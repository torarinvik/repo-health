{
  "schema": "rh-jsonschema/1",
  "name": "replay-result",
  "targets": ["fixtures/replay/replay-result-*.json"],
  "type": "object",
  "required": ["bundle", "verified", "commits", "rejected", "digest", "metrics"],
  "allowed_keys": ["bundle", "verified", "commits", "rejected", "digest", "metrics"],
  "types": {"bundle": "str", "verified": "bool", "commits": "int", "rejected": "int", "digest": "str", "metrics": "list"},
  "minimum": {"commits": 0, "rejected": 0},
  "maximum_items": {"metrics": 1},
  "items": {
    "metrics": {
      "required": ["key", "version", "status", "value", "evidence", "quality_dimensions"],
      "allowed_keys": ["key", "version", "status", "value", "reason", "evidence", "quality_dimensions"],
      "types": {"key": "str", "version": "str", "status": "str", "value": "int_dict_or_null", "reason": "str", "evidence": "list", "quality_dimensions": "dict"},
      "enum": {"key": ["coverage.replay_match_share"], "version": ["1.0.0"], "status": ["observed"]},
      "maximum_items": {"evidence": 2},
      "item_types": {"evidence": "str"},
      "nested": {
        "value": {"required": ["num", "den"], "allowed_keys": ["num", "den"], "types": {"num": "int", "den": "int"}, "minimum": {"num": 0, "den": 1}},
        "quality_dimensions": {
          "required": ["completeness", "freshness", "validity", "provenance"],
          "allowed_keys": ["completeness", "freshness", "validity", "provenance"],
          "types": {"completeness": "str", "freshness": "str", "validity": "str", "provenance": "str"},
          "enum": {"completeness": ["complete"], "freshness": ["unknown"], "validity": ["valid"], "provenance": ["evidence_backed"]}
        }
      },
      "conditional": {"field": "status", "cases": {"observed": {"types": {"value": "int_dict"}}}}
    }
  }
}
