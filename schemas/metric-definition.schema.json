{
  "schema": "rh-jsonschema/1",
  "name": "metric-definition",
  "targets": [
    "metrics/definitions/*.json"
  ],
  "required": [
    "key",
    "version",
    "implementation_status",
    "owner",
    "subject_kind",
    "output",
    "denominator_rule",
    "source_requirements",
    "cost_class",
    "privacy_class",
    "fixture_references",
    "measurement_class"
  ],
  "types": {
    "key": "str",
    "version": "str",
    "implementation_status": "str",
    "owner": "str",
    "subject_kind": "str",
    "output": "dict",
    "denominator_rule": "str",
