{
  "schema": "rh-jsonschema/1",
  "name": "postgres-command",
  "targets": ["fixtures/postgres/*-command.json"],
  "required": ["schema", "operation"],
  "types": {
    "schema": "str",
    "operation": "str",
    "source_id": "str",
    "source_kind": "str",
    "source_base_url": "str",
    "configuration_revision": "int",
    "source_created_at": "str",
    "capability": "str",
    "connector_name": "str",
    "connector_version": "str",
    "requested_start": "str",
    "requested_end": "str",
    "started_at": "str",
    "run_id": "str",
    "page_number": "int",
    "scope_hash": "str",
    "cursor_before": "str",
    "cursor_after": "str",
    "completeness": "str",
    "record_count": "int",
    "evidence_id": "str",
    "visibility_scope": "str",
    "blob_name": "str",
    "subjects_json": "str",
    "actors_json": "str",
    "media_type": "str",
    "retention_class": "str",
    "transformation_kind": "str",
    "events_json": "str",
    "normalization": "dict",
    "request": "dict",
    "result": "dict",
    "worker_id": "str",
    "job_id": "str",
    "fencing_token": "int",
    "attempt": "int",
    "failure_kind": "str",
    "now_epoch": "int",
    "max_attempts": "int",
    "backoff_cap_secs": "int",
    "now": "str",
    "lease_seconds": "int",
    "priority": "int",
    "next_attempt_at": "str",
    "state": "str",
    "run_status": "str",
    "coverage_details": "str",
    "outcome": "str",
    "error_kind": "str",
    "created_at": "str",
    "source_instance_id": "str",
    "requested_by": "str",
    "resolved_by": "str",
    "reason": "str",
    "requested_at": "str",
    "resolved_at": "str",
    "collection_run_id": "str",
    "scope": "str",
    "acquisition": "str",
    "captured_at": "int",
    "observed": "list",
    "projection_id": "str",
    "edge_kind": "str",
    "direction": "str",
    "entity_ids": "list",
    "edge_limit": "int",
    "projection": "dict",
    "edges": "list"
  },
  "enum": {
    "schema": ["rh-postgres-command/1"],
    "operation": ["begin_collection_run", "enqueue_collection_job", "enqueue_graph_query_job", "read_projection_adjacency_batch", "store_graph_projection", "claim_graph_query_job", "run_graph_query_job", "get_graph_query_job", "publish_graph_query_result", "retry_graph_query_job", "page_commit", "page_commit_events", "register_evidence", "evidence_references", "evidence_gc", "claim_job", "claim_collection_job", "heartbeat_job", "finish_job", "finish_collection_job", "commit_staged_normalization", "reconcile_source_objects", "request_source_stop", "resolve_source_stop"]
  },
  "nested": {
    "request": {
      "required": ["schema", "kind", "ids", "graph"],
      "types": {"schema": "str", "kind": "str", "ids": "list", "graph": "dict"},
      "enum": {"schema": ["rh-query-input/1"], "kind": ["upstream", "downstream"]}
    },
    "result": {
      "required": ["schema", "kind", "graph"],
      "types": {"schema": "str", "kind": "str", "graph": "dict"},
      "enum": {"schema": ["rh-query-result/1"], "kind": ["upstream", "downstream"]}
    },
    "projection": {
      "required": ["id", "projection_kind", "visibility_scope", "input_cutoff", "as_of", "identity_revision", "mapping_revision", "completeness", "manifest_digest"],
      "types": {"id": "str", "projection_kind": "str", "visibility_scope": "str", "input_cutoff": "str", "as_of": "str", "identity_revision": "str", "mapping_revision": "str", "completeness": "str", "manifest_digest": "str"},
      "enum": {"completeness": ["complete", "partial", "truncated", "failed"]}
    },
    "normalization": {
      "required": ["schema", "source_id", "collection_run_id", "input_sha256", "configuration_sha256", "normalizer", "normalized"],
      "types": {"schema": "str", "source_id": "str", "collection_run_id": "str", "input_sha256": "str", "configuration_sha256": "str", "normalizer": "str", "normalized": "dict"},
      "enum": {"schema": ["rh-postgres-staged-normalize-result/1"]},
      "nested": {
        "normalized": {
          "required": ["schema", "captured_at", "events"],
          "types": {"schema": "str", "captured_at": "int", "events": "list"},
          "enum": {"schema": ["rh-forge-events-result/1"]},
          "items": {
            "events": {
              "required": ["kind", "native_id", "created_at", "staged_origin"],
              "types": {"kind": "str", "native_id": "str", "created_at": "int", "staged_origin": "dict"},
              "nested": {
                "staged_origin": {
                  "required": ["page_number", "record_ordinal", "evidence_id"],
                  "types": {"page_number": "int", "record_ordinal": "int", "evidence_id": "str"}
                }
              }
            }
          }
        }
      }
    }
  },
  "items": {
    "edges": {
      "required": ["from_entity_id", "to_entity_id", "edge_kind", "known_at"],
      "types": {"from_entity_id": "str", "to_entity_id": "str", "edge_kind": "str", "known_at": "str", "valid_from": "str", "valid_to": "str"}
    }
  }
}
