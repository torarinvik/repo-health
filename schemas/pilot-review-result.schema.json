{
  "schema": "rh-jsonschema/1",
  "name": "pilot-review-result",
  "targets": ["fixtures/pilot-review/result.json", "fixtures/pilot-review/legacy-result.json"],
  "type": "object",
  "allowed_keys": ["schema", "review", "mapping_review", "corrections", "decision_usefulness", "provider_outage", "costs", "state", "note"],
  "required": ["schema", "review", "mapping_review", "corrections", "decision_usefulness", "provider_outage", "costs", "state", "note"],
  "types": {"schema": "str", "review": "dict", "mapping_review": "dict", "corrections": "dict", "decision_usefulness": "dict", "provider_outage": "dict", "costs": "dict", "state": "str", "note": "str"},
  "enum": {"schema": ["rh-pilot-review-result/1"], "state": ["recorded"]},
  "nested": {
    "review": {
      "allowed_keys": ["id", "reviewer", "reviewed_at", "scope"],
      "required": ["id", "reviewer", "reviewed_at", "scope"],
      "types": {"id": "str", "reviewer": "str", "reviewed_at": "int", "scope": "str"},
      "minimum": {"reviewed_at": 0}
    },
    "mapping_review": {
      "allowed_keys": ["sampled", "accepted", "needs_review"],
      "required": ["sampled", "accepted", "needs_review"],
      "types": {"sampled": "int", "accepted": "int", "needs_review": "int"},
      "minimum": {"sampled": 0, "accepted": 0, "needs_review": 0},
      "less_than_or_equal": [["accepted", "sampled"], ["needs_review", "sampled"]]
    },
    "corrections": {
      "allowed_keys": ["requested", "resolved", "median_turnaround_seconds", "maintainer_effort_seconds"],
      "required": ["requested", "resolved", "median_turnaround_seconds", "maintainer_effort_seconds"],
      "types": {"requested": "int", "resolved": "int", "median_turnaround_seconds": "int", "maintainer_effort_seconds": "int_or_null"},
      "minimum": {"requested": 0, "resolved": 0, "median_turnaround_seconds": 0},
      "less_than_or_equal": [["resolved", "requested"]]
    },
    "decision_usefulness": {
      "allowed_keys": ["understood", "false_positive_count", "false_negative_count", "reviewed_findings", "decision_changed_count", "correct_findings_count", "actionable_findings_count", "unknowns_resolved_by_evidence_count"],
      "required": ["understood", "false_positive_count", "false_negative_count", "reviewed_findings", "decision_changed_count", "correct_findings_count", "actionable_findings_count", "unknowns_resolved_by_evidence_count"],
      "types": {"understood": "bool", "false_positive_count": "int", "false_negative_count": "int", "reviewed_findings": "int_or_null", "decision_changed_count": "int_or_null", "correct_findings_count": "int_or_null", "actionable_findings_count": "int_or_null", "unknowns_resolved_by_evidence_count": "int_or_null"},
      "minimum": {"false_positive_count": 0, "false_negative_count": 0}
    },
    "provider_outage": {
      "allowed_keys": ["capability", "status", "other_capabilities_usable"],
      "required": ["capability", "status", "other_capabilities_usable"],
      "types": {"capability": "str", "status": "str", "other_capabilities_usable": "bool"},
      "enum": {"status": ["stale_unknown", "recovered", "unsupported"]}
    },
    "costs": {
      "allowed_keys": ["events", "bytes", "elapsed_ms"],
      "required": ["events", "bytes", "elapsed_ms"],
      "types": {"events": "int", "bytes": "int", "elapsed_ms": "int"},
      "minimum": {"events": 0, "bytes": 0, "elapsed_ms": 0}
    }
  }
}
