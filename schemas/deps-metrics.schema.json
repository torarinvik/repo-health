{
  "schema": "rh-jsonschema/1",
  "name": "deps-metrics",
  "targets": ["fixtures/deps-metrics/*.json"],
  "type": "object",
  "required": ["schema", "metrics", "by_ecosystem"],
  "allowed_keys": ["schema", "metrics", "by_ecosystem"],
  "types": {"schema": "str", "metrics": "list", "by_ecosystem": "list"},
  "enum": {"schema": ["rh-deps-metrics/1"]},
  "maximum_items": {"metrics": 38},
  "items": {
    "metrics": {
      "required": ["key", "version", "status", "value", "evidence", "quality_dimensions"],
      "allowed_keys": ["key", "version", "status", "value", "reason", "evidence", "quality_dimensions", "note"],
      "types": {"key": "str", "version": "str", "status": "str", "value": "int_dict_bool_or_null", "reason": "str", "evidence": "list", "quality_dimensions": "dict", "note": "str"},
      "enum": {"status": ["observed", "unavailable", "not_applicable"]},
      "item_types": {"evidence": "str"},
      "maximum_items": {"evidence": 2},
      "unique_items": ["evidence"],
      "nested": {
        "value": {
          "required": ["num", "den"],
          "allowed_keys": ["num", "den"],
          "types": {"num": "int", "den": "int"},
          "minimum": {"num": 0, "den": 1},
          "less_than_or_equal": [["num", "den"]]
        },
        "quality_dimensions": {
          "required": ["completeness", "freshness", "validity", "provenance"],
          "allowed_keys": ["completeness", "freshness", "validity", "provenance"],
          "types": {"completeness": "str", "freshness": "str", "validity": "str", "provenance": "str"},
          "enum": {
            "completeness": ["complete", "partial", "unknown"],
            "freshness": ["fresh", "stale", "unknown"],
            "validity": ["valid", "invalid", "unknown"],
            "provenance": ["evidence_backed", "derived", "unverified", "unknown"]
          }
        }
      },
      "conditional": {
        "field": "status",
        "cases": {
          "observed": {
            "types": {"value": "int_dict_bool"},
            "nested": {
              "quality_dimensions": {
                "enum": {
                  "completeness": ["complete"],
                  "freshness": ["unknown"],
                  "validity": ["valid"],
                  "provenance": ["evidence_backed"]
                }
              }
            }
          },
          "unavailable": {
            "required": ["reason"],
            "types": {"value": "null"},
            "nested": {
              "quality_dimensions": {
                "enum": {
                  "completeness": ["unknown"],
                  "freshness": ["unknown"],
                  "validity": ["unknown"],
                  "provenance": ["unknown"]
                }
              }
            }
          },
          "not_applicable": {
            "required": ["reason"],
            "types": {"value": "null"},
            "nested": {
              "quality_dimensions": {
                "enum": {
                  "completeness": ["unknown"],
                  "freshness": ["unknown"],
                  "validity": ["unknown"],
                  "provenance": ["evidence_backed"]
                }
              }
            }
          }
        }
      }
    }
  }
}
