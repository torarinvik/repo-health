{
  "schema": "rh-jsonschema/1",
  "name": "succession-result",
  "targets": ["fixtures/succession/result-*.json"],
  "type": "object",
  "required": ["schema", "metric", "version", "status", "pair", "window_complete_months", "handover_month", "follow_up", "activity_primary_actor_change_by_month", "evidence", "note", "metrics"],
  "allowed_keys": ["schema", "metric", "version", "status", "value", "reason", "pair", "window_complete_months", "handover_month", "follow_up", "activity_primary_actor_change_by_month", "evidence", "note", "metrics"],
  "types": {"schema": "str", "metric": "str", "version": "str", "status": "str", "value": "int_or_null", "reason": "str", "pair": "dict", "window_complete_months": "int", "handover_month": "int_or_null", "follow_up": "dict", "activity_primary_actor_change_by_month": "list", "evidence": "list", "note": "str", "metrics": "list"},
  "enum": {"schema": ["rh-continuity-metrics/1"], "metric": ["succession.handover_overlap_months"], "version": ["1.0.0"], "status": ["observed", "not_applicable"]},
  "minimum": {"window_complete_months": 0},
  "maximum_items": {"metrics": 5, "activity_primary_actor_change_by_month": 120, "evidence": 1},
  "item_types": {"activity_primary_actor_change_by_month": "bool_or_null", "evidence": "str"},
  "nested": {
    "pair": {
      "required": ["predecessor", "successor"],
      "allowed_keys": ["predecessor", "successor"],
      "types": {"predecessor": "int", "successor": "int"}
    },
    "follow_up": {
      "required": ["requested_months", "observed_months", "successor_active_months"],
      "allowed_keys": ["requested_months", "observed_months", "successor_active_months"],
      "types": {"requested_months": "int_or_null", "observed_months": "int", "successor_active_months": "int_or_null"},
      "minimum": {"observed_months": 0}
    }
  },
  "items": {
    "metrics": {
      "required": ["key", "version", "status", "value", "evidence", "quality_dimensions"],
      "allowed_keys": ["key", "version", "status", "value", "reason", "evidence", "quality_dimensions", "observed_months", "requested_months", "eligible_month_pairs"],
      "types": {"key": "str", "version": "str", "status": "str", "value": "int_or_null", "reason": "str", "evidence": "list", "quality_dimensions": "dict", "observed_months": "int", "requested_months": "int", "eligible_month_pairs": "int"},
      "enum": {"key": ["succession.handover_overlap_months", "succession.declared_handovers", "succession.observed_activity_overlap_months", "succession.successor_follow_up_active_months", "succession.activity_primary_actor_changes"], "version": ["1.0.0"], "status": ["observed", "partial", "unsupported", "not_applicable"]},
      "minimum": {"observed_months": 0, "requested_months": 0, "eligible_month_pairs": 0},
      "maximum_items": {"evidence": 1},
      "item_types": {"evidence": "str"},
      "nested": {
        "quality_dimensions": {
          "required": ["completeness", "freshness", "validity", "provenance"],
          "allowed_keys": ["completeness", "freshness", "validity", "provenance"],
          "types": {"completeness": "str", "freshness": "str", "validity": "str", "provenance": "str"},
          "enum": {"completeness": ["complete", "partial", "unknown"], "freshness": ["unknown"], "validity": ["valid", "invalid", "unknown"], "provenance": ["evidence_backed"]}
        }
      },
      "conditional": {
        "field": "status",
        "cases": {
          "observed": {"required": ["value"], "types": {"value": "int"}, "minimum": {"value": 0}, "nested": {"quality_dimensions": {"enum": {"completeness": ["complete"], "validity": ["valid"]}}}},
          "partial": {"required": ["value"], "types": {"value": "int"}, "minimum": {"value": 0}, "nested": {"quality_dimensions": {"enum": {"completeness": ["partial"], "validity": ["unknown"]}}}},
          "unsupported": {"required": ["reason"], "types": {"value": "null"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["unknown"], "validity": ["unknown"]}}}},
          "not_applicable": {"required": ["reason"], "types": {"value": "null"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["unknown"], "validity": ["unknown"]}}}}
        }
      }
    }
  },
  "conditional": {
    "field": "status",
    "cases": {
      "observed": {"required": ["value"], "types": {"value": "int"}, "minimum": {"value": 0}},
      "not_applicable": {"required": ["reason"], "allowed_keys": ["schema", "metric", "version", "status", "reason", "pair", "window_complete_months", "handover_month", "follow_up", "activity_primary_actor_change_by_month", "evidence", "note", "metrics"]}
    }
  }
}
