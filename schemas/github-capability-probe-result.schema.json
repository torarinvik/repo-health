{
  "schema": "rh-jsonschema/1",
  "name": "github-capability-probe-result",
  "targets": ["fixtures/connectors/github-traffic-probe-result.json"],
  "required": ["schema", "provider", "captured_at", "scope", "authorization", "capabilities", "evidence", "note"],
  "types": {
    "schema": "str", "provider": "str", "captured_at": "int", "scope": "dict",
    "authorization": "dict", "capabilities": "dict", "evidence": "dict", "note": "str"
  },
  "enum": {
    "schema": ["rh-github-capability-probe-result/1"],
    "provider": ["github"]
  },
  "nested": {
    "scope": {"required": ["repository"], "types": {"repository": "str"}},
    "authorization": {
      "required": ["credential"], "types": {"credential": "str"},
      "enum": {"credential": ["configured", "not_requested"]}
    },
    "capabilities": {
      "required": ["traffic"], "types": {"traffic": "dict"},
      "nested": {
        "traffic": {
          "required": ["declaration", "status", "http_status", "window_days"],
          "types": {"declaration": "str", "status": "str", "http_status": "int_or_null", "window_days": "int"},
          "enum": {
            "declaration": ["authorized-14-day-window"],
            "status": ["observed", "malformed", "unauthorized", "forbidden_or_rate_limited", "not_found_or_private", "rate_limited", "unavailable"]
          }
        }
      }
    },
    "evidence": {
      "required": ["url", "body", "status", "error"],
      "types": {"url": "str", "body": "str", "status": "str", "error": "str"}
    }
  }
}
