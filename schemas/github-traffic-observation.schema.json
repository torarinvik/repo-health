    "window": "dict", "daily_observations": "list", "aggregation": "dict",
    "response_sha256": "str", "coverage": "str"
  },
  "enum": {
    "schema": ["rh-github-traffic-observation/1"],
    "provider": ["github"],
    "origin": ["caller_supplied_response"],
