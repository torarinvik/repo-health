{
  "schema": "rh-jsonschema/1",
  "name": "continuity-metrics",
  "targets": ["fixtures/continuity/continuity-metrics-*.json"],
  "type": "object",
  "required": ["schema", "identity_revision", "observation_window", "actors_total", "metrics", "retention_components", "retention_365d_components", "concentration_components"],
  "allowed_keys": ["schema", "identity_revision", "observation_window", "actors_total", "metrics", "retention_components", "retention_365d_components", "concentration_components"],
  "types": {"schema": "str", "identity_revision": "int", "observation_window": "dict", "actors_total": "int", "metrics": "list", "retention_components": "dict", "retention_365d_components": "dict", "concentration_components": "dict"},
  "enum": {"schema": ["rh-continuity-metrics/1"]},
  "maximum_items": {"metrics": 23},
  "nested": {
    "observation_window": {
      "required": ["start", "end"],
      "allowed_keys": ["start", "end"],
      "types": {"start": "int", "end": "int"},
      "minimum": {"start": 0, "end": 0}
    },
    "retention_components": {
      "required": ["retained", "eligible", "censored", "unobservable", "first_seen_supported"],
      "types": {"retained": "int", "eligible": "int", "censored": "int", "unobservable": "int", "first_seen_supported": "bool"},
      "minimum": {"retained": 0, "eligible": 0, "censored": 0, "unobservable": 0}
    },
    "retention_365d_components": {
      "required": ["retained", "eligible", "censored", "unobservable", "first_seen_supported"],
      "types": {"retained": "int", "eligible": "int", "censored": "int", "unobservable": "int", "first_seen_supported": "bool"},
      "minimum": {"retained": 0, "eligible": 0, "censored": 0, "unobservable": 0}
    },
    "concentration_components": {
      "required": ["hhi_num", "hhi_den", "effective_num", "effective_den", "absence_factor_50", "absence_factor_80"],
      "types": {"hhi_num": "int", "hhi_den": "int", "effective_num": "int", "effective_den": "int", "absence_factor_50": "int", "absence_factor_80": "int"}
    }
  },
  "items": {
    "metrics": {
      "required": ["key", "version", "status", "value", "evidence", "quality_dimensions"],
      "allowed_keys": ["key", "version", "status", "value", "reason", "evidence", "quality_dimensions", "gap_days", "profile"],
      "types": {"key": "str", "version": "str", "status": "str", "value": "int_dict_or_null", "reason": "str", "evidence": "list", "quality_dimensions": "dict", "gap_days": "int", "profile": "dict"},
      "enum": {"status": ["observed", "partial", "unsupported", "not_applicable"]},
      "item_types": {"evidence": "str"},
      "maximum_items": {"evidence": 1},
      "nested": {
        "value": {
          "required": ["num", "den"],
          "allowed_keys": ["num", "den"],
          "types": {"num": "int", "den": "int"},
          "minimum": {"num": 0, "den": 1}
        },
        "quality_dimensions": {
          "required": ["completeness", "freshness", "validity", "provenance"],
          "allowed_keys": ["completeness", "freshness", "validity", "provenance"],
          "types": {"completeness": "str", "freshness": "str", "validity": "str", "provenance": "str"},
          "enum": {
            "completeness": ["complete", "partial", "unknown"],
            "freshness": ["fresh", "stale", "unknown"],
            "validity": ["valid", "invalid", "unknown"],
            "provenance": ["evidence_backed", "derived", "unverified", "unknown"]
          }
        }
      },
      "conditional": {
        "field": "status",
        "cases": {
          "observed": {
            "types": {"value": "int_dict"},
            "nested": {
              "quality_dimensions": {
                "enum": {"completeness": ["complete"], "validity": ["valid"], "provenance": ["evidence_backed"]}
              }
            }
          },
          "partial": {
            "types": {"value": "int_dict"},
            "nested": {
              "quality_dimensions": {
                "enum": {"completeness": ["partial"], "validity": ["unknown"], "provenance": ["evidence_backed"]}
              }
            }
          },
          "unsupported": {
            "required": ["reason"],
            "types": {"value": "null"},
            "nested": {
              "quality_dimensions": {
                "enum": {"completeness": ["unknown"], "validity": ["unknown"], "provenance": ["evidence_backed"]}
              }
            }
          },
          "not_applicable": {
            "required": ["reason"],
            "types": {"value": "null"},
            "nested": {
              "quality_dimensions": {
                "enum": {"completeness": ["unknown"], "validity": ["unknown"], "provenance": ["evidence_backed"]}
              }
            }
          }
        }
      }
    }
  }
}
