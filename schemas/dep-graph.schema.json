{
  "schema": "rh-jsonschema/1",
  "name": "dep-graph",
  "targets": ["fixtures/packages/*.golden.json"],
  "type": "object",
  "required": ["schema", "ecosystem", "nodes", "edges", "advisories"],
  "types": {"schema": "str", "ecosystem": "str", "nodes": "list", "edges": "list", "advisories": "list"},
  "enum": {"schema": ["rh-dep-graph/1"], "ecosystem": ["cargo", "npm", "pypi", "go"]},
  "items": {
    "nodes": {"required": ["id", "name", "version"], "types": {"id": "int", "name": "str", "version": "str_or_null"}},
    "edges": {"required": ["from", "to"], "types": {"from": "int", "to": "int"}},
    "advisories": {"required": ["node", "witness"], "types": {"node": "int"}}
  }
}
