{
  "schema": "rh-jsonschema/1",
  "name": "dep-graph",
  "targets": ["fixtures/packages/*.golden.json", "fixtures/packages/artifact-observation-graph.json"],
  "type": "object",
  "required": ["schema", "ecosystem", "nodes", "edges", "advisories"],
  "types": {"schema": "str", "ecosystem": "str", "nodes": "list", "artifacts": "list", "edges": "list", "advisories": "list"},
  "enum": {"schema": ["rh-dep-graph/1"], "ecosystem": ["cargo", "npm", "pypi", "go"]},
  "items": {
    "nodes": {"required": ["id", "name", "version"], "types": {"id": "int", "name": "str", "version": "str_or_null", "source_identity_sha256": "str"}},
    "artifacts": {"required": ["id", "package_node", "kind", "expected_digest", "observed_digest", "identity_state"], "types": {"id": "int", "package_node": "int", "kind": "str", "expected_digest": "str_or_null", "observed_digest": "str_or_null", "identity_state": "str"}, "enum": {"kind": ["archive", "module"], "identity_state": ["match", "changed", "unknown"]}},
    "edges": {"required": ["from", "to"], "types": {"from": "int", "to": "int", "scope": "str", "optional": "bool", "platform": "int", "introduced": "int", "removed": "int", "first_seen": "int"}},
    "unresolved": {"required": ["from", "name", "requirement", "reason"], "types": {"from": "int", "name": "str", "requirement": "str_or_null", "reason": "str", "optional": "bool"}},
    "advisories": {"required": ["node", "witness"], "types": {"node": "int"}}
  }
}
