{
  "schema": "rh-jsonschema/1",
  "name": "experimental-result",
  "targets": ["fixtures/m11/experimental-result.json"],
  "type": "object",
  "required": ["schema", "specs", "observations", "metric", "anomaly", "label", "note"],
  "allowed_keys": ["schema", "specs", "observations", "metric", "anomaly", "label", "note"],
  "types": {"schema": "str", "specs": "list", "observations": "list", "metric": "dict", "anomaly": "dict", "label": "str", "note": "str"},
  "enum": {"schema": ["rh-experimental-result/1"]},
  "maximum_items": {"observations": 2},
  "minimum_items": {"observations": 2},
  "nested": {
    "metric": {"required": ["key", "status"], "types": {"key": "str", "status": "str"}},
    "anomaly": {"required": ["key", "status", "label"], "types": {"key": "str", "status": "str", "label": "str"}, "enum": {"status": ["observed", "not_applicable", "unsupported"]}}
  },
  "items": {
    "observations": {
      "required": ["key", "version", "status", "value", "evidence", "quality_dimensions"],
      "allowed_keys": ["key", "version", "status", "value", "reason", "evidence", "quality_dimensions"],
      "types": {"key": "str", "version": "str", "status": "str", "value": "int_dict_or_null", "reason": "str", "evidence": "list", "quality_dimensions": "dict"},
      "enum": {"status": ["observed", "not_applicable", "unsupported"]},
      "item_types": {"evidence": "str"},
      "maximum_items": {"evidence": 1},
      "unique_items": ["evidence"],
      "nested": {
        "value": {"required": ["num", "den"], "allowed_keys": ["num", "den"], "types": {"num": "int", "den": "int"}, "minimum": {"num": 0, "den": 1}, "less_than_or_equal": [["num", "den"]]},
        "quality_dimensions": {"required": ["completeness", "freshness", "validity", "provenance"], "allowed_keys": ["completeness", "freshness", "validity", "provenance"], "types": {"completeness": "str", "freshness": "str", "validity": "str", "provenance": "str"}, "enum": {"completeness": ["complete", "unknown"], "freshness": ["unknown"], "validity": ["valid", "unknown"], "provenance": ["evidence_backed", "derived", "unknown"]}}
      },
      "conditional": {
        "field": "status",
        "cases": {
          "observed": {"allowed_keys": ["key", "version", "status", "value", "evidence", "quality_dimensions"], "types": {"value": "int_dict"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["complete"], "freshness": ["unknown"], "validity": ["valid"], "provenance": ["evidence_backed"]}}}},
          "not_applicable": {"required": ["reason"], "types": {"value": "null"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["unknown"], "freshness": ["unknown"], "validity": ["unknown"], "provenance": ["evidence_backed"]}}}},
          "unsupported": {"required": ["reason"], "types": {"value": "null"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["unknown"], "freshness": ["unknown"], "validity": ["unknown"], "provenance": ["evidence_backed"]}}}}
        }
      }
    }
  }
}
