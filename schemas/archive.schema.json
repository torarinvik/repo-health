  "items": {
    "archives": {
      "required": ["identifier", "kind", "format", "uri", "digest", "published_at", "size"],
      "types": {"identifier": "str", "kind": "str", "format": "str", "uri": "str", "digest": "str_or_null", "published_at": "int_or_null", "size": "int_or_null"}
