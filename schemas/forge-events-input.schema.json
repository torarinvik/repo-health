{
  "schema": "rh-jsonschema/1",
  "name": "forge-events-input",
  "targets": [
    "fixtures/connectors/forge-events-input.json",
    "fixtures/connectors/forge-events-gitlab-input.json",
    "fixtures/connectors/forge-events-forgejo-input.json",
    "fixtures/connectors/forge-events-gitea-input.json",
    "fixtures/connectors/forge-events-bitbucket-input.json",
    "fixtures/connectors/forge-events-repository-reviews-input.json"
  ],
  "required": ["schema", "provider", "captured_at"],
  "types": {
    "schema": "str",
    "provider": "str",
    "captured_at": "int",
    "authorization": "dict",
    "issues": "list",
    "proposals": "list",
    "reviews": "list",
    "releases": "list",
    "pagination": "dict",
    "scope": "dict",
    "reviews_by_pull": "list",
    "review_collection": "dict",
    "staged_origins": "dict"
  },
  "enum": {
    "schema": ["rh-forge-events-input/1"],
    "provider": ["github", "gitlab", "gitea", "forgejo", "bitbucket"]
  },
  "nested": {
    "authorization": {
      "required": ["state"],
      "types": {"state": "str"},
      "enum": {"state": ["authorized", "unauthorized", "not_requested", "unknown"]}
    },
    "pagination": {
      "required": ["issues", "proposals", "reviews", "releases"],
      "types": {"issues": "dict", "proposals": "dict", "reviews": "dict", "releases": "dict"},
      "nested": {
        "issues": {"required": ["next", "complete"], "types": {"next": "str_or_null", "complete": "bool"}},
        "proposals": {"required": ["next", "complete"], "types": {"next": "str_or_null", "complete": "bool"}},
        "reviews": {"required": ["next", "complete"], "types": {"next": "str_or_null", "complete": "bool"}},
        "releases": {"required": ["next", "complete"], "types": {"next": "str_or_null", "complete": "bool"}}
      }
    },
    "scope": {
      "types": {"repository": "str", "pull_request": "int"}
    },
    "review_collection": {
      "required": ["pending_pull_requests", "next_pull_page", "pulls_complete", "complete"],
      "types": {"pending_pull_requests": "list", "next_pull_page": "int_or_null", "pulls_complete": "bool", "complete": "bool"},
      "items": {
        "pending_pull_requests": {"required": ["number", "next_review_page"], "types": {"number": "int", "next_review_page": "int"}}
      }
    },
    "staged_origins": {
      "types": {"issues": "list", "proposals": "list", "reviews": "list", "releases": "list"},
      "items": {
        "issues": {"required": ["page_number", "record_ordinal"], "types": {"page_number": "int", "record_ordinal": "int", "evidence_id": "str"}},
        "proposals": {"required": ["page_number", "record_ordinal"], "types": {"page_number": "int", "record_ordinal": "int", "evidence_id": "str"}},
        "reviews": {"required": ["page_number", "record_ordinal"], "types": {"page_number": "int", "record_ordinal": "int", "evidence_id": "str"}},
        "releases": {"required": ["page_number", "record_ordinal"], "types": {"page_number": "int", "record_ordinal": "int", "evidence_id": "str"}}
      }
    }
  },
  "items": {
    "reviews_by_pull": {
      "required": ["pull_number", "reviews"],
      "types": {"pull_number": "int", "reviews": "list", "staged_origins": "dict"},
      "nested": {
        "staged_origins": {
          "types": {"reviews": "list"},
          "items": {
            "reviews": {"required": ["page_number", "record_ordinal"], "types": {"page_number": "int", "record_ordinal": "int", "evidence_id": "str"}}
          }
        }
      }
    }
  }
}
