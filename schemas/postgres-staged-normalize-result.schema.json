{
  "schema": "rh-jsonschema/1",
  "name": "postgres-staged-normalize-result",
  "targets": ["fixtures/postgres/staged-github-issues-output.json", "fixtures/postgres/staged-github-proposals-output.json", "fixtures/postgres/staged-github-reviews-output.json", "fixtures/postgres/staged-github-releases-output.json", "fixtures/postgres/staged-gitlab-issues-output.json", "fixtures/postgres/staged-gitlab-proposals-output.json", "fixtures/postgres/staged-gitlab-releases-output.json", "fixtures/postgres/staged-forge-events-gitea-issues-output.json", "fixtures/postgres/staged-forge-events-forgejo-proposals-output.json", "fixtures/postgres/staged-forge-events-bitbucket-issues-output.json"],
  "required": ["schema", "source_id", "collection_run_id", "input_sha256", "provider", "collector_label", "canonical_capability", "record_count", "pages", "staged_records", "normalizer", "output_schema", "configuration_sha256", "field_transformations", "normalized"],
  "types": {
