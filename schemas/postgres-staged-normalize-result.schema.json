    "field_transformations": {"required": ["source_field", "target_field", "state", "missing_state", "reason"], "types": {"source_field": "str", "target_field": "str", "state": "str", "missing_state": "str", "reason": "str"}, "enum": {"state": ["preserved", "transformed", "inferred", "discarded", "unsupported"], "missing_state": ["unknown", "rejected", "not_applicable"]}}
  },
