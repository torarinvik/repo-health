          "required": ["kind", "native_id", "status", "created_at", "updated_at", "closed_at", "staged_origin"],
          "types": {"kind": "str", "native_id": "str", "status": "str", "created_at": "int", "updated_at": "int_or_null", "closed_at": "int_or_null", "tag": "str", "url": "str", "pull_request": "int", "staged_origin": "dict"},
          "nested": {"staged_origin": {"required": ["page_number", "record_ordinal"], "types": {"page_number": "int", "record_ordinal": "int"}}}
        }
      },
      "nested": {
        "capabilities": {
          "nested": {
            "issues": {"required": ["status", "attempted", "normalized", "duplicate_replacements", "count", "rejected"], "types": {"status": "str", "attempted": "int_or_null", "normalized": "int_or_null", "duplicate_replacements": "int_or_null", "count": "int_or_null", "rejected": "int"}},
            "proposals": {"required": ["status", "attempted", "normalized", "duplicate_replacements", "count", "rejected"], "types": {"status": "str", "attempted": "int_or_null", "normalized": "int_or_null", "duplicate_replacements": "int_or_null", "count": "int_or_null", "rejected": "int"}},
            "releases": {"required": ["status", "attempted", "normalized", "duplicate_replacements", "count", "rejected"], "types": {"status": "str", "attempted": "int_or_null", "normalized": "int_or_null", "duplicate_replacements": "int_or_null", "count": "int_or_null", "rejected": "int"}},
            "reviews": {"required": ["status", "attempted", "normalized", "duplicate_replacements", "count", "rejected"], "types": {"status": "str", "attempted": "int_or_null", "normalized": "int_or_null", "duplicate_replacements": "int_or_null", "count": "int_or_null", "rejected": "int"}}
          }
        }
      }
    }
