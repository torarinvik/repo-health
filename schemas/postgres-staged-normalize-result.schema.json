    "collector_label": "str", "canonical_capability": "str", "record_count": "int", "pages": "list", "staged_records": "list", "normalizer": "str", "output_schema": "str", "configuration_sha256": "str", "field_transformations": "list", "normalized": "dict", "note": "str"
  },
  "enum": {
    "schema": ["rh-postgres-staged-normalize-result/1"],
    "provider": ["github", "gitlab", "gitea", "forgejo", "bitbucket"],
    "canonical_capability": ["issues", "proposals", "reviews", "releases"],
