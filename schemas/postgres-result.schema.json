{
  "schema": "rh-jsonschema/1",
  "name": "postgres-result",
  "targets": ["fixtures/postgres/*-result.json"],
  "required": ["schema", "operation", "status"],
  "types": {
    "schema": "str",
    "operation": "str",
    "status": "str",
    "job_id": "str",
    "fencing_token": "int",
    "lease_expires_at": "str",
    "evidence_id": "str",
    "digest_algorithm": "str",
    "digest_value": "str",
    "byte_length": "int",
    "storage_key": "str",
    "reference_snapshot": "dict",
    "candidate_count": "int",
    "deleted_count": "int",
    "reference_count": "int",
    "deleted_names": "list"
  },
  "enum": {
    "schema": ["rh-postgres-result/1"],
    "operation": ["begin_collection_run", "enqueue_collection_job", "page_commit", "page_commit_events", "register_evidence", "evidence_references", "evidence_gc", "claim_job", "claim_collection_job", "heartbeat_job", "finish_job", "finish_collection_job"],
    "status": ["started", "enqueued", "committed", "duplicate", "registered", "listed", "collected", "partial", "claimed", "empty", "applied", "fenced"]
  },
  "nested": {
    "reference_snapshot": {
      "required": ["storage_keys", "invalid_count", "truncated", "count"],
      "types": {"storage_keys": "list", "invalid_count": "int", "truncated": "bool", "count": "int"},
      "item_types": {"storage_keys": "str"}
    }
  },
  "item_types": {"deleted_names": "str"}
}
