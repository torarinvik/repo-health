{
  "schema": "rh-jsonschema/1",
  "name": "postgres-result",
  "targets": ["fixtures/postgres/*-result.json"],
  "required": ["schema", "operation", "status"],
  "types": {
    "schema": "str",
    "operation": "str",
    "status": "str",
    "next_phase": "str",
    "wake_epoch": "int",
    "job_id": "str",
    "fencing_token": "int",
    "lease_expires_at": "str",
    "evidence_id": "str",
    "digest_algorithm": "str",
    "digest_value": "str",
    "byte_length": "int",
    "storage_key": "str",
    "reference_snapshot": "dict",
    "candidate_count": "int",
    "deleted_count": "int",
    "reference_count": "int",
    "deleted_names": "list",
    "event_count": "int",
    "input_sha256": "str",
    "configuration_sha256": "str",
    "output_sha256": "str",
    "request": "dict",
    "result": "dict"
  },
  "enum": {
    "schema": ["rh-postgres-result/1"],
    "operation": ["begin_collection_run", "enqueue_collection_job", "enqueue_graph_query_job", "claim_graph_query_job", "get_graph_query_job", "publish_graph_query_result", "retry_graph_query_job", "page_commit", "page_commit_events", "register_evidence", "evidence_references", "evidence_gc", "claim_job", "claim_collection_job", "heartbeat_job", "finish_job", "finish_collection_job", "commit_staged_normalization"],
    "status": ["started", "enqueued", "published", "committed", "duplicate", "registered", "listed", "collected", "partial", "claimed", "empty", "queued", "running", "succeeded", "failed", "dead_letter", "canceled", "not_found", "applied", "fenced"]
  },
  "nested": {
    "result": {
      "required": ["schema", "kind", "graph"],
      "types": {"schema": "str", "kind": "str", "graph": "dict"},
      "enum": {"schema": ["rh-query-result/1"], "kind": ["upstream", "downstream"]}
    },
    "request": {
      "required": ["schema", "kind", "ids", "graph"],
      "types": {"schema": "str", "kind": "str", "ids": "list", "graph": "dict"},
      "enum": {"schema": ["rh-query-input/1"], "kind": ["upstream", "downstream"]}
    },
    "reference_snapshot": {
      "required": ["storage_keys", "invalid_count", "truncated", "count"],
      "types": {"storage_keys": "list", "invalid_count": "int", "truncated": "bool", "count": "int"},
      "item_types": {"storage_keys": "str"}
    }
  },
  "item_types": {"deleted_names": "str"}
}
