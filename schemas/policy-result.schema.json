{
  "schema": "rh-jsonschema/1",
  "name": "policy-result",
  "targets": ["fixtures/policy-result/result-*.json"],
  "type": "object",
  "required": ["schema", "subject_id", "binding", "decision", "fired_rule_ids", "excepted_rule_ids", "missing_input_rule_ids", "explanation", "metrics", "note"],
  "allowed_keys": ["schema", "subject_id", "binding", "decision", "fired_rule_ids", "excepted_rule_ids", "missing_input_rule_ids", "explanation", "metrics", "note"],
  "types": {"schema": "str", "subject_id": "int", "binding": "dict", "decision": "str", "fired_rule_ids": "list", "excepted_rule_ids": "list", "missing_input_rule_ids": "list", "explanation": "dict", "metrics": "list", "note": "str"},
  "enum": {"schema": ["rh-policy-result/1"], "decision": ["allow", "warn", "deny", "unknown"]},
  "maximum_items": {"metrics": 7},
  "item_types": {"fired_rule_ids": "int", "excepted_rule_ids": "int", "missing_input_rule_ids": "int"},
  "nested": {
    "binding": {
      "required": ["policy_digest", "context_digest", "artifact_digest", "now"],
      "allowed_keys": ["policy_digest", "context_digest", "artifact_digest", "now"],
      "types": {"policy_digest": "str", "context_digest": "str", "artifact_digest": "str", "now": "int"},
      "minimum": {"now": 0}
    }
  },
  "items": {
    "metrics": {
      "required": ["key", "version", "status", "value", "evidence", "quality_dimensions"],
      "allowed_keys": ["key", "version", "status", "value", "reason", "evidence", "quality_dimensions"],
      "types": {"key": "str", "version": "str", "status": "str", "value": "int_or_null", "reason": "str", "evidence": "list", "quality_dimensions": "dict"},
      "enum": {"key": ["policy.evaluations", "policy.allow_count", "policy.warn_count", "policy.deny_count", "policy.unknown_count", "policy.active_exceptions", "policy.exception_expiry_days"], "version": ["1.0.0"], "status": ["observed", "not_applicable"]},
      "maximum_items": {"evidence": 1},
      "item_types": {"evidence": "str"},
      "nested": {
        "quality_dimensions": {
          "required": ["completeness", "freshness", "validity", "provenance"],
          "allowed_keys": ["completeness", "freshness", "validity", "provenance"],
          "types": {"completeness": "str", "freshness": "str", "validity": "str", "provenance": "str"},
          "enum": {"completeness": ["complete", "unknown"], "freshness": ["unknown"], "validity": ["valid", "unknown"], "provenance": ["evidence_backed"]}
        }
      },
      "conditional": {
        "field": "status",
        "cases": {
          "observed": {"required": ["value"], "types": {"value": "int"}, "minimum": {"value": 0}, "nested": {"quality_dimensions": {"enum": {"completeness": ["complete"], "validity": ["valid"]}}}},
          "not_applicable": {"required": ["reason"], "types": {"value": "null"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["unknown"], "validity": ["unknown"]}}}}
        }
      }
    }
  }
}
