{
  "schema": "rh-jsonschema/1",
  "name": "artifact-digest-anomaly-result",
  "targets": ["fixtures/m11/artifact-anomaly-result.json"],
  "type": "object",
  "required": ["schema", "status", "scope_complete", "history_complete", "observations", "findings", "conflicts", "label", "note"],
  "allowed_keys": ["schema", "status", "scope_complete", "history_complete", "observations", "findings", "conflicts", "label", "note"],
  "types": {"schema": "str", "status": "str", "scope_complete": "bool", "history_complete": "bool", "observations": "list", "findings": "list", "conflicts": "list", "label": "str", "note": "str"},
  "enum": {"schema": ["rh-artifact-digest-anomaly-result/1"], "status": ["unsupported", "conflicted", "observed", "partial", "no_change_observed", "unknown", "not_applicable"]},
  "items": {
    "observations": {
      "required": ["key", "version", "status", "value", "evidence", "quality_dimensions"],
      "allowed_keys": ["key", "version", "status", "value", "reason", "evidence", "quality_dimensions"],
      "types": {"key": "str", "version": "str", "status": "str", "value": "int_dict_or_null", "reason": "str", "evidence": "list", "quality_dimensions": "dict"},
      "enum": {"status": ["observed", "not_observed", "unavailable", "partial", "not_applicable", "unsupported", "conflicted"]},
      "maximum_items": {"evidence": 1},
      "item_types": {"evidence": "str"},
      "nested": {
        "quality_dimensions": {
          "required": ["completeness", "freshness", "validity", "provenance"],
          "allowed_keys": ["completeness", "freshness", "validity", "provenance"],
          "types": {"completeness": "str", "freshness": "str", "validity": "str", "provenance": "str"},
          "enum": {"completeness": ["complete", "partial", "unknown"], "freshness": ["unknown"], "validity": ["valid", "unknown"], "provenance": ["evidence_backed"]}
        }
      },
      "conditional": {
        "field": "status",
        "cases": {
          "observed": {"types": {"value": "int_dict"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["complete"], "validity": ["valid"]}}}},
          "not_observed": {"types": {"value": "int_dict"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["complete"], "validity": ["valid"]}}}},
          "partial": {"types": {"value": "int_dict"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["partial"], "validity": ["valid"]}}}},
          "unavailable": {"required": ["reason"], "types": {"value": "null"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["unknown"], "validity": ["unknown"]}}}},
          "not_applicable": {"required": ["reason"], "types": {"value": "null"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["unknown"], "validity": ["unknown"]}}}},
          "unsupported": {"required": ["reason"], "types": {"value": "null"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["unknown"], "validity": ["unknown"]}}}},
          "conflicted": {"required": ["reason"], "types": {"value": "null"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["unknown"], "validity": ["unknown"]}}}}
        }
      }
    },
    "findings": {
      "required": ["package", "version", "artifact", "before", "after"],
      "allowed_keys": ["package", "version", "artifact", "before", "after"],
      "types": {"package": "str", "version": "str", "artifact": "str", "before": "dict", "after": "dict"},
      "nested": {
        "before": {"required": ["observed_at", "sha256", "input_observation_index"], "allowed_keys": ["observed_at", "sha256", "input_observation_index"], "types": {"observed_at": "int", "sha256": "str", "input_observation_index": "int"}, "minimum": {"observed_at": 0, "input_observation_index": 0}},
        "after": {"required": ["observed_at", "sha256", "input_observation_index"], "allowed_keys": ["observed_at", "sha256", "input_observation_index"], "types": {"observed_at": "int", "sha256": "str", "input_observation_index": "int"}, "minimum": {"observed_at": 0, "input_observation_index": 0}}
      }
    },
    "conflicts": {
      "required": ["package", "version", "artifact", "observed_at", "input_observation_indices", "sha256"],
      "allowed_keys": ["package", "version", "artifact", "observed_at", "input_observation_indices", "sha256"],
      "types": {"package": "str", "version": "str", "artifact": "str", "observed_at": "int", "input_observation_indices": "list", "sha256": "list"},
      "minimum": {"observed_at": 0},
      "minimum_items": {"input_observation_indices": 2, "sha256": 2},
      "item_types": {"input_observation_indices": "int", "sha256": "str"}
    }
  }
}
