{
  "schema": "rh-jsonschema/1",
  "name": "freebsd-catalog-result",
  "targets": ["fixtures/distribution/freebsd-data-result.json"],
  "type": "object",
  "required": ["schema", "format", "packages", "unknown_package_fields", "omitted_free_text_fields", "omitted_group_count", "omitted_expired_package_count", "note"],
  "types": {
    "schema": "str",
    "format": "str",
    "packages": "list",
    "unknown_package_fields": "int",
    "omitted_free_text_fields": "int",
    "omitted_group_count": "int",
    "omitted_expired_package_count": "int",
    "note": "str"
  },
  "enum": {
    "schema": ["rh-freebsd-catalog-result/1"],
    "format": ["freebsd-pkg-data-json"]
  },
  "minimum": {
    "unknown_package_fields": 0,
    "omitted_free_text_fields": 0,
    "omitted_group_count": 0,
    "omitted_expired_package_count": 0
  },
  "maximum_items": {"packages": 25000},
  "items": {
    "packages": {
      "required": ["name", "origin", "version", "abi", "architecture", "checksum_claim", "package_size", "installed_size", "license_logic", "licenses", "relations"],
      "types": {
        "name": "int_str_or_null",
        "origin": "str",
        "version": "int_str_or_null",
        "abi": "str_or_null",
        "architecture": "str_or_null",
        "checksum_claim": "str_or_null",
        "package_size": "nonnegative_int_or_null",
        "installed_size": "nonnegative_int_or_null",
        "license_logic": "str_or_null",
        "licenses": "list",
        "relations": "list"
      },
      "item_types": {"licenses": "str"},
      "items": {
        "relations": {
          "required": ["kind"],
          "types": {"kind": "str"},
          "conditional": {
            "field": "kind",
            "cases": {
              "depends": {
                "required": ["kind", "name", "origin", "version"],
                "types": {"kind": "str", "name": "str", "origin": "str", "version": "int_str_or_null"}
              },
              "provides": {
                "required": ["kind", "expression"],
                "types": {"kind": "str", "expression": "str"}
              },
              "requires": {
                "required": ["kind", "expression"],
                "types": {"kind": "str", "expression": "str"}
              }
            }
          }
        }
      }
    }
  }
}
