      "types": {"pending_pull_requests": "list", "next_pull_page": "int_or_null", "pulls_complete": "bool", "complete": "bool"},
      "items": {
        "pending_pull_requests": {"required": ["number", "next_review_page"], "types": {"number": "int", "next_review_page": "int"}}
      }
    },
    "capabilities": {
      "required": ["issues", "proposals", "reviews", "releases"], "types": {
        "issues": "dict", "proposals": "dict", "reviews": "dict", "releases": "dict"
      },
      "nested": {
        "issues": {"required": ["status", "attempted", "normalized", "duplicate_replacements", "count", "rejected"], "types": {"status": "str", "attempted": "int_or_null", "normalized": "int_or_null", "duplicate_replacements": "int_or_null", "count": "int_or_null", "rejected": "int"}, "enum": {"status": ["observed", "unsupported", "not_attempted"]}},
        "proposals": {"required": ["status", "attempted", "normalized", "duplicate_replacements", "count", "rejected"], "types": {"status": "str", "attempted": "int_or_null", "normalized": "int_or_null", "duplicate_replacements": "int_or_null", "count": "int_or_null", "rejected": "int"}, "enum": {"status": ["observed", "unsupported", "not_attempted"]}},
        "reviews": {"required": ["status", "attempted", "normalized", "duplicate_replacements", "count", "rejected"], "types": {"status": "str", "attempted": "int_or_null", "normalized": "int_or_null", "duplicate_replacements": "int_or_null", "count": "int_or_null", "rejected": "int"}, "enum": {"status": ["observed", "unsupported", "not_attempted"]}},
        "releases": {"required": ["status", "attempted", "normalized", "duplicate_replacements", "count", "rejected"], "types": {"status": "str", "attempted": "int_or_null", "normalized": "int_or_null", "duplicate_replacements": "int_or_null", "count": "int_or_null", "rejected": "int"}, "enum": {"status": ["observed", "unsupported", "not_attempted"]}}
      }
    },
    "pagination": {
      "required": ["issues", "proposals", "reviews", "releases"],
      "types": {"issues": "dict", "proposals": "dict", "reviews": "dict", "releases": "dict"},
      "nested": {
        "issues": {"required": ["next", "complete"], "types": {"next": "str_or_null", "complete": "bool"}},
        "proposals": {"required": ["next", "complete"], "types": {"next": "str_or_null", "complete": "bool"}},
        "reviews": {"required": ["next", "complete"], "types": {"next": "str_or_null", "complete": "bool"}},
        "releases": {"required": ["next", "complete"], "types": {"next": "str_or_null", "complete": "bool"}}
      }
    }
  },
  "items": {
    "events": {
      "required": ["kind", "native_id", "status", "created_at", "updated_at", "closed_at"],
      "types": {"kind": "str", "native_id": "str", "status": "str", "created_at": "int", "updated_at": "int_or_null", "closed_at": "int_or_null", "tag": "str", "url": "str", "pull_request": "int"},
      "enum": {"kind": ["issues", "proposals", "reviews", "releases"]}
