{
  "schema": "rh-jsonschema/1",
  "name": "forge-events-result",
  "targets": ["fixtures/connectors/forge-events-result.json", "fixtures/connectors/forge-events-repository-reviews-result.json"],
  "required": ["schema", "provider", "captured_at", "authorization", "capabilities", "events", "note"],
  "types": {
    "schema": "str", "provider": "str", "captured_at": "int", "authorization": "dict",
    "capabilities": "dict", "events": "list", "note": "str", "scope": "dict", "review_collection": "dict"
  },
  "enum": {
    "schema": ["rh-forge-events-result/1"],
    "provider": ["github", "gitlab", "gitea", "forgejo", "bitbucket"]
  },
  "nested": {
    "authorization": {
      "required": ["state"], "types": {"state": "str"},
      "enum": {"state": ["authorized", "unauthorized", "not_requested", "unknown"]}
    },
    "scope": {
      "types": {"repository": "str", "pull_request": "int"}
    },
    "review_collection": {
