{
  "schema": "rh-jsonschema/1",
  "name": "inventory-result",
  "targets": ["fixtures/inventory-results/*.json"],
  "type": "object",
  "required": ["schema", "format", "spec_version", "provenance", "status", "note"],
  "types": {"schema": "str", "format": "str", "spec_version": "str", "provenance": "dict", "status": "str", "reason": "str", "counts": "dict", "components": "list", "completeness": "dict", "metrics": "list", "note": "str"},
  "enum": {"schema": ["rh-inventory/1"], "format": ["cyclonedx", "spdx"], "status": ["observed", "unsupported"]},
  "nested": {
    "provenance": {
      "required": ["input_sha256", "origin", "locator_sha256"],
      "types": {"input_sha256": "str", "origin": "str", "locator_sha256": "str_or_null"},
      "enum": {"origin": ["local_input", "captured_url"]}
    },
    "counts": {
      "required": ["invalid", "with_purl", "with_hash", "digest_known", "unknown_top_keys"],
      "types": {"components": "int", "packages": "int", "invalid": "int", "with_purl": "int", "with_hash": "int", "digest_known": "int", "unknown_top_keys": "int"}
    },
    "completeness": {
      "required": ["dependency_assertions", "compositions"],
      "types": {"dependency_assertions": "dict", "compositions": "list"},
      "nested": {
        "dependency_assertions": {
          "required": ["state", "count", "complete", "incomplete", "unknown", "not_specified"],
          "types": {"state": "str", "count": "int", "complete": "int", "incomplete": "int", "unknown": "int", "not_specified": "int"},
          "enum": {"state": ["declared", "not_asserted"]}
        }
      },
      "items": {
        "compositions": {
          "required": ["aggregate", "assemblies", "dependencies", "vulnerabilities"],
          "types": {"aggregate": "str", "assemblies": "int", "dependencies": "int", "vulnerabilities": "int"}
        }
      }
    }
  },
  "items": {
    "components": {
      "required": ["name", "version", "purl", "digest_known"],
      "types": {"name": "str", "version": "str", "purl": "str", "digest_known": "bool"}
    },
    "metrics": {
      "required": ["key", "version", "status", "evidence"],
      "types": {"key": "str", "version": "str", "status": "str", "evidence": "list"},
      "enum": {"status": ["observed", "not_applicable"]}
    }
  }
}
