    "authorization": "dict", "collector_label": "str", "canonical_capability": "str", "pages": "list"
  },
  "enum": {
    "schema": ["rh-postgres-staged-forge-events-input/1"],
    "provider": ["github", "gitlab", "gitea", "forgejo", "bitbucket"],
    "canonical_capability": ["issues", "proposals", "releases"]
