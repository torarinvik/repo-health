      "types": {"page_number": "int", "committed": "bool", "completeness": "str", "records": "list"},
      "enum": {"completeness": ["complete", "empty"]},
      "items": {
        "records": {
          "required": ["record_ordinal", "collector_label", "raw_payload"],
          "types": {"record_ordinal": "int", "collector_label": "str", "raw_payload": "str"}
