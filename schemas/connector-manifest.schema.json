{
  "schema": "rh-jsonschema/1",
  "name": "connector-manifest",
  "targets": ["connectors/manifests/*.json"],
  "type": "object",
  "required": ["api_version", "auth_scopes", "capabilities", "connector_id", "connector_version", "pagination", "time_precision"],
  "types": {
    "api_version": "str",
    "auth_scopes": "list",
    "capabilities": "dict",
    "connector_id": "str",
    "connector_version": "str",
    "pagination": "str",
    "time_precision": "str"
  },
  "nested": {
    "capabilities": {
      "required": ["history", "issues", "permissions", "releases", "reviews", "traffic"],
      "types": {
        "history": "str",
        "issues": "str",
        "permissions": "str",
        "releases": "str",
        "reviews": "str",
        "traffic": "str"
      }
    }
  }
}
