{
  "schema": "rh-jsonschema/1",
  "name": "connector-manifest",
  "targets": ["connectors/manifests/*.json"],
  "type": "object",
  "required": ["api_version", "auth_scopes", "capabilities", "connector_id", "connector_version", "history_limits", "pagination", "rate_limit_handling", "source_version_constraints", "time_precision"],
  "types": {
    "api_version": "str",
    "auth_scopes": "list",
    "capabilities": "dict",
    "connector_id": "str",
    "connector_version": "str",
    "history_limits": "str",
    "pagination": "str",
    "rate_limit_handling": "str",
    "source_version_constraints": "str",
    "time_precision": "str"
  },
  "item_types": {
    "auth_scopes": "str"
  },
  "enum": {
    "rate_limit_handling": ["not-applicable", "respect-retry-after-and-per-host-quota"],
    "time_precision": ["second", "millisecond", "microsecond", "nanosecond", "source-native"]
  },
  "nested": {
    "capabilities": {
      "required": ["history", "issues", "permissions", "releases", "reviews", "traffic"],
      "types": {
        "history": "str",
        "issues": "str",
        "permissions": "str",
        "releases": "str",
        "reviews": "str",
        "traffic": "str"
      },
      "enum": {
        "history": ["generic-git", "fossil", "mercurial", "subversion", "unsupported"],
        "issues": ["read", "unsupported"],
        "permissions": ["authorized-only", "unsupported"],
        "releases": ["read", "release-feed", "unsupported"],
        "reviews": ["read", "unsupported"],
        "traffic": ["authorized-14-day-window", "unauthorized-in-m02-slice", "unsupported-no-traffic-api", "unsupported"]
      }
    }
  }
}
