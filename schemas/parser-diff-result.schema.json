{
  "schema": "rh-jsonschema/1",
  "name": "parser-diff-result",
  "targets": ["fixtures/parser-diff/result-*.json"],
  "type": "object",
  "required": ["schema", "status", "parsers", "inputs", "cache_key", "summary", "metrics", "mismatches", "note"],
  "allowed_keys": ["schema", "status", "reason", "parsers", "inputs", "cache_key", "summary", "metrics", "mismatches", "note"],
  "types": {"schema": "str", "status": "str", "reason": "str", "parsers": "dict", "inputs": "dict", "cache_key": "str", "summary": "dict", "metrics": "list", "mismatches": "list", "note": "str"},
  "enum": {"schema": ["rh-parser-diff/1"], "status": ["match", "different", "unsupported"]},
  "maximum_items": {"metrics": 2, "mismatches": 10000},
  "nested": {
    "parsers": {
      "required": ["native", "candidate", "configuration", "visibility"],
      "allowed_keys": ["native", "candidate", "configuration", "visibility"],
      "types": {"native": "str", "candidate": "str", "configuration": "str", "visibility": "str"}
    },
    "inputs": {
      "required": ["native_digest", "candidate_digest", "output_schema"],
      "allowed_keys": ["native_digest", "candidate_digest", "output_schema"],
      "types": {"native_digest": "str", "candidate_digest": "str", "output_schema": "str"},
      "enum": {"output_schema": ["rh-dep-graph/1"]}
    },
    "summary": {
      "required": ["mismatches"],
      "allowed_keys": ["mismatches", "mapping", "context", "parser_support", "normalization"],
      "types": {"mismatches": "int", "mapping": "int", "context": "int", "parser_support": "int", "normalization": "int"},
      "minimum": {"mismatches": 0, "mapping": 0, "context": 0, "parser_support": 0, "normalization": 0}
    }
  },
  "items": {
    "metrics": {
      "required": ["key", "version", "status", "value", "evidence", "quality_dimensions"],
      "allowed_keys": ["key", "version", "status", "value", "reason", "evidence", "quality_dimensions"],
      "types": {"key": "str", "version": "str", "status": "str", "value": "int_or_null", "reason": "str", "evidence": "list", "quality_dimensions": "dict"},
      "enum": {"key": ["coverage.parser_error_count", "coverage.mapping_conflict_count"], "version": ["1.0.0"], "status": ["observed", "unsupported"]},
      "maximum_items": {"evidence": 1},
      "item_types": {"evidence": "str"},
      "nested": {
        "quality_dimensions": {
          "required": ["completeness", "freshness", "validity", "provenance"],
          "allowed_keys": ["completeness", "freshness", "validity", "provenance"],
          "types": {"completeness": "str", "freshness": "str", "validity": "str", "provenance": "str"},
          "enum": {"completeness": ["complete", "unknown"], "freshness": ["unknown"], "validity": ["valid", "unknown"], "provenance": ["evidence_backed"]}
        }
      },
      "conditional": {
        "field": "status",
        "cases": {
          "observed": {"required": ["value"], "types": {"value": "int"}, "minimum": {"value": 0}, "nested": {"quality_dimensions": {"enum": {"completeness": ["complete"], "validity": ["valid"]}}}},
          "unsupported": {"required": ["reason"], "types": {"value": "null"}, "nested": {"quality_dimensions": {"enum": {"completeness": ["unknown"], "validity": ["unknown"]}}}}
        }
      }
    },
    "mismatches": {
      "required": ["class", "detail"],
      "allowed_keys": ["class", "detail"],
      "types": {"class": "str", "detail": "str"},
      "enum": {"class": ["mapping", "context", "parser_support", "normalization"]}
    }
  },
  "conditional": {
    "field": "status",
    "cases": {
      "match": {"nested": {"summary": {"required": ["mismatches", "mapping", "context", "parser_support", "normalization"]}}},
      "different": {"nested": {"summary": {"required": ["mismatches", "mapping", "context", "parser_support", "normalization"]}}},
      "unsupported": {"required": ["reason"]}
    }
  }
}
