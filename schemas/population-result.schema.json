      "allowed_keys": ["key", "version", "eligible", "observed", "partial", "unavailable", "unknown", "distribution", "policy_counts"],
      "types": {"key": "str", "version": "str", "eligible": "int", "observed": "int", "partial": "int", "unavailable": "int", "unknown": "int", "distribution": "dict", "policy_counts": "dict"},
      "minimum": {"eligible": 0, "observed": 0, "partial": 0, "unavailable": 0, "unknown": 0},
      "nested": {
        "distribution": {"required": ["count", "sum", "min", "max"], "allowed_keys": ["count", "sum", "min", "max"], "types": {"count": "int", "sum": "int", "min": "int_or_null", "max": "int_or_null"}, "minimum": {"count": 0, "sum": 0}},
        "policy_counts": {"required": ["pass", "fail", "unknown"], "allowed_keys": ["pass", "fail", "unknown"], "types": {"pass": "int", "fail": "int", "unknown": "int"}, "minimum": {"pass": 0, "fail": 0, "unknown": 0}}
