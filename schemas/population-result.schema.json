{
  "schema": "rh-jsonschema/1",
  "name": "population-result",
  "targets": ["fixtures/population/result.json"],
  "type": "object",
  "required": ["schema", "focal", "discovery", "mapping_revision", "project_identity_mapping", "deduplication_unit", "population", "dependents", "unresolved_count", "summary_metrics", "metrics", "note"],
  "allowed_keys": ["schema", "focal", "discovery", "mapping_revision", "project_identity_mapping", "deduplication_unit", "population", "dependents", "unresolved_count", "summary_metrics", "metrics", "note"],
  "types": {"schema": "str", "mapping_revision": "int", "deduplication_unit": "str", "dependents": "list", "unresolved_count": "int", "summary_metrics": "list", "metrics": "list", "note": "str"},
  "enum": {"schema": ["rh-population-result/2"]},
