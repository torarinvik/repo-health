    "discovery": {"required": ["source", "mode", "context", "as_of", "page_limit", "truncated"], "allowed_keys": ["source", "mode", "context", "as_of", "page_limit", "truncated", "provider_status", "replay_attempts"], "types": {"source": "str", "mode": "str", "context": "str", "as_of": "int", "page_limit": "int", "truncated": "bool", "provider_status": "str", "replay_attempts": "int"}, "minimum": {"as_of": 0, "page_limit": 1, "replay_attempts": 1}},
    "project_identity_mapping": {"required": ["revision", "selected", "accepted", "unknown", "distinct_accepted_families"], "allowed_keys": ["revision", "selected", "accepted", "unknown", "distinct_accepted_families"], "types": {"revision": "int", "selected": "int", "accepted": "int", "unknown": "int", "distinct_accepted_families": "int"}, "minimum": {"revision": 0, "selected": 0, "accepted": 0, "unknown": 0, "distinct_accepted_families": 0}},
    "population": {"required": ["selected_dependents", "distinct_families", "unresolved"], "allowed_keys": ["selected_dependents", "distinct_families", "unresolved"], "types": {"selected_dependents": "int", "distinct_families": "int", "unresolved": "int"}, "minimum": {"selected_dependents": 0, "distinct_families": 0, "unresolved": 0}}
  },
  "items": {
