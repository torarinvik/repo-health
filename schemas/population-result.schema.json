      "allowed_keys": ["id", "family", "package", "version", "relation", "published_package_count", "path_witness", "graph_node_id", "project_identity", "metrics"],
      "types": {"id": "str", "family": "str", "package": "str", "version": "str", "relation": "str", "published_package_count": "int", "path_witness": "list", "graph_node_id": "int", "project_identity": "dict", "metrics": "list"},
      "minimum": {"published_package_count": 1, "graph_node_id": 0},
      "enum": {"relation": ["direct", "transitive"]},
      "item_types": {"path_witness": "str"},
      "nested": {"project_identity": {"required": ["mapping_status", "project_id", "family_id", "reviewer_id", "reviewed_at", "evidence_sha256"], "allowed_keys": ["mapping_status", "project_id", "family_id", "reviewer_id", "reviewed_at", "evidence_sha256"], "types": {"mapping_status": "str", "project_id": "str_or_null", "family_id": "str_or_null", "reviewer_id": "int_or_null", "reviewed_at": "int_or_null", "evidence_sha256": "str_or_null"}, "enum": {"mapping_status": ["accepted", "unknown"]}}},
      "items": {"metrics": {"required": ["key", "version", "status", "value", "policy"], "allowed_keys": ["key", "version", "status", "value", "policy"], "types": {"key": "str", "version": "str", "status": "str", "value": "int_or_null", "policy": "str"}, "enum": {"status": ["observed", "partial", "unavailable", "unknown"], "policy": ["pass", "fail", "unknown"]}}}
    },
    "summary_metrics": {"required": ["key", "version", "status", "value", "evidence"], "allowed_keys": ["key", "version", "status", "value", "evidence"], "types": {"key": "str", "version": "str", "status": "str", "value": "int", "evidence": "list"}, "item_types": {"evidence": "str"}},
