# rh_postgres_ingest.elisa — durable execution of normalized PostgreSQL pages.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_temporal.elisa"
include "./rh_postgres.elisa"
include "./rh_postgres_report.elisa"

module PostgresIngest:
    private:
        const RH_PI_MAX_BYTES: usize = 4194304
        const RH_PI_MAX_PAGES: i64 = 1000
        const RH_PI_MAX_RECORDS: i64 = 10000
        const RH_PI_ROWS_EVENTS: u8 = 1
        const RH_PI_ROWS_SUBJECTS: u8 = 2
        const RH_PI_ROWS_ACTORS: u8 = 3

        def rh_pi_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_obj_get(nodes, texts, object, key)

        def rh_pi_eq(texts: darray[u8]&, start: i64, end: i64, literal: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, start, end, literal)

        def rh_pi_span(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64, key: u8&, start_out: mutable i64&, end_out: mutable i64&, allow_empty: bool) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            index: i64 = PostgresIngest::rh_pi_get(nodes, texts, object, key)
            return false if index < 0 or not Json::rh_json_str_span(nodes, index, start_out, end_out)
            return false if end_out[0] < start_out[0] or (not allow_empty and end_out[0] == start_out[0])
            while offset < end_out[0] - start_out[0] |offset: i64 = 0, texts, start_out, end_out|:
                return false if texts[(start_out[0] + offset).usize()] == 0
                offset <- offset + 1
            true

        def rh_pi_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, object: i64, key: u8&, minimum: i64, maximum: i64, value_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            index: i64 = PostgresIngest::rh_pi_get(nodes, texts, object, key)
            ok: mutable i64 = 0
            value: i64 = Json::rh_json_int(nodes, raw, index, &ok)
            return false if ok == 0 or value < minimum or value > maximum
            value_out[0] <- value
            true

        def rh_pi_text(texts: darray[u8]&, start: i64, end: i64) -> mutable darray[u8] can[Memory.Allocate, Abort.Panic]:
            bytes: mutable darray[u8] = []
            while offset < end - start |offset: i64 = 0, bytes, texts, end, start|:
                bytes.push(texts[(start + offset).usize()])
                offset <- offset + 1
            bytes.push(0)
            bytes

        def rh_pi_json_root(texts: darray[u8]&, start: i64, end: i64, expected_kind: u8, count_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            return false if end <= start or end - start > 1048576
            raw: mutable darray[u8] = []
            while offset < end - start |offset: i64 = 0, raw, texts, start, end|:
                raw.push(texts[(start + offset).usize()])
                offset <- offset + 1
            nodes: mutable darray[Json::RhJsonNode] = []
            decoded: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, decoded)
            return false if root < 0 or nodes[root.usize()].kind != expected_kind
            count_out[0] <- nodes[root.usize()].child_count
            true

        def rh_pi_string_field(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64, key: u8&, minimum: i64, maximum: i64) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            index: i64 = PostgresIngest::rh_pi_get(nodes, texts, object, key)
            return false if index < 0 or nodes[index.usize()].kind != Json::RH_JSON_STR
            node: Json::RhJsonNode = nodes[index.usize()]
            length: i64 = node.text_end - node.text_start
            return false if length < minimum or length > maximum
            while offset < length |offset: i64 = 0, texts, node|:
                return false if texts[(node.text_start + offset).usize()] == 0
                offset <- offset + 1
            true

        def rh_pi_uuid(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if end - start != 36
            while index < 36 |index: i64 = 0, texts, start|:
                byte: u8 = texts[(start + index).usize()]
                if index == 8 or index == 13 or index == 18 or index == 23:
                    return false if byte != 45
                else:
                    hex: bool = (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 70) or (byte >= 97 and byte <= 102)
                    return false if not hex
                index <- index + 1
            true

        def rh_pi_digits(texts: darray[u8]&, start: i64, end: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if start < 0 or end <= start or end > texts.count.i64()
            first: u8 = texts[start.usize()]
            return -1 if first < 48 or first > 57
            valid: mutable i64 = 0
            value: i64 = Base::rh_parse_i64(texts, start.usize(), end.usize(), &valid)
            value if valid != 0 else -1

        def rh_pi_timestamp(texts: darray[u8]&, start: i64, end: i64, epoch_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            length: i64 = end - start
            return false if length != 20 and length != 25
            return false if texts[(start + 4).usize()] != 45 or texts[(start + 7).usize()] != 45 or texts[(start + 10).usize()] != 84 or texts[(start + 13).usize()] != 58 or texts[(start + 16).usize()] != 58
            year: i64 = PostgresIngest::rh_pi_digits(texts, start, start + 4)
            month: i64 = PostgresIngest::rh_pi_digits(texts, start + 5, start + 7)
            day: i64 = PostgresIngest::rh_pi_digits(texts, start + 8, start + 10)
            hour: i64 = PostgresIngest::rh_pi_digits(texts, start + 11, start + 13)
            minute: i64 = PostgresIngest::rh_pi_digits(texts, start + 14, start + 16)
            second: i64 = PostgresIngest::rh_pi_digits(texts, start + 17, start + 19)
            return false if year < 1 or month < 1 or month > 12 or day < 1 or hour < 0 or hour > 23 or minute < 0 or minute > 59 or second < 0 or second > 59
            days_in_month: i64 =
                if month == 2:
                    leap: bool = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
                    29 if leap else 28
                elif month == 4 or month == 6 or month == 9 or month == 11:
                    30
                else:
                    31
            return false if day > days_in_month
            offset: mutable i64 = 0
            zone: u8 = texts[(start + 19).usize()]
            if length == 20:
                return false if zone != 90
            else:
                return false if zone != 43 and zone != 45 or texts[(start + 22).usize()] != 58
                zone_hour: i64 = PostgresIngest::rh_pi_digits(texts, start + 20, start + 22)
                zone_minute: i64 = PostgresIngest::rh_pi_digits(texts, start + 23, start + 25)
                return false if zone_hour < 0 or zone_hour > 14 or zone_minute < 0 or zone_minute > 59 or (zone_hour == 14 and zone_minute != 0)
                offset <- zone_hour * 3600 + zone_minute * 60
                offset <- 0 - offset if zone == 45
            epoch_out[0] <- Temporal::rh_days_from_civil(year, month, day) * 86400 + hour * 3600 + minute * 60 + second - offset
            true

        def rh_pi_timestamp_field(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64, key: u8&, epoch_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            valid: bool =
                start: mutable i64 = 0
                end: mutable i64 = 0
                PostgresIngest::rh_pi_span(nodes, texts, object, key, &start, &end, false) and PostgresIngest::rh_pi_timestamp(texts, start, end, epoch_out)
            valid

        def rh_pi_nullable_timestamp_field(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64, key: u8&, allow_missing: bool) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            index: i64 = PostgresIngest::rh_pi_get(nodes, texts, object, key)
            return allow_missing if index < 0
            return true if nodes[index.usize()].kind == Json::RH_JSON_NULL
            return false if nodes[index.usize()].kind != Json::RH_JSON_STR
            valid: bool =
                start: mutable i64 = 0
                end: mutable i64 = 0
                epoch: mutable i64 = 0
                Json::rh_json_str_span(nodes, index, &start, &end) and PostgresIngest::rh_pi_timestamp(texts, start, end, &epoch)
            valid

        def rh_pi_uuid_field(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64, key: u8&) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            valid: bool =
                start: mutable i64 = 0
                end: mutable i64 = 0
                PostgresIngest::rh_pi_span(nodes, texts, object, key, &start, &end, false) and PostgresIngest::rh_pi_uuid(texts, start, end)
            valid

        def rh_pi_visibility_field(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64, key: u8&) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            valid: bool =
                start: mutable i64 = 0
                end: mutable i64 = 0
                if not PostgresIngest::rh_pi_span(nodes, texts, object, key, &start, &end, false):
                    false
                else:
                    PostgresIngest::rh_pi_eq(texts, start, end, "public") or PostgresIngest::rh_pi_eq(texts, start, end, "tenant-private") or PostgresIngest::rh_pi_eq(texts, start, end, "restricted-personal") or PostgresIngest::rh_pi_eq(texts, start, end, "embargoed-security") or PostgresIngest::rh_pi_eq(texts, start, end, "suppressed")
            valid

        def rh_pi_nullable_string_field(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64, key: u8&, allow_missing: bool, require_nonempty: bool, uuid_when_string: bool, maximum: i64) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            index: i64 = PostgresIngest::rh_pi_get(nodes, texts, object, key)
            return allow_missing if index < 0
            return true if nodes[index.usize()].kind == Json::RH_JSON_NULL
            return false if nodes[index.usize()].kind != Json::RH_JSON_STR
            node: Json::RhJsonNode = nodes[index.usize()]
            length: i64 = node.text_end - node.text_start
            return false if length > maximum or (require_nonempty and length == 0)
            while offset < length |offset: i64 = 0, texts, node, uuid_when_string|:
                return false if texts[(node.text_start + offset).usize()] == 0
                offset <- offset + 1
            return false if uuid_when_string and length > 0 and not PostgresIngest::rh_pi_uuid(texts, node.text_start, node.text_end)
            true

        def rh_pi_event_valid(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            return false if nodes[object.usize()].kind != Json::RH_JSON_OBJ
            return false if not PostgresIngest::rh_pi_string_field(nodes, texts, object, "source_object_type", 1, 4096)
            return false if not PostgresIngest::rh_pi_string_field(nodes, texts, object, "source_object_id", 1, 4096)
            return false if not PostgresIngest::rh_pi_string_field(nodes, texts, object, "source_revision", 1, 4096)
            return false if not PostgresIngest::rh_pi_string_field(nodes, texts, object, "event_kind", 1, 128)
            return false if not PostgresIngest::rh_pi_uuid_field(nodes, texts, object, "subject_id")
            observed_valid: bool =
                epoch: mutable i64 = 0
                PostgresIngest::rh_pi_timestamp_field(nodes, texts, object, "observed_at", &epoch)
            return false if not observed_valid
            return false if not PostgresIngest::rh_pi_uuid_field(nodes, texts, object, "evidence_id")
            return false if not PostgresIngest::rh_pi_string_field(nodes, texts, object, "parser_version", 1, 128)
            return false if not PostgresIngest::rh_pi_nullable_string_field(nodes, texts, object, "actor_account_id", true, false, true, 64)
            return false if not PostgresIngest::rh_pi_nullable_timestamp_field(nodes, texts, object, "occurred_at", true)
            return false if not PostgresIngest::rh_pi_kind_field(nodes, texts, object, "payload", Json::RH_JSON_OBJ)
            basis_start: mutable i64 = 0
            basis_end: mutable i64 = 0
            return false if not PostgresIngest::rh_pi_span(nodes, texts, object, "time_basis", &basis_start, &basis_end, false)
            PostgresIngest::rh_pi_eq(texts, basis_start, basis_end, "event") or PostgresIngest::rh_pi_eq(texts, basis_start, basis_end, "observation") or PostgresIngest::rh_pi_eq(texts, basis_start, basis_end, "unknown")

        def rh_pi_kind_field(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64, key: u8&, expected: u8) -> bool can[Memory.Allocate, Abort.Panic]:
            index: i64 = PostgresIngest::rh_pi_get(nodes, texts, object, key)
            index >= 0 and nodes[index.usize()].kind == expected

        def rh_pi_subject_valid(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            created_valid: bool =
                epoch: mutable i64 = 0
                PostgresIngest::rh_pi_timestamp_field(nodes, texts, object, "created_at", &epoch)
            nodes[object.usize()].kind == Json::RH_JSON_OBJ and PostgresIngest::rh_pi_uuid_field(nodes, texts, object, "id") and PostgresIngest::rh_pi_string_field(nodes, texts, object, "entity_kind", 1, 4096) and PostgresIngest::rh_pi_visibility_field(nodes, texts, object, "visibility_scope") and created_valid

        def rh_pi_actor_valid(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            return false if nodes[object.usize()].kind != Json::RH_JSON_OBJ
            return false if not PostgresIngest::rh_pi_uuid_field(nodes, texts, object, "id")
            return false if not PostgresIngest::rh_pi_string_field(nodes, texts, object, "source_native_id", 1, 4096)
            return false if not PostgresIngest::rh_pi_visibility_field(nodes, texts, object, "visibility_scope")
            return false if not PostgresIngest::rh_pi_nullable_string_field(nodes, texts, object, "display_name", false, false, false, 4096)
            return false if not PostgresIngest::rh_pi_nullable_string_field(nodes, texts, object, "raw_identity_evidence_id", false, false, true, 64)
            kind_start: mutable i64 = 0
            kind_end: mutable i64 = 0
            return false if not PostgresIngest::rh_pi_span(nodes, texts, object, "account_kind", &kind_start, &kind_end, false)
            PostgresIngest::rh_pi_eq(texts, kind_start, kind_end, "human") or PostgresIngest::rh_pi_eq(texts, kind_start, kind_end, "bot") or PostgresIngest::rh_pi_eq(texts, kind_start, kind_end, "service") or PostgresIngest::rh_pi_eq(texts, kind_start, kind_end, "organization") or PostgresIngest::rh_pi_eq(texts, kind_start, kind_end, "unknown")

        def rh_pi_rows_valid(texts: darray[u8]&, start: i64, end: i64, row_kind: u8, count_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            return false if end <= start or end - start > 1048576
            raw: mutable darray[u8] = []
            while offset < end - start |offset: i64 = 0, raw, texts, start, end|:
                raw.push(texts[(start + offset).usize()])
                offset <- offset + 1
            rows: mutable darray[Json::RhJsonNode] = []
            decoded: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, rows, decoded)
            return false if root < 0 or rows[root.usize()].kind != Json::RH_JSON_ARR or rows[root.usize()].child_count > RH_PI_MAX_RECORDS
            while row >= 0 |row: i64 = rows[root.usize()].first_child, rows, decoded, row_kind|:
                valid: bool =
                    if row_kind == RH_PI_ROWS_EVENTS:
                        PostgresIngest::rh_pi_event_valid(rows, decoded, row)
                    elif row_kind == RH_PI_ROWS_SUBJECTS:
                        PostgresIngest::rh_pi_subject_valid(rows, decoded, row)
                    elif row_kind == RH_PI_ROWS_ACTORS:
                        PostgresIngest::rh_pi_actor_valid(rows, decoded, row)
                    else:
                        false
                return false if not valid
                row <- rows[row.usize()].next_sibling
            count_out[0] <- rows[root.usize()].child_count
            true

        def rh_pi_staged_records_valid(texts: darray[u8]&, start: i64, end: i64, count_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release]:
            return false if end <= start or end - start > 8388608
            raw: mutable darray[u8] = []
            while offset < end - start |offset: i64 = 0, raw, texts, start, end|:
                raw.push(texts[(start + offset).usize()])
                offset <- offset + 1
            rows: mutable darray[Json::RhJsonNode] = []
            decoded: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, rows, decoded)
            return false if root < 0 or rows[root.usize()].kind != Json::RH_JSON_ARR or rows[root.usize()].child_count > RH_PI_MAX_RECORDS
            total_payload_bytes: mutable i64 = 0
            while row >= 0 |row: i64 = rows[root.usize()].first_child, rows, decoded, total_payload_bytes|:
                return false if rows[row.usize()].kind != Json::RH_JSON_OBJ
                return false if not PostgresIngest::rh_pi_string_field(rows, decoded, row, "collector_label", 1, 4096)
                return false if not PostgresIngest::rh_pi_string_field(rows, decoded, row, "raw_payload", 1, 1048576)
                payload_index: i64 = PostgresIngest::rh_pi_get(rows, decoded, row, "raw_payload")
                payload_node: Json::RhJsonNode = rows[payload_index.usize()]
                total_payload_bytes <- total_payload_bytes + payload_node.text_end - payload_node.text_start
                return false if total_payload_bytes > 4194304
                payload: mutable darray[u8] = []
                while offset < payload_node.text_end - payload_node.text_start |offset: i64 = 0, payload, decoded, payload_node|:
                    payload.push(decoded[(payload_node.text_start + offset).usize()])
                    offset <- offset + 1
                payload_nodes: mutable darray[Json::RhJsonNode] = []
                payload_texts: mutable darray[u8] = []
                payload_root: i64 = Json::rh_json_parse(payload, payload_nodes, payload_texts)
                return false if payload_root < 0 or payload_nodes[payload_root.usize()].kind != Json::RH_JSON_OBJ
                row <- rows[row.usize()].next_sibling
            count_out[0] <- rows[root.usize()].child_count
            true

        def rh_pi_emit_span(out: mutable darray[u8]&, texts: darray[u8]&, start: i64, end: i64) -> void can[Memory.Allocate, Abort.Panic]:
            out.push(34)
            Base::rh_json_escape(out, texts, start.usize(), end.usize())
            out.push(34)

        def rh_pi_emit_cstr(out: mutable darray[u8]&, bytes: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.push(34)
            Base::rh_json_escape(out, bytes, 0, bytes.count - 1)
            out.push(34)

    public:
        # This accepts normalized pages and explicitly marked raw-stage pages.
        # Acquisition and normalization stay outside short database transactions.
        def rh_postgres_ingest_report(raw: darray[u8]&, conninfo: cstr, evidence_root: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            return -1 if raw.count == 0 or raw.count > RH_PI_MAX_BYTES
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ

            schema_start: mutable i64 = 0
            schema_end: mutable i64 = 0
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "schema", &schema_start, &schema_end, false)
            return -1 if not PostgresIngest::rh_pi_eq(texts, schema_start, schema_end, "rh-postgres-ingest-input/1")

            source_start: mutable i64 = 0
            source_end: mutable i64 = 0
            source_kind_start: mutable i64 = 0
            source_kind_end: mutable i64 = 0
            base_url_start: mutable i64 = 0
            base_url_end: mutable i64 = 0
            visibility_start: mutable i64 = 0
            visibility_end: mutable i64 = 0
            source_created_start: mutable i64 = 0
            source_created_end: mutable i64 = 0
            run_start: mutable i64 = 0
            run_end: mutable i64 = 0
            capability_start: mutable i64 = 0
            capability_end: mutable i64 = 0
            connector_start: mutable i64 = 0
            connector_end: mutable i64 = 0
            connector_version_start: mutable i64 = 0
            connector_version_end: mutable i64 = 0
            requested_start: mutable i64 = 0
            requested_start_end: mutable i64 = 0
            requested_end: mutable i64 = 0
            requested_end_end: mutable i64 = 0
            started_start: mutable i64 = 0
            started_end: mutable i64 = 0
            job_start: mutable i64 = 0
            job_end: mutable i64 = 0
            worker_start: mutable i64 = 0
            worker_end: mutable i64 = 0
            next_attempt_start: mutable i64 = 0
            next_attempt_end: mutable i64 = 0
            created_start: mutable i64 = 0
            created_end: mutable i64 = 0
            claim_now_start: mutable i64 = 0
            claim_now_end: mutable i64 = 0
            finish_now_start: mutable i64 = 0
            finish_now_end: mutable i64 = 0
            job_state_start: mutable i64 = 0
            job_state_end: mutable i64 = 0
            run_status_start: mutable i64 = 0
            run_status_end: mutable i64 = 0
            run_completeness_start: mutable i64 = 0
            run_completeness_end: mutable i64 = 0
            coverage_start: mutable i64 = 0
            coverage_end: mutable i64 = 0
            outcome_start: mutable i64 = 0
            outcome_end: mutable i64 = 0
            error_start: mutable i64 = 0
            error_end: mutable i64 = 0
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "source_id", &source_start, &source_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "source_kind", &source_kind_start, &source_kind_end, false) or source_kind_end - source_kind_start > 128
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "source_base_url", &base_url_start, &base_url_end, false) or base_url_end - base_url_start > 2048
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "visibility_scope", &visibility_start, &visibility_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "source_created_at", &source_created_start, &source_created_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "run_id", &run_start, &run_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "capability", &capability_start, &capability_end, false) or capability_end - capability_start > 128
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "connector_name", &connector_start, &connector_end, false) or connector_end - connector_start > 128
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "connector_version", &connector_version_start, &connector_version_end, false) or connector_version_end - connector_version_start > 128
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "requested_start", &requested_start, &requested_start_end, true)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "requested_end", &requested_end, &requested_end_end, true)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "started_at", &started_start, &started_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "job_id", &job_start, &job_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "worker_id", &worker_start, &worker_end, false) or worker_end - worker_start > 256
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "next_attempt_at", &next_attempt_start, &next_attempt_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "created_at", &created_start, &created_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "claim_now", &claim_now_start, &claim_now_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "finish_now", &finish_now_start, &finish_now_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "job_state", &job_state_start, &job_state_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "run_status", &run_status_start, &run_status_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "run_completeness", &run_completeness_start, &run_completeness_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "coverage_details", &coverage_start, &coverage_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "outcome", &outcome_start, &outcome_end, false)
            return -1 if not PostgresIngest::rh_pi_span(nodes, texts, root, "error_kind", &error_start, &error_end, true)
            return -1 if not PostgresIngest::rh_pi_uuid_field(nodes, texts, root, "source_id") or not PostgresIngest::rh_pi_uuid_field(nodes, texts, root, "run_id") or not PostgresIngest::rh_pi_uuid_field(nodes, texts, root, "job_id")
            return -1 if not PostgresIngest::rh_pi_visibility_field(nodes, texts, root, "visibility_scope")
            source_created_epoch: mutable i64 = 0
            started_epoch: mutable i64 = 0
            created_epoch: mutable i64 = 0
            next_attempt_epoch: mutable i64 = 0
            claim_epoch: mutable i64 = 0
            finish_epoch: mutable i64 = 0
            return -1 if not PostgresIngest::rh_pi_timestamp_field(nodes, texts, root, "source_created_at", &source_created_epoch)
            return -1 if not PostgresIngest::rh_pi_timestamp_field(nodes, texts, root, "started_at", &started_epoch)
            return -1 if not PostgresIngest::rh_pi_timestamp_field(nodes, texts, root, "created_at", &created_epoch)
            return -1 if not PostgresIngest::rh_pi_timestamp_field(nodes, texts, root, "next_attempt_at", &next_attempt_epoch)
            return -1 if not PostgresIngest::rh_pi_timestamp_field(nodes, texts, root, "claim_now", &claim_epoch)
            return -1 if not PostgresIngest::rh_pi_timestamp_field(nodes, texts, root, "finish_now", &finish_epoch)
            requested_start_epoch: mutable i64 = 0
            requested_end_epoch: mutable i64 = 0
            return -1 if requested_start_end > requested_start and not PostgresIngest::rh_pi_timestamp(texts, requested_start, requested_start_end, &requested_start_epoch)
            return -1 if requested_end_end > requested_end and not PostgresIngest::rh_pi_timestamp(texts, requested_end, requested_end_end, &requested_end_epoch)
            return -1 if requested_start_end > requested_start and requested_end_end > requested_end and requested_start_epoch > requested_end_epoch
            return -1 if source_created_epoch > started_epoch or started_epoch > claim_epoch or created_epoch > claim_epoch or next_attempt_epoch > claim_epoch
            return -1 if finish_epoch <= claim_epoch
            partial_run: bool = PostgresIngest::rh_pi_eq(texts, run_status_start, run_status_end, "partial")
            failed_run: bool = PostgresIngest::rh_pi_eq(texts, run_status_start, run_status_end, "failed")
            canceled_run: bool = PostgresIngest::rh_pi_eq(texts, run_status_start, run_status_end, "canceled")
            incomplete_run: bool = partial_run or failed_run or canceled_run
            incomplete_completeness: bool = PostgresIngest::rh_pi_eq(texts, run_completeness_start, run_completeness_end, "partial") or PostgresIngest::rh_pi_eq(texts, run_completeness_start, run_completeness_end, "unknown")
            terminal_state_valid: bool =
                if partial_run:
                    PostgresIngest::rh_pi_eq(texts, job_state_start, job_state_end, "succeeded") and incomplete_completeness
                elif failed_run:
                    (PostgresIngest::rh_pi_eq(texts, job_state_start, job_state_end, "failed") or PostgresIngest::rh_pi_eq(texts, job_state_start, job_state_end, "dead_letter")) and incomplete_completeness
                elif canceled_run:
                    PostgresIngest::rh_pi_eq(texts, job_state_start, job_state_end, "canceled") and incomplete_completeness
                else:
                    PostgresIngest::rh_pi_eq(texts, job_state_start, job_state_end, "succeeded") and PostgresIngest::rh_pi_eq(texts, run_status_start, run_status_end, "succeeded") and (PostgresIngest::rh_pi_eq(texts, run_completeness_start, run_completeness_end, "complete") or PostgresIngest::rh_pi_eq(texts, run_completeness_start, run_completeness_end, "empty")) and PostgresIngest::rh_pi_eq(texts, error_start, error_end, "")
            return -1 if not terminal_state_valid

            configuration_revision: mutable i64 = 0
            return -1 if not PostgresIngest::rh_pi_int(nodes, raw, texts, root, "configuration_revision", 1, 9223372036854775807, &configuration_revision)
            priority: mutable i64 = 0
            return -1 if not PostgresIngest::rh_pi_int(nodes, raw, texts, root, "priority", -2147483648, 2147483647, &priority)
            lease_seconds: mutable i64 = 0
            return -1 if not PostgresIngest::rh_pi_int(nodes, raw, texts, root, "lease_seconds", 1, 86400, &lease_seconds)
            return -1 if finish_epoch - claim_epoch >= lease_seconds

            coverage_valid: bool =
                count: mutable i64 = 0
                PostgresIngest::rh_pi_json_root(texts, coverage_start, coverage_end, Json::RH_JSON_OBJ, &count)
            return -1 if not coverage_valid
            evidence_objects_index: i64 = PostgresIngest::rh_pi_get(nodes, texts, root, "evidence_objects")
            if evidence_objects_index >= 0:
                return -1 if nodes[evidence_objects_index.usize()].kind != Json::RH_JSON_ARR or nodes[evidence_objects_index.usize()].child_count > RH_PI_MAX_PAGES
                return -1 if nodes[evidence_objects_index.usize()].child_count > 0 and Base::rh_cstr_len_c(evidence_root) == 0
            pages_index: i64 = PostgresIngest::rh_pi_get(nodes, texts, root, "pages")
            return -1 if pages_index < 0 or nodes[pages_index.usize()].kind != Json::RH_JSON_ARR or nodes[pages_index.usize()].child_count > RH_PI_MAX_PAGES or (nodes[pages_index.usize()].child_count == 0 and not incomplete_run)
            expected_page: mutable i64 = 0
            complete_pages: mutable i64 = 0
            previous_page_commit: mutable i64 = claim_epoch
            scope_start: mutable i64 = 0
            scope_end: mutable i64 = 0
            while page >= 0 |page: i64 = nodes[pages_index.usize()].first_child, nodes, texts, raw, expected_page, complete_pages, previous_page_commit, scope_start, scope_end, claim_epoch, finish_epoch|:
                return -1 if nodes[page.usize()].kind != Json::RH_JSON_OBJ
                page_number: mutable i64 = 0
                return -1 if not PostgresIngest::rh_pi_int(nodes, raw, texts, page, "page_number", 0, 2147483647, &page_number) or page_number != expected_page
                scope_page_start: mutable i64 = 0
                scope_page_end: mutable i64 = 0
                return -1 if not PostgresIngest::rh_pi_span(nodes, texts, page, "scope_hash", &scope_page_start, &scope_page_end, false) or scope_page_end - scope_page_start > 1024
                if expected_page == 0:
                    scope_start <- scope_page_start
                    scope_end <- scope_page_end
                else:
                    return -1 if not Base::rh_bytes_equal_span(texts, scope_start, scope_end, texts, scope_page_start, scope_page_end)
                before_start: mutable i64 = 0
                before_end: mutable i64 = 0
                after_start: mutable i64 = 0
                after_end: mutable i64 = 0
                completeness_start: mutable i64 = 0
                completeness_end: mutable i64 = 0
                record_mode_start: mutable i64 = 0
                record_mode_end: mutable i64 = 0
                staged_records_start: mutable i64 = 0
                staged_records_end: mutable i64 = 0
                evidence_start: mutable i64 = 0
                evidence_end: mutable i64 = 0
                events_start: mutable i64 = 0
                events_end: mutable i64 = 0
                subjects_start: mutable i64 = 0
                subjects_end: mutable i64 = 0
                actors_start: mutable i64 = 0
                actors_end: mutable i64 = 0
                now_start: mutable i64 = 0
                now_end: mutable i64 = 0
                return -1 if not PostgresIngest::rh_pi_span(nodes, texts, page, "cursor_before", &before_start, &before_end, true)
                return -1 if not PostgresIngest::rh_pi_span(nodes, texts, page, "cursor_after", &after_start, &after_end, false)
                return -1 if not PostgresIngest::rh_pi_span(nodes, texts, page, "completeness", &completeness_start, &completeness_end, false)
                return -1 if not PostgresIngest::rh_pi_eq(texts, completeness_start, completeness_end, "complete") and not PostgresIngest::rh_pi_eq(texts, completeness_start, completeness_end, "empty")
                record_mode_index: i64 = PostgresIngest::rh_pi_get(nodes, texts, page, "record_mode")
                if record_mode_index >= 0:
                    return -1 if not Json::rh_json_str_span(nodes, record_mode_index, &record_mode_start, &record_mode_end)
                    return -1 if not PostgresIngest::rh_pi_eq(texts, record_mode_start, record_mode_end, "normalized") and not PostgresIngest::rh_pi_eq(texts, record_mode_start, record_mode_end, "staged")
                staged_records_index: i64 = PostgresIngest::rh_pi_get(nodes, texts, page, "staged_records_json")
                staged_page: bool = record_mode_index >= 0 and PostgresIngest::rh_pi_eq(texts, record_mode_start, record_mode_end, "staged")
                return -1 if staged_page and staged_records_index < 0
                return -1 if not staged_page and staged_records_index >= 0
                if staged_page:
                    return -1 if not PostgresIngest::rh_pi_span(nodes, texts, page, "staged_records_json", &staged_records_start, &staged_records_end, false)
                return -1 if not PostgresIngest::rh_pi_span(nodes, texts, page, "evidence_id", &evidence_start, &evidence_end, true)
                return -1 if not PostgresIngest::rh_pi_span(nodes, texts, page, "events_json", &events_start, &events_end, false)
                return -1 if not PostgresIngest::rh_pi_span(nodes, texts, page, "subjects_json", &subjects_start, &subjects_end, false)
                return -1 if not PostgresIngest::rh_pi_span(nodes, texts, page, "actors_json", &actors_start, &actors_end, false)
                return -1 if not PostgresIngest::rh_pi_span(nodes, texts, page, "committed_at", &now_start, &now_end, false)
                committed_epoch: mutable i64 = 0
                return -1 if not PostgresIngest::rh_pi_timestamp(texts, now_start, now_end, &committed_epoch) or committed_epoch < claim_epoch or committed_epoch > finish_epoch or committed_epoch < previous_page_commit
                previous_page_commit <- committed_epoch
                record_count: mutable i64 = 0
                return -1 if not PostgresIngest::rh_pi_int(nodes, raw, texts, page, "record_count", 0, RH_PI_MAX_RECORDS, &record_count)
                discard_count: mutable i64 = 0
                events_count, events_valid =
                    count: mutable i64 = 0
                    valid: bool = PostgresIngest::rh_pi_rows_valid(texts, events_start, events_end, RH_PI_ROWS_EVENTS, &count)
                    count, valid
                return -1 if not events_valid
                if staged_page:
                    staged_record_count: mutable i64 = 0
                    return -1 if not PostgresIngest::rh_pi_staged_records_valid(texts, staged_records_start, staged_records_end, &staged_record_count) or staged_record_count != record_count
                    return -1 if events_count != 0
                else:
                    return -1 if events_count != record_count
                subjects_count, subjects_valid =
                    count: mutable i64 = 0
                    valid: bool = PostgresIngest::rh_pi_rows_valid(texts, subjects_start, subjects_end, RH_PI_ROWS_SUBJECTS, &count)
                    count, valid
                actors_count, actors_valid =
                    count: mutable i64 = 0
                    valid: bool = PostgresIngest::rh_pi_rows_valid(texts, actors_start, actors_end, RH_PI_ROWS_ACTORS, &count)
                    count, valid
                return -1 if not subjects_valid or not actors_valid
                return -1 if staged_page and (subjects_count != 0 or actors_count != 0)
                return -1 if before_end > before_start and not PostgresIngest::rh_pi_json_root(texts, before_start, before_end, Json::RH_JSON_OBJ, &discard_count)
                return -1 if not PostgresIngest::rh_pi_json_root(texts, after_start, after_end, Json::RH_JSON_OBJ, &discard_count)
                return -1 if evidence_end > evidence_start and not PostgresIngest::rh_pi_uuid(texts, evidence_start, evidence_end)
                return -1 if PostgresIngest::rh_pi_eq(texts, completeness_start, completeness_end, "empty") and record_count != 0
                complete_pages <- complete_pages + 1 if PostgresIngest::rh_pi_eq(texts, completeness_start, completeness_end, "complete")
                expected_page <- expected_page + 1
                page <- nodes[page.usize()].next_sibling
            return -1 if not incomplete_run and ((complete_pages == 0 and not PostgresIngest::rh_pi_eq(texts, run_completeness_start, run_completeness_end, "empty")) or (complete_pages > 0 and not PostgresIngest::rh_pi_eq(texts, run_completeness_start, run_completeness_end, "complete")))

            if evidence_objects_index >= 0 and nodes[evidence_objects_index.usize()].child_count > 0:
                return -1 if PostgresReport::rh_postgres_register_ingest_evidence(raw, conninfo, evidence_root) != 0

            started: i64 =
                source_id: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, source_start, source_end)
                source_kind: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, source_kind_start, source_kind_end)
                base_url: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, base_url_start, base_url_end)
                visibility: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, visibility_start, visibility_end)
                source_created: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, source_created_start, source_created_end)
                run_id: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, run_start, run_end)
                capability: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, capability_start, capability_end)
                connector: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, connector_start, connector_end)
                connector_version: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, connector_version_start, connector_version_end)
                requested_start_text: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, requested_start, requested_start_end)
                requested_end_text: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, requested_end, requested_end_end)
                started_at: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, started_start, started_end)
                source_id_ptr: cstr = (&source_id[0]).cast[cstr] can Unsafe.PointerCast
                source_kind_ptr: cstr = (&source_kind[0]).cast[cstr] can Unsafe.PointerCast
                base_url_ptr: cstr = (&base_url[0]).cast[cstr] can Unsafe.PointerCast
                visibility_ptr: cstr = (&visibility[0]).cast[cstr] can Unsafe.PointerCast
                source_created_ptr: cstr = (&source_created[0]).cast[cstr] can Unsafe.PointerCast
                run_id_ptr: cstr = (&run_id[0]).cast[cstr] can Unsafe.PointerCast
                capability_ptr: cstr = (&capability[0]).cast[cstr] can Unsafe.PointerCast
                connector_ptr: cstr = (&connector[0]).cast[cstr] can Unsafe.PointerCast
                connector_version_ptr: cstr = (&connector_version[0]).cast[cstr] can Unsafe.PointerCast
                requested_start_ptr: cstr = (&requested_start_text[0]).cast[cstr] can Unsafe.PointerCast
                requested_end_ptr: cstr = (&requested_end_text[0]).cast[cstr] can Unsafe.PointerCast
                started_at_ptr: cstr = (&started_at[0]).cast[cstr] can Unsafe.PointerCast
                Postgres::rh_pg_begin_collection_run(conninfo, source_id_ptr, source_kind_ptr, base_url_ptr, visibility_ptr, configuration_revision, source_created_ptr, run_id_ptr, capability_ptr, connector_ptr, connector_version_ptr, requested_start_ptr, requested_end_ptr, started_at_ptr)
            return -1 if started < 0

            queued: i64 =
                run_id: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, run_start, run_end)
                job_id: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, job_start, job_end)
                next_attempt: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, next_attempt_start, next_attempt_end)
                created_at: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, created_start, created_end)
                run_id_ptr: cstr = (&run_id[0]).cast[cstr] can Unsafe.PointerCast
                job_id_ptr: cstr = (&job_id[0]).cast[cstr] can Unsafe.PointerCast
                next_attempt_ptr: cstr = (&next_attempt[0]).cast[cstr] can Unsafe.PointerCast
                created_at_ptr: cstr = (&created_at[0]).cast[cstr] can Unsafe.PointerCast
                Postgres::rh_pg_enqueue_collection_job(conninfo, run_id_ptr, job_id_ptr, priority, next_attempt_ptr, created_at_ptr)
            return -1 if queued < 0

            fencing_token: mutable i64 = 0
            lease_expires: mutable darray[u8] = []
            claim_result: i64 =
                requested_job: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, job_start, job_end)
                worker: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, worker_start, worker_end)
                now: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, claim_now_start, claim_now_end)
                claimed_job: mutable darray[u8] = []
                requested_job_ptr: cstr = (&requested_job[0]).cast[cstr] can Unsafe.PointerCast
                worker_ptr: cstr = (&worker[0]).cast[cstr] can Unsafe.PointerCast
                now_ptr: cstr = (&now[0]).cast[cstr] can Unsafe.PointerCast
                Postgres::rh_pg_claim_collection_job(conninfo, requested_job_ptr, worker_ptr, now_ptr, lease_seconds, claimed_job, &fencing_token, lease_expires)
            return -1 if claim_result < 0
            if claim_result == 0:
                Base::rh_push_text(out, "{\"schema\":\"rh-postgres-ingest-result/1\",\"operation\":\"ingest\",\"status\":\"not_claimed\",\"source_id\":")
                PostgresIngest::rh_pi_emit_span(out, texts, source_start, source_end)
                Base::rh_push_text(out, ",\"run_id\":")
                PostgresIngest::rh_pi_emit_span(out, texts, run_start, run_end)
                Base::rh_push_text(out, ",\"job_id\":")
                PostgresIngest::rh_pi_emit_span(out, texts, job_start, job_end)
                Base::rh_push_text(out, ",\"fencing_token\":0,\"pages\":[],\"lease_expires_at\":\"\"}")
                return 0

            Base::rh_push_text(out, "{\"schema\":\"rh-postgres-ingest-result/1\",\"operation\":\"ingest\",\"status\":")
            PostgresIngest::rh_pi_emit_span(out, texts, run_status_start, run_status_end)
            Base::rh_push_text(out, ",\"source_id\":")
            PostgresIngest::rh_pi_emit_span(out, texts, source_start, source_end)
            Base::rh_push_text(out, ",\"run_id\":")
            PostgresIngest::rh_pi_emit_span(out, texts, run_start, run_end)
            Base::rh_push_text(out, ",\"job_id\":")
            PostgresIngest::rh_pi_emit_span(out, texts, job_start, job_end)
            Base::rh_push_text(out, ",\"fencing_token\":")
            Base::rh_push_decimal_i64(out, fencing_token)
            Base::rh_push_text(out, ",\"pages\":[")
            while page >= 0 |page: i64 = nodes[pages_index.usize()].first_child, nodes, texts, raw, out, run_start, run_end, job_start, job_end, fencing_token|:
                page_number: mutable i64 = 0
                _ = PostgresIngest::rh_pi_int(nodes, raw, texts, page, "page_number", 0, 2147483647, &page_number)
                page_scope_start: mutable i64 = 0
                page_scope_end: mutable i64 = 0
                before_start: mutable i64 = 0
                before_end: mutable i64 = 0
                after_start: mutable i64 = 0
                after_end: mutable i64 = 0
                completeness_start: mutable i64 = 0
                completeness_end: mutable i64 = 0
                staged_records_start: mutable i64 = 0
                staged_records_end: mutable i64 = 0
                evidence_start: mutable i64 = 0
                evidence_end: mutable i64 = 0
                events_start: mutable i64 = 0
                events_end: mutable i64 = 0
                subjects_start: mutable i64 = 0
                subjects_end: mutable i64 = 0
                actors_start: mutable i64 = 0
                actors_end: mutable i64 = 0
                committed_at_start: mutable i64 = 0
                committed_at_end: mutable i64 = 0
                _ = PostgresIngest::rh_pi_span(nodes, texts, page, "scope_hash", &page_scope_start, &page_scope_end, false)
                _ = PostgresIngest::rh_pi_span(nodes, texts, page, "cursor_before", &before_start, &before_end, true)
                _ = PostgresIngest::rh_pi_span(nodes, texts, page, "cursor_after", &after_start, &after_end, false)
                _ = PostgresIngest::rh_pi_span(nodes, texts, page, "completeness", &completeness_start, &completeness_end, false)
                _ = PostgresIngest::rh_pi_span(nodes, texts, page, "evidence_id", &evidence_start, &evidence_end, true)
                _ = PostgresIngest::rh_pi_span(nodes, texts, page, "events_json", &events_start, &events_end, false)
                _ = PostgresIngest::rh_pi_span(nodes, texts, page, "subjects_json", &subjects_start, &subjects_end, false)
                _ = PostgresIngest::rh_pi_span(nodes, texts, page, "actors_json", &actors_start, &actors_end, false)
                _ = PostgresIngest::rh_pi_span(nodes, texts, page, "committed_at", &committed_at_start, &committed_at_end, false)
                record_mode_index: i64 = PostgresIngest::rh_pi_get(nodes, texts, page, "record_mode")
                staged_page: bool = record_mode_index >= 0 and PostgresIngest::rh_pi_eq(texts, nodes[record_mode_index.usize()].text_start, nodes[record_mode_index.usize()].text_end, "staged")
                if staged_page:
                    _ = PostgresIngest::rh_pi_span(nodes, texts, page, "staged_records_json", &staged_records_start, &staged_records_end, false)
                record_count: mutable i64 = 0
                _ = PostgresIngest::rh_pi_int(nodes, raw, texts, page, "record_count", 0, RH_PI_MAX_RECORDS, &record_count)
                committed: i64 =
                    run_id: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, run_start, run_end)
                    job_id: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, job_start, job_end)
                    scope_hash: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, page_scope_start, page_scope_end)
                    cursor_before: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, before_start, before_end)
                    cursor_after: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, after_start, after_end)
                    completeness: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, completeness_start, completeness_end)
                    evidence_id: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, evidence_start, evidence_end)
                    committed_at: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, committed_at_start, committed_at_end)
                    run_id_ptr: cstr = (&run_id[0]).cast[cstr] can Unsafe.PointerCast
                    job_id_ptr: cstr = (&job_id[0]).cast[cstr] can Unsafe.PointerCast
                    scope_hash_ptr: cstr = (&scope_hash[0]).cast[cstr] can Unsafe.PointerCast
                    cursor_before_ptr: cstr = (&cursor_before[0]).cast[cstr] can Unsafe.PointerCast
                    cursor_after_ptr: cstr = (&cursor_after[0]).cast[cstr] can Unsafe.PointerCast
                    completeness_ptr: cstr = (&completeness[0]).cast[cstr] can Unsafe.PointerCast
                    evidence_id_ptr: cstr = (&evidence_id[0]).cast[cstr] can Unsafe.PointerCast
                    committed_at_ptr: cstr = (&committed_at[0]).cast[cstr] can Unsafe.PointerCast
                    if staged_page:
                        records: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, staged_records_start, staged_records_end)
                        records_ptr: cstr = (&records[0]).cast[cstr] can Unsafe.PointerCast
                        Postgres::rh_pg_commit_staged_collection_page(conninfo, run_id_ptr, job_id_ptr, fencing_token, page_number, scope_hash_ptr, cursor_before_ptr, cursor_after_ptr, completeness_ptr, evidence_id_ptr, records_ptr, committed_at_ptr)
                    else:
                        events: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, events_start, events_end)
                        subjects: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, subjects_start, subjects_end)
                        actors: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, actors_start, actors_end)
                        events_ptr: cstr = (&events[0]).cast[cstr] can Unsafe.PointerCast
                        subjects_ptr: cstr = (&subjects[0]).cast[cstr] can Unsafe.PointerCast
                        actors_ptr: cstr = (&actors[0]).cast[cstr] can Unsafe.PointerCast
                        Postgres::rh_pg_commit_collection_page_events(conninfo, run_id_ptr, job_id_ptr, fencing_token, page_number, scope_hash_ptr, cursor_before_ptr, cursor_after_ptr, completeness_ptr, record_count, evidence_id_ptr, events_ptr, subjects_ptr, actors_ptr, committed_at_ptr)
                return -1 if committed < 0
                if page_number > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"page_number\":")
                Base::rh_push_decimal_i64(out, page_number)
                Base::rh_push_text(out, ",\"status\":\"")
                Base::rh_push_text(out, "committed" if committed == 1 else "duplicate")
                Base::rh_push_text(out, "\"")
                if staged_page:
                    Base::rh_push_text(out, ",\"record_mode\":\"staged\"")
                Base::rh_push_text(out, "}")
                page <- nodes[page.usize()].next_sibling

            finish_result: i64 =
                run_id: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, run_start, run_end)
                job_id: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, job_start, job_end)
                job_state: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, job_state_start, job_state_end)
                run_status: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, run_status_start, run_status_end)
                run_completeness: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, run_completeness_start, run_completeness_end)
                coverage: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, coverage_start, coverage_end)
                now: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, finish_now_start, finish_now_end)
                outcome: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, outcome_start, outcome_end)
                error_kind: mutable darray[u8] = PostgresIngest::rh_pi_text(texts, error_start, error_end)
                run_id_ptr: cstr = (&run_id[0]).cast[cstr] can Unsafe.PointerCast
                job_id_ptr: cstr = (&job_id[0]).cast[cstr] can Unsafe.PointerCast
                job_state_ptr: cstr = (&job_state[0]).cast[cstr] can Unsafe.PointerCast
                run_status_ptr: cstr = (&run_status[0]).cast[cstr] can Unsafe.PointerCast
                completeness_ptr: cstr = (&run_completeness[0]).cast[cstr] can Unsafe.PointerCast
                coverage_ptr: cstr = (&coverage[0]).cast[cstr] can Unsafe.PointerCast
                now_ptr: cstr = (&now[0]).cast[cstr] can Unsafe.PointerCast
                outcome_ptr: cstr = (&outcome[0]).cast[cstr] can Unsafe.PointerCast
                error_ptr: cstr = (&error_kind[0]).cast[cstr] can Unsafe.PointerCast
                Postgres::rh_pg_finish_collection_job(conninfo, run_id_ptr, job_id_ptr, fencing_token, job_state_ptr, run_status_ptr, completeness_ptr, coverage_ptr, now_ptr, outcome_ptr, error_ptr)
            return -1 if finish_result != 1
            Base::rh_push_text(out, "],\"lease_expires_at\":")
            PostgresIngest::rh_pi_emit_cstr(out, lease_expires)
            Base::rh_push_text(out, "}")
            0
