# rh_continuity_scan.elisa — build continuity inputs from a pinned git log
# (M04 execution path).
#
# The M04 formulas in rh_continuity.elisa were previously reachable only
# from tests. This module parses the same retained `evidence/git-log.bin`
# the M01 scanner wrote and turns it into the actor/month/instant arrays
# those formulas consume, so continuity can be published from a real scan
# bundle.
#
# Identity here is a project-local author-email key after the repository's
# `.mailmap`, assigned by first appearance in the pinned log order. The pinned
# evidence retains raw and mapped author fields. This is not a person or
# maintainer claim and never merges identities across sources (M04-02).
#
# Only events with window_start <= author_time <= now are collected; a
# future timestamp is flagged by the M01 report and excluded here rather
# than allowed to distort temporal windows. Malformed records are skipped,
# never coerced.

include "./rh_base.elisa"
include "./rh_temporal.elisa"
include "./rh_metrics.elisa"
include "./rh_continuity.elisa"

module ContinuityScan:
    private:
        # Actor IDs are assigned on first appearance; the private index only
        # accelerates exact mailmap-normalized email lookup.
        def rh_cs_find_actor(pool: darray[u8]&, astart: darray[i64]&, aend: darray[i64]&, slots: darray[i64]&, log: darray[u8]&, s: usize, e: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if slots.count == 0
            slot: mutable usize = hash_sview(string_view_slice(bytes_view(log), s, e)).usize() % slots.count
            while probe < slots.count |probe: usize = 0, slot, astart, aend, slots, pool, log, s, e|:
                index: i64 = slots[slot]
                return -1 if index == 0
                actor_index: usize = (index - 1).usize()
                return index - 1 if Base::rh_bytes_equal_span(pool, astart[actor_index], aend[actor_index], log, s.i64(), e.i64())
                slot <- (slot + 1) % slots.count
                probe <- probe + 1
            -1

        def rh_cs_actor_index_grow(pool: darray[u8]&, astart: darray[i64]&, aend: darray[i64]&, slots: mutable darray[i64]&, required_actors: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if slots.count > 0 and required_actors * 2 <= slots.count
            capacity: mutable usize = 16 if slots.count == 0 else slots.count * 2
            capacity <- required_actors * 2 + 1 if capacity < required_actors * 2 + 1
            grown_slots: mutable darray[i64] = []
            while i < capacity |i: usize = 0, capacity, grown_slots|:
                grown_slots.push(0)
                i <- i + 1
            while actor_index < astart.count |actor_index: usize = 0, astart, aend, pool, grown_slots|:
                hash: usize = hash_sview(string_view_slice(bytes_view(pool), astart[actor_index].usize(), aend[actor_index].usize())).usize()
                slot: mutable usize = hash % grown_slots.count
                while grown_slots[slot] != 0 |slot, grown_slots|:
                    slot <- (slot + 1) % grown_slots.count
                grown_slots[slot] <- actor_index.i64() + 1
                actor_index <- actor_index + 1
            slots <- grown_slots
            true

        def rh_cs_actor_index_insert(pool: darray[u8]&, astart: darray[i64]&, aend: darray[i64]&, slots: mutable darray[i64]&, actor_index: usize) -> bool:
            return false if slots.count == 0 or actor_index >= astart.count
            hash: usize = hash_sview(string_view_slice(bytes_view(pool), astart[actor_index].usize(), aend[actor_index].usize())).usize()
            slot: mutable usize = hash % slots.count
            while probe < slots.count |probe: usize = 0, slot, slots, actor_index|:
                if slots[slot] == 0:
                    slots[slot] <- actor_index.i64() + 1
                    return true
                slot <- (slot + 1) % slots.count
                probe <- probe + 1
            false

        # Parse in-window commits. Appends one entry per accepted commit to the
        # parallel arrays (actor, month, inst, kind) and returns the accepted
        # count. n_actors_out receives the distinct mailmap-normalized count. Returns -1 on
        # argument misuse.
    public:
        def rh_cs_parse(log: darray[u8]&, window_start: i64, now: i64, actor: mutable darray[i64]&, month: mutable darray[i64]&, inst: mutable darray[i64]&, kind: mutable darray[u8]&, n_actors_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            pool: mutable darray[u8] = []
            astart: mutable darray[i64] = []
            aend: mutable darray[i64] = []
            actor_slots: mutable darray[i64] = []
            n: mutable i64 = 0
            accepted: mutable i64 = 0
            if now < window_start:
                n_actors_out[0] <- 0
                return -1
            while pos < log.count |pos: usize = 0, log, window_start, now, actor, month, inst, kind, pool, astart, aend, actor_slots, n, accepted|:
                span_end: usize =
                    rec_end: i64 = Base::rh_find_byte(log, pos, 0)
                    rec_end.usize() if rec_end >= 0 else log.count
                if span_end == pos:
                    pos <- span_end + 1
                    continue
                f0: i64 = Base::rh_find_byte(log, pos, 1)
                if f0 < 0 or f0.usize() >= span_end:
                    pos <- span_end + 1
                    continue
                f1: i64 = Base::rh_find_byte(log, f0.usize() + 1, 1)
                if f1 < 0 or f1.usize() >= span_end:
                    pos <- span_end + 1
                    continue
                f2: i64 = Base::rh_find_byte(log, f1.usize() + 1, 1)
                if f2 < 0 or f2.usize() >= span_end:
                    pos <- span_end + 1
                    continue
                f3: i64 = Base::rh_find_byte(log, f2.usize() + 1, 1)
                if f3 < 0 or f3.usize() >= span_end:
                    pos <- span_end + 1
                    continue
                f4: i64 = Base::rh_find_byte(log, f3.usize() + 1, 1)
                f5: mutable i64 = -1
                f6: mutable i64 = -1
                if f4 >= 0 and f4.usize() < span_end:
                    f5 <- Base::rh_find_byte(log, f4.usize() + 1, 1)
                    if f5 >= 0 and f5.usize() < span_end:
                        f6 <- Base::rh_find_byte(log, f5.usize() + 1, 1)
                        if f6 < 0 or f6.usize() >= span_end:
                            pos <- span_end + 1
                            continue
                ae_s: usize = f1.usize() + 1
                ae_e: usize = f2.usize()
                actor_email_s: mutable usize = ae_s
                actor_email_e: mutable usize = ae_e
                if f6 >= 0 and f6.usize() + 1 < span_end:
                    actor_email_s <- f6.usize() + 1
                    actor_email_e <- span_end
                at_s: usize = f2.usize() + 1
                at_e: usize = f3.usize()
                at_ok: mutable i64 = 0
                at: i64 = Base::rh_parse_i64(log, at_s, at_e, &at_ok)
                if at_ok == 0 or not Temporal::rh_instant_supported(at):
                    pos <- span_end + 1
                    continue
                if at < window_start or at > now:
                    pos <- span_end + 1
                    continue
                aid: mutable i64 = rh_cs_find_actor(pool, astart, aend, actor_slots, log, actor_email_s, actor_email_e)
                if aid < 0:
                    return -1 if not rh_cs_actor_index_grow(pool, astart, aend, actor_slots, (n + 1).usize())
                    aid <- n
                    astart.push(pool.count.i64())
                    while kk < actor_email_e |kk: usize = actor_email_s, log, actor_email_e, pool|:
                        pool.push(log[kk])
                        kk <- kk + 1
                    aend.push(pool.count.i64())
                    return -1 if not rh_cs_actor_index_insert(pool, astart, aend, actor_slots, aid.usize())
                    n <- n + 1
                mo: mutable i64 = 0
                if not Temporal::rh_month_of_instant(at, &mo):
                    pos <- span_end + 1
                    continue
                actor.push(aid)
                month.push(mo)
                inst.push(at)
                kind.push(Continuity::RH_EV_COMMIT)
                accepted <- accepted + 1
                pos <- span_end + 1
            n_actors_out[0] <- n
            accepted

        # Retention over a parsed event stream (plan §19.3): t0 is each actor's
        # first observed in-window instant; the return interval is
        # [t0 + start_days, t0 + end_days); censored beats unobservable. Tallies
        # are written to the out-params. first_seen_supported must be false for a
        # windowed or shallow scan, where first observation cannot be established;
        # callers then publish `unsupported` instead of a misleading rate.
        def rh_cs_retention(actor: darray[i64]&, inst: darray[i64]&, n_actors: i64, cutoff: i64, coverage_start: i64, coverage_end: i64, start_days: i64, end_days: i64, first_seen_supported: bool, status_out: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if status_out.count != 0 or n_actors < 0 or actor.count != inst.count
            return -1 if cutoff < 0 or coverage_start < 0 or coverage_end < coverage_start
            return -1 if start_days < 0 or end_days <= start_days
            return -1 if end_days > 9223372036854775807 / 86400
            first_instants: mutable darray[i64] = []
            window_starts: mutable darray[i64] = []
            window_ends: mutable darray[i64] = []
            has_returns: mutable darray[bool] = []
            while a < n_actors.usize() |a: usize = 0, n_actors, first_instants, window_starts, window_ends, has_returns|:
                first_instants.push(9223372036854775807)
                window_starts.push(0)
                window_ends.push(0)
                has_returns.push(false)
                a <- a + 1
            if first_seen_supported:
                while event_index < actor.count |event_index: usize = 0, actor, inst, n_actors, first_instants|:
                    actor_id: i64 = actor[event_index]
                    if actor_id >= 0 and actor_id < n_actors:
                        first_instants[actor_id.usize()] <- inst[event_index] if inst[event_index] < first_instants[actor_id.usize()]
                    event_index <- event_index + 1
                while a < n_actors.usize() |a: usize = 0, first_instants, window_starts, window_ends, start_days, end_days|:
                    if first_instants[a] != 9223372036854775807:
                        return -1 if not Continuity::rh_retention_window_bounds(first_instants[a], start_days, end_days, &window_starts[a], &window_ends[a])
                    a <- a + 1
                while event_index < actor.count |event_index: usize = 0, actor, inst, n_actors, first_instants, window_starts, window_ends, has_returns|:
                    actor_id: i64 = actor[event_index]
                    if actor_id >= 0 and actor_id < n_actors:
                        actor_index: usize = actor_id.usize()
                        instant: i64 = inst[event_index]
                        if instant >= window_starts[actor_index] and instant < window_ends[actor_index] and instant != first_instants[actor_index]:
                            has_returns[actor_index] <- true
                    event_index <- event_index + 1
            computed: mutable darray[i64] = []
            while a < n_actors.usize() |a: usize = 0, n_actors, cutoff, coverage_start, coverage_end, start_days, end_days, first_seen_supported, first_instants, has_returns, computed|:
                if not first_seen_supported or first_instants[a] == 9223372036854775807:
                    computed.push(Continuity::RH_RET_UNOBSERVABLE)
                    a <- a + 1
                    continue
                s: i64 = Continuity::rh_retention_status(first_instants[a], start_days, end_days, cutoff, coverage_start, coverage_end, has_returns[a])
                return -1 if s == Continuity::RH_RET_INVALID
                computed.push(s)
                a <- a + 1
            while i < computed.count |i: usize = 0, computed, status_out|:
                status_out.push(computed[i])
                i <- i + 1
            0
