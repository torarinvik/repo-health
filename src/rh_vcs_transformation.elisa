# Digest-bound transformation report for native VCS and patch observations.
include "./rh_base.elisa"

module VcsTransformation:
    public:
        def rh_vcs_transformation_report(output_token: cstr, configuration_sha: darray[u8]&, input_sha: darray[u8]&, output_sha: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"native-vcs\",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"")
            Base::rh_push_cstr(out, output_token)
            Base::rh_push_text(out, "\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"provider-native revision/change identity\",\"target\":\"native_id\",\"state\":\"preserved\"},{\"source\":\"provider timestamps, offsets, and change metadata\",\"target\":\"canonical observations\",\"state\":\"transformed\"},{\"source\":\"raw author identifiers\",\"target\":\"actor identity\",\"state\":\"unsupported\"},{\"source\":\"missing provider values\",\"target\":\"canonical optional fields\",\"state\":\"unknown\"},{\"source\":\"unrecognized provider fields and message bodies\",\"target\":\"canonical report\",\"state\":\"discarded\"}]}")
