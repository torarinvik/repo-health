        def rh_pylock_emit_string(out: mutable darray[u8]&, pool: darray[u8]&, start: i64, end: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if start < 0:
                Base::rh_push_text(out, "null")
            else:
                out.push(34)
                Base::rh_json_escape(out, pool, start.usize(), end.usize())
                out.push(34)

        def rh_pylock_emit_strings(out: mutable darray[u8]&, pool: darray[u8]&, values: darray[RhPylockText]&) -> void can[Memory.Allocate, Abort.Panic]:
            out.push(91)
            for index in 0..<values.count |index, values, pool, out|:
                if index > 0:
                    out.push(44)
                value: RhPylockText = values[index]
                rh_pylock_emit_string(out, pool, value.start, value.end)
            out.push(93)

        def rh_pylock_emit_fingerprint(out: mutable darray[u8]&, pool: darray[u8]&, start: i64, end: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if start < 0:
                Base::rh_push_text(out, "null")
            else:
                value: mutable darray[u8] = []
                for i in start.usize()..<end.usize() |i, pool, value|:
                    value.push(pool[i])
                digest: mutable darray[u8] = []
                Sha256::rh_sha256(value, digest)
                out.push(34)
                out.extend(bytes_view(digest))
                out.push(34)

        def rh_pylock_emit_source(out: mutable darray[u8]&, pool: darray[u8]&, package: mutable RhPylockPackage) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"kind\":\"")
            Base::rh_push_text(out, "vcs" if package.source_kind == 1 else "directory" if package.source_kind == 2 else "none")
            Base::rh_push_text(out, "\",\"vcs_type\":")
            rh_pylock_emit_string(out, pool, package.source_type_s, package.source_type_e)
            Base::rh_push_text(out, ",\"source_kind\":")
            Base::rh_push_text(out, "\"url\"" if package.source_locator_kind == 1 else "\"path\"" if package.source_locator_kind == 2 else "null")
            Base::rh_push_text(out, ",\"source_sha256\":")
            rh_pylock_emit_fingerprint(out, pool, package.source_locator_s, package.source_locator_e)
            Base::rh_push_text(out, ",\"requested_revision\":")
            rh_pylock_emit_string(out, pool, package.source_revision_s, package.source_revision_e)
            Base::rh_push_text(out, ",\"commit_id\":")
            rh_pylock_emit_string(out, pool, package.source_commit_s, package.source_commit_e)
            Base::rh_push_text(out, ",\"editable\":")
            if package.source_kind != 2:
                Base::rh_push_text(out, "null")
            else:
                Base::rh_push_text(out, "true" if package.source_editable else "false")
            Base::rh_push_text(out, ",\"subdirectory\":")
            rh_pylock_emit_string(out, pool, package.source_subdirectory_s, package.source_subdirectory_e)
            out.push(125)

        def rh_pylock_target(pool: mutable darray[u8]&, packages: mutable darray[RhPylockPackage]&, reference: mutable RhPylockReference, target_out: mutable i64&) -> u8 can[Memory.Allocate, Abort.Panic]:
            return 3 if reference.context == 1
            candidates, target =
                for i in 0..<packages.count |count: i64 = 0, target: i64 = -1, i, packages, pool, reference| -> count, target:
                    candidate: RhPylockPackage = packages[i]
                    if rh_pylock_name_eq(pool, candidate.name_s, candidate.name_e, reference.name_s, reference.name_e):
                        if reference.version_s < 0 or (candidate.version_s >= 0 and rh_pylock_equal(pool, candidate.version_s, candidate.version_e, reference.version_s, reference.version_e)):
                            count <- count + 1
                            target <- i.i64()
            target_out[0] <- target
            return 0 if candidates == 1
            return 2 if candidates > 1
