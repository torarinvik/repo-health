# rh_pylock.elisa — bounded PEP 751 package and dependency audit projection.
#
# PEP 751 package relationships are informational and the format does not record
# project-root requirements. Keep this report separate from rh-dep-graph/1 so
# lock membership is never mistaken for directness or installer input.

include "./rh_base.elisa"
include "./rh_sha256.elisa"
include "./rh_temporal.elisa"

module Pylock:
    private:
        const RH_PYLOCK_MAX_BYTES: usize = 8388608
        const RH_PYLOCK_MAX_PACKAGES: i64 = 10000
        const RH_PYLOCK_MAX_DEPENDENCIES: i64 = 200000
        const RH_PYLOCK_MAX_ARTIFACTS: i64 = 200000
        const RH_PYLOCK_MAX_HASHES: i64 = 200000
        const RH_PYLOCK_MAX_HASHES_PER_ARTIFACT: i64 = 64
        const RH_PYLOCK_MAX_CONTEXT_VALUES: i64 = 10000

        struct RhPylockText:
            start: mutable i64
            end: mutable i64

        struct RhPylockMetadata:
            environments: mutable darray[RhPylockText]
            extras: mutable darray[RhPylockText]
            dependency_groups: mutable darray[RhPylockText]
            default_groups: mutable darray[RhPylockText]
            environments_seen: mutable bool
            extras_seen: mutable bool
            dependency_groups_seen: mutable bool
            default_groups_seen: mutable bool

        struct RhPylockPackage:
            name_s: mutable i64
            name_e: mutable i64
            version_s: mutable i64
            version_e: mutable i64
            marker_s: mutable i64
            marker_e: mutable i64
            python_s: mutable i64
            python_e: mutable i64
            index_s: mutable i64
            index_e: mutable i64
            source_kind: mutable u8
            source_type_s: mutable i64
            source_type_e: mutable i64
            source_locator_s: mutable i64
            source_locator_e: mutable i64
            source_locator_kind: mutable u8
            source_revision_s: mutable i64
            source_revision_e: mutable i64
            source_commit_s: mutable i64
            source_commit_e: mutable i64
            source_subdirectory_s: mutable i64
            source_subdirectory_e: mutable i64
            source_editable: mutable bool
            source_editable_seen: mutable bool
            dependency_array: mutable u8

        struct RhPylockReference:
            owner: mutable i64
            name_s: mutable i64
            name_e: mutable i64
            version_s: mutable i64
            version_e: mutable i64
            context: mutable u8

        struct RhPylockArtifact:
            owner: mutable i64
            kind: mutable u8
            name_s: mutable i64
            name_e: mutable i64
            locator_s: mutable i64
            locator_e: mutable i64
            locator_kind: mutable u8
            subdirectory_s: mutable i64
            subdirectory_e: mutable i64
            upload_time_s: mutable i64
            upload_time_e: mutable i64
            size_bytes: mutable i64
            first_hash: mutable i64
            hash_count: mutable i64

        struct RhPylockArtifactHash:
            artifact: mutable i64
            algorithm_s: mutable i64
            algorithm_e: mutable i64
            value_s: mutable i64
            value_e: mutable i64

        def rh_pylock_copy(pool: mutable darray[u8]&, data: darray[u8]&, s: usize, e: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            start: i64 = pool.count.i64()
            for i in s..<e |pool, data|:
                pool.push(data[i])
            start

        def rh_pylock_artifact_push(artifacts: mutable darray[RhPylockArtifact]&, owner: i64, kind: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if artifacts.count.i64() >= RH_PYLOCK_MAX_ARTIFACTS
            artifacts.push(RhPylockArtifact{owner: owner, kind: kind, name_s: -1, name_e: -1, locator_s: -1, locator_e: -1, locator_kind: 0, subdirectory_s: -1, subdirectory_e: -1, upload_time_s: -1, upload_time_e: -1, size_bytes: -1, first_hash: -1, hash_count: 0})
            artifacts.count.i64() - 1

        def rh_pylock_artifact_exists(artifacts: darray[RhPylockArtifact]&, owner: i64, kind: u8) -> bool:
            for index in 0..<artifacts.count |index, artifacts, owner, kind|:
                return true if artifacts[index].owner == owner and artifacts[index].kind == kind
            false

        def rh_pylock_package_has_artifact(artifacts: darray[RhPylockArtifact]&, owner: i64) -> bool:
            for index in 0..<artifacts.count |index, artifacts, owner|:
                return true if artifacts[index].owner == owner
            false

        def rh_pylock_lower(value: u8) -> u8:
            return value + 32 if value >= 65 and value <= 90
            value

        def rh_pylock_name_eq(pool: darray[u8]&, a_s: i64, a_e: i64, b_s: i64, b_e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if a_s < 0 or b_s < 0 or a_e - a_s != b_e - b_s
            for i in 0..<(a_e - a_s).usize() |pool, a_s, b_s|:
                a: mutable u8 = rh_pylock_lower(pool[(a_s + i.i64()).usize()])
                b: mutable u8 = rh_pylock_lower(pool[(b_s + i.i64()).usize()])
                a <- 45 if a == 95 or a == 46
                b <- 45 if b == 95 or b == 46
                return false if a != b
            true

        def rh_pylock_equal(pool: darray[u8]&, a_s: i64, a_e: i64, b_s: i64, b_e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if a_s < 0 or b_s < 0 or a_e - a_s != b_e - b_s
            for i in 0..<(a_e - a_s).usize() |pool, a_s, b_s|:
                return false if pool[(a_s + i.i64()).usize()] != pool[(b_s + i.i64()).usize()]
            true

        def rh_pylock_artifact_hash_record(pool: mutable darray[u8]&, artifacts: mutable darray[RhPylockArtifact]&, hashes: mutable darray[RhPylockArtifactHash]&, artifact: i64, algorithm_s: i64, algorithm_e: i64, value_s: i64, value_e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if hashes.count.i64() >= RH_PYLOCK_MAX_HASHES or algorithm_s < 0 or algorithm_s == algorithm_e or value_s < 0 or value_s == value_e
            artifact_record: mutable RhPylockArtifact = artifacts[artifact.usize()]
            return false if artifact_record.hash_count >= RH_PYLOCK_MAX_HASHES_PER_ARTIFACT
            start: usize = artifact_record.first_hash.usize() if artifact_record.first_hash >= 0 else hashes.count
            for existing in start..<hashes.count |existing, hashes, pool, artifact, algorithm_s, algorithm_e|:
                prior: RhPylockArtifactHash = hashes[existing]
                return false if prior.artifact == artifact and rh_pylock_equal(pool, prior.algorithm_s, prior.algorithm_e, algorithm_s, algorithm_e)
            hashes.push(RhPylockArtifactHash{artifact: artifact, algorithm_s: algorithm_s, algorithm_e: algorithm_e, value_s: value_s, value_e: value_e})
            artifact_record.first_hash <- hashes.count.i64() - 1 if artifact_record.hash_count == 0
            artifact_record.hash_count <- artifact_record.hash_count + 1
            artifacts[artifact.usize()] <- artifact_record
            true

        def rh_pylock_hash_key(data: darray[u8]&, start: usize, end: usize) -> bool:
            return false if start >= end
            for i in start..<end |i, data|:
                b: u8 = data[i]
                return false if not ((b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 45 or b == 95)
            true

        def rh_pylock_integer_digit(value: u8) -> i64:
            return (value - 48).i64() if value >= 48 and value <= 57
            return (value - 55).i64() if value >= 65 and value <= 70
            return (value - 87).i64() if value >= 97 and value <= 102
            -1

        # TOML integer subset for non-negative PEP artifact sizes. Decimal,
        # binary, octal, and hexadecimal spellings retain the same byte count.
        def rh_pylock_size_integer(data: darray[u8]&, start: usize, end: usize, ok_out: mutable i64&) -> i64 can[Abort.Panic]:
            ok_out[0] <- 0
            return 0 if start >= end or end > data.count
            cursor: mutable usize = start
            signed: mutable bool = false
            if data[cursor] == 45:
                return 0
            if data[cursor] == 43:
                signed <- true
                cursor <- cursor + 1
            return 0 if cursor >= end
            base: mutable i64 = 10
            if cursor + 1 < end and data[cursor] == 48:
                if data[cursor + 1] == 120:
                    base <- 16
                    cursor <- cursor + 2
                elif data[cursor + 1] == 111:
                    base <- 8
                    cursor <- cursor + 2
                elif data[cursor + 1] == 98:
                    base <- 2
                    cursor <- cursor + 2
            return 0 if cursor >= end or (signed and base != 10)
            value: mutable i64 = 0
            digit_count: mutable i64 = 0
            leading_zero: mutable bool = false
            previous_digit: mutable bool = false
            while cursor < end |cursor, end, data, base, value, digit_count, leading_zero, previous_digit|:
                byte: u8 = data[cursor]
                if byte == 95:
                    return 0 if not previous_digit or cursor + 1 >= end
                    next_digit: i64 = rh_pylock_integer_digit(data[cursor + 1])
                    return 0 if next_digit < 0 or next_digit >= base
                    previous_digit <- false
                else:
                    digit: i64 = rh_pylock_integer_digit(byte)
                    return 0 if digit < 0 or digit >= base
                    return 0 if base == 10 and leading_zero and digit_count > 0
                    leading_zero <- true if digit_count == 0 and base == 10 and digit == 0
                    return 0 if value > 9223372036854775807 / base or (value == 9223372036854775807 / base and digit > 9223372036854775807 % base)
                    value <- value * base + digit
                    digit_count <- digit_count + 1
                    previous_digit <- true
                cursor <- cursor + 1
            return 0 if digit_count == 0 or not previous_digit
            ok_out[0] <- 1
            value

        def rh_pylock_date_part(data: darray[u8]&, start: usize, end: usize, value_out: mutable i64&) -> bool can[Abort.Panic]:
            return false if start >= end or end > data.count
            for index in start..<end |index, data|:
                return false if data[index] < 48 or data[index] > 57
            parsed_ok: mutable i64 = 0
            parsed: i64 = Base::rh_parse_i64(data, start, end, &parsed_ok)
            return false if parsed_ok != 1
            value_out[0] <- parsed
            true

        # Validate a TOML offset date-time in UTC and retain its original
        # spelling. Local times and non-zero offsets cannot satisfy PEP 751.
        def rh_pylock_utc_datetime(data: darray[u8]&, pool: mutable darray[u8]&, start: usize, end: usize, value_s: mutable i64&, value_e: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if start >= end or end > data.count or end - start < 20
            return false if data[start + 4] != 45 or data[start + 7] != 45 or (data[start + 10] != 84 and data[start + 10] != 116 and data[start + 10] != 32) or data[start + 13] != 58 or data[start + 16] != 58
            year: mutable i64 = 0
            month: mutable i64 = 0
            day: mutable i64 = 0
            hour: mutable i64 = 0
            minute: mutable i64 = 0
            second: mutable i64 = 0
            return false if not rh_pylock_date_part(data, start, start + 4, &year) or not rh_pylock_date_part(data, start + 5, start + 7, &month) or not rh_pylock_date_part(data, start + 8, start + 10, &day)
            return false if not rh_pylock_date_part(data, start + 11, start + 13, &hour) or not rh_pylock_date_part(data, start + 14, start + 16, &minute) or not rh_pylock_date_part(data, start + 17, start + 19, &second)
            return false if year < 1 or month < 1 or month > 12 or hour > 23 or minute > 59 or second > 60
            return false if second == 60 and (hour != 23 or minute != 59)
            days: i64 = Temporal::rh_days_from_civil(year, month, day)
            normalized_year: mutable i64 = 0
            normalized_month: mutable i64 = 0
            normalized_day: mutable i64 = 0
            Temporal::rh_civil_from_days(days, &normalized_year, &normalized_month, &normalized_day)
            return false if normalized_year != year or normalized_month != month or normalized_day != day
            cursor: mutable usize = start + 19
            if data[cursor] == 46:
                cursor <- cursor + 1
                fraction_start: usize = cursor
                while cursor < end and data[cursor] >= 48 and data[cursor] <= 57 |cursor, data, end|:
                    cursor <- cursor + 1
                return false if cursor == fraction_start
            if end - cursor == 1:
                return false if data[cursor] != 90 and data[cursor] != 122
            elif end - cursor == 6:
                return false if data[cursor] != 43 or data[cursor + 1] != 48 or data[cursor + 2] != 48 or data[cursor + 3] != 58 or data[cursor + 4] != 48 or data[cursor + 5] != 48
            else:
                return false
            value_s[0] <- rh_pylock_copy(pool, data, start, end)
            value_e[0] <- value_s[0] + (end - start).i64()
            true

        def rh_pylock_inline_hashes(data: mutable darray[u8]&, pool: mutable darray[u8]&, artifacts: mutable darray[RhPylockArtifact]&, hashes: mutable darray[RhPylockArtifactHash]&, artifact: i64, start: usize, end: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if start >= end or data[start] != 123 or data[end - 1] != 125
            cursor: mutable usize = start + 1
            limit: usize = end - 1
            count: mutable i64 = 0
            while cursor < limit |cursor, limit, data, pool, artifacts, hashes, artifact, count|:
                while cursor < limit and (data[cursor] == 32 or data[cursor] == 9 or data[cursor] == 13 or data[cursor] == 10) |cursor, data, limit|:
                    cursor <- cursor + 1
                if cursor < limit:
                    field_start: usize = cursor
                    quote: mutable u8 = 0
                    while cursor < limit and (quote != 0 or data[cursor] != 44) |cursor, data, limit, quote|:
                        if quote == 0:
                            quote <- data[cursor] if data[cursor] == 34 or data[cursor] == 39
                        elif data[cursor] == quote:
                            quote <- 0
                        return false if data[cursor] == 92
                        cursor <- cursor + 1
                    return false if quote != 0
                    field_end: usize = cursor
                    key_s: mutable usize = field_start
                    key_e: mutable usize = field_end
                    value_s: mutable usize = field_start
                    return false if not rh_pylock_assignment(data, field_start, field_end, &key_s, &key_e, &value_s)
                    rh_pylock_trim(data, &key_s, &key_e)
                    value_e: usize = rh_pylock_comment_end(data, value_s, field_end)
                    value_end: mutable usize = value_e
                    rh_pylock_trim(data, &value_s, &value_end)
                    return false if not rh_pylock_hash_key(data, key_s, key_e)
                    algorithm_s: i64 = rh_pylock_copy(pool, data, key_s, key_e)
                    algorithm_e: i64 = algorithm_s + (key_e - key_s).i64()
                    value_start: mutable i64 = -1
                    value_stop: mutable i64 = -1
                    return false if not rh_pylock_scalar_string(data, pool, value_s, value_end, &value_start, &value_stop)
                    return false if not rh_pylock_artifact_hash_record(pool, artifacts, hashes, artifact, algorithm_s, algorithm_e, value_start, value_stop)
                    count <- count + 1
                    cursor <- cursor + 1 if cursor < limit and data[cursor] == 44
            count > 0

        def rh_pylock_artifact_field(data: mutable darray[u8]&, pool: mutable darray[u8]&, artifacts: mutable darray[RhPylockArtifact]&, hashes: mutable darray[RhPylockArtifactHash]&, artifact_index: i64, start: usize, end: usize, unknown_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            key_s: mutable usize = start
            key_e: mutable usize = end
            value_s: mutable usize = start
            return false if not rh_pylock_assignment(data, start, end, &key_s, &key_e, &value_s)
            value_e: usize = rh_pylock_comment_end(data, value_s, end)
            value_end: mutable usize = value_e
            rh_pylock_trim(data, &value_s, &value_end)
            artifact: mutable RhPylockArtifact = artifacts[artifact_index.usize()]
            if Base::rh_bytes_equal_literal(data, key_s.i64(), key_e.i64(), "name"):
                return false if artifact.name_s >= 0 or not rh_pylock_scalar_string(data, pool, value_s, value_end, &artifact.name_s, &artifact.name_e)
            elif Base::rh_bytes_equal_literal(data, key_s.i64(), key_e.i64(), "size"):
                return false if artifact.size_bytes >= 0
                size_ok: mutable i64 = 0
                size_bytes: i64 = rh_pylock_size_integer(data, value_s, value_end, &size_ok)
                return false if size_ok != 1
                artifact.size_bytes <- size_bytes
            elif Base::rh_bytes_equal_literal(data, key_s.i64(), key_e.i64(), "upload-time"):
                return false if artifact.upload_time_s >= 0 or not rh_pylock_utc_datetime(data, pool, value_s, value_end, &artifact.upload_time_s, &artifact.upload_time_e)
            elif Base::rh_bytes_equal_literal(data, key_s.i64(), key_e.i64(), "subdirectory"):
                return false if artifact.kind != 3 or artifact.subdirectory_s >= 0 or not rh_pylock_scalar_string(data, pool, value_s, value_end, &artifact.subdirectory_s, &artifact.subdirectory_e)
            elif Base::rh_bytes_equal_literal(data, key_s.i64(), key_e.i64(), "url"):
                return false if artifact.locator_kind != 0 or not rh_pylock_scalar_string(data, pool, value_s, value_end, &artifact.locator_s, &artifact.locator_e)
                artifact.locator_kind <- 1
            elif Base::rh_bytes_equal_literal(data, key_s.i64(), key_e.i64(), "path"):
                return false if artifact.locator_kind != 0 or not rh_pylock_scalar_string(data, pool, value_s, value_end, &artifact.locator_s, &artifact.locator_e)
                artifact.locator_kind <- 2
            elif Base::rh_bytes_equal_literal(data, key_s.i64(), key_e.i64(), "hashes"):
                return false if not rh_pylock_inline_hashes(data, pool, artifacts, hashes, artifact_index, value_s, value_end)
                return true
            else:
                unknown_out[0] <- unknown_out[0] + 1
            artifacts[artifact_index.usize()] <- artifact
            true

        def rh_pylock_artifact_hash_field(data: mutable darray[u8]&, pool: mutable darray[u8]&, artifacts: mutable darray[RhPylockArtifact]&, hashes: mutable darray[RhPylockArtifactHash]&, artifact_index: i64, start: usize, end: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            key_s: mutable usize = start
            key_e: mutable usize = end
            value_s: mutable usize = start
            return false if not rh_pylock_assignment(data, start, end, &key_s, &key_e, &value_s)
            rh_pylock_trim(data, &key_s, &key_e)
            value_e: usize = rh_pylock_comment_end(data, value_s, end)
            value_end: mutable usize = value_e
            rh_pylock_trim(data, &value_s, &value_end)
            return false if not rh_pylock_hash_key(data, key_s, key_e)
            algorithm_s: i64 = rh_pylock_copy(pool, data, key_s, key_e)
            algorithm_e: i64 = algorithm_s + (key_e - key_s).i64()
            value_start: mutable i64 = -1
            value_stop: mutable i64 = -1
            return false if not rh_pylock_scalar_string(data, pool, value_s, value_end, &value_start, &value_stop)
            rh_pylock_artifact_hash_record(pool, artifacts, hashes, artifact_index, algorithm_s, algorithm_e, value_start, value_stop)

        def rh_pylock_inline_artifact(data: mutable darray[u8]&, pool: mutable darray[u8]&, artifacts: mutable darray[RhPylockArtifact]&, hashes: mutable darray[RhPylockArtifactHash]&, owner: i64, kind: u8, start: usize, end: usize, unknown_out: mutable i64&, next_out: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if start >= end or data[start] != 123
            depth: mutable i64 = 1
            quote: mutable u8 = 0
            limit: mutable usize = end
            close: usize =
                while i < limit |i: usize = start + 1, data, depth, quote, limit| -> i:
                    b: u8 = data[i]
                    if quote != 0:
                        return false if b == 92
                        quote <- 0 if b == quote
                    elif b == 34 or b == 39:
                        quote <- b
                    elif b == 123:
                        depth <- depth + 1
                    elif b == 125:
                        depth <- depth - 1
                        break if depth == 0
                    i <- i + 1
            return false if close >= limit or depth != 0 or quote != 0
            artifact_index: i64 = rh_pylock_artifact_push(artifacts, owner, kind)
            return false if artifact_index < 0
            field_start: mutable usize = start + 1
            field_cursor: mutable usize = field_start
            field_quote: mutable u8 = 0
            field_depth: mutable i64 = 0
            while field_cursor <= close |field_cursor, close, data, pool, artifacts, hashes, artifact_index, unknown_out, field_start, field_quote, field_depth|:
                if field_cursor == close or (data[field_cursor] == 44 and field_quote == 0 and field_depth == 0):
                    field_s: mutable usize = field_start
                    field_e: mutable usize = field_cursor
                    rh_pylock_trim(data, &field_s, &field_e)
                    return false if field_s < field_e and not rh_pylock_artifact_field(data, pool, artifacts, hashes, artifact_index, field_s, field_e, unknown_out)
                    field_start <- field_cursor + 1
                else:
                    if field_quote != 0:
                        field_quote <- 0 if data[field_cursor] == field_quote
                    elif data[field_cursor] == 34 or data[field_cursor] == 39:
                        field_quote <- data[field_cursor]
                    elif data[field_cursor] == 123:
                        field_depth <- field_depth + 1
                    elif data[field_cursor] == 125:
                        field_depth <- field_depth - 1 if field_depth > 0
                    return false if data[field_cursor] == 92
                field_cursor <- field_cursor + 1
            next_out[0] <- close + 1
            true

        def rh_pylock_inline_artifact_array(data: mutable darray[u8]&, pool: mutable darray[u8]&, artifacts: mutable darray[RhPylockArtifact]&, hashes: mutable darray[RhPylockArtifactHash]&, owner: i64, kind: u8, start: usize, unknown_out: mutable i64&, close_out: mutable usize&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if start >= data.count or data[start] != 91
            cursor: mutable usize = start + 1
            while cursor < data.count |cursor, data, pool, artifacts, hashes, owner, kind, unknown_out, close_out|:
                while cursor < data.count and (data[cursor] == 32 or data[cursor] == 9 or data[cursor] == 13 or data[cursor] == 10) |cursor, data|:
                    cursor <- cursor + 1
                if cursor < data.count and data[cursor] == 35:
                    cursor <- while comment < data.count and data[comment] != 10 |comment: usize = cursor, data| -> comment:
                        comment <- comment + 1
                    continue
                return false if cursor >= data.count
                if data[cursor] == 93:
                    close_out[0] <- cursor
                    return true
                return false if data[cursor] != 123
                next: mutable usize = 0
                return false if not rh_pylock_inline_artifact(data, pool, artifacts, hashes, owner, kind, cursor, data.count, unknown_out, &next)
                cursor <- next
                while cursor < data.count and (data[cursor] == 32 or data[cursor] == 9 or data[cursor] == 13 or data[cursor] == 10) |cursor, data|:
                    cursor <- cursor + 1
                if cursor < data.count and data[cursor] == 44:
                    cursor <- cursor + 1
                elif cursor < data.count and data[cursor] == 93:
                    close_out[0] <- cursor
                    return true
                else:
                    return false
            false

        def rh_pylock_trim(data: darray[u8]&, start: mutable usize&, end: mutable usize&) -> void can[Memory.Allocate, Abort.Panic]:
            while start[0] < end[0] and (data[start[0]] == 32 or data[start[0]] == 9 or data[start[0]] == 13) |data, start, end|:
                start[0] <- start[0] + 1
            while end[0] > start[0] and (data[end[0] - 1] == 32 or data[end[0] - 1] == 9 or data[end[0] - 1] == 13) |data, start, end|:
                end[0] <- end[0] - 1

