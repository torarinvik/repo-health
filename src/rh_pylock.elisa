    public:
        # Emit package-to-package lock evidence without projecting a synthetic
        # root. Return -1 for malformed or unsupported core TOML constructs.
        def rh_pylock_audit(data: mutable darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            pool: mutable darray[u8] = []
            packages: mutable darray[RhPylockPackage] = []
            references: mutable darray[RhPylockReference] = []
            artifacts: mutable darray[RhPylockArtifact] = []
            hashes: mutable darray[RhPylockArtifactHash] = []
            metadata: mutable RhPylockMetadata = RhPylockMetadata{environments: [], extras: [], dependency_groups: [], default_groups: [], environments_seen: false, extras_seen: false, dependency_groups_seen: false, default_groups_seen: false}
            created_s: mutable i64 = -1
            created_e: mutable i64 = -1
            python_s: mutable i64 = -1
            python_e: mutable i64 = -1
            unknown_top: mutable i64 = 0
            unknown_package: mutable i64 = 0
            unknown_dependency: mutable i64 = 0
            unknown_artifact: mutable i64 = 0
            unknown_tables: mutable i64 = 0
            return -1 if rh_pylock_parse(data, pool, packages, references, artifacts, hashes, metadata, &created_s, &created_e, &python_s, &python_e, &unknown_top, &unknown_package, &unknown_dependency, &unknown_artifact, &unknown_tables) != 0
            input_hash: mutable darray[u8] = []
            Sha256::rh_sha256(data, input_hash)
            Base::rh_push_text(out, "{\"schema\":\"rh-pylock-audit/1\",\"format\":\"PEP 751\",\"parser\":\"bounded-core-projection\",\"lock_version\":\"1.0\",\"created_by\":")
            rh_pylock_emit_string(out, pool, created_s, created_e)
            Base::rh_push_text(out, ",\"input_sha256\":\"")
            for i in 0..<input_hash.count |input_hash, out|:
                out.push(input_hash[i])
            Base::rh_push_text(out, "\"")
            Base::rh_push_text(out, ",\"requires_python\":")
            rh_pylock_emit_string(out, pool, python_s, python_e)
            Base::rh_push_text(out, ",\"environments\":")
            rh_pylock_emit_strings(out, pool, metadata.environments)
            Base::rh_push_text(out, ",\"extras\":")
            rh_pylock_emit_strings(out, pool, metadata.extras)
            Base::rh_push_text(out, ",\"dependency_groups\":")
            rh_pylock_emit_strings(out, pool, metadata.dependency_groups)
            Base::rh_push_text(out, ",\"default_groups\":")
            rh_pylock_emit_strings(out, pool, metadata.default_groups)
            Base::rh_push_text(out, ",\"root_relationship\":\"not_recorded\",\"dependency_semantics\":\"informational_only\",\"packages\":[")
            artifact_cursor: mutable usize = 0
            hash_cursor: mutable usize = 0
            for package_id in 0..<packages.count |package_id, packages, pool, references, out, artifact_cursor, hash_cursor|:
                pkg: RhPylockPackage = packages[package_id]
                if package_id > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"id\":")
                Base::rh_push_decimal_i64(out, package_id.i64())
                Base::rh_push_text(out, ",\"name\":")
                rh_pylock_emit_string(out, pool, pkg.name_s, pkg.name_e)
                Base::rh_push_text(out, ",\"version\":")
                rh_pylock_emit_string(out, pool, pkg.version_s, pkg.version_e)
                Base::rh_push_text(out, ",\"marker\":")
                rh_pylock_emit_string(out, pool, pkg.marker_s, pkg.marker_e)
                Base::rh_push_text(out, ",\"requires_python\":")
                rh_pylock_emit_string(out, pool, pkg.python_s, pkg.python_e)
                Base::rh_push_text(out, ",\"index_sha256\":")
                rh_pylock_emit_fingerprint(out, pool, pkg.index_s, pkg.index_e)
                Base::rh_push_text(out, ",\"source\":")
                rh_pylock_emit_source(out, pool, pkg)
                Base::rh_push_text(out, ",\"dependencies\":[")
                first: mutable bool = true
                for reference_id in 0..<references.count |reference_id, references, pool, packages, out, package_id, first|:
                    reference: mutable RhPylockReference = references[reference_id]
                    if reference.owner == package_id.i64():
                        if not first:
                            out.push(44)
                        first <- false
                        target: mutable i64 = -1
                        state: u8 = rh_pylock_target(pool, packages, reference, &target)
                        Base::rh_push_text(out, "{\"name\":")
                        rh_pylock_emit_string(out, pool, reference.name_s, reference.name_e)
                        Base::rh_push_text(out, ",\"version\":")
                        rh_pylock_emit_string(out, pool, reference.version_s, reference.version_e)
                        Base::rh_push_text(out, ",\"target\":")
                        if state == 0:
                            Base::rh_push_decimal_i64(out, target)
                        else:
                            Base::rh_push_text(out, "null")
                        Base::rh_push_text(out, ",\"resolution\":\"")
                        Base::rh_push_text(out, "resolved" if state == 0 else "missing" if state == 1 else "ambiguous" if state == 2 else "context")
                        Base::rh_push_text(out, "\"}")
                Base::rh_push_text(out, "],\"artifacts\":[")
                first_artifact: mutable bool = true
                while artifact_cursor < artifacts.count and artifacts[artifact_cursor].owner == package_id.i64() |artifact_cursor, artifacts, hashes, pool, out, package_id, first_artifact, hash_cursor|:
                    artifact_id: mutable usize = artifact_cursor
                    artifact: RhPylockArtifact = artifacts[artifact_id]
                    artifact_cursor <- artifact_cursor + 1
                    if not first_artifact:
                        out.push(44)
                    first_artifact <- false
                    Base::rh_push_text(out, "{\"id\":")
                    Base::rh_push_decimal_i64(out, artifact_id.i64())
                    Base::rh_push_text(out, ",\"kind\":\"")
                    Base::rh_push_text(out, "wheel" if artifact.kind == 1 else "sdist" if artifact.kind == 2 else "archive")
                    Base::rh_push_text(out, "\",\"name\":")
                    rh_pylock_emit_string(out, pool, artifact.name_s, artifact.name_e)
                    Base::rh_push_text(out, ",\"source_kind\":")
                    Base::rh_push_text(out, "\"url\"" if artifact.locator_kind == 1 else "\"path\"" if artifact.locator_kind == 2 else "\"name_only\"")
                    Base::rh_push_text(out, ",\"source_sha256\":")
                    rh_pylock_emit_fingerprint(out, pool, artifact.locator_s, artifact.locator_e)
                    Base::rh_push_text(out, ",\"upload_time\":")
                    rh_pylock_emit_string(out, pool, artifact.upload_time_s, artifact.upload_time_e)
                    Base::rh_push_text(out, ",\"subdirectory\":")
                    rh_pylock_emit_string(out, pool, artifact.subdirectory_s, artifact.subdirectory_e)
                    Base::rh_push_text(out, ",\"size_bytes\":")
                    if artifact.size_bytes < 0:
                        Base::rh_push_text(out, "null")
                    else:
                        Base::rh_push_decimal_i64(out, artifact.size_bytes)
                    Base::rh_push_text(out, ",\"hashes\":[")
                    first_hash: mutable bool = true
                    while hash_cursor < hashes.count and hashes[hash_cursor].artifact == artifact_id.i64() |hash_cursor, hashes, pool, out, artifact_id, first_hash|:
                        hash: RhPylockArtifactHash = hashes[hash_cursor]
                        hash_cursor <- hash_cursor + 1
                        if not first_hash:
                            out.push(44)
                        first_hash <- false
                        Base::rh_push_text(out, "{\"algorithm\":")
                        rh_pylock_emit_string(out, pool, hash.algorithm_s, hash.algorithm_e)
                        Base::rh_push_text(out, ",\"value\":")
                        rh_pylock_emit_string(out, pool, hash.value_s, hash.value_e)
                        out.push(125)
                    Base::rh_push_text(out, "]}")
                Base::rh_push_text(out, "]}")
            Base::rh_push_text(out, "],\"coverage\":{\"direct_dependencies\":\"not_recorded\",\"markers_evaluated\":false,\"artifacts_projected\":false,\"artifact_hashes_projected\":")
            Base::rh_push_text(out, "true" if unknown_artifact == 0 and unknown_package == 0 else "false")
            Base::rh_push_text(out, ",\"unprojected_artifact_fields\":")
            Base::rh_push_decimal_i64(out, unknown_artifact)
            Base::rh_push_text(out, ",\"unprojected_top_level_fields\":")
            Base::rh_push_decimal_i64(out, unknown_top)
            Base::rh_push_text(out, ",\"unprojected_package_fields\":")
            Base::rh_push_decimal_i64(out, unknown_package)
            Base::rh_push_text(out, ",\"unprojected_dependency_fields\":")
            Base::rh_push_decimal_i64(out, unknown_dependency)
            Base::rh_push_text(out, ",\"unprojected_tables\":")
            Base::rh_push_decimal_i64(out, unknown_tables)
            Base::rh_push_text(out, "}}")
            0
