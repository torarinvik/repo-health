# test_forge_event_chain.elisa — bounded module harness for Bitbucket segment assembly.

include "./rh_base.elisa"
include "./rh_git.elisa"
include "./rh_forge_event_chain.elisa"

module ForgeEventChainHarness:
    private:
        def rh_fech_fail() -> i32:
            4

        def rh_fech_run(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            return 3 if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path) or Base::rh_streq(input_path, out_path)
            raw: mutable darray[u8] = []
            read_status: i64 = Base::rh_io_read(input_path, raw) can Global{Read,Write}
            return ForgeEventChainHarness::rh_fech_fail() if read_status < 0
            body: mutable darray[u8] = []
            chain_status: i64 = ForgeEventChain::rh_forge_bitbucket_event_chain(raw, body) can Global{Read,Write}
            return ForgeEventChainHarness::rh_fech_fail() if chain_status != 0
            body.push(10)
            write_status: bool = Base::rh_io_write(out_path, body) can Global{Read,Write}
            return ForgeEventChainHarness::rh_fech_fail() if not write_status
            0

        def rh_fech_usage() -> i32:
            2

    public:
        def rh_forge_event_chain_harness_main(argc: i64, argv: mutable void&) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            return ForgeEventChainHarness::rh_fech_usage() if argc != 7
            slots: mutable cstr&& = argv.cast[mutable cstr&&]
            command: u8& = slots[1].cast[u8&] can Unsafe.PointerCast
            subcommand: u8& = slots[2].cast[u8&] can Unsafe.PointerCast
            input_option: u8& = slots[3].cast[u8&] can Unsafe.PointerCast
            output_option: u8& = slots[5].cast[u8&] can Unsafe.PointerCast
            return ForgeEventChainHarness::rh_fech_usage() if not Base::rh_streq(command, "forge") or not Base::rh_streq(subcommand, "events-chain") or not Base::rh_streq(input_option, "--input") or not Base::rh_streq(output_option, "--out")
            ForgeEventChainHarness::rh_fech_run(slots[4], slots[6]) can Global{Read,Write}

def main(argc: i64, argv: mutable void&) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    ForgeEventChainHarness::rh_forge_event_chain_harness_main(argc, argv) can Global{Read,Write}
