# rh_role_publication.elisa — restricted role publication (M04-09).
#
# Captured role declarations may contain source-native actor IDs. This public
# projection retains only project-level counts and query coverage. It never
# emits actor IDs, names, permission documents, or an individual ranking.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_roles.elisa"

module RolePublication:
    private:
        def rh_rp_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_obj_get(nodes, texts, obj, key)

        def rh_rp_eq(texts: darray[u8]&, s: i64, e: i64, literal: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, literal)

        def rh_rp_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = RolePublication::rh_rp_get(nodes, texts, obj, key)
            return false if idx < 0 or not Json::rh_json_str_span(nodes, idx, s_out, e_out)
            s_out[0] < e_out[0]

        def rh_rp_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_int(nodes, raw, RolePublication::rh_rp_get(nodes, texts, obj, key), ok_out)

        def rh_rp_source(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Roles::RH_DECL_SOURCE_PROVIDER if RolePublication::rh_rp_eq(texts, s, e, "provider")
            return Roles::RH_DECL_SOURCE_FILE if RolePublication::rh_rp_eq(texts, s, e, "file")
            return Roles::RH_DECL_SOURCE_OPERATOR if RolePublication::rh_rp_eq(texts, s, e, "operator")
            -1

        def rh_rp_auth(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return 1 if RolePublication::rh_rp_eq(texts, s, e, "authorized")
            return 2 if RolePublication::rh_rp_eq(texts, s, e, "unauthorized")
            return 3 if RolePublication::rh_rp_eq(texts, s, e, "not_requested")
            return 4 if RolePublication::rh_rp_eq(texts, s, e, "unknown")
            -1

        def rh_rp_auth_label(state: i64) -> u8&:
            return "authorized" if state == 1
            return "unauthorized" if state == 2
            return "not_requested" if state == 3
            "unknown"

    public:
        def rh_role_publication_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_idx: i64 = RolePublication::rh_rp_get(nodes, texts, root, "schema")
            schema_s: mutable i64 = 0
            schema_e: mutable i64 = 0
            return -1 if schema_idx < 0 or not Json::rh_json_str_span(nodes, schema_idx, &schema_s, &schema_e) or not RolePublication::rh_rp_eq(texts, schema_s, schema_e, "rh-roles-input/1")
            auth_state: mutable i64 = 4
            auth_idx: i64 = RolePublication::rh_rp_get(nodes, texts, root, "authorization")
            if auth_idx >= 0:
                return -1 if nodes[auth_idx.usize()].kind != Json::RH_JSON_OBJ
                auth_value: i64 = RolePublication::rh_rp_get(nodes, texts, auth_idx, "state")
                auth_s: mutable i64 = 0
                auth_e: mutable i64 = 0
                return -1 if not Json::rh_json_str_span(nodes, auth_value, &auth_s, &auth_e)
                auth_state <- RolePublication::rh_rp_auth(texts, auth_s, auth_e)
                return -1 if auth_state < 0
            decl_idx: i64 = RolePublication::rh_rp_get(nodes, texts, root, "declarations")
            return -1 if decl_idx < 0 or nodes[decl_idx.usize()].kind != Json::RH_JSON_ARR
            declarations: mutable darray[Roles::RhRoleDecl] = []
            role_counts: mutable darray[i64] = [0, 0, 0, 0, 0]
            source_counts: mutable darray[i64] = [0, 0, 0]
            decls: Json::RhJsonNode = nodes[decl_idx.usize()]
            return -1 if decls.child_count > 100000
            while decl >= 0 |decl: i64 = decls.first_child, nodes, texts, raw, declarations, role_counts, source_counts|:
                return -1 if nodes[decl.usize()].kind != Json::RH_JSON_OBJ
                actor_ok: mutable i64 = 0
                actor: i64 = RolePublication::rh_rp_int(nodes, raw, texts, decl, "actor_id", &actor_ok)
                return -1 if actor_ok == 0 or actor < 0
                role_s: mutable i64 = 0
                role_e: mutable i64 = 0
                source_s: mutable i64 = 0
                source_e: mutable i64 = 0
                return -1 if not RolePublication::rh_rp_str(nodes, texts, decl, "role", &role_s, &role_e) or not RolePublication::rh_rp_str(nodes, texts, decl, "source", &source_s, &source_e)
                role: u8 = Roles::rh_role_parse_role(texts, role_s, role_e)
                source: i64 = RolePublication::rh_rp_source(texts, source_s, source_e)
                return -1 if source < 0
                permission_ok: mutable i64 = 0
                permission: i64 = RolePublication::rh_rp_int(nodes, raw, texts, decl, "permission", &permission_ok)
                return -1 if permission_ok == 0 or permission < 0 or permission > 255
                declared_ok: mutable i64 = 0
                declared_at: i64 = RolePublication::rh_rp_int(nodes, raw, texts, decl, "declared_at", &declared_ok)
                return -1 if declared_ok == 0 or declared_at < 0
                revoked_ok: mutable i64 = 0
                revoked_at: mutable i64 = RolePublication::rh_rp_int(nodes, raw, texts, decl, "revoked_at", &revoked_ok)
                revoked_at <- 0 if revoked_ok == 0
                return -1 if revoked_at < 0
                declarations.push(Roles::RhRoleDecl{actor_id: actor, role: role, permission: permission.u8(), source: source.u8(), declared_at: declared_at, revoked_at: revoked_at})
                role_counts[role.usize()] <- role_counts[role.usize()] + 1
                source_counts[(source - 1).usize()] <- source_counts[(source - 1).usize()] + 1
                decl <- nodes[decl.usize()].next_sibling

            known_queries: mutable i64 = 0
            unknown_queries: mutable i64 = 0
            query_idx: i64 = RolePublication::rh_rp_get(nodes, texts, root, "queries")
            if query_idx >= 0:
                return -1 if nodes[query_idx.usize()].kind != Json::RH_JSON_ARR
                queries: Json::RhJsonNode = nodes[query_idx.usize()]
                while query >= 0 |query: i64 = queries.first_child, nodes, texts, raw, declarations, known_queries, unknown_queries|:
                    return -1 if nodes[query.usize()].kind != Json::RH_JSON_OBJ
                    actor_ok: mutable i64 = 0
                    actor: i64 = RolePublication::rh_rp_int(nodes, raw, texts, query, "actor_id", &actor_ok)
                    as_of_ok: mutable i64 = 0
                    as_of: i64 = RolePublication::rh_rp_int(nodes, raw, texts, query, "as_of", &as_of_ok)
                    return -1 if actor_ok == 0 or actor < 0 or as_of_ok == 0 or as_of < 0
                    role: u8 = Roles::rh_role_declared(declarations, actor, as_of)
                    known_queries <- known_queries + 1 if role != Roles::RH_ROLE_UNKNOWN
                    unknown_queries <- unknown_queries + 1 if role == Roles::RH_ROLE_UNKNOWN
                    query <- nodes[query.usize()].next_sibling

            permission_queries: mutable i64 = 0
            granted_queries: mutable i64 = 0
            permission_idx: i64 = RolePublication::rh_rp_get(nodes, texts, root, "permission_queries")
            if permission_idx >= 0:
                return -1 if nodes[permission_idx.usize()].kind != Json::RH_JSON_ARR
                permissions: Json::RhJsonNode = nodes[permission_idx.usize()]
                while permission >= 0 |permission: i64 = permissions.first_child, nodes, texts, raw, declarations, permission_queries, granted_queries|:
                    return -1 if nodes[permission.usize()].kind != Json::RH_JSON_OBJ
                    actor_ok: mutable i64 = 0
                    actor: i64 = RolePublication::rh_rp_int(nodes, raw, texts, permission, "actor_id", &actor_ok)
                    bit_ok: mutable i64 = 0
                    bit: i64 = RolePublication::rh_rp_int(nodes, raw, texts, permission, "perm_bit", &bit_ok)
                    as_of_ok: mutable i64 = 0
                    as_of: i64 = RolePublication::rh_rp_int(nodes, raw, texts, permission, "as_of", &as_of_ok)
                    return -1 if actor_ok == 0 or actor < 0 or bit_ok == 0 or bit < 0 or bit > 255 or as_of_ok == 0 or as_of < 0
                    permission_queries <- permission_queries + 1
                    granted_queries <- granted_queries + 1 if Roles::rh_role_permission_declared(declarations, actor, bit.u8(), as_of) == 1
                    permission <- nodes[permission.usize()].next_sibling

            Base::rh_push_text(out, "{\"schema\":\"rh-role-publication-result/1\",\"authorization_state\":\"")
            Base::rh_push_text(out, RolePublication::rh_rp_auth_label(auth_state))
            Base::rh_push_text(out, "\",\"raw_identity\":\"restricted\",\"declaration_count\":")
            Base::rh_push_decimal_i64(out, declarations.count.i64())
            Base::rh_push_text(out, ",\"role_counts\":{\"owner\":")
            Base::rh_push_decimal_i64(out, role_counts[Roles::RH_ROLE_OWNER.usize()])
            Base::rh_push_text(out, ",\"maintainer\":")
            Base::rh_push_decimal_i64(out, role_counts[Roles::RH_ROLE_MAINTAINER.usize()])
            Base::rh_push_text(out, ",\"triager\":")
            Base::rh_push_decimal_i64(out, role_counts[Roles::RH_ROLE_TRIAGER.usize()])
            Base::rh_push_text(out, ",\"member\":")
            Base::rh_push_decimal_i64(out, role_counts[Roles::RH_ROLE_MEMBER.usize()])
            Base::rh_push_text(out, ",\"unknown\":")
            Base::rh_push_decimal_i64(out, role_counts[Roles::RH_ROLE_UNKNOWN.usize()])
            Base::rh_push_text(out, "},\"source_tally\":{\"provider\":")
            Base::rh_push_decimal_i64(out, source_counts[0])
            Base::rh_push_text(out, ",\"file\":")
            Base::rh_push_decimal_i64(out, source_counts[1])
            Base::rh_push_text(out, ",\"operator\":")
            Base::rh_push_decimal_i64(out, source_counts[2])
            Base::rh_push_text(out, "},\"query_coverage\":{\"role_queries\":")
            Base::rh_push_decimal_i64(out, known_queries + unknown_queries)
            Base::rh_push_text(out, ",\"known_role\":")
            Base::rh_push_decimal_i64(out, known_queries)
            Base::rh_push_text(out, ",\"unknown_role\":")
            Base::rh_push_decimal_i64(out, unknown_queries)
            Base::rh_push_text(out, ",\"permission_queries\":")
            Base::rh_push_decimal_i64(out, permission_queries)
            Base::rh_push_text(out, ",\"granted_permission\":")
            Base::rh_push_decimal_i64(out, granted_queries)
            Base::rh_push_text(out, "},\"personal_leaderboard\":false,\"note\":\"project-level role and permission aggregates only; actor identities and permission documents are restricted; declarations remain separate from observed actions\"}")
            0
