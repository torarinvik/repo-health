    t7check(not Git::rh_addr_guard("127.0.0.1"), "addr-reject-loopback", fails)
    t7check(not Git::rh_addr_guard("10.1.2.3"), "addr-reject-private", fails)
    t7check(not Git::rh_addr_guard("169.254.169.254"), "addr-reject-linklocal", fails)
    t7check(not Git::rh_addr_guard("100.64.0.1"), "addr-reject-cgnat", fails)
    t7check(not Git::rh_addr_guard("198.51.100.7"), "addr-reject-documentation-v4-test-net-2", fails)
    t7check(not Git::rh_addr_guard("203.0.113.7"), "addr-reject-documentation-v4-test-net-3", fails)
    t7check(not Git::rh_addr_guard("192.88.99.2"), "addr-reject-retired-6to4-relay", fails)
    t7check(not Git::rh_addr_guard("224.0.0.1"), "addr-reject-multicast", fails)
    t7check(not Git::rh_addr_guard("::1"), "addr-reject-v6-loopback", fails)
    t7check(not Git::rh_addr_guard("::"), "addr-reject-v6-unspecified", fails)
    t7check(not Git::rh_addr_guard("fe80::1"), "addr-reject-v6-linklocal", fails)
    t7check(not Git::rh_addr_guard("fc00::1"), "addr-reject-v6-ula-fc", fails)
    t7check(not Git::rh_addr_guard("fd12::1"), "addr-reject-v6-ula-fd", fails)
    t7check(not Git::rh_addr_guard("ff02::1"), "addr-reject-v6-multicast", fails)
    t7check(not Git::rh_addr_guard("::ffff:127.0.0.1"), "addr-reject-v4mapped", fails)
    t7check(not Git::rh_addr_guard("0:0:0:0:0:0:0:1"), "addr-reject-expanded-loopback", fails)
    t7check(not Git::rh_addr_guard("0:0:0:0:0:0:0:0"), "addr-reject-expanded-unspecified", fails)
    t7check(not Git::rh_addr_guard("0:0:0:0:0:ffff:7f00:1"), "addr-reject-expanded-v4mapped", fails)
    t7check(not Git::rh_addr_guard("fe90::1"), "addr-reject-full-linklocal-range", fails)
    t7check(not Git::rh_addr_guard("fedd::1"), "addr-reject-site-local", fails)
    t7check(not Git::rh_addr_guard("2001:db8::1"), "addr-reject-documentation-v6", fails)
    t7check(not Git::rh_addr_guard("2001:0::1"), "addr-reject-ietf-special-v6-teredo", fails)
    t7check(not Git::rh_addr_guard("2001:2::1"), "addr-reject-ietf-special-v6-benchmark", fails)
    t7check(not Git::rh_addr_guard("3fff::1"), "addr-reject-second-documentation-v6", fails)
    t7check(not Git::rh_addr_guard("2002:c000:0204::1"), "addr-reject-6to4", fails)
    t7check(not Git::rh_addr_guard("2001:db8::zz"), "addr-reject-non-hex-v6", fails)
    t7check(not Git::rh_addr_guard("2001::db8::1"), "addr-reject-double-compression", fails)
    t7check(not Git::rh_addr_guard("12345::1"), "addr-reject-overlong-hextet", fails)
    t7check(not Git::rh_addr_guard("not:an:ip"), "addr-reject-colon-malformed", fails)
    t7check(not Git::rh_addr_guard("not-an-ip"), "addr-reject-unknown-form", fails)
    return

# --- M07-03: parser hardening (structured failure, bounded) -------------
def try_bad_json(data: darray[u8]&, label: u8&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    t7check(Json::rh_json_parse(data, nodes, texts) < 0, label, fails)

def check_json_hardening(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    a0: darray[u8] = []
    try_bad_json(a0, "json-reject-empty", fails)
    a1: darray[u8] = [123]
    try_bad_json(a1, "json-reject-open-brace", fails)
    a2: darray[u8] = [91]
    try_bad_json(a2, "json-reject-open-bracket", fails)
    a3: darray[u8] = [123, 34, 97, 34, 58, 49]
    try_bad_json(a3, "json-reject-truncated-object", fails)
    a4: darray[u8] = [91, 49, 44, 50, 44]
    try_bad_json(a4, "json-reject-trailing-comma", fails)
    a5: darray[u8] = [49, 32, 50]
    try_bad_json(a5, "json-reject-trailing-garbage", fails)
    deep: mutable darray[u8] = []
    while k < 600 |k: i64 = 0, deep|:
        deep.push(91)
        k <- k + 1
    while j < 600 |j: i64 = 0, deep|:
        deep.push(93)
        j <- j + 1
    dn: mutable darray[Json::RhJsonNode] = []
    dt: mutable darray[u8] = []
    t7check(Json::rh_json_parse(deep, dn, dt) < 0, "json-reject-depth-bound", fails)
    return

def check_json_fuzz_case(data: darray[u8]&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    root_in_bounds: bool =
        nodes: mutable darray[Json::RhJsonNode] = []
        texts: mutable darray[u8] = []
        root: i64 = Json::rh_json_parse(data, nodes, texts)
        (root == -1 or (root >= 0 and root < nodes.count.i64())) and nodes.count <= data.count and texts.count <= data.count
    t7check(root_in_bounds, "json-fuzz-root-bounds", fails)
    return

def check_json_fuzz(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    corpus: mutable darray[u8] = []
    Base::rh_push_text(corpus, "{\"name\":\"elisa\",\"deps\":[\"a\",\"b\"],\"n\":42,\"ok\":true}")
    while trial < 128 |trial: i64 = 0, rng: i64 = 1, corpus, fails|:
        fuzzed: mutable darray[u8] = []
        while copied < corpus.count |copied: usize = 0, corpus, fuzzed|:
            fuzzed.push(corpus[copied])
            copied <- copied + 1
        rng <- (rng * 48271) % 2147483647
        edits: i64 = 1 + rng % 5
        while edit < edits |edit: i64 = 0, rng, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            pos: usize = (rng % fuzzed.count.i64()).usize()
            rng <- (rng * 48271) % 2147483647
            fuzzed[pos] <- (rng % 256).u8()
            edit <- edit + 1
        check_json_fuzz_case(fuzzed, fails)
        trial <- trial + 1

    alphabet: mutable darray[u8] = [91, 93, 123, 125, 34, 58, 44, 45, 48, 49, 116, 114, 117, 101, 102, 97, 108, 115, 110, 32, 9, 92, 46, 69, 43]
    while trial < 128 |trial: i64 = 0, rng: i64 = 8675309, alphabet, fails|:
        rng <- (rng * 48271) % 2147483647
        byte_count: usize = (1 + rng % 96).usize()
        fuzzed: mutable darray[u8] = []
        while pos < byte_count |pos: usize = 0, rng, alphabet, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            choice: usize = (rng % alphabet.count.i64()).usize()
            fuzzed.push(alphabet[choice])
            pos <- pos + 1
        check_json_fuzz_case(fuzzed, fails)
        trial <- trial + 1
    return

def check_cargo_fuzz_case(data: darray[u8]&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    bounded_result: bool =
        packages: mutable darray[Package::RhPkgNode] = []
        pool: mutable darray[u8] = []
        requirements: mutable darray[Package::RhRequire] = []
        unknown: mutable i64 = 0
        parsed: i64 = Package::rh_cargo_parse(data, packages, pool, requirements, &unknown)
        (parsed == -1 or (parsed >= 0 and parsed <= data.count.i64())) and packages.count <= data.count and pool.count <= data.count and requirements.count <= data.count and unknown >= 0 and unknown <= data.count.i64() + 1
    t7check(bounded_result, "cargo-fuzz-bounds", fails)
    return

