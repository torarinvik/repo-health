            rng <- (rng * 48271) % 2147483647
            pos: usize = (rng % fuzzed.count.i64()).usize()
            rng <- (rng * 48271) % 2147483647
            fuzzed[pos] <- (rng % 128).u8()
            edit <- edit + 1
        check_semver_fuzz_case(fuzzed, fails)
        trial <- trial + 1

    alphabet: mutable darray[u8] = [118, 48, 49, 50, 51, 46, 45, 43, 97, 98, 99, 120, 121, 122, 48, 57]
    while trial < 128 |trial: i64 = 0, rng: i64 = 8675309, alphabet, fails|:
        rng <- (rng * 48271) % 2147483647
        byte_count: usize = (1 + rng % 96).usize()
        fuzzed: mutable darray[u8] = []
        while pos < byte_count |pos: usize = 0, rng, alphabet, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            choice: usize = (rng % alphabet.count.i64()).usize()
            fuzzed.push(alphabet[choice])
            pos <- pos + 1
        check_semver_fuzz_case(fuzzed, fails)
        trial <- trial + 1
    return

def check_lock_hardening(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    garbage: mutable darray[u8] = [91, 91, 112, 97, 99, 107]
    pkgs: mutable darray[Package::RhPkgNode] = []
    pool: mutable darray[u8] = []
    reqs: mutable darray[Package::RhRequire] = []
    unk: mutable i64 = 0
    _ = Package::rh_cargo_parse(garbage, pkgs, pool, reqs, &unk)
    t7check(pkgs.count == 0, "cargo-garbage-no-nodes", fails)
    nbytes: mutable darray[u8] = [123, 123, 123]
    npkgs: mutable darray[Package::RhPkgNode] = []
    npool: mutable darray[u8] = []
    npaths: mutable darray[i64] = []
    nreqs: mutable darray[Package::RhRequire] = []
    _ = Package::rh_npm_lock_parse(nbytes, garbage, npkgs, npool, npaths, nreqs)
    t7check(npkgs.count == 0, "npm-garbage-no-nodes", fails)
    return

# --- M07-11: monitoring separation --------------------------------------
def check_monitoring(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    m: mutable RhMon = Ops::rh_mon_new(3600)
    t7check(Ops::rh_mon_observed_rate_bp(m) == -1, "mon-no-denominator-unknown", fails)
    Ops::rh_mon_observed(m)
    Ops::rh_mon_observed(m)
    Ops::rh_mon_observed(m)
    Ops::rh_mon_unknown(m)
    rate: i64 = Ops::rh_mon_observed_rate_bp(m)
    t7check(rate == 7500, "mon-rate-3of4", fails)
    t7check(Ops::rh_mon_freshness_age(m, 500) == -1, "mon-never-fresh", fails)
    Ops::rh_mon_success(m, 1000)
    t7check(Ops::rh_mon_freshness_age(m, 1500) == 500, "mon-freshness-age", fails)
    t7check(Ops::rh_mon_freshness_age(m, 900) == 0, "mon-freshness-clock-skew-clamped", fails)
    Ops::rh_mon_error(m)
    Ops::rh_mon_parser_reject(m)
    Ops::rh_mon_truncation(m)
    out: mutable darray[u8] = []
    Ops::rh_mon_text(m, 1500, out)
    t7check(m7_contains(out, "rh_project_unknown_total 1"), "mon-text-unknown", fails)
    t7check(m7_contains(out, "rh_project_observed_rate_bp 7500"), "mon-text-rate", fails)
    t7check(m7_contains(out, "rh_service_freshness_age_seconds 500"), "mon-text-freshness", fails)
    t7check(m7_contains(out, "rh_project_truncations_total 1"), "mon-text-trunc", fails)
    t7check(not m7_contains(out, "rh_project_queue_age"), "mon-service-project-separate", fails)
    return

# --- M07-12: source-respect quotas --------------------------------------
def check_quota(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    p: Ops::RhHostPolicy = Ops::RhHostPolicy{capacity: 2, refill_per_second: 1, base_backoff_seconds: 10, max_backoff_seconds: 100}
    st: mutable Ops::RhHostState = Ops::rh_host_new(7, 2)
    t7check(Ops::rh_host_consume(st, p, 0) == 1, "q-consume-1", fails)
    t7check(Ops::rh_host_consume(st, p, 0) == 1, "q-consume-2", fails)
    t7check(Ops::rh_host_consume(st, p, 0) == 0, "q-empty-refused", fails)
    t7check(Ops::rh_host_consume(st, p, 5) == 1, "q-refill", fails)
    w1: i64 = Ops::rh_host_record_failure(st, p, 5)
    t7check(w1 == 10, "q-backoff-10", fails)
    t7check(Ops::rh_host_allow(st, p, 10) == 0, "q-backoff-blocks", fails)
    t7check(Ops::rh_host_consume(st, p, 10) == 0, "q-backoff-no-request", fails)
    t7check(Ops::rh_host_consume(st, p, 16) == 1, "q-backoff-expires", fails)
    w2: i64 = Ops::rh_host_record_failure(st, p, 16)
    t7check(w2 == 20, "q-backoff-doubles", fails)
    Ops::rh_host_record_success(st)
    t7check(Ops::rh_host_allow(st, p, 17) == 1, "q-success-clears", fails)
    Ops::rh_host_stop(st)
    t7check(Ops::rh_host_consume(st, p, 17) == 0, "q-stop-killswitch", fails)
    return

def check_backup(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    ev: mutable darray[u8] =
        ev: mutable darray[u8] = []
        Base::rh_push_text(ev, "build/tmp_m07/store/evidence")
        ev.push(0)
        ev
    evp: cstr = (&ev[0]).cast[cstr] can Unsafe.PointerCast
    da: mutable darray[u8] = []
    Base::rh_push_text(da, "alpha")
    ha: mutable darray[u8] = []
    t7check(Store::rh_store_blob(evp, da, ha) == 0, "bk-store-a", fails)
    db: mutable darray[u8] = []
    Base::rh_push_text(db, "beta")
    hb: mutable darray[u8] = []
    t7check(Store::rh_store_blob(evp, db, hb) == 0, "bk-store-b", fails)
    dc: mutable darray[u8] = []
    Base::rh_push_text(dc, "gamma")
    hc: mutable darray[u8] = []
    t7check(Store::rh_store_blob(evp, dc, hc) == 0, "bk-store-c", fails)
    names: mutable darray[u8] = []
    k: mutable usize =
        while k < ha.count |k: usize = 0, ha, names| -> k:
            names.push(ha[k])
            k <- k + 1
    names.push(10)
    k <- 0
    while k < hb.count |k, hb, names|:
        names.push(hb[k])
        k <- k + 1
    names.push(10)
    k <- 0
    while k < hc.count |k, hc, names|:
        names.push(hc[k])
        k <- k + 1
    names.push(10)
    man: mutable darray[u8] =
        man: mutable darray[u8] = []
        Base::rh_push_text(man, "build/tmp_m07/backup.manifest")
        man.push(0)
        man
    mp: cstr = (&man[0]).cast[cstr] can Unsafe.PointerCast
    t7check(Ops::rh_backup_write(mp, names), "bk-write-manifest", fails)
    p_out: mutable i64 = 0
    m_out: mutable i64 = 0
    c_out: mutable i64 = 0
    _ = Ops::rh_backup_verify(evp, mp, &p_out, &m_out, &c_out)
    t7check(p_out == 3 and c_out == 0, "bk-verify-clean", fails)
    # Corrupt blob C in place: verify must catch it, restore must skip it.
    cbuf: mutable darray[u8] = []
    cn: mutable darray[u8] = []
    k <- 0
    while k < hc.count |k, hc, cn|:
        cn.push(hc[k])
        k <- k + 1
    cn.push(0)
    cnp: cstr = (&cn[0]).cast[cstr] can Unsafe.PointerCast
    Base::rh_push_cstr(cbuf, evp)
    cbuf.push(47)
    Base::rh_push_cstr(cbuf, cnp)
    cbuf.push(0)
    cpath: cstr = (&cbuf[0]).cast[cstr] can Unsafe.PointerCast
    tampered: mutable darray[u8] = []
    Base::rh_push_text(tampered, "tampered")
    _ = Base::rh_io_write(cpath, tampered)
    _ = Ops::rh_backup_verify(evp, mp, &p_out, &m_out, &c_out)
    t7check(c_out == 1, "bk-detect-corrupt", fails)
    dst: mutable darray[u8] =
        dst: mutable darray[u8] = []
        Base::rh_push_text(dst, "build/tmp_m07/restore/evidence")
        dst.push(0)
        dst
    dstp: cstr = (&dst[0]).cast[cstr] can Unsafe.PointerCast
    r_out: mutable i64 = 0
    _ = Ops::rh_backup_restore(evp, dstp, mp, &r_out)
    t7check(r_out == 2, "bk-restore-skips-corrupt", fails)
    ok: mutable i64 = 0
    ha2: mutable darray[u8] = []
    k <- 0
    while k < ha.count |k, ha, ha2|:
        ha2.push(ha[k])
        k <- k + 1
    ha2.push(0)
    hap: cstr = (&ha2[0]).cast[cstr] can Unsafe.PointerCast
    _ = Store::rh_store_blob_verify(dstp, hap, &ok)
    t7check(ok == 1, "bk-restored-verifies", fails)

    # --- M07-08 deletion drill: replayability label changes ---
    dd: mutable darray[u8] = []
    Base::rh_push_text(dd, "delete-me")
    hd: mutable darray[u8] = []
    t7check(Store::rh_store_blob(evp, dd, hd) == 0, "dr-store", fails)
    refd: mutable darray[u8] = []
    k <- 0
    while k < hd.count |k, hd, refd|:
        refd.push(hd[k])
        k <- k + 1
    refd.push(10)
    t7check(Ops::rh_replay_label(evp, refd) == Ops::RH_REPLAY_REPLAYABLE, "dr-replayable-before", fails)
    hdn: mutable darray[u8] = []
    k <- 0
    while k < hd.count |k, hd, hdn|:
        hdn.push(hd[k])
        k <- k + 1
    hdn.push(0)
    hdnp: u8& = (&hdn[0]).cast[u8&] can Unsafe.PointerCast
    t7check(Store::rh_store_delete_blob(evp, hdnp) == 0, "dr-delete", fails)
    t7check(Ops::rh_replay_label(evp, refd) == Ops::RH_REPLAY_NOT_REPLAYABLE, "dr-not-replayable-after", fails)
    emptyref: mutable darray[u8] = []
    t7check(Ops::rh_replay_label(evp, emptyref) == Ops::RH_REPLAY_UNKNOWN, "dr-empty-unknown", fails)
    return

# --- M07-07: publication suppression ------------------------------------
def check_publication(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    t7check(Privacy::rh_pub_decide(0, 0, 0, 0, 5) == Privacy::RH_PUB_UNAVAILABLE, "pub-empty-unavailable", fails)
    t7check(Privacy::rh_pub_decide(1, 0, 0, 0, 5) == Privacy::RH_PUB_SUPPRESS_SMALL, "pub-small-suppressed", fails)
    t7check(Privacy::rh_pub_decide(4, 0, 0, 0, 5) == Privacy::RH_PUB_SUPPRESS_SMALL, "pub-below-threshold", fails)
    t7check(Privacy::rh_pub_decide(5, 0, 0, 0, 5) == Privacy::RH_PUB_PUBLISH, "pub-at-threshold", fails)
    t7check(Privacy::rh_pub_decide(9, 1, 0, 0, 5) == Privacy::RH_PUB_PUBLISH, "pub-authorized-broad", fails)
    t7check(Privacy::rh_pub_decide(9, 0, 1, 0, 5) == Privacy::RH_PUB_WITHHOLD_PRIVATE, "pub-private-withheld", fails)
    t7check(Privacy::rh_pub_decide(0, 0, 0, 1, 5) == Privacy::RH_PUB_WITHHOLD_UNKNOWN, "pub-unknown-withheld", fails)
    # Precedence: unknown > private > threshold.
    t7check(Privacy::rh_pub_decide(9, 0, 1, 1, 5) == Privacy::RH_PUB_WITHHOLD_UNKNOWN, "pub-unknown-wins", fails)
    t7check(not Privacy::rh_pub_is_publishable(Privacy::rh_pub_decide(9, 0, 1, 0, 5)), "pub-private-not-publishable", fails)
    t7check(not Privacy::rh_pub_is_publishable(Privacy::rh_pub_decide(1, 0, 0, 0, 5)), "pub-small-not-publishable", fails)
    out: mutable darray[u8] = []
    Privacy::rh_pub_text(Privacy::RH_PUB_WITHHOLD_PRIVATE, 9, 0, 1, 0, 5, out)
    t7check(m7_contains(out, "withhold_private_member"), "pub-text-decision", fails)
    t7check(m7_contains(out, "suppression is not anonymization"), "pub-text-anonymity-caveat", fails)
    return

def main() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    fails: mutable i64 = 0
    check_transport(&fails)
    check_publication(&fails)
    check_addr_guard(&fails)
    check_json_hardening(&fails)
    check_json_fuzz(&fails)
    check_cargo_fuzz(&fails)
    check_archive_fuzz(&fails)
    check_npm_fuzz(&fails)
    check_yarn_fuzz(&fails)
    check_pnpm_fuzz(&fails)
    check_go_fuzz(&fails)
    check_xml_lock_fuzz(&fails)
    check_gem_composer_fuzz(&fails)
    check_python_requirement_fuzz(&fails)
    check_semver_hardening(&fails)
    check_semver_fuzz(&fails)
    check_lock_hardening(&fails)
    check_monitoring(&fails)
    check_quota(&fails)
    check_backup(&fails)
    if fails == 0:
        b: mutable darray[u8] =
            b: mutable darray[u8] = []
            Base::rh_push_text(b, "M07 OK")
            b.push(10)
            b
        Base::rh_write_stdout(b)
        return 0
    1
