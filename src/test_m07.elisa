        while edit < edits |edit: i64 = 0, rng, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            pos: usize = (rng % fuzzed.count.i64()).usize()
            rng <- (rng * 48271) % 2147483647
            fuzzed[pos] <- (rng % 128).u8()
            edit <- edit + 1
        check_cargo_fuzz_case(fuzzed, fails)
