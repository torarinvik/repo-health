    alphabet: mutable darray[u8] = [91, 93, 34, 61, 46, 45, 95, 32, 10, 48, 49, 50, 97, 98, 99, 100, 101, 110, 112, 114, 115, 116, 118, 121]
    while trial < 128 |trial: i64 = 0, rng: i64 = 11235813, alphabet, fails|:
        rng <- (rng * 48271) % 2147483647
