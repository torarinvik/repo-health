# test_m07.elisa — M07 security/ops cores: adversarial transport (S002),
# parser hardening (M07-03), monitoring separation (M07-11), per-host
# source-respect (M07-12), and backup/restore drills (M07-10).
# Deterministic, offline. Requires workdir `build/tmp_m07` pre-created.
include "./rh_base.elisa"
include "./rh_git.elisa"
include "./rh_store.elisa"
include "./rh_ops.elisa"
include "./rh_json.elisa"
include "./rh_package.elisa"
include "./rh_privacy.elisa"

def t7check(cond: bool, label: u8&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    return if cond
    fails[0] <- fails[0] + 1
    b: mutable darray[u8] =
        b: mutable darray[u8] = []
        Base::rh_push_text(b, "M07-FAIL ")
        Base::rh_push_text(b, label)
        b.push(10)
        b
    Base::rh_write_stdout(b)

def m7_contains(hay: darray[u8]&, needle: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: usize = strlen(needle)
    return false if n == 0 or hay.count < n
    while i + n <= hay.count |i: usize = 0, hay, needle, n|:
        same: bool =
            while k < n |same: bool = true, k: usize = 0, i| -> same:
                if hay[i + k] != needle[k]:
                    same <- false
                k <- k + 1
        return true if same
        i <- i + 1
    false

# --- M07-02: adversarial transport --------------------------------------
def check_transport(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    t7check(Git::rh_fetch_guard("https://example.com/"), "tx-accept-host", fails)
    t7check(Git::rh_fetch_guard("https://gitlab.example.org/g/p"), "tx-accept-path", fails)
    t7check(Git::rh_fetch_guard("https://8.8.8.8/x"), "tx-accept-public-v4", fails)
    t7check(Git::rh_fetch_guard("file:///tmp/f"), "tx-accept-file", fails)
    t7check(not Git::rh_fetch_guard("http://example.com/"), "tx-reject-http", fails)
    t7check(not Git::rh_fetch_guard("https://127.0.0.1/"), "tx-reject-loopback", fails)
    t7check(not Git::rh_fetch_guard("https://10.0.0.5/"), "tx-reject-rfc1918-10", fails)
    t7check(not Git::rh_fetch_guard("https://172.16.0.1/"), "tx-reject-rfc1918-172", fails)
    t7check(Git::rh_fetch_guard("https://172.32.0.1/"), "tx-accept-172-public", fails)
    t7check(not Git::rh_fetch_guard("https://192.168.1.1/"), "tx-reject-rfc1918-192", fails)
    t7check(not Git::rh_fetch_guard("https://169.254.169.254/"), "tx-reject-metadata", fails)
    t7check(not Git::rh_fetch_guard("https://100.64.0.1/"), "tx-reject-cgnat", fails)
    t7check(not Git::rh_fetch_guard("https://198.18.0.1/"), "tx-reject-benchmark", fails)
    t7check(not Git::rh_fetch_guard("https://224.0.0.1/"), "tx-reject-multicast", fails)
    t7check(not Git::rh_fetch_guard("https://0.0.0.0/"), "tx-reject-unspecified", fails)
    t7check(not Git::rh_fetch_guard("https://[::1]/"), "tx-reject-v6-brackets", fails)
    t7check(not Git::rh_fetch_guard("https://[fd00::1]/"), "tx-reject-v6-ula", fails)
    t7check(not Git::rh_fetch_guard("https://user@example.com/"), "tx-reject-userinfo", fails)
    t7check(not Git::rh_fetch_guard("https://user:pass@example.com/"), "tx-reject-credential", fails)
    t7check(not Git::rh_fetch_guard("https://example.com:8080/"), "tx-reject-port", fails)
    t7check(not Git::rh_fetch_guard("https://example.com%2f@evil/"), "tx-reject-percent", fails)
    t7check(not Git::rh_fetch_guard("https://2130706433/"), "tx-reject-decimal-ip", fails)
    t7check(not Git::rh_fetch_guard("https://0x7f.0.0.1/"), "tx-reject-hex-ip", fails)
    t7check(not Git::rh_fetch_guard("https://0177.0.0.1/"), "tx-reject-octal-ip", fails)
    t7check(not Git::rh_fetch_guard("https://127.1/"), "tx-reject-short-v4", fails)
    t7check(not Git::rh_fetch_guard("https://exa_mple.com/"), "tx-reject-underscore", fails)
    t7check(not Git::rh_fetch_guard("file://"), "tx-reject-bare-file", fails)
    return

def check_addr_guard(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    t7check(Git::rh_addr_guard("93.184.216.34"), "addr-accept-public-v4", fails)
    t7check(Git::rh_addr_guard("2606:2800:220:1:248:1893:25c8:1946"), "addr-accept-public-v6", fails)
    t7check(Git::rh_addr_guard("2001:4860:4860::8888"), "addr-accept-compressed-public-v6", fails)
    t7check(not Git::rh_addr_guard("127.0.0.1"), "addr-reject-loopback", fails)
    t7check(not Git::rh_addr_guard("10.1.2.3"), "addr-reject-private", fails)
    t7check(not Git::rh_addr_guard("169.254.169.254"), "addr-reject-linklocal", fails)
    t7check(not Git::rh_addr_guard("100.64.0.1"), "addr-reject-cgnat", fails)
    t7check(not Git::rh_addr_guard("198.51.100.7"), "addr-reject-documentation-v4-test-net-2", fails)
    t7check(not Git::rh_addr_guard("203.0.113.7"), "addr-reject-documentation-v4-test-net-3", fails)
    t7check(not Git::rh_addr_guard("192.88.99.2"), "addr-reject-retired-6to4-relay", fails)
    t7check(not Git::rh_addr_guard("224.0.0.1"), "addr-reject-multicast", fails)
    t7check(not Git::rh_addr_guard("::1"), "addr-reject-v6-loopback", fails)
    t7check(not Git::rh_addr_guard("::"), "addr-reject-v6-unspecified", fails)
    t7check(not Git::rh_addr_guard("fe80::1"), "addr-reject-v6-linklocal", fails)
    t7check(not Git::rh_addr_guard("fc00::1"), "addr-reject-v6-ula-fc", fails)
    t7check(not Git::rh_addr_guard("fd12::1"), "addr-reject-v6-ula-fd", fails)
    t7check(not Git::rh_addr_guard("ff02::1"), "addr-reject-v6-multicast", fails)
    t7check(not Git::rh_addr_guard("::ffff:127.0.0.1"), "addr-reject-v4mapped", fails)
    t7check(not Git::rh_addr_guard("0:0:0:0:0:0:0:1"), "addr-reject-expanded-loopback", fails)
    t7check(not Git::rh_addr_guard("0:0:0:0:0:0:0:0"), "addr-reject-expanded-unspecified", fails)
    t7check(not Git::rh_addr_guard("0:0:0:0:0:ffff:7f00:1"), "addr-reject-expanded-v4mapped", fails)
    t7check(not Git::rh_addr_guard("fe90::1"), "addr-reject-full-linklocal-range", fails)
    t7check(not Git::rh_addr_guard("fedd::1"), "addr-reject-site-local", fails)
    t7check(not Git::rh_addr_guard("2001:db8::1"), "addr-reject-documentation-v6", fails)
    t7check(not Git::rh_addr_guard("2001:0::1"), "addr-reject-ietf-special-v6-teredo", fails)
    t7check(not Git::rh_addr_guard("2001:2::1"), "addr-reject-ietf-special-v6-benchmark", fails)
    t7check(not Git::rh_addr_guard("3fff::1"), "addr-reject-second-documentation-v6", fails)
    t7check(not Git::rh_addr_guard("2002:c000:0204::1"), "addr-reject-6to4", fails)
    t7check(not Git::rh_addr_guard("2001:db8::zz"), "addr-reject-non-hex-v6", fails)
    t7check(not Git::rh_addr_guard("2001::db8::1"), "addr-reject-double-compression", fails)
    t7check(not Git::rh_addr_guard("12345::1"), "addr-reject-overlong-hextet", fails)
    t7check(not Git::rh_addr_guard("not:an:ip"), "addr-reject-colon-malformed", fails)
    t7check(not Git::rh_addr_guard("not-an-ip"), "addr-reject-unknown-form", fails)
    return

# --- M07-03: parser hardening (structured failure, bounded) -------------
def try_bad_json(data: darray[u8]&, label: u8&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    t7check(Json::rh_json_parse(data, nodes, texts) < 0, label, fails)

def check_json_hardening(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    a0: darray[u8] = []
    try_bad_json(a0, "json-reject-empty", fails)
    a1: darray[u8] = [123]
    try_bad_json(a1, "json-reject-open-brace", fails)
    a2: darray[u8] = [91]
    try_bad_json(a2, "json-reject-open-bracket", fails)
    a3: darray[u8] = [123, 34, 97, 34, 58, 49]
    try_bad_json(a3, "json-reject-truncated-object", fails)
    a4: darray[u8] = [91, 49, 44, 50, 44]
    try_bad_json(a4, "json-reject-trailing-comma", fails)
    a5: darray[u8] = [49, 32, 50]
    try_bad_json(a5, "json-reject-trailing-garbage", fails)
    deep: mutable darray[u8] = []
    while k < 600 |k: i64 = 0, deep|:
        deep.push(91)
        k <- k + 1
    while j < 600 |j: i64 = 0, deep|:
        deep.push(93)
        j <- j + 1
    dn: mutable darray[Json::RhJsonNode] = []
    dt: mutable darray[u8] = []
    t7check(Json::rh_json_parse(deep, dn, dt) < 0, "json-reject-depth-bound", fails)
    return

def check_json_fuzz_case(data: darray[u8]&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    root_in_bounds: bool =
        nodes: mutable darray[Json::RhJsonNode] = []
        texts: mutable darray[u8] = []
        root: i64 = Json::rh_json_parse(data, nodes, texts)
        (root == -1 or (root >= 0 and root < nodes.count.i64())) and nodes.count <= data.count and texts.count <= data.count
    t7check(root_in_bounds, "json-fuzz-root-bounds", fails)
    return

def check_json_fuzz(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    corpus: mutable darray[u8] = []
    Base::rh_push_text(corpus, "{\"name\":\"elisa\",\"deps\":[\"a\",\"b\"],\"n\":42,\"ok\":true}")
    while trial < 128 |trial: i64 = 0, rng: i64 = 1, corpus, fails|:
        fuzzed: mutable darray[u8] = []
        while copied < corpus.count |copied: usize = 0, corpus, fuzzed|:
            fuzzed.push(corpus[copied])
            copied <- copied + 1
        rng <- (rng * 48271) % 2147483647
        edits: i64 = 1 + rng % 5
        while edit < edits |edit: i64 = 0, rng, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            pos: usize = (rng % fuzzed.count.i64()).usize()
            rng <- (rng * 48271) % 2147483647
            fuzzed[pos] <- (rng % 256).u8()
            edit <- edit + 1
        check_json_fuzz_case(fuzzed, fails)
        trial <- trial + 1

    alphabet: mutable darray[u8] = [91, 93, 123, 125, 34, 58, 44, 45, 48, 49, 116, 114, 117, 101, 102, 97, 108, 115, 110, 32, 9, 92, 46, 69, 43]
    while trial < 128 |trial: i64 = 0, rng: i64 = 8675309, alphabet, fails|:
        rng <- (rng * 48271) % 2147483647
        byte_count: usize = (1 + rng % 96).usize()
        fuzzed: mutable darray[u8] = []
        while pos < byte_count |pos: usize = 0, rng, alphabet, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            choice: usize = (rng % alphabet.count.i64()).usize()
            fuzzed.push(alphabet[choice])
            pos <- pos + 1
        check_json_fuzz_case(fuzzed, fails)
        trial <- trial + 1
    return

def check_cargo_fuzz_case(data: darray[u8]&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    bounded_result: bool =
        packages: mutable darray[Package::RhPkgNode] = []
        pool: mutable darray[u8] = []
        requirements: mutable darray[Package::RhRequire] = []
        unknown: mutable i64 = 0
        parsed: i64 = Package::rh_cargo_parse(data, packages, pool, requirements, &unknown)
        (parsed == -1 or (parsed >= 0 and parsed <= data.count.i64())) and packages.count <= data.count and pool.count <= data.count and requirements.count <= data.count and unknown >= 0 and unknown <= data.count.i64() + 1
    t7check(bounded_result, "cargo-fuzz-bounds", fails)
    return

def check_cargo_fuzz(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    corpus: mutable darray[u8] = []
    Base::rh_push_text(corpus, "[[package]]\nname = \"serde\"\nversion = \"1.0.0\"\ndependencies = [\n \"itoa 1.0.0\",\n]\n")
    while trial < 96 |trial: i64 = 0, rng: i64 = 314159, corpus, fails|:
        fuzzed: mutable darray[u8] = []
        while copied < corpus.count |copied: usize = 0, corpus, fuzzed|:
            fuzzed.push(corpus[copied])
            copied <- copied + 1
        rng <- (rng * 48271) % 2147483647
        edits: i64 = 1 + rng % 4
        while edit < edits |edit: i64 = 0, rng, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            pos: usize = (rng % fuzzed.count.i64()).usize()
            rng <- (rng * 48271) % 2147483647
            fuzzed[pos] <- (rng % 128).u8()
            edit <- edit + 1
        check_cargo_fuzz_case(fuzzed, fails)
        trial <- trial + 1

    alphabet: mutable darray[u8] = [91, 93, 34, 61, 46, 45, 95, 32, 10, 48, 49, 50, 97, 98, 99, 100, 101, 110, 112, 114, 115, 116, 118, 121]
    while trial < 128 |trial: i64 = 0, rng: i64 = 11235813, alphabet, fails|:
        rng <- (rng * 48271) % 2147483647
        byte_count: usize = (1 + rng % 96).usize()
        fuzzed: mutable darray[u8] = []
        while pos < byte_count |pos: usize = 0, rng, alphabet, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            choice: usize = (rng % alphabet.count.i64()).usize()
            fuzzed.push(alphabet[choice])
            pos <- pos + 1
        check_cargo_fuzz_case(fuzzed, fails)
        trial <- trial + 1
    return

def try_bad_semver(data: darray[u8]&, label: u8&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    ok: bool =
        vv: mutable Package::RhSemver = Package::RhSemver{0, 0, 0, 0, 0}
        block_result: bool = Package::rh_semver_parse(data, 0, data.count.usize(), &vv)
        block_result
    t7check(not ok, label, fails)

def check_semver_hardening(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    good: mutable darray[u8] = []
    Base::rh_push_text(good, "1.2.3")
    v: mutable Package::RhSemver = Package::RhSemver{0, 0, 0, 0, 0}
    t7check(Package::rh_semver_parse(good, 0, 5, &v), "sem-accept", fails)
    # Partial versions ("1", "1.2") are accepted on purpose: Cargo-style
    # requirements rely on them. Only malformed forms are rejected.
    p1: darray[u8] = [49]
    vp1: mutable Package::RhSemver = Package::RhSemver{0, 0, 0, 0, 0}
    t7check(Package::rh_semver_parse(p1, 0, 1, &vp1), "sem-accept-major-only", fails)
    p2: darray[u8] = [49, 46, 50]
    vp2: mutable Package::RhSemver = Package::RhSemver{0, 0, 0, 0, 0}
    t7check(Package::rh_semver_parse(p2, 0, 3, &vp2), "sem-accept-two-part", fails)
    b0: darray[u8] = []
    try_bad_semver(b0, "sem-reject-empty", fails)
    b3: darray[u8] = [49, 46, 50, 46, 51, 46, 52]
    try_bad_semver(b3, "sem-reject-four-part", fails)
    b4: darray[u8] = [48, 49, 46, 50, 46, 51]
    try_bad_semver(b4, "sem-reject-leading-zero", fails)
    b5: darray[u8] = [49, 46, 50, 46]
    try_bad_semver(b5, "sem-reject-trailing-dot", fails)
    return

def check_semver_fuzz_case(data: darray[u8]&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    valid_result: bool =
        version: mutable Package::RhSemver = Package::RhSemver{0, 0, 0, -1, -1}
        parsed: bool = Package::rh_semver_parse(data, 0, data.count, &version)
        span_valid: bool = (version.pre_s == -1 and version.pre_e == -1) or (version.pre_s >= 0 and version.pre_s < version.pre_e and version.pre_e <= data.count.i64())
        shape_valid: bool = version.major >= 0 and version.minor >= 0 and version.patch >= 0 and span_valid
        not parsed or shape_valid
    t7check(valid_result, "semver-fuzz-success-shape", fails)
    return

def check_semver_fuzz(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    corpus: mutable darray[u8] = []
    Base::rh_push_text(corpus, "v1.2.3-alpha.1+build.7")
    while trial < 96 |trial: i64 = 0, rng: i64 = 20260920, corpus, fails|:
        fuzzed: mutable darray[u8] = []
        while copied < corpus.count |copied: usize = 0, corpus, fuzzed|:
            fuzzed.push(corpus[copied])
            copied <- copied + 1
        rng <- (rng * 48271) % 2147483647
        edits: i64 = 1 + rng % 4
        while edit < edits |edit: i64 = 0, rng, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            pos: usize = (rng % fuzzed.count.i64()).usize()
            rng <- (rng * 48271) % 2147483647
            fuzzed[pos] <- (rng % 128).u8()
            edit <- edit + 1
        check_semver_fuzz_case(fuzzed, fails)
        trial <- trial + 1

    alphabet: mutable darray[u8] = [118, 48, 49, 50, 51, 46, 45, 43, 97, 98, 99, 120, 121, 122, 48, 57]
    while trial < 128 |trial: i64 = 0, rng: i64 = 8675309, alphabet, fails|:
        rng <- (rng * 48271) % 2147483647
        byte_count: usize = (1 + rng % 96).usize()
        fuzzed: mutable darray[u8] = []
        while pos < byte_count |pos: usize = 0, rng, alphabet, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            choice: usize = (rng % alphabet.count.i64()).usize()
            fuzzed.push(alphabet[choice])
            pos <- pos + 1
        check_semver_fuzz_case(fuzzed, fails)
        trial <- trial + 1
    return

def check_lock_hardening(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    garbage: mutable darray[u8] = [91, 91, 112, 97, 99, 107]
    pkgs: mutable darray[Package::RhPkgNode] = []
    pool: mutable darray[u8] = []
    reqs: mutable darray[Package::RhRequire] = []
    unk: mutable i64 = 0
    _ = Package::rh_cargo_parse(garbage, pkgs, pool, reqs, &unk)
    t7check(pkgs.count == 0, "cargo-garbage-no-nodes", fails)
    nbytes: mutable darray[u8] = [123, 123, 123]
    npkgs: mutable darray[Package::RhPkgNode] = []
    npool: mutable darray[u8] = []
    npaths: mutable darray[i64] = []
    nreqs: mutable darray[Package::RhRequire] = []
    _ = Package::rh_npm_lock_parse(nbytes, garbage, npkgs, npool, npaths, nreqs)
    t7check(npkgs.count == 0, "npm-garbage-no-nodes", fails)
    return

# --- M07-11: monitoring separation --------------------------------------
def check_monitoring(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    m: mutable RhMon = Ops::rh_mon_new(3600)
    t7check(Ops::rh_mon_observed_rate_bp(m) == -1, "mon-no-denominator-unknown", fails)
    Ops::rh_mon_observed(m)
    Ops::rh_mon_observed(m)
    Ops::rh_mon_observed(m)
    Ops::rh_mon_unknown(m)
    rate: i64 = Ops::rh_mon_observed_rate_bp(m)
    t7check(rate == 7500, "mon-rate-3of4", fails)
    t7check(Ops::rh_mon_freshness_age(m, 500) == -1, "mon-never-fresh", fails)
    Ops::rh_mon_success(m, 1000)
    t7check(Ops::rh_mon_freshness_age(m, 1500) == 500, "mon-freshness-age", fails)
    t7check(Ops::rh_mon_freshness_age(m, 900) == 0, "mon-freshness-clock-skew-clamped", fails)
    Ops::rh_mon_error(m)
    Ops::rh_mon_parser_reject(m)
    Ops::rh_mon_truncation(m)
    out: mutable darray[u8] = []
    Ops::rh_mon_text(m, 1500, out)
    t7check(m7_contains(out, "rh_project_unknown_total 1"), "mon-text-unknown", fails)
    t7check(m7_contains(out, "rh_project_observed_rate_bp 7500"), "mon-text-rate", fails)
    t7check(m7_contains(out, "rh_service_freshness_age_seconds 500"), "mon-text-freshness", fails)
    t7check(m7_contains(out, "rh_project_truncations_total 1"), "mon-text-trunc", fails)
    t7check(not m7_contains(out, "rh_project_queue_age"), "mon-service-project-separate", fails)
    return

# --- M07-12: source-respect quotas --------------------------------------
def check_quota(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    p: Ops::RhHostPolicy = Ops::RhHostPolicy{capacity: 2, refill_per_second: 1, base_backoff_seconds: 10, max_backoff_seconds: 100}
    st: mutable Ops::RhHostState = Ops::rh_host_new(7, 2)
    t7check(Ops::rh_host_consume(st, p, 0) == 1, "q-consume-1", fails)
    t7check(Ops::rh_host_consume(st, p, 0) == 1, "q-consume-2", fails)
    t7check(Ops::rh_host_consume(st, p, 0) == 0, "q-empty-refused", fails)
    t7check(Ops::rh_host_consume(st, p, 5) == 1, "q-refill", fails)
    w1: i64 = Ops::rh_host_record_failure(st, p, 5)
    t7check(w1 == 10, "q-backoff-10", fails)
    t7check(Ops::rh_host_allow(st, p, 10) == 0, "q-backoff-blocks", fails)
    t7check(Ops::rh_host_consume(st, p, 10) == 0, "q-backoff-no-request", fails)
    t7check(Ops::rh_host_consume(st, p, 16) == 1, "q-backoff-expires", fails)
    w2: i64 = Ops::rh_host_record_failure(st, p, 16)
    t7check(w2 == 20, "q-backoff-doubles", fails)
    Ops::rh_host_record_success(st)
    t7check(Ops::rh_host_allow(st, p, 17) == 1, "q-success-clears", fails)
    Ops::rh_host_stop(st)
    t7check(Ops::rh_host_consume(st, p, 17) == 0, "q-stop-killswitch", fails)
    return

def check_backup(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    ev: mutable darray[u8] =
        ev: mutable darray[u8] = []
        Base::rh_push_text(ev, "build/tmp_m07/store/evidence")
        ev.push(0)
        ev
    evp: cstr = (&ev[0]).cast[cstr] can Unsafe.PointerCast
    da: mutable darray[u8] = []
    Base::rh_push_text(da, "alpha")
    ha: mutable darray[u8] = []
    t7check(Store::rh_store_blob(evp, da, ha) == 0, "bk-store-a", fails)
    db: mutable darray[u8] = []
    Base::rh_push_text(db, "beta")
    hb: mutable darray[u8] = []
    t7check(Store::rh_store_blob(evp, db, hb) == 0, "bk-store-b", fails)
    dc: mutable darray[u8] = []
    Base::rh_push_text(dc, "gamma")
    hc: mutable darray[u8] = []
    t7check(Store::rh_store_blob(evp, dc, hc) == 0, "bk-store-c", fails)
    names: mutable darray[u8] = []
    k: mutable usize =
        while k < ha.count |k: usize = 0, ha, names| -> k:
            names.push(ha[k])
            k <- k + 1
    names.push(10)
    k <- 0
    while k < hb.count |k, hb, names|:
        names.push(hb[k])
        k <- k + 1
    names.push(10)
    k <- 0
    while k < hc.count |k, hc, names|:
        names.push(hc[k])
        k <- k + 1
    names.push(10)
    man: mutable darray[u8] =
        man: mutable darray[u8] = []
        Base::rh_push_text(man, "build/tmp_m07/backup.manifest")
        man.push(0)
        man
    mp: cstr = (&man[0]).cast[cstr] can Unsafe.PointerCast
    t7check(Ops::rh_backup_write(mp, names), "bk-write-manifest", fails)
    p_out: mutable i64 = 0
    m_out: mutable i64 = 0
    c_out: mutable i64 = 0
    _ = Ops::rh_backup_verify(evp, mp, &p_out, &m_out, &c_out)
    t7check(p_out == 3 and c_out == 0, "bk-verify-clean", fails)
    # Corrupt blob C in place: verify must catch it, restore must skip it.
    cbuf: mutable darray[u8] = []
    cn: mutable darray[u8] = []
    k <- 0
    while k < hc.count |k, hc, cn|:
        cn.push(hc[k])
        k <- k + 1
    cn.push(0)
    cnp: cstr = (&cn[0]).cast[cstr] can Unsafe.PointerCast
    Base::rh_push_cstr(cbuf, evp)
    cbuf.push(47)
    Base::rh_push_cstr(cbuf, cnp)
    cbuf.push(0)
    cpath: cstr = (&cbuf[0]).cast[cstr] can Unsafe.PointerCast
    tampered: mutable darray[u8] = []
    Base::rh_push_text(tampered, "tampered")
    _ = Base::rh_io_write(cpath, tampered)
    _ = Ops::rh_backup_verify(evp, mp, &p_out, &m_out, &c_out)
    t7check(c_out == 1, "bk-detect-corrupt", fails)
    dst: mutable darray[u8] =
        dst: mutable darray[u8] = []
        Base::rh_push_text(dst, "build/tmp_m07/restore/evidence")
        dst.push(0)
        dst
    dstp: cstr = (&dst[0]).cast[cstr] can Unsafe.PointerCast
    r_out: mutable i64 = 0
    _ = Ops::rh_backup_restore(evp, dstp, mp, &r_out)
    t7check(r_out == 2, "bk-restore-skips-corrupt", fails)
    ok: mutable i64 = 0
    ha2: mutable darray[u8] = []
    k <- 0
    while k < ha.count |k, ha, ha2|:
        ha2.push(ha[k])
        k <- k + 1
    ha2.push(0)
    hap: cstr = (&ha2[0]).cast[cstr] can Unsafe.PointerCast
    _ = Store::rh_store_blob_verify(dstp, hap, &ok)
    t7check(ok == 1, "bk-restored-verifies", fails)

    # --- M07-08 deletion drill: replayability label changes ---
    dd: mutable darray[u8] = []
    Base::rh_push_text(dd, "delete-me")
    hd: mutable darray[u8] = []
    t7check(Store::rh_store_blob(evp, dd, hd) == 0, "dr-store", fails)
    refd: mutable darray[u8] = []
    k <- 0
    while k < hd.count |k, hd, refd|:
        refd.push(hd[k])
        k <- k + 1
    refd.push(10)
    t7check(Ops::rh_replay_label(evp, refd) == Ops::RH_REPLAY_REPLAYABLE, "dr-replayable-before", fails)
    hdn: mutable darray[u8] = []
    k <- 0
    while k < hd.count |k, hd, hdn|:
        hdn.push(hd[k])
        k <- k + 1
    hdn.push(0)
    hdnp: u8& = (&hdn[0]).cast[u8&] can Unsafe.PointerCast
    t7check(Store::rh_store_delete_blob(evp, hdnp) == 0, "dr-delete", fails)
    t7check(Ops::rh_replay_label(evp, refd) == Ops::RH_REPLAY_NOT_REPLAYABLE, "dr-not-replayable-after", fails)
    emptyref: mutable darray[u8] = []
    t7check(Ops::rh_replay_label(evp, emptyref) == Ops::RH_REPLAY_UNKNOWN, "dr-empty-unknown", fails)
    return

# --- M07-07: publication suppression ------------------------------------
def check_publication(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    t7check(Privacy::rh_pub_decide(0, 0, 0, 0, 5) == Privacy::RH_PUB_UNAVAILABLE, "pub-empty-unavailable", fails)
    t7check(Privacy::rh_pub_decide(1, 0, 0, 0, 5) == Privacy::RH_PUB_SUPPRESS_SMALL, "pub-small-suppressed", fails)
    t7check(Privacy::rh_pub_decide(4, 0, 0, 0, 5) == Privacy::RH_PUB_SUPPRESS_SMALL, "pub-below-threshold", fails)
    t7check(Privacy::rh_pub_decide(5, 0, 0, 0, 5) == Privacy::RH_PUB_PUBLISH, "pub-at-threshold", fails)
    t7check(Privacy::rh_pub_decide(9, 1, 0, 0, 5) == Privacy::RH_PUB_PUBLISH, "pub-authorized-broad", fails)
    t7check(Privacy::rh_pub_decide(9, 0, 1, 0, 5) == Privacy::RH_PUB_WITHHOLD_PRIVATE, "pub-private-withheld", fails)
    t7check(Privacy::rh_pub_decide(0, 0, 0, 1, 5) == Privacy::RH_PUB_WITHHOLD_UNKNOWN, "pub-unknown-withheld", fails)
    # Precedence: unknown > private > threshold.
    t7check(Privacy::rh_pub_decide(9, 0, 1, 1, 5) == Privacy::RH_PUB_WITHHOLD_UNKNOWN, "pub-unknown-wins", fails)
    t7check(not Privacy::rh_pub_is_publishable(Privacy::rh_pub_decide(9, 0, 1, 0, 5)), "pub-private-not-publishable", fails)
    t7check(not Privacy::rh_pub_is_publishable(Privacy::rh_pub_decide(1, 0, 0, 0, 5)), "pub-small-not-publishable", fails)
    out: mutable darray[u8] = []
    Privacy::rh_pub_text(Privacy::RH_PUB_WITHHOLD_PRIVATE, 9, 0, 1, 0, 5, out)
    t7check(m7_contains(out, "withhold_private_member"), "pub-text-decision", fails)
    t7check(m7_contains(out, "suppression is not anonymization"), "pub-text-anonymity-caveat", fails)
    return

def main() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    fails: mutable i64 = 0
    check_transport(&fails)
    check_publication(&fails)
    check_addr_guard(&fails)
    check_json_hardening(&fails)
    check_json_fuzz(&fails)
    check_cargo_fuzz(&fails)
    check_semver_hardening(&fails)
    check_semver_fuzz(&fails)
    check_lock_hardening(&fails)
    check_monitoring(&fails)
    check_quota(&fails)
    check_backup(&fails)
    if fails == 0:
        b: mutable darray[u8] =
            b: mutable darray[u8] = []
            Base::rh_push_text(b, "M07 OK")
            b.push(10)
            b
        Base::rh_write_stdout(b)
        return 0
    1
