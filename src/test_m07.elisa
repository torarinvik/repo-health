def try_bad_semver(data: darray[u8]&, label: u8&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    ok: bool =
        vv: mutable Package::RhSemver = Package::RhSemver{0, 0, 0, 0, 0}
        block_result: bool = Package::rh_semver_parse(data, 0, data.count.usize(), &vv)
        block_result
    t7check(not ok, label, fails)

def check_semver_hardening(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    good: mutable darray[u8] = []
    Base::rh_push_text(good, "1.2.3")
    v: mutable Package::RhSemver = Package::RhSemver{0, 0, 0, 0, 0}
    t7check(Package::rh_semver_parse(good, 0, 5, &v), "sem-accept", fails)
    # Partial versions ("1", "1.2") are accepted on purpose: Cargo-style
    # requirements rely on them. Only malformed forms are rejected.
    p1: darray[u8] = [49]
    vp1: mutable Package::RhSemver = Package::RhSemver{0, 0, 0, 0, 0}
    t7check(Package::rh_semver_parse(p1, 0, 1, &vp1), "sem-accept-major-only", fails)
    p2: darray[u8] = [49, 46, 50]
    vp2: mutable Package::RhSemver = Package::RhSemver{0, 0, 0, 0, 0}
    t7check(Package::rh_semver_parse(p2, 0, 3, &vp2), "sem-accept-two-part", fails)
    b0: darray[u8] = []
    try_bad_semver(b0, "sem-reject-empty", fails)
    b3: darray[u8] = [49, 46, 50, 46, 51, 46, 52]
    try_bad_semver(b3, "sem-reject-four-part", fails)
    b4: darray[u8] = [48, 49, 46, 50, 46, 51]
    try_bad_semver(b4, "sem-reject-leading-zero", fails)
    b5: darray[u8] = [49, 46, 50, 46]
    try_bad_semver(b5, "sem-reject-trailing-dot", fails)
    return

