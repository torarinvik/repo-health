    while trial < 64 |trial: i64 = 0, rng: i64 = 271828, legacy_corpus, fails|:
        fuzzed: mutable darray[u8] = []
        while copied < legacy_corpus.count |copied: usize = 0, legacy_corpus, fuzzed|:
