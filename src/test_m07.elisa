def check_yarn_fuzz_case(raw: darray[u8]&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    bounded_result: bool =
        manifest: mutable darray[u8] = []
        Base::rh_push_text(manifest, "{\"name\":\"root\",\"version\":\"1.0.0\",\"dependencies\":{\"foo\":\"^1.0.0\"}}")
        packages: mutable darray[Package::RhPkgNode] = []
        pool: mutable darray[u8] = []
        requirements: mutable darray[Package::RhRequire] = []
        edges: mutable darray[Package::RhDepEdge] = []
        unresolved: mutable darray[Package::RhUnresolved] = []
        root: i64 = Package::rh_yarn_lock_parse(raw, manifest, packages, pool, requirements, edges, unresolved)
        source_bound: i64 = (raw.count.i64() + manifest.count.i64() + 1) * 16
        (root == -1 or (root >= 0 and root < packages.count.i64())) and packages.count.i64() <= raw.count.i64() + 1 and requirements.count.i64() <= raw.count.i64() + manifest.count.i64() and edges.count.i64() <= requirements.count.i64() and unresolved.count.i64() <= requirements.count.i64() and pool.count.i64() <= source_bound
    t7check(bounded_result, "yarn-lock-fuzz-bounds", fails)
    return

def check_yarn_fuzz(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    corpus: mutable darray[u8] = []
    Base::rh_push_text(corpus, "# yarn lockfile v1\n\nfoo@^1.0.0:\n  version \"1.2.0\"\n  resolved \"https://registry.example/foo.tgz\"\n  dependencies:\n    bar \"~2.0.0\"\n")
    while trial < 96 |trial: i64 = 0, rng: i64 = 244949, corpus, fails|:
        fuzzed: mutable darray[u8] = []
        while copied < corpus.count |copied: usize = 0, corpus, fuzzed|:
            fuzzed.push(corpus[copied])
            copied <- copied + 1
        rng <- (rng * 48271) % 2147483647
