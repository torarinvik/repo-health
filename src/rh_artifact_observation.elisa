# rh_artifact_observation.elisa — bind a local archive-byte observation to one
# immutable package-graph digest and artifact record.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_sha256.elisa"
include "./rh_sha512.elisa"
include "./rh_go_zip.elisa"

module ArtifactObservation:
    private:
        const RH_ARTIFACT_OBSERVATION_TARGET_OK: i64 = 0
        const RH_ARTIFACT_OBSERVATION_CARGO_SHA256: i64 = 0
        const RH_ARTIFACT_OBSERVATION_NPM_SHA512: i64 = 1
        const RH_ARTIFACT_OBSERVATION_NPM_SHA256: i64 = 2
        const RH_ARTIFACT_OBSERVATION_NPM_SHA384: i64 = 3
        const RH_ARTIFACT_OBSERVATION_GO_H1_MOD: i64 = 4
        const RH_ARTIFACT_OBSERVATION_GO_H1_ZIP: i64 = 5
        def rh_artifact_observation_member(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if obj < 0 or nodes[obj.usize()].kind != Json::RH_JSON_OBJ
            width: usize = strlen(key)
            found: mutable i64 = -1
            while child >= 0 |child: i64 = nodes[obj.usize()].first_child, nodes, texts, key, width, found|:
                key_node: Json::RhJsonNode = nodes[child.usize()]
                value: i64 = key_node.next_sibling
                return -2 if value < 0
                if key_node.kind == Json::RH_JSON_STR and key_node.text_end - key_node.text_start == width.i64():
                    same: bool =
                        while k < width |same: bool = true, k: usize = 0, texts, key, child, nodes| -> same:
                            key_text: Json::RhJsonNode = nodes[child.usize()]
                            if texts[(key_text.text_start.usize() + k)] != key[k]:
                                same <- false
                            k <- k + 1
                    if same:
                        return -2 if found >= 0
                        found <- value
                child <- nodes[value.usize()].next_sibling
            found

        def rh_artifact_observation_fields(nodes: darray[Json::RhJsonNode]&, obj: i64, fields: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if obj < 0 or nodes[obj.usize()].kind != Json::RH_JSON_OBJ
            nodes[obj.usize()].child_count == fields * 2

        def rh_artifact_observation_hex(texts: darray[u8]&, start: i64, end: i64) -> bool:
            return false if end - start != 64
            while i < end |i: i64 = start, texts, end|:
                b: u8 = texts[i.usize()]
                valid: bool = (b >= 48 and b <= 57) or (b >= 65 and b <= 70) or (b >= 97 and b <= 102)
                return false if not valid
                i <- i + 1
            true

        def rh_artifact_observation_sri_space(value: u8) -> bool:
            value == 9 or value == 10 or value == 12 or value == 13 or value == 32

        def rh_artifact_observation_sri_algorithm_prefix(texts: darray[u8]&, start: i64, end: i64, algorithm: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            width: usize = strlen(algorithm)
            return false if end - start < width.i64()
            while index < width |index: usize = 0, texts, start, algorithm, width|:
                actual: mutable u8 = texts[start.usize() + index]
                expected: u8 = algorithm[index]
                actual <- actual + 32 if actual >= 65 and actual <= 90
                return false if actual != expected
                index <- index + 1
            true

        # SRI associates each ?option with the hash expression before it.
        # Options are reserved and ignored today, but their syntax is VCHAR.
        # Return the digest end (the first '?', or the token end); reject
        # non-printable option bytes instead of silently accepting malformed
        # integrity metadata.
        def rh_artifact_observation_sri_digest_end(texts: darray[u8]&, start: i64, end: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if start < 0 or end < start or end > texts.count.i64()
            digest_end: mutable i64 = end
            while i < end |i: i64 = start, texts, end, digest_end|:
                if texts[i.usize()] == 63:
                    digest_end <- i
                    i <- end
                else:
                    i <- i + 1
            return digest_end if digest_end == end
            while i < end |i: i64 = digest_end + 1, texts, end|:
                return -1 if texts[i.usize()] < 33 or texts[i.usize()] > 126
                i <- i + 1
            digest_end

        def rh_artifact_observation_sri_has_algorithm(texts: darray[u8]&, start: i64, end: i64, algorithm: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            found: mutable bool = false
            while token_start < end |token_start: i64 = start, token_end: i64 = start, texts, end, algorithm, found|:
                while token_start < end and rh_artifact_observation_sri_space(texts[token_start.usize()]) |token_start, texts, end|:
                    token_start <- token_start + 1
                token_end <- token_start
                while token_end < end and not rh_artifact_observation_sri_space(texts[token_end.usize()]) |token_end, texts, end|:
                    token_end <- token_end + 1
                found <- true if rh_artifact_observation_sri_algorithm_prefix(texts, token_start, token_end, algorithm)
                token_start <- token_end
            found

        def rh_artifact_observation_sri_sha512_token(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            digest_end: i64 = rh_artifact_observation_sri_digest_end(texts, start, end)
            return false if digest_end < 0 or digest_end - start != 95 or not rh_artifact_observation_sri_algorithm_prefix(texts, start, digest_end, "sha512-")
            Base64::rh_base64_sha512_valid(texts, start + 7, digest_end)

        def rh_artifact_observation_sri_sha512_valid(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            found: mutable bool = false
            while token_start < end |token_start: i64 = start, token_end: i64 = start, texts, end, found|:
                while token_start < end and rh_artifact_observation_sri_space(texts[token_start.usize()]) |token_start, texts, end|:
                    token_start <- token_start + 1
                token_end <- token_start
                while token_end < end and not rh_artifact_observation_sri_space(texts[token_end.usize()]) |token_end, texts, end|:
                    token_end <- token_end + 1
                if rh_artifact_observation_sri_algorithm_prefix(texts, token_start, token_end, "sha512-"):
                    return false if not rh_artifact_observation_sri_sha512_token(texts, token_start, token_end)
                    found <- true
                token_start <- token_end
            found

        def rh_artifact_observation_sri_sha256_token(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            digest_end: i64 = rh_artifact_observation_sri_digest_end(texts, start, end)
            return false if digest_end < 0 or digest_end - start != 51 or not rh_artifact_observation_sri_algorithm_prefix(texts, start, digest_end, "sha256-")
            Base64::rh_base64_sha256_valid(texts, start + 7, digest_end)

        def rh_artifact_observation_sri_sha256_valid(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            found: mutable bool = false
            while token_start < end |token_start: i64 = start, token_end: i64 = start, texts, end, found|:
                while token_start < end and rh_artifact_observation_sri_space(texts[token_start.usize()]) |token_start, texts, end|:
                    token_start <- token_start + 1
                token_end <- token_start
                while token_end < end and not rh_artifact_observation_sri_space(texts[token_end.usize()]) |token_end, texts, end|:
                    token_end <- token_end + 1
                if rh_artifact_observation_sri_algorithm_prefix(texts, token_start, token_end, "sha256-"):
                    return false if not rh_artifact_observation_sri_sha256_token(texts, token_start, token_end)
                    found <- true
                token_start <- token_end
            found

        def rh_artifact_observation_sri_sha384_token(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            digest_end: i64 = rh_artifact_observation_sri_digest_end(texts, start, end)
            return false if digest_end < 0 or digest_end - start != 71 or not rh_artifact_observation_sri_algorithm_prefix(texts, start, digest_end, "sha384-")
            Base64::rh_base64_sha384_valid(texts, start + 7, digest_end)

        def rh_artifact_observation_sri_sha384_valid(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            found: mutable bool = false
            while token_start < end |token_start: i64 = start, token_end: i64 = start, texts, end, found|:
                while token_start < end and rh_artifact_observation_sri_space(texts[token_start.usize()]) |token_start, texts, end|:
                    token_start <- token_start + 1
                token_end <- token_start
                while token_end < end and not rh_artifact_observation_sri_space(texts[token_end.usize()]) |token_end, texts, end|:
                    token_end <- token_end + 1
                if rh_artifact_observation_sri_algorithm_prefix(texts, token_start, token_end, "sha384-"):
                    return false if not rh_artifact_observation_sri_sha384_token(texts, token_start, token_end)
                    found <- true
                token_start <- token_end
            found

        def rh_artifact_observation_sri_matches(texts: darray[u8]&, start: i64, end: i64, observed: darray[u8]&, algorithm: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            width: usize = strlen(algorithm)
            while token_start < end |token_start: i64 = start, token_end: i64 = start, texts, end, observed, algorithm, width|:
                while token_start < end and rh_artifact_observation_sri_space(texts[token_start.usize()]) |token_start, texts, end|:
                    token_start <- token_start + 1
                token_end <- token_start
                while token_end < end and not rh_artifact_observation_sri_space(texts[token_end.usize()]) |token_end, texts, end|:
                    token_end <- token_end + 1
                if rh_artifact_observation_sri_algorithm_prefix(texts, token_start, token_end, algorithm):
                    digest_end: i64 = rh_artifact_observation_sri_digest_end(texts, token_start, token_end)
                    if digest_end >= 0 and Base::rh_bytes_equal_span(texts, token_start + width.i64(), digest_end, observed, width.i64(), observed.count.i64()):
                        return true
                token_start <- token_end
            false

        def rh_artifact_observation_hex_equal(texts: darray[u8]&, start: i64, observed: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if start < 0 or observed.count != 64
            while i < observed.count |i: usize = 0, texts, observed, start|:
                expected: mutable u8 = texts[(start.usize() + i)]
                actual: u8 = observed[i]
                expected <- expected + 32 if expected >= 65 and expected <= 90
                return false if expected != actual
                i <- i + 1
            true

        def rh_artifact_observation_go_h1_valid(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if end - start != 47 or not Base::rh_bytes_equal_literal(texts, start, start + 3, "h1:")
            Base64::rh_base64_sha256_valid(texts, start + 3, end)

        def rh_artifact_observation_go_h1_mod_file(file_bytes: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            file_digest: mutable darray[u8] = []
            Sha256::rh_sha256(file_bytes, file_digest)
            summary: mutable darray[u8] = []
            summary.extend(bytes_view(file_digest))
            Base::rh_push_text(summary, "  go.mod\n")
            Base::rh_push_text(out, "h1:")
            Sha256::rh_sha256_base64(summary, out)

        def rh_artifact_observation_target(graph: darray[u8]&, artifact_id: i64, package_node_out: mutable i64&, expected_start_out: mutable i64&, expected_end_out: mutable i64&, digest_algorithm_out: mutable i64&, texts_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if graph.count.i64() > RH_ARTIFACT_OBSERVATION_MAX_GRAPH_BYTES or artifact_id < 0
            nodes: mutable darray[Json::RhJsonNode] = []
            root: i64 = Json::rh_json_parse(graph, nodes, texts_out)
            return -1 if root < 0 or not rh_artifact_observation_fields(nodes, root, 7)
            schema: i64 = rh_artifact_observation_member(nodes, texts_out, root, "schema")
            ecosystem: i64 = rh_artifact_observation_member(nodes, texts_out, root, "ecosystem")
            graph_nodes: i64 = rh_artifact_observation_member(nodes, texts_out, root, "nodes")
            artifacts: i64 = rh_artifact_observation_member(nodes, texts_out, root, "artifacts")
            edges: i64 = rh_artifact_observation_member(nodes, texts_out, root, "edges")
            unresolved: i64 = rh_artifact_observation_member(nodes, texts_out, root, "unresolved")
            advisories: i64 = rh_artifact_observation_member(nodes, texts_out, root, "advisories")
            return -1 if schema < 0 or ecosystem < 0 or graph_nodes < 0 or artifacts < 0 or edges < 0 or unresolved < 0 or advisories < 0
            return -1 if nodes[graph_nodes.usize()].kind != Json::RH_JSON_ARR or nodes[artifacts.usize()].kind != Json::RH_JSON_ARR
            return -1 if nodes[edges.usize()].kind != Json::RH_JSON_ARR or nodes[unresolved.usize()].kind != Json::RH_JSON_ARR or nodes[advisories.usize()].kind != Json::RH_JSON_ARR
            schema_s: mutable i64 = -1
            schema_e: mutable i64 = -1
            ecosystem_s: mutable i64 = -1
            ecosystem_e: mutable i64 = -1
            return -1 if not Json::rh_json_str_span(nodes, schema, &schema_s, &schema_e) or not Base::rh_bytes_equal_literal(texts_out, schema_s, schema_e, "rh-dep-graph/1")
            return -1 if not Json::rh_json_str_span(nodes, ecosystem, &ecosystem_s, &ecosystem_e)
            cargo_graph: bool = Base::rh_bytes_equal_literal(texts_out, ecosystem_s, ecosystem_e, "cargo")
            npm_graph: bool = Base::rh_bytes_equal_literal(texts_out, ecosystem_s, ecosystem_e, "npm")
            go_graph: bool = Base::rh_bytes_equal_literal(texts_out, ecosystem_s, ecosystem_e, "go")
            return -1 if not cargo_graph and not npm_graph and not go_graph
            return -1 if artifact_id >= nodes[artifacts.usize()].child_count.i64()
            item: mutable i64 = nodes[artifacts.usize()].first_child
            while i < artifact_id |i: i64 = 0, item, nodes|:
                return -1 if item < 0
                item <- nodes[item.usize()].next_sibling
                i <- i + 1
            return -1 if item < 0 or not rh_artifact_observation_fields(nodes, item, 6)
            id: i64 = rh_artifact_observation_member(nodes, texts_out, item, "id")
            package_node: i64 = rh_artifact_observation_member(nodes, texts_out, item, "package_node")
            kind: i64 = rh_artifact_observation_member(nodes, texts_out, item, "kind")
            expected: i64 = rh_artifact_observation_member(nodes, texts_out, item, "expected_digest")
            observed: i64 = rh_artifact_observation_member(nodes, texts_out, item, "observed_digest")
            state: i64 = rh_artifact_observation_member(nodes, texts_out, item, "identity_state")
            return -1 if id < 0 or package_node < 0 or kind < 0 or expected < 0 or observed < 0 or state < 0
            return -1 if nodes[id.usize()].kind != Json::RH_JSON_NUM or nodes[package_node.usize()].kind != Json::RH_JSON_NUM
            return -1 if nodes[kind.usize()].kind != Json::RH_JSON_STR or nodes[expected.usize()].kind != Json::RH_JSON_STR
            return -1 if nodes[observed.usize()].kind != Json::RH_JSON_NULL and nodes[observed.usize()].kind != Json::RH_JSON_STR
            return -1 if nodes[state.usize()].kind != Json::RH_JSON_STR
            id_ok: mutable i64 = 0
            parsed_id: i64 = Json::rh_json_int(nodes, graph, id, &id_ok)
            return -1 if id_ok != 1 or parsed_id != artifact_id
            package_node_ok: mutable i64 = 0
            package_node_out[0] <- Json::rh_json_int(nodes, graph, package_node, &package_node_ok)
            return -1 if package_node_ok != 1 or package_node_out[0] < 0 or package_node_out[0] >= nodes[graph_nodes.usize()].child_count.i64()
            kind_s: mutable i64 = -1
            kind_e: mutable i64 = -1
            return -1 if not Json::rh_json_str_span(nodes, kind, &kind_s, &kind_e)
            archive_kind: bool = Base::rh_bytes_equal_literal(texts_out, kind_s, kind_e, "archive")
            go_mod_kind: bool = Base::rh_bytes_equal_literal(texts_out, kind_s, kind_e, "go_mod")
            go_module_kind: bool = Base::rh_bytes_equal_literal(texts_out, kind_s, kind_e, "module")
            return -1 if cargo_graph and not archive_kind
            return -1 if npm_graph and not archive_kind
            return -1 if go_graph and not go_mod_kind and not go_module_kind
            return -1 if not Json::rh_json_str_span(nodes, expected, expected_start_out, expected_end_out)
            if go_graph:
                digest_algorithm_out[0] <- RH_ARTIFACT_OBSERVATION_GO_H1_MOD if go_mod_kind
                digest_algorithm_out[0] <- RH_ARTIFACT_OBSERVATION_GO_H1_ZIP if go_module_kind
                return -1 if not rh_artifact_observation_go_h1_valid(texts_out, expected_start_out[0], expected_end_out[0])
            elif cargo_graph:
                digest_algorithm_out[0] <- RH_ARTIFACT_OBSERVATION_CARGO_SHA256
                return -1 if not rh_artifact_observation_hex(texts_out, expected_start_out[0], expected_end_out[0])
            else:
                has_sha512: bool = rh_artifact_observation_sri_has_algorithm(texts_out, expected_start_out[0], expected_end_out[0], "sha512-")
                has_sha384: bool = rh_artifact_observation_sri_has_algorithm(texts_out, expected_start_out[0], expected_end_out[0], "sha384-")
                if has_sha512:
                    digest_algorithm_out[0] <- RH_ARTIFACT_OBSERVATION_NPM_SHA512
                    return -1 if not rh_artifact_observation_sri_sha512_valid(texts_out, expected_start_out[0], expected_end_out[0])
                elif has_sha384:
                    digest_algorithm_out[0] <- RH_ARTIFACT_OBSERVATION_NPM_SHA384
                    return -1 if not rh_artifact_observation_sri_sha384_valid(texts_out, expected_start_out[0], expected_end_out[0])
                else:
                    digest_algorithm_out[0] <- RH_ARTIFACT_OBSERVATION_NPM_SHA256
                    return -1 if not rh_artifact_observation_sri_sha256_valid(texts_out, expected_start_out[0], expected_end_out[0])
            RH_ARTIFACT_OBSERVATION_TARGET_OK

    public:
        const RH_ARTIFACT_OBSERVATION_MAX_GRAPH_BYTES: i64 = 8388608
        const RH_ARTIFACT_OBSERVATION_MAX_BYTES: i64 = 67108864

        # Verify raw bytes for a Cargo archive, npm tarball, or Go module artifact.
        # Unsupported digest algorithms, ecosystems, and artifact kinds fail
        # closed; no archive is extracted or executed. The result binds the
        # observation to graph bytes and the graph-local artifact ID instead of
        # mutating the source graph.
        def rh_artifact_observation(graph: darray[u8]&, artifact_bytes: darray[u8]&, artifact_id: i64, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.RawExtern, Unsafe.PointerCast]:
            return -1 if artifact_bytes.count.i64() > RH_ARTIFACT_OBSERVATION_MAX_BYTES
            graph_texts: mutable darray[u8] = []
            package_node: mutable i64 = -1
            expected_s: mutable i64 = -1
            expected_e: mutable i64 = -1
            digest_algorithm: mutable i64 = -1
            return -1 if ArtifactObservation::rh_artifact_observation_target(graph, artifact_id, &package_node, &expected_s, &expected_e, &digest_algorithm, graph_texts) != RH_ARTIFACT_OBSERVATION_TARGET_OK
            observed: mutable darray[u8] =
                observed: mutable darray[u8] = []
                if digest_algorithm == RH_ARTIFACT_OBSERVATION_CARGO_SHA256:
                    Sha256::rh_sha256(artifact_bytes, observed)
                elif digest_algorithm == RH_ARTIFACT_OBSERVATION_GO_H1_MOD:
                    ArtifactObservation::rh_artifact_observation_go_h1_mod_file(artifact_bytes, observed)
                elif digest_algorithm == RH_ARTIFACT_OBSERVATION_GO_H1_ZIP:
                    Base::rh_push_text(observed, "")
                    return -1 if GoZip::rh_go_zip_h1(artifact_bytes, observed) != 0
                elif digest_algorithm == RH_ARTIFACT_OBSERVATION_NPM_SHA512:
                    Base::rh_push_text(observed, "sha512-")
                    Sha512::rh_sha512_base64(artifact_bytes, observed)
                elif digest_algorithm == RH_ARTIFACT_OBSERVATION_NPM_SHA384:
                    Base::rh_push_text(observed, "sha384-")
                    Sha512::rh_sha384_base64(artifact_bytes, observed)
                else:
                    Base::rh_push_text(observed, "sha256-")
                    Sha256::rh_sha256_base64(artifact_bytes, observed)
                observed
            graph_digest: mutable darray[u8] = []
            Sha256::rh_sha256(graph, graph_digest)
            matches: bool =
                if digest_algorithm == RH_ARTIFACT_OBSERVATION_CARGO_SHA256:
                    ArtifactObservation::rh_artifact_observation_hex_equal(graph_texts, expected_s, observed)
                elif digest_algorithm == RH_ARTIFACT_OBSERVATION_GO_H1_MOD:
                    Base::rh_bytes_equal_span(graph_texts, expected_s, expected_e, observed, 0, observed.count.i64())
                elif digest_algorithm == RH_ARTIFACT_OBSERVATION_GO_H1_ZIP:
                    Base::rh_bytes_equal_span(graph_texts, expected_s, expected_e, observed, 0, observed.count.i64())
                elif digest_algorithm == RH_ARTIFACT_OBSERVATION_NPM_SHA512:
                    ArtifactObservation::rh_artifact_observation_sri_matches(graph_texts, expected_s, expected_e, observed, "sha512-")
                elif digest_algorithm == RH_ARTIFACT_OBSERVATION_NPM_SHA384:
                    ArtifactObservation::rh_artifact_observation_sri_matches(graph_texts, expected_s, expected_e, observed, "sha384-")
                else:
                    ArtifactObservation::rh_artifact_observation_sri_matches(graph_texts, expected_s, expected_e, observed, "sha256-")
            if digest_algorithm == RH_ARTIFACT_OBSERVATION_GO_H1_MOD:
                Base::rh_push_text(out, "{\"schema\":\"rh-go-mod-observation-result/1\",\"graph_sha256\":\"")
                out.extend(bytes_view(graph_digest))
                Base::rh_push_text(out, "\",\"artifact_id\":")
                Base::rh_push_decimal_i64(out, artifact_id)
                Base::rh_push_text(out, ",\"package_node\":")
                Base::rh_push_decimal_i64(out, package_node)
                Base::rh_push_text(out, ",\"expected_digest\":\"")
                Base::rh_json_escape(out, graph_texts, expected_s.usize(), expected_e.usize())
                Base::rh_push_text(out, "\",\"observed_digest\":\"")
                out.extend(bytes_view(observed))
                Base::rh_push_text(out, "\",\"identity_state\":\"")
                Base::rh_push_text(out, "match") if matches
                Base::rh_push_text(out, "changed") if not matches
                Base::rh_push_text(out, "\",\"digest_algorithm\":\"h1\",\"verification_basis\":\"go_h1_mod_file\",\"file_size_bytes\":")
                Base::rh_push_decimal_i64(out, artifact_bytes.count.i64())
            elif digest_algorithm == RH_ARTIFACT_OBSERVATION_GO_H1_ZIP:
                Base::rh_push_text(out, "{\"schema\":\"rh-go-zip-observation-result/1\",\"graph_sha256\":\"")
                out.extend(bytes_view(graph_digest))
                Base::rh_push_text(out, "\",\"artifact_id\":")
                Base::rh_push_decimal_i64(out, artifact_id)
                Base::rh_push_text(out, ",\"package_node\":")
                Base::rh_push_decimal_i64(out, package_node)
                Base::rh_push_text(out, ",\"expected_digest\":\"")
                Base::rh_json_escape(out, graph_texts, expected_s.usize(), expected_e.usize())
                Base::rh_push_text(out, "\",\"observed_digest\":\"")
                out.extend(bytes_view(observed))
                Base::rh_push_text(out, "\",\"identity_state\":\"")
                Base::rh_push_text(out, "match") if matches
                Base::rh_push_text(out, "changed") if not matches
                Base::rh_push_text(out, "\",\"digest_algorithm\":\"h1\",\"verification_basis\":\"go_h1_zip_contents\",\"archive_size_bytes\":")
                Base::rh_push_decimal_i64(out, artifact_bytes.count.i64())
            else:
                Base::rh_push_text(out, "{\"schema\":\"rh-artifact-observation-result/1\",\"graph_sha256\":\"")
                out.extend(bytes_view(graph_digest))
                Base::rh_push_text(out, "\",\"artifact_id\":")
                Base::rh_push_decimal_i64(out, artifact_id)
                Base::rh_push_text(out, ",\"package_node\":")
                Base::rh_push_decimal_i64(out, package_node)
                Base::rh_push_text(out, ",\"expected_digest\":\"")
                Base::rh_json_escape(out, graph_texts, expected_s.usize(), expected_e.usize())
                Base::rh_push_text(out, "\",\"observed_digest\":\"")
                out.extend(bytes_view(observed))
                Base::rh_push_text(out, "\",\"identity_state\":\"")
                Base::rh_push_text(out, "match") if matches
                Base::rh_push_text(out, "changed") if not matches
                if digest_algorithm == RH_ARTIFACT_OBSERVATION_CARGO_SHA256:
                    Base::rh_push_text(out, "\",\"digest_algorithm\":\"sha256\",\"verification_basis\":\"raw_cargo_archive_bytes\",\"archive_size_bytes\":")
                elif digest_algorithm == RH_ARTIFACT_OBSERVATION_NPM_SHA512:
                    Base::rh_push_text(out, "\",\"digest_algorithm\":\"sha512\",\"verification_basis\":\"raw_npm_tarball_bytes\",\"archive_size_bytes\":")
                elif digest_algorithm == RH_ARTIFACT_OBSERVATION_NPM_SHA384:
                    Base::rh_push_text(out, "\",\"digest_algorithm\":\"sha384\",\"verification_basis\":\"raw_npm_tarball_bytes\",\"archive_size_bytes\":")
                else:
                    Base::rh_push_text(out, "\",\"digest_algorithm\":\"sha256\",\"verification_basis\":\"raw_npm_tarball_bytes\",\"archive_size_bytes\":")
                Base::rh_push_decimal_i64(out, artifact_bytes.count.i64())
            Base::rh_push_text(out, "}")
            0
