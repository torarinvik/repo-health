# rh_identity.elisa — reversible identity links + revisioned clusters +
# automation classification (M04-02/03/04).
#
# Raw author identities are index-identified (actor ids are positions in
# the caller's raw-identity ledger). Links are explicit assertions with a
# lifecycle: proposed(0) accepted(1) rejected(2) revoked(3). Clusters are
# derived from accepted links only and are recomputed on every change, so
# revocation is reversible by construction.

module Identity:
    public:
        const RH_LINK_PROPOSED: u8 = 0
        const RH_LINK_ACCEPTED: u8 = 1
        const RH_LINK_REJECTED: u8 = 2
        const RH_LINK_REVOKED: u8 = 3

        const RH_ACTOR_HUMAN: u8 = 0
        const RH_ACTOR_BOT_KNOWN: u8 = 1
        const RH_ACTOR_UNRESOLVED: u8 = 2
        const RH_ACTOR_SERVICE_KNOWN: u8 = 3
        const RH_ACTOR_SOURCE_UNKNOWN: u8 = 0
        const RH_ACTOR_SOURCE_PROVIDER: u8 = 1
        const RH_ACTOR_SOURCE_PROJECT: u8 = 2
        const RH_ACTOR_SOURCE_OPERATOR: u8 = 3

        struct RhIdentityLink:
            a: mutable i64
            b: mutable i64
            state: mutable u8
            revision_added: mutable i64

        # The revision is the highest ledger revision that changed the
        # accepted identity graph. Counting active links is not a revision:
        # revocation and replacement can otherwise reuse an old cache key.
        def rh_identity_revision(links: darray[RhIdentityLink]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < links.count |rev: i64 = 0, i: usize = 0| -> rev:
                l: RhIdentityLink = links[i]
                i <- i + 1
                if l.state == RH_LINK_ACCEPTED or l.state == RH_LINK_REVOKED:
                    rev <- l.revision_added if l.revision_added > rev

        def rh_identity_clusters(links: darray[RhIdentityLink]&, actor_count: i64, parent: mutable darray[i64]&, cluster_out: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if actor_count < 0
            while i < actor_count |i: i64 = 0, parent|:
                parent.push(i)
                i <- i + 1
            while j < links.count |j: usize = 0, links, parent|:
                l: RhIdentityLink = links[j]
                j <- j + 1
                continue if l.state != RH_LINK_ACCEPTED
                continue if l.a < 0 or l.a >= actor_count or l.b < 0 or l.b >= actor_count
                ra: i64 = Identity::rh_find_root(parent, l.a)
                rb: i64 = Identity::rh_find_root(parent, l.b)
                continue if ra < 0 or rb < 0
                if ra != rb:
                    lo: i64 = ra if ra < rb else rb
                    hi: i64 = rb if ra < rb else ra
                    parent[hi.usize()] <- lo
            while k < actor_count |distinct: i64 = 0, k: i64 = 0, parent, cluster_out| -> distinct:
                root: i64 = Identity::rh_find_root(parent, k)
                cluster_out.push(root)
                distinct <- distinct + 1 if root == k
                k <- k + 1

        def rh_cluster_of(cluster_map: darray[i64]&, actor: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if actor < 0 or actor >= cluster_map.count.i64()
            cluster_map[actor.usize()]

        def rh_actor_kinds(kinds: darray[u8]&, humans_out: mutable i64&, bots_out: mutable i64&, services_out: mutable i64&, unresolved_out: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            humans_out[0] <- 0
            bots_out[0] <- 0
            services_out[0] <- 0
            unresolved_out[0] <- 0
            while i < kinds.count |i: usize = 0, kinds, humans_out, bots_out, services_out, unresolved_out|:
                k: u8 = kinds[i]
                i <- i + 1
                if k == RH_ACTOR_HUMAN:
                    humans_out[0] <- humans_out[0] + 1
                if k == RH_ACTOR_BOT_KNOWN:
                    bots_out[0] <- bots_out[0] + 1
                if k == RH_ACTOR_SERVICE_KNOWN:
                    services_out[0] <- services_out[0] + 1
                if k == RH_ACTOR_UNRESOLVED:
                    unresolved_out[0] <- unresolved_out[0] + 1

        def rh_actor_kind_sources(sources: darray[u8]&, provider_out: mutable i64&, project_out: mutable i64&, operator_out: mutable i64&, unknown_out: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            provider_out[0] <- 0
            project_out[0] <- 0
            operator_out[0] <- 0
            unknown_out[0] <- 0
            while i < sources.count |i: usize = 0, sources, provider_out, project_out, operator_out, unknown_out|:
                source: u8 = sources[i]
                i <- i + 1
                if source == RH_ACTOR_SOURCE_PROVIDER:
                    provider_out[0] <- provider_out[0] + 1
                if source == RH_ACTOR_SOURCE_PROJECT:
                    project_out[0] <- project_out[0] + 1
                if source == RH_ACTOR_SOURCE_OPERATOR:
                    operator_out[0] <- operator_out[0] + 1
                if source == RH_ACTOR_SOURCE_UNKNOWN:
                    unknown_out[0] <- unknown_out[0] + 1

        def rh_actor_kind_source_label(source: u8) -> u8&:
            return "provider" if source == RH_ACTOR_SOURCE_PROVIDER
            return "project" if source == RH_ACTOR_SOURCE_PROJECT
            return "operator" if source == RH_ACTOR_SOURCE_OPERATOR
            "unknown"

    private:
        def rh_find_root(parent: mutable darray[i64]&, x: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if x < 0 or x >= parent.count.i64()
            root: i64 =
                while parent[cur.usize()] != cur |cur: i64 = x, hops: i64 = 0, parent| -> cur:
                    cur <- parent[cur.usize()]
                    hops <- hops + 1
                    return -1 if hops > parent.count.i64()
            while parent[path.usize()] != root |path: i64 = x, hops: i64 = 0, parent, root|:
                next: i64 = parent[path.usize()]
                parent[path.usize()] <- root
                path <- next
                hops <- hops + 1
                return -1 if hops > parent.count.i64()
            root
