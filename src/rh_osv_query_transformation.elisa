# Field transformation contract for one bounded OSV package/version query.
include "./rh_base.elisa"

module OsvQueryTransformation:
    public:
        def rh_osv_query_transformation_report(configuration_sha: darray[u8]&, input_sha: darray[u8]&,
                                               output_sha: darray[u8]&,
                                               out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"osv-package-version-query\",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"osv-query-response-object\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"ecosystem|package name|version or commit\",\"target\":\"OSV query request\",\"state\":\"transformed\"},{\"source\":\"vulns[] records\",\"target\":\"normalized response vulns[]\",\"state\":\"preserved\"},{\"source\":\"next_page_token\",\"target\":\"normalized response next_page_token\",\"state\":\"preserved\"},{\"source\":\"omitted vulns array\",\"target\":\"normalized response vulns=[]\",\"state\":\"inferred\"},{\"source\":\"unknown top-level response fields\",\"target\":\"normalized response\",\"state\":\"discarded\"}]}")

        def rh_osv_graph_transformation_report(configuration_sha: darray[u8]&, input_sha: darray[u8]&, output_sha: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"osv-graph-batch-query\",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-osv-query-batch-result\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"eligible graph package nodes\",\"target\":\"positional OSV queries\",\"state\":\"transformed\"},{\"source\":\"OSV vulnerability IDs and response positions\",\"target\":\"batch result summaries\",\"state\":\"preserved\"},{\"source\":\"unversioned or unsupported graph nodes\",\"target\":\"skipped_node_count\",\"state\":\"discarded\"},{\"source\":\"unresolved requirements\",\"target\":\"batch query set\",\"state\":\"unsupported\"},{\"source\":\"full advisory records when hydration is disabled\",\"target\":\"matcher response\",\"state\":\"unsupported\"}]}")
