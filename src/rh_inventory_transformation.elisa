# Field transformation contract for CycloneDX and SPDX inventory observations.
include "./rh_base.elisa"

module InventoryTransformation:
    public:
        def rh_inventory_transformation_report(format: u8, configuration_sha: darray[u8]&,
                                               input_sha: darray[u8]&, output_sha: darray[u8]&,
                                               out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"software-inventory\",\"source_format\":\"cyclonedx\"") if format == 0
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"software-inventory\",\"source_format\":\"spdx\"") if format != 0
            Base::rh_push_text(out, ",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-inventory/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"component|package identity\",\"target\":\"components[].identity\",\"state\":\"transformed\"},{\"source\":\"purl and supported SHA-256 hashes\",\"target\":\"components[].purl|hashes\",\"state\":\"preserved\"},{\"source\":\"inventory completeness assertions\",\"target\":\"completeness\",\"state\":\"transformed\"},{\"source\":\"unsupported digest algorithms and unrecognized properties\",\"target\":\"normalized observation\",\"state\":\"discarded\"},{\"source\":\"missing identity or optional source fields\",\"target\":\"component coverage\",\"state\":\"unknown\"}]}")
