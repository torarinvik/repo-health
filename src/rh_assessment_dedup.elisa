# rh_assessment_dedup.elisa — group repeated deliveries by complete origin identity.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_sha256.elisa"

module AssessmentDedup:
    public:
        const RH_ASSESSMENT_DEDUP_MAX_STATE_BYTES: i64 = 7000000

    private:
        const RH_ASSESSMENT_DEDUP_MAX_ROWS: i64 = 4096
        const RH_ASSESSMENT_DEDUP_MAX_SOURCE_ID: i64 = 128
        const RH_ASSESSMENT_DEDUP_MAX_STATE_KEYS: i64 = 100000

        struct RhAssessmentDelivery:
            delivery_s: mutable i64
            delivery_e: mutable i64
            delivery_time: mutable i64
            delivery_source_s: mutable i64
            delivery_source_e: mutable i64
            delivery_source_present: mutable i64
            tool_s: mutable i64
            tool_e: mutable i64
            tool_present: mutable i64
            version_s: mutable i64
            version_e: mutable i64
            version_present: mutable i64
            subject_revision: mutable i64
            revision_present: mutable i64
            original_run_s: mutable i64
            original_run_e: mutable i64
            original_run_present: mutable i64
            original_time: mutable i64
            original_time_present: mutable i64
            result_digest_s: mutable i64
            result_digest_e: mutable i64
            result_digest_present: mutable i64
            identity_complete: mutable i64
            group_id: mutable i64
            key_offset: mutable i64
            seen_before_batch: mutable i64

        def rh_dedup_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_obj_get(nodes, texts, obj, key)

        def rh_dedup_string(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, start_out: mutable i64&, end_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            index: i64 = AssessmentDedup::rh_dedup_get(nodes, texts, obj, key)
            return false if index < 0 or nodes[index.usize()].kind != Json::RH_JSON_STR
            node: Json::RhJsonNode = nodes[index.usize()]
            return false if node.text_start == node.text_end
            start_out[0] <- node.text_start
            end_out[0] <- node.text_end
            true

        def rh_dedup_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            index: i64 = AssessmentDedup::rh_dedup_get(nodes, texts, obj, key)
            Json::rh_json_int(nodes, raw, index, ok_out)

        def rh_dedup_optional_string(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, start_out: mutable i64&, end_out: mutable i64&, present_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            index: i64 = AssessmentDedup::rh_dedup_get(nodes, texts, obj, key)
            if index < 0 or nodes[index.usize()].kind == Json::RH_JSON_NULL:
                start_out[0] <- 0
                end_out[0] <- 0
                present_out[0] <- 0
                return true
            return false if nodes[index.usize()].kind != Json::RH_JSON_STR
            node: Json::RhJsonNode = nodes[index.usize()]
            return false if node.text_start == node.text_end
            start_out[0] <- node.text_start
            end_out[0] <- node.text_end
            present_out[0] <- 1
            true

        def rh_dedup_optional_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, value_out: mutable i64&, present_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            index: i64 = AssessmentDedup::rh_dedup_get(nodes, texts, obj, key)
            if index < 0 or nodes[index.usize()].kind == Json::RH_JSON_NULL:
                value_out[0] <- 0
                present_out[0] <- 0
                return true
            ok: mutable i64 = 0
            value: i64 = Json::rh_json_int(nodes, raw, index, &ok)
            return false if ok == 0 or value < 0
            value_out[0] <- value
            present_out[0] <- 1
            true

        def rh_dedup_hex64(texts: darray[u8]&, start: i64, stop: i64) -> bool:
            return false if start < 0 or stop - start != 64
            while index < 64 |index: i64 = 0, texts, start|:
                c: u8 = texts[(start + index).usize()]
                return false if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102))
                index <- index + 1
            true

        def rh_dedup_text_span_order(texts: darray[u8]&, left_start: i64, left_stop: i64, right_start: i64, right_stop: i64) -> i64:
            return -1 if left_stop - left_start != right_stop - right_start
            for index in 0..<(left_stop - left_start) |order: i64 = 0| -> order:
                left: u8 = texts[(left_start + index).usize()]
                right: u8 = texts[(right_start + index).usize()]
                break -1 if left < right
                break 1 if left > right

        def rh_dedup_state_object_keys_unique(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            while key >= 0 |valid: bool = true, key: i64 = nodes[object.usize()].first_child| -> valid:
                break false if nodes[key.usize()].kind != Json::RH_JSON_STR
                value: i64 = nodes[key.usize()].next_sibling
                break false if value < 0
                duplicate_or_invalid: bool = while other >= 0 |duplicate: bool = false, other: i64 = nodes[value.usize()].next_sibling| -> duplicate:
                    break true if nodes[other.usize()].kind != Json::RH_JSON_STR
                    break true if Base::rh_bytes_equal_span(texts, nodes[key.usize()].text_start, nodes[key.usize()].text_end, texts, nodes[other.usize()].text_start, nodes[other.usize()].text_end)
                    other_value: i64 = nodes[other.usize()].next_sibling
                    break true if other_value < 0
                    other <- nodes[other_value.usize()].next_sibling
                break false if duplicate_or_invalid
                key <- nodes[value.usize()].next_sibling

        def rh_dedup_state_keys(raw: darray[u8]&, keys_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if raw.count == 0
            return -1 if raw.count > AssessmentDedup::RH_ASSESSMENT_DEDUP_MAX_STATE_BYTES
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ or nodes[root.usize()].child_count != 4
            schema: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
            values: i64 = Json::rh_json_obj_get(nodes, texts, root, "origin_keys")
            return -1 if schema < 0 or nodes[schema.usize()].kind != Json::RH_JSON_STR or not Base::rh_bytes_equal_literal(texts, nodes[schema.usize()].text_start, nodes[schema.usize()].text_end, "rh-assessment-dedup-state/1")
            return -1 if values < 0 or nodes[values.usize()].kind != Json::RH_JSON_ARR or nodes[values.usize()].child_count > RH_ASSESSMENT_DEDUP_MAX_STATE_KEYS
            return -1 if not AssessmentDedup::rh_dedup_state_object_keys_unique(nodes, texts, root)
            parsed_keys: mutable darray[u8] = []
            status: i64 = while item >= 0 |status: i64 = 0, item: i64 = nodes[values.usize()].first_child, previous_start: i64 = -1, parsed_keys| -> status:
                break -1 if nodes[item.usize()].kind != Json::RH_JSON_STR
                node: Json::RhJsonNode = nodes[item.usize()]
                break -1 if not AssessmentDedup::rh_dedup_hex64(texts, node.text_start, node.text_end)
                break -1 if previous_start >= 0 and AssessmentDedup::rh_dedup_text_span_order(texts, previous_start, previous_start + 64, node.text_start, node.text_end) >= 0
                break -1 if Base::rh_absorb_span(texts, node.text_start, node.text_end, parsed_keys) < 0
                previous_start <- node.text_start
                item <- node.next_sibling
            return status if status != 0
            keys_out.extend(bytes_view(parsed_keys))
            0

        def rh_dedup_key_order(keys: darray[u8]&, left: i64, right: i64) -> i64:
            for index in 0..<64 |order: i64 = 0| -> order:
                left_byte: u8 = keys[(left + index).usize()]
                right_byte: u8 = keys[(right + index).usize()]
                break -1 if left_byte < right_byte
                break 1 if left_byte > right_byte

        def rh_dedup_key_order_between(left_keys: darray[u8]&, left: i64, right_keys: darray[u8]&, right: i64) -> i64:
            for index in 0..<64 |order: i64 = 0| -> order:
                left_byte: u8 = left_keys[(left + index).usize()]
                right_byte: u8 = right_keys[(right + index).usize()]
                break -1 if left_byte < right_byte
                break 1 if left_byte > right_byte

        def rh_dedup_state_contains(sorted_keys: darray[u8]&, key: darray[u8]&) -> bool:
            return false if key.count != 64
            while low < high |found: bool = false, low: i64 = 0, high: i64 = sorted_keys.count.i64() / 64| -> found:
                middle: i64 = low + (high - low) / 2
                order: i64 = for index in 0..<64 |order: i64 = 0| -> order:
                    prior: u8 = sorted_keys[(middle * 64 + index).usize()]
                    current: u8 = key[index.usize()]
                    break -1 if prior < current
                    break 1 if prior > current
                break true if order == 0
                low <- middle + 1 if order < 0
                high <- middle if order > 0

        def rh_dedup_state_keys_valid(keys: darray[u8]&) -> bool:
            return false if keys.count % 64 != 0
            count: i64 = keys.count.i64() / 64
            return false if count > RH_ASSESSMENT_DEDUP_MAX_STATE_KEYS
            for index in 0..<count |valid: bool = true| -> valid:
                offset: i64 = index * 64
                break false if not AssessmentDedup::rh_dedup_hex64(keys, offset, offset + 64)
                break false if index > 0 and AssessmentDedup::rh_dedup_key_order(keys, offset - 64, offset) >= 0

        def rh_dedup_swap_keys(keys: mutable darray[u8]&, left: i64, right: i64) -> void can[Abort.Panic]:
            for index in 0..<64 |keys|:
                temporary: u8 = keys[(left + index).usize()]
                keys[(left + index).usize()] <- keys[(right + index).usize()]
                keys[(right + index).usize()] <- temporary

        def rh_dedup_sift_keys(keys: mutable darray[u8]&, root: i64, last: i64) -> void can[Memory.Allocate, Abort.Panic]:
            while parent * 2 + 1 <= last |parent: i64 = root, keys|:
                child: mutable i64 = parent * 2 + 1
                child <- child + 1 if child < last and AssessmentDedup::rh_dedup_key_order(keys, child * 64, (child + 1) * 64) < 0
                break if AssessmentDedup::rh_dedup_key_order(keys, parent * 64, child * 64) >= 0
                AssessmentDedup::rh_dedup_swap_keys(keys, parent * 64, child * 64)
                parent <- child

        def rh_dedup_sort_keys(keys: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            count: i64 = keys.count.i64() / 64
            return if count < 2
            while start > 0 |start: i64 = count / 2, keys|:
                start <- start - 1
                AssessmentDedup::rh_dedup_sift_keys(keys, start, count - 1)
            while last > 0 |last: i64 = count - 1, keys|:
                AssessmentDedup::rh_dedup_swap_keys(keys, 0, last * 64)
                last <- last - 1
                AssessmentDedup::rh_dedup_sift_keys(keys, 0, last)

        def rh_dedup_state_merge(prior: darray[u8]&, incoming: mutable darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if prior.count % 64 != 0 or incoming.count % 64 != 0
            AssessmentDedup::rh_dedup_sort_keys(incoming)
            prior_count: i64 = prior.count.i64() / 64
            incoming_count: i64 = incoming.count.i64() / 64
            return false if prior_count + incoming_count > RH_ASSESSMENT_DEDUP_MAX_STATE_KEYS
            while left < prior_count or right < incoming_count |valid: bool = true, left: i64 = 0, right: i64 = 0, out| -> valid:
                if left >= prior_count:
                    break false if Base::rh_absorb_span(incoming, right * 64, right * 64 + 64, out) < 0
                    right <- right + 1
                elif right >= incoming_count:
                    break false if Base::rh_absorb_span(prior, left * 64, left * 64 + 64, out) < 0
                    left <- left + 1
                else:
                    order: i64 = AssessmentDedup::rh_dedup_key_order_between(prior, left * 64, incoming, right * 64)
                    if order < 0:
                        break false if Base::rh_absorb_span(prior, left * 64, left * 64 + 64, out) < 0
                        left <- left + 1
                    elif order > 0:
                        break false if Base::rh_absorb_span(incoming, right * 64, right * 64 + 64, out) < 0
                        right <- right + 1
                    else:
                        break false if Base::rh_absorb_span(prior, left * 64, left * 64 + 64, out) < 0
                        left <- left + 1
                        right <- right + 1

        def rh_dedup_emit_state(keys: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-assessment-dedup-state/1\",\"origin_keys\":[")
            for index in 0..<(keys.count.i64() / 64) |out|:
                if index > 0:
                    out.push(44)
                out.push(34)
                for byte_index in 0..<64 |out|:
                    out.push(keys[(index * 64 + byte_index).usize()])
                out.push(34)
            Base::rh_push_text(out, "]}")

        def rh_dedup_source_id_valid(texts: darray[u8]&, start: i64, stop: i64) -> bool:
            return false if start < 0 or stop <= start or stop - start > RH_ASSESSMENT_DEDUP_MAX_SOURCE_ID
            for index in start..<stop |index, texts|:
                c: u8 = texts[index.usize()]
                valid: bool = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 46 or c == 58 or c == 95
                return false if not valid
            true

        def rh_dedup_same_origin(texts: darray[u8]&, left: RhAssessmentDelivery, right: RhAssessmentDelivery) -> bool:
            return false if left.identity_complete == 0 or right.identity_complete == 0
            return false if not Base::rh_bytes_equal_span(texts, left.tool_s, left.tool_e, texts, right.tool_s, right.tool_e)
            return false if not Base::rh_bytes_equal_span(texts, left.version_s, left.version_e, texts, right.version_s, right.version_e)
            return false if left.subject_revision != right.subject_revision
            return false if not Base::rh_bytes_equal_span(texts, left.original_run_s, left.original_run_e, texts, right.original_run_s, right.original_run_e)
            return false if left.original_time != right.original_time
            Base::rh_bytes_equal_span(texts, left.result_digest_s, left.result_digest_e, texts, right.result_digest_s, right.result_digest_e)

        def rh_dedup_append_key_part(material: mutable darray[u8]&, texts: darray[u8]&, start: i64, stop: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_decimal_i64(material, stop - start)
            material.push(58)
            return false if Base::rh_absorb_span(texts, start, stop, material) < 0
            material.push(10)
            true

        def rh_dedup_origin_key(record: RhAssessmentDelivery, texts: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            material: mutable darray[u8] = []
            return false if not AssessmentDedup::rh_dedup_append_key_part(material, texts, record.tool_s, record.tool_e)
            return false if not AssessmentDedup::rh_dedup_append_key_part(material, texts, record.version_s, record.version_e)
            Base::rh_push_decimal_i64(material, record.subject_revision)
            material.push(10)
            return false if not AssessmentDedup::rh_dedup_append_key_part(material, texts, record.original_run_s, record.original_run_e)
            Base::rh_push_decimal_i64(material, record.original_time)
            material.push(10)
            return false if not AssessmentDedup::rh_dedup_append_key_part(material, texts, record.result_digest_s, record.result_digest_e)
            Sha256::rh_sha256(material, out)
            true

        def rh_dedup_emit_span(out: mutable darray[u8]&, texts: darray[u8]&, start: i64, stop: i64) -> void can[Memory.Allocate, Abort.Panic]:
            out.push(34)
            Base::rh_json_escape(out, texts, start.usize(), stop.usize())
            out.push(34)

    public:
        def rh_assessment_dedup_state_keys(raw: darray[u8]&, keys_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            AssessmentDedup::rh_dedup_state_keys(raw, keys_out)

    private:
        # Complete keys deduplicate an assessment, while all delivery rows remain
        # visible. Incomplete identities each receive their own possible-duplicate state.
        def rh_dedup_report(raw: darray[u8]&, prior_keys: darray[u8]&, state_enabled: bool, out: mutable darray[u8]&, state_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if raw.count > 1048576
            return -1 if state_enabled and not AssessmentDedup::rh_dedup_state_keys_valid(prior_keys)
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_index: i64 = AssessmentDedup::rh_dedup_get(nodes, texts, root, "schema")
            return -1 if schema_index < 0 or nodes[schema_index.usize()].kind != Json::RH_JSON_STR or not Base::rh_bytes_equal_literal(texts, nodes[schema_index.usize()].text_start, nodes[schema_index.usize()].text_end, "rh-assessment-dedup-input/1")
            rows_index: i64 = AssessmentDedup::rh_dedup_get(nodes, texts, root, "deliveries")
            return -1 if rows_index < 0 or nodes[rows_index.usize()].kind != Json::RH_JSON_ARR
            row_count: i64 = nodes[rows_index.usize()].child_count
            return -1 if row_count < 1 or row_count > RH_ASSESSMENT_DEDUP_MAX_ROWS
            rows: mutable darray[RhAssessmentDelivery] = []
            digests: mutable darray[u8] = []
            new_state_keys: mutable darray[u8] = []
            complete_groups: mutable i64 = 0
            repeated_deliveries: mutable i64 = 0
            possible_duplicates: mutable i64 = 0
            previously_seen_groups: mutable i64 = 0
            while row >= 0 |row: i64 = nodes[rows_index.usize()].first_child, nodes, texts, raw, rows, digests, new_state_keys, prior_keys, state_enabled, complete_groups, repeated_deliveries, possible_duplicates, previously_seen_groups|:
                return -1 if nodes[row.usize()].kind != Json::RH_JSON_OBJ
                delivery_s: mutable i64 = 0
                delivery_e: mutable i64 = 0
                return -1 if not AssessmentDedup::rh_dedup_string(nodes, texts, row, "delivery_id", &delivery_s, &delivery_e)
                delivery_time_ok: mutable i64 = 0
                delivery_time: i64 = AssessmentDedup::rh_dedup_int(nodes, raw, texts, row, "delivery_time", &delivery_time_ok)
                return -1 if delivery_time_ok == 0 or delivery_time < 0
                delivery_source_s: mutable i64 = 0
                delivery_source_e: mutable i64 = 0
                delivery_source_present: mutable i64 = 0
                return -1 if not AssessmentDedup::rh_dedup_optional_string(nodes, texts, row, "delivery_source", &delivery_source_s, &delivery_source_e, &delivery_source_present)
                return -1 if delivery_source_present != 0 and not AssessmentDedup::rh_dedup_source_id_valid(texts, delivery_source_s, delivery_source_e)
                unique_delivery_id: bool = for prior in 0..<rows.count |unique: bool = true| -> unique:
                    prior_delivery: RhAssessmentDelivery = rows[prior]
                    same_delivery_id: bool = Base::rh_bytes_equal_span(texts, prior_delivery.delivery_s, prior_delivery.delivery_e, texts, delivery_s, delivery_e)
                    same_source_presence: bool = prior_delivery.delivery_source_present == delivery_source_present
                    same_source: bool = delivery_source_present == 0 or Base::rh_bytes_equal_span(texts, prior_delivery.delivery_source_s, prior_delivery.delivery_source_e, texts, delivery_source_s, delivery_source_e)
                    break false if same_delivery_id and same_source_presence and same_source
                return -1 if not unique_delivery_id
                tool_s: mutable i64 = 0
                tool_e: mutable i64 = 0
                tool_present: mutable i64 = 0
                version_s: mutable i64 = 0
                version_e: mutable i64 = 0
                version_present: mutable i64 = 0
                revision: mutable i64 = 0
                revision_present: mutable i64 = 0
                original_run_s: mutable i64 = 0
                original_run_e: mutable i64 = 0
                original_run_present: mutable i64 = 0
                original_time: mutable i64 = 0
                original_time_present: mutable i64 = 0
                result_digest_s: mutable i64 = 0
                result_digest_e: mutable i64 = 0
                result_digest_present: mutable i64 = 0
                return -1 if not AssessmentDedup::rh_dedup_optional_string(nodes, texts, row, "tool", &tool_s, &tool_e, &tool_present) or not AssessmentDedup::rh_dedup_optional_string(nodes, texts, row, "tool_version", &version_s, &version_e, &version_present) or not AssessmentDedup::rh_dedup_optional_int(nodes, raw, texts, row, "subject_revision", &revision, &revision_present) or not AssessmentDedup::rh_dedup_optional_string(nodes, texts, row, "original_run", &original_run_s, &original_run_e, &original_run_present) or not AssessmentDedup::rh_dedup_optional_int(nodes, raw, texts, row, "original_time", &original_time, &original_time_present) or not AssessmentDedup::rh_dedup_optional_string(nodes, texts, row, "result_digest", &result_digest_s, &result_digest_e, &result_digest_present)
                return -1 if result_digest_present != 0 and not AssessmentDedup::rh_dedup_hex64(texts, result_digest_s, result_digest_e)
                complete: bool = tool_present != 0 and version_present != 0 and revision_present != 0 and original_run_present != 0 and original_time_present != 0 and result_digest_present != 0
                item: mutable RhAssessmentDelivery = RhAssessmentDelivery{delivery_s: delivery_s, delivery_e: delivery_e, delivery_time: delivery_time, delivery_source_s: delivery_source_s, delivery_source_e: delivery_source_e, delivery_source_present: delivery_source_present, tool_s: tool_s, tool_e: tool_e, tool_present: tool_present, version_s: version_s, version_e: version_e, version_present: version_present, subject_revision: revision, revision_present: revision_present, original_run_s: original_run_s, original_run_e: original_run_e, original_run_present: original_run_present, original_time: original_time, original_time_present: original_time_present, result_digest_s: result_digest_s, result_digest_e: result_digest_e, result_digest_present: result_digest_present, identity_complete: 1 if complete else 0, group_id: -1, key_offset: -1, seen_before_batch: 0}
                if complete:
                    matched_group, matched_key_offset, matched_seen_before_batch =
                        for prior in 0..<rows.count |matched_group: i64 = -1, matched_key_offset: i64 = -1, matched_seen_before_batch: i64 = 0| -> matched_group, matched_key_offset, matched_seen_before_batch:
                            if AssessmentDedup::rh_dedup_same_origin(texts, rows[prior], item):
                                matched_group <- rows[prior].group_id
                                matched_key_offset <- rows[prior].key_offset
                                matched_seen_before_batch <- rows[prior].seen_before_batch
                                break
                    if matched_group >= 0:
                        item.group_id <- matched_group
                        repeated_deliveries <- repeated_deliveries + 1
                        item.key_offset <- matched_key_offset
                        item.seen_before_batch <- matched_seen_before_batch
                    else:
                        item.group_id <- complete_groups
                        complete_groups <- complete_groups + 1
                        key: mutable darray[u8] = []
                        return -1 if not AssessmentDedup::rh_dedup_origin_key(item, texts, key)
                        item.key_offset <- digests.count.i64()
                        digests.extend(bytes_view(key))
                        if state_enabled:
                            item.seen_before_batch <- 1 if AssessmentDedup::rh_dedup_state_contains(prior_keys, key)
                            previously_seen_groups <- previously_seen_groups + 1 if item.seen_before_batch != 0
                            if item.seen_before_batch == 0:
                                new_state_keys.extend(bytes_view(key))
                else:
                    possible_duplicates <- possible_duplicates + 1
                rows.push(item)
                row <- nodes[row.usize()].next_sibling
            if state_enabled:
                merged_state_keys: mutable darray[u8] = []
                return -1 if not AssessmentDedup::rh_dedup_state_merge(prior_keys, new_state_keys, merged_state_keys)
                AssessmentDedup::rh_dedup_emit_state(merged_state_keys, state_out)
            Base::rh_push_text(out, "{\"schema\":\"rh-assessment-dedup-result/1\",\"deliveries\":[")
            for index in 0..<rows.count |out|:
                if index > 0:
                    out.push(44)
                item: RhAssessmentDelivery = rows[index]
                Base::rh_push_text(out, "{\"delivery_id\":")
                AssessmentDedup::rh_dedup_emit_span(out, texts, item.delivery_s, item.delivery_e)
                if item.delivery_source_present != 0:
                    Base::rh_push_text(out, ",\"delivery_source\":")
                    AssessmentDedup::rh_dedup_emit_span(out, texts, item.delivery_source_s, item.delivery_source_e)
                Base::rh_push_text(out, ",\"delivery_time\":")
                Base::rh_push_decimal_i64(out, item.delivery_time)
                if state_enabled:
                    Base::rh_push_text(out, ",\"seen_before_batch\":")
                    Base::rh_push_text(out, "true" if item.seen_before_batch != 0 else "false")
                Base::rh_push_text(out, ",\"identity_complete\":")
                Base::rh_push_text(out, "true" if item.identity_complete != 0 else "false")
                Base::rh_push_text(out, ",\"deduplication_state\":\"")
                Base::rh_push_text(out, "key_available" if item.identity_complete != 0 else "possible_duplicate")
                Base::rh_push_text(out, "\",\"group_id\":")
                if item.identity_complete != 0:
                    Base::rh_push_decimal_i64(out, item.group_id)
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"assessment_key\":")
                if item.identity_complete != 0:
                    out.push(34)
                    for key_index in 0..<64.usize() |out|:
                        out.push(digests[item.key_offset.usize() + key_index])
                    out.push(34)
                else:
                    Base::rh_push_text(out, "null")
                out.push(125)
            Base::rh_push_text(out, "],\"counts\":{\"delivery_count\":")
            Base::rh_push_decimal_i64(out, rows.count.i64())
            Base::rh_push_text(out, ",\"unique_complete_origin_assessments\":")
            Base::rh_push_decimal_i64(out, complete_groups)
            Base::rh_push_text(out, ",\"additional_deliveries_of_same_assessment\":")
            Base::rh_push_decimal_i64(out, repeated_deliveries)
            Base::rh_push_text(out, ",\"possible_duplicate_deliveries\":")
            Base::rh_push_decimal_i64(out, possible_duplicates)
            if state_enabled:
                Base::rh_push_text(out, ",\"origin_assessments_seen_before_batch\":")
                Base::rh_push_decimal_i64(out, previously_seen_groups)
            Base::rh_push_text(out, "}}")
            0

    public:
        def rh_assessment_dedup_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            prior_keys: mutable darray[u8] = []
            state_out: mutable darray[u8] = []
            AssessmentDedup::rh_dedup_report(raw, prior_keys, false, out, state_out)

        def rh_assessment_dedup_report_state(raw: darray[u8]&, prior_keys: darray[u8]&, out: mutable darray[u8]&, state_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            AssessmentDedup::rh_dedup_report(raw, prior_keys, true, out, state_out)
