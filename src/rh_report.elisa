# rh_report.elisa — pinned reports (M01-07).
#
# Writes report.json, report.md, and bundle.manifest. Every published
# number traces to the retained evidence files named in its "evidence"
# list (R003). Capabilities the generic-Git path cannot observe (reviews,
# permissions, traffic, dependents) are reported unavailable with reasons
# (R002); they never appear as zero or as a favorable default (R030: no
# universal score anywhere in these files).
#
# All human-readable strings here are fixed literals or allowlist-checked
# inputs (Git::rh_arg_safe charset has no JSON/Markdown metacharacters), so no
# escaping layer is needed or claimed.


include "./rh_base.elisa"
include "./rh_observation.elisa"
include "./rh_scan.elisa"
include "./rh_git_metrics.elisa"
include "./rh_files.elisa"

module Report:
    private:
        # {"key":..,"version":"1.0.0","status":..,"value":N,"evidence":[...]}
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_emit_count(buffer: mutable darray[u8]&, key: u8&, status: u8, count: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(buffer, "{\"key\":\"")
            Base::rh_push_text(buffer, key)
            Base::rh_push_text(buffer, "\",\"version\":\"1.0.0\",\"status\":\"")
            Base::rh_push_text(buffer, Observation::rh_status_label(status))
            Base::rh_push_text(buffer, "\",\"value\":")
            Base::rh_push_decimal_i64(buffer, count)
            Base::rh_push_text(buffer, ",\"evidence\":[\"evidence/git-log.bin\"]}")

        def rh_emit_timestamp(buffer: mutable darray[u8]&, key: u8&, status: u8, value: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(buffer, "{\"key\":\"")
            Base::rh_push_text(buffer, key)
            Base::rh_push_text(buffer, "\",\"version\":\"1.0.0\",\"status\":\"")
            Base::rh_push_text(buffer, Observation::rh_status_label(status))
            Base::rh_push_text(buffer, "\",\"value\":")
            Base::rh_push_decimal_i64(buffer, value)
            Base::rh_push_text(buffer, ",\"evidence\":[\"evidence/git-log.bin\"]}")

        # Absent value: no "value" member at all (never null-as-zero).
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_emit_absent(buffer: mutable darray[u8]&, key: u8&, status: u8, reason: u8&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(buffer, "{\"key\":\"")
            Base::rh_push_text(buffer, key)
            Base::rh_push_text(buffer, "\",\"version\":\"1.0.0\",\"status\":\"")
            Base::rh_push_text(buffer, Observation::rh_status_label(status))
            Base::rh_push_text(buffer, "\",\"reason\":\"")
            Base::rh_push_text(buffer, reason)
            Base::rh_push_text(buffer, "\"}")

        # Versioned absent value; denominator changes must remain visible even when
        # the observation has no numeric value.
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_emit_absent_version(buffer: mutable darray[u8]&, key: u8&, version: u8&, status: u8, reason: u8&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(buffer, "{\"key\":\"")
            Base::rh_push_text(buffer, key)
            Base::rh_push_text(buffer, "\",\"version\":\"")
            Base::rh_push_text(buffer, version)
            Base::rh_push_text(buffer, "\",\"status\":\"")
            Base::rh_push_text(buffer, Observation::rh_status_label(status))
            Base::rh_push_text(buffer, "\",\"reason\":\"")
            Base::rh_push_text(buffer, reason)
            Base::rh_push_text(buffer, "\"}")

        # Ratio value {"num":N,"den":D}.
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_emit_ratio(buffer: mutable darray[u8]&, key: u8&, status: u8, num: i64, den: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(buffer, "{\"key\":\"")
            Base::rh_push_text(buffer, key)
            Base::rh_push_text(buffer, "\",\"version\":\"1.0.0\",\"status\":\"")
            Base::rh_push_text(buffer, Observation::rh_status_label(status))
            Base::rh_push_text(buffer, "\",\"value\":{\"num\":")
            Base::rh_push_decimal_i64(buffer, num)
            Base::rh_push_text(buffer, ",\"den\":")
            Base::rh_push_decimal_i64(buffer, den)
            Base::rh_push_text(buffer, "},\"evidence\":[\"evidence/git-log.bin\",\"evidence/git-shallow.txt\"]}")

        # Explicit-version ratio emission keeps denominator changes machine-visible.
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_emit_ratio_version(buffer: mutable darray[u8]&, key: u8&, version: u8&, status: u8, num: i64, den: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(buffer, "{\"key\":\"")
            Base::rh_push_text(buffer, key)
            Base::rh_push_text(buffer, "\",\"version\":\"")
            Base::rh_push_text(buffer, version)
            Base::rh_push_text(buffer, "\",\"status\":\"")
            Base::rh_push_text(buffer, Observation::rh_status_label(status))
            Base::rh_push_text(buffer, "\",\"value\":{\"num\":")
            Base::rh_push_decimal_i64(buffer, num)
            Base::rh_push_text(buffer, ",\"den\":")
            Base::rh_push_decimal_i64(buffer, den)
            Base::rh_push_text(buffer, "},\"evidence\":[\"evidence/git-log.bin\",\"evidence/git-shallow.txt\"]}")

        # Enum value {"code":C,"label":"..."}.
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_emit_enum(buffer: mutable darray[u8]&, key: u8&, status: u8, code: i64, label: u8&, ev2: bool) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(buffer, "{\"key\":\"")
            Base::rh_push_text(buffer, key)
            Base::rh_push_text(buffer, "\",\"version\":\"1.0.0\",\"status\":\"")
            Base::rh_push_text(buffer, Observation::rh_status_label(status))
            Base::rh_push_text(buffer, "\",\"value\":{\"code\":")
            Base::rh_push_decimal_i64(buffer, code)
            Base::rh_push_text(buffer, ",\"label\":\"")
            Base::rh_push_text(buffer, label)
            Base::rh_push_text(buffer, "\"},\"evidence\":[\"evidence/git-log.bin\"")
            if ev2:
                Base::rh_push_text(buffer, ",\"evidence/git-shallow.txt\"")
            Base::rh_push_text(buffer, "]}")

        def rh_emit_bool(buffer: mutable darray[u8]&, key: u8&, value: i64, evidence: u8&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(buffer, "{\"key\":\"")
            Base::rh_push_text(buffer, key)
            Base::rh_push_text(buffer, "\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_text(buffer, "true" if value == 1 else "false")
            Base::rh_push_text(buffer, ",\"evidence\":[\"")
            Base::rh_push_text(buffer, evidence)
            Base::rh_push_text(buffer, "\"]}")

        def rh_emit_file_metric(buffer: mutable darray[u8]&, key: u8&, value: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if value < 0:
                rh_emit_absent(buffer, key, 2, "snapshot-file-list-unavailable")
            else:
                rh_emit_bool(buffer, key, value, "evidence/git-files.txt")

        def rh_emit_file_count(buffer: mutable darray[u8]&, key: u8&, value: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if value < 0:
                rh_emit_absent(buffer, key, 2, "snapshot-file-list-unavailable")
            else:
                Base::rh_push_text(buffer, "{\"key\":\"")
                Base::rh_push_text(buffer, key)
                Base::rh_push_text(buffer, "\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
                Base::rh_push_decimal_i64(buffer, value)
                Base::rh_push_text(buffer, ",\"evidence\":[\"evidence/git-files.txt\"]}")

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_coverage_label(state: i64) -> u8&:
            return "shallow" if state == 1
            return "truncated" if state == 2
            "complete"

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_manifest_label(code: i64) -> u8&:
            return "found" if code == 1
            "none"

        # Locate "key" at a line start; returns the value span [vstart, vend).
        # Found flag via found_out (1/0). Replay fails closed when absent.
        def rh_manifest_span(manifest: darray[u8]&, key: u8&, vstart_out: mutable i64&, vend_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            kn: usize = strlen(key)
            while pos + kn < manifest.count |pos: usize = 0, manifest, kn, key|:
                at_line_start: bool = pos == 0 or manifest[pos - 1] == 10
                if at_line_start:
                    hit: bool =
                        while k < kn |hit: bool = true, k: usize = 0, pos| -> hit:
                            if manifest[pos + k] != key[k]:
                                hit <- false
                            k <- k + 1
                    if hit:
                        line_end: usize =
                            eol: i64 = Base::rh_find_byte(manifest, pos + kn, 10)
                            eol.usize() if eol >= 0 else manifest.count
                        vstart_out[0] <- (pos + kn).i64()
                        vend_out[0] <- line_end.i64()
                        return true
                pos <- pos + 1
            false

        # Integer manifest field ("window-days: 365"). ok_out 1/0.
        def rh_manifest_int(manifest: darray[u8]&, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            ok_out[0] <- 0
            vs: mutable i64 = 0
            ve: mutable i64 = 0
            return 0 if not rh_manifest_span(manifest, key, &vs, &ve)
            Base::rh_parse_i64(manifest, vs.usize(), ve.usize(), ok_out)

        # Boolean manifest field ("full-history: true"). 1 true, 0 false/unparseable.
        def rh_manifest_flag(manifest: darray[u8]&, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            vs: mutable i64 = 0
            ve: mutable i64 = 0
            return 0 if not rh_manifest_span(manifest, key, &vs, &ve)
            if ve - vs == 4:
                return 1 if manifest[vs.usize()] == 116 and manifest[vs.usize() + 1] == 114 and manifest[vs.usize() + 2] == 117 and manifest[vs.usize() + 3] == 101
            0

    public:
        # Replay uses these narrow readers at the CLI boundary; the span parser
        # and field representation remain private to the report module.
        def rh_report_manifest_int(manifest: darray[u8]&, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            rh_manifest_int(manifest, key, ok_out)

        def rh_report_manifest_flag(manifest: darray[u8]&, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            rh_manifest_flag(manifest, key)
    public:
        struct RhReportCtx:
            identities: i64
            bots: i64
            months: i64
            cov_num: i64
            cov_den: i64
            cov_v2_num: i64
            cov_v2_den: i64
            cov_state: i64
            fresh_age: i64
            window_days: i64
            full_history: i64
            repo_kind: i64
            cutoff: i64
            partial_clone: i64
            default_revisions: i64
            files: Files::RhFileMetrics
            git_metrics: GitMetrics::RhMetrics

        def rh_report_ctx_make(identities: i64, bots: i64, months: i64, cov_num: i64, cov_den: i64, cov_v2_num: i64, cov_v2_den: i64, cov_state: i64, fresh_age: i64, window_days: i64, full_history: i64, repo_kind: i64, cutoff: i64, partial_clone: i64, default_revisions: i64, files: Files::RhFileMetrics, git_metrics: GitMetrics::RhMetrics) -> RhReportCtx:
            RhReportCtx{identities: identities, bots: bots, months: months, cov_num: cov_num, cov_den: cov_den, cov_v2_num: cov_v2_num, cov_v2_den: cov_v2_den, cov_state: cov_state, fresh_age: fresh_age, window_days: window_days, full_history: full_history, repo_kind: repo_kind, cutoff: cutoff, partial_clone: partial_clone, default_revisions: default_revisions, files: files, git_metrics: git_metrics}

        def rh_write_report_json(path: cstr, repo: cstr, snap: Scan::RhSnapshot&, ctx: RhReportCtx&) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            out: mutable darray[u8] =
                out: mutable darray[u8] = []
                Base::rh_push_text(out, "{\"report\":\"repo-health-m01\",\"report_version\":\"1.0.0\",\"source\":\"")
                Base::rh_push_cstr(out, repo)
                Base::rh_push_text(out, "\",\"source_kind\":\"")
                out
            if ctx.repo_kind == 1:
                Base::rh_push_text(out, "https")
            else:
                Base::rh_push_text(out, "local")
            Base::rh_push_text(out, "\",\"evidence_cutoff\":")
            Base::rh_push_decimal_i64(out, ctx.cutoff)
            Base::rh_push_text(out, ",\"window_days\":")
            Base::rh_push_decimal_i64(out, ctx.window_days)
            Base::rh_push_text(out, ",\"full_history\":")
            if ctx.full_history == 1:
                Base::rh_push_text(out, "true")
            else:
                Base::rh_push_text(out, "false")
            Base::rh_push_text(out, ",\"input_digest_fnv1a64\":\"")
            Base::rh_push_text(out, "fnv1a64:")
            Base::rh_push_hex_u64(out, snap.digest)
            Base::rh_push_text(out, "\",\"metrics\":[")
            rh_emit_count(out, "history.commit_count", 0, snap.commits)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "history.reachable_revisions", 0, snap.commits_all)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "history.reachable_merge_count", 0, snap.merges)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "history.rejected_record_count", 0, snap.rejected)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "history.revisions_observed", 0, ctx.git_metrics.revisions_observed)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "history.revisions_reachable_all_refs", 0, ctx.git_metrics.revisions_observed)
            Base::rh_push_text(out, ",")
            Base::rh_push_text(out, "{\"key\":\"history.revisions_reachable_default\",\"version\":\"1.0.0\",\"status\":\"")
            if ctx.default_revisions < 0:
                Base::rh_push_text(out, "unsupported\",\"reason\":\"default-branch-tip-unavailable\"")
            else:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, ctx.default_revisions)
            Base::rh_push_text(out, ",\"evidence\":[\"evidence/git-default-count.txt\"]}")
            Base::rh_push_text(out, ",")
            if ctx.git_metrics.revisions_observed == 0:
                rh_emit_absent(out, "history.first_author_time", 6, "empty-history")
            else:
                rh_emit_timestamp(out, "history.first_author_time", 0, ctx.git_metrics.first_author_time)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "history.history_span_days", 0, ctx.git_metrics.history_span_days)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "history.shallow_boundary_count", 0, ctx.git_metrics.shallow_boundary_count)
            Base::rh_push_text(out, ",")
            rh_emit_enum(out, "history.coverage_state", 0, ctx.cov_state, rh_coverage_label(ctx.cov_state), true)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "activity.commit_event_count", 0, snap.commits)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "activity.accepted_changes", 0, ctx.git_metrics.commits)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "activity.commits", 0, ctx.git_metrics.commits)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "activity.nonmerge_commits", 0, ctx.git_metrics.nonmerge_commits)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "activity.merge_commits", 0, ctx.git_metrics.merge_commits)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "activity.active_days", 0, ctx.git_metrics.active_days)
            Base::rh_push_text(out, ",")
            if ctx.git_metrics.longest_gap_days < 0:
                rh_emit_absent(out, "activity.longest_observed_gap_days", 6, "fewer-than-two-events")
            else:
                rh_emit_count(out, "activity.longest_observed_gap_days", 0, ctx.git_metrics.longest_gap_days)
            Base::rh_push_text(out, ",")
            if ctx.git_metrics.median_interevent_hours < 0:
                rh_emit_absent(out, "activity.median_interevent_hours", 6, "fewer-than-two-events")
            else:
                rh_emit_count(out, "activity.median_interevent_hours", 0, ctx.git_metrics.median_interevent_hours)
            Base::rh_push_text(out, ",")
            if ctx.git_metrics.weekly_slope_den <= 0:
                rh_emit_absent(out, "activity.weekly_count_slope", 6, "fewer-than-two-complete-weeks")
            else:
                rh_emit_ratio(out, "activity.weekly_count_slope", 0, ctx.git_metrics.weekly_slope_num, ctx.git_metrics.weekly_slope_den)
            Base::rh_push_text(out, ",")
            if ctx.git_metrics.weekly_variance_den <= 0:
                rh_emit_absent(out, "activity.weekly_count_variance", 6, "no-complete-weeks")
            else:
                rh_emit_ratio(out, "activity.weekly_count_variance", 0, ctx.git_metrics.weekly_variance_num, ctx.git_metrics.weekly_variance_den)
            Base::rh_push_text(out, ",")
            if ctx.git_metrics.commits == 0:
                rh_emit_absent(out, "activity.bot_event_share", 6, "empty-window-no-events")
            else:
                rh_emit_ratio(out, "activity.bot_event_share", 0, ctx.git_metrics.bot_events, ctx.git_metrics.commits)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "activity.active_complete_months", 0, ctx.months)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "activity.active_months", 0, ctx.months)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "contributors.raw_identity_count", 0, ctx.identities)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "contributor.source_accounts", 0, ctx.identities)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "contributor.raw_author_identities", 0, ctx.identities)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "contributor.known_bot_accounts", 0, ctx.git_metrics.known_bot_accounts)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "contributor.unclassified_accounts", 0, ctx.git_metrics.unclassified_accounts)
            Base::rh_push_text(out, ",")
            if ctx.git_metrics.first_observed_actors < 0:
                rh_emit_absent(out, "contributor.first_observed_contributors", 4, "windowed-history-cannot-establish-first-observed")
            else:
                rh_emit_count(out, "contributor.first_observed_contributors", 0, ctx.git_metrics.first_observed_actors)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "contributor.single_event_contributors", 0, ctx.git_metrics.single_event_actors)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "contributor.contributors_2_to_5_events", 0, ctx.git_metrics.actors_2_to_5)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "contributor.contributors_6_to_20_events", 0, ctx.git_metrics.actors_6_to_20)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "contributor.contributors_over_20_events", 0, ctx.git_metrics.actors_over_20)
            Base::rh_push_text(out, ",")
            if ctx.git_metrics.actor_count == 0:
                rh_emit_absent(out, "contributor.single_event_share", 6, "empty-window-no-actors")
            else:
                rh_emit_ratio(out, "contributor.single_event_share", 0, ctx.git_metrics.single_event_actors, ctx.git_metrics.actor_count)
            Base::rh_push_text(out, ",")
            rh_emit_count(out, "contributors.automation_known", 0, ctx.bots)
            Base::rh_push_text(out, ",")
            if ctx.cov_den == 0:
                rh_emit_absent(out, "coverage.window_completeness", 6, "empty-window-no-complete-month")
            else:
                if ctx.cov_state == 0:
                    rh_emit_ratio(out, "coverage.window_completeness", 0, ctx.cov_num, ctx.cov_den)
                else:
                    rh_emit_ratio(out, "coverage.window_completeness", 4, ctx.cov_num, ctx.cov_den)
            Base::rh_push_text(out, ",")
            if ctx.cov_v2_den == 0:
                rh_emit_absent_version(out, "coverage.window_completeness", "2.0.0", 6, "empty-window-no-complete-month")
            else:
                if ctx.cov_state == 0:
                    rh_emit_ratio_version(out, "coverage.window_completeness", "2.0.0", 0, ctx.cov_v2_num, ctx.cov_v2_den)
                else:
                    rh_emit_ratio_version(out, "coverage.window_completeness", "2.0.0", 4, ctx.cov_v2_num, ctx.cov_v2_den)
            Base::rh_push_text(out, ",")
            Base::rh_push_text(out, "{\"key\":\"history.collection_complete_windows\",\"version\":\"1.0.0\",\"status\":\"")
            Base::rh_push_text(out, "observed\",\"value\":{\"complete\":")
            Base::rh_push_decimal_i64(out, 1 if ctx.cov_state == 0 else 0)
            Base::rh_push_text(out, ",\"requested\":1},\"evidence\":[\"evidence/git-log.bin\",\"evidence/git-shallow.txt\"]}")
            Base::rh_push_text(out, ",")
            if ctx.fresh_age < 0:
                rh_emit_absent(out, "freshness.evidence_max_age_hours", 2, "no-commit-events-in-window")
            else:
                rh_emit_count(out, "freshness.evidence_max_age_hours", 0, ctx.fresh_age)
            Base::rh_push_text(out, ",")
            if snap.manifest == 2:
                rh_emit_absent(out, "source.manifest_presence", 2, "non-local-source-no-file-access")
            else:
                rh_emit_enum(out, "source.manifest_presence", 0, snap.manifest, rh_manifest_label(snap.manifest), false)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "documentation.readme_present", ctx.files.readme)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "documentation.contributing_guide_present", ctx.files.contributing)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "licensing.license_declaration_present", ctx.files.license)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "documentation.installation_guide_present", ctx.files.installation)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "documentation.api_reference_present", ctx.files.api_reference)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "governance.governance_document_present", ctx.files.governance)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "governance.code_ownership_rules_present", ctx.files.code_ownership)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "licensing.source_notice_presence", ctx.files.notice)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "governance.release_process_document_present", ctx.files.release_process)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "governance.succession_process_document_present", ctx.files.succession_process)
            Base::rh_push_text(out, ",")
            rh_emit_file_count(out, "licensing.license_file_count", ctx.files.license_files)
            Base::rh_push_text(out, ",")
            rh_emit_file_count(out, "documentation.example_program_count", ctx.files.examples)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "security.security_policy_present", ctx.files.security_policy)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "release.release_note_presence", ctx.files.release_notes)
            Base::rh_push_text(out, ",")
            rh_emit_file_count(out, "code.source_file_count", ctx.files.source_files)
            Base::rh_push_text(out, ",")
            rh_emit_file_metric(out, "build.ci_configuration_present", ctx.files.ci_configuration)
            Base::rh_push_text(out, ",")
            rh_emit_file_count(out, "testing.test_files_observed", ctx.files.test_files)
            Base::rh_push_text(out, ",")
            rh_emit_ratio(out, "coverage.lineage_complete_share", 0, 1, 1)
            Base::rh_push_text(out, "],\"capabilities\":{\"git_log\":\"observed\",\"review_events\":\"unavailable-from-generic-git\",\"maintainer_permissions\":\"unavailable-from-generic-git\",\"clone_traffic\":\"unavailable-from-generic-git\",\"known_downstream\":\"not-collected-in-m01\",\"retention\":\"deferred-to-m04\",\"cross_source_identity\":\"not-configured\"")
            if ctx.partial_clone == 1:
                Base::rh_push_text(out, ",\"blob_metrics\":\"partial-missing-blobs\"")
            else:
                Base::rh_push_text(out, ",\"blob_metrics\":\"not-derived\"")
            Base::rh_push_text(out, "}}")
            Base::rh_push_text(out, "\n")
            Base::rh_io_write(path, out)

        def rh_write_report_md(path: cstr, repo: cstr, snap: Scan::RhSnapshot&, ctx: RhReportCtx&) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            out: mutable darray[u8] =
                out: mutable darray[u8] = []
                Base::rh_push_text(out, "# repo-health report (M01 slice)\n\nSource: `")
                Base::rh_push_cstr(out, repo)
                Base::rh_push_text(out, "`\n\nProject identity: repository-only; no accepted multi-repository mapping.\n")
                Base::rh_push_text(out, "History: ")
                Base::rh_push_text(out, rh_coverage_label(ctx.cov_state))
                Base::rh_push_text(out, " for the requested window.\n\n")
                Base::rh_push_text(out, "| metric | status | value |\n|---|---|---|\n| observed commits | observed | ")
                Base::rh_push_decimal_i64(out, snap.commits)
                Base::rh_push_text(out, " |\n| reachable revisions | observed | ")
                Base::rh_push_decimal_i64(out, snap.commits_all)
                Base::rh_push_text(out, " |\n| rejected records | observed | ")
                Base::rh_push_decimal_i64(out, snap.rejected)
                Base::rh_push_text(out, " |\n| merge commits | observed | ")
                Base::rh_push_decimal_i64(out, snap.merges)
                Base::rh_push_text(out, " |\n| future timestamps | flagged | ")
                Base::rh_push_decimal_i64(out, snap.future)
                Base::rh_push_text(out, " |\n| author-committer skew | observed | ")
                Base::rh_push_decimal_i64(out, snap.skew)
                Base::rh_push_text(out, " |\n| raw author identities | observed | ")
                Base::rh_push_decimal_i64(out, ctx.identities)
                Base::rh_push_text(out, " |\n| automation (heuristic) | observed | ")
                Base::rh_push_decimal_i64(out, ctx.bots)
                Base::rh_push_text(out, " |\n| active complete months | observed | ")
                Base::rh_push_decimal_i64(out, ctx.months)
                Base::rh_push_text(out, " |\n| window completeness | ")
                out
            if ctx.cov_den == 0:
                Base::rh_push_text(out, "not_applicable | no complete month in window")
            else:
                if ctx.cov_state != 0:
                    Base::rh_push_text(out, "partial")
                else:
                    Base::rh_push_text(out, "observed")
                Base::rh_push_text(out, " | ")
                Base::rh_push_decimal_i64(out, ctx.cov_num)
                Base::rh_push_text(out, "/")
                Base::rh_push_decimal_i64(out, ctx.cov_den)
            Base::rh_push_text(out, " |\n| window completeness v2 (full requested window) | ")
            if ctx.cov_v2_den == 0:
                Base::rh_push_text(out, "not_applicable | no complete month in window")
            else:
                if ctx.cov_state != 0:
                    Base::rh_push_text(out, "partial")
                else:
                    Base::rh_push_text(out, "observed")
                Base::rh_push_text(out, " | ")
                Base::rh_push_decimal_i64(out, ctx.cov_v2_num)
                Base::rh_push_text(out, "/")
                Base::rh_push_decimal_i64(out, ctx.cov_v2_den)
            Base::rh_push_text(out, " |\n| evidence max age (hours) | ")
            if ctx.fresh_age < 0:
                Base::rh_push_text(out, "unavailable | no commit events in window")
            else:
                Base::rh_push_text(out, "observed | ")
                Base::rh_push_decimal_i64(out, ctx.fresh_age)
            Base::rh_push_text(out, " |\n| manifest presence | ")
            if snap.manifest == 2:
                Base::rh_push_text(out, "unavailable | non-local source")
            else:
                Base::rh_push_text(out, "observed | ")
                Base::rh_push_text(out, rh_manifest_label(snap.manifest))
            Base::rh_push_text(out, " |\n| blob-derived metrics | ")
            if ctx.partial_clone == 1:
                Base::rh_push_text(out, "partial | partial clone: blobs may be missing; history metrics are unaffected")
            else:
                Base::rh_push_text(out, "not-derived | no blob/tree metric is published in M01")
            Base::rh_push_text(out, " |\n\n")
            Base::rh_push_text(out, "## Explicitly not collected from generic Git\n\nReview events, maintainer permission inventories, clone traffic, and known downstream projects are unavailable from generic Git history, not zero. Retention and cross-source identity are deferred to M04. Raw commit authors are not called maintainers.\n\n")
            Base::rh_push_text(out, "Evidence digest `fnv1a64:")
            Base::rh_push_hex_u64(out, snap.digest)
            Base::rh_push_text(out, "`. Replay with `rh_cli replay` against the retained bundle.\n")
            Base::rh_io_write(path, out)

        def rh_write_manifest(path: cstr, repo: cstr, snap: Scan::RhSnapshot&, ctx: RhReportCtx&) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            out: mutable darray[u8] =
                out: mutable darray[u8] = []
                Base::rh_push_text(out, "repo-health-bundle-manifest 1\ntool: rh_cli 0.1.0\nsource: ")
                Base::rh_push_cstr(out, repo)
                Base::rh_push_text(out, "\nsource-kind: ")
                out
            if ctx.repo_kind == 1:
                Base::rh_push_text(out, "https\n")
            else:
                Base::rh_push_text(out, "local\n")
            Base::rh_push_text(out, "window-days: ")
            Base::rh_push_decimal_i64(out, ctx.window_days)
            Base::rh_push_text(out, "\nfull-history: ")
            if ctx.full_history == 1:
                Base::rh_push_text(out, "true\n")
            else:
                Base::rh_push_text(out, "false\n")
            Base::rh_push_text(out, "evidence-cutoff: ")
            Base::rh_push_decimal_i64(out, ctx.cutoff)
            Base::rh_push_text(out, "\ncommits: ")
            Base::rh_push_decimal_i64(out, snap.commits)
            Base::rh_push_text(out, "\nrejected: ")
            Base::rh_push_decimal_i64(out, snap.rejected)
            Base::rh_push_text(out, "\ndigest-fnv1a64: ")
            Base::rh_push_hex_u64(out, snap.digest)
            Base::rh_push_text(out, "\ndefault-revisions: ")
            Base::rh_push_decimal_i64(out, ctx.default_revisions)
            Base::rh_push_text(out, "\nfiles: evidence/git-log.bin evidence/git-default-count.txt evidence/git-shallow.txt evidence/git-version.txt evidence/git-files.txt evidence/emails.uniq\n")
            Base::rh_io_write(path, out)

        # Parse "digest-fnv1a64: <16 hex>" back out of a manifest. False when absent
        # or malformed (replay then fails closed, never fabricates success).
        def rh_manifest_digest(manifest: darray[u8]&, digest_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
            needle: u8& = "digest-fnv1a64: "
            nn: usize = strlen(needle)
            while pos + nn + 16 <= manifest.count |pos: usize = 0, manifest, nn|:
                hit: bool =
                    while k < nn |hit: bool = true, k: usize = 0, pos| -> hit:
                        if manifest[pos + k] != needle[k]:
                            hit <- false
                        k <- k + 1
                if hit:
                    ok: mutable i64 = 0
                    parsed: u64 = Scan::rh_parse_hex64(manifest, pos + nn, pos + nn + 16, &ok)
                    if ok == 1:
                        digest_out[0] <- parsed
                        return true
                    return false
                pos <- pos + 1
            false

        # Count bot-heuristic lines in a newline-separated email list.
        def rh_count_bot_lines(data: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while start < data.count |total: i64 = 0, start: usize = 0| -> total:
                stop: i64 = Base::rh_find_byte(data, start, 10)
                line_end: usize = stop.usize() if stop >= 0 else data.count
                if line_end > start:
                    if Scan::rh_email_is_bot(data, start, line_end):
                        total <- total + 1
                if stop < 0:
                    start <- data.count
                else:
                    start <- stop.usize() + 1
