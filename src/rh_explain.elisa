# rh_explain.elisa — structured explanation of the pinned M01 report.
#
# This is a read-only projection: it consumes report.json, preserves the
# report's explicit status/reason/value/evidence fields, and adds no verdict.
# Every cell is built from typed JSON nodes; repository prose cannot alter the
# explanation. The output is deterministic Markdown with a version marker.

include "./rh_base.elisa"
include "./rh_json.elisa"

module Explain:
    private:
        def rh_explain_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if obj < 0 or nodes[obj.usize()].kind != Json::RH_JSON_OBJ
            want: usize = strlen(key)
            while child >= 0 |child: i64 = nodes[obj.usize()].first_child, nodes, texts, key, want|:
                kn: Json::RhJsonNode = nodes[child.usize()]
                value: i64 = kn.next_sibling
                if kn.kind == Json::RH_JSON_STR and value >= 0 and kn.text_end - kn.text_start == want.i64():
                    same: mutable bool = true
                    while k < want |k: usize = 0, texts, kn, key|:
                        if texts[(kn.text_start + k.i64()).usize()] != key[k]:
                            same <- false
                        k <- k + 1
                    return value if same
                child <- nodes[value.usize()].next_sibling if value >= 0 else -1
            -1

        def rh_explain_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool:
            return false if s < 0 or e < s or e - s != strlen(lit).i64()
            while i < e - s |i: i64 = 0, texts, s, lit|:
                return false if texts[(s + i).usize()] != lit[i.usize()]
                i <- i + 1
            true

        def rh_explain_cell(out: mutable darray[u8]&, data: darray[u8]&, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
            return if s < 0 or e < s or e > data.count.i64()
            while i < e |i: i64 = s, data, out|:
                b: u8 = data[i.usize()]
                if b == 38:
                    rh_push_text(out, "&amp;")
                elif b == 60:
                    rh_push_text(out, "&lt;")
                elif b == 62:
                    rh_push_text(out, "&gt;")
                elif b == 124:
                    rh_push_text(out, "\\|")
                elif b == 96:
                    rh_push_text(out, "&#96;")
                elif b == 10 or b == 13:
                    out.push(32)
                else:
                    out.push(b)
                i <- i + 1

        def rh_explain_string(out: mutable darray[u8]&, nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Explain::rh_explain_get(nodes, texts, obj, key)
            return false if idx < 0 or nodes[idx.usize()].kind != Json::RH_JSON_STR
            n: Json::RhJsonNode = nodes[idx.usize()]
            Explain::rh_explain_cell(out, texts, n.text_start, n.text_end)
            true

        def rh_explain_scalar(out: mutable darray[u8]&, nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, raw: darray[u8]&, idx: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if idx < 0:
                rh_push_text(out, "unknown")
                return
            n: Json::RhJsonNode = nodes[idx.usize()]
            if n.kind == Json::RH_JSON_STR:
                Explain::rh_explain_cell(out, texts, n.text_start, n.text_end)
            elif n.kind == Json::RH_JSON_NUM:
                Explain::rh_explain_cell(out, raw, n.text_start, n.text_end)
            elif n.kind == Json::RH_JSON_BOOL:
                rh_push_text(out, "true") if Json::rh_json_is_true(nodes, raw, idx)
                rh_push_text(out, "false") if not Json::rh_json_is_true(nodes, raw, idx)
            elif n.kind == Json::RH_JSON_NULL:
                rh_push_text(out, "unknown")
            elif n.kind == Json::RH_JSON_ARR:
                rh_push_text(out, "list")
            else:
                rh_push_text(out, "structured")

        def rh_explain_value(out: mutable darray[u8]&, nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, raw: darray[u8]&, obj: i64) -> void can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Explain::rh_explain_get(nodes, texts, obj, "value")
            if idx < 0:
                rh_push_text(out, "unknown")
                return
            n: Json::RhJsonNode = nodes[idx.usize()]
            if n.kind != Json::RH_JSON_OBJ:
                Explain::rh_explain_scalar(out, nodes, texts, raw, idx)
                return
            num: i64 = Explain::rh_explain_get(nodes, texts, idx, "num")
            den: i64 = Explain::rh_explain_get(nodes, texts, idx, "den")
            if num >= 0 and den >= 0:
                Explain::rh_explain_scalar(out, nodes, texts, raw, num)
                rh_push_text(out, " / ")
                Explain::rh_explain_scalar(out, nodes, texts, raw, den)
                return
            label: i64 = Explain::rh_explain_get(nodes, texts, idx, "label")
            if label >= 0:
                Explain::rh_explain_scalar(out, nodes, texts, raw, label)
                return
            rh_push_text(out, "structured")

        def rh_explain_evidence(out: mutable darray[u8]&, nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, raw: darray[u8]&, arr: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if arr < 0 or nodes[arr.usize()].kind != Json::RH_JSON_ARR:
                rh_push_text(out, "none recorded")
                return
            first: mutable bool = true
            while child >= 0 |child: i64 = nodes[arr.usize()].first_child, nodes, texts, out, first|:
                if not first:
                    rh_push_text(out, ", ")
                first <- false
                Explain::rh_explain_scalar(out, nodes, texts, raw, child)
                child <- nodes[child.usize()].next_sibling
            rh_push_text(out, "none recorded") if first

        def rh_explain_meta_cell(out: mutable darray[u8]&, nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, raw: darray[u8]&, root: i64, key: u8&) -> void can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Explain::rh_explain_get(nodes, texts, root, key)
            if idx < 0:
                rh_push_text(out, "unknown")
            else:
                Explain::rh_explain_scalar(out, nodes, texts, raw, idx)

    public:
        def rh_explain_markdown(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            report: i64 = Explain::rh_explain_get(nodes, texts, root, "report")
            return -1 if report < 0 or nodes[report.usize()].kind != Json::RH_JSON_STR
            report_node: Json::RhJsonNode = nodes[report.usize()]
            return -1 if not Explain::rh_explain_eq(texts, report_node.text_start, report_node.text_end, "repo-health-m01")
            metrics: i64 = Explain::rh_explain_get(nodes, texts, root, "metrics")
            return -1 if metrics < 0 or nodes[metrics.usize()].kind != Json::RH_JSON_ARR
            rh_push_text(out, "# repo-health explanation\n\n<!-- repo-health-explain/1 -->\n\n")
            rh_push_text(out, "This document explains the pinned `repo-health-m01` report. It restates typed observations and evidence references; it adds no health, trust, or safety verdict.\n\n")
            rh_push_text(out, "| field | value |\n|---|---|\n| source | ")
            Explain::rh_explain_meta_cell(out, nodes, texts, raw, root, "source")
            rh_push_text(out, " |\n| source kind | ")
            Explain::rh_explain_meta_cell(out, nodes, texts, raw, root, "source_kind")
            rh_push_text(out, " |\n| evidence cutoff | ")
            Explain::rh_explain_meta_cell(out, nodes, texts, raw, root, "evidence_cutoff")
            rh_push_text(out, " |\n| window days | ")
            Explain::rh_explain_meta_cell(out, nodes, texts, raw, root, "window_days")
            rh_push_text(out, " |\n| full history | ")
            Explain::rh_explain_meta_cell(out, nodes, texts, raw, root, "full_history")
            rh_push_text(out, " |\n| input digest | ")
            Explain::rh_explain_meta_cell(out, nodes, texts, raw, root, "input_digest_fnv1a64")
            rh_push_text(out, " |\n\n## Metrics\n\n| metric | status | reason | value | evidence |\n|---|---|---|---|---|\n")
            while child >= 0 |child: i64 = nodes[metrics.usize()].first_child, nodes, texts, raw, out|:
                return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                key: i64 = Explain::rh_explain_get(nodes, texts, child, "key")
                status: i64 = Explain::rh_explain_get(nodes, texts, child, "status")
                reason: i64 = Explain::rh_explain_get(nodes, texts, child, "reason")
                evidence: i64 = Explain::rh_explain_get(nodes, texts, child, "evidence")
                rh_push_text(out, "| ")
                Explain::rh_explain_scalar(out, nodes, texts, raw, key)
                rh_push_text(out, " | ")
                Explain::rh_explain_scalar(out, nodes, texts, raw, status)
                rh_push_text(out, " | ")
                Explain::rh_explain_scalar(out, nodes, texts, raw, reason)
                rh_push_text(out, " | ")
                Explain::rh_explain_value(out, nodes, texts, raw, child)
                rh_push_text(out, " | ")
                Explain::rh_explain_evidence(out, nodes, texts, raw, evidence)
                rh_push_text(out, " |\n")
                child <- nodes[child.usize()].next_sibling
            rh_push_text(out, "\n## Capabilities\n\n| capability | state |\n|---|---|\n")
            caps: i64 = Explain::rh_explain_get(nodes, texts, root, "capabilities")
            if caps >= 0 and nodes[caps.usize()].kind == Json::RH_JSON_OBJ:
                while cap_key >= 0 |cap_key: i64 = nodes[caps.usize()].first_child, nodes, texts, out|:
                    cap_value: i64 = nodes[cap_key.usize()].next_sibling
                    rh_push_text(out, "| ")
                    Explain::rh_explain_scalar(out, nodes, texts, raw, cap_key)
                    rh_push_text(out, " | ")
                    Explain::rh_explain_scalar(out, nodes, texts, raw, cap_value)
                    rh_push_text(out, " |\n")
                    cap_key <- nodes[cap_value.usize()].next_sibling if cap_value >= 0 else -1
            rh_push_text(out, "\nUnknown is not zero; unavailable, partial, stale, and not_applicable remain distinct. Raw commit authors are not maintainers, and this explanation does not infer authority or a project verdict.\n")
            0
