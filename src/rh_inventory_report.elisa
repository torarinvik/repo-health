# rh_inventory_report.elisa — inventory interchange execution path
# (M03-07 CycloneDX, M08 SPDX-2.3; R027).
#
# Parses a standards-based inventory document and emits an `rh-inventory/1`
# observation. A document whose declared spec version is outside the
# supported set is reported `unsupported` with the reason, never interpreted
# as if it were a known version. `valid != complete`: a well-formed document
# proves only that it parses, not that it lists every dependency — the notice
# says so explicitly. Only SHA-256 digests of the exact hex shape count as
# known digests.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_sha256.elisa"
include "./rh_inventory.elisa"
include "./rh_spdx.elisa"
include "./rh_observation.elisa"

module InventoryReport:
    private:
        def rh_inv_emit_metric(out: mutable darray[u8]&, key: cstr, value: Observation::RhMetricValue, status: u8, reason: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{
                completeness: Observation::RhCompleteness.Complete if status == Observation::RH_ST_OBSERVED else Observation::RhCompleteness.Unknown,
                freshness: Observation::RhFreshness.Unknown,
                validity: Observation::RhValidity.Valid if status == Observation::RH_ST_OBSERVED else Observation::RhValidity.Unknown,
                provenance: Observation::RhProvenanceQuality.EvidenceBacked
            }
            evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
            Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.InventoryInput)
            observation: Observation::RhObservation = Observation::rh_observation_make_with_evidence(status, value, false, quality, evidence)
            Observation::rh_observation_emit_metric(out, key, "1.0.0", reason, observation)

        def rh_inv_emit_count_metric(out: mutable darray[u8]&, key: cstr, count: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_inv_emit_metric(out, key, Observation::RhMetricValue.Count(count), Observation::RH_ST_OBSERVED, "")

        def rh_inv_emit_ratio_metric(out: mutable darray[u8]&, key: cstr, numerator: i64, denominator: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            Observation::rh_ratio_valid(numerator, denominator) and rh_inv_emit_metric(out, key, Observation::RhMetricValue.Ratio(numerator, denominator), Observation::RH_ST_OBSERVED, "")

        def rh_inv_emit_metrics(out: mutable darray[u8]&, component_count: i64, invalid_count: i64, purl_count: i64, hash_count: i64, known_digest_count: i64, unknown_field_count: i64, empty_reason: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            ok: bool = |out|
                Base::rh_push_text(out, "[")
                first: bool = rh_inv_emit_count_metric(out, "inventory.component_count", component_count)
                out.push(44) if first
                second: bool = first and rh_inv_emit_count_metric(out, "inventory.invalid_component_count", invalid_count)
                out.push(44) if second
                third: bool = second and rh_inv_emit_count_metric(out, "inventory.components_with_purl_count", purl_count)
                out.push(44) if third
                fourth: bool = third and rh_inv_emit_count_metric(out, "inventory.components_with_hash_count", hash_count)
                out.push(44) if fourth
                fifth: bool = fourth and rh_inv_emit_count_metric(out, "inventory.known_digest_count", known_digest_count)
                out.push(44) if fifth
                sixth: bool = fifth and (rh_inv_emit_ratio_metric(out, "provenance.artifact_digest_present_share", hash_count, component_count) if component_count > 0 else rh_inv_emit_metric(out, "provenance.artifact_digest_present_share", Observation::RhMetricValue.Absent, Observation::RH_ST_NOT_APPLICABLE, empty_reason))
                out.push(44) if sixth
                seventh: bool = sixth and rh_inv_emit_count_metric(out, "inventory.unknown_field_count", unknown_field_count)
                Base::rh_push_text(out, "]")
                seventh
            ok

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_inv_emit_span(out: mutable darray[u8]&, pool: darray[u8]&, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if s >= 0 and e >= s and e <= pool.count.i64():
                Base::rh_json_escape(out, pool, s.usize(), e.usize())

        # Copy a span of the decoded texts buffer into pool; returns the start
        # offset in pool. (private to this file)
        def rh_inv_pool_copy(pool: mutable darray[u8]&, texts: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            Base::rh_absorb_span(texts, s, e, pool)

        # Bind each normalized observation to the exact retained source bytes.
        # Hash the locator instead of publishing it so query tokens and local
        # paths do not become part of a public report.
        def rh_inv_provenance(raw: darray[u8]&, source_url: cstr, has_url: bool, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, ",\"provenance\":{\"input_sha256\":\"")
            Sha256::rh_sha256(raw, out)
            Base::rh_push_text(out, "\",\"origin\":\"")
            Base::rh_push_text(out, "captured_url" if has_url else "local_input")
            Base::rh_push_text(out, "\",\"locator_sha256\":")
            if has_url:
                locator: mutable darray[u8] =
                    locator: mutable darray[u8] = []
                    Base::rh_push_cstr(locator, source_url)
                    locator
                Base::rh_push_text(out, "\"")
                Sha256::rh_sha256(locator, out)
                out.push(34)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, "}")

        def rh_inv_completeness(compositions: darray[Inventory::RhBomComposition]&, pool: darray[u8]&, bom: Inventory::RhBom, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, ",\"completeness\":{\"dependency_assertions\":{\"state\":\"")
            Base::rh_push_text(out, "not_asserted" if bom.dependency_composition_count == 0 else "declared")
            Base::rh_push_text(out, "\",\"count\":")
            Base::rh_push_decimal_i64(out, bom.dependency_composition_count)
            Base::rh_push_text(out, ",\"complete\":")
            Base::rh_push_decimal_i64(out, bom.dependency_complete_count)
            Base::rh_push_text(out, ",\"incomplete\":")
            Base::rh_push_decimal_i64(out, bom.dependency_incomplete_count)
            Base::rh_push_text(out, ",\"unknown\":")
            Base::rh_push_decimal_i64(out, bom.dependency_unknown_count)
            Base::rh_push_text(out, ",\"not_specified\":")
            Base::rh_push_decimal_i64(out, bom.dependency_not_specified_count)
            Base::rh_push_text(out, "},\"compositions\":[")
            while i < compositions.count.i64() |i: i64 = 0, compositions, pool, out|:
                c: Inventory::RhBomComposition = compositions[i.usize()]
                if i > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"aggregate\":\"")
                rh_inv_emit_span(out, pool, c.aggregate_s, c.aggregate_e)
                Base::rh_push_text(out, "\",\"assemblies\":")
                Base::rh_push_decimal_i64(out, c.assemblies)
                Base::rh_push_text(out, ",\"dependencies\":")
                Base::rh_push_decimal_i64(out, c.dependencies)
                Base::rh_push_text(out, ",\"vulnerabilities\":")
                Base::rh_push_decimal_i64(out, c.vulnerabilities)
                out.push(125)
                i <- i + 1
            Base::rh_push_text(out, "]}")

        # Extract a top-level string field (spec version) into pool; span in pool.
        # (private to this file)
        def rh_inv_spec_version(raw: darray[u8]&, key: u8&, pool: mutable darray[u8]&, s_out: mutable i64&, e_out: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            idx: i64 = |s_out, e_out, nodes, texts|
                root: i64 = Json::rh_json_parse(raw, nodes, texts)
                s_out[0] <- -1
                e_out[0] <- -1
                return if root < 0
                block_result: i64 = Json::rh_json_obj_get(nodes, texts, root, key)
                block_result
            return if idx < 0
            ss: mutable i64 = 0
            se: mutable i64 = 0
            if Json::rh_json_str_span(nodes, idx, &ss, &se):
                start: i64 = rh_inv_pool_copy(pool, texts, ss, se)
                s_out[0] <- start
                e_out[0] <- pool.count.i64()

        # CycloneDX. Returns 0 observed, 1 unsupported-spec (report written),
        # -1 not a CycloneDX document.
        def rh_inv_cyclonedx(raw: darray[u8]&, source_url: cstr, has_url: bool, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            pool: mutable darray[u8] = []
            comps: mutable darray[Inventory::RhBomComponent] = []
            composition_assertions: mutable darray[Inventory::RhBomComposition] = []
            bom: mutable Inventory::RhBom = Inventory::RhBom{ok: 0, spec_unsupported: 0, component_count: 0, invalid_components: 0, with_purl: 0, with_hash: 0, digest_known: 0, unknown_top_keys: 0, dependency_composition_count: 0, dependency_complete_count: 0, dependency_incomplete_count: 0, dependency_unknown_count: 0, dependency_not_specified_count: 0}
            return -1 if Inventory::rh_bom_parse(raw, pool, comps, composition_assertions, &bom) != 0
            sv_s: mutable i64 = -1
            sv_e: mutable i64 = -1
            rh_inv_spec_version(raw, "specVersion", pool, &sv_s, &sv_e)
            Base::rh_push_text(out, "{\"schema\":\"rh-inventory/1\",\"format\":\"cyclonedx\",\"spec_version\":\"")
            rh_inv_emit_span(out, pool, sv_s, sv_e)
            out.push(34)
            rh_inv_provenance(raw, source_url, has_url, out)
            Base::rh_push_text(out, ",\"status\":\"")
            if bom.spec_unsupported == 1:
                Base::rh_push_text(out, "unsupported\",\"reason\":\"spec-version-not-in-declared-supported-set\"")
            else:
                Base::rh_push_text(out, "observed\",\"counts\":{\"components\":")
                Base::rh_push_decimal_i64(out, bom.component_count)
                Base::rh_push_text(out, ",\"invalid\":")
                Base::rh_push_decimal_i64(out, bom.invalid_components)
                Base::rh_push_text(out, ",\"with_purl\":")
                Base::rh_push_decimal_i64(out, bom.with_purl)
                Base::rh_push_text(out, ",\"with_hash\":")
                Base::rh_push_decimal_i64(out, bom.with_hash)
                Base::rh_push_text(out, ",\"digest_known\":")
                Base::rh_push_decimal_i64(out, bom.digest_known)
                Base::rh_push_text(out, ",\"unknown_top_keys\":")
                Base::rh_push_decimal_i64(out, bom.unknown_top_keys)
                Base::rh_push_text(out, "},\"components\":[")
                while i < comps.count.i64() |i: i64 = 0, comps, pool, out|:
                    c: Inventory::RhBomComponent = comps[i.usize()]
                    if i > 0:
                        out.push(44)
                    Base::rh_push_text(out, "{\"name\":\"")
                    rh_inv_emit_span(out, pool, c.name_s, c.name_e)
                    Base::rh_push_text(out, "\",\"version\":\"")
                    rh_inv_emit_span(out, pool, c.version_s, c.version_e)
                    Base::rh_push_text(out, "\",\"purl\":\"")
                    rh_inv_emit_span(out, pool, c.purl_s, c.purl_e)
                    Base::rh_push_text(out, "\",\"digest_known\":")
                    if c.valid_sha256 > 0:
                        Base::rh_push_text(out, "true")
                    else:
                        Base::rh_push_text(out, "false")
                    Base::rh_push_text(out, "}")
                    i <- i + 1
                Base::rh_push_text(out, "]")
                rh_inv_completeness(composition_assertions, pool, bom, out)
                Base::rh_push_text(out, ",\"metrics\":")
                return -1 if not InventoryReport::rh_inv_emit_metrics(out, bom.component_count, bom.invalid_components, bom.with_purl, bom.with_hash, bom.digest_known, bom.unknown_top_keys, "no-parsed-components")
            Base::rh_push_text(out, ",\"note\":\"valid != complete: a well-formed document proves it parses, not that every dependency is listed\"}")
            return 1 if bom.spec_unsupported == 1
            0

        # SPDX 2.3. Returns 0 observed, 1 unsupported-spec (report written),
        # -1 not an SPDX document.
        def rh_inv_spdx(raw: darray[u8]&, source_url: cstr, has_url: bool, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            pool: mutable darray[u8] = []
            pkgs: mutable darray[Spdx::RhSpdxPackage] = []
            spdx: mutable Spdx::RhSpdx = Spdx::RhSpdx{ok: 0, spec_unsupported: 0, packages: 0, invalid_packages: 0, with_purl: 0, with_hash: 0, digest_known: 0, unknown_top_keys: 0}
            return -1 if Spdx::rh_spdx_parse(raw, pool, pkgs, &spdx) != 0
            sv_s: mutable i64 = -1
            sv_e: mutable i64 = -1
            rh_inv_spec_version(raw, "spdxVersion", pool, &sv_s, &sv_e)
            Base::rh_push_text(out, "{\"schema\":\"rh-inventory/1\",\"format\":\"spdx\",\"spec_version\":\"")
            rh_inv_emit_span(out, pool, sv_s, sv_e)
            out.push(34)
            rh_inv_provenance(raw, source_url, has_url, out)
            Base::rh_push_text(out, ",\"status\":\"")
            if spdx.spec_unsupported == 1:
                Base::rh_push_text(out, "unsupported\",\"reason\":\"spec-version-not-in-declared-supported-set\"")
            else:
                Base::rh_push_text(out, "observed\",\"counts\":{\"packages\":")
                Base::rh_push_decimal_i64(out, spdx.packages)
                Base::rh_push_text(out, ",\"invalid\":")
                Base::rh_push_decimal_i64(out, spdx.invalid_packages)
                Base::rh_push_text(out, ",\"with_purl\":")
                Base::rh_push_decimal_i64(out, spdx.with_purl)
                Base::rh_push_text(out, ",\"with_hash\":")
                Base::rh_push_decimal_i64(out, spdx.with_hash)
                Base::rh_push_text(out, ",\"digest_known\":")
                Base::rh_push_decimal_i64(out, spdx.digest_known)
                Base::rh_push_text(out, ",\"unknown_top_keys\":")
                Base::rh_push_decimal_i64(out, spdx.unknown_top_keys)
                Base::rh_push_text(out, "},\"components\":[")
                while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool, out|:
                    p: Spdx::RhSpdxPackage = pkgs[i.usize()]
                    if i > 0:
                        out.push(44)
                    Base::rh_push_text(out, "{\"name\":\"")
                    rh_inv_emit_span(out, pool, p.name_s, p.name_e)
                    Base::rh_push_text(out, "\",\"version\":\"")
                    rh_inv_emit_span(out, pool, p.version_s, p.version_e)
                    Base::rh_push_text(out, "\",\"purl\":\"")
                    rh_inv_emit_span(out, pool, p.purl_s, p.purl_e)
                    Base::rh_push_text(out, "\",\"digest_known\":")
                    if p.valid_sha256 > 0:
                        Base::rh_push_text(out, "true")
                    else:
                        Base::rh_push_text(out, "false")
                    Base::rh_push_text(out, "}")
                    i <- i + 1
                Base::rh_push_text(out, "]")
                Base::rh_push_text(out, ",\"completeness\":{\"dependency_assertions\":{\"state\":\"not_asserted\",\"count\":0,\"complete\":0,\"incomplete\":0,\"unknown\":0,\"not_specified\":0},\"compositions\":[]}")
                Base::rh_push_text(out, ",\"metrics\":")
                return -1 if not InventoryReport::rh_inv_emit_metrics(out, spdx.packages, spdx.invalid_packages, spdx.with_purl, spdx.with_hash, spdx.digest_known, spdx.unknown_top_keys, "no-parsed-packages")
            Base::rh_push_text(out, ",\"note\":\"valid != complete: a well-formed document proves it parses, not that every dependency is listed\"}")
            return 1 if spdx.spec_unsupported == 1
            0

        # format: 0 cyclonedx, 1 spdx.
    public:
        const RH_INVENTORY_MAX_BYTES: i64 = 67108864
        def rh_inventory_report(raw: darray[u8]&, format: u8, source_url: cstr, has_url: bool, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if raw.count.i64() > RH_INVENTORY_MAX_BYTES
            return rh_inv_cyclonedx(raw, source_url, has_url, out) if format == 0
            rh_inv_spdx(raw, source_url, has_url, out)
