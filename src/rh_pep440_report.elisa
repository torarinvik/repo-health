# rh_pep440_report.elisa — Python/PEP 440 version semantics execution path
# (M08 ecosystems lane).
#
# Turns an `rh-pep440-input/1` list of version strings into
# `rh-pep440-result/1`: per-version parse details and a deterministic
# ascending order over the VALID versions only. SemVer is deliberately not
# applied — epoch, arbitrary release segments, a/b/rc pre-releases (with
# alpha/beta/c aliases), post, dev, and local are ordered per PEP 440.
# Invalid versions are reported `valid:false` and are NEVER compared or
# sorted (their order would be meaningless). Malformed input fails closed.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_pep440.elisa"

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pr_pool_copy(pool: mutable darray[u8]&, texts: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    start: i64 = pool.count.i64()
    k: mutable i64 = s
    while k < e |k, texts, pool, e|:
        pool.push(texts[k.usize()])
        k <- k + 1
    return start

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pr_emit(out: mutable darray[u8]&, pool: darray[u8]&, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
    if s >= 0 and e >= s and e <= pool.count.i64():
        rh_json_escape(out, pool, s.usize(), e.usize())

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pr_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: i64 = e - s
    k: mutable i64 = 0
    while k < n |k, texts, lit, s|:
        if lit[k.usize()] == 0:
            return false
        if texts[(s + k).usize()] != lit[k.usize()]:
            return false
        k <- k + 1
    return lit[n.usize()] == 0

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pr_pre_label(rank: i64) -> u8&:
    if rank == RH_PEP_PRE_DEV_ONLY:
        return "dev_only"
    if rank == RH_PEP_PRE_A:
        return "a"
    if rank == RH_PEP_PRE_B:
        return "b"
    if rank == RH_PEP_PRE_RC:
        return "rc"
    return "none"

def rh_pep440_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = rh_json_parse(raw, nodes, texts)
    if root < 0 or nodes[root.usize()].kind != RH_JSON_OBJ:
        return -1
    sc_idx: i64 = rh_json_obj_get(nodes, texts, root, "schema")
    sc_s: mutable i64 = 0
    sc_e: mutable i64 = 0
    if sc_idx < 0 or not rh_json_str_span(nodes, sc_idx, &sc_s, &sc_e):
        return -1
    if not rh_pr_eq(texts, sc_s, sc_e, "rh-pep440-input/1"):
        return -1
    vs_idx: i64 = rh_json_obj_get(nodes, texts, root, "versions")
    if vs_idx < 0 or nodes[vs_idx.usize()].kind != RH_JSON_ARR:
        return -1
    pool: mutable darray[u8] = []
    starts: mutable darray[i64] = []
    ends: mutable darray[i64] = []
    parsed: mutable darray[RhPep440] = []
    arr: RhJsonNode = nodes[vs_idx.usize()]
    child: mutable i64 = arr.first_child
    while child >= 0 |child, nodes, texts, pool, starts, ends, parsed|:
        ss: mutable i64 = 0
        se: mutable i64 = 0
        if not rh_json_str_span(nodes, child, &ss, &se):
            return -1
        v: RhPep440 = rh_pep440_parse(texts, ss, se)
        pstart: i64 = rh_pr_pool_copy(pool, texts, ss, se)
        starts.push(pstart)
        ends.push(pool.count.i64())
        parsed.push(v)
        child <- nodes[child.usize()].next_sibling
    # Ascending order over valid versions only (stable insertion sort).
    order: mutable darray[i64] = []
    i: mutable i64 = 0
    while i < parsed.count.i64() |i, parsed, order|:
        p: RhPep440 = parsed[i.usize()]
        if p.ok == 1:
            order.push(i)
        i <- i + 1
    a: mutable i64 = 1
    while a < order.count.i64() |a, order, parsed|:
        key: i64 = order[a.usize()]
        kb: RhPep440 = parsed[key.usize()]
        j: mutable i64 = a
        while j > 0 |j, order, parsed, kb|:
            pb: RhPep440 = parsed[order[(j - 1).usize()].usize()]
            if rh_pep440_cmp(&pb, &kb) <= 0:
                break
            order[j.usize()] <- order[(j - 1).usize()]
            j <- j - 1
        order[j.usize()] <- key
        a <- a + 1

    rh_push_text(out, "{\"schema\":\"rh-pep440-result/1\",\"versions\":[")
    v2: mutable i64 = 0
    while v2 < parsed.count.i64() |v2, parsed, starts, ends, pool, out|:
        p2: RhPep440 = parsed[v2.usize()]
        if v2 > 0:
            out.push(44)
        rh_push_text(out, "{\"version\":\"")
        rh_pr_emit(out, pool, starts[v2.usize()], ends[v2.usize()])
        rh_push_text(out, "\",\"valid\":")
        if p2.ok == 1:
            rh_push_text(out, "true")
        else:
            rh_push_text(out, "false")
        if p2.ok == 1:
            rh_push_text(out, ",\"epoch\":")
            rh_push_decimal_i64(out, p2.epoch)
            rh_push_text(out, ",\"release\":[")
            r: mutable i64 = 0
            while r < p2.n |r, p2, out|:
                if r > 0:
                    out.push(44)
                rh_push_decimal_i64(out, rh_pep_field(&p2, r))
                r <- r + 1
            rh_push_text(out, "],\"pre_rank\":\"")
            rh_push_text(out, rh_pr_pre_label(p2.pre_rank))
            rh_push_text(out, "\",\"pre_num\":")
            if p2.pre_rank == RH_PEP_PRE_A or p2.pre_rank == RH_PEP_PRE_B or p2.pre_rank == RH_PEP_PRE_RC:
                rh_push_decimal_i64(out, p2.pre_num)
            else:
                rh_push_text(out, "null")
            rh_push_text(out, ",\"post\":")
            if p2.post < 0:
                rh_push_text(out, "null")
            else:
                rh_push_decimal_i64(out, p2.post)
            rh_push_text(out, ",\"dev\":")
            if p2.dev == RH_PEP_DEV_ABSENT:
                rh_push_text(out, "null")
            else:
                rh_push_decimal_i64(out, p2.dev)
            rh_push_text(out, ",\"has_local\":")
            if p2.local >= 0:
                rh_push_text(out, "true")
            else:
                rh_push_text(out, "false")
        rh_push_text(out, "}")
        v2 <- v2 + 1
    rh_push_text(out, "],\"sorted\":[")
    s2: mutable i64 = 0
    while s2 < order.count.i64() |s2, order, starts, ends, pool, out|:
        if s2 > 0:
            out.push(44)
        rh_push_text(out, "\"")
        k2: i64 = order[s2.usize()]
        rh_pr_emit(out, pool, starts[k2.usize()], ends[k2.usize()])
        rh_push_text(out, "\"")
        s2 <- s2 + 1
    rh_push_text(out, "],\"note\":\"ascending order covers VALID versions only; invalid versions are never compared; epoch/release/pre/post/dev/local are ordered per PEP 440, not SemVer; local-segment ordering is presence-only\"}")
    return 0
