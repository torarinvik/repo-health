# rh_pep440_report.elisa — Python/PEP 440 version semantics execution path
# (M08 ecosystems lane).
#
# Turns an `rh-pep440-input/1` list of version strings into
# `rh-pep440-result/1`: per-version parse details and a deterministic
# ascending order over the VALID versions only. SemVer is deliberately not
# applied — epoch, arbitrary release segments, a/b/rc pre-releases (with
# alpha/beta/c aliases), post, dev, and local are ordered per PEP 440.
# Invalid versions are reported `valid:false` and are NEVER compared or
# sorted (their order would be meaningless). Malformed input fails closed.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_pep440.elisa"

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pr_pool_copy(pool: mutable darray[u8]&, texts: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    start: i64 = pool.count.i64()
    while k < e |k: i64 = s, texts, pool, e|:
        pool.push(texts[k.usize()])
        k <- k + 1
    start

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pr_emit(out: mutable darray[u8]&, pool: darray[u8]&, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
    if s >= 0 and e >= s and e <= pool.count.i64():
        Base::rh_json_escape(out, pool, s.usize(), e.usize())

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pr_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    Base::rh_bytes_equal_literal(texts, s, e, lit)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pr_pre_label(rank: i64) -> u8&:
    return "dev_only" if rank == RH_PEP_PRE_DEV_ONLY
    return "a" if rank == RH_PEP_PRE_A
    return "b" if rank == RH_PEP_PRE_B
    return "rc" if rank == RH_PEP_PRE_RC
    "none"

def rh_pep440_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    vs_idx: i64 = |nodes, texts|
        root: i64 = Json::rh_json_parse(raw, nodes, texts)
        return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
        sc_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
        sc_s: mutable i64 = 0
        sc_e: mutable i64 = 0
        return -1 if sc_idx < 0 or not Json::rh_json_str_span(nodes, sc_idx, &sc_s, &sc_e)
        return -1 if not rh_pr_eq(texts, sc_s, sc_e, "rh-pep440-input/1")
        block_result: i64 = Json::rh_json_obj_get(nodes, texts, root, "versions")
        block_result
    return -1 if vs_idx < 0 or nodes[vs_idx.usize()].kind != Json::RH_JSON_ARR
    pool: mutable darray[u8] = []
    starts: mutable darray[i64] = []
    ends: mutable darray[i64] = []
    parsed: mutable darray[RhPep440] = []
    arr: Json::RhJsonNode = nodes[vs_idx.usize()]
    while child >= 0 |child: i64 = arr.first_child, nodes, texts, pool, starts, ends, parsed|:
        ss: mutable i64 = 0
        se: mutable i64 = 0
        return -1 if not Json::rh_json_str_span(nodes, child, &ss, &se)
        v: RhPep440 = rh_pep440_parse(texts, ss, se)
        pstart: i64 = rh_pr_pool_copy(pool, texts, ss, se)
        starts.push(pstart)
        ends.push(pool.count.i64())
        parsed.push(v)
        child <- nodes[child.usize()].next_sibling
    # Ascending order over valid versions only (stable insertion sort).
    order: mutable darray[i64] = []
    while i < parsed.count.i64() |i: i64 = 0, parsed, order|:
        p: RhPep440 = parsed[i.usize()]
        if p.ok == 1:
            order.push(i)
        i <- i + 1
    while a < order.count.i64() |a: i64 = 1, order, parsed|:
        key: i64 = order[a.usize()]
        kb: RhPep440 = parsed[key.usize()]
        j: i64 =
            while j > 0 |j: i64 = a, order, parsed| -> j:
                pb: RhPep440 = parsed[order[(j - 1).usize()].usize()]
                break if rh_pep440_cmp(&pb, &kb) <= 0
                order[j.usize()] <- order[(j - 1).usize()]
                j <- j - 1
        order[j.usize()] <- key
        a <- a + 1

    Base::rh_push_text(out, "{\"schema\":\"rh-pep440-result/1\",\"versions\":[")
    while v2 < parsed.count.i64() |v2: i64 = 0, parsed, starts, ends, pool, out|:
        p2: RhPep440 = parsed[v2.usize()]
        if v2 > 0:
            out.push(44)
        Base::rh_push_text(out, "{\"version\":\"")
        rh_pr_emit(out, pool, starts[v2.usize()], ends[v2.usize()])
        Base::rh_push_text(out, "\",\"valid\":")
        if p2.ok == 1:
            Base::rh_push_text(out, "true")
        else:
            Base::rh_push_text(out, "false")
        if p2.ok == 1:
            Base::rh_push_text(out, ",\"epoch\":")
            Base::rh_push_decimal_i64(out, p2.epoch)
            Base::rh_push_text(out, ",\"release\":[")
            while r < p2.n |r: i64 = 0, p2, out|:
                if r > 0:
                    out.push(44)
                Base::rh_push_decimal_i64(out, rh_pep_field(&p2, r))
                r <- r + 1
            Base::rh_push_text(out, "],\"pre_rank\":\"")
            Base::rh_push_text(out, rh_pr_pre_label(p2.pre_rank))
            Base::rh_push_text(out, "\",\"pre_num\":")
            if p2.pre_rank == RH_PEP_PRE_A or p2.pre_rank == RH_PEP_PRE_B or p2.pre_rank == RH_PEP_PRE_RC:
                Base::rh_push_decimal_i64(out, p2.pre_num)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, ",\"post\":")
            if p2.post < 0:
                Base::rh_push_text(out, "null")
            else:
                Base::rh_push_decimal_i64(out, p2.post)
            Base::rh_push_text(out, ",\"dev\":")
            if p2.dev == RH_PEP_DEV_ABSENT:
                Base::rh_push_text(out, "null")
            else:
                Base::rh_push_decimal_i64(out, p2.dev)
            Base::rh_push_text(out, ",\"has_local\":")
            if p2.local >= 0:
                Base::rh_push_text(out, "true")
            else:
                Base::rh_push_text(out, "false")
        Base::rh_push_text(out, "}")
        v2 <- v2 + 1
    Base::rh_push_text(out, "],\"sorted\":[")
    while s2 < order.count.i64() |s2: i64 = 0, order, starts, ends, pool, out|:
        if s2 > 0:
            out.push(44)
        Base::rh_push_text(out, "\"")
        k2: i64 = order[s2.usize()]
        rh_pr_emit(out, pool, starts[k2.usize()], ends[k2.usize()])
        Base::rh_push_text(out, "\"")
        s2 <- s2 + 1
    Base::rh_push_text(out, "],\"note\":\"ascending order covers VALID versions only; invalid versions are never compared; epoch/release/pre/post/dev/local are ordered per PEP 440, not SemVer; local-segment ordering is presence-only\"}")
    0
