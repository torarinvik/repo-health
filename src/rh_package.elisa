include "./rh_sha256.elisa"

module Package:
    public:
        # rh_package.elisa — package identities, ecosystems, resolved graphs, OSV
        # matching (M03; Cargo + npm reference pair).
        #
        # Coordinates keep registry identity, namespace, normalized and raw names,
        # and ecosystem-native versions distinct (M03-01). Source identity remains
        # separate from ecosystem and name, so equal name/version pairs from two
        # registries remain distinct nodes. Version labels and artifact digests are separate fields everywhere
        # (a digest change under one label is a new artifact, M03-02). Dependency
        # REQUIREMENTS (manifest strings) never become exact edges without
        # resolution evidence; ambiguous Cargo name matches stay unresolved with
        # an explicit reason (M03-03/04, R009). Version comparison is ecosystem-
        # native semver implemented once and documented per-eco (M03 admission).
        # No resolver is executed: resolution is read from lockfiles, and anything
        # computed hypothetically would be labeled, never stored as observed.

        const RH_ECO_CARGO: u8 = 0
        const RH_ECO_NPM: u8 = 1
        const RH_ECO_PYPI: u8 = 2
        const RH_ECO_GO: u8 = 3
        const RH_ECO_RUBYGEMS: u8 = 4
        const RH_ECO_COMPOSER: u8 = 5
        const RH_ECO_NUGET: u8 = 6
        const RH_ECO_MAVEN: u8 = 7

        const RH_PSRC_REGISTRY: u8 = 0
        const RH_PSRC_PATH: u8 = 1
        const RH_PSRC_GIT: u8 = 2
        const RH_PSRC_UNKNOWN: u8 = 3

        const RH_SCOPE_NORMAL: u8 = 0
        const RH_SCOPE_DEV: u8 = 1
        const RH_SCOPE_OPTIONAL: u8 = 2
        const RH_SCOPE_PEER: u8 = 3
        # A declared dependency whose group/scope is not recorded in the source
        # format (Gemfile.lock's DEPENDENCIES block omits Gemfile groups): the
        # scope is genuinely UNKNOWN and must not be guessed as runtime or dev.
        const RH_SCOPE_DECLARED: u8 = 4

        # M03-02 artifact identity outcome. A version LABEL is not an artifact:
        # the same label with different bytes is a NEW artifact and must be
        # re-evaluated, never silently treated as the previously seen one (F024).
        const RH_ART_UNKNOWN: i64 = 0
        const RH_ART_MATCH: i64 = 1
        const RH_ART_CHANGED: i64 = 2
        const RH_ART_KIND_ARCHIVE: u8 = 0
        const RH_ART_KIND_MODULE: u8 = 1
        const RH_ART_KIND_GO_MOD: u8 = 2
        const RH_ART_KIND_NUGET_CONTENT: u8 = 3

        # Compare an expected digest against an observed digest for one version
        # label. Either side missing => UNKNOWN (never a match). known flags are
        # 1/0; digests are 128-bit split halves.
        def rh_artifact_identity(expected_known: i64, exp_hi: u64, exp_lo: u64, observed_known: i64, obs_hi: u64, obs_lo: u64) -> i64:
            return RH_ART_UNKNOWN if expected_known != 1 or observed_known != 1
            return RH_ART_MATCH if exp_hi == obs_hi and exp_lo == obs_lo
            RH_ART_CHANGED

        # True when the observed bytes constitute a distinct artifact from the
        # expectation. UNKNOWN is NOT distinct (it is unknown), MATCH is not.
        def rh_artifact_is_distinct(state: i64) -> bool:
            state == RH_ART_CHANGED

        # M03-05 repository-claim state. A declared source link is an ASSERTION,
        # not identity (R008/F023): absent evidence it stays unverified, and any
        # conflicting evidence makes it conflicted. Only reviewed verification
        # promotes it, and even then it is not the package identity.
        const RH_CLAIM_NONE: i64 = 0
        const RH_CLAIM_UNVERIFIED: i64 = 1
        const RH_CLAIM_VERIFIED: i64 = 2
        const RH_CLAIM_CONFLICTED: i64 = 3

        def rh_repo_claim_state(claimed: bool, verified_evidence: bool, conflicting_evidence: bool) -> i64:
            return RH_CLAIM_CONFLICTED if conflicting_evidence
            return RH_CLAIM_VERIFIED if verified_evidence
            return RH_CLAIM_UNVERIFIED if claimed
            RH_CLAIM_NONE

        # Only a verified claim may be used as a repository assertion; conflicted
        # and unverified claims must not be silently treated as identity.
        def rh_repo_claim_is_identity(state: i64) -> bool:
            state == RH_CLAIM_VERIFIED

        # OSV ecosystem identifiers per package ecosystem (mapping table, M03-08).
        def rh_osv_ecosystem(eco: u8) -> u8&:
            return "crates.io" if eco == RH_ECO_CARGO
            return "PyPI" if eco == RH_ECO_PYPI
            return "Go" if eco == RH_ECO_GO
            return "RubyGems" if eco == RH_ECO_RUBYGEMS
            return "Packagist" if eco == RH_ECO_COMPOSER
            return "NuGet" if eco == RH_ECO_NUGET
            return "Maven" if eco == RH_ECO_MAVEN
            "npm"

    private:
        # Cargo name equality: ASCII case-insensitive, '-' and '_' equivalent
        # (registry rule). Everything else is byte-exact.
        def rh_cargo_name_eq(pool: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if e1 - s1 != e2 - s2
            while k < e1 - s1 |k: usize = 0, pool, s1, s2|:
                a: mutable u8 = pool[s1 + k]
                b: mutable u8 = pool[s2 + k]
                if a >= 65 and a <= 90:
                    a <- a + 32
                if b >= 65 and b <= 90:
                    b <- b + 32
                if a == 95:
                    a <- 45
                if b == 95:
                    b <- 45
                return false if a != b
                k <- k + 1
            true

        def rh_name_eq(eco: u8, pool: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return rh_cargo_name_eq(pool, s1, e1, s2, e2) if eco == RH_ECO_CARGO
            return rh_pypi_name_eq(pool, s1, e1, s2, e2) if eco == RH_ECO_PYPI
            return rh_go_name_eq(pool, s1, e1, s2, e2) if eco == RH_ECO_GO
            return rh_nuget_name_eq(pool, s1, e1, s2, e2) if eco == RH_ECO_NUGET
            return false if e1 - s1 != e2 - s2
            while k < e1 - s1 |k: usize = 0, pool, s1, s2|:
                return false if pool[s1 + k] != pool[s2 + k]
                k <- k + 1
            true

        # NuGet package IDs are compared case-insensitively by the client ecosystem;
        # punctuation remains significant. Preserve the raw spelling in graph output.
        def rh_nuget_name_eq(pool: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if e1 - s1 != e2 - s2
            while k < e1 - s1 |k: usize = 0, pool, s1, s2|:
                a: mutable u8 = pool[s1 + k]
                b: mutable u8 = pool[s2 + k]
                a <- a + 32 if a >= 65 and a <= 90
                b <- b + 32 if b >= 65 and b <= 90
                return false if a != b
                k <- k + 1
            true

        # PyPI (PEP 503) name equality: ASCII case-insensitive with '-', '_' and '.'
        # treated as equivalent separators. Runs are not collapsed in this slice.
        def rh_pypi_name_eq(pool: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if e1 - s1 != e2 - s2
            while k < e1 - s1 |k: usize = 0, pool, s1, s2|:
                a: mutable u8 = pool[s1 + k]
                b: mutable u8 = pool[s2 + k]
                if a >= 65 and a <= 90:
                    a <- a + 32
                if b >= 65 and b <= 90:
                    b <- b + 32
                if a == 95 or a == 46:
                    a <- 45
                if b == 95 or b == 46:
                    b <- 45
                return false if a != b
                k <- k + 1
            true

        # --- Semver (ecosystem-native: strict, no leading zeros, prerelease and
        # build parsed; build ignored in precedence; one leading 'v' tolerated
        # for npm spellings). Spans index the caller's buffer; prerelease span
        # is -1/-1 when absent.
    public:
        struct RhSemver:
            major: mutable i64
            minor: mutable i64
            patch: mutable i64
            pre_s: mutable i64
            pre_e: mutable i64

    private:
        def rh_sem_digits(data: darray[u8]&, s: usize, e: usize, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            ok_out[0] <- 0
            return 0 if s >= e
            return 0 if data[s] < 48 or data[s] > 57
            return 0 if e - s > 1 and data[s] == 48
            acc: i64 =
                while k < e |acc: i64 = 0, k: usize = s| -> acc:
                    b: u8 = data[k]
                    return 0 if b < 48 or b > 57
                    return 0 if acc > 9223372036854775807 / 10
                    acc <- acc * 10
                    return 0 if acc > 9223372036854775807 - (b - 48).i64()
                    acc <- acc + (b - 48).i64()
                    k <- k + 1
            ok_out[0] <- 1
            acc

        # First of '.', '-', '+' at/after pos, or end. Bounds every version span.
        def rh_span_end(data: darray[u8]&, pos: usize, end: usize) -> usize can[Memory.Allocate, Abort.Panic]:
            m: mutable usize = end
            d: i64 = Base::rh_find_byte(data, pos, 46)
            if d >= 0 and d.usize() < m and d.usize() >= pos:
                m <- d.usize()
            p: i64 = Base::rh_find_byte(data, pos, 45)
            if p >= 0 and p.usize() < m and p.usize() >= pos:
                m <- p.usize()
            b: i64 = Base::rh_find_byte(data, pos, 43)
            if b >= 0 and b.usize() < m and b.usize() >= pos:
                m <- b.usize()
            m

    public:
        def rh_semver_parse(data: darray[u8]&, s: usize, e: usize, v: mutable RhSemver&) -> bool can[Memory.Allocate, Abort.Panic]:
            v.major <- 0
            v.minor <- 0
            v.patch <- 0
            v.pre_s <- -1
            v.pre_e <- -1
            return false if s >= e
            cur: mutable usize = s
            if data[cur] == 118:
                cur <- cur + 1
                return false if cur >= e
            me: usize = rh_span_end(data, cur, e)
            ok1: mutable i64 = 0
            major: i64 = rh_sem_digits(data, cur, me, &ok1)
            return false if ok1 == 0
            v.major <- major
            cur <- me
            if cur < e and data[cur] == 46:
                cur <- cur + 1
                me2: usize = rh_span_end(data, cur, e)
                ok2: mutable i64 = 0
                minor: i64 = rh_sem_digits(data, cur, me2, &ok2)
                return false if ok2 == 0
                v.minor <- minor
                cur <- me2
            if cur < e and data[cur] == 46:
                cur <- cur + 1
                me3: usize = rh_span_end(data, cur, e)
                ok3: mutable i64 = 0
                patch: i64 = rh_sem_digits(data, cur, me3, &ok3)
                return false if ok3 == 0
                v.patch <- patch
                cur <- me3
            if cur < e and data[cur] == 45:
                cur <- cur + 1
                pe: mutable usize = e
                bb: i64 = Base::rh_find_byte(data, cur, 43)
                if bb >= 0 and bb.usize() < pe and bb.usize() >= cur:
                    pe <- bb.usize()
                return false if pe <= cur
                return false if not rh_pre_valid(data, cur, pe)
                v.pre_s <- cur.i64()
                v.pre_e <- pe.i64()
                cur <- pe
            if cur < e and data[cur] == 43:
                cur <- cur + 1
                return false if cur >= e
                return false if not rh_pre_valid(data, cur, e)
                cur <- e
            return false if cur != e
            true

    private:
        # Dot-separated identifiers, each [0-9A-Za-z-]+ and non-empty.
        def rh_pre_valid(data: darray[u8]&, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s >= e
            need: bool =
                while k < e |need: bool = true, k: usize = s| -> need:
                    b: u8 = data[k]
                    if b == 46:
                        return false if need
                        need <- true
                    elif (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 45:
                        need <- false
                    else:
                        return false
                    k <- k + 1
            not need

        def rh_ident_is_num(data: darray[u8]&, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s >= e
            while k < e |k: usize = s, data|:
                return false if data[k] < 48 or data[k] > 57
                k <- k + 1
            true

        # Compare identifier spans: numeric < alphanumeric; numerics by length
        # then lexically (exact for any width); alphanumerics ASCII.
        def rh_ident_cmp(data: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            n1: bool = rh_ident_is_num(data, s1, e1)
            n2: bool = rh_ident_is_num(data, s2, e2)
            return -1 if n1 and not n2
            return 1 if n2 and not n1
            if n1 and n2:
                if e1 - s1 != e2 - s2:
                    return -1 if e1 - s1 < e2 - s2
                    return 1
            k: mutable usize = 0
            len: mutable usize = e1 - s1
            if e2 - s2 < len:
                len <- e2 - s2
            while k < len |k, data, s1, s2|:
                if data[s1 + k] != data[s2 + k]:
                    return -1 if data[s1 + k] < data[s2 + k]
                    return 1
                k <- k + 1
            if e1 - s1 != e2 - s2:
                return -1 if e1 - s1 < e2 - s2
                return 1
            0

        # Full precedence: -1/0/1. data holds both spans (same or pooled buffer).
        def rh_semver_cmp(data: darray[u8]&, a: RhSemver&, b: RhSemver&) -> i64 can[Memory.Allocate, Abort.Panic]:
            if a.major != b.major:
                return -1 if a.major < b.major
                return 1
            if a.minor != b.minor:
                return -1 if a.minor < b.minor
                return 1
            if a.patch != b.patch:
                return -1 if a.patch < b.patch
                return 1
            a_pre: bool = a.pre_s >= 0
            b_pre: bool = b.pre_s >= 0
            return 0 if not a_pre and not b_pre
            return -1 if a_pre and not b_pre
            return 1 if b_pre and not a_pre
            ai: mutable usize = a.pre_s.usize()
            bi: mutable usize = b.pre_s.usize()
            ae: usize = a.pre_e.usize()
            be: usize = b.pre_e.usize()
            while true |ai, bi, data, ae, be|:
                a_end: usize =
                    while q < ae |a_end: usize = ae, q: usize = ai| -> a_end:
                        if data[q] == 46:
                            a_end <- q
                            q <- ae
                        else:
                            q <- q + 1
                b_end: usize =
                    while r < be |b_end: usize = be, r: usize = bi| -> b_end:
                        if data[r] == 46:
                            b_end <- r
                            r <- be
                        else:
                            r <- r + 1
                c: i64 = rh_ident_cmp(data, ai, a_end, bi, b_end)
                return c if c != 0
                a_done: bool = a_end >= ae
                b_done: bool = b_end >= be
                return 0 if a_done and b_done
                return -1 if a_done
                return 1 if b_done
                ai <- a_end + 1
                bi <- b_end + 1
            0

    public:
        # --- Package graph model (M03-01/02/06). Node identities are
        # (ecosystem, source kind + source locator, normalized name, version);
        # the pool owns every string so spans stay valid for the graph lifetime.
        # Retained source locators are fingerprinted in output, never emitted raw.
        # Edges are
        # RESOLVED (exact from/to indices); anything unresolvable is an
        # RhUnresolved with a reason, never a guessed edge (R009).
        struct RhPkgNode:
            eco: mutable u8
            name_s: mutable i64
            name_e: mutable i64
            ver_s: mutable i64
            ver_e: mutable i64
            origin_s: mutable i64
            origin_e: mutable i64
            src_kind: mutable u8
            has_digest: mutable u8
            dig_s: mutable i64
            dig_e: mutable i64
            framework_s: mutable i64
            framework_e: mutable i64
            dev: mutable u8
            optional: mutable u8

        struct RhDepEdge:
            from: mutable i64
            dst: mutable i64
            depctx: mutable u8
            optional: mutable u8

        struct RhUnresolved:
            from: mutable i64
            name_s: mutable i64
            name_e: mutable i64
            req_s: mutable i64
            req_e: mutable i64
            reason: mutable u8
            optional: mutable u8

        struct RhArtifact:
            package_node: mutable i64
            kind: mutable u8
            expected_s: mutable i64
            expected_e: mutable i64
            observed_s: mutable i64
            observed_e: mutable i64

        struct RhRequire:
            from: mutable i64
            name_s: mutable i64
            name_e: mutable i64
            ver_s: mutable i64
            ver_e: mutable i64
            src_s: mutable i64
            src_e: mutable i64
            req_s: mutable i64
            req_e: mutable i64
            depctx: mutable u8
            optional: mutable u8

        # Unresolved reasons: 0 no candidate, 1 ambiguous (multiple versions),
        # 2 unsupported context (local/git/deleted refs we do not resolve here).
        const RH_UNRES_MISSING: u8 = 0
        const RH_UNRES_AMBIGUOUS: u8 = 1
        const RH_UNRES_CONTEXT: u8 = 2

        def rh_pool_copy(pool: mutable darray[u8]&, data: darray[u8]&, s: usize, e: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            start: i64 = pool.count.i64()
            while k < e |k: usize = s, pool, data|:
                pool.push(data[k])
                k <- k + 1
            start

        def rh_node_add(pkgs: mutable darray[RhPkgNode]&, eco: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if pkgs.count.i64() > 100000
            pkgs.push(RhPkgNode{eco: eco, name_s: -1, name_e: -1, ver_s: -1, ver_e: -1, origin_s: -1, origin_e: -1, src_kind: 3, has_digest: 0, dig_s: -1, dig_e: -1, framework_s: -1, framework_e: -1, dev: 0, optional: 0})
            pkgs.count.i64() - 1

        def rh_artifact_add_expected(artifacts: mutable darray[RhArtifact]&, package_node: i64, kind: u8, expected_s: i64, expected_e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if package_node < 0 or expected_s < 0 or expected_e <= expected_s
            return -1 if artifacts.count.i64() >= 200000
            artifacts.push(RhArtifact{package_node: package_node, kind: kind, expected_s: expected_s, expected_e: expected_e, observed_s: -1, observed_e: -1})
            (artifacts.count - 1).i64()

        def rh_artifacts_from_packages(pkgs: darray[RhPkgNode]&, artifacts: mutable darray[RhArtifact]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |made: i64 = 0, i: i64 = 0, artifacts| -> made:
                package: RhPkgNode = pkgs[i.usize()]
                if package.has_digest != 0:
                    kind: u8 = RH_ART_KIND_MODULE if package.eco == RH_ECO_GO else RH_ART_KIND_ARCHIVE
                    return -1 if rh_artifact_add_expected(artifacts, i, kind, package.dig_s, package.dig_e) < 0
                    made <- made + 1
                i <- i + 1

        def rh_artifact_set_observed(artifacts: mutable darray[RhArtifact]&, pool: darray[u8]&, artifact_id: i64, observed_s: i64, observed_e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if artifact_id < 0 or artifact_id >= artifacts.count.i64()
            return false if observed_s < 0 or observed_e <= observed_s or observed_e > pool.count.i64()
            artifact: mutable RhArtifact = artifacts[artifact_id.usize()]
            artifact.observed_s <- observed_s
            artifact.observed_e <- observed_e
            artifacts[artifact_id.usize()] <- artifact
            true

        def rh_artifact_identity_state(artifacts: darray[RhArtifact]&, pool: darray[u8]&, artifact_id: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return RH_ART_UNKNOWN if artifact_id < 0 or artifact_id >= artifacts.count.i64()
            artifact: RhArtifact = artifacts[artifact_id.usize()]
            return RH_ART_UNKNOWN if artifact.expected_s < 0 or artifact.observed_s < 0
            return RH_ART_MATCH if rh_span_eq2(pool, artifact.expected_s.usize(), artifact.expected_e.usize(), pool, artifact.observed_s.usize(), artifact.observed_e.usize())
            RH_ART_CHANGED

    private:
        # Exact node match (all coordinates incl. source kind).
        def rh_node_find(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, eco: u8, ns: usize, ne: usize, vs: usize, ve: usize, skind: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool|:
                n: RhPkgNode = pkgs[i.usize()]
                if n.eco == eco and n.src_kind == skind:
                    if rh_name_eq(eco, pool, n.name_s.usize(), n.name_e.usize(), ns, ne):
                        return i if rh_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, vs, ve)
                i <- i + 1
            -1

        # Byte-exact span equality across (possibly distinct) buffers.
        def rh_span_eq2(a: darray[u8]&, s1: usize, e1: usize, b: darray[u8]&, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_span(a, s1.i64(), e1.i64(), b, s2.i64(), e2.i64())

        # --- Cargo.lock subset parser (M03-03/04). Reads [[package]] tables with
        # name/version/source/checksum/dependencies. Well-formed lines with
        # unknown keys are counted (unsupported intact); malformed lines fail the
        # whole parse (fail closed — no half-resolved graph). Returns the package
        # count, or -1 on malformed input.
        def rh_toml_key(line: darray[u8]&, s: usize, e: usize, ks: mutable i64&, ke: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            i: mutable usize =
                while i < e |i: usize = s| -> i:
                    break if line[i] != 32 and line[i] != 9
                    i <- i + 1
            start: usize = i
            while i < e |i, line|:
                b: u8 = line[i]
                if (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95 or b == 45:
                    i <- i + 1
                else:
                    break
            return false if i == start
            ks[0] <- start.i64()
            ke[0] <- i.i64()
            while i < e |i, line|:
                break if line[i] != 32 and line[i] != 9
                i <- i + 1
            return false if i >= e or line[i] != 61
            true

        # Quoted basic string at pos (pos points at '"'). Decodes \" and \\.
        def rh_quoted_span(line: darray[u8]&, pos: usize, e: usize, pool: mutable darray[u8]&, vs: mutable i64&, ve: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if pos >= e or line[pos] != 34
            i: mutable usize = pos + 1
            start: i64 = pool.count.i64()
            while i < e |i, line, pool|:
                b: u8 = line[i]
                if b == 34:
                    vs[0] <- start
                    ve[0] <- pool.count.i64()
                    return (i + 1).i64()
                if b == 92:
                    i <- i + 1
                    return -1 if i >= e
                    e2: u8 = line[i]
                    if e2 == 34 or e2 == 92:
                        pool.push(e2)
                    else:
                        return -1
                    i <- i + 1
                    continue
                pool.push(b)
                i <- i + 1
            -1

        def rh_span_lit(data: darray[u8]&, s: usize, e: usize, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = strlen(lit)
            return false if e - s != n
            while k < n |k: usize = 0, data, s, lit|:
                return false if data[s + k] != lit[k]
                k <- k + 1
            true

    public:
        def rh_cargo_parse(lock: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            unknown_out[0] <- 0
            parsed_count: i64 = while pos < lock.count |count: i64 = 0, cur: i64 = -1, in_deps: bool = false, top_level: bool = true, lock_version_seen: bool = false, root_seen: bool = false, pos: usize = 0, pkgs, pool, reqs, unknown_out| -> count:
                lend: usize =
                    nl: i64 = Base::rh_find_byte(lock, pos, 10)
                    nl.usize() if nl >= 0 else lock.count
                ts: mutable i64 = 0
                te: mutable i64 = 0
                rh_trim_span(lock, pos, lend, &ts, &te)
                if te > ts:
                    if lock[ts.usize()] == 35:
                        pos <- lend + 1
                        continue
                    if lock[ts.usize()] == 91:
                        top_level <- false
                        in_deps <- false
                        if rh_span_lit(lock, ts.usize(), te.usize(), "[[package]]"):
                            cur <- rh_node_add(pkgs, 0)
                            return -1 if cur < 0
                            count <- count + 1
                        elif rh_span_lit(lock, ts.usize(), te.usize(), "[root]"):
                            return -1 if root_seen
                            root_seen <- true
                            cur <- rh_node_add(pkgs, 0)
                            return -1 if cur < 0
                            count <- count + 1
                        else:
                            cur <- -1
                        pos <- lend + 1
                        continue
                    if in_deps:
                        after: i64 = rh_cargo_dep_line(lock, ts.usize(), te.usize(), pool, cur, reqs, in_deps)
                        return -1 if after < 0
                        if after == 0:
                            in_deps <- false
                        pos <- lend + 1
                        continue
                    if cur < 0:
                        if top_level and rh_span_prefix(lock, ts.usize(), te.usize(), "version"):
                            ks_root: mutable i64 = 0
                            ke_root: mutable i64 = 0
                            return -1 if not rh_toml_key(lock, ts.usize(), te.usize(), &ks_root, &ke_root)
                            if rh_span_lit(lock, ks_root.usize(), ke_root.usize(), "version"):
                                return -1 if lock_version_seen
                                lock_view: mutable darray[u8]& = lock
                                version_pos: usize =
                                    while version_pos < te.usize() |version_pos: usize = ke_root.usize(), lock_view| -> version_pos:
                                        break if lock_view[version_pos] != 32 and lock_view[version_pos] != 9 and lock_view[version_pos] != 61
                                        version_pos <- version_pos + 1
                                return -1 if version_pos >= te.usize() or (lock_view[version_pos] != 51 and lock_view[version_pos] != 52)
                                format_version: i64 = (lock_view[version_pos] - 48).i64()
                                version_end: usize = version_pos + 1
                                while version_end < te.usize() |version_end: usize = version_pos + 1, lock_view|:
                                    if lock_view[version_end] == 35:
                                        break
                                    return -1 if lock_view[version_end] != 32 and lock_view[version_end] != 9
                                    version_end <- version_end + 1
                                return -1 if format_version != 3 and format_version != 4
                                lock_version_seen <- true
                        pos <- lend + 1
                        continue
                    ks: mutable i64 = 0
                    ke: mutable i64 = 0
                    return -1 if not rh_toml_key(lock, ts.usize(), te.usize(), &ks, &ke)
                    if rh_span_lit(lock, ks.usize(), ke.usize(), "name"):
                        vs: mutable i64 = 0
                        ve: mutable i64 = 0
                        return -1 if rh_toml_qstring(lock, ke.usize(), te.usize(), pool, &vs, &ve) < 0
                        node: mutable RhPkgNode = pkgs[cur.usize()]
                        node.name_s <- vs
                        node.name_e <- ve
                        pkgs[cur.usize()] <- node
                    elif rh_span_lit(lock, ks.usize(), ke.usize(), "version"):
                        vs2: mutable i64 = 0
                        ve2: mutable i64 = 0
                        return -1 if rh_toml_qstring(lock, ke.usize(), te.usize(), pool, &vs2, &ve2) < 0
                        node2: mutable RhPkgNode = pkgs[cur.usize()]
                        node2.ver_s <- vs2
                        node2.ver_e <- ve2
                        pkgs[cur.usize()] <- node2
                    elif rh_span_lit(lock, ks.usize(), ke.usize(), "source"):
                        vs3: mutable i64 = 0
                        ve3: mutable i64 = 0
                        return -1 if rh_toml_qstring(lock, ke.usize(), te.usize(), pool, &vs3, &ve3) < 0
                        node3: mutable RhPkgNode = pkgs[cur.usize()]
                        node3.src_kind <- rh_cargo_src_kind(pool, vs3.usize(), ve3.usize())
                        node3.origin_s <- vs3
                        node3.origin_e <- ve3
                        pkgs[cur.usize()] <- node3
                    elif rh_span_lit(lock, ks.usize(), ke.usize(), "checksum"):
                        vs4: mutable i64 = 0
                        ve4: mutable i64 = 0
                        return -1 if rh_toml_qstring(lock, ke.usize(), te.usize(), pool, &vs4, &ve4) < 0
                        return -1 if not rh_cargo_checksum_valid(pool, vs4, ve4)
                        node4: mutable RhPkgNode = pkgs[cur.usize()]
                        node4.has_digest <- 1
                        node4.dig_s <- vs4
                        node4.dig_e <- ve4
                        pkgs[cur.usize()] <- node4
                    elif rh_span_lit(lock, ks.usize(), ke.usize(), "dependencies"):
                        di: mutable usize =
                            while di < te.usize() |di: usize = ke.usize()| -> di:
                                break if lock[di] != 32 and lock[di] != 9 and lock[di] != 61
                                di <- di + 1
                        return -1 if di >= te.usize() or lock[di] != 91
                        di <- di + 1
                        after2: i64 = rh_cargo_dep_line(lock, di, te.usize(), pool, cur, reqs, in_deps)
                        return -1 if after2 < 0
                        if after2 == 0:
                            in_deps <- false
                        else:
                            in_deps <- true
                    else:
                        unknown_out[0] <- unknown_out[0] + 1
                pos <- lend + 1

            return -1 if parsed_count < 0 or not rh_cargo_nodes_valid(pkgs)
            metadata_unknown: i64 = rh_cargo_metadata_checksums(lock, pkgs, pool)
            return -1 if metadata_unknown < 0
            unknown_out[0] <- unknown_out[0] + metadata_unknown
            parsed_count

    private:
        def rh_cargo_nodes_valid(pkgs: darray[RhPkgNode]&) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs|:
                node: RhPkgNode = pkgs[i.usize()]
                return false if node.name_s < 0 or node.name_e <= node.name_s or node.ver_s < 0 or node.ver_e <= node.ver_s
                i <- i + 1
            true

        def rh_cargo_checksum_valid(pool: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if start < 0 or end - start != 64 or end > pool.count.i64()
            while i < 64 |i: i64 = 0, pool, start|:
                b: u8 = pool[(start + i).usize()]
                is_digit: bool = b >= 48 and b <= 57
                is_lower_hex: bool = b >= 97 and b <= 102
                is_upper_hex: bool = b >= 65 and b <= 70
                return false if not is_digit and not is_lower_hex and not is_upper_hex
                i <- i + 1
            true

        # Parse dependency entries in [s, e). Returns 1 when the list stays open
        # (no ']' seen), 0 when closed, -1 malformed. in_deps echoes the mode
        # for the caller's convenience (unused internally).
        def rh_cargo_dep_line(line: darray[u8]&, s: usize, e: usize, pool: mutable darray[u8]&, cur: i64, reqs: mutable darray[RhRequire]&, in_deps: bool) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < e |i: usize = s, line, pool, cur, reqs|:
                b: u8 = line[i]
                if b == 32 or b == 9 or b == 44:
                    i <- i + 1
                    continue
                return 0 if b == 93
                return -1 if b != 34
                vs: mutable i64 = 0
                ve: mutable i64 = 0
                nxt: i64 = rh_quoted_span(line, i, e, pool, &vs, &ve)
                return -1 if nxt < 0
                i <- nxt.usize()
                nm_e: mutable usize = ve.usize()
                k: mutable usize =
                    while k < ve.usize() |k: usize = vs.usize(), pool| -> k:
                        break if pool[k] == 32
                        k <- k + 1
                nm_e <- k
                ver_s: mutable i64 = -1
                ver_e: mutable i64 = -1
                src_s: mutable i64 = -1
                src_e: mutable i64 = -1
                if k < ve.usize():
                    rest: mutable usize =
                        while rest < ve.usize() |rest: usize = k + 1, pool| -> rest:
                            break if pool[rest] != 32
                            rest <- rest + 1
                    if rest < ve.usize() and pool[rest] == 40:
                        src_s <- (rest + 1).i64()
                        src_e <- ve
                        return -1 if pool[ve.usize() - 1] != 41
                        src_e <- (ve.usize() - 1).i64()
                    else:
                        vend: usize =
                            while vend < ve.usize() |vend: usize = rest, pool| -> vend:
                                break if pool[vend] == 32 or pool[vend] == 40
                                vend <- vend + 1
                        ver_s <- rest.i64()
                        ver_e <- vend.i64()
                        source_pos: usize =
                            while source_pos < ve.usize() |source_pos: usize = vend, pool| -> source_pos:
                                break if pool[source_pos] != 32
                                source_pos <- source_pos + 1
                        if source_pos < ve.usize() and pool[source_pos] == 40:
                            return -1 if pool[ve.usize() - 1] != 41
                            src_s <- (source_pos + 1).i64()
                            src_e <- (ve.usize() - 1).i64()
                req: RhRequire = RhRequire{from: cur, name_s: vs, name_e: nm_e.i64(), ver_s: ver_s, ver_e: ver_e, src_s: src_s, src_e: src_e, req_s: -1, req_e: -1, depctx: 0, optional: 0}
                reqs.push(req)
            1

        # Quoted basic string value after "key =": skip spaces, expect '=', then
        # a quoted span (\" and \\ escapes; anything else fails closed).
        def rh_toml_qstring(line: darray[u8]&, pos: usize, e: usize, pool: mutable darray[u8]&, vs: mutable i64&, ve: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            i: mutable usize =
                while i < e |i: usize = pos| -> i:
                    break if line[i] != 32 and line[i] != 9
                    i <- i + 1
            return -1 if i >= e or line[i] != 61
            i <- i + 1
            while i < e |i, line|:
                break if line[i] != 32 and line[i] != 9
                i <- i + 1
            rh_quoted_span(line, i, e, pool, vs, ve)

        # Append an edge unless the identical (from, to, depctx) triple exists.
        def rh_edge_add(edges: mutable darray[RhDepEdge]&, from: i64, dst: i64, depctx: u8, optional: u8) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < edges.count.i64() |i: i64 = 0, edges, from, dst, depctx|:
                e: RhDepEdge = edges[i.usize()]
                if e.from == from and e.dst == dst and e.depctx == depctx:
                    if optional != 0 and e.optional == 0:
                        e.optional <- optional
                        edges[i.usize()] <- e
                    return false
                i <- i + 1
            edges.push(RhDepEdge{from: from, dst: dst, depctx: depctx, optional: optional})
            true

        # Resolve Cargo requirements to exact edges. A package ID's version and
        # source are both identity fields; omitting either can merge registry
        # copies of the same crate. Bare names resolve only when one candidate
        # remains (R009).
    public:
        def rh_cargo_resolve(pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while r < reqs.count |made: i64 = 0, r: usize = 0, pkgs, pool, edges, unresolved| -> made:
                q: RhRequire = reqs[r]
                first, count =
                    while n < pkgs.count.i64() |first: i64 = -1, count: i64 = 0, n: i64 = 0, pkgs, pool| -> first, count:
                        nd: RhPkgNode = pkgs[n.usize()]
                        if nd.eco == 0 and rh_name_eq(0, pool, nd.name_s.usize(), nd.name_e.usize(), q.name_s.usize(), q.name_e.usize()):
                            version_matches: bool = q.ver_s < 0 or (nd.ver_s >= 0 and rh_span_eq2(pool, nd.ver_s.usize(), nd.ver_e.usize(), pool, q.ver_s.usize(), q.ver_e.usize()))
                            source_matches: bool = q.src_s < 0 or (nd.origin_s >= 0 and rh_span_eq2(pool, nd.origin_s.usize(), nd.origin_e.usize(), pool, q.src_s.usize(), q.src_e.usize()))
                            if version_matches and source_matches:
                                if first < 0:
                                    first <- n
                                count <- count + 1
                        n <- n + 1
                if count == 0:
                    unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.ver_s, req_e: q.ver_e, reason: 0, optional: 0})
                elif count == 1:
                    if rh_edge_add(edges, q.from, first, 0, q.optional):
                        made <- made + 1
                else:
                    unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.ver_s, req_e: q.ver_e, reason: 1, optional: 0})
                r <- r + 1

    private:
        def rh_cargo_src_kind(pool: darray[u8]&, s: usize, e: usize) -> u8 can[Memory.Allocate, Abort.Panic]:
            return RH_PSRC_REGISTRY if rh_span_prefix(pool, s, e, "registry+")
            return RH_PSRC_REGISTRY if rh_span_prefix(pool, s, e, "sparse+")
            return 2 if rh_span_prefix(pool, s, e, "git+")
            return 1 if rh_span_prefix(pool, s, e, "path+")
            3

        def rh_span_prefix(pool: darray[u8]&, s: usize, e: usize, prefix: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = strlen(prefix)
            return false if e - s < n
            while k < n |k: usize = 0, pool, s, prefix|:
                return false if pool[s + k] != prefix[k]
                k <- k + 1
            true

        def rh_trim_span(line: darray[u8]&, s: usize, e: usize, os: mutable i64&, oe: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            a: usize =
                while a < e |a: usize = s| -> a:
                    break if line[a] != 32 and line[a] != 9 and line[a] != 13
                    a <- a + 1
            b: usize =
                while b > a |b: usize = e| -> b:
                    break if line[b - 1] != 32 and line[b - 1] != 9 and line[b - 1] != 13
                    b <- b - 1
            os[0] <- a.i64()
            oe[0] <- b.i64()

        # --- npm lock/package parsers (M03-03/04). lockfileVersion 2/3 "packages"
        # maps plus legacy v1 "dependencies" trees, plus package.json requirement
        # maps (dependencies/dev/peer/optional). Resolution is Node-style
        # directory walk-up over install paths; link:true entries resolve as
        # path-kind pkgs; entries without versions fail the parse except links
        # (recorded unresolved, reason 2). Requirement STRINGS are preserved
        # verbatim in req_s/req_e and never treated as resolved versions (R009).

    private:
        # pnpm's package table identifies the artifact while each snapshot
        # keeps its full peer-suffixed dependency path. The latter is graph
        # resolution context, not part of the published version label.
        struct RhPnpmPackage:
            name_s: mutable i64
            name_e: mutable i64
            ver_s: mutable i64
            ver_e: mutable i64
            origin_s: mutable i64
            origin_e: mutable i64
            digest_s: mutable i64
            digest_e: mutable i64
            src_kind: mutable u8

        struct RhPnpmSnapshot:
            key_s: mutable i64
            key_e: mutable i64
            node: mutable i64

        # Yarn Classic lock selectors resolve requirements by the exact
        # name/range descriptor written by Yarn. These spans stay private to
        # this adapter; graph consumers receive only package nodes and edges.
        struct RhYarnSelector:
            node: mutable i64
            name_s: mutable i64
            name_e: mutable i64
            req_s: mutable i64
            req_e: mutable i64

        def rh_yarn_selector_split(pool: darray[u8]&, s: usize, e: usize, name_s: mutable i64&, name_e: mutable i64&, req_s: mutable i64&, req_e: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s >= e
            delimiter: usize =
                if pool[s] == 64:
                    slash: usize =
                        while k < e |k: usize = s + 1| -> k:
                            break if pool[k] == 47
                            k <- k + 1
                    return false if slash >= e
                    while k < e |k: usize = slash + 1| -> k:
                        break if pool[k] == 64
                        k <- k + 1
                else:
                    while k < e |k: usize = s| -> k:
                        break if pool[k] == 64
                        k <- k + 1
            return false if delimiter <= s or delimiter + 1 >= e
            name_s[0] <- s.i64()
            name_e[0] <- delimiter.i64()
            req_s[0] <- (delimiter + 1).i64()
            req_e[0] <- e.i64()
            return false if rh_span_prefix(pool, req_s[0].usize(), req_e[0].usize(), "npm:")
            true

        def rh_yarn_has_space(data: darray[u8]&, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < e |i: usize = s|:
                return true if data[i] == 32 or data[i] == 9 or data[i] == 13
                i <- i + 1
            false

        def rh_yarn_selector_source(pool: darray[u8]&, s: usize, e: usize) -> u8 can[Memory.Allocate, Abort.Panic]:
            return RH_PSRC_GIT if rh_span_prefix(pool, s, e, "git+") or rh_span_prefix(pool, s, e, "git://") or rh_span_prefix(pool, s, e, "github:")
            return RH_PSRC_PATH if rh_span_prefix(pool, s, e, "file:") or rh_span_prefix(pool, s, e, "link:") or rh_span_prefix(pool, s, e, "workspace:")
            RH_PSRC_UNKNOWN

        # One quoted or unquoted scalar token; quoted values use the same
        # bounded escape grammar as the TOML parser. `next_out` marks the first
        # byte after the token so callers can require an exact line shape.
        def rh_yarn_token(line: darray[u8]&, s: usize, e: usize, pool: mutable darray[u8]&, value_s: mutable i64&, value_e: mutable i64&, next_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            i: mutable usize = s
            while i < e:
                break if line[i] != 32 and line[i] != 9
                i <- i + 1
            return false if i >= e
            if line[i] == 34:
                next: i64 = rh_quoted_span(line, i, e, pool, value_s, value_e)
                return false if next < 0
                next_out[0] <- next
            else:
                start: usize = i
                while i < e |i|:
                    break if line[i] == 32 or line[i] == 9
                    return false if line[i] == 34 or line[i] == 39
                    i <- i + 1
                return false if i == start
                value_s[0] <- rh_pool_copy(pool, line, start, i)
                value_e[0] <- pool.count.i64()
                next_out[0] <- i.i64()
            true

        # Decode a selector list from one Yarn v1 header, append its exact
        # descriptor mappings, and create the associated resolved package node.
        # Unsupported aliases and duplicate selectors fail closed.
        def rh_yarn_entry_header(line: darray[u8]&, s: usize, e: usize, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, selectors: mutable darray[RhYarnSelector]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if e <= s or line[e - 1] != 58
            key_end: usize = e - 1
            node: mutable i64 = -1
            first_name_s: mutable i64 = -1
            first_name_e: mutable i64 = -1
            first_selector_source: mutable u8 = RH_PSRC_UNKNOWN
            segment_s: mutable usize = s
            quoted: mutable bool = false
            escaped: mutable bool = false
            while i <= key_end |i: usize = s, pool, selectors, pkgs, node, first_name_s, first_name_e, first_selector_source, segment_s, quoted, escaped|:
                split: mutable bool = i == key_end
                if i < key_end:
                    b: u8 = line[i]
                    if quoted and escaped:
                        escaped <- false
                    elif quoted and b == 92:
                        escaped <- true
                    elif b == 34:
                        quoted <- not quoted
                    elif b == 44 and not quoted:
                        split <- true
                if split:
                    a: mutable i64 = 0
                    z: mutable i64 = 0
                    rh_trim_span(line, segment_s, i, &a, &z)
                    return -1 if z <= a
                    selector_s: mutable i64 = 0
                    selector_e: mutable i64 = 0
                    if line[a.usize()] == 34:
                        next: mutable i64 = rh_quoted_span(line, a.usize(), z.usize(), pool, &selector_s, &selector_e)
                        return -1 if next < 0
                        while next.usize() < z.usize() |next|:
                            break if line[next.usize()] != 32 and line[next.usize()] != 9
                            next <- next + 1
                        return -1 if next.usize() != z.usize()
                    else:
                        selector_s <- rh_pool_copy(pool, line, a.usize(), z.usize())
                        selector_e <- pool.count.i64()
                        return -1 if rh_yarn_has_space(pool, selector_s.usize(), selector_e.usize())
                    name_s: mutable i64 = 0
                    name_e: mutable i64 = 0
                    req_s: mutable i64 = 0
                    req_e: mutable i64 = 0
                    return -1 if not rh_yarn_selector_split(pool, selector_s.usize(), selector_e.usize(), &name_s, &name_e, &req_s, &req_e)
                    selector_source: u8 = rh_yarn_selector_source(pool, req_s.usize(), req_e.usize())
                    if node < 0:
                        node <- rh_node_add(pkgs, RH_ECO_NPM)
                        return -1 if node < 0
                        first_name_s <- name_s
                        first_name_e <- name_e
                        first_selector_source <- selector_source
                        package: mutable RhPkgNode = pkgs[node.usize()]
                        package.name_s <- name_s
                        package.name_e <- name_e
                        package.src_kind <- selector_source
                        pkgs[node.usize()] <- package
                    else:
                        return -1 if not rh_span_eq2(pool, first_name_s.usize(), first_name_e.usize(), pool, name_s.usize(), name_e.usize())
                        return -1 if selector_source != first_selector_source
                    return -1 if selectors.count.i64() >= 200000
                    return -1 if rh_yarn_selector_duplicate(selectors, pool, name_s.usize(), name_e.usize(), req_s.usize(), req_e.usize())
                    selectors.push(RhYarnSelector{node: node, name_s: name_s, name_e: name_e, req_s: req_s, req_e: req_e})
                    segment_s <- i + 1
                i <- i + 1
            return -1 if quoted or escaped or node < 0
            node

        def rh_yarn_selector_duplicate(selectors: darray[RhYarnSelector]&, pool: darray[u8]&, name_s: usize, name_e: usize, req_s: usize, req_e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < selectors.count.i64() |i: i64 = 0|:
                existing: RhYarnSelector = selectors[i.usize()]
                same: bool = rh_span_eq2(pool, existing.name_s.usize(), existing.name_e.usize(), pool, name_s, name_e) and rh_span_eq2(pool, existing.req_s.usize(), existing.req_e.usize(), pool, req_s, req_e)
                return true if same
                i <- i + 1
            false

        # YAML scalar subset used by pnpm v9. Single quotes follow YAML's
        # doubled-quote escape; double quotes use the existing bounded decoder.
        def rh_pnpm_scalar(line: darray[u8]&, s: usize, e: usize, pool: mutable darray[u8]&, value_s: mutable i64&, value_e: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            trimmed_s: mutable i64 = 0
            trimmed_e: mutable i64 = 0
            rh_trim_span(line, s, e, &trimmed_s, &trimmed_e)
            a: usize = trimmed_s.usize()
            b: usize = trimmed_e.usize()
            return false if b <= a
            if line[a] == 34:
                after: i64 = rh_quoted_span(line, a, b, pool, value_s, value_e)
                return false if after < 0 or after.usize() != b
                return true
            if line[a] == 39:
                start: i64 = pool.count.i64()
                return false if b < a + 2 or line[b - 1] != 39
                while i < b - 1 |i: usize = a + 1, pool, line, b|:
                    if line[i] == 39:
                        return false if i + 1 >= b - 1 or line[i + 1] != 39
                        pool.push(39)
                        i <- i + 2
                    else:
                        pool.push(line[i])
                        i <- i + 1
                value_s[0] <- start
                value_e[0] <- pool.count.i64()
                return true
            plain_end: usize =
                while i < b |i: usize = a| -> i:
                    if line[i] == 35 and i > a and (line[i - 1] == 32 or line[i - 1] == 9):
                        break
                    i <- i + 1
            return false if plain_end <= a
            value_s[0] <- rh_pool_copy(pool, line, a, plain_end)
            value_e[0] <- pool.count.i64()
            true

        # Split one YAML mapping line at its structural colon. Colons inside a
        # quoted key or URL value are not separators.
        def rh_pnpm_pair(line: darray[u8]&, s: usize, e: usize, pool: mutable darray[u8]&, key_s: mutable i64&, key_e: mutable i64&, value_s: mutable i64&, value_e: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            quoted: mutable u8 = 0
            escaped: mutable bool = false
            colon: mutable i64 = -1
            while i < e |i: usize = s, quoted, escaped, colon, line|:
                b: u8 = line[i]
                if quoted == 34 and escaped:
                    escaped <- false
                elif quoted == 34 and b == 92:
                    escaped <- true
                elif quoted != 0 and b == quoted:
                    if quoted == 39 and i + 1 < e and line[i + 1] == 39:
                        i <- i + 1
                    else:
                        quoted <- 0
                elif quoted == 0 and (b == 34 or b == 39):
                    quoted <- b
                elif quoted == 0 and b == 58 and (i + 1 == e or line[i + 1] == 32 or line[i + 1] == 9):
                    colon <- i.i64()
                    i <- e
                i <- i + 1
            return false if quoted != 0 or escaped or colon < 0
            return false if not rh_pnpm_scalar(line, s, colon.usize(), pool, key_s, key_e)
            raw_value_s: mutable i64 = 0
            raw_value_e: mutable i64 = 0
            rh_trim_span(line, colon.usize() + 1, e, &raw_value_s, &raw_value_e)
            value_s[0] <- raw_value_s
            value_e[0] <- raw_value_e
            true

        def rh_pnpm_snapshot_match(pool: darray[u8]&, snapshot: RhPnpmSnapshot, name_s: usize, name_e: usize, ver_s: usize, ver_e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if snapshot.key_s < 0 or snapshot.key_e <= snapshot.key_s or name_e <= name_s or ver_e <= ver_s
            key_s: usize = snapshot.key_s.usize()
            key_e: usize = snapshot.key_e.usize()
            return false if key_e - key_s != (name_e - name_s) + 1 + (ver_e - ver_s)
            return false if not rh_span_eq2(pool, key_s, key_s + (name_e - name_s), pool, name_s, name_e)
            return false if pool[key_s + (name_e - name_s)] != 64
            rh_span_eq2(pool, key_s + (name_e - name_s) + 1, key_e, pool, ver_s, ver_e)

        def rh_pnpm_source_for_version(pool: darray[u8]&, s: usize, e: usize) -> u8 can[Memory.Allocate, Abort.Panic]:
            return RH_PSRC_GIT if rh_span_prefix(pool, s, e, "git+") or rh_span_prefix(pool, s, e, "git://") or rh_span_prefix(pool, s, e, "github:")
            return RH_PSRC_PATH if rh_span_prefix(pool, s, e, "link:") or rh_span_prefix(pool, s, e, "file:") or rh_span_prefix(pool, s, e, "workspace:")
            RH_PSRC_REGISTRY

        def rh_pnpm_unsupported_locator(pool: darray[u8]&, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if rh_span_prefix(pool, s, e, "npm:") or rh_span_prefix(pool, s, e, "link:") or rh_span_prefix(pool, s, e, "file:") or rh_span_prefix(pool, s, e, "workspace:") or rh_span_prefix(pool, s, e, "git+") or rh_span_prefix(pool, s, e, "git://") or rh_span_prefix(pool, s, e, "github:")
            false

        def rh_pnpm_id_parts(data: darray[u8]&, s: usize, e: usize, name_s: mutable i64&, name_e: mutable i64&, version_s: mutable i64&, version_e: mutable i64&, allow_peers: bool) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if e <= s
            scoped: bool = data[s] == 64
            delimiter: usize =
                while i < e |delimiter: usize = e, i: usize = s, after_slash: bool = false| -> delimiter:
                    if scoped and data[i] == 47:
                        after_slash <- true
                    delimiter <- i if data[i] == 64 and (not scoped or after_slash)
                    break if data[i] == 64 and (not scoped or after_slash)
                    i <- i + 1
            return false if delimiter <= s or delimiter + 1 >= e
            suffix_s: usize =
                while i < e |suffix_s: usize = e, i: usize = delimiter + 1| -> suffix_s:
                    suffix_s <- i if allow_peers and data[i] == 40
                    break if allow_peers and data[i] == 40
                    i <- i + 1
            return false if suffix_s <= delimiter + 1
            return false if suffix_s < e and (not allow_peers or data[e - 1] != 41)
            depth: i64 =
                while i < e |depth: i64 = 0, i: usize = suffix_s| -> depth:
                    depth <- depth + 1 if data[i] == 40
                    depth <- depth - 1 if data[i] == 41
                    break if depth < 0
                    i <- i + 1
            return false if depth < 0 or (suffix_s < e and depth != 0)
            name_s[0] <- s.i64()
            name_e[0] <- delimiter.i64()
            version_s[0] <- (delimiter + 1).i64()
            version_e[0] <- suffix_s.i64()
            true

        def rh_pnpm_find_package(packages: darray[RhPnpmPackage]&, pool: darray[u8]&, name_s: usize, name_e: usize, ver_s: usize, ver_e: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < packages.count.i64() |i: i64 = 0, packages|:
                package: RhPnpmPackage = packages[i.usize()]
                if rh_span_eq2(pool, package.name_s.usize(), package.name_e.usize(), pool, name_s, name_e) and rh_span_eq2(pool, package.ver_s.usize(), package.ver_e.usize(), pool, ver_s, ver_e):
                    return i
                i <- i + 1
            -1

        def rh_pnpm_find_snapshot(snapshots: darray[RhPnpmSnapshot]&, pool: darray[u8]&, name_s: usize, name_e: usize, ver_s: usize, ver_e: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < snapshots.count.i64() |i: i64 = 0, snapshots|:
                snapshot: RhPnpmSnapshot = snapshots[i.usize()]
                return snapshot.node if rh_pnpm_snapshot_match(pool, snapshot, name_s, name_e, ver_s, ver_e)
                i <- i + 1
            -1

        def rh_pnpm_snapshot_duplicate(snapshots: darray[RhPnpmSnapshot]&, pool: darray[u8]&, key_s: usize, key_e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < snapshots.count.i64() |i: i64 = 0, snapshots, pool|:
                snapshot: RhPnpmSnapshot = snapshots[i.usize()]
                return true if rh_span_eq2(pool, snapshot.key_s.usize(), snapshot.key_e.usize(), pool, key_s, key_e)
                i <- i + 1
            false

        def rh_pnpm_importer_flush(reqs: mutable darray[RhRequire]&, name_s: i64, name_e: i64, spec_s: i64, spec_e: i64, ver_s: i64, ver_e: i64, depctx: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if name_s < 0
            return false if name_e <= name_s or spec_s < 0 or spec_e <= spec_s or ver_s < 0 or ver_e <= ver_s or depctx < 0
            return false if reqs.count.i64() >= 200000
            reqs.push(RhRequire{from: 0, name_s: name_s, name_e: name_e, ver_s: ver_s, ver_e: ver_e, src_s: -1, src_e: -1, req_s: spec_s, req_e: spec_e, depctx: depctx.u8(), optional: 0})
            true

        def rh_pnpm_resolution_field(line: darray[u8]&, value_s: usize, value_e: usize, pool: mutable darray[u8]&, packages: mutable darray[RhPnpmPackage]&, package_idx: i64, field_s: usize, field_e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if package_idx < 0 or package_idx >= packages.count.i64()
            package: mutable RhPnpmPackage = packages[package_idx.usize()]
            parsed_s: mutable i64 = -1
            parsed_e: mutable i64 = -1
            return false if value_e <= value_s or not rh_pnpm_scalar(line, value_s, value_e, pool, &parsed_s, &parsed_e)
            if rh_span_eq_text(pool, field_s, field_e, "integrity"):
                return false if package.digest_s >= 0
                package.digest_s <- parsed_s
                package.digest_e <- parsed_e
                packages[package_idx.usize()] <- package
                return true
            if rh_span_eq_text(pool, field_s, field_e, "tarball"):
                return false if package.origin_s >= 0
                package.origin_s <- parsed_s
                package.origin_e <- parsed_e
                package.src_kind <- rh_pnpm_source_for_version(pool, parsed_s.usize(), parsed_e.usize())
                packages[package_idx.usize()] <- package
                return true
            if rh_span_eq_text(pool, field_s, field_e, "directory"):
                return false if package.origin_s >= 0
                package.origin_s <- parsed_s
                package.origin_e <- parsed_e
                package.src_kind <- RH_PSRC_PATH
                packages[package_idx.usize()] <- package
                return true
            false

        def rh_pnpm_inline_resolution(line: darray[u8]&, value_s: usize, value_e: usize, pool: mutable darray[u8]&, packages: mutable darray[RhPnpmPackage]&, package_idx: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if value_e - value_s < 2 or line[value_s] != 123 or line[value_e - 1] != 125
            start: usize = value_s + 1
            end: usize = value_e - 1
            return true if start == end
            while pos <= end |pos: usize = start, pool, packages|:
                item_end: usize =
                    while i < end |item_end: usize = end, i: usize = pos, quoted: mutable u8 = 0, escaped: mutable bool = false| -> item_end:
                        b: u8 = line[i]
                        if quoted == 34 and escaped:
                            escaped <- false
                        elif quoted == 34 and b == 92:
                            escaped <- true
                        elif quoted != 0 and b == quoted:
                            if quoted == 39 and i + 1 < end and line[i + 1] == 39:
                                i <- i + 1
                            else:
                                quoted <- 0
                        elif quoted == 0 and (b == 34 or b == 39):
                            quoted <- b
                        elif quoted == 0 and b == 44:
                            item_end <- i
                            i <- end
                        i <- i + 1
                key_s: mutable i64 = 0
                key_e: mutable i64 = 0
                field_s: mutable i64 = 0
                field_e: mutable i64 = 0
                return false if not rh_pnpm_pair(line, pos, item_end, pool, &key_s, &key_e, &field_s, &field_e)
                return false if field_s >= field_e or not rh_pnpm_resolution_field(line, field_s.usize(), field_e.usize(), pool, packages, package_idx, key_s.usize(), key_e.usize())
                pos <- item_end + 1
            true

        def rh_pnpm_root(pkg_bytes: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if pkg_bytes.count == 0 or pkg_bytes.count > 1048576
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            parsed: i64 = Json::rh_json_parse(pkg_bytes, nodes, texts)
            return -1 if parsed < 0
            manifest: Json::RhJsonNode = nodes[parsed.usize()]
            return -1 if manifest.kind != 5
            name_idx: i64 = Json::rh_json_obj_get(nodes, texts, parsed, "name")
            version_idx: i64 = Json::rh_json_obj_get(nodes, texts, parsed, "version")
            return -1 if name_idx < 0 or version_idx < 0
            name: Json::RhJsonNode = nodes[name_idx.usize()]
            version: Json::RhJsonNode = nodes[version_idx.usize()]
            return -1 if name.kind != 3 or version.kind != 3 or name.text_start == name.text_end or version.text_start == version.text_end
            root: i64 = rh_node_add(pkgs, RH_ECO_NPM)
            return -1 if root < 0
            node: mutable RhPkgNode = pkgs[root.usize()]
            node.name_s <- rh_pool_copy(pool, texts, name.text_start.usize(), name.text_end.usize())
            node.name_e <- pool.count.i64()
            node.ver_s <- rh_pool_copy(pool, texts, version.text_start.usize(), version.text_end.usize())
            node.ver_e <- pool.count.i64()
            pkgs[root.usize()] <- node
            root

        def rh_pnpm_resolve(pool: darray[u8]&, snapshots: darray[RhPnpmSnapshot]&, reqs: darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < reqs.count.i64() |i: i64 = 0, edges, unresolved|:
                requirement: RhRequire = reqs[i.usize()]
                target: mutable i64 = -1
                reason: mutable u8 = RH_UNRES_MISSING
                if requirement.ver_s >= 0 and rh_pnpm_unsupported_locator(pool, requirement.ver_s.usize(), requirement.ver_e.usize()):
                    reason <- RH_UNRES_CONTEXT
                elif requirement.ver_s >= 0:
                    target <- rh_pnpm_find_snapshot(snapshots, pool, requirement.name_s.usize(), requirement.name_e.usize(), requirement.ver_s.usize(), requirement.ver_e.usize())
                if target >= 0:
                    _ = rh_edge_add(edges, requirement.from, target, requirement.depctx, requirement.optional)
                else:
                    unresolved.push(RhUnresolved{from: requirement.from, name_s: requirement.name_s, name_e: requirement.name_e, req_s: requirement.req_s, req_e: requirement.req_e, reason: reason, optional: requirement.optional})
                i <- i + 1
            edges.count.i64()

        def rh_pnpm_setting_known(pool: darray[u8]&, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if rh_span_eq_text(pool, s, e, "autoInstallPeers") or rh_span_eq_text(pool, s, e, "excludeLinksFromLockfile") or rh_span_eq_text(pool, s, e, "peersSuffixMaxLength") or rh_span_eq_text(pool, s, e, "injectWorkspacePackages") or rh_span_eq_text(pool, s, e, "dedupePeerDependents") or rh_span_eq_text(pool, s, e, "resolvePeersFromWorkspaceRoot") or rh_span_eq_text(pool, s, e, "linkWorkspacePackages") or rh_span_eq_text(pool, s, e, "preferWorkspacePackages") or rh_span_eq_text(pool, s, e, "strictPeerDependencies") or rh_span_eq_text(pool, s, e, "nodeLinker") or rh_span_eq_text(pool, s, e, "sharedWorkspaceLockfile") or rh_span_eq_text(pool, s, e, "saveWorkspaceProtocol") or rh_span_eq_text(pool, s, e, "resolutionMode") or rh_span_eq_text(pool, s, e, "packageManagerStrict") or rh_span_eq_text(pool, s, e, "packageManagerStrictVersion") or rh_span_eq_text(pool, s, e, "virtualStoreDir") or rh_span_eq_text(pool, s, e, "hoistPattern") or rh_span_eq_text(pool, s, e, "publicHoistPattern") or rh_span_eq_text(pool, s, e, "registry") or rh_span_eq_text(pool, s, e, "pnpmfileChecksum") or rh_span_eq_text(pool, s, e, "packageExtensionsChecksum")
            false

        def rh_pnpm_package_field_known(pool: darray[u8]&, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if rh_span_eq_text(pool, s, e, "peerDependencies") or rh_span_eq_text(pool, s, e, "peerDependenciesMeta") or rh_span_eq_text(pool, s, e, "engines") or rh_span_eq_text(pool, s, e, "os") or rh_span_eq_text(pool, s, e, "cpu") or rh_span_eq_text(pool, s, e, "libc") or rh_span_eq_text(pool, s, e, "deprecated") or rh_span_eq_text(pool, s, e, "bundledDependencies") or rh_span_eq_text(pool, s, e, "hasBin") or rh_span_eq_text(pool, s, e, "requiresBuild") or rh_span_eq_text(pool, s, e, "prepare") or rh_span_eq_text(pool, s, e, "optional") or rh_span_eq_text(pool, s, e, "dev") or rh_span_eq_text(pool, s, e, "patched")
            false

        def rh_yarn_resolve(pool: darray[u8]&, selectors: darray[RhYarnSelector]&, reqs: darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < reqs.count.i64() |i: i64 = 0, edges, unresolved|:
                requirement: RhRequire = reqs[i.usize()]
                candidate: mutable i64 = -1
                ambiguous: mutable bool = false
                while j < selectors.count.i64() |j: i64 = 0, candidate, ambiguous|:
                    selector: RhYarnSelector = selectors[j.usize()]
                    exact_name: bool = rh_span_eq2(pool, selector.name_s.usize(), selector.name_e.usize(), pool, requirement.name_s.usize(), requirement.name_e.usize())
                    exact_range: bool = requirement.req_s >= 0 and rh_span_eq2(pool, selector.req_s.usize(), selector.req_e.usize(), pool, requirement.req_s.usize(), requirement.req_e.usize())
                    if exact_name and exact_range:
                        if candidate < 0:
                            candidate <- selector.node
                        elif candidate != selector.node:
                            ambiguous <- true
                    j <- j + 1
                if candidate >= 0 and not ambiguous:
                    _ = rh_edge_add(edges, requirement.from, candidate, requirement.depctx, requirement.optional)
                else:
                    unresolved.push(RhUnresolved{from: requirement.from, name_s: requirement.name_s, name_e: requirement.name_e, req_s: requirement.req_s, req_e: requirement.req_e, reason: RH_UNRES_AMBIGUOUS if ambiguous else RH_UNRES_MISSING, optional: requirement.optional})
                i <- i + 1
            edges.count.i64()

        # Cargo's older lockfiles keep package checksums in a generic metadata
        # table. Index only when such an entry exists; ordinary and newer locks
        # do not pay for the lookup table.
        def rh_cargo_identity_hash(pool: darray[u8]&, name_s: usize, name_e: usize, ver_s: usize, ver_e: usize, source_s: usize, source_e: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            name_hash: i64 =
                while i < name_e - name_s |hash: i64 = 7, i: usize = 0| -> hash:
                    hash <- (hash * 131 + pool[name_s + i].i64()) % 2147483629
                    i <- i + 1
            version_hash: i64 =
                while i < ver_e - ver_s |hash: i64 = (name_hash * 131) % 2147483629, i: usize = 0| -> hash:
                    hash <- (hash * 131 + pool[ver_s + i].i64()) % 2147483629
                    i <- i + 1
            while i < source_e - source_s |hash: i64 = (version_hash * 131) % 2147483629, i: usize = 0| -> hash:
                hash <- (hash * 131 + pool[source_s + i].i64()) % 2147483629
                i <- i + 1

        def rh_cargo_identity_matches(node: RhPkgNode, pool: darray[u8]&, name_s: usize, name_e: usize, ver_s: usize, ver_e: usize, source_s: usize, source_e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            node.src_kind == RH_PSRC_REGISTRY and node.origin_s >= 0 and rh_span_eq2(pool, node.name_s.usize(), node.name_e.usize(), pool, name_s, name_e) and rh_span_eq2(pool, node.ver_s.usize(), node.ver_e.usize(), pool, ver_s, ver_e) and rh_span_eq2(pool, node.origin_s.usize(), node.origin_e.usize(), pool, source_s, source_e)

        def rh_cargo_checksum_index(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, table: mutable darray[i64]&) -> bool can[Memory.Allocate, Abort.Panic]:
            capacity: i64 = pkgs.count.i64() * 2 + 1
            while table.count.i64() < capacity |table|:
                table.push(-1)
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, table|:
                node: RhPkgNode = pkgs[i.usize()]
                if node.src_kind == RH_PSRC_REGISTRY and node.origin_s >= 0:
                    hash: i64 = rh_cargo_identity_hash(pool, node.name_s.usize(), node.name_e.usize(), node.ver_s.usize(), node.ver_e.usize(), node.origin_s.usize(), node.origin_e.usize())
                    start_slot: usize = (hash % table.count.i64()).usize()
                    inserted: bool =
                        while probe < table.count.i64() |found: bool = false, probe: i64 = 0, slot: usize = start_slot, i, table, pkgs| -> found:
                            previous: i64 = table[slot]
                            if previous < 0:
                                table[slot] <- i
                                break true
                            prior: RhPkgNode = pkgs[previous.usize()]
                            return false if rh_cargo_identity_matches(prior, pool, node.name_s.usize(), node.name_e.usize(), node.ver_s.usize(), node.ver_e.usize(), node.origin_s.usize(), node.origin_e.usize())
                            slot <- (slot + 1) % table.count
                            probe <- probe + 1
                    return false if not inserted
                i <- i + 1
            true

        def rh_cargo_metadata_apply(pkgs: mutable darray[RhPkgNode]&, pool: darray[u8]&, table: darray[i64]&, name_s: usize, name_e: usize, ver_s: usize, ver_e: usize, source_s: usize, source_e: usize, digest_s: i64, digest_e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if table.count.i64() == 0
            hash: i64 = rh_cargo_identity_hash(pool, name_s, name_e, ver_s, ver_e, source_s, source_e)
            slot: mutable usize = (hash % table.count.i64()).usize()
            while probe < table.count.i64() |probe: i64 = 0, slot, table, pkgs|:
                package: i64 = table[slot]
                return false if package < 0
                node: mutable RhPkgNode = pkgs[package.usize()]
                if rh_cargo_identity_matches(node, pool, name_s, name_e, ver_s, ver_e, source_s, source_e):
                    return false if node.has_digest != 0
                    node.has_digest <- 1
                    node.dig_s <- digest_s
                    node.dig_e <- digest_e
                    pkgs[package.usize()] <- node
                    return true
                slot <- (slot + 1) % table.count
                probe <- probe + 1
            false

        def rh_cargo_metadata_checksums(lock: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            table: mutable darray[i64] = []
            while pos < lock.count |unknown: i64 = 0, in_metadata: bool = false, metadata_seen: bool = false, table_ready: bool = false, pos: usize = 0, pkgs, table| -> unknown:
                line_end: usize =
                    nl: i64 = Base::rh_find_byte(lock, pos, 10)
                    nl.usize() if nl >= 0 else lock.count
                ts: mutable i64 = 0
                te: mutable i64 = 0
                rh_trim_span(lock, pos, line_end, &ts, &te)
                if te > ts:
                    if lock[ts.usize()] == 35:
                        pos <- line_end + 1
                        continue
                    if lock[ts.usize()] == 91:
                        is_metadata: bool = rh_span_lit(lock, ts.usize(), te.usize(), "[metadata]")
                        return -1 if is_metadata and metadata_seen
                        metadata_seen <- true if is_metadata
                        in_metadata <- is_metadata
                    elif in_metadata and lock[ts.usize()] == 34:
                        key_s: mutable i64 = 0
                        key_e: mutable i64 = 0
                        after_key: i64 = rh_quoted_span(lock, ts.usize(), te.usize(), pool, &key_s, &key_e)
                        return -1 if after_key < 0
                        if rh_span_prefix(pool, key_s.usize(), key_e.usize(), "checksum "):
                            package_name_s: usize = key_s.usize() + 9
                            package_name_e: usize =
                                while name_end < key_e.usize() |name_end: usize = package_name_s, pool| -> name_end:
                                    break if pool[name_end] == 32
                                    name_end <- name_end + 1
                            return -1 if package_name_e == package_name_s or package_name_e + 1 >= key_e.usize()
                            return -1 if pool[package_name_e] != 32 or pool[key_e.usize() - 1] != 41
                            package_version_s: usize = package_name_e + 1
                            package_version_e: usize =
                                while version_end < key_e.usize() |version_end: usize = package_version_s, pool| -> version_end:
                                    break if pool[version_end] == 32
                                    version_end <- version_end + 1
                            return -1 if package_version_e == package_version_s or package_version_e + 2 >= key_e.usize()
                            return -1 if pool[package_version_e] != 32 or pool[package_version_e + 1] != 40
                            source_s: usize = package_version_e + 2
                            source_e: usize = key_e.usize() - 1
                            return -1 if source_e <= source_s
                            digest_s: mutable i64 = 0
                            digest_e: mutable i64 = 0
                            after_digest: i64 = rh_toml_qstring(lock, after_key.usize(), te.usize(), pool, &digest_s, &digest_e)
                            return -1 if after_digest < 0 or not rh_cargo_checksum_valid(pool, digest_s, digest_e)
                            trailing: usize =
                                while trailing < te.usize() |trailing: usize = after_digest.usize()| -> trailing:
                                    break if lock[trailing] == 35
                                    break if lock[trailing] != 32 and lock[trailing] != 9
                                    trailing <- trailing + 1
                            return -1 if trailing < te.usize() and lock[trailing] != 35
                            if not table_ready:
                                return -1 if not rh_cargo_checksum_index(pkgs, pool, table)
                                table_ready <- true
                            return -1 if not rh_cargo_metadata_apply(pkgs, pool, table, package_name_s, package_name_e, package_version_s, package_version_e, source_s, source_e, digest_s, digest_e)
                        else:
                            unknown <- unknown + 1
                    elif in_metadata:
                        unknown <- unknown + 1
                pos <- line_end + 1

        def rh_artifact_kind_label(kind: u8) -> u8&:
            return "module" if kind == RH_ART_KIND_MODULE
            return "go_mod" if kind == RH_ART_KIND_GO_MOD
            return "nuget_content" if kind == RH_ART_KIND_NUGET_CONTENT
            "archive"

        def rh_artifact_state_label(state: i64) -> u8&:
            return "match" if state == RH_ART_MATCH
            return "changed" if state == RH_ART_CHANGED
            "unknown"

        def rh_npm_entry_name(pool: mutable darray[u8]&, ps: usize, pe: usize, ns: mutable i64&, ne: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if pe <= ps
            last: usize =
                while k < pe |last: usize = pe, k: usize = ps, pool| -> last:
                    if pool[k] == 47:
                        last <- k + 1
                    k <- k + 1
            return false if last >= pe
            if last > ps and pool[last - 1] == 47:
                scope_at: usize =
                    while q < last - 1 |scope_at: usize = ps, q: usize = ps, pool| -> scope_at:
                        if pool[q] == 47:
                            scope_at <- q + 1
                        q <- q + 1
                if pool[scope_at] == 64:
                    ns[0] <- scope_at.i64()
                    ne[0] <- pe.i64()
                    return true
            ns[0] <- last.i64()
            ne[0] <- pe.i64()
            true

        def rh_npm_copy_span(pool: mutable darray[u8]&, texts: darray[u8]&, s: usize, e: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            start: i64 = pool.count.i64()
            while k < e |k: usize = s, pool, texts|:
                pool.push(texts[k])
                k <- k + 1
            start

        # Collect one requirement map (name -> range string) from a JSON object.
        def rh_npm_optional_peer(jnodes: darray[Json::RhJsonNode]&, input: darray[u8]&, texts: darray[u8]&, peer_meta: i64, name_s: usize, name_e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if peer_meta < 0
            meta: Json::RhJsonNode = jnodes[peer_meta.usize()]
            return false if meta.kind != 5
            while child >= 0 |child: i64 = meta.first_child|:
                key: Json::RhJsonNode = jnodes[child.usize()]
                value: i64 = key.next_sibling
                return false if value < 0
                if key.kind == 3 and rh_span_eq2(texts, key.text_start.usize(), key.text_end.usize(), texts, name_s, name_e):
                    optional_idx: i64 = Json::rh_json_obj_get(jnodes, texts, value, "optional")
                    return Json::rh_json_is_true(jnodes, input, optional_idx)
                child <- jnodes[value.usize()].next_sibling
            false

        def rh_npm_req_map(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, input: darray[u8]&, obj: i64, from: i64, depctx: u8, peer_meta: i64, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            o: Json::RhJsonNode = jnodes[obj.usize()]
            while child >= 0 |made: i64 = 0, child: i64 = o.first_child, pool, reqs| -> made:
                kn: Json::RhJsonNode = jnodes[child.usize()]
                vn: i64 = kn.next_sibling
                return -1 if vn < 0
                vv: Json::RhJsonNode = jnodes[vn.usize()]
                return -1 if vv.kind != 3
                optional_peer: mutable u8 = 0
                if depctx == 3 and rh_npm_optional_peer(jnodes, input, texts, peer_meta, kn.text_start.usize(), kn.text_end.usize()):
                    optional_peer <- 1
                ns: i64 = rh_pool_copy(pool, texts, kn.text_start.usize(), kn.text_end.usize())
                ne: i64 = pool.count.i64()
                rs: i64 = rh_pool_copy(pool, texts, vv.text_start.usize(), vv.text_end.usize())
                re: i64 = pool.count.i64()
                reqs.push(RhRequire{from: from, name_s: ns, name_e: ne, ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: rs, req_e: re, depctx: depctx, optional: optional_peer})
                made <- made + 1
                child <- jnodes[vn.usize()].next_sibling

        def rh_npm_scope_of(texts: darray[u8]&, mapkey_s: usize, mapkey_e: usize) -> u8 can[Memory.Allocate, Abort.Panic]:
            return 1 if rh_span_eq_text(texts, mapkey_s, mapkey_e, "devDependencies")
            return 2 if rh_span_eq_text(texts, mapkey_s, mapkey_e, "optionalDependencies")
            return 3 if rh_span_eq_text(texts, mapkey_s, mapkey_e, "peerDependencies")
            0

        # Node lookup by install path (exact bytes, pool spans vs candidate span).
        def rh_npm_find_path(nodes: darray[RhPkgNode]&, paths: darray[i64]&, pool: mutable darray[u8]&, want: darray[u8]&, want_s: usize, want_e: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < nodes.count.i64() |i: i64 = 0, nodes, paths, pool, want|:
                ps: usize = paths[(i * 2).usize()].usize()
                pe: usize = paths[(i * 2 + 1).usize()].usize()
                return i if rh_span_eq2(pool, ps, pe, want, want_s, want_e)
                i <- i + 1
            -1

        # Node-style walk-up: dir(P)/node_modules/D, then parents, then root.
        # Returns node idx, or -1 with reason in reason_out (0 missing, 2 peer).
        def rh_npm_lookup(pkgs: darray[RhPkgNode]&, paths: darray[i64]&, pool: mutable darray[u8]&, entry_path_s: usize, entry_path_e: usize, dep_s: usize, dep_e: usize, peer: bool, reason_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            reason_out[0] <- 0
            while done == false |dirpos: usize = entry_path_e, done: bool = false, pool, entry_path_s, dep_s, dep_e|:
                hit: i64 = |pool|
                    cand: mutable darray[u8] = []
                    if dirpos > entry_path_s:
                        while k < dirpos |k: usize = entry_path_s, pool, cand|:
                            cand.push(pool[k])
                            k <- k + 1
                        cand.push(47)
                    Base::rh_push_text(cand, "node_modules/")
                    while q < dep_e |q: usize = dep_s, pool, cand|:
                        cand.push(pool[q])
                        q <- q + 1
                    block_result: i64 = rh_npm_find_path(pkgs, paths, pool, cand, 0, cand.count)
                    block_result
                return hit if hit >= 0
                if dirpos <= entry_path_s:
                    done <- true
                else:
                    back: usize =
                        while back > entry_path_s |back: usize = dirpos, pool| -> back:
                            break if pool[back - 1] == 47
                            back <- back - 1
                    if back <= entry_path_s:
                        dirpos <- entry_path_s
                    else:
                        dirpos <- back - 1
            if peer:
                reason_out[0] <- 2
            -1

        # Register one lock entry as a node. Returns idx or -1 malformed.
        # entry_path is the lock key span ("" for root).
        def rh_npm_add_node(pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, paths: mutable darray[i64]&, texts: darray[u8]&, input: darray[u8]&, entry: i64, enodes: darray[Json::RhJsonNode]&, ps: usize, pe: usize, fallback_name_s: i64, fallback_name_e: i64, fallback_ver_s: i64, fallback_ver_e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            idx: i64 = rh_node_add(pkgs, 1)
            return -1 if idx < 0
            paths.push(ps.i64())
            paths.push(pe.i64())
            n: mutable RhPkgNode = pkgs[idx.usize()]
            nm: i64 = Json::rh_json_obj_get(enodes, texts, entry, "name")
            if nm >= 0:
                nn: Json::RhJsonNode = enodes[nm.usize()]
                if nn.kind == 3:
                    n.name_s <- rh_pool_copy(pool, texts, nn.text_start.usize(), nn.text_end.usize())
                    n.name_e <- pool.count.i64()
                else:
                    return -1
            elif fallback_name_s >= 0:
                n.name_s <- rh_pool_copy(pool, texts, fallback_name_s.usize(), fallback_name_e.usize())
                n.name_e <- pool.count.i64()
            else:
                ns2: mutable i64 = 0
                ne2: mutable i64 = 0
                return -1 if not rh_npm_entry_name(pool, ps, pe, &ns2, &ne2)
                n.name_s <- ns2
                n.name_e <- ne2
            vi: i64 = Json::rh_json_obj_get(enodes, texts, entry, "version")
            if vi >= 0:
                vn2: Json::RhJsonNode = enodes[vi.usize()]
                return -1 if vn2.kind != 3
                n.ver_s <- rh_pool_copy(pool, texts, vn2.text_start.usize(), vn2.text_end.usize())
                n.ver_e <- pool.count.i64()
            elif fallback_ver_s >= 0:
                n.ver_s <- rh_pool_copy(pool, texts, fallback_ver_s.usize(), fallback_ver_e.usize())
                n.ver_e <- pool.count.i64()
            else:
                link: i64 = Json::rh_json_obj_get(enodes, texts, entry, "link")
                return -1 if link < 0 or not Json::rh_json_is_true(enodes, input, link)
                n.src_kind <- 1
                n.ver_s <- -1
                n.ver_e <- -1
            integ: i64 = Json::rh_json_obj_get(enodes, texts, entry, "integrity")
            if integ >= 0:
                ni3: Json::RhJsonNode = enodes[integ.usize()]
                if ni3.kind == 3:
                    n.has_digest <- 1
                    n.dig_s <- rh_pool_copy(pool, texts, ni3.text_start.usize(), ni3.text_end.usize())
                    n.dig_e <- pool.count.i64()
            devf: i64 = Json::rh_json_obj_get(enodes, texts, entry, "dev")
            if devf >= 0 and Json::rh_json_is_true(enodes, input, devf):
                n.dev <- 1
            optf: i64 = Json::rh_json_obj_get(enodes, texts, entry, "optional")
            if optf >= 0 and Json::rh_json_is_true(enodes, input, optf):
                n.optional <- 1
            resolved: i64 = Json::rh_json_obj_get(enodes, texts, entry, "resolved")
            if resolved >= 0:
                resolved_node: Json::RhJsonNode = enodes[resolved.usize()]
                return -1 if resolved_node.kind != 3
                n.origin_s <- rh_pool_copy(pool, texts, resolved_node.text_start.usize(), resolved_node.text_end.usize())
                n.origin_e <- pool.count.i64()
                if rh_span_prefix(pool, n.origin_s.usize(), n.origin_e.usize(), "git+"):
                    n.src_kind <- RH_PSRC_GIT
                elif rh_span_prefix(pool, n.origin_s.usize(), n.origin_e.usize(), "file:"):
                    n.src_kind <- RH_PSRC_PATH
            pkgs[idx.usize()] <- n
            idx

        # v1 legacy "dependencies" tree walk. curpath is the pool span of the
        # containing depctx ("" at top). Returns 0 ok, -1 malformed.
        # v1 requirements: the "requires" object maps names to range strings.
        # Nested "dependencies" are package ENTRIES (walked separately), never
        # requirement strings (R009).
        def rh_npm_v1_requires(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, input: darray[u8]&, entry: i64, from: i64, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            req: i64 = Json::rh_json_obj_get(jnodes, texts, entry, "requires")
            return 0 if req < 0
            rn: Json::RhJsonNode = jnodes[req.usize()]
            return 0 if rn.kind != 5
            rh_npm_req_map(jnodes, pool, texts, input, req, from, 0, -1, reqs)

        def rh_npm_v1_walk(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, input: darray[u8]&, obj: i64, cur_s: usize, cur_e: usize, pkgs: mutable darray[RhPkgNode]&, paths: mutable darray[i64]&, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            o: Json::RhJsonNode = jnodes[obj.usize()]
            while child >= 0 |child: i64 = o.first_child, jnodes, pool, texts, input, cur_s, cur_e, pkgs, paths, reqs|:
                kn: Json::RhJsonNode = jnodes[child.usize()]
                vn: i64 = kn.next_sibling
                return -1 if vn < 0
                entry_idx: i64 = |pool, pkgs, paths|
                    vv: Json::RhJsonNode = jnodes[vn.usize()]
                    return -1 if vv.kind != 5
                    kid_s: mutable i64 = 0
                    kid_e: mutable i64 = 0
                    return -1 if not rh_npm_child_path(pool, cur_s, cur_e, texts, kn.text_start.usize(), kn.text_end.usize(), &kid_s, &kid_e)
                    block_result: i64 = rh_npm_add_node(pkgs, pool, paths, texts, input, vn, jnodes, kid_s.usize(), kid_e.usize(), -1, -1, -1, -1)
                    block_result
                return -1 if entry_idx < 0
                return -1 if rh_npm_v1_requires(jnodes, pool, texts, input, vn, entry_idx, reqs) < 0
                nested: i64 = Json::rh_json_obj_get(jnodes, texts, vn, "dependencies")
                if nested >= 0:
                    nn2: Json::RhJsonNode = jnodes[nested.usize()]
                    return -1 if nn2.kind != 5
                    ps2: mutable i64 = 0
                    pe2: mutable i64 = 0
                    return -1 if not rh_node_path(pkgs, paths, entry_idx, &ps2, &pe2)
                    return -1 if rh_npm_v1_walk(jnodes, pool, texts, input, nested, ps2.usize(), pe2.usize(), pkgs, paths, reqs) < 0
                child <- jnodes[vn.usize()].next_sibling
            0

        # Child install path = depctx + "/node_modules/" + key, appended to pool.
        # Staged through a temp buffer: pool may reallocate while growing, so it
        # is never read and written in one pass. Reports span via outs.
        def rh_npm_child_path(pool: mutable darray[u8]&, cur_s: usize, cur_e: usize, texts: darray[u8]&, ks: usize, ke: usize, ps_out: mutable i64&, pe_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            tmp: mutable darray[u8] = []
            if cur_e > cur_s:
                while k < cur_e |k: usize = cur_s, pool, tmp|:
                    tmp.push(pool[k])
                    k <- k + 1
                tmp.push(47)
            Base::rh_push_text(tmp, "node_modules/")
            while q < ke |q: usize = ks, tmp, texts|:
                tmp.push(texts[q])
                q <- q + 1
            ps_out[0] <- pool.count.i64()
            pool.extend(bytes_view(tmp))
            pe_out[0] <- pool.count.i64()
            true

        def rh_node_path(pkgs: darray[RhPkgNode]&, paths: darray[i64]&, idx: i64, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if idx < 0 or idx >= pkgs.count.i64()
            s_out[0] <- paths[(idx * 2).usize()]
            e_out[0] <- paths[(idx * 2 + 1).usize()]
            true

        # Top-level npm lockfile driver. lock_bytes holds package-lock.json;
        # pkg_bytes holds package.json or is empty. Builds pkgs (path spans in
        # paths[]), requirements, then resolves. Root identity comes from the
        # lock top-level name/version (always present in real locks; missing
        # fails closed). Returns the root index, or -1 malformed.
    public:
        def rh_npm_lock_parse(lock_bytes: darray[u8]&, pkg_bytes: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, paths: mutable darray[i64]&, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            lnodes: mutable darray[Json::RhJsonNode] = []
            ltexts: mutable darray[u8] = []
            lroot: i64 = Json::rh_json_parse(lock_bytes, lnodes, ltexts)
            return -1 if lroot < 0
            lro: Json::RhJsonNode = lnodes[lroot.usize()]
            return -1 if lro.kind != 5
            lock_version_idx: i64 = Json::rh_json_obj_get(lnodes, ltexts, lroot, "lockfileVersion")
            pkgs_obj: i64 = Json::rh_json_obj_get(lnodes, ltexts, lroot, "packages")
            if lock_version_idx >= 0:
                lock_version_ok: mutable i64 = 0
                lock_version: i64 = Json::rh_json_int(lnodes, lock_bytes, lock_version_idx, &lock_version_ok)
                return -1 if lock_version_ok != 1 or lock_version < 1 or lock_version > 3
                return -1 if lock_version == 1 and pkgs_obj >= 0
                return -1 if lock_version >= 2 and pkgs_obj < 0
            else:
                return -1 if pkgs_obj >= 0
            tn_s: mutable i64 = -1
            tn_e: mutable i64 = -1
            tv_s: mutable i64 = -1
            tv_e: mutable i64 = -1
            tn: i64 = Json::rh_json_obj_get(lnodes, ltexts, lroot, "name")
            if tn >= 0:
                tnn: Json::RhJsonNode = lnodes[tn.usize()]
                return -1 if tnn.kind != 3
                tn_s <- rh_pool_copy(pool, ltexts, tnn.text_start.usize(), tnn.text_end.usize())
                tn_e <- pool.count.i64()
            tv: i64 = Json::rh_json_obj_get(lnodes, ltexts, lroot, "version")
            if tv >= 0:
                tvn: Json::RhJsonNode = lnodes[tv.usize()]
                return -1 if tvn.kind != 3
                tv_s <- rh_pool_copy(pool, ltexts, tvn.text_start.usize(), tvn.text_end.usize())
                tv_e <- pool.count.i64()
            return -1 if tn_s < 0 or tv_s < 0
            root: i64 = rh_node_add(pkgs, 1)
            return -1 if root < 0
            paths.push(0)
            paths.push(0)
            rn: mutable RhPkgNode = pkgs[root.usize()]
            rn.name_s <- tn_s
            rn.name_e <- tn_e
            rn.ver_s <- tv_s
            rn.ver_e <- tv_e
            pkgs[root.usize()] <- rn
            if pkgs_obj >= 0:
                pk: Json::RhJsonNode = lnodes[pkgs_obj.usize()]
                return -1 if pk.kind != 5
                return -1 if rh_npm_packages_walk(lnodes, pool, ltexts, lock_bytes, pkgs_obj, root, tn_s, tn_e, tv_s, tv_e, pkgs, paths, reqs) < 0
            else:
                deps: i64 = Json::rh_json_obj_get(lnodes, ltexts, lroot, "dependencies")
                return -1 if deps < 0
                dd: Json::RhJsonNode = lnodes[deps.usize()]
                return -1 if dd.kind != 5
                return -1 if rh_npm_v1_walk(lnodes, pool, ltexts, lock_bytes, deps, 0, 0, pkgs, paths, reqs) < 0
            if pkg_bytes.count > 0:
                return -1 if rh_npm_package_json(pkg_bytes, root, pkgs, pool, reqs) < 0
            root

        # v2/v3 "packages" map walk. The "" entry reuses the root node (name and
        # version fall back to top-level when absent there).
        def rh_npm_packages_walk(lnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, ltexts: darray[u8]&, linput: darray[u8]&, pkgs_obj: i64, root: i64, tn_s: i64, tn_e: i64, tv_s: i64, tv_e: i64, pkgs: mutable darray[RhPkgNode]&, paths: mutable darray[i64]&, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            po: Json::RhJsonNode = lnodes[pkgs_obj.usize()]
            while child >= 0 |child: i64 = po.first_child, lnodes, pool, ltexts, linput, root, tn_s, tn_e, tv_s, tv_e, pkgs, paths, reqs|:
                kn: Json::RhJsonNode = lnodes[child.usize()]
                vn: i64 = kn.next_sibling
                return -1 if vn < 0
                vv: Json::RhJsonNode = lnodes[vn.usize()]
                return -1 if vv.kind != 5
                ps: i64 = rh_pool_copy(pool, ltexts, kn.text_start.usize(), kn.text_end.usize())
                pe: i64 = pool.count.i64()
                if ps == pe:
                    return -1 if rh_npm_entry_reqs(lnodes, pool, ltexts, linput, vn, root, reqs) < 0
                else:
                    idx: i64 = rh_npm_add_node(pkgs, pool, paths, ltexts, linput, vn, lnodes, ps.usize(), pe.usize(), -1, -1, -1, -1)
                    return -1 if idx < 0
                    return -1 if rh_npm_entry_reqs(lnodes, pool, ltexts, linput, vn, idx, reqs) < 0
                child <- lnodes[vn.usize()].next_sibling
            0

        # package.json: root name/version cross-check skipped (lock wins for
        # identity); its four dependency maps become scoped requirements.
        def rh_npm_package_json(pkg_bytes: darray[u8]&, root: i64, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            pnodes: mutable darray[Json::RhJsonNode] = []
            ptexts: mutable darray[u8] = []
            proot: i64 = Json::rh_json_parse(pkg_bytes, pnodes, ptexts)
            return -1 if proot < 0
            po: Json::RhJsonNode = pnodes[proot.usize()]
            return -1 if po.kind != 5
            return -1 if rh_npm_entry_reqs(pnodes, pool, ptexts, pkg_bytes, proot, root, reqs) < 0
            0

        # Iterate one entry's four dependency maps into requirements.
        def rh_npm_entry_reqs(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, input: darray[u8]&, entry: i64, from: i64, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            maps: mutable i64 = 0
            maps <- maps + rh_npm_map_reqs(jnodes, pool, texts, input, entry, from, "dependencies", 0, reqs)
            maps <- maps + rh_npm_map_reqs(jnodes, pool, texts, input, entry, from, "devDependencies", 1, reqs)
            maps <- maps + rh_npm_map_reqs(jnodes, pool, texts, input, entry, from, "optionalDependencies", 2, reqs)
            maps <- maps + rh_npm_map_reqs(jnodes, pool, texts, input, entry, from, "peerDependencies", 3, reqs)
            maps

        def rh_npm_map_reqs(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, input: darray[u8]&, entry: i64, from: i64, mapkey: u8&, depctx: u8, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            m: i64 = Json::rh_json_obj_get(jnodes, texts, entry, mapkey)
            return 0 if m < 0
            mo: Json::RhJsonNode = jnodes[m.usize()]
            return -1 if mo.kind != 5
            peer_meta: mutable i64 = -1
            if depctx == 3:
                peer_meta <- Json::rh_json_obj_get(jnodes, texts, entry, "peerDependenciesMeta")
                return -1 if peer_meta >= 0 and jnodes[peer_meta.usize()].kind != 5
            rh_npm_req_map(jnodes, pool, texts, input, m, from, depctx, peer_meta, reqs)

        # Resolve every collected requirement via walk-up. Returns edge count.
        def rh_npm_resolve(pkgs: darray[RhPkgNode]&, paths: darray[i64]&, pool: mutable darray[u8]&, reqs: darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while r < reqs.count |made: i64 = 0, r: usize = 0, pool, edges, unresolved| -> made:
                q: RhRequire = reqs[r]
                from_path_s: mutable usize = 0
                from_path_e: mutable usize = 0
                if q.from >= 0:
                    f2a: i64 = q.from * 2
                    from_path_s <- paths[f2a.usize()].usize()
                    f2b: i64 = q.from * 2 + 1
                    from_path_e <- paths[f2b.usize()].usize()
                reason: mutable i64 = 0
                hit: i64 = rh_npm_lookup(pkgs, paths, pool, from_path_s, from_path_e, q.name_s.usize(), q.name_e.usize(), q.depctx == 3, &reason)
                if hit >= 0:
                    if rh_edge_add(edges, q.from, hit, q.depctx, q.optional):
                        made <- made + 1
                else:
                    code: u8 = 2 if reason == 2 else 0
                    unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.req_s, req_e: q.req_e, reason: code, optional: q.optional})
                r <- r + 1

    private:
        def rh_yarn_root(pkg_bytes: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if pkg_bytes.count == 0 or pkg_bytes.count > 1048576
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            parsed: i64 = Json::rh_json_parse(pkg_bytes, nodes, texts)
            return -1 if parsed < 0
            manifest: Json::RhJsonNode = nodes[parsed.usize()]
            return -1 if manifest.kind != 5
            name_idx: i64 = Json::rh_json_obj_get(nodes, texts, parsed, "name")
            version_idx: i64 = Json::rh_json_obj_get(nodes, texts, parsed, "version")
            return -1 if name_idx < 0 or version_idx < 0
            name: Json::RhJsonNode = nodes[name_idx.usize()]
            version: Json::RhJsonNode = nodes[version_idx.usize()]
            return -1 if name.kind != 3 or version.kind != 3
            return -1 if name.text_start == name.text_end or version.text_start == version.text_end
            root: i64 = rh_node_add(pkgs, RH_ECO_NPM)
            return -1 if root < 0
            root_node: mutable RhPkgNode = pkgs[root.usize()]
            root_node.name_s <- rh_pool_copy(pool, texts, name.text_start.usize(), name.text_end.usize())
            root_node.name_e <- pool.count.i64()
            root_node.ver_s <- rh_pool_copy(pool, texts, version.text_start.usize(), version.text_end.usize())
            root_node.ver_e <- pool.count.i64()
            pkgs[root.usize()] <- root_node
            return -1 if rh_npm_entry_reqs(nodes, pool, texts, pkg_bytes, parsed, root, reqs) < 0
            root

    public:
        # Yarn Classic v1 lockfile adapter. Yarn records the exact descriptor
        # selectors alongside resolved versions, so requirements resolve only
        # by exact name/range evidence. Berry lockfiles, aliases, and unknown
        # record fields remain outside this version-pinned parser.
        def rh_yarn_lock_parse(lock: darray[u8]&, pkg_bytes: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if lock.count == 0 or lock.count > 4194304
            root: i64 = rh_yarn_root(pkg_bytes, pkgs, pool, reqs)
            return -1 if root < 0
            selectors: mutable darray[RhYarnSelector] = []
            header_seen: mutable bool = false
            current_node: mutable i64 = -1
            current_scope: mutable i64 = -1
            version_seen: mutable bool = false
            resolved_seen: mutable bool = false
            integrity_seen: mutable bool = false
            entry_count: mutable i64 = 0
            while pos < lock.count |pos: usize = 0, pool, pkgs, reqs, edges, unresolved, selectors, header_seen, current_node, current_scope, version_seen, resolved_seen, integrity_seen, entry_count|:
                line_end: usize =
                    newline: i64 = Base::rh_find_byte(lock, pos, 10)
                    newline.usize() if newline >= 0 else lock.count
                return -1 if line_end - pos > 65536
                start: mutable i64 = 0
                end: mutable i64 = 0
                rh_trim_span(lock, pos, line_end, &start, &end)
                indent: usize = start.usize() - pos
                if end > start:
                    return -1 if lock[pos] == 9
                    if lock[start.usize()] == 35:
                        if rh_span_prefix(lock, start.usize(), end.usize(), "# yarn lockfile v"):
                            prefix_len: usize = strlen("# yarn lockfile v")
                            return -1 if header_seen or end.usize() != start.usize() + prefix_len + 1 or lock[start.usize() + prefix_len] != 49
                            header_seen <- true
                    elif indent == 0:
                        return -1 if current_node >= 0 and not version_seen
                        current_node <- rh_yarn_entry_header(lock, start.usize(), end.usize(), pkgs, pool, selectors)
                        return -1 if current_node < 0
                        current_scope <- -1
                        version_seen <- false
                        resolved_seen <- false
                        integrity_seen <- false
                        entry_count <- entry_count + 1
                    elif current_node < 0:
                        return -1
                    elif indent == 2:
                        current_scope <- -1
                        if rh_span_lit(lock, start.usize(), end.usize(), "dependencies:"):
                            current_scope <- 0
                        elif rh_span_lit(lock, start.usize(), end.usize(), "optionalDependencies:"):
                            current_scope <- 2
                        elif rh_span_lit(lock, start.usize(), end.usize(), "peerDependencies:"):
                            current_scope <- 3
                        else:
                            key_s: mutable i64 = 0
                            key_e: mutable i64 = 0
                            key_next: mutable i64 = 0
                            return -1 if not rh_yarn_token(lock, start.usize(), end.usize(), pool, &key_s, &key_e, &key_next)
                            value_s: mutable i64 = 0
                            value_e: mutable i64 = 0
                            value_next: mutable i64 = 0
                            return -1 if not rh_yarn_token(lock, key_next.usize(), end.usize(), pool, &value_s, &value_e, &value_next)
                            rest_pos: mutable usize = value_next.usize()
                            while rest_pos < end.usize() |rest_pos|:
                                break if lock[rest_pos] != 32 and lock[rest_pos] != 9
                                rest_pos <- rest_pos + 1
                            return -1 if rest_pos != end.usize() or value_s == value_e
                            if rh_span_lit(pool, key_s.usize(), key_e.usize(), "version"):
                                return -1 if version_seen
                                package: mutable RhPkgNode = pkgs[current_node.usize()]
                                package.ver_s <- value_s
                                package.ver_e <- value_e
                                pkgs[current_node.usize()] <- package
                                version_seen <- true
                            elif rh_span_lit(pool, key_s.usize(), key_e.usize(), "resolved"):
                                return -1 if resolved_seen
                                package: mutable RhPkgNode = pkgs[current_node.usize()]
                                package.origin_s <- value_s
                                package.origin_e <- value_e
                                if package.src_kind == RH_PSRC_UNKNOWN:
                                    package.src_kind <- RH_PSRC_REGISTRY
                                    if rh_span_prefix(pool, value_s.usize(), value_e.usize(), "git+") or rh_span_prefix(pool, value_s.usize(), value_e.usize(), "git://") or rh_span_prefix(pool, value_s.usize(), value_e.usize(), "github:"):
                                        package.src_kind <- RH_PSRC_GIT
                                    elif rh_span_prefix(pool, value_s.usize(), value_e.usize(), "file:") or rh_span_prefix(pool, value_s.usize(), value_e.usize(), "link:") or rh_span_prefix(pool, value_s.usize(), value_e.usize(), "workspace:"):
                                        package.src_kind <- RH_PSRC_PATH
                                pkgs[current_node.usize()] <- package
                                resolved_seen <- true
                            elif rh_span_lit(pool, key_s.usize(), key_e.usize(), "integrity"):
                                return -1 if integrity_seen
                                package: mutable RhPkgNode = pkgs[current_node.usize()]
                                package.has_digest <- 1
                                package.dig_s <- value_s
                                package.dig_e <- value_e
                                pkgs[current_node.usize()] <- package
                                integrity_seen <- true
                            else:
                                return -1
                    elif indent == 4:
                        return -1 if current_scope < 0 or reqs.count.i64() >= 200000
                        name_s: mutable i64 = 0
                        name_e: mutable i64 = 0
                        name_next: mutable i64 = 0
                        return -1 if not rh_yarn_token(lock, start.usize(), end.usize(), pool, &name_s, &name_e, &name_next)
                        req_s: mutable i64 = 0
                        req_e: mutable i64 = 0
                        req_next: mutable i64 = 0
                        return -1 if not rh_yarn_token(lock, name_next.usize(), end.usize(), pool, &req_s, &req_e, &req_next)
                        rest_pos2: mutable usize = req_next.usize()
                        while rest_pos2 < end.usize() |rest_pos2|:
                            break if lock[rest_pos2] != 32 and lock[rest_pos2] != 9
                            rest_pos2 <- rest_pos2 + 1
                        return -1 if rest_pos2 != end.usize() or name_s == name_e or req_s == req_e
                        reqs.push(RhRequire{from: current_node, name_s: name_s, name_e: name_e, ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: req_s, req_e: req_e, depctx: current_scope.u8(), optional: 0})
                    else:
                        return -1
                pos <- line_end + 1
            if current_node >= 0 and not version_seen:
                return -1
            return -1 if not header_seen or entry_count == 0
            _ = rh_yarn_resolve(pool, selectors, reqs, edges, unresolved)
            root

        # pnpm v9's importer resolution and snapshot graph are exact lockfile
        # evidence. Workspace importers and non-registry locators remain
        # explicit context-unresolved requirements; peer suffixes distinguish
        # private snapshot paths while published node versions stay plain.
        def rh_pnpm_lock_parse(lock: darray[u8]&, pkg_bytes: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if lock.count == 0 or lock.count > 4194304
            root: i64 = rh_pnpm_root(pkg_bytes, pkgs, pool)
            return -1 if root != 0
            packages: mutable darray[RhPnpmPackage] = []
            snapshots: mutable darray[RhPnpmSnapshot] = []
            section: mutable i64 = 0
            lock_version_seen: mutable bool = false
            settings_seen: mutable bool = false
            importers_seen: mutable bool = false
            packages_seen: mutable bool = false
            snapshots_seen: mutable bool = false
            root_importer_seen: mutable bool = false
            importer_count: mutable i64 = 0
            importer_scope: mutable i64 = -1
            importer_name_s: mutable i64 = -1
            importer_name_e: mutable i64 = -1
            importer_spec_s: mutable i64 = -1
            importer_spec_e: mutable i64 = -1
            importer_ver_s: mutable i64 = -1
            importer_ver_e: mutable i64 = -1
            current_package: mutable i64 = -1
            package_resolution_nested: mutable bool = false
            package_resolution_seen: mutable bool = false
            package_metadata_skip: mutable bool = false
            current_snapshot: mutable i64 = -1
            snapshot_scope: mutable i64 = -1
            peer_list_skip: mutable bool = false
            while pos < lock.count |pos: usize = 0, section, lock_version_seen, settings_seen, importers_seen, packages_seen, snapshots_seen, root_importer_seen, importer_count, importer_scope, importer_name_s, importer_name_e, importer_spec_s, importer_spec_e, importer_ver_s, importer_ver_e, current_package, package_resolution_nested, package_resolution_seen, package_metadata_skip, current_snapshot, snapshot_scope, peer_list_skip, packages, snapshots, pkgs, pool, reqs, edges, unresolved, lock|:
                line_end: usize =
                    newline: i64 = Base::rh_find_byte(lock, pos, 10)
                    newline.usize() if newline >= 0 else lock.count
                return -1 if line_end - pos > 65536
                start: mutable i64 = 0
                end: mutable i64 = 0
                rh_trim_span(lock, pos, line_end, &start, &end)
                indent: usize = start.usize() - pos
                if end > start:
                    return -1 if lock[pos] == 9
                    if lock[start.usize()] != 35:
                        return -1 if section == 2 and indent < 8 and not rh_pnpm_importer_flush(reqs, importer_name_s, importer_name_e, importer_spec_s, importer_spec_e, importer_ver_s, importer_ver_e, importer_scope)
                        if section == 2 and indent < 8 and importer_name_s >= 0:
                            importer_name_s <- -1
                            importer_name_e <- -1
                            importer_spec_s <- -1
                            importer_spec_e <- -1
                            importer_ver_s <- -1
                            importer_ver_e <- -1
                        if section == 3 and indent <= 4:
                            package_resolution_nested <- false
                            package_resolution_seen <- false if indent == 2
                            package_metadata_skip <- false
                        if section == 4 and indent < 6:
                            snapshot_scope <- -1
                            peer_list_skip <- false
                        if section == 3 and package_metadata_skip and indent > 4:
                            pos <- line_end + 1
                            continue
                        if indent == 0:
                            key_s: mutable i64 = 0
                            key_e: mutable i64 = 0
                            value_s: mutable i64 = 0
                            value_e: mutable i64 = 0
                            return -1 if not rh_pnpm_pair(lock, start.usize(), end.usize(), pool, &key_s, &key_e, &value_s, &value_e)
                            if rh_span_lit(pool, key_s.usize(), key_e.usize(), "lockfileVersion"):
                                return -1 if lock_version_seen or value_s >= value_e
                                version_s: mutable i64 = -1
                                version_e: mutable i64 = -1
                                return -1 if not rh_pnpm_scalar(lock, value_s.usize(), value_e.usize(), pool, &version_s, &version_e)
                                return -1 if not rh_span_lit(pool, version_s.usize(), version_e.usize(), "9.0")
                                lock_version_seen <- true
                            elif rh_span_lit(pool, key_s.usize(), key_e.usize(), "settings"):
                                return -1 if settings_seen or value_s < value_e
                                settings_seen <- true
                                section <- 1
                            elif rh_span_lit(pool, key_s.usize(), key_e.usize(), "importers"):
                                return -1 if importers_seen or value_s < value_e
                                importers_seen <- true
                                section <- 2
                            elif rh_span_lit(pool, key_s.usize(), key_e.usize(), "packages"):
                                return -1 if packages_seen or value_s < value_e or not importers_seen
                                packages_seen <- true
                                section <- 3
                            elif rh_span_lit(pool, key_s.usize(), key_e.usize(), "snapshots"):
                                return -1 if snapshots_seen or value_s < value_e or not packages_seen
                                snapshots_seen <- true
                                section <- 4
                            else:
                                return -1
                        elif section == 1:
                            return -1 if indent != 2
                            key_s: mutable i64 = 0
                            key_e: mutable i64 = 0
                            value_s: mutable i64 = 0
                            value_e: mutable i64 = 0
                            return -1 if not rh_pnpm_pair(lock, start.usize(), end.usize(), pool, &key_s, &key_e, &value_s, &value_e)
                            return -1 if not rh_pnpm_setting_known(pool, key_s.usize(), key_e.usize()) or value_s >= value_e
                            valid_setting: bool =
                                setting_s: mutable i64 = -1
                                setting_e: mutable i64 = -1
                                rh_pnpm_scalar(lock, value_s.usize(), value_e.usize(), pool, &setting_s, &setting_e)
                            return -1 if not valid_setting
                        elif section == 2:
                            key_s: mutable i64 = 0
                            key_e: mutable i64 = 0
                            value_s: mutable i64 = 0
                            value_e: mutable i64 = 0
                            return -1 if not rh_pnpm_pair(lock, start.usize(), end.usize(), pool, &key_s, &key_e, &value_s, &value_e)
                            if indent == 2:
                                return -1 if importer_count > 0 or value_s < value_e or not rh_span_lit(pool, key_s.usize(), key_e.usize(), ".")
                                importer_count <- importer_count + 1
                                root_importer_seen <- true
                                importer_scope <- -1
                            elif indent == 4:
                                return -1 if not root_importer_seen or value_s < value_e
                                importer_scope <- -1
                                importer_scope <- 0 if rh_span_lit(pool, key_s.usize(), key_e.usize(), "dependencies")
                                importer_scope <- 1 if rh_span_lit(pool, key_s.usize(), key_e.usize(), "devDependencies")
                                importer_scope <- 2 if rh_span_lit(pool, key_s.usize(), key_e.usize(), "optionalDependencies")
                                return -1 if importer_scope < 0
                            elif indent == 6:
                                return -1 if importer_scope < 0 or importer_name_s >= 0 or value_s < value_e
                                importer_name_s <- key_s
                                importer_name_e <- key_e
                            elif indent == 8:
                                return -1 if importer_name_s < 0 or value_s >= value_e
                                field_s: mutable i64 = -1
                                field_e: mutable i64 = -1
                                return -1 if not rh_pnpm_scalar(lock, value_s.usize(), value_e.usize(), pool, &field_s, &field_e)
                                if rh_span_lit(pool, key_s.usize(), key_e.usize(), "specifier"):
                                    return -1 if importer_spec_s >= 0
                                    importer_spec_s <- field_s
                                    importer_spec_e <- field_e
                                elif rh_span_lit(pool, key_s.usize(), key_e.usize(), "version"):
                                    return -1 if importer_ver_s >= 0
                                    importer_ver_s <- field_s
                                    importer_ver_e <- field_e
                                else:
                                    return -1
                            else:
                                return -1
                        elif section == 3:
                            if indent == 2:
                                key_s: mutable i64 = 0
                                key_e: mutable i64 = 0
                                value_s: mutable i64 = 0
                                value_e: mutable i64 = 0
                                return -1 if packages.count.i64() >= 200000 or not rh_pnpm_pair(lock, start.usize(), end.usize(), pool, &key_s, &key_e, &value_s, &value_e)
                                return -1 if value_s < value_e and not rh_span_lit(lock, value_s.usize(), value_e.usize(), "{}")
                                name_s: mutable i64 = -1
                                name_e: mutable i64 = -1
                                ver_s: mutable i64 = -1
                                ver_e: mutable i64 = -1
                                return -1 if not rh_pnpm_id_parts(pool, key_s.usize(), key_e.usize(), &name_s, &name_e, &ver_s, &ver_e, false)
                                return -1 if rh_pnpm_find_package(packages, pool, name_s.usize(), name_e.usize(), ver_s.usize(), ver_e.usize()) >= 0
                                source_kind: u8 = rh_pnpm_source_for_version(pool, ver_s.usize(), ver_e.usize())
                                packages.push(RhPnpmPackage{name_s: name_s, name_e: name_e, ver_s: ver_s, ver_e: ver_e, origin_s: -1, origin_e: -1, digest_s: -1, digest_e: -1, src_kind: source_kind})
                                current_package <- packages.count.i64() - 1
                                package_resolution_nested <- false
                                package_resolution_seen <- false
                            elif indent == 4:
                                return -1 if current_package < 0
                                key_s: mutable i64 = 0
                                key_e: mutable i64 = 0
                                value_s: mutable i64 = 0
                                value_e: mutable i64 = 0
                                return -1 if not rh_pnpm_pair(lock, start.usize(), end.usize(), pool, &key_s, &key_e, &value_s, &value_e)
                                if rh_span_lit(pool, key_s.usize(), key_e.usize(), "resolution"):
                                    return -1 if package_resolution_seen
                                    package_resolution_seen <- true
                                    if value_s >= value_e:
                                        package_resolution_nested <- true
                                    else:
                                        return -1 if not rh_pnpm_inline_resolution(lock, value_s.usize(), value_e.usize(), pool, packages, current_package)
                                elif rh_pnpm_package_field_known(pool, key_s.usize(), key_e.usize()):
                                    if value_s < value_e:
                                        valid_metadata_scalar: bool =
                                            field_s: mutable i64 = -1
                                            field_e: mutable i64 = -1
                                            rh_pnpm_scalar(lock, value_s.usize(), value_e.usize(), pool, &field_s, &field_e)
                                        return -1 if not valid_metadata_scalar
                                    else:
                                        package_metadata_skip <- true
                                else:
                                    return -1
                            elif indent == 6 and package_resolution_nested:
                                key_s: mutable i64 = 0
                                key_e: mutable i64 = 0
                                value_s: mutable i64 = 0
                                value_e: mutable i64 = 0
                                return -1 if not rh_pnpm_pair(lock, start.usize(), end.usize(), pool, &key_s, &key_e, &value_s, &value_e)
                                return -1 if value_s >= value_e or not rh_pnpm_resolution_field(lock, value_s.usize(), value_e.usize(), pool, packages, current_package, key_s.usize(), key_e.usize())
                            else:
                                return -1
                        elif section == 4:
                            if indent == 2:
                                key_s: mutable i64 = 0
                                key_e: mutable i64 = 0
                                value_s: mutable i64 = 0
                                value_e: mutable i64 = 0
                                return -1 if snapshots.count.i64() >= 200000 or not rh_pnpm_pair(lock, start.usize(), end.usize(), pool, &key_s, &key_e, &value_s, &value_e)
                                return -1 if value_s < value_e and not rh_span_lit(lock, value_s.usize(), value_e.usize(), "{}")
                                name_s: mutable i64 = -1
                                name_e: mutable i64 = -1
                                ver_s: mutable i64 = -1
                                ver_e: mutable i64 = -1
                                return -1 if not rh_pnpm_id_parts(pool, key_s.usize(), key_e.usize(), &name_s, &name_e, &ver_s, &ver_e, true)
                                package_index: i64 = rh_pnpm_find_package(packages, pool, name_s.usize(), name_e.usize(), ver_s.usize(), ver_e.usize())
                                return -1 if package_index < 0
                                return -1 if rh_pnpm_snapshot_duplicate(snapshots, pool, key_s.usize(), key_e.usize())
                                package: RhPnpmPackage = packages[package_index.usize()]
                                node_index: i64 = rh_node_add(pkgs, RH_ECO_NPM)
                                return -1 if node_index < 0
                                node: mutable RhPkgNode = pkgs[node_index.usize()]
                                node.name_s <- name_s
                                node.name_e <- name_e
                                node.ver_s <- ver_s
                                node.ver_e <- ver_e
                                node.src_kind <- package.src_kind
                                node.origin_s <- package.origin_s
                                node.origin_e <- package.origin_e
                                if package.digest_s >= 0:
                                    node.has_digest <- 1
                                    node.dig_s <- package.digest_s
                                    node.dig_e <- package.digest_e
                                pkgs[node_index.usize()] <- node
                                snapshots.push(RhPnpmSnapshot{key_s: key_s, key_e: key_e, node: node_index})
                                current_snapshot <- snapshots.count.i64() - 1
                                snapshot_scope <- -1
                                peer_list_skip <- false
                            elif indent == 4:
                                return -1 if current_snapshot < 0
                                key_s: mutable i64 = 0
                                key_e: mutable i64 = 0
                                value_s: mutable i64 = 0
                                value_e: mutable i64 = 0
                                return -1 if not rh_pnpm_pair(lock, start.usize(), end.usize(), pool, &key_s, &key_e, &value_s, &value_e)
                                if rh_span_lit(pool, key_s.usize(), key_e.usize(), "dependencies"):
                                    return -1 if value_s < value_e
                                    snapshot_scope <- 0
                                    peer_list_skip <- false
                                elif rh_span_lit(pool, key_s.usize(), key_e.usize(), "optionalDependencies"):
                                    return -1 if value_s < value_e
                                    snapshot_scope <- 2
                                    peer_list_skip <- false
                                elif rh_span_lit(pool, key_s.usize(), key_e.usize(), "transitivePeerDependencies"):
                                    snapshot_scope <- 5
                                    peer_list_skip <- value_s == value_e
                                    if value_s < value_e:
                                        list_s: mutable i64 = -1
                                        list_e: mutable i64 = -1
                                        return -1 if not rh_pnpm_scalar(lock, value_s.usize(), value_e.usize(), pool, &list_s, &list_e)
                                        return -1 if list_e - list_s < 2 or pool[list_s.usize()] != 91 or pool[list_e.usize() - 1] != 93
                                else:
                                    return -1
                            elif indent == 6 and snapshot_scope == 5 and peer_list_skip:
                                return -1 if lock[start.usize()] != 45 or start.usize() + 1 >= end.usize() or lock[start.usize() + 1] != 32
                                valid_peer_item: bool =
                                    peer_s: mutable i64 = -1
                                    peer_e: mutable i64 = -1
                                    rh_pnpm_scalar(lock, start.usize() + 2, end.usize(), pool, &peer_s, &peer_e)
                                return -1 if not valid_peer_item
                            elif indent == 6 and (snapshot_scope == 0 or snapshot_scope == 2):
                                key_s: mutable i64 = 0
                                key_e: mutable i64 = 0
                                value_s: mutable i64 = 0
                                value_e: mutable i64 = 0
                                return -1 if reqs.count.i64() >= 200000 or not rh_pnpm_pair(lock, start.usize(), end.usize(), pool, &key_s, &key_e, &value_s, &value_e)
                                return -1 if value_s >= value_e
                                locked_s: mutable i64 = -1
                                locked_e: mutable i64 = -1
                                return -1 if not rh_pnpm_scalar(lock, value_s.usize(), value_e.usize(), pool, &locked_s, &locked_e)
                                snapshot: RhPnpmSnapshot = snapshots[current_snapshot.usize()]
                                reqs.push(RhRequire{from: snapshot.node, name_s: key_s, name_e: key_e, ver_s: locked_s, ver_e: locked_e, src_s: -1, src_e: -1, req_s: locked_s, req_e: locked_e, depctx: snapshot_scope.u8(), optional: 0})
                            else:
                                return -1
                        else:
                            return -1
                pos <- line_end + 1
            return -1 if not lock_version_seen or not importers_seen or not root_importer_seen or not packages_seen or not snapshots_seen
            return -1 if not rh_pnpm_importer_flush(reqs, importer_name_s, importer_name_e, importer_spec_s, importer_spec_e, importer_ver_s, importer_ver_e, importer_scope)
            _ = rh_pnpm_resolve(pool, snapshots, reqs, edges, unresolved)
            root

        def rh_span_eq_text(texts: darray[u8]&, s: usize, e: usize, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s.i64(), e.i64(), lit)

        # --- Bounded graph queries (M03-06/M05-05 subset). BFS over outgoing
        # edges with a visited set, depth limit, and truncation flag (never a
        # fabricated total when truncated). Reverse BFS over incoming edges for
        # dependent counts. Witness paths via parent pointers (bounded length).
        # Budgets: node/edge visits counted; exceeding max_visits stops with
        # truncated=1 (S012).

        def rh_graph_out_count(edges: darray[RhDepEdge]&, node: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < edges.count.i64() |total: i64 = 0, i: i64 = 0| -> total:
                if edges[i.usize()].from == node:
                    total <- total + 1
                i <- i + 1

        def rh_graph_in_count(edges: darray[RhDepEdge]&, node: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < edges.count.i64() |total: i64 = 0, i: i64 = 0| -> total:
                if edges[i.usize()].dst == node:
                    total <- total + 1
                i <- i + 1

        # Direct dependency projections use the selected graph root. Requirements
        # and unresolved records remain distinct from exact edges; resolved
        # versions are counted as unique destination nodes even when scopes
        # produce duplicate edge records.
        def rh_direct_requirement_count(reqs: mutable darray[RhRequire]&, root: mutable i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < reqs.count |total: i64 = 0, i: i64 = 0, reqs, root| -> total:
                total <- total + 1 if reqs[i.usize()].from == root
                i <- i + 1

        def rh_direct_unresolved_count(unresolved: mutable darray[RhUnresolved]&, root: mutable i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < unresolved.count |total: i64 = 0, i: i64 = 0, unresolved, root| -> total:
                total <- total + 1 if unresolved[i.usize()].from == root
                i <- i + 1

        # Count declarations by their source-native dependency scope.
        # `declared` is an explicit unknown scope (for example Gemfile.lock's
        # DEPENDENCIES block), never an inferred runtime dependency.
        def rh_scope_count(reqs: mutable darray[RhRequire]&, scope: mutable u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < reqs.count |total: i64 = 0, i: i64 = 0, reqs, scope| -> total:
                total <- total + 1 if reqs[i.usize()].depctx == scope
                i <- i + 1

        def rh_direct_scope_count(reqs: mutable darray[RhRequire]&, root: mutable i64, scope: mutable u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < reqs.count |total: i64 = 0, i: i64 = 0, reqs, root, scope| -> total:
                total <- total + 1 if reqs[i.usize()].from == root and reqs[i.usize()].depctx == scope
                i <- i + 1

        # A requirement is pinned only when its source carries a literal exact
        # version. Ranges, aliases, paths, URLs, and missing version text remain
        # unpinned even when a lockfile happens to contain a candidate node.
        def rh_requirement_is_pinned(req: RhRequire, pool: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if req.ver_s >= 0 and req.ver_e > req.ver_s
            return false if req.req_s < 0 or req.req_e <= req.req_s
            s: mutable usize = req.req_s.usize()
            e: mutable usize = req.req_e.usize()
            pool_loop: mutable darray[u8]& = pool
            while s < e and (pool_loop[s] == 32 or pool_loop[s] == 9) |s, e, pool_loop|:
                s <- s + 1
            while e > s and (pool_loop[e - 1] == 32 or pool_loop[e - 1] == 9) |s, e, pool_loop|:
                e <- e - 1
            if e - s >= 2 and pool_loop[s] == 61 and pool_loop[s + 1] == 61:
                s <- s + 2
                s <- s + 1 if s < e and pool_loop[s] == 61
            return false if s >= e
            while i < e - s |i: usize = 0, s, e, pool_loop|:
                b: u8 = pool_loop[s + i]
                return false if b == 32 or b == 9 or b == 33 or b == 42 or b == 44 or b == 60 or b == 62 or b == 94 or b == 124 or b == 58 or b == 47
                i <- i + 1
            dots: mutable i64 = 0
            while i < e - s |i: usize = 0, s, e, pool_loop, dots|:
                dots <- dots + 1 if pool_loop[s + i] == 46
                i <- i + 1
            dots >= 2

        def rh_unpinned_requirement_count(reqs: mutable darray[RhRequire]&, pool: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            pool_loop: mutable darray[u8]& = pool
            while i < reqs.count |total: i64 = 0, i: i64 = 0, reqs, pool_loop| -> total:
                total <- total + 1 if not rh_requirement_is_pinned(reqs[i.usize()], pool_loop)
                i <- i + 1

        # Count unique resolved destination nodes, optionally restricted to nodes
        # carrying an observed artifact digest. Requirements and edges can repeat
        # a destination under different scopes, so the denominator is node-based.
        def rh_resolved_node_metric_count(pkgs: mutable darray[RhPkgNode]&, edges: mutable darray[RhDepEdge]&, known_only: bool) -> i64 can[Memory.Allocate, Abort.Panic]:
            seen: mutable darray[i64] = []
            known_only_loop: mutable bool = known_only
            while i < edges.count |total: i64 = 0, i: i64 = 0, pkgs, edges, seen, known_only_loop| -> total:
                node: i64 = edges[i.usize()].dst
                return total if node < 0 or node >= pkgs.count.i64()
                already: bool = rh_visited_has(seen, node)
                if not already:
                    seen.push(node)
                    total <- total + 1 if not known_only_loop or pkgs[node.usize()].has_digest == 1
                i <- i + 1

        # Count unique resolved destination nodes whose version/range context is
        # unavailable to an advisory matcher. A node without a version is an
        # explicit unknown, never a non-match; duplicate scoped edges count once.
        def rh_advisory_unknown_node_count(pkgs: mutable darray[RhPkgNode]&, edges: mutable darray[RhDepEdge]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            seen: mutable darray[i64] = []
            while i < edges.count |total: i64 = 0, i: i64 = 0, pkgs, edges, seen| -> total:
                node: i64 = edges[i.usize()].dst
                return total if node < 0 or node >= pkgs.count.i64()
                if pkgs[node.usize()].ver_s < 0 and not rh_visited_has(seen, node):
                    seen.push(node)
                    total <- total + 1
                i <- i + 1

        # Maximum shortest-path depth from a selected root over the observed
        # resolved graph. The finite node count bounds traversal in cycles.
        def rh_max_dependency_depth(edges: mutable darray[RhDepEdge]&, node_count: mutable i64, root: mutable i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if node_count <= 0 or root < 0 or root >= node_count
            frontier: mutable darray[i64] = []
            depths: mutable darray[i64] = []
            seen: mutable darray[i64] = []
            frontier.push(root)
            depths.push(0)
            max_depth: mutable i64 = 0
            while fi < frontier.count |fi: i64 = 0, frontier, depths, seen, edges, max_depth|:
                cur: i64 = frontier[fi.usize()]
                depth: i64 = depths[fi.usize()]
                fi <- fi + 1
                continue if rh_visited_has(seen, cur)
                seen.push(cur)
                max_depth <- depth if depth > max_depth
                while ei < edges.count |ei: i64 = 0, edges, cur, depth, frontier, depths, seen|:
                    edge: RhDepEdge = edges[ei.usize()]
                    if edge.from == cur and not rh_visited_has(seen, edge.dst):
                        frontier.push(edge.dst)
                        depths.push(depth + 1)
                    ei <- ei + 1
            max_depth

        # True only when no unresolved requirement is attached to a node reachable
        # from the selected root. Unresolved records outside that projection do not
        # make the selected context incomplete.
        def rh_resolution_complete(edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, node_count: mutable i64, root: mutable i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if node_count <= 0 or root < 0 or root >= node_count
            reachable: mutable darray[i64] = []
            frontier: mutable darray[i64] = []
            frontier.push(root)
            while fi < frontier.count |fi: i64 = 0, frontier, reachable, edges|:
                cur: i64 = frontier[fi.usize()]
                fi <- fi + 1
                continue if rh_visited_has(reachable, cur)
                reachable.push(cur)
                while ei < edges.count |ei: i64 = 0, edges, cur, frontier, reachable|:
                    edge: RhDepEdge = edges[ei.usize()]
                    frontier.push(edge.dst) if edge.from == cur and not rh_visited_has(reachable, edge.dst)
                    ei <- ei + 1
            while i < unresolved.count |i: i64 = 0, unresolved, reachable|:
                return false if rh_visited_has(reachable, unresolved[i.usize()].from)
                i <- i + 1
            true

        # Count resolved graph relations by their preserved source scope. A
        # declaration can remain unresolved, so these counts intentionally do
        # not have to sum to the requirement-scope counts.
        def rh_edge_scope_count(edges: mutable darray[RhDepEdge]&, scope: mutable u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < edges.count |total: i64 = 0, i: i64 = 0, edges, scope| -> total:
                total <- total + 1 if edges[i.usize()].depctx == scope
                i <- i + 1

        def rh_direct_resolved_count(edges: mutable darray[RhDepEdge]&, root: mutable i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            seen: mutable darray[i64] = []
            while i < edges.count |i: i64 = 0, edges, root, seen| -> seen.count.i64():
                e: mutable RhDepEdge = edges[i.usize()]
                if e.from == root:
                    already: bool =
                        while j < seen.count |already: bool = false, j: i64 = 0, seen, e| -> already:
                            already <- true if seen[j.usize()] == e.dst
                            j <- j + 1
                    seen.push(e.dst) if not already
                i <- i + 1

        def rh_visited_has(visited: darray[i64]&, node: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < visited.count |i: usize = 0, visited, node|:
                return true if visited[i] == node
                i <- i + 1
            false

        # Complete reachability from one root over the finite graph. The node
        # count bounds the walk, so cycles terminate without an arbitrary depth
        # parameter; the root itself is excluded from the returned count.
        def rh_reachable_dependency_count(edges: mutable darray[RhDepEdge]&, node_count: mutable i64, root: mutable i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if node_count <= 0 or root < 0 or root >= node_count
            frontier: mutable darray[i64] = []
            seen: mutable darray[i64] = []
            frontier.push(root)
            while fi < frontier.count |fi: i64 = 0, frontier, seen, edges, node_count|:
                cur: mutable i64 = frontier[fi.usize()]
                fi <- fi + 1
                continue if rh_visited_has(seen, cur)
                seen.push(cur)
                return seen.count.i64() - 1 if seen.count.i64() >= node_count
                while ei < edges.count.i64() |ei: i64 = 0, edges, cur, frontier, seen|:
                    edge: mutable RhDepEdge = edges[ei.usize()]
                    if edge.from == cur and not rh_visited_has(seen, edge.dst):
                        frontier.push(edge.dst)
                    ei <- ei + 1
            seen.count.i64() - 1

        # Forward BFS from roots. visited_out collects unique reachable nodes
        # EXCLUDING the roots themselves; trunc_out 1 when a budget/depth limit
        # stopped the walk. Returns the visited count, or -1 on bad input.
        def rh_graph_bfs(edges: darray[RhDepEdge]&, node_count: i64, roots: darray[i64]&, max_depth: i64, max_visits: i64, visited_out: mutable darray[i64]&, trunc_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            trunc_out[0] <- 0
            return -1 if max_depth < 0 or max_visits <= 0
            frontier: mutable darray[i64] = []
            depths: mutable darray[i64] = []
            while r < roots.count |r: usize = 0, roots, frontier, depths|:
                frontier.push(roots[r])
                depths.push(0)
                r <- r + 1
            seen: mutable darray[i64] = []
            while fi < frontier.count |fi: usize = 0, frontier, depths, edges, node_count, max_depth, max_visits, visited_out, seen, trunc_out|:
                if visited_out.count.i64() + seen.count.i64() >= max_visits:
                    trunc_out[0] <- 1
                    fi <- frontier.count
                    continue
                cur: i64 = frontier[fi]
                dep: i64 = depths[fi]
                fi <- fi + 1
                if cur < 0 or cur >= node_count:
                    trunc_out[0] <- 1
                    continue
                continue if rh_visited_has(seen, cur)
                seen.push(cur)
                if dep >= max_depth:
                    trunc_out[0] <- 1
                    continue
                while e < edges.count.i64() |e: i64 = 0, edges, cur, frontier, depths, seen, visited_out|:
                    ed: RhDepEdge = edges[e.usize()]
                    if ed.from == cur and not rh_visited_has(seen, ed.dst):
                        frontier.push(ed.dst)
                        depths.push(dep + 1)
                    e <- e + 1
            while k < seen.count |k: usize = 0, seen, visited_out, roots|:
                keep: bool =
                    while q < roots.count |keep: bool = true, q: usize = 0, seen, k| -> keep:
                        if seen[k] == roots[q]:
                            keep <- false
                        q <- q + 1
                if keep:
                    visited_out.push(seen[k])
                k <- k + 1
            visited_out.count.i64()

        # Reverse BFS (dependents): same contract over incoming edges.
        def rh_graph_rbfs(edges: darray[RhDepEdge]&, node_count: i64, roots: darray[i64]&, max_depth: i64, max_visits: i64, visited_out: mutable darray[i64]&, trunc_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            trunc_out[0] <- 0
            return -1 if max_depth < 0 or max_visits <= 0
            frontier: mutable darray[i64] = []
            depths: mutable darray[i64] = []
            while r < roots.count |r: usize = 0, roots, frontier, depths|:
                frontier.push(roots[r])
                depths.push(0)
                r <- r + 1
            seen: mutable darray[i64] = []
            while fi < frontier.count |fi: usize = 0, frontier, depths, edges, node_count, max_depth, max_visits, visited_out, seen, trunc_out|:
                if visited_out.count.i64() + seen.count.i64() >= max_visits:
                    trunc_out[0] <- 1
                    fi <- frontier.count
                    continue
                cur: i64 = frontier[fi]
                dep: i64 = depths[fi]
                fi <- fi + 1
                if cur < 0 or cur >= node_count:
                    trunc_out[0] <- 1
                    continue
                continue if rh_visited_has(seen, cur)
                seen.push(cur)
                if dep >= max_depth:
                    trunc_out[0] <- 1
                    continue
                while e < edges.count.i64() |e: i64 = 0, edges, cur, frontier, depths, seen, visited_out|:
                    ed: RhDepEdge = edges[e.usize()]
                    if ed.dst == cur and not rh_visited_has(seen, ed.from):
                        frontier.push(ed.from)
                        depths.push(dep + 1)
                    e <- e + 1
            while k < seen.count |k: usize = 0, seen, visited_out, roots|:
                keep: bool =
                    while q < roots.count |keep: bool = true, q: usize = 0, seen, k| -> keep:
                        if seen[k] == roots[q]:
                            keep <- false
                        q <- q + 1
                if keep:
                    visited_out.push(seen[k])
                k <- k + 1
            visited_out.count.i64()

        # Witness path root -> target over outgoing edges (BFS parents, bounded).
        # Writes node indices into path_out; returns length, 0 when unreachable,
        # -1 on bad input. Deterministic: first discovery wins.
        def rh_graph_witness(edges: darray[RhDepEdge]&, node_count: i64, root: i64, target: i64, max_depth: i64, path_out: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if root < 0 or root >= node_count or target < 0 or target >= node_count
            return -1 if max_depth < 0
            if root == target:
                path_out.push(root)
                return 1
            parent: mutable darray[i64] = []
            depth_of: mutable darray[i64] = []
            while i < node_count |i: i64 = 0, parent, depth_of|:
                parent.push(-2)
                depth_of.push(-1)
                i <- i + 1
            parent[root.usize()] <- -1
            depth_of[root.usize()] <- 0
            frontier: mutable darray[i64] = []
            frontier.push(root)
            found: bool =
                while fi < frontier.count |fi: usize = 0, found: bool = false, frontier, parent, depth_of| -> found:
                    cur: i64 = frontier[fi]
                    fi <- fi + 1
                    if cur == target:
                        found <- true
                        fi <- frontier.count
                        continue
                    continue if depth_of[cur.usize()] >= max_depth
                    while e < edges.count.i64() |e: i64 = 0, edges, cur, frontier, parent, depth_of, target, found|:
                        ed: RhDepEdge = edges[e.usize()]
                        if ed.from == cur and parent[ed.dst.usize()] == -2:
                            parent[ed.dst.usize()] <- cur
                            depth_of[ed.dst.usize()] <- depth_of[cur.usize()] + 1
                            if ed.dst == target:
                                found <- true
                                e <- edges.count.i64()
                            else:
                                frontier.push(ed.dst)
                        e <- e + 1
            return 0 if not found
            rev: mutable darray[i64] = []
            while walker >= 0 |walker: i64 = target, guard: i64 = 0, parent, rev, node_count|:
                rev.push(walker)
                if walker == root:
                    walker <- -1
                else:
                    return -1 if guard > node_count + 5
                    guard <- guard + 1
                    walker <- parent[walker.usize()]
            while k > 0 |k: usize = rev.count, rev, path_out|:
                k <- k - 1
                path_out.push(rev[k])
            path_out.count.i64()

        struct RhAliasRef:
            cand: mutable i64
            s: mutable i64
            e: mutable i64

        struct RhCandidate:
            node: mutable i64
            adv_s: mutable i64
            adv_e: mutable i64
            fix_s: mutable i64
            fix_e: mutable i64

        # Span equality inside one buffer (advisory id/alias comparison: exact,
        # case-sensitive — identifiers, not package names).
        def rh_span_eq_same(data: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_span(data, s1.i64(), e1.i64(), data, s2.i64(), e2.i64())

        # Top-level OSV match over our inventory nodes. vulns_root is either the
        # response object (with "vulns") or the array itself. Findings merge by
        # shared id/alias; withdrawn and unusable records are counted, not
        # matched. Returns finding count, or -1 on malformed input.
        def rh_osv_match(pkgs: darray[RhPkgNode]&, pool: mutable darray[u8]&, jnodes: darray[Json::RhJsonNode]&, jtexts: darray[u8]&, vulns_root: i64, findings: mutable darray[RhAdvisory]&, withdrawn_out: mutable i64&, skipped_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            withdrawn_out[0] <- 0
            skipped_out[0] <- 0
            return -1 if vulns_root < 0
            vr: Json::RhJsonNode = jnodes[vulns_root.usize()]
            arr: mutable i64 = vulns_root
            if vr.kind == 4:
                arr <- vulns_root
            else:
                return -1 if vr.kind != 5
                arr <- Json::rh_json_obj_get(jnodes, jtexts, vulns_root, "vulns")
                return -1 if arr < 0
            ar: Json::RhJsonNode = jnodes[arr.usize()]
            return -1 if ar.kind != 4
            cands: mutable darray[RhCandidate] = []
            aliases: mutable darray[RhAliasRef] = []
            while vi < ar.child_count |vi: i64 = 0, jnodes, jtexts, pkgs, pool, cands, aliases, withdrawn_out, skipped_out|:
                vobj: i64 = Json::rh_json_arr_get(jnodes, arr, vi)
                vi <- vi + 1
                if vobj < 0:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                vo: Json::RhJsonNode = jnodes[vobj.usize()]
                if vo.kind != 5:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                wdi: i64 = Json::rh_json_obj_get(jnodes, jtexts, vobj, "withdrawn")
                if wdi >= 0:
                    withdrawn_out[0] <- withdrawn_out[0] + 1
                    continue
                idi: i64 = Json::rh_json_obj_get(jnodes, jtexts, vobj, "id")
                if idi < 0:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                idn: Json::RhJsonNode = jnodes[idi.usize()]
                if idn.kind != 3:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                aff: i64 = Json::rh_json_obj_get(jnodes, jtexts, vobj, "affected")
                if aff < 0:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                afn: Json::RhJsonNode = jnodes[aff.usize()]
                if afn.kind != 4:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                while ai2 < afn.child_count |ai2: i64 = 0, jnodes, jtexts, pkgs, pool, cands, aliases, vobj, idn, skipped_out|:
                    aobj: i64 = Json::rh_json_arr_get(jnodes, aff, ai2)
                    ai2 <- ai2 + 1
                    continue if aobj < 0
                    ao: Json::RhJsonNode = jnodes[aobj.usize()]
                    continue if ao.kind != 5
                    pkg: i64 = Json::rh_json_obj_get(jnodes, jtexts, aobj, "package")
                    continue if pkg < 0
                    po2: Json::RhJsonNode = jnodes[pkg.usize()]
                    continue if po2.kind != 5
                    nm: i64 = Json::rh_json_obj_get(jnodes, jtexts, pkg, "name")
                    ec: i64 = Json::rh_json_obj_get(jnodes, jtexts, pkg, "ecosystem")
                    continue if nm < 0 or ec < 0
                    nmn: Json::RhJsonNode = jnodes[nm.usize()]
                    ecn: Json::RhJsonNode = jnodes[ec.usize()]
                    continue if nmn.kind != 3 or ecn.kind != 3
                    while ni < pkgs.count.i64() |ni: i64 = 0, pkgs, pool, jnodes, jtexts, nmn, ecn, aobj, vobj, idn, cands, aliases|:
                        nd: RhPkgNode = pkgs[ni.usize()]
                        if not rh_osv_eco_ok(nd.eco, jtexts, ecn.text_start.usize(), ecn.text_end.usize()):
                            ni <- ni + 1
                            continue
                        if nd.ver_s < 0:
                            ni <- ni + 1
                            continue
                        cand_ns: i64 = rh_pool_copy(pool, jtexts, nmn.text_start.usize(), nmn.text_end.usize())
                        cand_ne: i64 = pool.count.i64()
                        if not rh_name_eq(nd.eco, pool, nd.name_s.usize(), nd.name_e.usize(), cand_ns.usize(), cand_ne.usize()):
                            ni <- ni + 1
                            continue
                        vv: mutable RhSemver = RhSemver{major: 0, minor: 0, patch: 0, pre_s: 0, pre_e: 0}
                        if not rh_semver_parse(pool, nd.ver_s.usize(), nd.ver_e.usize(), &vv):
                            ni <- ni + 1
                            continue
                        ranges: i64 = Json::rh_json_obj_get(jnodes, jtexts, aobj, "ranges")
                        matched_here: mutable bool = false
                        fix_s: mutable i64 = -1
                        fix_e: mutable i64 = -1
                        has_ranges: bool = ranges >= 0
                        if has_ranges:
                            rn2: Json::RhJsonNode = jnodes[ranges.usize()]
                            if rn2.kind == 4:
                                while rg < rn2.child_count |rg: i64 = 0, jnodes, jtexts, pool, vv, matched_here|:
                                    robj: i64 = Json::rh_json_arr_get(jnodes, ranges, rg)
                                    rg <- rg + 1
                                    continue if robj < 0
                                    evts: mutable darray[i64] = []
                                    triples: i64 = rh_osv_collect_events(jnodes, jtexts, robj, evts)
                                    continue if triples <= 0
                                    verdict: i64 = rh_osv_version_in_events(pool, &vv, evts, triples, jtexts)
                                    if verdict == 1:
                                        matched_here <- true
                                        fs2: mutable i64 = -1
                                        fe2: mutable i64 = -1
                                        if rh_osv_first_fixed(jnodes, jtexts, aobj, &fs2, &fe2):
                                            fix_s <- fs2
                                            fix_e <- fe2
                                        rg <- rn2.child_count
                                if matched_here:
                                    ci: i64 = cands.count.i64()
                                    cands.push(RhCandidate{node: ni, adv_s: idn.text_start, adv_e: idn.text_end, fix_s: fix_s, fix_e: fix_e})
                                    rh_osv_collect_aliases(jnodes, jtexts, vobj, ci, aliases)
                        if not has_ranges:
                            vers: i64 = Json::rh_json_obj_get(jnodes, jtexts, aobj, "versions")
                            if vers >= 0:
                                vsn: Json::RhJsonNode = jnodes[vers.usize()]
                                if vsn.kind == 4:
                                    while q < vsn.child_count |q: i64 = 0, jnodes, jtexts, pool, vv, matched_here|:
                                        sentry: i64 = Json::rh_json_arr_get(jnodes, vers, q)
                                        q <- q + 1
                                        continue if sentry < 0
                                        sn2: Json::RhJsonNode = jnodes[sentry.usize()]
                                        continue if sn2.kind != 3
                                        sps: i64 = rh_pool_copy(pool, jtexts, sn2.text_start.usize(), sn2.text_end.usize())
                                        spe: i64 = pool.count.i64()
                                        sv: mutable RhSemver = RhSemver{major: 0, minor: 0, patch: 0, pre_s: 0, pre_e: 0}
                                        if rh_semver_parse(pool, sps.usize(), spe.usize(), &sv):
                                            if rh_semver_cmp(pool, &vv, &sv) == 0:
                                                matched_here <- true
                                    if matched_here:
                                        ci2: i64 = cands.count.i64()
                                        cands.push(RhCandidate{node: ni, adv_s: idn.text_start, adv_e: idn.text_end, fix_s: -1, fix_e: -1})
                                        rh_osv_collect_aliases(jnodes, jtexts, vobj, ci2, aliases)
                        ni <- ni + 1
            groups: mutable darray[i64] = []
            while gi < cands.count.i64() |gi: i64 = 0, groups|:
                groups.push(gi)
                gi <- gi + 1
            while a2 < cands.count.i64() |a2: i64 = 0, cands, groups, aliases, jtexts|:
                while b2 < cands.count.i64() |b2: i64 = a2 + 1, a2, cands, groups, aliases, jtexts|:
                    if groups[a2.usize()] != groups[b2.usize()] and rh_cand_shared(cands, aliases, jtexts, a2, b2):
                        old: i64 = groups[b2.usize()]
                        nw: i64 = groups[a2.usize()]
                        while g < groups.count.i64() |g: i64 = 0, groups, old, nw|:
                            if groups[g.usize()] == old:
                                groups[g.usize()] <- nw
                            g <- g + 1
                    b2 <- b2 + 1
                a2 <- a2 + 1
            seen_group: mutable darray[i64] = []
            while f < cands.count.i64() |f: i64 = 0, cands, groups, seen_group, findings|:
                g2: i64 = groups[f.usize()]
                dup: bool =
                    while h < seen_group.count |dup: bool = false, h: usize = 0, seen_group| -> dup:
                        if seen_group[h] == g2:
                            dup <- true
                        h <- h + 1
                if not dup:
                    seen_group.push(g2)
                    members: i64 =
                        while m < cands.count.i64() |members: i64 = 0, m: i64 = 0, cands, groups| -> members:
                            if groups[m.usize()] == g2:
                                members <- members + 1
                            m <- m + 1
                    fc: RhCandidate = cands[f.usize()]
                    findings.push(RhAdvisory{adv_s: fc.adv_s, adv_e: fc.adv_e, node: fc.node, fix_s: fc.fix_s, fix_e: fc.fix_e, alias_count: members - 1})
                f <- f + 1
            findings.count.i64()

        # Ecosystem allowlist for one affected entry (exact OSV identifier).
        def rh_osv_eco_ok(eco: u8, texts: darray[u8]&, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            want: u8& = rh_osv_ecosystem(eco)
            n: usize = strlen(want)
            return false if e - s != n
            while k < n |k: usize = 0, texts, s, want|:
                return false if texts[s + k] != want[k]
                k <- k + 1
            true

        # Collect advisory id + aliases into the alias table for one candidate.
        def rh_osv_collect_aliases(jnodes: darray[Json::RhJsonNode]&, jtexts: darray[u8]&, vobj: i64, cand: i64, aliases: mutable darray[RhAliasRef]&) -> void can[Memory.Allocate, Abort.Panic]:
            idi: i64 = Json::rh_json_obj_get(jnodes, jtexts, vobj, "id")
            if idi >= 0:
                idn: Json::RhJsonNode = jnodes[idi.usize()]
                if idn.kind == 3:
                    aliases.push(RhAliasRef{cand: cand, s: idn.text_start, e: idn.text_end})
            ali: i64 = Json::rh_json_obj_get(jnodes, jtexts, vobj, "aliases")
            return if ali < 0
            aln: Json::RhJsonNode = jnodes[ali.usize()]
            return if aln.kind != 4
            while ai < aln.child_count |ai: i64 = 0, jnodes, aliases, cand|:
                item: i64 = Json::rh_json_arr_get(jnodes, ali, ai)
                ai <- ai + 1
                continue if item < 0
                iv: Json::RhJsonNode = jnodes[item.usize()]
                continue if iv.kind != 3
                aliases.push(RhAliasRef{cand: cand, s: iv.text_start, e: iv.text_end})

        # True when two candidates share an id or any alias (exact bytes).
        def rh_cand_shared(cands: darray[RhCandidate]&, aliases: darray[RhAliasRef]&, texts: darray[u8]&, a: i64, b: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            ca: RhCandidate = cands[a.usize()]
            cb: RhCandidate = cands[b.usize()]
            return true if rh_span_eq_same(texts, ca.adv_s.usize(), ca.adv_e.usize(), cb.adv_s.usize(), cb.adv_e.usize())
            while i < aliases.count |i: usize = 0, aliases, texts, ca, cb|:
                ra: RhAliasRef = aliases[i]
                i <- i + 1
                while j < aliases.count |j: usize = i, aliases, texts, ca, cb, ra|:
                    rb: RhAliasRef = aliases[j]
                    j <- j + 1
                    a_mine: bool = ra.cand == a or ra.cand == b
                    b_mine: bool = rb.cand == a or rb.cand == b
                    if a_mine and b_mine and ra.cand != rb.cand:
                        return true if rh_span_eq_same(texts, ra.s.usize(), ra.e.usize(), rb.s.usize(), rb.e.usize())
            return true if rh_alias_hits(aliases, texts, a, cb.adv_s.usize(), cb.adv_e.usize())
            return true if rh_alias_hits(aliases, texts, b, ca.adv_s.usize(), ca.adv_e.usize())
            false

        # True when candidate `cand` owns an alias entry equal to span [s, e).
        # (Each candidate's own id is also tabled, so id hits work uniformly.)
        def rh_alias_hits(aliases: darray[RhAliasRef]&, texts: darray[u8]&, cand: i64, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < aliases.count |i: usize = 0, aliases, texts, cand, s, e|:
                ra: RhAliasRef = aliases[i]
                i <- i + 1
                continue if ra.cand != cand
                return true if rh_span_eq_same(texts, ra.s.usize(), ra.e.usize(), s, e)
            false

        struct RhAdvisory:
            adv_s: mutable i64
            adv_e: mutable i64
            node: mutable i64
            fix_s: mutable i64
            fix_e: mutable i64
            alias_count: mutable i64

        # A matched advisory group carries the first fixed release event when
        # the feed provides one. Presence is an observed boolean, not a claim
        # that the release is compatible with every consumer policy.
        def rh_fixed_version_available(findings: mutable darray[RhAdvisory]&) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < findings.count |i: i64 = 0, findings|:
                return true if findings[i.usize()].fix_s >= 0
                i <- i + 1
            false

        # Count distinct resolved nodes represented by matched advisory groups.
        # A shared advisory can match more than one node; the public security
        # metric keeps that node population separate from advisory cardinality.
        def rh_advisory_node_count(findings: mutable darray[RhAdvisory]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            seen: mutable darray[i64] = []
            while i < findings.count |i: i64 = 0, findings, seen| -> seen.count.i64():
                node: mutable i64 = findings[i.usize()].node
                already: bool =
                    while j < seen.count |already: bool = false, j: i64 = 0, seen, node| -> already:
                        already <- true if seen[j.usize()] == node
                        j <- j + 1
                if not already:
                    seen.push(node)
                i <- i + 1

        # Raw matched advisory records before accepted id/alias group
        # deduplication. `alias_count` stores the additional candidates folded
        # into each published advisory group.
        def rh_advisory_record_count(findings: mutable darray[RhAdvisory]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < findings.count |total: i64 = 0, i: i64 = 0, findings| -> total:
                total <- total + findings[i.usize()].alias_count + 1
                i <- i + 1

        # Classify unique matched advisory nodes against the selected graph
        # root. Mode 0 counts direct destinations, mode 1 counts reachable
        # non-direct destinations, and mode 2 counts matched nodes outside the
        # root's observed reachability. The latter remains evidence of a feed
        # match, never an affected-root claim.
        def rh_advisory_scope_count(findings: mutable darray[RhAdvisory]&, edges: mutable darray[RhDepEdge]&, root: mutable i64, node_count: mutable i64, mode: mutable i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if root < 0 or node_count <= 0
            reachable: mutable darray[i64] = []
            frontier: mutable darray[i64] = []
            frontier.push(root)
            while fi < frontier.count |fi: i64 = 0, frontier, reachable, edges|:
                cur: i64 = frontier[fi.usize()]
                fi <- fi + 1
                continue if rh_visited_has(reachable, cur)
                reachable.push(cur)
                while ei < edges.count |ei: i64 = 0, edges, cur, frontier, reachable|:
                    edge: RhDepEdge = edges[ei.usize()]
                    frontier.push(edge.dst) if edge.from == cur and not rh_visited_has(reachable, edge.dst)
                    ei <- ei + 1
            counted: mutable darray[i64] = []
            while i < findings.count |total: i64 = 0, i: i64 = 0, findings, edges, root, reachable, counted, mode| -> total:
                node: mutable i64 = findings[i.usize()].node
                already: bool = rh_visited_has(counted, node)
                if not already:
                    counted.push(node)
                    direct: bool =
                        while j < edges.count |direct: bool = false, j: i64 = 0, edges, node, root| -> direct:
                            direct <- true if edges[j.usize()].from == root and edges[j.usize()].dst == node
                            j <- j + 1
                    in_reach: bool = rh_visited_has(reachable, node)
                    include: bool = (mode == 0 and direct) or (mode == 1 and in_reach and not direct) or (mode == 2 and not in_reach)
                    total <- total + 1 if include
                i <- i + 1

        # Triples (kind, vstart, vend) per range event: 0 introduced, 1 fixed,
        # 2 last_affected. Returns the triple count, -1 malformed, 0 no events.
        def rh_osv_collect_events(jnodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, range_obj: i64, out: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            ev: i64 = Json::rh_json_obj_get(jnodes, texts, range_obj, "events")
            return 0 if ev < 0
            en: Json::RhJsonNode = jnodes[ev.usize()]
            return -1 if en.kind != 4
            while ai < en.child_count |total: i64 = 0, ai: i64 = 0, out| -> total:
                item: i64 = Json::rh_json_arr_get(jnodes, ev, ai)
                return -1 if item < 0
                io: Json::RhJsonNode = jnodes[item.usize()]
                return -1 if io.kind != 5
                return -1 if io.child_count != 2
                kn: Json::RhJsonNode =
                    kv: i64 = io.first_child
                    jnodes[kv.usize()]
                vv2: i64 = kn.next_sibling
                return -1 if vv2 < 0
                val: Json::RhJsonNode = jnodes[vv2.usize()]
                return -1 if val.kind != 3
                kind: mutable i64 = -1
                if kn.text_end - kn.text_start == 10:
                    if rh_span_eq_text(texts, kn.text_start.usize(), kn.text_end.usize(), "introduced"):
                        kind <- 0
                if kn.text_end - kn.text_start == 5:
                    if rh_span_eq_text(texts, kn.text_start.usize(), kn.text_end.usize(), "fixed"):
                        kind <- 1
                if kn.text_end - kn.text_start == 13:
                    if rh_span_eq_text(texts, kn.text_start.usize(), kn.text_end.usize(), "last_affected"):
                        kind <- 2
                return -1 if kind < 0
                out.push(kind)
                out.push(val.text_start)
                out.push(val.text_end)
                total <- total + 1
                ai <- ai + 1

        # Version verdict over one range's event triples: 1 vulnerable, 0 not,
        # -1 no usable range (unknown — caller skips, never matches).
        def rh_osv_version_in_events(pool: mutable darray[u8]&, ver: RhSemver&, events: darray[i64]&, triples: i64, evtexts: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            # Pass 1: does the range declare an explicit introduced bound? A range
            # with only fixed/last_affected is vulnerable FROM THE START (OSV
            # implicit introduced=0), never skipped.
            has_intro, any_event =
                while t < triples |has_intro: bool = false, any_event: bool = false, t: i64 = 0, pool| -> has_intro, any_event:
                    kind: i64 = events[(t * 3).usize()]
                    vs: usize = events[(t * 3 + 1).usize()].usize()
                    cps: i64 =
                        ve: usize = events[(t * 3 + 2).usize()].usize()
                        block_result: i64 = rh_pool_copy(pool, evtexts, vs, ve)
                        block_result
                    cpe: i64 = pool.count.i64()
                    cv: mutable RhSemver = RhSemver{major: 0, minor: 0, patch: 0, pre_s: 0, pre_e: 0}
                    if rh_semver_parse(pool, cps.usize(), cpe.usize(), &cv):
                        any_event <- true
                        if kind == 0:
                            has_intro <- true
                    t <- t + 1
            if not any_event:
                return -1
            # Pass 2: ordered evaluation. Start vulnerable unless the range has an
            # explicit introduced event.
            vuln: bool =
                while t2 < triples |vuln: bool = not has_intro, t2: i64 = 0, pool| -> vuln:
                    kind2: i64 = events[(t2 * 3).usize()]
                    vs2: usize = events[(t2 * 3 + 1).usize()].usize()
                    cps2: i64 =
                        ve2: usize = events[(t2 * 3 + 2).usize()].usize()
                        block_result: i64 = rh_pool_copy(pool, evtexts, vs2, ve2)
                        block_result
                    cpe2: i64 = pool.count.i64()
                    cv2: mutable RhSemver = RhSemver{major: 0, minor: 0, patch: 0, pre_s: 0, pre_e: 0}
                    if rh_semver_parse(pool, cps2.usize(), cpe2.usize(), &cv2):
                        if kind2 == 0:
                            if rh_semver_cmp(pool, ver, &cv2) >= 0:
                                vuln <- true
                        if kind2 == 1:
                            if rh_semver_cmp(pool, ver, &cv2) >= 0:
                                vuln <- false
                        if kind2 == 2:
                            if rh_semver_cmp(pool, ver, &cv2) > 0:
                                vuln <- false
                    t2 <- t2 + 1
            return 1 if vuln
            0

        def rh_osv_first_fixed(jnodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, affected: i64, fs_out: mutable i64&, fe_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            ranges: i64 = Json::rh_json_obj_get(jnodes, texts, affected, "ranges")
            return false if ranges < 0
            rn: Json::RhJsonNode = jnodes[ranges.usize()]
            return false if rn.kind != 4
            while ri < rn.child_count |ri: i64 = 0, jnodes, texts, fs_out, fe_out|:
                ev: i64 =
                    robj: i64 = Json::rh_json_arr_get(jnodes, ranges, ri)
                    return false if robj < 0
                    block_result: i64 = Json::rh_json_obj_get(jnodes, texts, robj, "events")
                    block_result
                return false if ev < 0
                en2: Json::RhJsonNode = jnodes[ev.usize()]
                return false if en2.kind != 4
                while ai < en2.child_count |ai: i64 = 0, jnodes, texts, fs_out, fe_out|:
                    item: i64 = Json::rh_json_arr_get(jnodes, ev, ai)
                    return false if item < 0
                    io: Json::RhJsonNode = jnodes[item.usize()]
                    return false if io.kind != 5 or io.child_count != 2
                    kn: Json::RhJsonNode =
                        kv: i64 = io.first_child
                        jnodes[kv.usize()]
                    vv2: i64 = kn.next_sibling
                    return false if vv2 < 0
                    if kn.text_end - kn.text_start == 5:
                        if rh_span_eq_text(texts, kn.text_start.usize(), kn.text_end.usize(), "fixed"):
                            val: Json::RhJsonNode = jnodes[vv2.usize()]
                            return false if val.kind != 3
                            fs_out[0] <- val.text_start
                            fe_out[0] <- val.text_end
                            return true
                    ai <- ai + 1
                ri <- ri + 1
            false

        def rh_scope_label(depctx: u8) -> u8&:
            return "dev" if depctx == 1
            return "optional" if depctx == 2
            return "peer" if depctx == 3
            return "declared" if depctx == 4
            "normal"

        def rh_src_label(kind: u8) -> u8&:
            return "registry" if kind == 0
            return "path" if kind == 1
            return "git" if kind == 2
            "unknown"

        def rh_unres_label(reason: u8) -> u8&:
            return "ambiguous" if reason == 1
            return "context" if reason == 2
            "missing"

        # --- Python requirements.txt (declared requirements; M03-03 / M08 PyPI) ---
        # Declared requirements are NEVER silently treated as resolved edges (R009):
        # only an exact `==` / `===` pin with no extras, environment marker or direct
        # URL becomes a package node and a root edge. Ranges, extras, markers, URLs
        # and pip options stay explicit unresolved entries preserving their original
        # text, with reason `context` for environment/URL/option forms and `missing`
        # for a plain range we cannot resolve offline. Names use PEP 503 equality.

        def rh_pypi_name_char(b: u8) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if b >= 48 and b <= 57
            return true if b >= 65 and b <= 90
            return true if b >= 97 and b <= 122
            return true if b == 46 or b == 95 or b == 45
            false

        def rh_pypi_find(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize, vs: usize, ve: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count |i: usize = 0, pkgs, pool, ns, ne, vs, ve|:
                n: RhPkgNode = pkgs[i]
                if n.eco == RH_ECO_PYPI and n.name_s >= 0 and n.ver_s >= 0:
                    if rh_name_eq(RH_ECO_PYPI, pool, n.name_s.usize(), n.name_e.usize(), ns, ne):
                        return i.i64() if rh_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, vs, ve)
                i <- i + 1
            -1

        def rh_pypi_line(buf: darray[u8]&, s: usize, e: usize, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&, depctx: u8) -> void can[Memory.Allocate, Abort.Panic]:
            a: mutable usize = s
            b: mutable usize = e
            while a < b and (buf[a] == 32 or buf[a] == 9) |a, b, buf|:
                a <- a + 1
            while b > a and (buf[b - 1] == 32 or buf[b - 1] == 9 or buf[b - 1] == 13) |b, a, buf|:
                b <- b - 1
            return if a >= b
            return if buf[a] == 35
            k: usize =
                while k < b |k: usize = a, b| -> k:
                    break if buf[k] == 35 and k > a and (buf[k - 1] == 32 or buf[k - 1] == 9)
                    k <- k + 1
            if k < b:
                b <- k
                while b > a and (buf[b - 1] == 32 or buf[b - 1] == 9) |b, a, buf|:
                    b <- b - 1
                return if a >= b
            is_opt: bool = true if buf[a] == 45 else false
            ns: mutable usize = a
            ne: mutable usize = a
            if is_opt:
                while ne < b and buf[ne] != 32 and buf[ne] != 9 |ne, b, buf|:
                    ne <- ne + 1
            else:
                while ne < b and rh_pypi_name_char(buf[ne]) |ne, b, buf|:
                    ne <- ne + 1
            if ne == ns:
                unknown_out[0] <- unknown_out[0] + 1
                uns0: i64 = rh_pool_copy(pool, buf, a, b)
                unresolved.push(RhUnresolved{from: 0, name_s: uns0, name_e: uns0 + (b - a).i64(), req_s: -1, req_e: -1, reason: 2, optional: 0})
                return
            c: mutable usize =
                while c < b and (buf[c] == 32 or buf[c] == 9) |c: usize = ne| -> c:
                    c <- c + 1
            has_extras: mutable bool = false
            if c < b and buf[c] == 91:
                has_extras <- true
                while c < b and buf[c] != 93 |c, b, buf|:
                    c <- c + 1
                if c < b:
                    c <- c + 1
                while c < b and (buf[c] == 32 or buf[c] == 9) |c, b, buf|:
                    c <- c + 1
            semi: usize =
                while m < b |semi: usize = b, m: usize = c| -> semi:
                    if buf[m] == 59:
                        semi <- m
                    m <- m + 1
            has_marker: mutable bool = semi < b
            rs, re2 =
                while re2 > rs and (buf[re2 - 1] == 32 or buf[re2 - 1] == 9) |rs: usize = c, re2: usize = semi| -> rs, re2:
                    re2 <- re2 - 1
            has_url: bool =
                while u < re2 |has_url: bool = false, u: usize = rs| -> has_url:
                    if buf[u] == 58 or buf[u] == 64 or buf[u] == 47:
                        has_url <- true
                    u <- u + 1
            exact: mutable bool = false
            vstart: mutable usize = rs
            if re2 - rs >= 3 and buf[rs] == 61 and buf[rs + 1] == 61:
                if buf[rs + 2] == 61:
                    vstart <- rs + 3
                else:
                    vstart <- rs + 2
                while vstart < re2 and (buf[vstart] == 32 or buf[vstart] == 9) |vstart, re2, buf|:
                    vstart <- vstart + 1
                exact <- true
                while w < re2 |w: usize = vstart, vstart, re2, buf, exact|:
                    x: u8 = buf[w]
                    if x == 42 or x == 44 or x == 33 or x == 60 or x == 62 or x == 126 or x == 124 or x == 32 or x == 9:
                        exact <- false
                    w <- w + 1
                if vstart >= re2:
                    exact <- false
            # record the requirement text for the unsupported-range classifier; a
            # pip option (-r/-e/-i...) is not a declared requirement and is counted
            # separately as an unknown construct instead.
            rhs: mutable i64 = -1
            rhe: mutable i64 = -1
            if rs < re2:
                rhs <- rh_pool_copy(pool, buf, rs, re2)
                rhe <- rhs + (re2 - rs).i64()
            if not is_opt:
                reqs.push(RhRequire{from: 0, name_s: -1, name_e: -1, ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: rhs, req_e: rhe, depctx: depctx, optional: 0})
            if exact and not has_extras and not has_marker and not has_url and not is_opt:
                nname: i64 = rh_pool_copy(pool, buf, ns, ne)
                nver: i64 = rh_pool_copy(pool, buf, vstart, re2)
                existing: mutable i64 = rh_pypi_find(pkgs, pool, nname.usize(), (nname + (ne - ns).i64()).usize(), nver.usize(), (nver + (re2 - vstart).i64()).usize())
                if existing < 0:
                    existing <- rh_node_add(pkgs, RH_ECO_PYPI)
                    return if existing < 0
                    nd: mutable RhPkgNode = pkgs[existing.usize()]
                    nd.name_s <- nname
                    nd.name_e <- nname + (ne - ns).i64()
                    nd.ver_s <- nver
                    nd.ver_e <- nver + (re2 - vstart).i64()
                    nd.src_kind <- 0
                    pkgs[existing.usize()] <- nd
                edges.push(RhDepEdge{from: 0, dst: existing, depctx: depctx, optional: 0})
                return
            uns_name: i64 = rh_pool_copy(pool, buf, ns, ne)
            uns_req: mutable i64 = -1
            uns_req_end: mutable i64 = -1
            if rs < re2:
                uns_req <- rh_pool_copy(pool, buf, rs, re2)
                uns_req_end <- uns_req + (re2 - rs).i64()
            reason: u8 = 2 if has_extras or has_marker or has_url or is_opt else 0
            unresolved.push(RhUnresolved{from: 0, name_s: uns_name, name_e: uns_name + (ne - ns).i64(), req_s: uns_req, req_e: uns_req_end, reason: reason, optional: 0})
            return

        # Parse a requirements.txt into a root-plus-pinned graph. Returns 0 (root
        # is always index 0) or -1 if the root node cannot be created. A requirements
        # file routinely contains ranges/options we do not resolve; those are
        # preserved as unresolved entries, never guessed edges.
        def rh_pypi_parse(req: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            rroot: i64 = rh_node_add(pkgs, RH_ECO_PYPI)
            return -1 if rroot != 0
            rn: mutable darray[u8] = []
            Base::rh_push_text(rn, "root")
            rns: i64 = rh_pool_copy(pool, rn, 0, rn.count)
            rnode: mutable RhPkgNode = pkgs[0]
            rnode.name_s <- rns
            rnode.name_e <- rns + rn.count.i64()
            rnode.src_kind <- 3
            pkgs[0] <- rnode
            while i <= req.count |i: usize = 0, req, pkgs, pool, reqs, edges, unresolved, unknown_out|:
                j: usize =
                    while j < req.count and req[j] != 10 |j: usize = i| -> j:
                        j <- j + 1
                if j > i:
                    rh_pypi_line(req, i, j, pkgs, pool, reqs, edges, unresolved, unknown_out, 0)
                i <- j + 1
            0

        # Extract quoted dependency strings from one PEP 621 array line. The
        # supported subset is deliberately narrow: basic/literal TOML strings inside
        # `project.dependencies` or an optional-dependency table. Unsupported dynamic
        # forms fail closed instead of becoming an empty graph.
        # (private to this file)
        def rh_pypi_pep621_values(buf: darray[u8]&, s: usize, e: usize, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&, depctx: u8, close_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            close_out[0] <- 0
            while i < e |i: usize = s, e, buf, pkgs, pool, reqs, edges, unresolved, unknown_out, depctx, close_out|:
                b: u8 = buf[i]
                if b == 93:
                    close_out[0] <- 1
                    return 0
                if b == 34 or b == 39:
                    quote: u8 = b
                    i <- i + 1
                    dep: mutable darray[u8] = []
                    while i < e and buf[i] != quote |i, e, buf, dep|:
                        if buf[i] == 92:
                            i <- i + 1
                            return -1 if i >= e
                        dep.push(buf[i])
                        i <- i + 1
                    return -1 if i >= e
                    return -1 if dep.count == 0
                    rh_pypi_line(dep, 0, dep.count, pkgs, pool, reqs, edges, unresolved, unknown_out, depctx)
                i <- i + 1
            0

        # Parse the bounded PEP 621 project metadata subset. Requirements remain
        # declared evidence; exact pins are the only offline-resolved edges, matching
        # requirements.txt semantics. Optional arrays retain `depctx=optional`.
        def rh_pypi_parse_pep621(req: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            rroot: i64 = rh_node_add(pkgs, RH_ECO_PYPI)
            return -1 if rroot != 0
            root_name: mutable darray[u8] = []
            Base::rh_push_text(root_name, "root")
            root_s: i64 = rh_pool_copy(pool, root_name, 0, root_name.count)
            root_node: mutable RhPkgNode = pkgs[0]
            root_node.name_s <- root_s
            root_node.name_e <- root_s + root_name.count.i64()
            root_node.src_kind <- RH_PSRC_UNKNOWN
            pkgs[0] <- root_node
            section: mutable i64 = 0
            active: mutable i64 = 0
            active_scope: mutable u8 = RH_SCOPE_NORMAL
            saw_project: mutable i64 = 0
            while line_start <= req.count |line_start: usize = 0, req, pkgs, pool, reqs, edges, unresolved, unknown_out, section, active, active_scope, saw_project|:
                line_end: usize =
                    while j < req.count and req[j] != 10 |j: usize = line_start| -> j:
                        j <- j + 1
                s: mutable usize = line_start
                e: mutable usize = line_end
                while s < e and (req[s] == 32 or req[s] == 9 or req[s] == 13) |s, e, req|:
                    s <- s + 1
                while e > s and (req[e - 1] == 32 or req[e - 1] == 9 or req[e - 1] == 13) |s, e, req|:
                    e <- e - 1
                if s < e and req[s] == 91:
                    return -1 if active == 1
                    section <- 0
                    active <- 0
                    if Base::rh_bytes_equal_literal(req, s.i64(), e.i64(), "[project]"):
                        section <- 1
                        saw_project <- 1
                    elif Base::rh_bytes_equal_literal(req, s.i64(), e.i64(), "[project.optional-dependencies]"):
                        section <- 2
                        saw_project <- 1
                elif section == 1 or section == 2:
                    eq: mutable i64 = -1
                    while k < e |k: usize = s, e, req, eq|:
                        if req[k] == 61:
                            eq <- k.i64()
                            break
                        k <- k + 1
                    if active == 0 and eq >= 0:
                        key_end: mutable usize = eq.usize()
                        while key_end > s and (req[key_end - 1] == 32 or req[key_end - 1] == 9) |key_end, s, req|:
                            key_end <- key_end - 1
                        is_dependencies: bool = section == 1 and Base::rh_bytes_equal_literal(req, s.i64(), key_end.i64(), "dependencies")
                        is_optional: bool = section == 2
                        if is_dependencies or is_optional:
                            array_start: mutable usize = (eq + 1).usize()
                            while array_start < e and (req[array_start] == 32 or req[array_start] == 9) |array_start, e, req|:
                                array_start <- array_start + 1
                            return -1 if array_start >= e or req[array_start] != 91
                            active <- 1
                            active_scope <- RH_SCOPE_OPTIONAL if is_optional else RH_SCOPE_NORMAL
                            closed: mutable i64 = 0
                            return -1 if rh_pypi_pep621_values(req, array_start + 1, e, pkgs, pool, reqs, edges, unresolved, unknown_out, active_scope, &closed) != 0
                            active <- 0 if closed == 1
                    elif active == 1:
                        closed_cont: mutable i64 = 0
                        return -1 if rh_pypi_pep621_values(req, s, e, pkgs, pool, reqs, edges, unresolved, unknown_out, active_scope, &closed_cont) != 0
                        active <- 0 if closed_cont == 1
                line_start <- line_end + 1
            return -1 if saw_project == 0 or active == 1
            0

        # --- Go modules (go.mod; M08 ecosystems lane) --------------------------
        # Declared requirements are NEVER silently treated as resolved edges (R009):
        # only a `require <module/path> vX.Y.Z` directive whose version is a plain
        # semantic version (`v` + MAJOR.MINOR.PATCH, optional -prerelease/+build)
        # becomes a package node and a root edge. Everything else stays an explicit
        # unresolved entry with its original text:
        #   - pseudo-versions (v0.0.0-20240101120000-abcdef123456) -> missing
        #   - `+incompatible`, branch/commit refs, and bare path-only forms -> missing
        #   - `replace` / `exclude` / `retract` directives -> context (not resolved
        #     offline; a replacement target is a declared rewrite, not a registry
        #     version, and must never be treated as the resolved edge)
        # `// indirect` is a comment, not a distinct requirement, and is preserved
        # only as part of the recorded requirement text. Module paths are byte-exact
        # in go.mod (the `!`-escaped cache form is a separate representation and is
        # not what a go.mod contains), so name equality is byte-exact.

        def rh_go_name_eq(pool: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_span(pool, s1.i64(), e1.i64(), pool, s2.i64(), e2.i64())

        # Byte-exact span equality across two distinct buffers (module path lookup).
        def rh_go_span_eq2(a: darray[u8]&, s1: usize, e1: usize, b: darray[u8]&, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_span(a, s1.i64(), e1.i64(), b, s2.i64(), e2.i64())

        # A module path segment character: letters, digits, and the punctuation Go
        # permits in module paths ('.', '-', '_', '~', '+'). A leading digit is not
        # allowed in the first segment of a domain, but this is deliberately a
        # permissive lexical check; the echo of the exact text is what is stored.
        def rh_go_path_char(b: u8) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if b >= 48 and b <= 57
            return true if b >= 65 and b <= 90
            return true if b >= 97 and b <= 122
            return true if b == 46 or b == 45 or b == 95 or b == 126 or b == 43 or b == 47
            false

        # Strict Go semantic version for the DECLARED supported subset: exactly
        # `v` MAJOR `.` MINOR `.` PATCH. Prereleases, build metadata, pseudo-versions
        # (`v0.0.0-20240101120000-abcdef...`) and `+incompatible` are NOT evaluated
        # offline and are reported unresolved, never guessed as resolved edges.
        def rh_go_version_supported(data: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e - s < 6 or e > data.count.i64()
            return false if data[s.usize()] != 118
            i: mutable i64 = s + 1
            maj: i64 = rh_go_num_run(data, i, e, &i)
            return false if maj < 0 or i >= e or data[i.usize()] != 46
            i <- i + 1
            mn: i64 = rh_go_num_run(data, i, e, &i)
            return false if mn < 0 or i >= e or data[i.usize()] != 46
            i <- i + 1
            pt: i64 = rh_go_num_run(data, i, e, &i)
            return false if pt < 0
            i == e

        # One or more decimal digits; -1 when none. Advances pos.
        def rh_go_num_run(data: darray[u8]&, start: i64, e: i64, pos: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            i: i64 =
                while i < e and data[i.usize()] >= 48 and data[i.usize()] <= 57 |i: i64 = start| -> i:
                    i <- i + 1
            return -1 if i == start
            pos[0] <- i
            i - start

        # Trim a Span, skipping leading/trailing ASCII whitespace.
        def rh_go_trim(data: darray[u8]&, s: i64, e: i64, s_out: mutable i64&, e_out: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            a: mutable i64 = s
            b: mutable i64 = e
            while a < b and (data[a.usize()] == 32 or data[a.usize()] == 9) |a, b, data|:
                a <- a + 1
            while b > a and (data[(b - 1).usize()] == 32 or data[(b - 1).usize()] == 9 or data[(b - 1).usize()] == 13) |b, a, data|:
                b <- b - 1
            s_out[0] <- a
            e_out[0] <- b
            return

        # Does the token span equal the literal at the same length?
        def rh_go_tok(data: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: i64 = strlen(lit).i64()
            return false if e - s != n
            while k < n |k: i64 = 0, data, s, lit|:
                return false if data[(s + k).usize()] != lit[k.usize()]
                k <- k + 1
            true

        # Find an existing Go node by module path and version (byte-exact).
        def rh_go_find(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize, vs: usize, ve: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count |i: usize = 0, pkgs, pool, ns, ne, vs, ve|:
                n: RhPkgNode = pkgs[i]
                if n.eco == RH_ECO_GO and n.name_s >= 0 and n.ver_s >= 0:
                    if rh_go_name_eq(pool, n.name_s.usize(), n.name_e.usize(), ns, ne):
                        return i.i64() if rh_go_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, vs, ve)
                i <- i + 1
            -1

        # Parse a go.mod into a root-plus-requirements graph. Returns 0 (root is
        # always index 0) or -1 when the module directive is malformed/missing or the
        # root node cannot be created. A go.mod routinely contains replace/exclude/
        # retract directives and pseudo-versions we do not resolve; those are
        # preserved as unresolved entries, never guessed edges.
        def rh_go_parse(mod: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            rroot: i64 = rh_node_add(pkgs, RH_ECO_GO)
            if rroot != 0:
                return -1
            # root identity: the `module` directive path (fall back to a fixed label)
            ms: mutable i64 = 0
            me: mutable i64 = 0
            has_mod: mutable bool = false
            found_mod: i64 = rh_go_module_path(mod, &ms, &me)
            if found_mod >= 0:
                has_mod <- true
            rnode: mutable RhPkgNode = pkgs[0]
            if has_mod:
                rns: i64 = rh_pool_copy(pool, mod, ms.usize(), me.usize())
                rnode.name_s <- rns
                rnode.name_e <- rns + (me - ms)
            else:
                rn: mutable darray[u8] = []
                Base::rh_push_text(rn, "root")
                rns2: i64 = rh_pool_copy(pool, rn, 0, rn.count)
                rnode.name_s <- rns2
                rnode.name_e <- rns2 + rn.count.i64()
            rnode.src_kind <- 3
            pkgs[0] <- rnode
            # Walk lines, handling single-line and parenthesized blocks.
            while true |in_require: i64 = 0, in_other_block: i64 = 0, pos: i64 = 0, mod, pkgs, pool, reqs, edges, unresolved, unknown_out|:
                break if pos >= mod.count.i64()
                le: i64 =
                    while le < mod.count.i64() and mod[le.usize()] != 10 |le: i64 = pos| -> le:
                        le <- le + 1
                ts: mutable i64 = 0
                te: mutable i64 = 0
                rh_go_trim(mod, pos, le, &ts, &te)
                if te > ts and mod[ts.usize()] != 47:
                    rh_go_line(mod, ts, te, pkgs, pool, reqs, edges, unresolved, unknown_out, &in_require, &in_other_block)
                pos <- le + 1
            0

        # Handle one go.mod line; updates the in_require/in_other_block flags via
        # out-parameters (the language has no tuple returns).
        def rh_go_line(mod: darray[u8]&, s: i64, e: i64, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&, in_require: mutable i64&, in_other_block: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            # strip a trailing // comment
            code_e: i64 =
                while i + 1 < e |code_e: i64 = e, i: i64 = s| -> code_e:
                    if mod[i.usize()] == 47 and mod[(i + 1).usize()] == 47:
                        code_e <- i
                    i <- i + 1
            cs: mutable i64 = 0
            ce: mutable i64 = 0
            rh_go_trim(mod, s, code_e, &cs, &ce)
            return if ce <= cs
            if mod[cs.usize()] == 41:
                # close of a block
                in_require[0] <- 0
                in_other_block[0] <- 0
                return
            if in_require[0] == 1:
                rh_go_require_entry(mod, cs, ce, pkgs, pool, reqs, edges, unresolved, unknown_out)
                return
            if in_other_block[0] == 1:
                # a line inside replace/exclude/retract/etc. -> context, keep text
                rh_go_context_entry(mod, cs, ce, pool, unresolved)
                return
            # directive keyword
            k: i64 = rh_go_word_end(mod, cs, ce)
            if rh_go_tok(mod, cs, k, "require"):
                rest_s: i64 =
                    while rest_s < ce and (mod[rest_s.usize()] == 32 or mod[rest_s.usize()] == 9) |rest_s: i64 = k, ce| -> rest_s:
                        rest_s <- rest_s + 1
                if rest_s < ce and mod[rest_s.usize()] == 40:
                    in_require[0] <- 1
                    return
                if rest_s < ce:
                    rh_go_require_entry(mod, rest_s, ce, pkgs, pool, reqs, edges, unresolved, unknown_out)
                return
            if rh_go_tok(mod, cs, k, "replace") or rh_go_tok(mod, cs, k, "exclude") or rh_go_tok(mod, cs, k, "retract") or rh_go_tok(mod, cs, k, "droprequire"):
                rest2: i64 =
                    while rest2 < ce and (mod[rest2.usize()] == 32 or mod[rest2.usize()] == 9) |rest2: i64 = k| -> rest2:
                        rest2 <- rest2 + 1
                if rest2 < ce and mod[rest2.usize()] == 40:
                    in_other_block[0] <- 1
                    return
                if rest2 < ce:
                    rh_go_context_entry(mod, rest2, ce, pool, unresolved)
                return
            # module / go / toolchain / comment / unknown directive: not a requirement
            return if rh_go_tok(mod, cs, k, "module") or rh_go_tok(mod, cs, k, "go") or rh_go_tok(mod, cs, k, "toolchain")
            unknown_out[0] <- unknown_out[0] + 1
            return

        # End index of the first whitespace-delimited word in [s,e).
        def rh_go_word_end(data: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < e and data[i.usize()] != 32 and data[i.usize()] != 9 |i: i64 = s| -> i:
                i <- i + 1

        # Parse `module <path>`; returns the path span via ms/me or -1.
        def rh_go_module_path(mod: darray[u8]&, ms: mutable i64&, me: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while true |pos: i64 = 0, mod, ms, me|:
                break if pos >= mod.count.i64()
                le: i64 =
                    while le < mod.count.i64() and mod[le.usize()] != 10 |le: i64 = pos| -> le:
                        le <- le + 1
                cs: mutable i64 = 0
                ce: mutable i64 = 0
                rh_go_trim(mod, pos, le, &cs, &ce)
                if ce > cs:
                    k: i64 = rh_go_word_end(mod, cs, ce)
                    if rh_go_tok(mod, cs, k, "module"):
                        rest: i64 =
                            while rest < ce and (mod[rest.usize()] == 32 or mod[rest.usize()] == 9) |rest: i64 = k, ce| -> rest:
                                rest <- rest + 1
                        if rest < ce:
                            ms[0] <- rest
                            me[0] <- ce
                            return 0
                pos <- le + 1
            -1

        # Insert a require entry: exact supported version -> node + root edge;
        # otherwise an unresolved entry preserving the original text.
        def rh_go_require_entry(mod: darray[u8]&, s: i64, e: i64, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            ns: mutable i64 = s
            ne: mutable i64 =
                while ne < e and mod[ne.usize()] != 32 and mod[ne.usize()] != 9 |ne: i64 = s| -> ne:
                    ne <- ne + 1
            return if ne <= ns
            vs: mutable i64 =
                while vs < e and (mod[vs.usize()] == 32 or mod[vs.usize()] == 9) |vs: i64 = ne| -> vs:
                    vs <- vs + 1
            ve: i64 =
                while ve < e and mod[ve.usize()] != 32 and mod[ve.usize()] != 9 |ve: i64 = vs| -> ve:
                    ve <- ve + 1
                # record the requirement token for the unsupported-range classifier
            rhs: mutable i64 = -1
            rhe: mutable i64 = -1
            if vs < ve:
                rhs <- rh_pool_copy(pool, mod, vs.usize(), ve.usize())
                rhe <- rhs + (ve - vs)
            reqs.push(RhRequire{from: 0, name_s: -1, name_e: -1, ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: rhs, req_e: rhe, depctx: 0, optional: 0})
            if vs < ve and rh_go_version_supported(mod, vs, ve):
                nname: i64 = rh_pool_copy(pool, mod, ns.usize(), ne.usize())
                nver: i64 = rh_pool_copy(pool, mod, vs.usize(), ve.usize())
                existing: mutable i64 = rh_go_find(pkgs, pool, nname.usize(), (nname + (ne - ns)).usize(), nver.usize(), (nver + (ve - vs)).usize())
                if existing < 0:
                    existing <- rh_node_add(pkgs, RH_ECO_GO)
                    return if existing < 0
                    nd: mutable RhPkgNode = pkgs[existing.usize()]
                    nd.name_s <- nname
                    nd.name_e <- nname + (ne - ns)
                    nd.ver_s <- nver
                    nd.ver_e <- nver + (ve - vs)
                    nd.src_kind <- 0
                    pkgs[existing.usize()] <- nd
                edges.push(RhDepEdge{from: 0, dst: existing, depctx: 0, optional: 0})
                return
            # missing version or unsupported version -> unresolved (preserve text)
            uns_name: i64 = rh_pool_copy(pool, mod, ns.usize(), ne.usize())
            unresolved.push(RhUnresolved{from: 0, name_s: uns_name, name_e: uns_name + (ne - ns), req_s: rhs, req_e: rhe, reason: 0, optional: 0})
            return

        # Replace/exclude/retract entry -> an explicit context-unresolved record.
        def rh_go_context_entry(mod: darray[u8]&, s: i64, e: i64, pool: mutable darray[u8]&, unresolved: mutable darray[RhUnresolved]&) -> void can[Memory.Allocate, Abort.Panic]:
            ns: mutable i64 = s
            ne: i64 =
                while ne < e and mod[ne.usize()] != 32 and mod[ne.usize()] != 9 |ne: i64 = s| -> ne:
                    ne <- ne + 1
            return if ne <= ns
            name_s: i64 = rh_pool_copy(pool, mod, ns.usize(), ne.usize())
            full_s: i64 = rh_pool_copy(pool, mod, s.usize(), e.usize())
            unresolved.push(RhUnresolved{from: 0, name_s: name_s, name_e: name_s + (ne - ns), req_s: full_s, req_e: full_s + (e - s), reason: 2, optional: 0})
            return

        # --- Go module checksums (go.sum; M03-02) -------------------------------
        # A go.sum module line is evidence for the exact module/version selected by
        # go.mod. Zip checksums attach to the module artifact; `/go.mod` checksums
        # attach to a distinct `go_mod` artifact. Unknown module lines do not create
        # graph nodes when the local go.mod did not declare them.
        def rh_go_sum_digest_valid(data: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if e - s != 47
            return false if not rh_go_tok(data, s, s + 3, "h1:")
            Base64::rh_base64_sha256_valid(data, s + 3, e)

        def rh_go_sum_line(sum: darray[u8]&, s: i64, e: i64, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, artifacts: mutable darray[RhArtifact]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            ts: mutable i64 = 0
            te: mutable i64 = 0
            rh_go_trim(sum, s, e, &ts, &te)
            return 0 if ts == te
            ms: i64 = ts
            me: i64 =
                while i < te and sum[i.usize()] != 32 and sum[i.usize()] != 9 |i: i64 = ts| -> i:
                    i <- i + 1
            return -1 if me <= ms
            vs: i64 =
                while i < te and (sum[i.usize()] == 32 or sum[i.usize()] == 9) |i: i64 = me| -> i:
                    i <- i + 1
            ve: i64 =
                while i < te and sum[i.usize()] != 32 and sum[i.usize()] != 9 |i: i64 = vs| -> i:
                    i <- i + 1
            return -1 if ve <= vs
            ds: i64 =
                while i < te and (sum[i.usize()] == 32 or sum[i.usize()] == 9) |i: i64 = ve| -> i:
                    i <- i + 1
            de: i64 = te
            return -1 if ds >= de or not rh_go_sum_digest_valid(sum, ds, de)
            # A fourth token is never part of go.sum's line grammar.
            extra: i64 =
                while extra < te and (sum[extra.usize()] == 32 or sum[extra.usize()] == 9) |extra: i64 = de| -> extra:
                    extra <- extra + 1
            return -1 if extra < te
            is_modfile: bool = ve - vs >= 7 and sum[(ve - 7).usize()] == 47 and rh_go_tok(sum, ve - 6, ve, "go.mod")
            version_end: i64 =
                while version_end < ve and sum[version_end.usize()] != 47 |version_end: i64 = vs| -> version_end:
                    version_end <- version_end + 1
            while i < pkgs.count |i: usize = 0, pkgs, pool, sum, artifacts, ms, me, vs, version_end, ds, de, is_modfile|:
                n: RhPkgNode = pkgs[i]
                if n.eco == RH_ECO_GO and n.name_s >= 0 and n.ver_s >= 0:
                    if rh_go_span_eq2(pool, n.name_s.usize(), n.name_e.usize(), sum, ms.usize(), me.usize()) and rh_go_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), sum, vs.usize(), version_end.usize()):
                        if is_modfile:
                            while a < artifacts.count |a: usize = 0, artifacts, pool, i, sum, ds, de|:
                                prior: RhArtifact = artifacts[a]
                                if prior.kind == RH_ART_KIND_GO_MOD and prior.package_node == i.i64():
                                    return 0 if rh_go_span_eq2(pool, prior.expected_s.usize(), prior.expected_e.usize(), sum, ds.usize(), de.usize())
                                    return -1
                                a <- a + 1
                            digest_start: i64 = rh_pool_copy(pool, sum, ds.usize(), de.usize())
                            return -1 if rh_artifact_add_expected(artifacts, i.i64(), RH_ART_KIND_GO_MOD, digest_start, digest_start + (de - ds)) < 0
                            return 0
                        if n.has_digest == 1:
                            return 0 if rh_go_span_eq2(pool, n.dig_s.usize(), n.dig_e.usize(), sum, ds.usize(), de.usize())
                            return -1
                        digest_start: i64 = rh_pool_copy(pool, sum, ds.usize(), de.usize())
                        n.has_digest <- 1
                        n.dig_s <- digest_start
                        n.dig_e <- digest_start + (de - ds)
                        pkgs[i] <- n
                        return 0
                i <- i + 1
            0

        def rh_go_sum_parse(sum: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, artifacts: mutable darray[RhArtifact]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while pos < sum.count.i64() |pos: i64 = 0, sum, pkgs, pool, artifacts|:
                line_end: i64 =
                    while line_end < sum.count.i64() and sum[line_end.usize()] != 10 |line_end: i64 = pos, sum| -> line_end:
                        line_end <- line_end + 1
                return -1 if rh_go_sum_line(sum, pos, line_end, pkgs, pool, artifacts) != 0
                pos <- line_end + 1
            0

        # --- M03 unsupported range expressions (F022, R009) -------------------
        # The supported subset is DECLARED, not implied: a requirement string is
        # classified as evaluable only when it is a plain semver range over digits,
        # dots, the operators ^ ~ > < = * and `x`, prerelease/build identifiers
        # (letters, '-', '+'), `|`/`,`/space, and it contains at least one digit or
        # is exactly `*`. Protocol/alias/workspace/path forms (`:`, `/`, e.g.
        # `npm:`, `file:`, `git+https://`, `workspace:`, `link:`) and dist-tags
        # such as `latest` are NOT evaluated and count as unsupported. This is
        # deliberately distinct from a missing dependency: an unsupported
        # expression is a syntax we do not claim to read, never a guessed edge.
        def rh_req_range_supported(pool: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e <= s or e > pool.count.i64()
            has_digit: bool =
                while i < e |has_digit: bool = false, i: i64 = s| -> has_digit:
                    ok: bool = |has_digit|
                        b: u8 = pool[i.usize()]
                        return false if b == 58 or b == 47
                        if b >= 48 and b <= 57:
                            has_digit <- true
                        (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 46 or b == 42 or b == 94 or b == 126 or b == 62 or b == 60 or b == 61 or b == 43 or b == 45 or b == 124 or b == 44 or b == 32 or b == 9
                    return false if not ok
                    i <- i + 1
            return true if has_digit
            if e - s == 1:
                return true if pool[s.usize()] == 42
            false

        # Count requirements whose range/version string is outside the declared
        # supported subset. Cargo.lock dependency entries carry an exact pinned
        # version (ver_s); npm requirement maps carry the raw range (req_s).
        # Requirements with no string at all are not counted (nothing to classify).
        def rh_unsupported_range_count(reqs: darray[RhRequire]&, pool: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while r < reqs.count |total: i64 = 0, r: usize = 0| -> total:
                q: RhRequire = reqs[r]
                s: i64 = q.ver_s if q.req_s < 0 else q.req_s
                e: i64 = q.ver_e if q.req_s < 0 else q.req_e
                if s >= 0 and e >= 0:
                    if not rh_req_range_supported(pool, s, e):
                        total <- total + 1
                r <- r + 1

        # Dependency metrics document (rh-deps-metrics/1). One registered metric,
        # `dependencies.unsupported_range_count`, with per-ecosystem components so
        # the denominator-free count can be audited. It never claims a dependency
        # is safe or that the graph is complete (R009/F022/R030).
        def rh_deps_metrics_emit(out: mutable darray[u8]&, eco_codes: darray[i64]&, declared: darray[i64]&, resolved: darray[i64]&, unresolved: darray[i64]&, unsupported: darray[i64]&, direct_declared: mutable darray[i64]&, direct_resolved: mutable darray[i64]&, direct_unresolved: mutable darray[i64]&, transitive_resolved: mutable darray[i64]&, runtime_requirements: mutable darray[i64]&, development_requirements: mutable darray[i64]&, optional_requirements: mutable darray[i64]&, peer_requirements: mutable darray[i64]&, unknown_scope_requirements: mutable darray[i64]&, runtime_direct: mutable darray[i64]&, build_direct: mutable darray[i64]&, optional_direct: mutable darray[i64]&, unknown_scope_direct: mutable darray[i64]&, unpinned: mutable darray[i64]&, digest_known: mutable darray[i64]&, digest_total: mutable darray[i64]&, maximum_depth: mutable darray[i64]&, resolution_complete: mutable darray[i64]&, node_count: mutable darray[i64]&, edge_count: mutable darray[i64]&, advisory_unknown_nodes: mutable darray[i64]&, fixed_version_available: mutable darray[i64]&, runtime_edges: mutable darray[i64]&, development_edges: mutable darray[i64]&, optional_edges: mutable darray[i64]&, peer_edges: mutable darray[i64]&, unknown_scope_edges: mutable darray[i64]&, advisories: mutable darray[i64]&, advisory_records: mutable darray[i64]&, affected_nodes: mutable darray[i64]&, affected_direct_nodes: mutable darray[i64]&, affected_transitive_nodes: mutable darray[i64]&, affected_unreachable_nodes: mutable darray[i64]&, withdrawn: mutable darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
            total_declared: i64 =
                while i < eco_codes.count.i64() |total_declared: i64 = 0, i: i64 = 0| -> total_declared:
                    total_declared <- total_declared + declared[i.usize()]
                    i <- i + 1
            total_resolved: i64 =
                while i < eco_codes.count.i64() |total_resolved: i64 = 0, i: i64 = 0| -> total_resolved:
                    total_resolved <- total_resolved + resolved[i.usize()]
                    i <- i + 1
            total_unresolved: i64 =
                while i < eco_codes.count.i64() |total_unresolved: i64 = 0, i: i64 = 0| -> total_unresolved:
                    total_unresolved <- total_unresolved + unresolved[i.usize()]
                    i <- i + 1
            total_unsupported: i64 =
                while i < eco_codes.count.i64() |total_unsupported: i64 = 0, i: i64 = 0| -> total_unsupported:
                    total_unsupported <- total_unsupported + unsupported[i.usize()]
                    i <- i + 1
            total_direct_declared: i64 =
                while i < eco_codes.count.i64() |total_direct_declared: i64 = 0, i: i64 = 0, direct_declared| -> total_direct_declared:
                    total_direct_declared <- total_direct_declared + direct_declared[i.usize()]
                    i <- i + 1
            total_direct_resolved: i64 =
                while i < eco_codes.count.i64() |total_direct_resolved: i64 = 0, i: i64 = 0, direct_resolved| -> total_direct_resolved:
                    total_direct_resolved <- total_direct_resolved + direct_resolved[i.usize()]
                    i <- i + 1
            total_direct_unresolved: i64 =
                while i < eco_codes.count.i64() |total_direct_unresolved: i64 = 0, i: i64 = 0, direct_unresolved| -> total_direct_unresolved:
                    total_direct_unresolved <- total_direct_unresolved + direct_unresolved[i.usize()]
                    i <- i + 1
            total_transitive_resolved: i64 =
                while i < eco_codes.count.i64() |total_transitive_resolved: i64 = 0, i: i64 = 0, transitive_resolved| -> total_transitive_resolved:
                    total_transitive_resolved <- total_transitive_resolved + transitive_resolved[i.usize()]
                    i <- i + 1
            total_runtime_requirements: i64 =
                while i < eco_codes.count.i64() |total_runtime_requirements: i64 = 0, i: i64 = 0, runtime_requirements| -> total_runtime_requirements:
                    total_runtime_requirements <- total_runtime_requirements + runtime_requirements[i.usize()]
                    i <- i + 1
            total_development_requirements: i64 =
                while i < eco_codes.count.i64() |total_development_requirements: i64 = 0, i: i64 = 0, development_requirements| -> total_development_requirements:
                    total_development_requirements <- total_development_requirements + development_requirements[i.usize()]
                    i <- i + 1
            total_optional_requirements: i64 =
                while i < eco_codes.count.i64() |total_optional_requirements: i64 = 0, i: i64 = 0, optional_requirements| -> total_optional_requirements:
                    total_optional_requirements <- total_optional_requirements + optional_requirements[i.usize()]
                    i <- i + 1
            total_peer_requirements: i64 =
                while i < eco_codes.count.i64() |total_peer_requirements: i64 = 0, i: i64 = 0, peer_requirements| -> total_peer_requirements:
                    total_peer_requirements <- total_peer_requirements + peer_requirements[i.usize()]
                    i <- i + 1
            total_unknown_scope_requirements: i64 =
                while i < eco_codes.count.i64() |total_unknown_scope_requirements: i64 = 0, i: i64 = 0, unknown_scope_requirements| -> total_unknown_scope_requirements:
                    total_unknown_scope_requirements <- total_unknown_scope_requirements + unknown_scope_requirements[i.usize()]
                    i <- i + 1
            total_runtime_direct: i64 =
                while i < eco_codes.count.i64() |total_runtime_direct: i64 = 0, i: i64 = 0, runtime_direct| -> total_runtime_direct:
                    total_runtime_direct <- total_runtime_direct + runtime_direct[i.usize()]
                    i <- i + 1
            total_build_direct: i64 =
                while i < eco_codes.count.i64() |total_build_direct: i64 = 0, i: i64 = 0, build_direct| -> total_build_direct:
                    total_build_direct <- total_build_direct + build_direct[i.usize()]
                    i <- i + 1
            total_optional_direct: i64 =
                while i < eco_codes.count.i64() |total_optional_direct: i64 = 0, i: i64 = 0, optional_direct| -> total_optional_direct:
                    total_optional_direct <- total_optional_direct + optional_direct[i.usize()]
                    i <- i + 1
            total_unknown_scope_direct: i64 =
                while i < eco_codes.count.i64() |total_unknown_scope_direct: i64 = 0, i: i64 = 0, unknown_scope_direct| -> total_unknown_scope_direct:
                    total_unknown_scope_direct <- total_unknown_scope_direct + unknown_scope_direct[i.usize()]
                    i <- i + 1
            total_unpinned: i64 =
                while i < eco_codes.count.i64() |total_unpinned: i64 = 0, i: i64 = 0, unpinned| -> total_unpinned:
                    total_unpinned <- total_unpinned + unpinned[i.usize()]
                    i <- i + 1
            total_digest_known: i64 =
                while i < eco_codes.count.i64() |total_digest_known: i64 = 0, i: i64 = 0, digest_known| -> total_digest_known:
                    total_digest_known <- total_digest_known + digest_known[i.usize()]
                    i <- i + 1
            total_digest_nodes: i64 =
                while i < eco_codes.count.i64() |total_digest_nodes: i64 = 0, i: i64 = 0, digest_total| -> total_digest_nodes:
                    total_digest_nodes <- total_digest_nodes + digest_total[i.usize()]
                    i <- i + 1
            total_maximum_depth: i64 =
                while i < eco_codes.count.i64() |total_maximum_depth: i64 = 0, i: i64 = 0, maximum_depth| -> total_maximum_depth:
                    total_maximum_depth <- maximum_depth[i.usize()] if maximum_depth[i.usize()] > total_maximum_depth
                    i <- i + 1
            all_resolutions_complete: bool =
                while i < eco_codes.count.i64() |all_resolutions_complete: bool = true, i: i64 = 0, resolution_complete| -> all_resolutions_complete:
                    all_resolutions_complete <- false if resolution_complete[i.usize()] == 0
                    i <- i + 1
            total_node_count: i64 =
                while i < eco_codes.count.i64() |total_node_count: i64 = 0, i: i64 = 0, node_count| -> total_node_count:
                    total_node_count <- total_node_count + node_count[i.usize()]
                    i <- i + 1
            total_edge_count: i64 =
                while i < eco_codes.count.i64() |total_edge_count: i64 = 0, i: i64 = 0, edge_count| -> total_edge_count:
                    total_edge_count <- total_edge_count + edge_count[i.usize()]
                    i <- i + 1
            total_runtime_edges: i64 =
                while i < eco_codes.count.i64() |total_runtime_edges: i64 = 0, i: i64 = 0, runtime_edges| -> total_runtime_edges:
                    total_runtime_edges <- total_runtime_edges + runtime_edges[i.usize()]
                    i <- i + 1
            total_development_edges: i64 =
                while i < eco_codes.count.i64() |total_development_edges: i64 = 0, i: i64 = 0, development_edges| -> total_development_edges:
                    total_development_edges <- total_development_edges + development_edges[i.usize()]
                    i <- i + 1
            total_optional_edges: i64 =
                while i < eco_codes.count.i64() |total_optional_edges: i64 = 0, i: i64 = 0, optional_edges| -> total_optional_edges:
                    total_optional_edges <- total_optional_edges + optional_edges[i.usize()]
                    i <- i + 1
            total_peer_edges: i64 =
                while i < eco_codes.count.i64() |total_peer_edges: i64 = 0, i: i64 = 0, peer_edges| -> total_peer_edges:
                    total_peer_edges <- total_peer_edges + peer_edges[i.usize()]
                    i <- i + 1
            total_unknown_scope_edges: i64 =
                while i < eco_codes.count.i64() |total_unknown_scope_edges: i64 = 0, i: i64 = 0, unknown_scope_edges| -> total_unknown_scope_edges:
                    total_unknown_scope_edges <- total_unknown_scope_edges + unknown_scope_edges[i.usize()]
                    i <- i + 1
            security_observed: bool = advisories.count == eco_codes.count and eco_codes.count > 0 and advisories[0] >= 0
            total_advisories: mutable i64 = 0
            total_advisory_records: mutable i64 = 0
            total_affected_nodes: mutable i64 = 0
            total_affected_direct_nodes: mutable i64 = 0
            total_affected_transitive_nodes: mutable i64 = 0
            total_affected_unreachable_nodes: mutable i64 = 0
            total_withdrawn: mutable i64 = 0
            total_advisory_unknown_nodes: mutable i64 = 0
            any_fixed_version: mutable bool = false
            if security_observed:
