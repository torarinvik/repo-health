

module Package:
    public:
        # rh_package.elisa — package identities, ecosystems, resolved graphs, OSV
        # matching (M03; Cargo + npm reference pair).
        #
        # Coordinates keep registry identity, namespace, normalized and raw names,
        # and ecosystem-native versions distinct (M03-01); identical names in
        # different registries never collide because the ecosystem is part of the
        # key. Version labels and artifact digests are separate fields everywhere
        # (a digest change under one label is a new artifact, M03-02). Dependency
        # REQUIREMENTS (manifest strings) never become exact edges without
        # resolution evidence; ambiguous Cargo name matches stay unresolved with
        # an explicit reason (M03-03/04, R009). Version comparison is ecosystem-
        # native semver implemented once and documented per-eco (M03 admission).
        # No resolver is executed: resolution is read from lockfiles, and anything
        # computed hypothetically would be labeled, never stored as observed.

        const RH_ECO_CARGO: u8 = 0
        const RH_ECO_NPM: u8 = 1
        const RH_ECO_PYPI: u8 = 2
        const RH_ECO_GO: u8 = 3
        const RH_ECO_RUBYGEMS: u8 = 4
        const RH_ECO_COMPOSER: u8 = 5
        const RH_ECO_NUGET: u8 = 6
        const RH_ECO_MAVEN: u8 = 7

        const RH_PSRC_REGISTRY: u8 = 0
        const RH_PSRC_PATH: u8 = 1
        const RH_PSRC_GIT: u8 = 2
        const RH_PSRC_UNKNOWN: u8 = 3

        const RH_SCOPE_NORMAL: u8 = 0
        const RH_SCOPE_DEV: u8 = 1
        const RH_SCOPE_OPTIONAL: u8 = 2
        const RH_SCOPE_PEER: u8 = 3
        # A declared dependency whose group/scope is not recorded in the source
        # format (Gemfile.lock's DEPENDENCIES block omits Gemfile groups): the
        # scope is genuinely UNKNOWN and must not be guessed as runtime or dev.
        const RH_SCOPE_DECLARED: u8 = 4

        # M03-02 artifact identity outcome. A version LABEL is not an artifact:
        # the same label with different bytes is a NEW artifact and must be
        # re-evaluated, never silently treated as the previously seen one (F024).
        const RH_ART_UNKNOWN: i64 = 0
        const RH_ART_MATCH: i64 = 1
        const RH_ART_CHANGED: i64 = 2

        # Compare an expected digest against an observed digest for one version
        # label. Either side missing => UNKNOWN (never a match). known flags are
        # 1/0; digests are 128-bit split halves.
        def rh_artifact_identity(expected_known: i64, exp_hi: u64, exp_lo: u64, observed_known: i64, obs_hi: u64, obs_lo: u64) -> i64:
            return RH_ART_UNKNOWN if expected_known != 1 or observed_known != 1
            return RH_ART_MATCH if exp_hi == obs_hi and exp_lo == obs_lo
            RH_ART_CHANGED

        # True when the observed bytes constitute a distinct artifact from the
        # expectation. UNKNOWN is NOT distinct (it is unknown), MATCH is not.
        def rh_artifact_is_distinct(state: i64) -> bool:
            state == RH_ART_CHANGED

        # M03-05 repository-claim state. A declared source link is an ASSERTION,
        # not identity (R008/F023): absent evidence it stays unverified, and any
        # conflicting evidence makes it conflicted. Only reviewed verification
        # promotes it, and even then it is not the package identity.
        const RH_CLAIM_NONE: i64 = 0
        const RH_CLAIM_UNVERIFIED: i64 = 1
        const RH_CLAIM_VERIFIED: i64 = 2
        const RH_CLAIM_CONFLICTED: i64 = 3

        def rh_repo_claim_state(claimed: bool, verified_evidence: bool, conflicting_evidence: bool) -> i64:
            return RH_CLAIM_CONFLICTED if conflicting_evidence
            return RH_CLAIM_VERIFIED if verified_evidence
            return RH_CLAIM_UNVERIFIED if claimed
            RH_CLAIM_NONE

        # Only a verified claim may be used as a repository assertion; conflicted
        # and unverified claims must not be silently treated as identity.
        def rh_repo_claim_is_identity(state: i64) -> bool:
            state == RH_CLAIM_VERIFIED

        # OSV ecosystem identifiers per package ecosystem (mapping table, M03-08).
        def rh_osv_ecosystem(eco: u8) -> u8&:
            return "crates.io" if eco == RH_ECO_CARGO
            return "PyPI" if eco == RH_ECO_PYPI
            return "Go" if eco == RH_ECO_GO
            return "RubyGems" if eco == RH_ECO_RUBYGEMS
            return "Packagist" if eco == RH_ECO_COMPOSER
            return "NuGet" if eco == RH_ECO_NUGET
            return "Maven" if eco == RH_ECO_MAVEN
            "npm"

        # Cargo name equality: ASCII case-insensitive, '-' and '_' equivalent
        # (registry rule). Everything else is byte-exact.
        def rh_cargo_name_eq(pool: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if e1 - s1 != e2 - s2
            while k < e1 - s1 |k: usize = 0, pool, s1, s2|:
                a: mutable u8 = pool[s1 + k]
                b: mutable u8 = pool[s2 + k]
                if a >= 65 and a <= 90:
                    a <- a + 32
                if b >= 65 and b <= 90:
                    b <- b + 32
                if a == 95:
                    a <- 45
                if b == 95:
                    b <- 45
                return false if a != b
                k <- k + 1
            true

        def rh_name_eq(eco: u8, pool: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return rh_cargo_name_eq(pool, s1, e1, s2, e2) if eco == RH_ECO_CARGO
            return rh_pypi_name_eq(pool, s1, e1, s2, e2) if eco == RH_ECO_PYPI
            return rh_go_name_eq(pool, s1, e1, s2, e2) if eco == RH_ECO_GO
            return rh_nuget_name_eq(pool, s1, e1, s2, e2) if eco == RH_ECO_NUGET
            return false if e1 - s1 != e2 - s2
            while k < e1 - s1 |k: usize = 0, pool, s1, s2|:
                return false if pool[s1 + k] != pool[s2 + k]
                k <- k + 1
            true

        # NuGet package IDs are compared case-insensitively by the client ecosystem;
        # punctuation remains significant. Preserve the raw spelling in graph output.
        def rh_nuget_name_eq(pool: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if e1 - s1 != e2 - s2
            while k < e1 - s1 |k: usize = 0, pool, s1, s2|:
                a: mutable u8 = pool[s1 + k]
                b: mutable u8 = pool[s2 + k]
                a <- a + 32 if a >= 65 and a <= 90
                b <- b + 32 if b >= 65 and b <= 90
                return false if a != b
                k <- k + 1
            true

        # PyPI (PEP 503) name equality: ASCII case-insensitive with '-', '_' and '.'
        # treated as equivalent separators. Runs are not collapsed in this slice.
        def rh_pypi_name_eq(pool: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if e1 - s1 != e2 - s2
            while k < e1 - s1 |k: usize = 0, pool, s1, s2|:
                a: mutable u8 = pool[s1 + k]
                b: mutable u8 = pool[s2 + k]
                if a >= 65 and a <= 90:
                    a <- a + 32
                if b >= 65 and b <= 90:
                    b <- b + 32
                if a == 95 or a == 46:
                    a <- 45
                if b == 95 or b == 46:
                    b <- 45
                return false if a != b
                k <- k + 1
            true

        # --- Semver (ecosystem-native: strict, no leading zeros, prerelease and
        # build parsed; build ignored in precedence; one leading 'v' tolerated
        # for npm spellings). Spans index the caller's buffer; prerelease span
        # is -1/-1 when absent.
        struct RhSemver:
            major: mutable i64
            minor: mutable i64
            patch: mutable i64
            pre_s: mutable i64
            pre_e: mutable i64

        def rh_sem_digits(data: darray[u8]&, s: usize, e: usize, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            ok_out[0] <- 0
            return 0 if s >= e
            return 0 if data[s] < 48 or data[s] > 57
            return 0 if e - s > 1 and data[s] == 48
            acc: i64 =
                while k < e |acc: i64 = 0, k: usize = s| -> acc:
                    b: u8 = data[k]
                    return 0 if b < 48 or b > 57
                    return 0 if acc > 9223372036854775807 / 10
                    acc <- acc * 10
                    return 0 if acc > 9223372036854775807 - (b - 48).i64()
                    acc <- acc + (b - 48).i64()
                    k <- k + 1
            ok_out[0] <- 1
            acc

        # First of '.', '-', '+' at/after pos, or end. Bounds every version span.
        def rh_span_end(data: darray[u8]&, pos: usize, end: usize) -> usize can[Memory.Allocate, Abort.Panic]:
            m: mutable usize = end
            d: i64 = Base::rh_find_byte(data, pos, 46)
            if d >= 0 and d.usize() < m and d.usize() >= pos:
                m <- d.usize()
            p: i64 = Base::rh_find_byte(data, pos, 45)
            if p >= 0 and p.usize() < m and p.usize() >= pos:
                m <- p.usize()
            b: i64 = Base::rh_find_byte(data, pos, 43)
            if b >= 0 and b.usize() < m and b.usize() >= pos:
                m <- b.usize()
            m

        def rh_semver_parse(data: darray[u8]&, s: usize, e: usize, v: mutable RhSemver&) -> bool can[Memory.Allocate, Abort.Panic]:
            v.major <- 0
            v.minor <- 0
            v.patch <- 0
            v.pre_s <- -1
            v.pre_e <- -1
            return false if s >= e
            cur: mutable usize = s
            if data[cur] == 118:
                cur <- cur + 1
                return false if cur >= e
            me: usize = rh_span_end(data, cur, e)
            ok1: mutable i64 = 0
            major: i64 = rh_sem_digits(data, cur, me, &ok1)
            return false if ok1 == 0
            v.major <- major
            cur <- me
            if cur < e and data[cur] == 46:
                cur <- cur + 1
                me2: usize = rh_span_end(data, cur, e)
                ok2: mutable i64 = 0
                minor: i64 = rh_sem_digits(data, cur, me2, &ok2)
                return false if ok2 == 0
                v.minor <- minor
                cur <- me2
            if cur < e and data[cur] == 46:
                cur <- cur + 1
                me3: usize = rh_span_end(data, cur, e)
                ok3: mutable i64 = 0
                patch: i64 = rh_sem_digits(data, cur, me3, &ok3)
                return false if ok3 == 0
                v.patch <- patch
                cur <- me3
            if cur < e and data[cur] == 45:
                cur <- cur + 1
                pe: mutable usize = e
                bb: i64 = Base::rh_find_byte(data, cur, 43)
                if bb >= 0 and bb.usize() < pe and bb.usize() >= cur:
                    pe <- bb.usize()
                return false if pe <= cur
                return false if not rh_pre_valid(data, cur, pe)
                v.pre_s <- cur.i64()
                v.pre_e <- pe.i64()
                cur <- pe
            if cur < e and data[cur] == 43:
                cur <- cur + 1
                return false if cur >= e
                return false if not rh_pre_valid(data, cur, e)
                cur <- e
            return false if cur != e
            true

        # Dot-separated identifiers, each [0-9A-Za-z-]+ and non-empty.
        def rh_pre_valid(data: darray[u8]&, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s >= e
            need: bool =
                while k < e |need: bool = true, k: usize = s| -> need:
                    b: u8 = data[k]
                    if b == 46:
                        return false if need
                        need <- true
                    elif (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 45:
                        need <- false
                    else:
                        return false
                    k <- k + 1
            not need

        def rh_ident_is_num(data: darray[u8]&, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s >= e
            while k < e |k: usize = s, data|:
                return false if data[k] < 48 or data[k] > 57
                k <- k + 1
            true

        # Compare identifier spans: numeric < alphanumeric; numerics by length
        # then lexically (exact for any width); alphanumerics ASCII.
        def rh_ident_cmp(data: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            n1: bool = rh_ident_is_num(data, s1, e1)
            n2: bool = rh_ident_is_num(data, s2, e2)
            return -1 if n1 and not n2
            return 1 if n2 and not n1
            if n1 and n2:
                if e1 - s1 != e2 - s2:
                    return -1 if e1 - s1 < e2 - s2
                    return 1
            k: mutable usize = 0
            len: mutable usize = e1 - s1
            if e2 - s2 < len:
                len <- e2 - s2
            while k < len |k, data, s1, s2|:
                if data[s1 + k] != data[s2 + k]:
                    return -1 if data[s1 + k] < data[s2 + k]
                    return 1
                k <- k + 1
            if e1 - s1 != e2 - s2:
                return -1 if e1 - s1 < e2 - s2
                return 1
            0

        # Full precedence: -1/0/1. data holds both spans (same or pooled buffer).
        def rh_semver_cmp(data: darray[u8]&, a: RhSemver&, b: RhSemver&) -> i64 can[Memory.Allocate, Abort.Panic]:
            if a.major != b.major:
                return -1 if a.major < b.major
                return 1
            if a.minor != b.minor:
                return -1 if a.minor < b.minor
                return 1
            if a.patch != b.patch:
                return -1 if a.patch < b.patch
                return 1
            a_pre: bool = a.pre_s >= 0
            b_pre: bool = b.pre_s >= 0
            return 0 if not a_pre and not b_pre
            return -1 if a_pre and not b_pre
            return 1 if b_pre and not a_pre
            ai: mutable usize = a.pre_s.usize()
            bi: mutable usize = b.pre_s.usize()
            ae: usize = a.pre_e.usize()
            be: usize = b.pre_e.usize()
            while true |ai, bi, data, ae, be|:
                a_end: usize =
                    while q < ae |a_end: usize = ae, q: usize = ai| -> a_end:
                        if data[q] == 46:
                            a_end <- q
                            q <- ae
                        else:
                            q <- q + 1
                b_end: usize =
                    while r < be |b_end: usize = be, r: usize = bi| -> b_end:
                        if data[r] == 46:
                            b_end <- r
                            r <- be
                        else:
                            r <- r + 1
                c: i64 = rh_ident_cmp(data, ai, a_end, bi, b_end)
                return c if c != 0
                a_done: bool = a_end >= ae
                b_done: bool = b_end >= be
                return 0 if a_done and b_done
                return -1 if a_done
                return 1 if b_done
                ai <- a_end + 1
                bi <- b_end + 1
            0

        # --- Package graph model (M03-01/02/06). Node identities are
        # (ecosystem, registry, normalized name, version, source-kind); the pool
        # owns every string so spans stay valid for the graph lifetime. Edges are
        # RESOLVED (exact from/to indices); anything unresolvable is an
        # RhUnresolved with a reason, never a guessed edge (R009).
        struct RhPkgNode:
            eco: mutable u8
            name_s: mutable i64
            name_e: mutable i64
            ver_s: mutable i64
            ver_e: mutable i64
            src_kind: mutable u8
            has_digest: mutable u8
            dig_s: mutable i64
            dig_e: mutable i64
            dev: mutable u8
            optional: mutable u8

        struct RhDepEdge:
            from: mutable i64
            dst: mutable i64
            depctx: mutable u8

        struct RhUnresolved:
            from: mutable i64
            name_s: mutable i64
            name_e: mutable i64
            req_s: mutable i64
            req_e: mutable i64
            reason: mutable u8

        struct RhRequire:
            from: mutable i64
            name_s: mutable i64
            name_e: mutable i64
            ver_s: mutable i64
            ver_e: mutable i64
            src_s: mutable i64
            src_e: mutable i64
            req_s: mutable i64
            req_e: mutable i64
            depctx: mutable u8

        # Unresolved reasons: 0 no candidate, 1 ambiguous (multiple versions),
        # 2 unsupported context (local/git/deleted refs we do not resolve here).
        const RH_UNRES_MISSING: u8 = 0
        const RH_UNRES_AMBIGUOUS: u8 = 1
        const RH_UNRES_CONTEXT: u8 = 2

        def rh_pool_copy(pool: mutable darray[u8]&, data: darray[u8]&, s: usize, e: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            start: i64 = pool.count.i64()
            while k < e |k: usize = s, pool, data|:
                pool.push(data[k])
                k <- k + 1
            start

        def rh_node_add(pkgs: mutable darray[RhPkgNode]&, eco: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if pkgs.count.i64() > 100000
            pkgs.push(RhPkgNode{eco: eco, name_s: -1, name_e: -1, ver_s: -1, ver_e: -1, src_kind: 3, has_digest: 0, dig_s: -1, dig_e: -1, dev: 0, optional: 0})
            pkgs.count.i64() - 1

        # Exact node match (all coordinates incl. source kind).
        def rh_node_find(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, eco: u8, ns: usize, ne: usize, vs: usize, ve: usize, skind: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool|:
                n: RhPkgNode = pkgs[i.usize()]
                if n.eco == eco and n.src_kind == skind:
                    if rh_name_eq(eco, pool, n.name_s.usize(), n.name_e.usize(), ns, ne):
                        return i if rh_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, vs, ve)
                i <- i + 1
            -1

        # Byte-exact span equality across (possibly distinct) buffers.
        def rh_span_eq2(a: darray[u8]&, s1: usize, e1: usize, b: darray[u8]&, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_span(a, s1.i64(), e1.i64(), b, s2.i64(), e2.i64())

        # --- Cargo.lock subset parser (M03-03/04). Reads [[package]] tables with
        # name/version/source/checksum/dependencies. Well-formed lines with
        # unknown keys are counted (unsupported intact); malformed lines fail the
        # whole parse (fail closed — no half-resolved graph). Returns the package
        # count, or -1 on malformed input.
        def rh_toml_key(line: darray[u8]&, s: usize, e: usize, ks: mutable i64&, ke: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            i: mutable usize =
                while i < e |i: usize = s| -> i:
                    break if line[i] != 32 and line[i] != 9
                    i <- i + 1
            start: usize = i
            while i < e |i, line|:
                b: u8 = line[i]
                if (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 95 or b == 45:
                    i <- i + 1
                else:
                    break
            return false if i == start
            ks[0] <- start.i64()
            ke[0] <- i.i64()
            while i < e |i, line|:
                break if line[i] != 32 and line[i] != 9
                i <- i + 1
            return false if i >= e or line[i] != 61
            true

        # Quoted basic string at pos (pos points at '"'). Decodes \" and \\.
        def rh_quoted_span(line: darray[u8]&, pos: usize, e: usize, pool: mutable darray[u8]&, vs: mutable i64&, ve: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if pos >= e or line[pos] != 34
            i: mutable usize = pos + 1
            start: i64 = pool.count.i64()
            while i < e |i, line, pool|:
                b: u8 = line[i]
                if b == 34:
                    vs[0] <- start
                    ve[0] <- pool.count.i64()
                    return (i + 1).i64()
                if b == 92:
                    i <- i + 1
                    return -1 if i >= e
                    e2: u8 = line[i]
                    if e2 == 34 or e2 == 92:
                        pool.push(e2)
                    else:
                        return -1
                    i <- i + 1
                    continue
                pool.push(b)
                i <- i + 1
            -1

        def rh_span_lit(data: darray[u8]&, s: usize, e: usize, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = strlen(lit)
            return false if e - s != n
            while k < n |k: usize = 0, data, s, lit|:
                return false if data[s + k] != lit[k]
                k <- k + 1
            true

        def rh_cargo_parse(lock: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            unknown_out[0] <- 0
            while pos < lock.count |count: i64 = 0, cur: i64 = -1, in_deps: bool = false, pos: usize = 0, pkgs, pool, reqs, unknown_out| -> count:
                lend: usize =
                    nl: i64 = Base::rh_find_byte(lock, pos, 10)
                    nl.usize() if nl >= 0 else lock.count
                ts: mutable i64 = 0
                te: mutable i64 = 0
                rh_trim_span(lock, pos, lend, &ts, &te)
                if te > ts:
                    if lock[ts.usize()] == 35:
                        pos <- lend + 1
                        continue
                    if lock[ts.usize()] == 91:
                        in_deps <- false
                        if rh_span_lit(lock, ts.usize(), te.usize(), "[[package]]"):
                            cur <- rh_node_add(pkgs, 0)
                            return -1 if cur < 0
                            count <- count + 1
                        else:
                            cur <- -1
                        pos <- lend + 1
                        continue
                    if in_deps:
                        after: i64 = rh_cargo_dep_line(lock, ts.usize(), te.usize(), pool, cur, reqs, in_deps)
                        return -1 if after < 0
                        if after == 0:
                            in_deps <- false
                        pos <- lend + 1
                        continue
                    if cur < 0:
                        pos <- lend + 1
                        continue
                    ks: mutable i64 = 0
                    ke: mutable i64 = 0
                    return -1 if not rh_toml_key(lock, ts.usize(), te.usize(), &ks, &ke)
                    if rh_span_lit(lock, ks.usize(), ke.usize(), "name"):
                        vs: mutable i64 = 0
                        ve: mutable i64 = 0
                        return -1 if rh_toml_qstring(lock, ke.usize(), te.usize(), pool, &vs, &ve) < 0
                        node: mutable RhPkgNode = pkgs[cur.usize()]
                        node.name_s <- vs
                        node.name_e <- ve
                        pkgs[cur.usize()] <- node
                    elif rh_span_lit(lock, ks.usize(), ke.usize(), "version"):
                        vs2: mutable i64 = 0
                        ve2: mutable i64 = 0
                        return -1 if rh_toml_qstring(lock, ke.usize(), te.usize(), pool, &vs2, &ve2) < 0
                        node2: mutable RhPkgNode = pkgs[cur.usize()]
                        node2.ver_s <- vs2
                        node2.ver_e <- ve2
                        pkgs[cur.usize()] <- node2
                    elif rh_span_lit(lock, ks.usize(), ke.usize(), "source"):
                        vs3: mutable i64 = 0
                        ve3: mutable i64 = 0
                        return -1 if rh_toml_qstring(lock, ke.usize(), te.usize(), pool, &vs3, &ve3) < 0
                        node3: mutable RhPkgNode = pkgs[cur.usize()]
                        node3.src_kind <- rh_cargo_src_kind(pool, vs3.usize(), ve3.usize())
                        pkgs[cur.usize()] <- node3
                    elif rh_span_lit(lock, ks.usize(), ke.usize(), "checksum"):
                        vs4: mutable i64 = 0
                        ve4: mutable i64 = 0
                        return -1 if rh_toml_qstring(lock, ke.usize(), te.usize(), pool, &vs4, &ve4) < 0
                        node4: mutable RhPkgNode = pkgs[cur.usize()]
                        node4.has_digest <- 1
                        node4.dig_s <- vs4
                        node4.dig_e <- ve4
                        pkgs[cur.usize()] <- node4
                    elif rh_span_lit(lock, ks.usize(), ke.usize(), "dependencies"):
                        di: mutable usize =
                            while di < te.usize() |di: usize = ke.usize()| -> di:
                                break if lock[di] != 32 and lock[di] != 9 and lock[di] != 61
                                di <- di + 1
                        return -1 if di >= te.usize() or lock[di] != 91
                        di <- di + 1
                        after2: i64 = rh_cargo_dep_line(lock, di, te.usize(), pool, cur, reqs, in_deps)
                        return -1 if after2 < 0
                        if after2 == 0:
                            in_deps <- false
                        else:
                            in_deps <- true
                    else:
                        unknown_out[0] <- unknown_out[0] + 1
                pos <- lend + 1

        # Parse dependency entries in [s, e). Returns 1 when the list stays open
        # (no ']' seen), 0 when closed, -1 malformed. in_deps echoes the mode
        # for the caller's convenience (unused internally).
        def rh_cargo_dep_line(line: darray[u8]&, s: usize, e: usize, pool: mutable darray[u8]&, cur: i64, reqs: mutable darray[RhRequire]&, in_deps: bool) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < e |i: usize = s, line, pool, cur, reqs|:
                b: u8 = line[i]
                if b == 32 or b == 9 or b == 44:
                    i <- i + 1
                    continue
                return 0 if b == 93
                return -1 if b != 34
                vs: mutable i64 = 0
                ve: mutable i64 = 0
                nxt: i64 = rh_quoted_span(line, i, e, pool, &vs, &ve)
                return -1 if nxt < 0
                i <- nxt.usize()
                nm_e: mutable usize = ve.usize()
                k: mutable usize =
                    while k < ve.usize() |k: usize = vs.usize(), pool| -> k:
                        break if pool[k] == 32
                        k <- k + 1
                nm_e <- k
                ver_s: mutable i64 = -1
                ver_e: mutable i64 = -1
                src_s: mutable i64 = -1
                src_e: mutable i64 = -1
                if k < ve.usize():
                    rest: mutable usize =
                        while rest < ve.usize() |rest: usize = k + 1, pool| -> rest:
                            break if pool[rest] != 32
                            rest <- rest + 1
                    if rest < ve.usize() and pool[rest] == 40:
                        src_s <- (rest + 1).i64()
                        src_e <- ve
                        return -1 if pool[ve.usize() - 1] != 41
                        src_e <- (ve.usize() - 1).i64()
                    else:
                        vend: usize =
                            while vend < ve.usize() |vend: usize = rest, pool| -> vend:
                                break if pool[vend] == 32 or pool[vend] == 40
                                vend <- vend + 1
                        ver_s <- rest.i64()
                        ver_e <- vend.i64()
                        if vend < ve.usize() and pool[vend] == 40:
                            return -1 if pool[ve.usize() - 1] != 41
                            src_s <- (vend + 1).i64()
                            src_e <- (ve.usize() - 1).i64()
                req: RhRequire = RhRequire{from: cur, name_s: vs, name_e: nm_e.i64(), ver_s: ver_s, ver_e: ver_e, src_s: src_s, src_e: src_e, req_s: -1, req_e: -1, depctx: 0}
                reqs.push(req)
            1

        # Quoted basic string value after "key =": skip spaces, expect '=', then
        # a quoted span (\" and \\ escapes; anything else fails closed).
        def rh_toml_qstring(line: darray[u8]&, pos: usize, e: usize, pool: mutable darray[u8]&, vs: mutable i64&, ve: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            i: mutable usize =
                while i < e |i: usize = pos| -> i:
                    break if line[i] != 32 and line[i] != 9
                    i <- i + 1
            return -1 if i >= e or line[i] != 61
            i <- i + 1
            while i < e |i, line|:
                break if line[i] != 32 and line[i] != 9
                i <- i + 1
            rh_quoted_span(line, i, e, pool, vs, ve)

        # Append an edge unless the identical (from, to, depctx) triple exists.
        def rh_edge_add(edges: mutable darray[RhDepEdge]&, from: i64, dst: i64, depctx: u8) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < edges.count.i64() |i: i64 = 0, edges, from, dst, depctx|:
                e: RhDepEdge = edges[i.usize()]
                return false if e.from == from and e.dst == dst and e.depctx == depctx
                i <- i + 1
            edges.push(RhDepEdge{from: from, dst: dst, depctx: depctx})
            true

        # Resolve Cargo requirements to exact edges. Bare names with several
        # same-name versions stay UNRESOLVED (reason 1): without the registry
        # index there is no evidence which one applies (R009). A pinned
        # "name version (source)" entry resolves by exact version match.
        def rh_cargo_resolve(pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while r < reqs.count |made: i64 = 0, r: usize = 0, pkgs, pool, edges, unresolved| -> made:
                q: RhRequire = reqs[r]
                first, count =
                    while n < pkgs.count.i64() |first: i64 = -1, count: i64 = 0, n: i64 = 0, pkgs, pool| -> first, count:
                        nd: RhPkgNode = pkgs[n.usize()]
                        if nd.eco == 0 and rh_name_eq(0, pool, nd.name_s.usize(), nd.name_e.usize(), q.name_s.usize(), q.name_e.usize()):
                            if first < 0:
                                first <- n
                            count <- count + 1
                        n <- n + 1
                if count == 0:
                    unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: -1, req_e: -1, reason: 0})
                elif count == 1:
                    if rh_edge_add(edges, q.from, first, 0):
                        made <- made + 1
                else:
                    if q.ver_s < 0:
                        unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: -1, req_e: -1, reason: 1})
                    else:
                        rv: mutable RhSemver = RhSemver{major: 0, minor: 0, patch: 0, pre_s: 0, pre_e: 0}
                        if not rh_semver_parse(pool, q.ver_s.usize(), q.ver_e.usize(), &rv):
                            unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.ver_s, req_e: q.ver_e, reason: 0})
                        else:
                            hits, hit_idx =
                                while m < pkgs.count.i64() |hits: i64 = 0, hit_idx: i64 = -1, m: i64 = 0, pkgs, pool, rv| -> hits, hit_idx:
                                    nd2: RhPkgNode = pkgs[m.usize()]
                                    if nd2.eco == 0 and rh_name_eq(0, pool, nd2.name_s.usize(), nd2.name_e.usize(), q.name_s.usize(), q.name_e.usize()):
                                        cv: mutable RhSemver = RhSemver{major: 0, minor: 0, patch: 0, pre_s: 0, pre_e: 0}
                                        if rh_semver_parse(pool, nd2.ver_s.usize(), nd2.ver_e.usize(), &cv):
                                            if rh_semver_cmp(pool, &rv, &cv) == 0:
                                                hits <- hits + 1
                                                hit_idx <- m
                                    m <- m + 1
                            if hits == 1:
                                if rh_edge_add(edges, q.from, hit_idx, 0):
                                    made <- made + 1
                            elif hits == 0:
                                unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.ver_s, req_e: q.ver_e, reason: 0})
                            else:
                                if rh_edge_add(edges, q.from, hit_idx, 0):
                                    made <- made + 1
                r <- r + 1

        def rh_cargo_src_kind(pool: darray[u8]&, s: usize, e: usize) -> u8 can[Memory.Allocate, Abort.Panic]:
            return 0 if rh_span_prefix(pool, s, e, "registry+")
            return 2 if rh_span_prefix(pool, s, e, "git+")
            return 1 if rh_span_prefix(pool, s, e, "path+")
            3

        def rh_span_prefix(pool: darray[u8]&, s: usize, e: usize, prefix: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = strlen(prefix)
            return false if e - s < n
            while k < n |k: usize = 0, pool, s, prefix|:
                return false if pool[s + k] != prefix[k]
                k <- k + 1
            true

        def rh_trim_span(line: darray[u8]&, s: usize, e: usize, os: mutable i64&, oe: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            a: usize =
                while a < e |a: usize = s| -> a:
                    break if line[a] != 32 and line[a] != 9 and line[a] != 13
                    a <- a + 1
            b: usize =
                while b > a |b: usize = e| -> b:
                    break if line[b - 1] != 32 and line[b - 1] != 9 and line[b - 1] != 13
                    b <- b - 1
            os[0] <- a.i64()
            oe[0] <- b.i64()

        # --- npm lock/package parsers (M03-03/04). lockfileVersion 2/3 "packages"
        # maps plus legacy v1 "dependencies" trees, plus package.json requirement
        # maps (dependencies/dev/peer/optional). Resolution is Node-style
        # directory walk-up over install paths; link:true entries resolve as
        # path-kind pkgs; entries without versions fail the parse except links
        # (recorded unresolved, reason 2). Requirement STRINGS are preserved
        # verbatim in req_s/req_e and never treated as resolved versions (R009).

        def rh_npm_entry_name(pool: mutable darray[u8]&, ps: usize, pe: usize, ns: mutable i64&, ne: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if pe <= ps
            last: usize =
                while k < pe |last: usize = pe, k: usize = ps, pool| -> last:
                    if pool[k] == 47:
                        last <- k + 1
                    k <- k + 1
            return false if last >= pe
            if last > ps and pool[last - 1] == 47:
                scope_at: usize =
                    while q < last - 1 |scope_at: usize = ps, q: usize = ps, pool| -> scope_at:
                        if pool[q] == 47:
                            scope_at <- q + 1
                        q <- q + 1
                if pool[scope_at] == 64:
                    ns[0] <- scope_at.i64()
                    ne[0] <- pe.i64()
                    return true
            ns[0] <- last.i64()
            ne[0] <- pe.i64()
            true

        def rh_npm_copy_span(pool: mutable darray[u8]&, texts: darray[u8]&, s: usize, e: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            start: i64 = pool.count.i64()
            while k < e |k: usize = s, pool, texts|:
                pool.push(texts[k])
                k <- k + 1
            start

        # Collect one requirement map (name -> range string) from a JSON object.
        def rh_npm_req_map(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, obj: i64, from: i64, depctx: u8, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            o: Json::RhJsonNode = jnodes[obj.usize()]
            while child >= 0 |made: i64 = 0, child: i64 = o.first_child, pool, reqs| -> made:
                kn: Json::RhJsonNode = jnodes[child.usize()]
                vn: i64 = kn.next_sibling
                return -1 if vn < 0
                vv: Json::RhJsonNode = jnodes[vn.usize()]
                return -1 if vv.kind != 3
                ns: i64 = rh_pool_copy(pool, texts, kn.text_start.usize(), kn.text_end.usize())
                ne: i64 = pool.count.i64()
                rs: i64 = rh_pool_copy(pool, texts, vv.text_start.usize(), vv.text_end.usize())
                re: i64 = pool.count.i64()
                reqs.push(RhRequire{from: from, name_s: ns, name_e: ne, ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: rs, req_e: re, depctx: depctx})
                made <- made + 1
                child <- jnodes[vn.usize()].next_sibling

        def rh_npm_scope_of(texts: darray[u8]&, mapkey_s: usize, mapkey_e: usize) -> u8 can[Memory.Allocate, Abort.Panic]:
            return 1 if rh_span_eq_text(texts, mapkey_s, mapkey_e, "devDependencies")
            return 2 if rh_span_eq_text(texts, mapkey_s, mapkey_e, "optionalDependencies")
            return 3 if rh_span_eq_text(texts, mapkey_s, mapkey_e, "peerDependencies")
            0

        # Node lookup by install path (exact bytes, pool spans vs candidate span).
        def rh_npm_find_path(nodes: darray[RhPkgNode]&, paths: darray[i64]&, pool: mutable darray[u8]&, want: darray[u8]&, want_s: usize, want_e: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < nodes.count.i64() |i: i64 = 0, nodes, paths, pool, want|:
                ps: usize = paths[(i * 2).usize()].usize()
                pe: usize = paths[(i * 2 + 1).usize()].usize()
                return i if rh_span_eq2(pool, ps, pe, want, want_s, want_e)
                i <- i + 1
            -1

        # Node-style walk-up: dir(P)/node_modules/D, then parents, then root.
        # Returns node idx, or -1 with reason in reason_out (0 missing, 2 peer).
        def rh_npm_lookup(pkgs: darray[RhPkgNode]&, paths: darray[i64]&, pool: mutable darray[u8]&, entry_path_s: usize, entry_path_e: usize, dep_s: usize, dep_e: usize, peer: bool, reason_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            reason_out[0] <- 0
            while done == false |dirpos: usize = entry_path_e, done: bool = false, pool, entry_path_s, dep_s, dep_e|:
                hit: i64 = |pool|
                    cand: mutable darray[u8] = []
                    if dirpos > entry_path_s:
                        while k < dirpos |k: usize = entry_path_s, pool, cand|:
                            cand.push(pool[k])
                            k <- k + 1
                        cand.push(47)
                    Base::rh_push_text(cand, "node_modules/")
                    while q < dep_e |q: usize = dep_s, pool, cand|:
                        cand.push(pool[q])
                        q <- q + 1
                    block_result: i64 = rh_npm_find_path(pkgs, paths, pool, cand, 0, cand.count)
                    block_result
                return hit if hit >= 0
                if dirpos <= entry_path_s:
                    done <- true
                else:
                    back: usize =
                        while back > entry_path_s |back: usize = dirpos, pool| -> back:
                            break if pool[back - 1] == 47
                            back <- back - 1
                    if back <= entry_path_s:
                        dirpos <- entry_path_s
                    else:
                        dirpos <- back - 1
            if peer:
                reason_out[0] <- 2
            -1

        # Register one lock entry as a node. Returns idx or -1 malformed.
        # entry_path is the lock key span ("" for root).
        def rh_npm_add_node(pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, paths: mutable darray[i64]&, texts: darray[u8]&, input: darray[u8]&, entry: i64, enodes: darray[Json::RhJsonNode]&, ps: usize, pe: usize, fallback_name_s: i64, fallback_name_e: i64, fallback_ver_s: i64, fallback_ver_e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            idx: i64 = rh_node_add(pkgs, 1)
            return -1 if idx < 0
            paths.push(ps.i64())
            paths.push(pe.i64())
            n: mutable RhPkgNode = pkgs[idx.usize()]
            nm: i64 = Json::rh_json_obj_get(enodes, texts, entry, "name")
            if nm >= 0:
                nn: Json::RhJsonNode = enodes[nm.usize()]
                if nn.kind == 3:
                    n.name_s <- rh_pool_copy(pool, texts, nn.text_start.usize(), nn.text_end.usize())
                    n.name_e <- pool.count.i64()
                else:
                    return -1
            elif fallback_name_s >= 0:
                n.name_s <- rh_pool_copy(pool, texts, fallback_name_s.usize(), fallback_name_e.usize())
                n.name_e <- pool.count.i64()
            else:
                ns2: mutable i64 = 0
                ne2: mutable i64 = 0
                return -1 if not rh_npm_entry_name(pool, ps, pe, &ns2, &ne2)
                n.name_s <- ns2
                n.name_e <- ne2
            vi: i64 = Json::rh_json_obj_get(enodes, texts, entry, "version")
            if vi >= 0:
                vn2: Json::RhJsonNode = enodes[vi.usize()]
                return -1 if vn2.kind != 3
                n.ver_s <- rh_pool_copy(pool, texts, vn2.text_start.usize(), vn2.text_end.usize())
                n.ver_e <- pool.count.i64()
            elif fallback_ver_s >= 0:
                n.ver_s <- rh_pool_copy(pool, texts, fallback_ver_s.usize(), fallback_ver_e.usize())
                n.ver_e <- pool.count.i64()
            else:
                link: i64 = Json::rh_json_obj_get(enodes, texts, entry, "link")
                return -1 if link < 0 or not Json::rh_json_is_true(enodes, input, link)
                n.src_kind <- 1
                n.ver_s <- -1
                n.ver_e <- -1
            integ: i64 = Json::rh_json_obj_get(enodes, texts, entry, "integrity")
            if integ >= 0:
                ni3: Json::RhJsonNode = enodes[integ.usize()]
                if ni3.kind == 3:
                    n.has_digest <- 1
                    n.dig_s <- rh_pool_copy(pool, texts, ni3.text_start.usize(), ni3.text_end.usize())
                    n.dig_e <- pool.count.i64()
            devf: i64 = Json::rh_json_obj_get(enodes, texts, entry, "dev")
            if devf >= 0 and Json::rh_json_is_true(enodes, input, devf):
                n.dev <- 1
            optf: i64 = Json::rh_json_obj_get(enodes, texts, entry, "optional")
            if optf >= 0 and Json::rh_json_is_true(enodes, input, optf):
                n.optional <- 1
            pkgs[idx.usize()] <- n
            idx

        # v1 legacy "dependencies" tree walk. curpath is the pool span of the
        # containing depctx ("" at top). Returns 0 ok, -1 malformed.
        # v1 requirements: the "requires" object maps names to range strings.
        # Nested "dependencies" are package ENTRIES (walked separately), never
        # requirement strings (R009).
        def rh_npm_v1_requires(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, entry: i64, from: i64, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            req: i64 = Json::rh_json_obj_get(jnodes, texts, entry, "requires")
            return 0 if req < 0
            rn: Json::RhJsonNode = jnodes[req.usize()]
            return 0 if rn.kind != 5
            rh_npm_req_map(jnodes, pool, texts, req, from, 0, reqs)

        def rh_npm_v1_walk(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, input: darray[u8]&, obj: i64, cur_s: usize, cur_e: usize, pkgs: mutable darray[RhPkgNode]&, paths: mutable darray[i64]&, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            o: Json::RhJsonNode = jnodes[obj.usize()]
            while child >= 0 |child: i64 = o.first_child, jnodes, pool, texts, cur_s, cur_e, pkgs, paths, reqs|:
                kn: Json::RhJsonNode = jnodes[child.usize()]
                vn: i64 = kn.next_sibling
                return -1 if vn < 0
                entry_idx: i64 = |pool, pkgs, paths|
                    vv: Json::RhJsonNode = jnodes[vn.usize()]
                    return -1 if vv.kind != 5
                    kid_s: mutable i64 = 0
                    kid_e: mutable i64 = 0
                    return -1 if not rh_npm_child_path(pool, cur_s, cur_e, texts, kn.text_start.usize(), kn.text_end.usize(), &kid_s, &kid_e)
                    block_result: i64 = rh_npm_add_node(pkgs, pool, paths, texts, input, vn, jnodes, kid_s.usize(), kid_e.usize(), -1, -1, -1, -1)
                    block_result
                return -1 if entry_idx < 0
                return -1 if rh_npm_v1_requires(jnodes, pool, texts, vn, entry_idx, reqs) < 0
                nested: i64 = Json::rh_json_obj_get(jnodes, texts, vn, "dependencies")
                if nested >= 0:
                    nn2: Json::RhJsonNode = jnodes[nested.usize()]
                    return -1 if nn2.kind != 5
                    ps2: mutable i64 = 0
                    pe2: mutable i64 = 0
                    return -1 if not rh_node_path(pkgs, paths, entry_idx, &ps2, &pe2)
                    return -1 if rh_npm_v1_walk(jnodes, pool, texts, input, nested, ps2.usize(), pe2.usize(), pkgs, paths, reqs) < 0
                child <- jnodes[vn.usize()].next_sibling
            0

        # Child install path = depctx + "/node_modules/" + key, appended to pool.
        # Staged through a temp buffer: pool may reallocate while growing, so it
        # is never read and written in one pass. Reports span via outs.
        def rh_npm_child_path(pool: mutable darray[u8]&, cur_s: usize, cur_e: usize, texts: darray[u8]&, ks: usize, ke: usize, ps_out: mutable i64&, pe_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            tmp: mutable darray[u8] = []
            if cur_e > cur_s:
                while k < cur_e |k: usize = cur_s, pool, tmp|:
                    tmp.push(pool[k])
                    k <- k + 1
                tmp.push(47)
            Base::rh_push_text(tmp, "node_modules/")
            while q < ke |q: usize = ks, tmp, texts|:
                tmp.push(texts[q])
                q <- q + 1
            ps_out[0] <- pool.count.i64()
            pool.extend(bytes_view(tmp))
            pe_out[0] <- pool.count.i64()
            true

        def rh_node_path(pkgs: darray[RhPkgNode]&, paths: darray[i64]&, idx: i64, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if idx < 0 or idx >= pkgs.count.i64()
            s_out[0] <- paths[(idx * 2).usize()]
            e_out[0] <- paths[(idx * 2 + 1).usize()]
            true

        # Top-level npm lockfile driver. lock_bytes holds package-lock.json;
        # pkg_bytes holds package.json or is empty. Builds pkgs (path spans in
        # paths[]), requirements, then resolves. Root identity comes from the
        # lock top-level name/version (always present in real locks; missing
        # fails closed). Returns the root index, or -1 malformed.
        def rh_npm_lock_parse(lock_bytes: darray[u8]&, pkg_bytes: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, paths: mutable darray[i64]&, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            lnodes: mutable darray[Json::RhJsonNode] = []
            ltexts: mutable darray[u8] = []
            lroot: i64 = Json::rh_json_parse(lock_bytes, lnodes, ltexts)
            return -1 if lroot < 0
            lro: Json::RhJsonNode = lnodes[lroot.usize()]
            return -1 if lro.kind != 5
            tn_s: mutable i64 = -1
            tn_e: mutable i64 = -1
            tv_s: mutable i64 = -1
            tv_e: mutable i64 = -1
            tn: i64 = Json::rh_json_obj_get(lnodes, ltexts, lroot, "name")
            if tn >= 0:
                tnn: Json::RhJsonNode = lnodes[tn.usize()]
                return -1 if tnn.kind != 3
                tn_s <- rh_pool_copy(pool, ltexts, tnn.text_start.usize(), tnn.text_end.usize())
                tn_e <- pool.count.i64()
            tv: i64 = Json::rh_json_obj_get(lnodes, ltexts, lroot, "version")
            if tv >= 0:
                tvn: Json::RhJsonNode = lnodes[tv.usize()]
                return -1 if tvn.kind != 3
                tv_s <- rh_pool_copy(pool, ltexts, tvn.text_start.usize(), tvn.text_end.usize())
                tv_e <- pool.count.i64()
            return -1 if tn_s < 0 or tv_s < 0
            root: i64 = rh_node_add(pkgs, 1)
            return -1 if root < 0
            paths.push(0)
            paths.push(0)
            rn: mutable RhPkgNode = pkgs[root.usize()]
            rn.name_s <- tn_s
            rn.name_e <- tn_e
            rn.ver_s <- tv_s
            rn.ver_e <- tv_e
            pkgs[root.usize()] <- rn
            pkgs_obj: i64 = Json::rh_json_obj_get(lnodes, ltexts, lroot, "packages")
            if pkgs_obj >= 0:
                pk: Json::RhJsonNode = lnodes[pkgs_obj.usize()]
                return -1 if pk.kind != 5
                return -1 if rh_npm_packages_walk(lnodes, pool, ltexts, lock_bytes, pkgs_obj, root, tn_s, tn_e, tv_s, tv_e, pkgs, paths, reqs) < 0
            else:
                deps: i64 = Json::rh_json_obj_get(lnodes, ltexts, lroot, "dependencies")
                return -1 if deps < 0
                dd: Json::RhJsonNode = lnodes[deps.usize()]
                return -1 if dd.kind != 5
                return -1 if rh_npm_v1_walk(lnodes, pool, ltexts, lock_bytes, deps, 0, 0, pkgs, paths, reqs) < 0
            if pkg_bytes.count > 0:
                return -1 if rh_npm_package_json(pkg_bytes, root, pkgs, pool, reqs) < 0
            root

        # v2/v3 "packages" map walk. The "" entry reuses the root node (name and
        # version fall back to top-level when absent there).
        def rh_npm_packages_walk(lnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, ltexts: darray[u8]&, linput: darray[u8]&, pkgs_obj: i64, root: i64, tn_s: i64, tn_e: i64, tv_s: i64, tv_e: i64, pkgs: mutable darray[RhPkgNode]&, paths: mutable darray[i64]&, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            po: Json::RhJsonNode = lnodes[pkgs_obj.usize()]
            while child >= 0 |child: i64 = po.first_child, lnodes, pool, ltexts, root, tn_s, tn_e, tv_s, tv_e, pkgs, paths, reqs|:
                kn: Json::RhJsonNode = lnodes[child.usize()]
                vn: i64 = kn.next_sibling
                return -1 if vn < 0
                vv: Json::RhJsonNode = lnodes[vn.usize()]
                return -1 if vv.kind != 5
                ps: i64 = rh_pool_copy(pool, ltexts, kn.text_start.usize(), kn.text_end.usize())
                pe: i64 = pool.count.i64()
                if ps == pe:
                    return -1 if rh_npm_entry_reqs(lnodes, pool, ltexts, vn, root, reqs) < 0
                else:
                    idx: i64 = rh_npm_add_node(pkgs, pool, paths, ltexts, linput, vn, lnodes, ps.usize(), pe.usize(), -1, -1, -1, -1)
                    return -1 if idx < 0
                    return -1 if rh_npm_entry_reqs(lnodes, pool, ltexts, vn, idx, reqs) < 0
                child <- lnodes[vn.usize()].next_sibling
            0

        # package.json: root name/version cross-check skipped (lock wins for
        # identity); its four dependency maps become scoped requirements.
        def rh_npm_package_json(pkg_bytes: darray[u8]&, root: i64, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            pnodes: mutable darray[Json::RhJsonNode] = []
            ptexts: mutable darray[u8] = []
            proot: i64 = Json::rh_json_parse(pkg_bytes, pnodes, ptexts)
            return -1 if proot < 0
            po: Json::RhJsonNode = pnodes[proot.usize()]
            return -1 if po.kind != 5
            return -1 if rh_npm_entry_reqs(pnodes, pool, ptexts, proot, root, reqs) < 0
            0

        # Iterate one entry's four dependency maps into requirements.
        def rh_npm_entry_reqs(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, entry: i64, from: i64, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            maps: mutable i64 = 0
            maps <- maps + rh_npm_map_reqs(jnodes, pool, texts, entry, from, "dependencies", 0, reqs)
            maps <- maps + rh_npm_map_reqs(jnodes, pool, texts, entry, from, "devDependencies", 1, reqs)
            maps <- maps + rh_npm_map_reqs(jnodes, pool, texts, entry, from, "optionalDependencies", 2, reqs)
            maps <- maps + rh_npm_map_reqs(jnodes, pool, texts, entry, from, "peerDependencies", 3, reqs)
            maps

        def rh_npm_map_reqs(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, entry: i64, from: i64, mapkey: u8&, depctx: u8, reqs: mutable darray[RhRequire]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            m: i64 = Json::rh_json_obj_get(jnodes, texts, entry, mapkey)
            return 0 if m < 0
            mo: Json::RhJsonNode = jnodes[m.usize()]
            return -1 if mo.kind != 5
            rh_npm_req_map(jnodes, pool, texts, m, from, depctx, reqs)

        # Resolve every collected requirement via walk-up. Returns edge count.
        def rh_npm_resolve(pkgs: darray[RhPkgNode]&, paths: darray[i64]&, pool: mutable darray[u8]&, reqs: darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while r < reqs.count |made: i64 = 0, r: usize = 0, pool, edges, unresolved| -> made:
                q: RhRequire = reqs[r]
                from_path_s: mutable usize = 0
                from_path_e: mutable usize = 0
                if q.from >= 0:
                    f2a: i64 = q.from * 2
                    from_path_s <- paths[f2a.usize()].usize()
                    f2b: i64 = q.from * 2 + 1
                    from_path_e <- paths[f2b.usize()].usize()
                reason: mutable i64 = 0
                hit: i64 = rh_npm_lookup(pkgs, paths, pool, from_path_s, from_path_e, q.name_s.usize(), q.name_e.usize(), q.depctx == 3, &reason)
                if hit >= 0:
                    if rh_edge_add(edges, q.from, hit, q.depctx):
                        made <- made + 1
                else:
                    code: u8 = 2 if reason == 2 else 0
                    unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.req_s, req_e: q.req_e, reason: code})
                r <- r + 1

        def rh_span_eq_text(texts: darray[u8]&, s: usize, e: usize, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s.i64(), e.i64(), lit)

        # --- Bounded graph queries (M03-06/M05-05 subset). BFS over outgoing
        # edges with a visited set, depth limit, and truncation flag (never a
        # fabricated total when truncated). Reverse BFS over incoming edges for
        # dependent counts. Witness paths via parent pointers (bounded length).
        # Budgets: node/edge visits counted; exceeding max_visits stops with
        # truncated=1 (S012).

        def rh_graph_out_count(edges: darray[RhDepEdge]&, node: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < edges.count.i64() |total: i64 = 0, i: i64 = 0| -> total:
                if edges[i.usize()].from == node:
                    total <- total + 1
                i <- i + 1

        def rh_graph_in_count(edges: darray[RhDepEdge]&, node: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < edges.count.i64() |total: i64 = 0, i: i64 = 0| -> total:
                if edges[i.usize()].dst == node:
                    total <- total + 1
                i <- i + 1

        # Direct dependency projections use the selected graph root. Requirements
        # and unresolved records remain distinct from exact edges; resolved
        # versions are counted as unique destination nodes even when scopes
        # produce duplicate edge records.
        def rh_direct_requirement_count(reqs: mutable darray[RhRequire]&, root: mutable i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < reqs.count |total: i64 = 0, i: i64 = 0, reqs, root| -> total:
                total <- total + 1 if reqs[i.usize()].from == root
                i <- i + 1

        def rh_direct_unresolved_count(unresolved: mutable darray[RhUnresolved]&, root: mutable i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < unresolved.count |total: i64 = 0, i: i64 = 0, unresolved, root| -> total:
                total <- total + 1 if unresolved[i.usize()].from == root
                i <- i + 1

        # Count declarations by their source-native dependency scope.
        # `declared` is an explicit unknown scope (for example Gemfile.lock's
        # DEPENDENCIES block), never an inferred runtime dependency.
        def rh_scope_count(reqs: mutable darray[RhRequire]&, scope: mutable u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < reqs.count |total: i64 = 0, i: i64 = 0, reqs, scope| -> total:
                total <- total + 1 if reqs[i.usize()].depctx == scope
                i <- i + 1

        # Count resolved graph relations by their preserved source scope. A
        # declaration can remain unresolved, so these counts intentionally do
        # not have to sum to the requirement-scope counts.
        def rh_edge_scope_count(edges: mutable darray[RhDepEdge]&, scope: mutable u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < edges.count |total: i64 = 0, i: i64 = 0, edges, scope| -> total:
                total <- total + 1 if edges[i.usize()].depctx == scope
                i <- i + 1

        def rh_direct_resolved_count(edges: mutable darray[RhDepEdge]&, root: mutable i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            seen: mutable darray[i64] = []
            while i < edges.count |i: i64 = 0, edges, root, seen| -> seen.count.i64():
                e: mutable RhDepEdge = edges[i.usize()]
                if e.from == root:
                    already: bool =
                        while j < seen.count |already: bool = false, j: i64 = 0, seen, e| -> already:
                            already <- true if seen[j.usize()] == e.dst
                            j <- j + 1
                    seen.push(e.dst) if not already
                i <- i + 1

        def rh_visited_has(visited: darray[i64]&, node: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < visited.count |i: usize = 0, visited, node|:
                return true if visited[i] == node
                i <- i + 1
            false

        # Complete reachability from one root over the finite graph. The node
        # count bounds the walk, so cycles terminate without an arbitrary depth
        # parameter; the root itself is excluded from the returned count.
        def rh_reachable_dependency_count(edges: mutable darray[RhDepEdge]&, node_count: mutable i64, root: mutable i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if node_count <= 0 or root < 0 or root >= node_count
            frontier: mutable darray[i64] = []
            seen: mutable darray[i64] = []
            frontier.push(root)
            while fi < frontier.count |fi: i64 = 0, frontier, seen, edges, node_count|:
                cur: mutable i64 = frontier[fi.usize()]
                fi <- fi + 1
                continue if rh_visited_has(seen, cur)
                seen.push(cur)
                return seen.count.i64() - 1 if seen.count.i64() >= node_count
                while ei < edges.count.i64() |ei: i64 = 0, edges, cur, frontier, seen|:
                    edge: mutable RhDepEdge = edges[ei.usize()]
                    if edge.from == cur and not rh_visited_has(seen, edge.dst):
                        frontier.push(edge.dst)
                    ei <- ei + 1
            seen.count.i64() - 1

        # Forward BFS from roots. visited_out collects unique reachable nodes
        # EXCLUDING the roots themselves; trunc_out 1 when a budget/depth limit
        # stopped the walk. Returns the visited count, or -1 on bad input.
        def rh_graph_bfs(edges: darray[RhDepEdge]&, node_count: i64, roots: darray[i64]&, max_depth: i64, max_visits: i64, visited_out: mutable darray[i64]&, trunc_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            trunc_out[0] <- 0
            return -1 if max_depth < 0 or max_visits <= 0
            frontier: mutable darray[i64] = []
            depths: mutable darray[i64] = []
            while r < roots.count |r: usize = 0, roots, frontier, depths|:
                frontier.push(roots[r])
                depths.push(0)
                r <- r + 1
            seen: mutable darray[i64] = []
            while fi < frontier.count |fi: usize = 0, frontier, depths, edges, node_count, max_depth, max_visits, visited_out, seen, trunc_out|:
                if visited_out.count.i64() + seen.count.i64() >= max_visits:
                    trunc_out[0] <- 1
                    fi <- frontier.count
                    continue
                cur: i64 = frontier[fi]
                dep: i64 = depths[fi]
                fi <- fi + 1
                if cur < 0 or cur >= node_count:
                    trunc_out[0] <- 1
                    continue
                continue if rh_visited_has(seen, cur)
                seen.push(cur)
                if dep >= max_depth:
                    trunc_out[0] <- 1
                    continue
                while e < edges.count.i64() |e: i64 = 0, edges, cur, frontier, depths, seen, visited_out|:
                    ed: RhDepEdge = edges[e.usize()]
                    if ed.from == cur and not rh_visited_has(seen, ed.dst):
                        frontier.push(ed.dst)
                        depths.push(dep + 1)
                    e <- e + 1
            while k < seen.count |k: usize = 0, seen, visited_out, roots|:
                keep: bool =
                    while q < roots.count |keep: bool = true, q: usize = 0, seen, k| -> keep:
                        if seen[k] == roots[q]:
                            keep <- false
                        q <- q + 1
                if keep:
                    visited_out.push(seen[k])
                k <- k + 1
            visited_out.count.i64()

        # Reverse BFS (dependents): same contract over incoming edges.
        def rh_graph_rbfs(edges: darray[RhDepEdge]&, node_count: i64, roots: darray[i64]&, max_depth: i64, max_visits: i64, visited_out: mutable darray[i64]&, trunc_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            trunc_out[0] <- 0
            return -1 if max_depth < 0 or max_visits <= 0
            frontier: mutable darray[i64] = []
            depths: mutable darray[i64] = []
            while r < roots.count |r: usize = 0, roots, frontier, depths|:
                frontier.push(roots[r])
                depths.push(0)
                r <- r + 1
            seen: mutable darray[i64] = []
            while fi < frontier.count |fi: usize = 0, frontier, depths, edges, node_count, max_depth, max_visits, visited_out, seen, trunc_out|:
                if visited_out.count.i64() + seen.count.i64() >= max_visits:
                    trunc_out[0] <- 1
                    fi <- frontier.count
                    continue
                cur: i64 = frontier[fi]
                dep: i64 = depths[fi]
                fi <- fi + 1
                if cur < 0 or cur >= node_count:
                    trunc_out[0] <- 1
                    continue
                continue if rh_visited_has(seen, cur)
                seen.push(cur)
                if dep >= max_depth:
                    trunc_out[0] <- 1
                    continue
                while e < edges.count.i64() |e: i64 = 0, edges, cur, frontier, depths, seen, visited_out|:
                    ed: RhDepEdge = edges[e.usize()]
                    if ed.dst == cur and not rh_visited_has(seen, ed.from):
                        frontier.push(ed.from)
                        depths.push(dep + 1)
                    e <- e + 1
            while k < seen.count |k: usize = 0, seen, visited_out, roots|:
                keep: bool =
                    while q < roots.count |keep: bool = true, q: usize = 0, seen, k| -> keep:
                        if seen[k] == roots[q]:
                            keep <- false
                        q <- q + 1
                if keep:
                    visited_out.push(seen[k])
                k <- k + 1
            visited_out.count.i64()

        # Witness path root -> target over outgoing edges (BFS parents, bounded).
        # Writes node indices into path_out; returns length, 0 when unreachable,
        # -1 on bad input. Deterministic: first discovery wins.
        def rh_graph_witness(edges: darray[RhDepEdge]&, node_count: i64, root: i64, target: i64, max_depth: i64, path_out: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if root < 0 or root >= node_count or target < 0 or target >= node_count
            return -1 if max_depth < 0
            if root == target:
                path_out.push(root)
                return 1
            parent: mutable darray[i64] = []
            depth_of: mutable darray[i64] = []
            while i < node_count |i: i64 = 0, parent, depth_of|:
                parent.push(-2)
                depth_of.push(-1)
                i <- i + 1
            parent[root.usize()] <- -1
            depth_of[root.usize()] <- 0
            frontier: mutable darray[i64] = []
            frontier.push(root)
            found: bool =
                while fi < frontier.count |fi: usize = 0, found: bool = false, frontier, parent, depth_of| -> found:
                    cur: i64 = frontier[fi]
                    fi <- fi + 1
                    if cur == target:
                        found <- true
                        fi <- frontier.count
                        continue
                    continue if depth_of[cur.usize()] >= max_depth
                    while e < edges.count.i64() |e: i64 = 0, edges, cur, frontier, parent, depth_of, target, found|:
                        ed: RhDepEdge = edges[e.usize()]
                        if ed.from == cur and parent[ed.dst.usize()] == -2:
                            parent[ed.dst.usize()] <- cur
                            depth_of[ed.dst.usize()] <- depth_of[cur.usize()] + 1
                            if ed.dst == target:
                                found <- true
                                e <- edges.count.i64()
                            else:
                                frontier.push(ed.dst)
                        e <- e + 1
            return 0 if not found
            rev: mutable darray[i64] = []
            while walker >= 0 |walker: i64 = target, guard: i64 = 0, parent, rev, node_count|:
                rev.push(walker)
                if walker == root:
                    walker <- -1
                else:
                    return -1 if guard > node_count + 5
                    guard <- guard + 1
                    walker <- parent[walker.usize()]
            while k > 0 |k: usize = rev.count, rev, path_out|:
                k <- k - 1
                path_out.push(rev[k])
            path_out.count.i64()

        struct RhAliasRef:
            cand: mutable i64
            s: mutable i64
            e: mutable i64

        struct RhCandidate:
            node: mutable i64
            adv_s: mutable i64
            adv_e: mutable i64
            fix_s: mutable i64
            fix_e: mutable i64

        # Span equality inside one buffer (advisory id/alias comparison: exact,
        # case-sensitive — identifiers, not package names).
        def rh_span_eq_same(data: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_span(data, s1.i64(), e1.i64(), data, s2.i64(), e2.i64())

        # Top-level OSV match over our inventory nodes. vulns_root is either the
        # response object (with "vulns") or the array itself. Findings merge by
        # shared id/alias; withdrawn and unusable records are counted, not
        # matched. Returns finding count, or -1 on malformed input.
        def rh_osv_match(pkgs: darray[RhPkgNode]&, pool: mutable darray[u8]&, jnodes: darray[Json::RhJsonNode]&, jtexts: darray[u8]&, vulns_root: i64, findings: mutable darray[RhAdvisory]&, withdrawn_out: mutable i64&, skipped_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            withdrawn_out[0] <- 0
            skipped_out[0] <- 0
            return -1 if vulns_root < 0
            vr: Json::RhJsonNode = jnodes[vulns_root.usize()]
            arr: mutable i64 = vulns_root
            if vr.kind == 4:
                arr <- vulns_root
            else:
                return -1 if vr.kind != 5
                arr <- Json::rh_json_obj_get(jnodes, jtexts, vulns_root, "vulns")
                return -1 if arr < 0
            ar: Json::RhJsonNode = jnodes[arr.usize()]
            return -1 if ar.kind != 4
            cands: mutable darray[RhCandidate] = []
            aliases: mutable darray[RhAliasRef] = []
            while vi < ar.child_count |vi: i64 = 0, jnodes, jtexts, pkgs, pool, cands, aliases, withdrawn_out, skipped_out|:
                vobj: i64 = Json::rh_json_arr_get(jnodes, arr, vi)
                vi <- vi + 1
                if vobj < 0:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                vo: Json::RhJsonNode = jnodes[vobj.usize()]
                if vo.kind != 5:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                wdi: i64 = Json::rh_json_obj_get(jnodes, jtexts, vobj, "withdrawn")
                if wdi >= 0:
                    withdrawn_out[0] <- withdrawn_out[0] + 1
                    continue
                idi: i64 = Json::rh_json_obj_get(jnodes, jtexts, vobj, "id")
                if idi < 0:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                idn: Json::RhJsonNode = jnodes[idi.usize()]
                if idn.kind != 3:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                aff: i64 = Json::rh_json_obj_get(jnodes, jtexts, vobj, "affected")
                if aff < 0:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                afn: Json::RhJsonNode = jnodes[aff.usize()]
                if afn.kind != 4:
                    skipped_out[0] <- skipped_out[0] + 1
                    continue
                while ai2 < afn.child_count |ai2: i64 = 0, jnodes, jtexts, pkgs, pool, cands, aliases, vobj, idn, skipped_out|:
                    aobj: i64 = Json::rh_json_arr_get(jnodes, aff, ai2)
                    ai2 <- ai2 + 1
                    continue if aobj < 0
                    ao: Json::RhJsonNode = jnodes[aobj.usize()]
                    continue if ao.kind != 5
                    pkg: i64 = Json::rh_json_obj_get(jnodes, jtexts, aobj, "package")
                    continue if pkg < 0
                    po2: Json::RhJsonNode = jnodes[pkg.usize()]
                    continue if po2.kind != 5
                    nm: i64 = Json::rh_json_obj_get(jnodes, jtexts, pkg, "name")
                    ec: i64 = Json::rh_json_obj_get(jnodes, jtexts, pkg, "ecosystem")
                    continue if nm < 0 or ec < 0
                    nmn: Json::RhJsonNode = jnodes[nm.usize()]
                    ecn: Json::RhJsonNode = jnodes[ec.usize()]
                    continue if nmn.kind != 3 or ecn.kind != 3
                    while ni < pkgs.count.i64() |ni: i64 = 0, pkgs, pool, jnodes, jtexts, nmn, ecn, aobj, vobj, idn, cands, aliases|:
                        nd: RhPkgNode = pkgs[ni.usize()]
                        if not rh_osv_eco_ok(nd.eco, jtexts, ecn.text_start.usize(), ecn.text_end.usize()):
                            ni <- ni + 1
                            continue
                        if nd.ver_s < 0:
                            ni <- ni + 1
                            continue
                        cand_ns: i64 = rh_pool_copy(pool, jtexts, nmn.text_start.usize(), nmn.text_end.usize())
                        cand_ne: i64 = pool.count.i64()
                        if not rh_name_eq(nd.eco, pool, nd.name_s.usize(), nd.name_e.usize(), cand_ns.usize(), cand_ne.usize()):
                            ni <- ni + 1
                            continue
                        vv: mutable RhSemver = RhSemver{major: 0, minor: 0, patch: 0, pre_s: 0, pre_e: 0}
                        if not rh_semver_parse(pool, nd.ver_s.usize(), nd.ver_e.usize(), &vv):
                            ni <- ni + 1
                            continue
                        ranges: i64 = Json::rh_json_obj_get(jnodes, jtexts, aobj, "ranges")
                        matched_here: mutable bool = false
                        fix_s: mutable i64 = -1
                        fix_e: mutable i64 = -1
                        has_ranges: bool = ranges >= 0
                        if has_ranges:
                            rn2: Json::RhJsonNode = jnodes[ranges.usize()]
                            if rn2.kind == 4:
                                while rg < rn2.child_count |rg: i64 = 0, jnodes, jtexts, pool, vv, matched_here|:
                                    robj: i64 = Json::rh_json_arr_get(jnodes, ranges, rg)
                                    rg <- rg + 1
                                    continue if robj < 0
                                    evts: mutable darray[i64] = []
                                    triples: i64 = rh_osv_collect_events(jnodes, jtexts, robj, evts)
                                    continue if triples <= 0
                                    verdict: i64 = rh_osv_version_in_events(pool, &vv, evts, triples, jtexts)
                                    if verdict == 1:
                                        matched_here <- true
                                        fs2: mutable i64 = -1
                                        fe2: mutable i64 = -1
                                        if rh_osv_first_fixed(jnodes, jtexts, aobj, &fs2, &fe2):
                                            fix_s <- fs2
                                            fix_e <- fe2
                                        rg <- rn2.child_count
                                if matched_here:
                                    ci: i64 = cands.count.i64()
                                    cands.push(RhCandidate{node: ni, adv_s: idn.text_start, adv_e: idn.text_end, fix_s: fix_s, fix_e: fix_e})
                                    rh_osv_collect_aliases(jnodes, jtexts, vobj, ci, aliases)
                        if not has_ranges:
                            vers: i64 = Json::rh_json_obj_get(jnodes, jtexts, aobj, "versions")
                            if vers >= 0:
                                vsn: Json::RhJsonNode = jnodes[vers.usize()]
                                if vsn.kind == 4:
                                    while q < vsn.child_count |q: i64 = 0, jnodes, jtexts, pool, vv, matched_here|:
                                        sentry: i64 = Json::rh_json_arr_get(jnodes, vers, q)
                                        q <- q + 1
                                        continue if sentry < 0
                                        sn2: Json::RhJsonNode = jnodes[sentry.usize()]
                                        continue if sn2.kind != 3
                                        sps: i64 = rh_pool_copy(pool, jtexts, sn2.text_start.usize(), sn2.text_end.usize())
                                        spe: i64 = pool.count.i64()
                                        sv: mutable RhSemver = RhSemver{major: 0, minor: 0, patch: 0, pre_s: 0, pre_e: 0}
                                        if rh_semver_parse(pool, sps.usize(), spe.usize(), &sv):
                                            if rh_semver_cmp(pool, &vv, &sv) == 0:
                                                matched_here <- true
                                    if matched_here:
                                        ci2: i64 = cands.count.i64()
                                        cands.push(RhCandidate{node: ni, adv_s: idn.text_start, adv_e: idn.text_end, fix_s: -1, fix_e: -1})
                                        rh_osv_collect_aliases(jnodes, jtexts, vobj, ci2, aliases)
                        ni <- ni + 1
            groups: mutable darray[i64] = []
            while gi < cands.count.i64() |gi: i64 = 0, groups|:
                groups.push(gi)
                gi <- gi + 1
            while a2 < cands.count.i64() |a2: i64 = 0, cands, groups, aliases, jtexts|:
                while b2 < cands.count.i64() |b2: i64 = a2 + 1, a2, cands, groups, aliases, jtexts|:
                    if groups[a2.usize()] != groups[b2.usize()] and rh_cand_shared(cands, aliases, jtexts, a2, b2):
                        old: i64 = groups[b2.usize()]
                        nw: i64 = groups[a2.usize()]
                        while g < groups.count.i64() |g: i64 = 0, groups, old, nw|:
                            if groups[g.usize()] == old:
                                groups[g.usize()] <- nw
                            g <- g + 1
                    b2 <- b2 + 1
                a2 <- a2 + 1
            seen_group: mutable darray[i64] = []
            while f < cands.count.i64() |f: i64 = 0, cands, groups, seen_group, findings|:
                g2: i64 = groups[f.usize()]
                dup: bool =
                    while h < seen_group.count |dup: bool = false, h: usize = 0, seen_group| -> dup:
                        if seen_group[h] == g2:
                            dup <- true
                        h <- h + 1
                if not dup:
                    seen_group.push(g2)
                    members: i64 =
                        while m < cands.count.i64() |members: i64 = 0, m: i64 = 0, cands, groups| -> members:
                            if groups[m.usize()] == g2:
                                members <- members + 1
                            m <- m + 1
                    fc: RhCandidate = cands[f.usize()]
                    findings.push(RhAdvisory{adv_s: fc.adv_s, adv_e: fc.adv_e, node: fc.node, fix_s: fc.fix_s, fix_e: fc.fix_e, alias_count: members - 1})
                f <- f + 1
            findings.count.i64()

        # Ecosystem allowlist for one affected entry (exact OSV identifier).
        def rh_osv_eco_ok(eco: u8, texts: darray[u8]&, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            want: u8& = rh_osv_ecosystem(eco)
            n: usize = strlen(want)
            return false if e - s != n
            while k < n |k: usize = 0, texts, s, want|:
                return false if texts[s + k] != want[k]
                k <- k + 1
            true

        # Collect advisory id + aliases into the alias table for one candidate.
        def rh_osv_collect_aliases(jnodes: darray[Json::RhJsonNode]&, jtexts: darray[u8]&, vobj: i64, cand: i64, aliases: mutable darray[RhAliasRef]&) -> void can[Memory.Allocate, Abort.Panic]:
            idi: i64 = Json::rh_json_obj_get(jnodes, jtexts, vobj, "id")
            if idi >= 0:
                idn: Json::RhJsonNode = jnodes[idi.usize()]
                if idn.kind == 3:
                    aliases.push(RhAliasRef{cand: cand, s: idn.text_start, e: idn.text_end})
            ali: i64 = Json::rh_json_obj_get(jnodes, jtexts, vobj, "aliases")
            return if ali < 0
            aln: Json::RhJsonNode = jnodes[ali.usize()]
            return if aln.kind != 4
            while ai < aln.child_count |ai: i64 = 0, jnodes, aliases, cand|:
                item: i64 = Json::rh_json_arr_get(jnodes, ali, ai)
                ai <- ai + 1
                continue if item < 0
                iv: Json::RhJsonNode = jnodes[item.usize()]
                continue if iv.kind != 3
                aliases.push(RhAliasRef{cand: cand, s: iv.text_start, e: iv.text_end})

        # True when two candidates share an id or any alias (exact bytes).
        def rh_cand_shared(cands: darray[RhCandidate]&, aliases: darray[RhAliasRef]&, texts: darray[u8]&, a: i64, b: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            ca: RhCandidate = cands[a.usize()]
            cb: RhCandidate = cands[b.usize()]
            return true if rh_span_eq_same(texts, ca.adv_s.usize(), ca.adv_e.usize(), cb.adv_s.usize(), cb.adv_e.usize())
            while i < aliases.count |i: usize = 0, aliases, texts, ca, cb|:
                ra: RhAliasRef = aliases[i]
                i <- i + 1
                while j < aliases.count |j: usize = i, aliases, texts, ca, cb, ra|:
                    rb: RhAliasRef = aliases[j]
                    j <- j + 1
                    a_mine: bool = ra.cand == a or ra.cand == b
                    b_mine: bool = rb.cand == a or rb.cand == b
                    if a_mine and b_mine and ra.cand != rb.cand:
                        return true if rh_span_eq_same(texts, ra.s.usize(), ra.e.usize(), rb.s.usize(), rb.e.usize())
            return true if rh_alias_hits(aliases, texts, a, cb.adv_s.usize(), cb.adv_e.usize())
            return true if rh_alias_hits(aliases, texts, b, ca.adv_s.usize(), ca.adv_e.usize())
            false

        # True when candidate `cand` owns an alias entry equal to span [s, e).
        # (Each candidate's own id is also tabled, so id hits work uniformly.)
        def rh_alias_hits(aliases: darray[RhAliasRef]&, texts: darray[u8]&, cand: i64, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < aliases.count |i: usize = 0, aliases, texts, cand, s, e|:
                ra: RhAliasRef = aliases[i]
                i <- i + 1
                continue if ra.cand != cand
                return true if rh_span_eq_same(texts, ra.s.usize(), ra.e.usize(), s, e)
            false

        struct RhAdvisory:
            adv_s: mutable i64
            adv_e: mutable i64
            node: mutable i64
            fix_s: mutable i64
            fix_e: mutable i64
            alias_count: mutable i64

        # Count distinct resolved nodes represented by matched advisory groups.
        # A shared advisory can match more than one node; the public security
        # metric keeps that node population separate from advisory cardinality.
        def rh_advisory_node_count(findings: mutable darray[RhAdvisory]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            seen: mutable darray[i64] = []
            while i < findings.count |i: i64 = 0, findings, seen| -> seen.count.i64():
                node: mutable i64 = findings[i.usize()].node
                already: bool =
                    while j < seen.count |already: bool = false, j: i64 = 0, seen, node| -> already:
                        already <- true if seen[j.usize()] == node
                        j <- j + 1
                if not already:
                    seen.push(node)
                i <- i + 1

        # Raw matched advisory records before accepted id/alias group
        # deduplication. `alias_count` stores the additional candidates folded
        # into each published advisory group.
        def rh_advisory_record_count(findings: mutable darray[RhAdvisory]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < findings.count |total: i64 = 0, i: i64 = 0, findings| -> total:
                total <- total + findings[i.usize()].alias_count + 1
                i <- i + 1

        # Classify unique matched advisory nodes against the selected graph
        # root. Mode 0 counts direct destinations, mode 1 counts reachable
        # non-direct destinations, and mode 2 counts matched nodes outside the
        # root's observed reachability. The latter remains evidence of a feed
        # match, never an affected-root claim.
        def rh_advisory_scope_count(findings: mutable darray[RhAdvisory]&, edges: mutable darray[RhDepEdge]&, root: mutable i64, node_count: mutable i64, mode: mutable i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if root < 0 or node_count <= 0
            reachable: mutable darray[i64] = []
            frontier: mutable darray[i64] = []
            frontier.push(root)
            while fi < frontier.count |fi: i64 = 0, frontier, reachable, edges|:
                cur: i64 = frontier[fi.usize()]
                fi <- fi + 1
                continue if rh_visited_has(reachable, cur)
                reachable.push(cur)
                while ei < edges.count |ei: i64 = 0, edges, cur, frontier, reachable|:
                    edge: RhDepEdge = edges[ei.usize()]
                    frontier.push(edge.dst) if edge.from == cur and not rh_visited_has(reachable, edge.dst)
                    ei <- ei + 1
            counted: mutable darray[i64] = []
            while i < findings.count |total: i64 = 0, i: i64 = 0, findings, edges, root, reachable, counted, mode| -> total:
                node: mutable i64 = findings[i.usize()].node
                already: bool = rh_visited_has(counted, node)
                if not already:
                    counted.push(node)
                    direct: bool =
                        while j < edges.count |direct: bool = false, j: i64 = 0, edges, node, root| -> direct:
                            direct <- true if edges[j.usize()].from == root and edges[j.usize()].dst == node
                            j <- j + 1
                    in_reach: bool = rh_visited_has(reachable, node)
                    include: bool = (mode == 0 and direct) or (mode == 1 and in_reach and not direct) or (mode == 2 and not in_reach)
                    total <- total + 1 if include
                i <- i + 1

        # Triples (kind, vstart, vend) per range event: 0 introduced, 1 fixed,
        # 2 last_affected. Returns the triple count, -1 malformed, 0 no events.
        def rh_osv_collect_events(jnodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, range_obj: i64, out: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            ev: i64 = Json::rh_json_obj_get(jnodes, texts, range_obj, "events")
            return 0 if ev < 0
            en: Json::RhJsonNode = jnodes[ev.usize()]
            return -1 if en.kind != 4
            while ai < en.child_count |total: i64 = 0, ai: i64 = 0, out| -> total:
                item: i64 = Json::rh_json_arr_get(jnodes, ev, ai)
                return -1 if item < 0
                io: Json::RhJsonNode = jnodes[item.usize()]
                return -1 if io.kind != 5
                return -1 if io.child_count != 2
                kn: Json::RhJsonNode =
                    kv: i64 = io.first_child
                    jnodes[kv.usize()]
                vv2: i64 = kn.next_sibling
                return -1 if vv2 < 0
                val: Json::RhJsonNode = jnodes[vv2.usize()]
                return -1 if val.kind != 3
                kind: mutable i64 = -1
                if kn.text_end - kn.text_start == 10:
                    if rh_span_eq_text(texts, kn.text_start.usize(), kn.text_end.usize(), "introduced"):
                        kind <- 0
                if kn.text_end - kn.text_start == 5:
                    if rh_span_eq_text(texts, kn.text_start.usize(), kn.text_end.usize(), "fixed"):
                        kind <- 1
                if kn.text_end - kn.text_start == 13:
                    if rh_span_eq_text(texts, kn.text_start.usize(), kn.text_end.usize(), "last_affected"):
                        kind <- 2
                return -1 if kind < 0
                out.push(kind)
                out.push(val.text_start)
                out.push(val.text_end)
                total <- total + 1
                ai <- ai + 1

        # Version verdict over one range's event triples: 1 vulnerable, 0 not,
        # -1 no usable range (unknown — caller skips, never matches).
        def rh_osv_version_in_events(pool: mutable darray[u8]&, ver: RhSemver&, events: darray[i64]&, triples: i64, evtexts: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            # Pass 1: does the range declare an explicit introduced bound? A range
            # with only fixed/last_affected is vulnerable FROM THE START (OSV
            # implicit introduced=0), never skipped.
            has_intro, any_event =
                while t < triples |has_intro: bool = false, any_event: bool = false, t: i64 = 0, pool| -> has_intro, any_event:
                    kind: i64 = events[(t * 3).usize()]
                    vs: usize = events[(t * 3 + 1).usize()].usize()
                    cps: i64 =
                        ve: usize = events[(t * 3 + 2).usize()].usize()
                        block_result: i64 = rh_pool_copy(pool, evtexts, vs, ve)
                        block_result
                    cpe: i64 = pool.count.i64()
                    cv: mutable RhSemver = RhSemver{major: 0, minor: 0, patch: 0, pre_s: 0, pre_e: 0}
                    if rh_semver_parse(pool, cps.usize(), cpe.usize(), &cv):
                        any_event <- true
                        if kind == 0:
                            has_intro <- true
                    t <- t + 1
            if not any_event:
                return -1
            # Pass 2: ordered evaluation. Start vulnerable unless the range has an
            # explicit introduced event.
            vuln: bool =
                while t2 < triples |vuln: bool = not has_intro, t2: i64 = 0, pool| -> vuln:
                    kind2: i64 = events[(t2 * 3).usize()]
                    vs2: usize = events[(t2 * 3 + 1).usize()].usize()
                    cps2: i64 =
                        ve2: usize = events[(t2 * 3 + 2).usize()].usize()
                        block_result: i64 = rh_pool_copy(pool, evtexts, vs2, ve2)
                        block_result
                    cpe2: i64 = pool.count.i64()
                    cv2: mutable RhSemver = RhSemver{major: 0, minor: 0, patch: 0, pre_s: 0, pre_e: 0}
                    if rh_semver_parse(pool, cps2.usize(), cpe2.usize(), &cv2):
                        if kind2 == 0:
                            if rh_semver_cmp(pool, ver, &cv2) >= 0:
                                vuln <- true
                        if kind2 == 1:
                            if rh_semver_cmp(pool, ver, &cv2) >= 0:
                                vuln <- false
                        if kind2 == 2:
                            if rh_semver_cmp(pool, ver, &cv2) > 0:
                                vuln <- false
                    t2 <- t2 + 1
            return 1 if vuln
            0

        def rh_osv_first_fixed(jnodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, affected: i64, fs_out: mutable i64&, fe_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            ranges: i64 = Json::rh_json_obj_get(jnodes, texts, affected, "ranges")
            return false if ranges < 0
            rn: Json::RhJsonNode = jnodes[ranges.usize()]
            return false if rn.kind != 4
            while ri < rn.child_count |ri: i64 = 0, jnodes, texts, fs_out, fe_out|:
                ev: i64 =
                    robj: i64 = Json::rh_json_arr_get(jnodes, ranges, ri)
                    return false if robj < 0
                    block_result: i64 = Json::rh_json_obj_get(jnodes, texts, robj, "events")
                    block_result
                return false if ev < 0
                en2: Json::RhJsonNode = jnodes[ev.usize()]
                return false if en2.kind != 4
                while ai < en2.child_count |ai: i64 = 0, jnodes, texts, fs_out, fe_out|:
                    item: i64 = Json::rh_json_arr_get(jnodes, ev, ai)
                    return false if item < 0
                    io: Json::RhJsonNode = jnodes[item.usize()]
                    return false if io.kind != 5 or io.child_count != 2
                    kn: Json::RhJsonNode =
                        kv: i64 = io.first_child
                        jnodes[kv.usize()]
                    vv2: i64 = kn.next_sibling
                    return false if vv2 < 0
                    if kn.text_end - kn.text_start == 5:
                        if rh_span_eq_text(texts, kn.text_start.usize(), kn.text_end.usize(), "fixed"):
                            val: Json::RhJsonNode = jnodes[vv2.usize()]
                            return false if val.kind != 3
                            fs_out[0] <- val.text_start
                            fe_out[0] <- val.text_end
                            return true
                    ai <- ai + 1
                ri <- ri + 1
            false

        def rh_scope_label(depctx: u8) -> u8&:
            return "dev" if depctx == 1
            return "optional" if depctx == 2
            return "peer" if depctx == 3
            return "declared" if depctx == 4
            "normal"

        def rh_src_label(kind: u8) -> u8&:
            return "registry" if kind == 0
            return "path" if kind == 1
            return "git" if kind == 2
            "unknown"

        def rh_unres_label(reason: u8) -> u8&:
            return "ambiguous" if reason == 1
            return "context" if reason == 2
            "missing"

        # --- Python requirements.txt (declared requirements; M03-03 / M08 PyPI) ---
        # Declared requirements are NEVER silently treated as resolved edges (R009):
        # only an exact `==` / `===` pin with no extras, environment marker or direct
        # URL becomes a package node and a root edge. Ranges, extras, markers, URLs
        # and pip options stay explicit unresolved entries preserving their original
        # text, with reason `context` for environment/URL/option forms and `missing`
        # for a plain range we cannot resolve offline. Names use PEP 503 equality.

        def rh_pypi_name_char(b: u8) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if b >= 48 and b <= 57
            return true if b >= 65 and b <= 90
            return true if b >= 97 and b <= 122
            return true if b == 46 or b == 95 or b == 45
            false

        def rh_pypi_find(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize, vs: usize, ve: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count |i: usize = 0, pkgs, pool, ns, ne, vs, ve|:
                n: RhPkgNode = pkgs[i]
                if n.eco == RH_ECO_PYPI and n.name_s >= 0 and n.ver_s >= 0:
                    if rh_name_eq(RH_ECO_PYPI, pool, n.name_s.usize(), n.name_e.usize(), ns, ne):
                        return i.i64() if rh_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, vs, ve)
                i <- i + 1
            -1

        def rh_pypi_line(buf: darray[u8]&, s: usize, e: usize, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&, depctx: u8) -> void can[Memory.Allocate, Abort.Panic]:
            a: mutable usize = s
            b: mutable usize = e
            while a < b and (buf[a] == 32 or buf[a] == 9) |a, b, buf|:
                a <- a + 1
            while b > a and (buf[b - 1] == 32 or buf[b - 1] == 9 or buf[b - 1] == 13) |b, a, buf|:
                b <- b - 1
            return if a >= b
            return if buf[a] == 35
            k: usize =
                while k < b |k: usize = a, b| -> k:
                    break if buf[k] == 35 and k > a and (buf[k - 1] == 32 or buf[k - 1] == 9)
                    k <- k + 1
            if k < b:
                b <- k
                while b > a and (buf[b - 1] == 32 or buf[b - 1] == 9) |b, a, buf|:
                    b <- b - 1
                return if a >= b
            is_opt: bool = true if buf[a] == 45 else false
            ns: mutable usize = a
            ne: mutable usize = a
            if is_opt:
                while ne < b and buf[ne] != 32 and buf[ne] != 9 |ne, b, buf|:
                    ne <- ne + 1
            else:
                while ne < b and rh_pypi_name_char(buf[ne]) |ne, b, buf|:
                    ne <- ne + 1
            if ne == ns:
                unknown_out[0] <- unknown_out[0] + 1
                uns0: i64 = rh_pool_copy(pool, buf, a, b)
                unresolved.push(RhUnresolved{from: 0, name_s: uns0, name_e: uns0 + (b - a).i64(), req_s: -1, req_e: -1, reason: 2})
                return
            c: mutable usize =
                while c < b and (buf[c] == 32 or buf[c] == 9) |c: usize = ne| -> c:
                    c <- c + 1
            has_extras: mutable bool = false
            if c < b and buf[c] == 91:
                has_extras <- true
                while c < b and buf[c] != 93 |c, b, buf|:
                    c <- c + 1
                if c < b:
                    c <- c + 1
                while c < b and (buf[c] == 32 or buf[c] == 9) |c, b, buf|:
                    c <- c + 1
            semi: usize =
                while m < b |semi: usize = b, m: usize = c| -> semi:
                    if buf[m] == 59:
                        semi <- m
                    m <- m + 1
            has_marker: mutable bool = semi < b
            rs, re2 =
                while re2 > rs and (buf[re2 - 1] == 32 or buf[re2 - 1] == 9) |rs: usize = c, re2: usize = semi| -> rs, re2:
                    re2 <- re2 - 1
            has_url: bool =
                while u < re2 |has_url: bool = false, u: usize = rs| -> has_url:
                    if buf[u] == 58 or buf[u] == 64 or buf[u] == 47:
                        has_url <- true
                    u <- u + 1
            exact: mutable bool = false
            vstart: mutable usize = rs
            if re2 - rs >= 3 and buf[rs] == 61 and buf[rs + 1] == 61:
                if buf[rs + 2] == 61:
                    vstart <- rs + 3
                else:
                    vstart <- rs + 2
                while vstart < re2 and (buf[vstart] == 32 or buf[vstart] == 9) |vstart, re2, buf|:
                    vstart <- vstart + 1
                exact <- true
                while w < re2 |w: usize = vstart, vstart, re2, buf, exact|:
                    x: u8 = buf[w]
                    if x == 42 or x == 44 or x == 33 or x == 60 or x == 62 or x == 126 or x == 124 or x == 32 or x == 9:
                        exact <- false
                    w <- w + 1
                if vstart >= re2:
                    exact <- false
            # record the requirement text for the unsupported-range classifier; a
            # pip option (-r/-e/-i...) is not a declared requirement and is counted
            # separately as an unknown construct instead.
            rhs: mutable i64 = -1
            rhe: mutable i64 = -1
            if rs < re2:
                rhs <- rh_pool_copy(pool, buf, rs, re2)
                rhe <- rhs + (re2 - rs).i64()
            if not is_opt:
                reqs.push(RhRequire{from: 0, name_s: -1, name_e: -1, ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: rhs, req_e: rhe, depctx: depctx})
            if exact and not has_extras and not has_marker and not has_url and not is_opt:
                nname: i64 = rh_pool_copy(pool, buf, ns, ne)
                nver: i64 = rh_pool_copy(pool, buf, vstart, re2)
                existing: mutable i64 = rh_pypi_find(pkgs, pool, nname.usize(), (nname + (ne - ns).i64()).usize(), nver.usize(), (nver + (re2 - vstart).i64()).usize())
                if existing < 0:
                    existing <- rh_node_add(pkgs, RH_ECO_PYPI)
                    return if existing < 0
                    nd: mutable RhPkgNode = pkgs[existing.usize()]
                    nd.name_s <- nname
                    nd.name_e <- nname + (ne - ns).i64()
                    nd.ver_s <- nver
                    nd.ver_e <- nver + (re2 - vstart).i64()
                    nd.src_kind <- 0
                    pkgs[existing.usize()] <- nd
                edges.push(RhDepEdge{from: 0, dst: existing, depctx: depctx})
                return
            uns_name: i64 = rh_pool_copy(pool, buf, ns, ne)
            uns_req: mutable i64 = -1
            uns_req_end: mutable i64 = -1
            if rs < re2:
                uns_req <- rh_pool_copy(pool, buf, rs, re2)
                uns_req_end <- uns_req + (re2 - rs).i64()
            reason: u8 = 2 if has_extras or has_marker or has_url or is_opt else 0
            unresolved.push(RhUnresolved{from: 0, name_s: uns_name, name_e: uns_name + (ne - ns).i64(), req_s: uns_req, req_e: uns_req_end, reason: reason})
            return

        # Parse a requirements.txt into a root-plus-pinned graph. Returns 0 (root
        # is always index 0) or -1 if the root node cannot be created. A requirements
        # file routinely contains ranges/options we do not resolve; those are
        # preserved as unresolved entries, never guessed edges.
        def rh_pypi_parse(req: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            rroot: i64 = rh_node_add(pkgs, RH_ECO_PYPI)
            return -1 if rroot != 0
            rn: mutable darray[u8] = []
            Base::rh_push_text(rn, "root")
            rns: i64 = rh_pool_copy(pool, rn, 0, rn.count)
            rnode: mutable RhPkgNode = pkgs[0]
            rnode.name_s <- rns
            rnode.name_e <- rns + rn.count.i64()
            rnode.src_kind <- 3
            pkgs[0] <- rnode
            while i <= req.count |i: usize = 0, req, pkgs, pool, reqs, edges, unresolved, unknown_out|:
                j: usize =
                    while j < req.count and req[j] != 10 |j: usize = i| -> j:
                        j <- j + 1
                if j > i:
                    rh_pypi_line(req, i, j, pkgs, pool, reqs, edges, unresolved, unknown_out, 0)
                i <- j + 1
            0

        # Extract quoted dependency strings from one PEP 621 array line. The
        # supported subset is deliberately narrow: basic/literal TOML strings inside
        # `project.dependencies` or an optional-dependency table. Unsupported dynamic
        # forms fail closed instead of becoming an empty graph.
        # (private to this file)
        def rh_pypi_pep621_values(buf: darray[u8]&, s: usize, e: usize, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&, depctx: u8, close_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            close_out[0] <- 0
            while i < e |i: usize = s, e, buf, pkgs, pool, reqs, edges, unresolved, unknown_out, depctx, close_out|:
                b: u8 = buf[i]
                if b == 93:
                    close_out[0] <- 1
                    return 0
                if b == 34 or b == 39:
                    quote: u8 = b
                    i <- i + 1
                    dep: mutable darray[u8] = []
                    while i < e and buf[i] != quote |i, e, buf, dep|:
                        if buf[i] == 92:
                            i <- i + 1
                            return -1 if i >= e
                        dep.push(buf[i])
                        i <- i + 1
                    return -1 if i >= e
                    return -1 if dep.count == 0
                    rh_pypi_line(dep, 0, dep.count, pkgs, pool, reqs, edges, unresolved, unknown_out, depctx)
                i <- i + 1
            0

        # Parse the bounded PEP 621 project metadata subset. Requirements remain
        # declared evidence; exact pins are the only offline-resolved edges, matching
        # requirements.txt semantics. Optional arrays retain `depctx=optional`.
        def rh_pypi_parse_pep621(req: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            rroot: i64 = rh_node_add(pkgs, RH_ECO_PYPI)
            return -1 if rroot != 0
            root_name: mutable darray[u8] = []
            Base::rh_push_text(root_name, "root")
            root_s: i64 = rh_pool_copy(pool, root_name, 0, root_name.count)
            root_node: mutable RhPkgNode = pkgs[0]
            root_node.name_s <- root_s
            root_node.name_e <- root_s + root_name.count.i64()
            root_node.src_kind <- RH_PSRC_UNKNOWN
            pkgs[0] <- root_node
            section: mutable i64 = 0
            active: mutable i64 = 0
            active_scope: mutable u8 = RH_SCOPE_NORMAL
            saw_project: mutable i64 = 0
            while line_start <= req.count |line_start: usize = 0, req, pkgs, pool, reqs, edges, unresolved, unknown_out, section, active, active_scope, saw_project|:
                line_end: usize =
                    while j < req.count and req[j] != 10 |j: usize = line_start| -> j:
                        j <- j + 1
                s: mutable usize = line_start
                e: mutable usize = line_end
                while s < e and (req[s] == 32 or req[s] == 9 or req[s] == 13) |s, e, req|:
                    s <- s + 1
                while e > s and (req[e - 1] == 32 or req[e - 1] == 9 or req[e - 1] == 13) |s, e, req|:
                    e <- e - 1
                if s < e and req[s] == 91:
                    return -1 if active == 1
                    section <- 0
                    active <- 0
                    if Base::rh_bytes_equal_literal(req, s.i64(), e.i64(), "[project]"):
                        section <- 1
                        saw_project <- 1
                    elif Base::rh_bytes_equal_literal(req, s.i64(), e.i64(), "[project.optional-dependencies]"):
                        section <- 2
                        saw_project <- 1
                elif section == 1 or section == 2:
                    eq: mutable i64 = -1
                    while k < e |k: usize = s, e, req, eq|:
                        if req[k] == 61:
                            eq <- k.i64()
                            break
                        k <- k + 1
                    if active == 0 and eq >= 0:
                        key_end: mutable usize = eq.usize()
                        while key_end > s and (req[key_end - 1] == 32 or req[key_end - 1] == 9) |key_end, s, req|:
                            key_end <- key_end - 1
                        is_dependencies: bool = section == 1 and Base::rh_bytes_equal_literal(req, s.i64(), key_end.i64(), "dependencies")
                        is_optional: bool = section == 2
                        if is_dependencies or is_optional:
                            array_start: mutable usize = (eq + 1).usize()
                            while array_start < e and (req[array_start] == 32 or req[array_start] == 9) |array_start, e, req|:
                                array_start <- array_start + 1
                            return -1 if array_start >= e or req[array_start] != 91
                            active <- 1
                            active_scope <- RH_SCOPE_OPTIONAL if is_optional else RH_SCOPE_NORMAL
                            closed: mutable i64 = 0
                            return -1 if rh_pypi_pep621_values(req, array_start + 1, e, pkgs, pool, reqs, edges, unresolved, unknown_out, active_scope, &closed) != 0
                            active <- 0 if closed == 1
                    elif active == 1:
                        closed_cont: mutable i64 = 0
                        return -1 if rh_pypi_pep621_values(req, s, e, pkgs, pool, reqs, edges, unresolved, unknown_out, active_scope, &closed_cont) != 0
                        active <- 0 if closed_cont == 1
                line_start <- line_end + 1
            return -1 if saw_project == 0 or active == 1
            0

        # --- Go modules (go.mod; M08 ecosystems lane) --------------------------
        # Declared requirements are NEVER silently treated as resolved edges (R009):
        # only a `require <module/path> vX.Y.Z` directive whose version is a plain
        # semantic version (`v` + MAJOR.MINOR.PATCH, optional -prerelease/+build)
        # becomes a package node and a root edge. Everything else stays an explicit
        # unresolved entry with its original text:
        #   - pseudo-versions (v0.0.0-20240101120000-abcdef123456) -> missing
        #   - `+incompatible`, branch/commit refs, and bare path-only forms -> missing
        #   - `replace` / `exclude` / `retract` directives -> context (not resolved
        #     offline; a replacement target is a declared rewrite, not a registry
        #     version, and must never be treated as the resolved edge)
        # `// indirect` is a comment, not a distinct requirement, and is preserved
        # only as part of the recorded requirement text. Module paths are byte-exact
        # in go.mod (the `!`-escaped cache form is a separate representation and is
        # not what a go.mod contains), so name equality is byte-exact.

        def rh_go_name_eq(pool: darray[u8]&, s1: usize, e1: usize, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_span(pool, s1.i64(), e1.i64(), pool, s2.i64(), e2.i64())

        # Byte-exact span equality across two distinct buffers (module path lookup).
        def rh_go_span_eq2(a: darray[u8]&, s1: usize, e1: usize, b: darray[u8]&, s2: usize, e2: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_span(a, s1.i64(), e1.i64(), b, s2.i64(), e2.i64())

        # A module path segment character: letters, digits, and the punctuation Go
        # permits in module paths ('.', '-', '_', '~', '+'). A leading digit is not
        # allowed in the first segment of a domain, but this is deliberately a
        # permissive lexical check; the echo of the exact text is what is stored.
        def rh_go_path_char(b: u8) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if b >= 48 and b <= 57
            return true if b >= 65 and b <= 90
            return true if b >= 97 and b <= 122
            return true if b == 46 or b == 45 or b == 95 or b == 126 or b == 43 or b == 47
            false

        # Strict Go semantic version for the DECLARED supported subset: exactly
        # `v` MAJOR `.` MINOR `.` PATCH. Prereleases, build metadata, pseudo-versions
        # (`v0.0.0-20240101120000-abcdef...`) and `+incompatible` are NOT evaluated
        # offline and are reported unresolved, never guessed as resolved edges.
        def rh_go_version_supported(data: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e - s < 6 or e > data.count.i64()
            return false if data[s.usize()] != 118
            i: mutable i64 = s + 1
            maj: i64 = rh_go_num_run(data, i, e, &i)
            return false if maj < 0 or i >= e or data[i.usize()] != 46
            i <- i + 1
            mn: i64 = rh_go_num_run(data, i, e, &i)
            return false if mn < 0 or i >= e or data[i.usize()] != 46
            i <- i + 1
            pt: i64 = rh_go_num_run(data, i, e, &i)
            return false if pt < 0
            i == e

        # One or more decimal digits; -1 when none. Advances pos.
        def rh_go_num_run(data: darray[u8]&, start: i64, e: i64, pos: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            i: i64 =
                while i < e and data[i.usize()] >= 48 and data[i.usize()] <= 57 |i: i64 = start| -> i:
                    i <- i + 1
            return -1 if i == start
            pos[0] <- i
            i - start

        # Trim a Span, skipping leading/trailing ASCII whitespace.
        def rh_go_trim(data: darray[u8]&, s: i64, e: i64, s_out: mutable i64&, e_out: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            a: mutable i64 = s
            b: mutable i64 = e
            while a < b and (data[a.usize()] == 32 or data[a.usize()] == 9) |a, b, data|:
                a <- a + 1
            while b > a and (data[(b - 1).usize()] == 32 or data[(b - 1).usize()] == 9 or data[(b - 1).usize()] == 13) |b, a, data|:
                b <- b - 1
            s_out[0] <- a
            e_out[0] <- b
            return

        # Does the token span equal the literal at the same length?
        def rh_go_tok(data: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: i64 = strlen(lit).i64()
            return false if e - s != n
            while k < n |k: i64 = 0, data, s, lit|:
                return false if data[(s + k).usize()] != lit[k.usize()]
                k <- k + 1
            true

        # Find an existing Go node by module path and version (byte-exact).
        def rh_go_find(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize, vs: usize, ve: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count |i: usize = 0, pkgs, pool, ns, ne, vs, ve|:
                n: RhPkgNode = pkgs[i]
                if n.eco == RH_ECO_GO and n.name_s >= 0 and n.ver_s >= 0:
                    if rh_go_name_eq(pool, n.name_s.usize(), n.name_e.usize(), ns, ne):
                        return i.i64() if rh_go_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, vs, ve)
                i <- i + 1
            -1

        # Parse a go.mod into a root-plus-requirements graph. Returns 0 (root is
        # always index 0) or -1 when the module directive is malformed/missing or the
        # root node cannot be created. A go.mod routinely contains replace/exclude/
        # retract directives and pseudo-versions we do not resolve; those are
        # preserved as unresolved entries, never guessed edges.
        def rh_go_parse(mod: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            rroot: i64 = rh_node_add(pkgs, RH_ECO_GO)
            if rroot != 0:
                return -1
            # root identity: the `module` directive path (fall back to a fixed label)
            ms: mutable i64 = 0
            me: mutable i64 = 0
            has_mod: mutable bool = false
            found_mod: i64 = rh_go_module_path(mod, &ms, &me)
            if found_mod >= 0:
                has_mod <- true
            rnode: mutable RhPkgNode = pkgs[0]
            if has_mod:
                rns: i64 = rh_pool_copy(pool, mod, ms.usize(), me.usize())
                rnode.name_s <- rns
                rnode.name_e <- rns + (me - ms)
            else:
                rn: mutable darray[u8] = []
                Base::rh_push_text(rn, "root")
                rns2: i64 = rh_pool_copy(pool, rn, 0, rn.count)
                rnode.name_s <- rns2
                rnode.name_e <- rns2 + rn.count.i64()
            rnode.src_kind <- 3
            pkgs[0] <- rnode
            # Walk lines, handling single-line and parenthesized blocks.
            while true |in_require: i64 = 0, in_other_block: i64 = 0, pos: i64 = 0, mod, pkgs, pool, reqs, edges, unresolved, unknown_out|:
                break if pos >= mod.count.i64()
                le: i64 =
                    while le < mod.count.i64() and mod[le.usize()] != 10 |le: i64 = pos| -> le:
                        le <- le + 1
                ts: mutable i64 = 0
                te: mutable i64 = 0
                rh_go_trim(mod, pos, le, &ts, &te)
                if te > ts and mod[ts.usize()] != 47:
                    rh_go_line(mod, ts, te, pkgs, pool, reqs, edges, unresolved, unknown_out, &in_require, &in_other_block)
                pos <- le + 1
            0

        # Handle one go.mod line; updates the in_require/in_other_block flags via
        # out-parameters (the language has no tuple returns).
        def rh_go_line(mod: darray[u8]&, s: i64, e: i64, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&, in_require: mutable i64&, in_other_block: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            # strip a trailing // comment
            code_e: i64 =
                while i + 1 < e |code_e: i64 = e, i: i64 = s| -> code_e:
                    if mod[i.usize()] == 47 and mod[(i + 1).usize()] == 47:
                        code_e <- i
                    i <- i + 1
            cs: mutable i64 = 0
            ce: mutable i64 = 0
            rh_go_trim(mod, s, code_e, &cs, &ce)
            return if ce <= cs
            if mod[cs.usize()] == 41:
                # close of a block
                in_require[0] <- 0
                in_other_block[0] <- 0
                return
            if in_require[0] == 1:
                rh_go_require_entry(mod, cs, ce, pkgs, pool, reqs, edges, unresolved, unknown_out)
                return
            if in_other_block[0] == 1:
                # a line inside replace/exclude/retract/etc. -> context, keep text
                rh_go_context_entry(mod, cs, ce, pool, unresolved)
                return
            # directive keyword
            k: i64 = rh_go_word_end(mod, cs, ce)
            if rh_go_tok(mod, cs, k, "require"):
                rest_s: i64 =
                    while rest_s < ce and (mod[rest_s.usize()] == 32 or mod[rest_s.usize()] == 9) |rest_s: i64 = k, ce| -> rest_s:
                        rest_s <- rest_s + 1
                if rest_s < ce and mod[rest_s.usize()] == 40:
                    in_require[0] <- 1
                    return
                if rest_s < ce:
                    rh_go_require_entry(mod, rest_s, ce, pkgs, pool, reqs, edges, unresolved, unknown_out)
                return
            if rh_go_tok(mod, cs, k, "replace") or rh_go_tok(mod, cs, k, "exclude") or rh_go_tok(mod, cs, k, "retract") or rh_go_tok(mod, cs, k, "droprequire"):
                rest2: i64 =
                    while rest2 < ce and (mod[rest2.usize()] == 32 or mod[rest2.usize()] == 9) |rest2: i64 = k| -> rest2:
                        rest2 <- rest2 + 1
                if rest2 < ce and mod[rest2.usize()] == 40:
                    in_other_block[0] <- 1
                    return
                if rest2 < ce:
                    rh_go_context_entry(mod, rest2, ce, pool, unresolved)
                return
            # module / go / toolchain / comment / unknown directive: not a requirement
            return if rh_go_tok(mod, cs, k, "module") or rh_go_tok(mod, cs, k, "go") or rh_go_tok(mod, cs, k, "toolchain")
            unknown_out[0] <- unknown_out[0] + 1
            return

        # End index of the first whitespace-delimited word in [s,e).
        def rh_go_word_end(data: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < e and data[i.usize()] != 32 and data[i.usize()] != 9 |i: i64 = s| -> i:
                i <- i + 1

        # Parse `module <path>`; returns the path span via ms/me or -1.
        def rh_go_module_path(mod: darray[u8]&, ms: mutable i64&, me: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while true |pos: i64 = 0, mod, ms, me|:
                break if pos >= mod.count.i64()
                le: i64 =
                    while le < mod.count.i64() and mod[le.usize()] != 10 |le: i64 = pos| -> le:
                        le <- le + 1
                cs: mutable i64 = 0
                ce: mutable i64 = 0
                rh_go_trim(mod, pos, le, &cs, &ce)
                if ce > cs:
                    k: i64 = rh_go_word_end(mod, cs, ce)
                    if rh_go_tok(mod, cs, k, "module"):
                        rest: i64 =
                            while rest < ce and (mod[rest.usize()] == 32 or mod[rest.usize()] == 9) |rest: i64 = k, ce| -> rest:
                                rest <- rest + 1
                        if rest < ce:
                            ms[0] <- rest
                            me[0] <- ce
                            return 0
                pos <- le + 1
            -1

        # Insert a require entry: exact supported version -> node + root edge;
        # otherwise an unresolved entry preserving the original text.
        def rh_go_require_entry(mod: darray[u8]&, s: i64, e: i64, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            ns: mutable i64 = s
            ne: mutable i64 =
                while ne < e and mod[ne.usize()] != 32 and mod[ne.usize()] != 9 |ne: i64 = s| -> ne:
                    ne <- ne + 1
            return if ne <= ns
            vs: mutable i64 =
                while vs < e and (mod[vs.usize()] == 32 or mod[vs.usize()] == 9) |vs: i64 = ne| -> vs:
                    vs <- vs + 1
            ve: i64 =
                while ve < e and mod[ve.usize()] != 32 and mod[ve.usize()] != 9 |ve: i64 = vs| -> ve:
                    ve <- ve + 1
                # record the requirement token for the unsupported-range classifier
            rhs: mutable i64 = -1
            rhe: mutable i64 = -1
            if vs < ve:
                rhs <- rh_pool_copy(pool, mod, vs.usize(), ve.usize())
                rhe <- rhs + (ve - vs)
            reqs.push(RhRequire{from: 0, name_s: -1, name_e: -1, ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: rhs, req_e: rhe, depctx: 0})
            if vs < ve and rh_go_version_supported(mod, vs, ve):
                nname: i64 = rh_pool_copy(pool, mod, ns.usize(), ne.usize())
                nver: i64 = rh_pool_copy(pool, mod, vs.usize(), ve.usize())
                existing: mutable i64 = rh_go_find(pkgs, pool, nname.usize(), (nname + (ne - ns)).usize(), nver.usize(), (nver + (ve - vs)).usize())
                if existing < 0:
                    existing <- rh_node_add(pkgs, RH_ECO_GO)
                    return if existing < 0
                    nd: mutable RhPkgNode = pkgs[existing.usize()]
                    nd.name_s <- nname
                    nd.name_e <- nname + (ne - ns)
                    nd.ver_s <- nver
                    nd.ver_e <- nver + (ve - vs)
                    nd.src_kind <- 0
                    pkgs[existing.usize()] <- nd
                edges.push(RhDepEdge{from: 0, dst: existing, depctx: 0})
                return
            # missing version or unsupported version -> unresolved (preserve text)
            uns_name: i64 = rh_pool_copy(pool, mod, ns.usize(), ne.usize())
            unresolved.push(RhUnresolved{from: 0, name_s: uns_name, name_e: uns_name + (ne - ns), req_s: rhs, req_e: rhe, reason: 0})
            return

        # Replace/exclude/retract entry -> an explicit context-unresolved record.
        def rh_go_context_entry(mod: darray[u8]&, s: i64, e: i64, pool: mutable darray[u8]&, unresolved: mutable darray[RhUnresolved]&) -> void can[Memory.Allocate, Abort.Panic]:
            ns: mutable i64 = s
            ne: i64 =
                while ne < e and mod[ne.usize()] != 32 and mod[ne.usize()] != 9 |ne: i64 = s| -> ne:
                    ne <- ne + 1
            return if ne <= ns
            name_s: i64 = rh_pool_copy(pool, mod, ns.usize(), ne.usize())
            full_s: i64 = rh_pool_copy(pool, mod, s.usize(), e.usize())
            unresolved.push(RhUnresolved{from: 0, name_s: name_s, name_e: name_s + (ne - ns), req_s: full_s, req_e: full_s + (e - s), reason: 2})
            return

        # --- Go module checksums (go.sum; M03-02) -------------------------------
        # A go.sum module line is evidence for the exact module/version selected by
        # go.mod. The separate `<version>/go.mod` checksum is metadata for the module
        # file, not the package artifact, so it is deliberately ignored here. Unknown
        # module lines are retained by Go's normal sum database but do not become
        # graph nodes when the local go.mod did not declare them.
        def rh_go_sum_digest_valid(data: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if e - s != 47
            return false if not rh_go_tok(data, s, s + 3, "h1:")
            while i < e |i: i64 = s + 3, data|:
                b: u8 = data[i.usize()]
                valid: bool = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 43 or b == 47 or b == 61
                return false if not valid
                i <- i + 1
            data[(e - 1).usize()] == 61

        def rh_go_sum_line(sum: darray[u8]&, s: i64, e: i64, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            ts: mutable i64 = 0
            te: mutable i64 = 0
            rh_go_trim(sum, s, e, &ts, &te)
            return 0 if ts == te
            ms: i64 = ts
            me: i64 =
                while i < te and sum[i.usize()] != 32 and sum[i.usize()] != 9 |i: i64 = ts| -> i:
                    i <- i + 1
            return -1 if me <= ms
            vs: i64 =
                while i < te and (sum[i.usize()] == 32 or sum[i.usize()] == 9) |i: i64 = me| -> i:
                    i <- i + 1
            ve: i64 =
                while i < te and sum[i.usize()] != 32 and sum[i.usize()] != 9 |i: i64 = vs| -> i:
                    i <- i + 1
            return -1 if ve <= vs
            ds: i64 =
                while i < te and (sum[i.usize()] == 32 or sum[i.usize()] == 9) |i: i64 = ve| -> i:
                    i <- i + 1
            de: i64 = te
            return -1 if ds >= de or not rh_go_sum_digest_valid(sum, ds, de)
            # A fourth token is never part of go.sum's line grammar.
            extra: i64 =
                while extra < te and (sum[extra.usize()] == 32 or sum[extra.usize()] == 9) |extra: i64 = de| -> extra:
                    extra <- extra + 1
            return -1 if extra < te
            # Ignore the module-file checksum while retaining package checksums.
            is_modfile: bool = ve - vs >= 7 and sum[(ve - 7).usize()] == 47 and rh_go_tok(sum, ve - 6, ve, "go.mod")
            return 0 if is_modfile
            version_end: i64 =
                while version_end < ve and sum[version_end.usize()] != 47 |version_end: i64 = vs| -> version_end:
                    version_end <- version_end + 1
            while i < pkgs.count |i: usize = 0, pkgs, pool, sum, ms, me, vs, version_end, ds, de|:
                n: RhPkgNode = pkgs[i]
                if n.eco == RH_ECO_GO and n.name_s >= 0 and n.ver_s >= 0:
                    if rh_go_span_eq2(pool, n.name_s.usize(), n.name_e.usize(), sum, ms.usize(), me.usize()) and rh_go_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), sum, vs.usize(), version_end.usize()):
                        if n.has_digest == 1:
                            return 0 if rh_go_span_eq2(pool, n.dig_s.usize(), n.dig_e.usize(), sum, ds.usize(), de.usize())
                            return -1
                        digest_start: i64 = rh_pool_copy(pool, sum, ds.usize(), de.usize())
                        n.has_digest <- 1
                        n.dig_s <- digest_start
                        n.dig_e <- digest_start + (de - ds)
                        pkgs[i] <- n
                        return 0
                i <- i + 1
            0

        def rh_go_sum_parse(sum: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while pos < sum.count.i64() |pos: i64 = 0, sum, pkgs, pool|:
                line_end: i64 =
                    while line_end < sum.count.i64() and sum[line_end.usize()] != 10 |line_end: i64 = pos, sum| -> line_end:
                        line_end <- line_end + 1
                return -1 if rh_go_sum_line(sum, pos, line_end, pkgs, pool) != 0
                pos <- line_end + 1
            0

        # --- M03 unsupported range expressions (F022, R009) -------------------
        # The supported subset is DECLARED, not implied: a requirement string is
        # classified as evaluable only when it is a plain semver range over digits,
        # dots, the operators ^ ~ > < = * and `x`, prerelease/build identifiers
        # (letters, '-', '+'), `|`/`,`/space, and it contains at least one digit or
        # is exactly `*`. Protocol/alias/workspace/path forms (`:`, `/`, e.g.
        # `npm:`, `file:`, `git+https://`, `workspace:`, `link:`) and dist-tags
        # such as `latest` are NOT evaluated and count as unsupported. This is
        # deliberately distinct from a missing dependency: an unsupported
        # expression is a syntax we do not claim to read, never a guessed edge.
        def rh_req_range_supported(pool: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e <= s or e > pool.count.i64()
            has_digit: bool =
                while i < e |has_digit: bool = false, i: i64 = s| -> has_digit:
                    ok: bool = |has_digit|
                        b: u8 = pool[i.usize()]
                        return false if b == 58 or b == 47
                        if b >= 48 and b <= 57:
                            has_digit <- true
                        (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 46 or b == 42 or b == 94 or b == 126 or b == 62 or b == 60 or b == 61 or b == 43 or b == 45 or b == 124 or b == 44 or b == 32 or b == 9
                    return false if not ok
                    i <- i + 1
            return true if has_digit
            if e - s == 1:
                return true if pool[s.usize()] == 42
            false

        # Count requirements whose range/version string is outside the declared
        # supported subset. Cargo.lock dependency entries carry an exact pinned
        # version (ver_s); npm requirement maps carry the raw range (req_s).
        # Requirements with no string at all are not counted (nothing to classify).
        def rh_unsupported_range_count(reqs: darray[RhRequire]&, pool: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while r < reqs.count |total: i64 = 0, r: usize = 0| -> total:
                q: RhRequire = reqs[r]
                s: i64 = q.ver_s if q.req_s < 0 else q.req_s
                e: i64 = q.ver_e if q.req_s < 0 else q.req_e
                if s >= 0 and e >= 0:
                    if not rh_req_range_supported(pool, s, e):
                        total <- total + 1
                r <- r + 1

        # Dependency metrics document (rh-deps-metrics/1). One registered metric,
        # `dependencies.unsupported_range_count`, with per-ecosystem components so
        # the denominator-free count can be audited. It never claims a dependency
        # is safe or that the graph is complete (R009/F022/R030).
        def rh_deps_metrics_emit(out: mutable darray[u8]&, eco_codes: darray[i64]&, declared: darray[i64]&, resolved: darray[i64]&, unresolved: darray[i64]&, unsupported: darray[i64]&, direct_declared: mutable darray[i64]&, direct_resolved: mutable darray[i64]&, direct_unresolved: mutable darray[i64]&, transitive_resolved: mutable darray[i64]&, runtime_requirements: mutable darray[i64]&, development_requirements: mutable darray[i64]&, optional_requirements: mutable darray[i64]&, peer_requirements: mutable darray[i64]&, unknown_scope_requirements: mutable darray[i64]&, runtime_edges: mutable darray[i64]&, development_edges: mutable darray[i64]&, optional_edges: mutable darray[i64]&, peer_edges: mutable darray[i64]&, unknown_scope_edges: mutable darray[i64]&, advisories: mutable darray[i64]&, advisory_records: mutable darray[i64]&, affected_nodes: mutable darray[i64]&, affected_direct_nodes: mutable darray[i64]&, affected_transitive_nodes: mutable darray[i64]&, affected_unreachable_nodes: mutable darray[i64]&, withdrawn: mutable darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
            total_declared: i64 =
                while i < eco_codes.count.i64() |total_declared: i64 = 0, i: i64 = 0| -> total_declared:
                    total_declared <- total_declared + declared[i.usize()]
                    i <- i + 1
            total_resolved: i64 =
                while i < eco_codes.count.i64() |total_resolved: i64 = 0, i: i64 = 0| -> total_resolved:
                    total_resolved <- total_resolved + resolved[i.usize()]
                    i <- i + 1
            total_unresolved: i64 =
                while i < eco_codes.count.i64() |total_unresolved: i64 = 0, i: i64 = 0| -> total_unresolved:
                    total_unresolved <- total_unresolved + unresolved[i.usize()]
                    i <- i + 1
            total_unsupported: i64 =
                while i < eco_codes.count.i64() |total_unsupported: i64 = 0, i: i64 = 0| -> total_unsupported:
                    total_unsupported <- total_unsupported + unsupported[i.usize()]
                    i <- i + 1
            total_direct_declared: i64 =
                while i < eco_codes.count.i64() |total_direct_declared: i64 = 0, i: i64 = 0, direct_declared| -> total_direct_declared:
                    total_direct_declared <- total_direct_declared + direct_declared[i.usize()]
                    i <- i + 1
            total_direct_resolved: i64 =
                while i < eco_codes.count.i64() |total_direct_resolved: i64 = 0, i: i64 = 0, direct_resolved| -> total_direct_resolved:
                    total_direct_resolved <- total_direct_resolved + direct_resolved[i.usize()]
                    i <- i + 1
            total_direct_unresolved: i64 =
                while i < eco_codes.count.i64() |total_direct_unresolved: i64 = 0, i: i64 = 0, direct_unresolved| -> total_direct_unresolved:
                    total_direct_unresolved <- total_direct_unresolved + direct_unresolved[i.usize()]
                    i <- i + 1
            total_transitive_resolved: i64 =
                while i < eco_codes.count.i64() |total_transitive_resolved: i64 = 0, i: i64 = 0, transitive_resolved| -> total_transitive_resolved:
                    total_transitive_resolved <- total_transitive_resolved + transitive_resolved[i.usize()]
                    i <- i + 1
            total_runtime_requirements: i64 =
                while i < eco_codes.count.i64() |total_runtime_requirements: i64 = 0, i: i64 = 0, runtime_requirements| -> total_runtime_requirements:
                    total_runtime_requirements <- total_runtime_requirements + runtime_requirements[i.usize()]
                    i <- i + 1
            total_development_requirements: i64 =
                while i < eco_codes.count.i64() |total_development_requirements: i64 = 0, i: i64 = 0, development_requirements| -> total_development_requirements:
                    total_development_requirements <- total_development_requirements + development_requirements[i.usize()]
                    i <- i + 1
            total_optional_requirements: i64 =
                while i < eco_codes.count.i64() |total_optional_requirements: i64 = 0, i: i64 = 0, optional_requirements| -> total_optional_requirements:
                    total_optional_requirements <- total_optional_requirements + optional_requirements[i.usize()]
                    i <- i + 1
            total_peer_requirements: i64 =
                while i < eco_codes.count.i64() |total_peer_requirements: i64 = 0, i: i64 = 0, peer_requirements| -> total_peer_requirements:
                    total_peer_requirements <- total_peer_requirements + peer_requirements[i.usize()]
                    i <- i + 1
            total_unknown_scope_requirements: i64 =
                while i < eco_codes.count.i64() |total_unknown_scope_requirements: i64 = 0, i: i64 = 0, unknown_scope_requirements| -> total_unknown_scope_requirements:
                    total_unknown_scope_requirements <- total_unknown_scope_requirements + unknown_scope_requirements[i.usize()]
                    i <- i + 1
            total_runtime_edges: i64 =
                while i < eco_codes.count.i64() |total_runtime_edges: i64 = 0, i: i64 = 0, runtime_edges| -> total_runtime_edges:
                    total_runtime_edges <- total_runtime_edges + runtime_edges[i.usize()]
                    i <- i + 1
            total_development_edges: i64 =
                while i < eco_codes.count.i64() |total_development_edges: i64 = 0, i: i64 = 0, development_edges| -> total_development_edges:
                    total_development_edges <- total_development_edges + development_edges[i.usize()]
                    i <- i + 1
            total_optional_edges: i64 =
                while i < eco_codes.count.i64() |total_optional_edges: i64 = 0, i: i64 = 0, optional_edges| -> total_optional_edges:
                    total_optional_edges <- total_optional_edges + optional_edges[i.usize()]
                    i <- i + 1
            total_peer_edges: i64 =
                while i < eco_codes.count.i64() |total_peer_edges: i64 = 0, i: i64 = 0, peer_edges| -> total_peer_edges:
                    total_peer_edges <- total_peer_edges + peer_edges[i.usize()]
                    i <- i + 1
            total_unknown_scope_edges: i64 =
                while i < eco_codes.count.i64() |total_unknown_scope_edges: i64 = 0, i: i64 = 0, unknown_scope_edges| -> total_unknown_scope_edges:
                    total_unknown_scope_edges <- total_unknown_scope_edges + unknown_scope_edges[i.usize()]
                    i <- i + 1
            security_observed: bool = advisories.count == eco_codes.count and eco_codes.count > 0 and advisories[0] >= 0
            total_advisories: mutable i64 = 0
            total_advisory_records: mutable i64 = 0
            total_affected_nodes: mutable i64 = 0
            total_affected_direct_nodes: mutable i64 = 0
            total_affected_transitive_nodes: mutable i64 = 0
            total_affected_unreachable_nodes: mutable i64 = 0
            total_withdrawn: mutable i64 = 0
            if security_observed:
                total_advisories <- while i < eco_codes.count.i64() |total_advisories: i64 = 0, i: i64 = 0, advisories| -> total_advisories:
                    total_advisories <- total_advisories + advisories[i.usize()]
                    i <- i + 1
                total_advisory_records <- while i < eco_codes.count.i64() |total_advisory_records: i64 = 0, i: i64 = 0, advisory_records| -> total_advisory_records:
                    total_advisory_records <- total_advisory_records + advisory_records[i.usize()]
                    i <- i + 1
                total_affected_nodes <- while i < eco_codes.count.i64() |total_affected_nodes: i64 = 0, i: i64 = 0, affected_nodes| -> total_affected_nodes:
                    total_affected_nodes <- total_affected_nodes + affected_nodes[i.usize()]
                    i <- i + 1
                total_affected_direct_nodes <- while i < eco_codes.count.i64() |total_affected_direct_nodes: i64 = 0, i: i64 = 0, affected_direct_nodes| -> total_affected_direct_nodes:
                    total_affected_direct_nodes <- total_affected_direct_nodes + affected_direct_nodes[i.usize()]
                    i <- i + 1
                total_affected_transitive_nodes <- while i < eco_codes.count.i64() |total_affected_transitive_nodes: i64 = 0, i: i64 = 0, affected_transitive_nodes| -> total_affected_transitive_nodes:
                    total_affected_transitive_nodes <- total_affected_transitive_nodes + affected_transitive_nodes[i.usize()]
                    i <- i + 1
                total_affected_unreachable_nodes <- while i < eco_codes.count.i64() |total_affected_unreachable_nodes: i64 = 0, i: i64 = 0, affected_unreachable_nodes| -> total_affected_unreachable_nodes:
                    total_affected_unreachable_nodes <- total_affected_unreachable_nodes + affected_unreachable_nodes[i.usize()]
                    i <- i + 1
                total_withdrawn <- while i < eco_codes.count.i64() |total_withdrawn: i64 = 0, i: i64 = 0, withdrawn| -> total_withdrawn:
                    total_withdrawn <- total_withdrawn + withdrawn[i.usize()]
                    i <- i + 1
            Base::rh_push_text(out, "{\"schema\":\"rh-deps-metrics/1\",\"metrics\":[{\"key\":\"dependencies.unsupported_range_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_unsupported)
            Base::rh_push_text(out, ",\"evidence\":[")
            while j < eco_codes.count.i64() |j: i64 = 0, eco_codes, out|:
                if j > 0:
                    out.push(44)
                Base::rh_push_text(out, "\"")
                Base::rh_push_text(out, rh_deps_spec(eco_codes[j.usize()]))
                Base::rh_push_text(out, "\"")
                j <- j + 1
            Base::rh_push_text(out, "],\"note\":\"unsupported range syntax is not a missing dependency; : and / forms are not evaluated\"},")
            Base::rh_push_text(out, "{\"key\":\"dependencies.ecosystem_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, eco_codes.count.i64())
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependencies.declared_requirement_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_declared)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependencies.resolved_edge_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_resolved)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependencies.unresolved_requirement_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_unresolved)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.requirements_direct\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_direct_declared)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.resolved_direct_versions\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_direct_resolved)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.unresolved_requirements\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_direct_unresolved)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.resolved_transitive_versions\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_transitive_resolved)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.runtime_requirements\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_runtime_requirements)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.development_requirements\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_development_requirements)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.optional_requirements\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_optional_requirements)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.peer_requirements\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_peer_requirements)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.unknown_scope_requirements\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_unknown_scope_requirements)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.runtime_resolved_edges\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_runtime_edges)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.development_resolved_edges\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_development_edges)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.optional_resolved_edges\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_optional_edges)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.peer_resolved_edges\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_peer_edges)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"dependency.unknown_scope_resolved_edges\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, total_unknown_scope_edges)
            Base::rh_push_text(out, ",\"evidence\":[\"dependency-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"security.known_advisory_records\",\"version\":\"1.0.0\",\"status\":\"")
            if security_observed:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, total_advisory_records)
            else:
                Base::rh_push_text(out, "unavailable\",\"reason\":\"osv-input-not-provided\"")
            Base::rh_push_text(out, ",\"evidence\":[\"osv-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"security.known_unique_advisories\",\"version\":\"1.0.0\",\"status\":\"")
            if security_observed:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, total_advisories)
            else:
                Base::rh_push_text(out, "unavailable\",\"reason\":\"osv-input-not-provided\"")
            Base::rh_push_text(out, ",\"evidence\":[\"osv-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"security.affected_resolved_nodes\",\"version\":\"1.0.0\",\"status\":\"")
            if security_observed:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, total_affected_nodes)
            else:
                Base::rh_push_text(out, "unavailable\",\"reason\":\"osv-input-not-provided\"")
            Base::rh_push_text(out, ",\"evidence\":[\"osv-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"security.affected_direct_nodes\",\"version\":\"1.0.0\",\"status\":\"")
            if security_observed:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, total_affected_direct_nodes)
            else:
                Base::rh_push_text(out, "unavailable\",\"reason\":\"osv-input-not-provided\"")
            Base::rh_push_text(out, ",\"evidence\":[\"osv-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"security.affected_transitive_nodes\",\"version\":\"1.0.0\",\"status\":\"")
            if security_observed:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, total_affected_transitive_nodes)
            else:
                Base::rh_push_text(out, "unavailable\",\"reason\":\"osv-input-not-provided\"")
            Base::rh_push_text(out, ",\"evidence\":[\"osv-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"security.affected_unreachable_nodes\",\"version\":\"1.0.0\",\"status\":\"")
            if security_observed:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, total_affected_unreachable_nodes)
            else:
                Base::rh_push_text(out, "unavailable\",\"reason\":\"osv-input-not-provided\"")
            Base::rh_push_text(out, ",\"evidence\":[\"osv-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"security.withdrawn_advisory_count\",\"version\":\"1.0.0\",\"status\":\"")
            if security_observed:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, total_withdrawn)
            else:
                Base::rh_push_text(out, "unavailable\",\"reason\":\"osv-input-not-provided\"")
            Base::rh_push_text(out, ",\"evidence\":[\"osv-input\"]}],\"by_ecosystem\":[")
            while k < eco_codes.count.i64() |k: i64 = 0, eco_codes, declared, resolved, unresolved, unsupported, direct_declared, direct_resolved, direct_unresolved, transitive_resolved, runtime_requirements, development_requirements, optional_requirements, peer_requirements, unknown_scope_requirements, runtime_edges, development_edges, optional_edges, peer_edges, unknown_scope_edges, advisories, advisory_records, affected_nodes, affected_direct_nodes, affected_transitive_nodes, affected_unreachable_nodes, withdrawn, out|:
                if k > 0:
                    out.push(44)
                ec: i64 = eco_codes[k.usize()]
                Base::rh_push_text(out, "{\"ecosystem\":\"")
                Base::rh_push_text(out, rh_deps_eco(ec))
                Base::rh_push_text(out, "\",\"evidence\":\"")
                Base::rh_push_text(out, rh_deps_spec(ec))
                Base::rh_push_text(out, "\",\"declared_requirements\":")
                Base::rh_push_decimal_i64(out, declared[k.usize()])
                Base::rh_push_text(out, ",\"resolved_edges\":")
                Base::rh_push_decimal_i64(out, resolved[k.usize()])
                Base::rh_push_text(out, ",\"unresolved_requirements\":")
                Base::rh_push_decimal_i64(out, unresolved[k.usize()])
                Base::rh_push_text(out, ",\"unsupported_range_count\":")
                Base::rh_push_decimal_i64(out, unsupported[k.usize()])
                Base::rh_push_text(out, ",\"requirements_direct\":")
                Base::rh_push_decimal_i64(out, direct_declared[k.usize()])
                Base::rh_push_text(out, ",\"resolved_direct_versions\":")
                Base::rh_push_decimal_i64(out, direct_resolved[k.usize()])
                Base::rh_push_text(out, ",\"unresolved_direct_requirements\":")
                Base::rh_push_decimal_i64(out, direct_unresolved[k.usize()])
                Base::rh_push_text(out, ",\"resolved_transitive_versions\":")
                Base::rh_push_decimal_i64(out, transitive_resolved[k.usize()])
                Base::rh_push_text(out, ",\"runtime_requirements\":")
                Base::rh_push_decimal_i64(out, runtime_requirements[k.usize()])
                Base::rh_push_text(out, ",\"development_requirements\":")
                Base::rh_push_decimal_i64(out, development_requirements[k.usize()])
                Base::rh_push_text(out, ",\"optional_requirements\":")
                Base::rh_push_decimal_i64(out, optional_requirements[k.usize()])
                Base::rh_push_text(out, ",\"peer_requirements\":")
                Base::rh_push_decimal_i64(out, peer_requirements[k.usize()])
                Base::rh_push_text(out, ",\"unknown_scope_requirements\":")
                Base::rh_push_decimal_i64(out, unknown_scope_requirements[k.usize()])
                Base::rh_push_text(out, ",\"runtime_resolved_edges\":")
                Base::rh_push_decimal_i64(out, runtime_edges[k.usize()])
                Base::rh_push_text(out, ",\"development_resolved_edges\":")
                Base::rh_push_decimal_i64(out, development_edges[k.usize()])
                Base::rh_push_text(out, ",\"optional_resolved_edges\":")
                Base::rh_push_decimal_i64(out, optional_edges[k.usize()])
                Base::rh_push_text(out, ",\"peer_resolved_edges\":")
                Base::rh_push_decimal_i64(out, peer_edges[k.usize()])
                Base::rh_push_text(out, ",\"unknown_scope_resolved_edges\":")
                Base::rh_push_decimal_i64(out, unknown_scope_edges[k.usize()])
                Base::rh_push_text(out, ",\"known_advisory_records\":")
                if security_observed:
                    Base::rh_push_decimal_i64(out, advisory_records[k.usize()])
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"known_unique_advisories\":")
                if security_observed:
                    Base::rh_push_decimal_i64(out, advisories[k.usize()])
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"affected_resolved_nodes\":")
                if security_observed:
                    Base::rh_push_decimal_i64(out, affected_nodes[k.usize()])
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"affected_direct_nodes\":")
                if security_observed:
                    Base::rh_push_decimal_i64(out, affected_direct_nodes[k.usize()])
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"affected_transitive_nodes\":")
                if security_observed:
                    Base::rh_push_decimal_i64(out, affected_transitive_nodes[k.usize()])
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"affected_unreachable_nodes\":")
                if security_observed:
                    Base::rh_push_decimal_i64(out, affected_unreachable_nodes[k.usize()])
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"withdrawn_advisory_count\":")
                if security_observed:
                    Base::rh_push_decimal_i64(out, withdrawn[k.usize()])
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, "}")
                k <- k + 1
            Base::rh_push_text(out, "]}")

        def rh_deps_eco(code: i64) -> u8&:
            return "npm" if code == 1
            return "pypi" if code == 2
            return "go" if code == 3
            return "rubygems" if code == 4
            return "composer" if code == 5
            return "nuget" if code == 6
            return "maven" if code == 7
            "cargo"

        def rh_deps_spec(code: i64) -> u8&:
            return "package-lock.json" if code == 1
            return "requirements.txt" if code == 2
            return "go.mod" if code == 3
            return "Gemfile.lock" if code == 4
            return "composer.lock" if code == 5
            return "packages.config" if code == 6
            return "pom.xml" if code == 7
            "Cargo.lock"

        # Root of a Cargo.lock graph: the workspace/root package has no `source`
        # field (src_kind 3); registry/path/git packages do. Falls back to the
        # first in-degree-zero node, then 0 (bounded witnesses later fail closed).
        def rh_deps_cargo_root(pkgs: darray[RhPkgNode]&, edges: darray[RhDepEdge]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs|:
                n: RhPkgNode = pkgs[i.usize()]
                return i if n.src_kind == 3
                i <- i + 1
            while j < pkgs.count.i64() |j: i64 = 0, edges|:
                return j if rh_graph_in_count(edges, j) == 0
                j <- j + 1
            0

        def rh_emit_bool(buffer: mutable darray[u8]&, value: bool) -> void can[Memory.Allocate, Abort.Panic]:
            if value:
                Base::rh_push_text(buffer, "true")
            else:
                Base::rh_push_text(buffer, "false")

        # Canonical dependency graph JSON (rh-dep-graph/1) for goldens, bundles,
        # and the deps command. Witnesses computed from root (bounded).
        def rh_graph_write_json(out: mutable darray[u8]&, eco: u8, pkgs: darray[RhPkgNode]&, pool: darray[u8]&, edges: darray[RhDepEdge]&, unresolved: darray[RhUnresolved]&, findings: darray[RhAdvisory]&, advtexts: darray[u8]&, root: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if eco == 0:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"cargo\",\"nodes\":[")
            elif eco == 2:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"pypi\",\"nodes\":[")
            elif eco == 3:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"go\",\"nodes\":[")
            elif eco == 4:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"rubygems\",\"nodes\":[")
            elif eco == 5:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"composer\",\"nodes\":[")
            elif eco == 6:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"nuget\",\"nodes\":[")
            elif eco == 7:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"maven\",\"nodes\":[")
            else:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"npm\",\"nodes\":[")
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool, out|:
                n: RhPkgNode = pkgs[i.usize()]
                if i > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"id\":")
                Base::rh_push_decimal_i64(out, i)
                Base::rh_push_text(out, ",\"name\":\"")
                Base::rh_json_escape(out, pool, n.name_s.usize(), n.name_e.usize())
                Base::rh_push_text(out, "\",\"version\":")
                if n.ver_s < 0:
                    Base::rh_push_text(out, "null")
                else:
                    Base::rh_push_text(out, "\"")
                    Base::rh_json_escape(out, pool, n.ver_s.usize(), n.ver_e.usize())
                    Base::rh_push_text(out, "\"")
                Base::rh_push_text(out, ",\"source\":\"")
                Base::rh_push_text(out, rh_src_label(n.src_kind))
                Base::rh_push_text(out, "\",\"digest\":")
                rh_emit_bool(out, n.has_digest != 0)
                Base::rh_push_text(out, ",\"dev\":")
                rh_emit_bool(out, n.dev != 0)
                Base::rh_push_text(out, ",\"optional\":")
                rh_emit_bool(out, n.optional != 0)
                Base::rh_push_text(out, "}")
                i <- i + 1
            Base::rh_push_text(out, "],\"edges\":[")
            while e < edges.count.i64() |e: i64 = 0, edges, out|:
                ed: RhDepEdge = edges[e.usize()]
                if e > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"from\":")
                Base::rh_push_decimal_i64(out, ed.from)
                Base::rh_push_text(out, ",\"to\":")
                Base::rh_push_decimal_i64(out, ed.dst)
                Base::rh_push_text(out, ",\"scope\":\"")
                Base::rh_push_text(out, rh_scope_label(ed.depctx))
                Base::rh_push_text(out, "\"}")
                e <- e + 1
            Base::rh_push_text(out, "],\"unresolved\":[")
            while u < unresolved.count.i64() |u: i64 = 0, unresolved, pool, out|:
                ur: RhUnresolved = unresolved[u.usize()]
                if u > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"from\":")
                Base::rh_push_decimal_i64(out, ur.from)
                Base::rh_push_text(out, ",\"name\":\"")
                Base::rh_json_escape(out, pool, ur.name_s.usize(), ur.name_e.usize())
                Base::rh_push_text(out, "\",\"requirement\":")
                if ur.req_s < 0:
                    Base::rh_push_text(out, "null")
                else:
                    Base::rh_push_text(out, "\"")
                    Base::rh_json_escape(out, pool, ur.req_s.usize(), ur.req_e.usize())
                    Base::rh_push_text(out, "\"")
                Base::rh_push_text(out, ",\"reason\":\"")
                Base::rh_push_text(out, rh_unres_label(ur.reason))
                Base::rh_push_text(out, "\"}")
                u <- u + 1
            Base::rh_push_text(out, "],\"advisories\":[")
            while f < findings.count.i64() |f: i64 = 0, findings, advtexts, out, edges, pkgs, root|:
                fa: RhAdvisory = findings[f.usize()]
                if f > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"advisory\":\"")
                Base::rh_json_escape(out, advtexts, fa.adv_s.usize(), fa.adv_e.usize())
                Base::rh_push_text(out, "\",\"node\":")
                Base::rh_push_decimal_i64(out, fa.node)
                Base::rh_push_text(out, ",\"fixed\":")
                if fa.fix_s < 0:
                    Base::rh_push_text(out, "null")
                else:
                    Base::rh_push_text(out, "\"")
                    Base::rh_json_escape(out, advtexts, fa.fix_s.usize(), fa.fix_e.usize())
                    Base::rh_push_text(out, "\"")
                Base::rh_push_text(out, ",\"aliases\":")
                Base::rh_push_decimal_i64(out, fa.alias_count)
                Base::rh_push_text(out, ",\"witness\":[")
                wit: mutable darray[i64] = []
                wl: i64 = rh_graph_witness(edges, pkgs.count.i64(), root, fa.node, 32, wit)
                if wl > 0:
                    while w < wit.count |w: usize = 0, wit, out|:
                        if w > 0:
                            out.push(44)
                        Base::rh_push_decimal_i64(out, wit[w])
                        w <- w + 1
                Base::rh_push_text(out, "]}")
                f <- f + 1
            Base::rh_push_text(out, "]}")

        # --- RubyGems Gemfile.lock (M08 ecosystems lane) ----------------------
        # Gemfile.lock is indentation-structured text, not JSON: a Gemfile is a
        # `~>`-style resolved lock, so the pinned `specs:` entries ARE resolution
        # evidence, while the `DEPENDENCIES` block is the declared-requirement
        # side and never silently becomes an edge (R009). A spec's nested
        # dependencies (6-space indent) become edges from that spec; the root
        # package is the synthetic project node. Platform-suffixed versions
        # (e.g. `nokogiri (1.15.0-x86_64-linux)`) are kept verbatim as the
        # version label — a label is not a digest (M03-02). GIT/PATH sections
        # mark source kind so a registry gem is never confused with a checkout.
        const RH_GEMSEC_NONE: u8 = 0
        const RH_GEMSEC_GEM: u8 = 1
        const RH_GEMSEC_GIT: u8 = 2
        const RH_GEMSEC_PATH: u8 = 3
        const RH_GEMSEC_DEPS: u8 = 4
        const RH_GEMSEC_OTHER: u8 = 5

        def rh_gem_indent(buf: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < e |i: i64 = s, n: i64 = 0| -> n:
                break if buf[i.usize()] != 32
                n <- n + 1
                i <- i + 1

        def rh_gem_trim(buf: darray[u8]&, s: i64, e: i64, ts: mutable i64&, te: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            a: mutable i64 =
                while a < e and (buf[a.usize()] == 32 or buf[a.usize()] == 9) |a: i64 = s| -> a:
                    a <- a + 1
            b: i64 =
                while b > a and (buf[(b - 1).usize()] == 32 or buf[(b - 1).usize()] == 9 or buf[(b - 1).usize()] == 13) |b: i64 = e, a| -> b:
                    b <- b - 1
            ts[0] <- a
            te[0] <- b
            return

        def rh_gem_section(buf: darray[u8]&, ts: i64, te: i64) -> u8 can[Memory.Allocate, Abort.Panic]:
            return RH_GEMSEC_NONE if ts >= te
            if ts + 3 <= te and buf[ts.usize()] == 71 and buf[(ts + 1).usize()] == 69 and buf[(ts + 2).usize()] == 77:
                return RH_GEMSEC_GEM if ts + 3 == te
            if ts + 3 <= te and buf[ts.usize()] == 71 and buf[(ts + 1).usize()] == 73 and buf[(ts + 2).usize()] == 84:
                return RH_GEMSEC_GIT if ts + 3 == te
            if ts + 4 <= te and buf[ts.usize()] == 80 and buf[(ts + 1).usize()] == 65 and buf[(ts + 2).usize()] == 84 and buf[(ts + 3).usize()] == 72:
                return RH_GEMSEC_PATH if ts + 4 == te
            return RH_GEMSEC_DEPS if ts + 11 <= te and rh_gem_word(buf, ts, te, "DEPENDENCIES")
            RH_GEMSEC_OTHER

        def rh_gem_word(buf: darray[u8]&, ts: i64, te: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if te - ts != Base::rh_cstr_len(lit)
            while ts + i < te |i: i64 = 0, ts, te, buf, lit|:
                b: u8 = buf[(ts + i).usize()]
                c: u8 = lit[i.usize()]
                return false if b != c
                i <- i + 1
            true

        # Parse `name (version)` / `name` -> name span + optional version span.
        def rh_gem_spec_split(buf: darray[u8]&, s: i64, e: i64, ns: mutable i64&, ne: mutable i64&, vs: mutable i64&, ve: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            ns[0] <- s
            ne[0] <- s
            vs[0] <- -1
            ve[0] <- -1
            a: mutable i64 =
                while a < e and (buf[a.usize()] == 32 or buf[a.usize()] == 9) |a: i64 = s| -> a:
                    a <- a + 1
            b: mutable i64 =
                while b < e and buf[b.usize()] != 32 and buf[b.usize()] != 9 |b: i64 = a| -> b:
                    b <- b + 1
            ns[0] <- a
            ne[0] <- b
            c: mutable i64 =
                while c < e and (buf[c.usize()] == 32 or buf[c.usize()] == 9) |c: i64 = b| -> c:
                    c <- c + 1
            if c < e and buf[c.usize()] == 40:
                d: i64 =
                    while d < e and buf[d.usize()] != 41 |d: i64 = c + 1| -> d:
                        d <- d + 1
                if d > c + 1:
                    vs[0] <- c + 1
                    ve[0] <- d
            return

        def rh_gem_find(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize, vs: usize, ve: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool, ns, ne, vs, ve|:
                n: RhPkgNode = pkgs[i.usize()]
                if n.eco == RH_ECO_RUBYGEMS and n.name_s >= 0 and n.ver_s >= 0:
                    if rh_span_eq2(pool, n.name_s.usize(), n.name_e.usize(), pool, ns, ne):
                        return i if rh_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, vs, ve)
                i <- i + 1
            -1

        def rh_gemfile_parse(buf: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            rroot: i64 = rh_node_add(pkgs, RH_ECO_RUBYGEMS)
            return -1 if rroot != 0
            rn: mutable darray[u8] = []
            Base::rh_push_text(rn, "root")
            rns: i64 = rh_pool_copy(pool, rn, 0, rn.count)
            rnode: mutable RhPkgNode = pkgs[0]
            rnode.name_s <- rns
            rnode.name_e <- rns + rn.count.i64()
            rnode.src_kind <- 3
            pkgs[0] <- rnode
            while true |sec: u8 = RH_GEMSEC_NONE, subsrc: u8 = RH_PSRC_REGISTRY, in_specs: i64 = 0, last_spec: i64 = -1, pos: i64 = 0, buf, pkgs, pool, reqs, edges, unresolved, unknown_out|:
                break if pos >= buf.count.i64()
                le: i64 =
                    while le < buf.count.i64() and buf[le.usize()] != 10 |le: i64 = pos| -> le:
                        le <- le + 1
                ind: i64 = rh_gem_indent(buf, pos, le)
                ts: mutable i64 = 0
                te: mutable i64 = 0
                rh_gem_trim(buf, pos, le, &ts, &te)
                if te > ts:
                    if ind == 0:
                        sec <- rh_gem_section(buf, ts, te)
                        if sec == RH_GEMSEC_GIT:
                            subsrc <- RH_PSRC_GIT
                        elif sec == RH_GEMSEC_PATH:
                            subsrc <- RH_PSRC_PATH
                        elif sec == RH_GEMSEC_GEM:
                            subsrc <- RH_PSRC_REGISTRY
                        in_specs <- 0
                        last_spec <- -1
                    elif sec == RH_GEMSEC_GEM or sec == RH_GEMSEC_GIT or sec == RH_GEMSEC_PATH:
                        if ind == 2:
                            # `remote:` / `specs:` / `revision:` / `branch:` metadata
                            if rh_gem_word(buf, ts, te, "specs:"):
                                in_specs <- 1
                            else:
                                unknown_out[0] <- unknown_out[0] + 1
                        elif in_specs == 1 and ind >= 4:
                            if ind == 4:
                                last_spec <- rh_gem_add_spec(buf, ts, te, pkgs, pool, subsrc)
                            elif ind == 6 and last_spec >= 0:
                                rh_gem_add_dep(buf, ts, te, pool, reqs, last_spec)
                            else:
                                unknown_out[0] <- unknown_out[0] + 1
                        else:
                            unknown_out[0] <- unknown_out[0] + 1
                    elif sec == RH_GEMSEC_DEPS:
                        if ind == 2:
                            rh_gem_add_require(buf, ts, te, pool, reqs, RH_SCOPE_DECLARED)
                        else:
                            unknown_out[0] <- unknown_out[0] + 1
                    else:
                        unknown_out[0] <- unknown_out[0] + 1
                pos <- le + 1
            # Resolve every recorded requirement (root DEPENDENCIES and nested spec
            # deps alike) against the full spec set: a requirement names a locked
            # spec -> edge; otherwise it stays an explicit unresolved entry and is
            # NEVER a guessed edge (R009).
            while i < reqs.count.i64() |i: i64 = 0, reqs, pkgs, pool, edges, unresolved|:
                q: RhRequire = reqs[i.usize()]
                if q.name_s >= 0:
                    hit: i64 = rh_gem_find_by_name(pkgs, pool, q.name_s.usize(), q.name_e.usize())
                    if hit >= 0:
                        edges.push(RhDepEdge{from: q.from, dst: hit, depctx: q.depctx})
                    else:
                        unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.req_s, req_e: q.req_e, reason: 0})
                i <- i + 1
            0

        def rh_gem_add_spec(buf: darray[u8]&, ts: i64, te: i64, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, skind: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            ns: mutable i64 = 0
            ne: mutable i64 = 0
            vs: mutable i64 = 0
            ve: mutable i64 = 0
            rh_gem_spec_split(buf, ts, te, &ns, &ne, &vs, &ve)
            if ne <= ns:
                return -1
            # Copy into the pool FIRST: rh_gem_find compares pool spans, so handing
            # it buf-relative offsets would compare the wrong bytes (and can trap
            # out of bounds when lengths coincide by accident).
            cname_s: i64 = rh_pool_copy(pool, buf, ns.usize(), ne.usize())
            cname_e: i64 = cname_s + (ne - ns)
            cver_s: mutable i64 = -1
            cver_e: mutable i64 = -1
            if vs >= 0:
                cver_s <- rh_pool_copy(pool, buf, vs.usize(), ve.usize())
                cver_e <- cver_s + (ve - vs)
            existing: mutable i64 = rh_gem_find(pkgs, pool, cname_s.usize(), cname_e.usize(), cver_s.usize(), cver_e.usize()) if vs >= 0 else -1
            if existing < 0:
                existing <- rh_node_add(pkgs, RH_ECO_RUBYGEMS)
                return -1 if existing < 0
                nd: mutable RhPkgNode = pkgs[existing.usize()]
                nd.name_s <- cname_s
                nd.name_e <- cname_e
                if vs >= 0:
                    nd.ver_s <- cver_s
                    nd.ver_e <- cver_e
                nd.src_kind <- skind
                pkgs[existing.usize()] <- nd
            existing

        def rh_gem_find_by_name(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool, ns, ne|:
                n: RhPkgNode = pkgs[i.usize()]
                if n.eco == RH_ECO_RUBYGEMS and n.name_s >= 0:
                    return i if rh_span_eq2(pool, n.name_s.usize(), n.name_e.usize(), pool, ns, ne)
                i <- i + 1
            -1

        def rh_gem_add_dep(buf: darray[u8]&, ts: i64, te: i64, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, from: i64) -> void can[Memory.Allocate, Abort.Panic]:
            ns: mutable i64 = 0
            ne: mutable i64 = 0
            vs: mutable i64 = 0
            ve: mutable i64 = 0
            rh_gem_spec_split(buf, ts, te, &ns, &ne, &vs, &ve)
            if ne <= ns:
                return
            # Record the nested dependency as a requirement from the spec node; the
            # caller resolves it AFTER every spec is known, so a forward reference
            # (a spec whose dependency appears later in the file) still resolves.
            name_s: i64 = rh_pool_copy(pool, buf, ns.usize(), ne.usize())
            rhs: mutable i64 = -1
            rhe: mutable i64 = -1
            if vs >= 0:
                rhs <- rh_pool_copy(pool, buf, vs.usize(), ve.usize())
                rhe <- rhs + (ve - vs)
            reqs.push(RhRequire{from: from, name_s: name_s, name_e: name_s + (ne - ns), ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: rhs, req_e: rhe, depctx: 0})
            return

        def rh_gem_add_require(buf: darray[u8]&, ts: i64, te: i64, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, depctx: u8) -> void can[Memory.Allocate, Abort.Panic]:
            ns: mutable i64 = 0
            ne: mutable i64 = 0
            vs: mutable i64 = 0
            ve: mutable i64 = 0
            rh_gem_spec_split(buf, ts, te, &ns, &ne, &vs, &ve)
            return if ne <= ns
            name_s: i64 = rh_pool_copy(pool, buf, ns.usize(), ne.usize())
            rhs: mutable i64 = -1
            rhe: mutable i64 = -1
            if vs >= 0:
                rhs <- rh_pool_copy(pool, buf, vs.usize(), ve.usize())
                rhe <- rhs + (ve - vs)
            reqs.push(RhRequire{from: 0, name_s: name_s, name_e: name_s + (ne - ns), ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: rhs, req_e: rhe, depctx: depctx})
            return

        # --- Composer composer.lock (M08 ecosystems lane) ---------------------
        # composer.lock is JSON with `packages` (runtime) and `packages-dev`
        # arrays; each entry has a vendor/package `name`, a `version` (native
        # Composer spelling, often with a leading `v` and stability suffixes) and
        # a `require` map whose values are Composer constraint expressions. The
        # locked entries ARE resolution evidence; the `require` map is the
        # declared-requirement side and becomes an edge only to an exactly-locked
        # name (R009). Platform requirements (`php`, `ext-*`, `lib-*`) are kept
        # as explicit context requirements, never as package edges. The root is
        # the synthetic project node; `require-dev` on a package marks the dev
        # scope so a test-only dependency is never reported as runtime.
        def rh_composer_add_pkg(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, reqs: mutable darray[RhRequire]&, entry: i64, depctx: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            namev: i64 = Json::rh_json_obj_get(jnodes, texts, entry, "name")
            ns: mutable i64 = -1
            ne: mutable i64 = -1
            return -1 if not Json::rh_json_str_span(jnodes, namev, &ns, &ne)
            verv: i64 = Json::rh_json_obj_get(jnodes, texts, entry, "version")
            vs: mutable i64 = -1
            ve: mutable i64 = -1
            has_ver: mutable bool = Json::rh_json_str_span(jnodes, verv, &vs, &ve)
            pname_s: i64 = rh_pool_copy(pool, texts, ns.usize(), ne.usize())
            pname_e: i64 = pname_s + (ne - ns)
            pver_s: mutable i64 = -1
            pver_e: mutable i64 = -1
            if has_ver:
                pver_s <- rh_pool_copy(pool, texts, vs.usize(), ve.usize())
                pver_e <- pver_s + (ve - vs)
            idx: mutable i64 = rh_composer_find(pkgs, pool, pname_s.usize(), pname_e.usize(), pver_s, pver_e)
            if idx < 0:
                idx <- rh_node_add(pkgs, RH_ECO_COMPOSER)
                return -1 if idx < 0
                nd: mutable RhPkgNode = pkgs[idx.usize()]
                nd.name_s <- pname_s
                nd.name_e <- pname_e
                if has_ver:
                    nd.ver_s <- pver_s
                    nd.ver_e <- pver_e
                nd.src_kind <- 0
                nd.dev <- depctx
                pkgs[idx.usize()] <- nd
            reqv: i64 = Json::rh_json_obj_get(jnodes, texts, entry, "require")
            if reqv >= 0:
                _ = rh_npm_req_map(jnodes, pool, texts, reqv, idx, depctx, reqs)
            idx

        def rh_composer_find(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize, vs: i64, ve: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool, ns, ne, vs, ve|:
                n: RhPkgNode = pkgs[i.usize()]
                if n.eco == RH_ECO_COMPOSER and n.name_s >= 0:
                    if rh_span_eq2(pool, n.name_s.usize(), n.name_e.usize(), pool, ns, ne):
                        return i if vs < 0 and n.ver_s < 0
                        if vs >= 0 and n.ver_s >= 0:
                            return i if rh_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, vs.usize(), ve.usize())
                i <- i + 1
            -1

        def rh_composer_parse(lock: darray[u8]&, jnodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            _ = lock
            return -1 if jnodes.count.i64() == 0
            rroot: i64 = rh_node_add(pkgs, RH_ECO_COMPOSER)
            return -1 if rroot != 0
            rn: mutable darray[u8] = []
            Base::rh_push_text(rn, "root")
            rns: i64 = rh_pool_copy(pool, rn, 0, rn.count)
            rnode: mutable RhPkgNode = pkgs[0]
            rnode.name_s <- rns
            rnode.name_e <- rns + rn.count.i64()
            rnode.src_kind <- 3
            pkgs[0] <- rnode
            # runtime packages then dev packages
            pa: i64 = Json::rh_json_obj_get(jnodes, texts, 0, "packages")
            rh_composer_add_array(jnodes, pool, texts, pkgs, reqs, pa, 0)
            pda: i64 = Json::rh_json_obj_get(jnodes, texts, 0, "packages-dev")
            rh_composer_add_array(jnodes, pool, texts, pkgs, reqs, pda, 1)
            # Resolve every recorded requirement (root and package `require` maps)
            # against the locked package set: a requirement that names a locked
            # vendor/package becomes an edge from its requiring node; a platform
            # requirement (php/ext-*/lib-*/php-*) stays context; anything else is
            # explicit unresolved. Never a guessed edge (R009).
            while i < reqs.count.i64() |i: i64 = 0, reqs, pkgs, pool, edges, unresolved|:
                q: RhRequire = reqs[i.usize()]
                if q.name_s >= 0:
                    if rh_composer_is_platform(pool, q.name_s.usize(), q.name_e.usize()):
                        unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.req_s, req_e: q.req_e, reason: 2})
                    else:
                        hit: i64 = rh_composer_find_by_name(pkgs, pool, q.name_s.usize(), q.name_e.usize())
                        if hit >= 0:
                            edges.push(RhDepEdge{from: q.from, dst: hit, depctx: q.depctx})
                        else:
                            unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.req_s, req_e: q.req_e, reason: 0})
                i <- i + 1
            0

        def rh_composer_add_array(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, reqs: mutable darray[RhRequire]&, arr: i64, depctx: u8) -> void can[Memory.Allocate, Abort.Panic]:
            return if arr < 0
            a: Json::RhJsonNode = jnodes[arr.usize()]
            return if a.kind != 4
            while child >= 0 |child: i64 = a.first_child, jnodes, pool, texts, pkgs, reqs, depctx|:
                _ = rh_composer_add_pkg(jnodes, pool, texts, pkgs, reqs, child, depctx)
                child <- jnodes[child.usize()].next_sibling
            return

        # Read one XML attribute from a bounded packages.config line. Attribute names
        # are matched exactly; both quote styles are accepted and decoded values stay
        # in the caller-owned source buffer.
        # (private to this file)
        def rh_nuget_attr(line: darray[u8]&, s: usize, e: usize, key: u8&, start_out: mutable i64&, end_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            start_out[0] <- -1
            end_out[0] <- -1
            key_len: usize = strlen(key)
            return false if key_len == 0
            while i + key_len < e |i: usize = s, e, line, key, key_len|:
                if Base::rh_bytes_equal_literal(line, i.i64(), (i + key_len).i64(), key):
                    before_ok: bool = i == s or line[i - 1] == 32 or line[i - 1] == 9 or line[i - 1] == 60 or line[i - 1] == 47
                    if before_ok:
                        j: mutable usize = i + key_len
                        while j < e and (line[j] == 32 or line[j] == 9) |j, e, line|:
                            j <- j + 1
                        if j < e and line[j] == 61:
                            j <- j + 1
                            while j < e and (line[j] == 32 or line[j] == 9) |j, e, line|:
                                j <- j + 1
                            return false if j >= e or (line[j] != 34 and line[j] != 39)
                            quote: u8 = line[j]
                            start_out[0] <- (j + 1).i64()
                            k: mutable usize = j + 1
                            while k < e and line[k] != quote |k, e, line, quote|:
                                k <- k + 1
                            return false if k >= e
                            end_out[0] <- k.i64()
                            return true
                i <- i + 1
            false

        def rh_nuget_version_exact(data: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e <= s
            digits: mutable i64 = 0
            while i < e |i: i64 = s, e, data, digits|:
                b: u8 = data[i.usize()]
                return false if b == 32 or b == 9 or b == 91 or b == 93 or b == 40 or b == 41 or b == 44 or b == 42 or b == 60 or b == 62 or b == 124
                digits <- 1 if b >= 48 and b <= 57
                i <- i + 1
            digits == 1

        # Parse the bounded NuGet `packages.config` format. Exact package versions
        # become resolved edges; range expressions and missing versions remain
        # explicit unresolved requirements. XML namespaces and package scripts are
        # outside this metadata-only subset and fail closed when malformed.
        def rh_nuget_parse(xml: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            root: i64 = rh_node_add(pkgs, RH_ECO_NUGET)
            return -1 if root != 0
            root_name: mutable darray[u8] = []
            Base::rh_push_text(root_name, "root")
            root_s: i64 = rh_pool_copy(pool, root_name, 0, root_name.count)
            root_node: mutable RhPkgNode = pkgs[0]
            root_node.name_s <- root_s
            root_node.name_e <- root_s + root_name.count.i64()
            root_node.src_kind <- RH_PSRC_UNKNOWN
            pkgs[0] <- root_node
            found: mutable i64 = 0
            while line_start <= xml.count |line_start: usize = 0, xml, pkgs, pool, reqs, edges, unresolved, unknown_out, found|:
                line_end: usize =
                    while j < xml.count and xml[j] != 10 |j: usize = line_start| -> j:
                        j <- j + 1
                s: mutable usize = line_start
                e: mutable usize = line_end
                while s < e and (xml[s] == 32 or xml[s] == 9 or xml[s] == 13) |s, e, xml|:
                    s <- s + 1
                while e > s and (xml[e - 1] == 32 or xml[e - 1] == 9 or xml[e - 1] == 13) |s, e, xml|:
                    e <- e - 1
                tag: mutable i64 = -1
                k: mutable usize = s
                while k + 8 < e |k, e, xml, tag|:
                    if xml[k] == 60 and Base::rh_bytes_equal_literal(xml, k.i64() + 1, k.i64() + 8, "package"):
                        after: u8 = xml[k + 8]
                        if after == 32 or after == 9 or after == 47 or after == 62:
                            tag <- k.i64()
                            break
                    k <- k + 1
                if tag >= 0:
                    return -1 if Base::rh_find_byte(xml, tag.usize(), 62) < 0
                    name_s: mutable i64 = -1
                    name_e: mutable i64 = -1
                    if not rh_nuget_attr(xml, s, e, "id", &name_s, &name_e):
                        return -1 if not rh_nuget_attr(xml, s, e, "Include", &name_s, &name_e)
                    return -1 if name_e <= name_s
                    ver_s: mutable i64 = -1
                    ver_e: mutable i64 = -1
                    _ = rh_nuget_attr(xml, s, e, "version", &ver_s, &ver_e)
                    if ver_s < 0:
                        _ = rh_nuget_attr(xml, s, e, "Version", &ver_s, &ver_e)
                    dev_s: mutable i64 = -1
                    dev_e: mutable i64 = -1
                    depctx: mutable u8 = RH_SCOPE_NORMAL
                    if rh_nuget_attr(xml, s, e, "developmentDependency", &dev_s, &dev_e) or rh_nuget_attr(xml, s, e, "DevelopmentDependency", &dev_s, &dev_e):
                        if dev_e - dev_s == 4 and xml[dev_s.usize()] == 116 and xml[(dev_s + 1).usize()] == 114 and xml[(dev_s + 2).usize()] == 117 and xml[(dev_s + 3).usize()] == 101:
                            depctx <- RH_SCOPE_DEV
                    nname: i64 = rh_pool_copy(pool, xml, name_s.usize(), name_e.usize())
                    nname_e: i64 = nname + (name_e - name_s)
                    req_ver_s: mutable i64 = -1
                    req_ver_e: mutable i64 = -1
                    if ver_s >= 0:
                        req_ver_s <- rh_pool_copy(pool, xml, ver_s.usize(), ver_e.usize())
                        req_ver_e <- req_ver_s + (ver_e - ver_s)
                    reqs.push(RhRequire{from: 0, name_s: nname, name_e: nname_e, ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: req_ver_s, req_e: req_ver_e, depctx: depctx})
                    if ver_s >= 0 and rh_nuget_version_exact(xml, ver_s, ver_e):
                        existing: mutable i64 = -1
                        while p < pkgs.count.i64() |p: i64 = 0, pkgs, pool, nname, nname_e, req_ver_s, req_ver_e|:
                            n: RhPkgNode = pkgs[p.usize()]
                            if n.eco == RH_ECO_NUGET and n.name_s >= 0 and rh_name_eq(RH_ECO_NUGET, pool, n.name_s.usize(), n.name_e.usize(), nname.usize(), nname_e.usize()):
                                if n.ver_s >= 0 and rh_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, req_ver_s.usize(), req_ver_e.usize()):
                                    existing <- p
                                    break
                            p <- p + 1
                        if existing < 0:
                            existing <- rh_node_add(pkgs, RH_ECO_NUGET)
                            return -1 if existing < 0
                            nd: mutable RhPkgNode = pkgs[existing.usize()]
                            nd.name_s <- nname
                            nd.name_e <- nname_e
                            nd.ver_s <- req_ver_s
                            nd.ver_e <- req_ver_e
                            nd.src_kind <- RH_PSRC_REGISTRY
                            nd.dev <- 1 if depctx == RH_SCOPE_DEV else 0
                            pkgs[existing.usize()] <- nd
                        edges.push(RhDepEdge{from: 0, dst: existing, depctx: depctx})
                    else:
                        unresolved.push(RhUnresolved{from: 0, name_s: nname, name_e: nname_e, req_s: req_ver_s, req_e: req_ver_e, reason: RH_UNRES_MISSING})
                    found <- found + 1
                line_start <- line_end + 1
            return -1 if found == 0
            0

        # Return one simple Maven XML tag value from a single bounded line. Nested
        # elements, entities, and multiline values are outside this metadata subset.
        def rh_maven_tag_value(line: darray[u8]&, s: usize, e: usize, tag: u8&, start_out: mutable i64&, end_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            start_out[0] <- -1
            end_out[0] <- -1
            n: usize = strlen(tag)
            return false if n == 0
            while i + n + 2 <= e |i: usize = s, e, line, tag, n|:
                if line[i] == 60 and line[i + 1] != 47 and Base::rh_bytes_equal_literal(line, (i + 1).i64(), (i + 1 + n).i64(), tag) and line[i + 1 + n] == 62:
                    value_s: mutable usize = i + n + 2
                    while value_s < e and (line[value_s] == 32 or line[value_s] == 9) |value_s, e, line|:
                        value_s <- value_s + 1
                    k: mutable usize = value_s
                    while k + n + 3 <= e |k, e, line, tag, n|:
                        if line[k] == 60 and line[k + 1] == 47 and Base::rh_bytes_equal_literal(line, (k + 2).i64(), (k + 2 + n).i64(), tag) and line[k + 2 + n] == 62:
                            value_e: mutable usize = k
                            while value_e > value_s and (line[value_e - 1] == 32 or line[value_e - 1] == 9) |value_e, value_s, line|:
                                value_e <- value_e - 1
                            return false if value_e <= value_s
                            start_out[0] <- value_s.i64()
                            end_out[0] <- value_e.i64()
                            return true
                        k <- k + 1
                i <- i + 1
            false

        def rh_maven_has_open(line: darray[u8]&, s: usize, e: usize, tag: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = strlen(tag)
            return false if n == 0
            while i + n + 2 <= e |i: usize = s, e, line, tag, n|:
                if line[i] == 60 and line[i + 1] != 47 and Base::rh_bytes_equal_literal(line, (i + 1).i64(), (i + 1 + n).i64(), tag):
                    after: u8 = line[i + 1 + n]
                    return true if after == 62 or after == 32 or after == 9 or after == 47
                i <- i + 1
            false

        def rh_maven_has_close(line: darray[u8]&, s: usize, e: usize, tag: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = strlen(tag)
            return false if n == 0
            while i + n + 3 <= e |i: usize = s, e, line, tag, n|:
                return true if line[i] == 60 and line[i + 1] == 47 and Base::rh_bytes_equal_literal(line, (i + 2).i64(), (i + 2 + n).i64(), tag) and line[i + 2 + n] == 62
                i <- i + 1
            false

        def rh_maven_coord(pool: mutable darray[u8]&, data: darray[u8]&, gs: usize, ge: usize, arts: usize, arte: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            start: i64 = pool.count.i64()
            while i < ge |i: usize = gs, ge, data, pool|:
                pool.push(data[i])
                i <- i + 1
            pool.push(58)
            while i < arte |i: usize = arts, arte, data, pool|:
                pool.push(data[i])
                i <- i + 1
            start

        def rh_maven_version_exact(data: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e <= s
            digits: mutable i64 = 0
            while i < e |i: i64 = s, e, data, digits|:
                b: u8 = data[i.usize()]
                return false if b == 32 or b == 9 or b == 91 or b == 93 or b == 40 or b == 41 or b == 44 or b == 42 or b == 60 or b == 62 or b == 124 or b == 36 or b == 123 or b == 125
                digits <- 1 if b >= 48 and b <= 57
                i <- i + 1
            digits == 1

        def rh_maven_add_dependency(xml: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, gs: i64, ge: i64, arts: i64, arte: i64, vs: i64, ve: i64, depctx: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if gs < 0 or ge <= gs or arts < 0 or arte <= arts
            name_s: i64 = rh_maven_coord(pool, xml, gs.usize(), ge.usize(), arts.usize(), arte.usize())
            name_e: i64 = pool.count.i64()
            req_s: mutable i64 = -1
            req_e: mutable i64 = -1
            if vs >= 0 and ve > vs:
                req_s <- rh_pool_copy(pool, xml, vs.usize(), ve.usize())
                req_e <- req_s + (ve - vs)
            reqs.push(RhRequire{from: 0, name_s: name_s, name_e: name_e, ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: req_s, req_e: req_e, depctx: depctx})
            if vs >= 0 and rh_maven_version_exact(xml, vs, ve):
                node: i64 = rh_node_add(pkgs, RH_ECO_MAVEN)
                return -1 if node < 0
                nd: mutable RhPkgNode = pkgs[node.usize()]
                nd.name_s <- name_s
                nd.name_e <- name_e
                nd.ver_s <- req_s
                nd.ver_e <- req_e
                nd.src_kind <- RH_PSRC_REGISTRY
                nd.optional <- 1 if depctx == RH_SCOPE_OPTIONAL else 0
                nd.dev <- 1 if depctx == RH_SCOPE_DEV else 0
                pkgs[node.usize()] <- nd
                edges.push(RhDepEdge{from: 0, dst: node, depctx: depctx})
            else:
                unresolved.push(RhUnresolved{from: 0, name_s: name_s, name_e: name_e, req_s: req_s, req_e: req_e, reason: RH_UNRES_MISSING})
            0

        # Parse the bounded Maven POM subset. Project and dependency coordinates use
        # `groupId:artifactId`; exact literal versions become root edges. Properties,
        # dependency management, profiles, and non-default repository resolution stay
        # explicit unresolved/unsupported instead of being evaluated.
        def rh_maven_parse(xml: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            unknown_out[0] <- 0
            root: i64 = rh_node_add(pkgs, RH_ECO_MAVEN)
            return -1 if root != 0
            project_gs: mutable i64 = -1
            project_ge: mutable i64 = -1
            project_as: mutable i64 = -1
            project_ae: mutable i64 = -1
            project_vs: mutable i64 = -1
            project_ve: mutable i64 = -1
            in_dep: mutable bool = false
            in_mgmt: mutable bool = false
            dep_gs: mutable i64 = -1
            dep_ge: mutable i64 = -1
            dep_as: mutable i64 = -1
            dep_ae: mutable i64 = -1
            dep_vs: mutable i64 = -1
            dep_ve: mutable i64 = -1
            dep_scope: mutable u8 = RH_SCOPE_NORMAL
            dep_optional: mutable bool = false
            line_start: mutable usize = 0
            while line_start <= xml.count |line_start, xml, pkgs, pool, reqs, edges, unresolved, unknown_out, project_gs, project_ge, project_as, project_ae, project_vs, project_ve, in_dep, in_mgmt, dep_gs, dep_ge, dep_as, dep_ae, dep_vs, dep_ve, dep_scope, dep_optional|:
                line_end: usize =
                    while j < xml.count and xml[j] != 10 |j: usize = line_start| -> j:
                        j <- j + 1
                s: mutable usize = line_start
                e: mutable usize = line_end
                while s < e and (xml[s] == 32 or xml[s] == 9 or xml[s] == 13) |s, e, xml|:
                    s <- s + 1
                while e > s and (xml[e - 1] == 32 or xml[e - 1] == 9 or xml[e - 1] == 13) |s, e, xml|:
                    e <- e - 1
                if rh_maven_has_open(xml, s, e, "dependencyManagement"):
                    in_mgmt <- true
                if rh_maven_has_close(xml, s, e, "dependencyManagement"):
                    in_mgmt <- false
                if rh_maven_has_open(xml, s, e, "dependency"):
                    return -1 if in_dep
                    in_dep <- true
                    dep_gs <- -1
                    dep_ge <- -1
                    dep_as <- -1
                    dep_ae <- -1
                    dep_vs <- -1
                    dep_ve <- -1
                    dep_scope <- RH_SCOPE_NORMAL
                    dep_optional <- false
                if rh_maven_has_close(xml, s, e, "dependency"):
                    return -1 if not in_dep
                    if not in_mgmt:
                        return -1 if rh_maven_add_dependency(xml, pkgs, pool, reqs, edges, unresolved, dep_gs, dep_ge, dep_as, dep_ae, dep_vs, dep_ve, dep_scope) != 0
                    in_dep <- false
                else:
                    ts: mutable i64 = -1
                    te: mutable i64 = -1
                    if in_dep:
                        if rh_maven_tag_value(xml, s, e, "groupId", &ts, &te):
                            dep_gs <- ts
                            dep_ge <- te
                        if rh_maven_tag_value(xml, s, e, "artifactId", &ts, &te):
                            dep_as <- ts
                            dep_ae <- te
                        if rh_maven_tag_value(xml, s, e, "version", &ts, &te):
                            dep_vs <- ts
                            dep_ve <- te
                        if rh_maven_tag_value(xml, s, e, "scope", &ts, &te):
                            dep_scope <- RH_SCOPE_DEV if rh_span_lit(xml, ts.usize(), te.usize(), "test") or rh_span_lit(xml, ts.usize(), te.usize(), "provided")
                        if rh_maven_tag_value(xml, s, e, "optional", &ts, &te):
                            dep_optional <- rh_span_lit(xml, ts.usize(), te.usize(), "true")
                            dep_scope <- RH_SCOPE_OPTIONAL if dep_optional
                    else:
                        if rh_maven_tag_value(xml, s, e, "groupId", &ts, &te):
                            project_gs <- ts
                            project_ge <- te
                        if rh_maven_tag_value(xml, s, e, "artifactId", &ts, &te):
                            project_as <- ts
                            project_ae <- te
                        if rh_maven_tag_value(xml, s, e, "version", &ts, &te):
                            project_vs <- ts
                            project_ve <- te
                line_start <- line_end + 1
            return -1 if in_dep or project_gs < 0 or project_as < 0
            root_name: i64 = rh_maven_coord(pool, xml, project_gs.usize(), project_ge.usize(), project_as.usize(), project_ae.usize())
            root_node: mutable RhPkgNode = pkgs[0]
            root_node.name_s <- root_name
            root_node.name_e <- pool.count.i64()
            if project_vs >= 0 and rh_maven_version_exact(xml, project_vs, project_ve):
                root_node.ver_s <- rh_pool_copy(pool, xml, project_vs.usize(), project_ve.usize())
                root_node.ver_e <- root_node.ver_s + (project_ve - project_vs)
            root_node.src_kind <- RH_PSRC_UNKNOWN
            pkgs[0] <- root_node
            0

        def rh_composer_is_platform(pool: darray[u8]&, ns: usize, ne: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if ne - ns == 3 and rh_name_eq_basic(pool, ns, ne, "php")
            return true if ne - ns >= 4 and rh_name_eq_basic(pool, ns, ns + 4, "ext-")
            return true if ne - ns >= 4 and rh_name_eq_basic(pool, ns, ns + 4, "lib-")
            return true if ne - ns >= 4 and rh_name_eq_basic(pool, ns, ns + 4, "php-")
            false

        def rh_composer_find_by_name(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool, ns, ne|:
                n: RhPkgNode = pkgs[i.usize()]
                if n.eco == RH_ECO_COMPOSER and n.name_s >= 0:
                    return i if rh_span_eq2(pool, n.name_s.usize(), n.name_e.usize(), pool, ns, ne)
                i <- i + 1
            -1

        def rh_name_eq_basic(pool: darray[u8]&, ns: usize, ne: usize, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(pool, ns.i64(), ne.i64(), lit)
