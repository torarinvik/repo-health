        def rh_deps_eco(code: i64) -> u8&:
            return "nuget" if code == 8
            return "npm" if code == 1
            return "pypi" if code == 2
            return "go" if code == 3
            return "rubygems" if code == 4
            return "composer" if code == 5
            return "nuget" if code == 6
            return "maven" if code == 7
            "cargo"

        def rh_deps_spec(code: i64) -> u8&:
            return "packages.lock.json" if code == 8
            return "package-lock.json" if code == 1
            return "requirements.txt" if code == 2
            return "go.mod" if code == 3
            return "Gemfile.lock" if code == 4
            return "composer.lock" if code == 5
            return "packages.config" if code == 6
            return "pom.xml" if code == 7
            "Cargo.lock"

        # Root of a Cargo.lock graph: the workspace/root package has no `source`
        # field (src_kind 3); registry/path/git packages do. Falls back to the
        # first in-degree-zero node, then 0 (bounded witnesses later fail closed).
        def rh_deps_cargo_root(pkgs: darray[RhPkgNode]&, edges: darray[RhDepEdge]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs|:
                n: RhPkgNode = pkgs[i.usize()]
                return i if n.src_kind == 3
                i <- i + 1
            while j < pkgs.count.i64() |j: i64 = 0, edges|:
                return j if rh_graph_in_count(edges, j) == 0
                j <- j + 1
            0

        def rh_emit_bool(buffer: mutable darray[u8]&, value: bool) -> void can[Memory.Allocate, Abort.Panic]:
            if value:
                Base::rh_push_text(buffer, "true")
            else:
                Base::rh_push_text(buffer, "false")

        # Canonical dependency graph JSON (rh-dep-graph/1) for goldens, bundles,
        # and the deps command. Witnesses computed from root (bounded).
        def rh_graph_write_json(out: mutable darray[u8]&, eco: u8, pkgs: darray[RhPkgNode]&, pool: darray[u8]&, artifacts: darray[RhArtifact]&, edges: darray[RhDepEdge]&, unresolved: darray[RhUnresolved]&, findings: darray[RhAdvisory]&, advtexts: darray[u8]&, root: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if eco == 0:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"cargo\",\"nodes\":[")
            elif eco == 2:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"pypi\",\"nodes\":[")
            elif eco == 3:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"go\",\"nodes\":[")
            elif eco == 4:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"rubygems\",\"nodes\":[")
            elif eco == 5:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"composer\",\"nodes\":[")
            elif eco == 6:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"nuget\",\"nodes\":[")
            elif eco == 7:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"maven\",\"nodes\":[")
            else:
                Base::rh_push_text(out, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"npm\",\"nodes\":[")
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool, out|:
                n: RhPkgNode = pkgs[i.usize()]
                if i > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"id\":")
                Base::rh_push_decimal_i64(out, i)
                Base::rh_push_text(out, ",\"name\":\"")
                Base::rh_json_escape(out, pool, n.name_s.usize(), n.name_e.usize())
                Base::rh_push_text(out, "\",\"version\":")
                if n.ver_s < 0:
                    Base::rh_push_text(out, "null")
                else:
                    Base::rh_push_text(out, "\"")
                    Base::rh_json_escape(out, pool, n.ver_s.usize(), n.ver_e.usize())
                    Base::rh_push_text(out, "\"")
                Base::rh_push_text(out, ",\"source\":\"")
                Base::rh_push_text(out, rh_src_label(n.src_kind))
                out.push(34)
                if n.origin_s >= 0:
                    origin_start: mutable usize = n.origin_s.usize()
                    origin_end: mutable usize = n.origin_e.usize()
                    source_identity: mutable darray[u8] = |pool, origin_start, origin_end|
                        source_bytes: mutable darray[u8] = []
                        while source_pos < origin_end |source_pos: usize = origin_start, pool, source_bytes, origin_end|:
                            source_bytes.push(pool[source_pos])
                            source_pos <- source_pos + 1
                        source_hash: mutable darray[u8] = []
                        Sha256::rh_sha256(source_bytes, source_hash)
                        source_hash
                    Base::rh_push_text(out, ",\"source_identity_sha256\":\"")
                    out.extend(bytes_view(source_identity))
                    out.push(34)
                Base::rh_push_text(out, ",\"digest\":")
                rh_emit_bool(out, n.has_digest != 0)
                Base::rh_push_text(out, ",\"dev\":")
                rh_emit_bool(out, n.dev != 0)
                Base::rh_push_text(out, ",\"optional\":")
                rh_emit_bool(out, n.optional != 0)
                if n.framework_s >= 0:
                    Base::rh_push_text(out, ",\"target_framework\":\"")
                    Base::rh_json_escape(out, pool, n.framework_s.usize(), n.framework_e.usize())
                    out.push(34)
                Base::rh_push_text(out, "}")
                i <- i + 1
            Base::rh_push_text(out, "],\"artifacts\":[")
            while a < artifacts.count.i64() |a: i64 = 0, artifacts, pool, out|:
                artifact: RhArtifact = artifacts[a.usize()]
                if a > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"id\":")
                Base::rh_push_decimal_i64(out, a)
                Base::rh_push_text(out, ",\"package_node\":")
                Base::rh_push_decimal_i64(out, artifact.package_node)
                Base::rh_push_text(out, ",\"kind\":\"")
                Base::rh_push_text(out, rh_artifact_kind_label(artifact.kind))
                Base::rh_push_text(out, "\",\"expected_digest\":")
                if artifact.expected_s < 0:
                    Base::rh_push_text(out, "null")
                else:
                    Base::rh_push_text(out, "\"")
                    Base::rh_json_escape(out, pool, artifact.expected_s.usize(), artifact.expected_e.usize())
                    Base::rh_push_text(out, "\"")
                Base::rh_push_text(out, ",\"observed_digest\":")
                if artifact.observed_s < 0:
                    Base::rh_push_text(out, "null")
                else:
                    Base::rh_push_text(out, "\"")
                    Base::rh_json_escape(out, pool, artifact.observed_s.usize(), artifact.observed_e.usize())
                    Base::rh_push_text(out, "\"")
                Base::rh_push_text(out, ",\"identity_state\":\"")
                Base::rh_push_text(out, rh_artifact_state_label(rh_artifact_identity_state(artifacts, pool, a)))
                Base::rh_push_text(out, "\"}")
                a <- a + 1
            Base::rh_push_text(out, "],\"edges\":[")
            while e < edges.count.i64() |e: i64 = 0, edges, out|:
                ed: RhDepEdge = edges[e.usize()]
                if e > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"from\":")
                Base::rh_push_decimal_i64(out, ed.from)
                Base::rh_push_text(out, ",\"to\":")
                Base::rh_push_decimal_i64(out, ed.dst)
                Base::rh_push_text(out, ",\"scope\":\"")
                Base::rh_push_text(out, rh_scope_label(ed.depctx))
                out.push(34)
                if ed.optional != 0:
                    Base::rh_push_text(out, ",\"optional\":true")
                out.push(125)
                e <- e + 1
            Base::rh_push_text(out, "],\"unresolved\":[")
            while u < unresolved.count.i64() |u: i64 = 0, unresolved, pool, out|:
                ur: RhUnresolved = unresolved[u.usize()]
                if u > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"from\":")
                Base::rh_push_decimal_i64(out, ur.from)
                Base::rh_push_text(out, ",\"name\":\"")
                Base::rh_json_escape(out, pool, ur.name_s.usize(), ur.name_e.usize())
                Base::rh_push_text(out, "\",\"requirement\":")
                if ur.req_s < 0:
                    Base::rh_push_text(out, "null")
                else:
                    Base::rh_push_text(out, "\"")
                    Base::rh_json_escape(out, pool, ur.req_s.usize(), ur.req_e.usize())
                    Base::rh_push_text(out, "\"")
                Base::rh_push_text(out, ",\"reason\":\"")
                Base::rh_push_text(out, rh_unres_label(ur.reason))
                out.push(34)
                if ur.optional != 0:
                    Base::rh_push_text(out, ",\"optional\":true")
                out.push(125)
                u <- u + 1
            Base::rh_push_text(out, "],\"advisories\":[")
            while f < findings.count.i64() |f: i64 = 0, findings, advtexts, out, edges, pkgs, root|:
                fa: RhAdvisory = findings[f.usize()]
                if f > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"advisory\":\"")
                Base::rh_json_escape(out, advtexts, fa.adv_s.usize(), fa.adv_e.usize())
                Base::rh_push_text(out, "\",\"node\":")
                Base::rh_push_decimal_i64(out, fa.node)
                Base::rh_push_text(out, ",\"fixed\":")
                if fa.fix_s < 0:
                    Base::rh_push_text(out, "null")
                else:
                    Base::rh_push_text(out, "\"")
                    Base::rh_json_escape(out, advtexts, fa.fix_s.usize(), fa.fix_e.usize())
                    Base::rh_push_text(out, "\"")
                Base::rh_push_text(out, ",\"aliases\":")
                Base::rh_push_decimal_i64(out, fa.alias_count)
                Base::rh_push_text(out, ",\"witness\":[")
                wit: mutable darray[i64] = []
                wl: i64 = rh_graph_witness(edges, pkgs.count.i64(), root, fa.node, 32, wit)
                if wl > 0:
                    while w < wit.count |w: usize = 0, wit, out|:
                        if w > 0:
                            out.push(44)
                        Base::rh_push_decimal_i64(out, wit[w])
                        w <- w + 1
                Base::rh_push_text(out, "]}")
                f <- f + 1
            Base::rh_push_text(out, "]}")

        # --- RubyGems Gemfile.lock (M08 ecosystems lane) ----------------------
        # Gemfile.lock is indentation-structured text, not JSON: a Gemfile is a
        # `~>`-style resolved lock, so the pinned `specs:` entries ARE resolution
        # evidence, while the `DEPENDENCIES` block is the declared-requirement
        # side and never silently becomes an edge (R009). A spec's nested
        # dependencies (6-space indent) become edges from that spec; the root
        # package is the synthetic project node. Platform-suffixed versions
        # (e.g. `nokogiri (1.15.0-x86_64-linux)`) are kept verbatim as the
        # version label — a label is not a digest (M03-02). GIT/PATH sections
        # mark source kind so a registry gem is never confused with a checkout.
        const RH_GEMSEC_NONE: u8 = 0
        const RH_GEMSEC_GEM: u8 = 1
        const RH_GEMSEC_GIT: u8 = 2
        const RH_GEMSEC_PATH: u8 = 3
        const RH_GEMSEC_DEPS: u8 = 4
        const RH_GEMSEC_OTHER: u8 = 5

        def rh_gem_indent(buf: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < e |i: i64 = s, n: i64 = 0| -> n:
                break if buf[i.usize()] != 32
                n <- n + 1
                i <- i + 1

        def rh_gem_trim(buf: darray[u8]&, s: i64, e: i64, ts: mutable i64&, te: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            a: mutable i64 =
                while a < e and (buf[a.usize()] == 32 or buf[a.usize()] == 9) |a: i64 = s| -> a:
                    a <- a + 1
            b: i64 =
                while b > a and (buf[(b - 1).usize()] == 32 or buf[(b - 1).usize()] == 9 or buf[(b - 1).usize()] == 13) |b: i64 = e, a| -> b:
                    b <- b - 1
            ts[0] <- a
            te[0] <- b
            return

        def rh_gem_section(buf: darray[u8]&, ts: i64, te: i64) -> u8 can[Memory.Allocate, Abort.Panic]:
            return RH_GEMSEC_NONE if ts >= te
            if ts + 3 <= te and buf[ts.usize()] == 71 and buf[(ts + 1).usize()] == 69 and buf[(ts + 2).usize()] == 77:
                return RH_GEMSEC_GEM if ts + 3 == te
            if ts + 3 <= te and buf[ts.usize()] == 71 and buf[(ts + 1).usize()] == 73 and buf[(ts + 2).usize()] == 84:
                return RH_GEMSEC_GIT if ts + 3 == te
            if ts + 4 <= te and buf[ts.usize()] == 80 and buf[(ts + 1).usize()] == 65 and buf[(ts + 2).usize()] == 84 and buf[(ts + 3).usize()] == 72:
                return RH_GEMSEC_PATH if ts + 4 == te
            return RH_GEMSEC_DEPS if ts + 11 <= te and rh_gem_word(buf, ts, te, "DEPENDENCIES")
            RH_GEMSEC_OTHER

        def rh_gem_word(buf: darray[u8]&, ts: i64, te: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if te - ts != Base::rh_cstr_len(lit)
            while ts + i < te |i: i64 = 0, ts, te, buf, lit|:
                b: u8 = buf[(ts + i).usize()]
                c: u8 = lit[i.usize()]
                return false if b != c
                i <- i + 1
            true

        # Parse `name (version)` / `name` -> name span + optional version span.
        def rh_gem_spec_split(buf: darray[u8]&, s: i64, e: i64, ns: mutable i64&, ne: mutable i64&, vs: mutable i64&, ve: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            ns[0] <- s
            ne[0] <- s
            vs[0] <- -1
            ve[0] <- -1
            a: mutable i64 =
                while a < e and (buf[a.usize()] == 32 or buf[a.usize()] == 9) |a: i64 = s| -> a:
                    a <- a + 1
            b: mutable i64 =
                while b < e and buf[b.usize()] != 32 and buf[b.usize()] != 9 |b: i64 = a| -> b:
                    b <- b + 1
            ns[0] <- a
            ne[0] <- b
            c: mutable i64 =
                while c < e and (buf[c.usize()] == 32 or buf[c.usize()] == 9) |c: i64 = b| -> c:
                    c <- c + 1
            if c < e and buf[c.usize()] == 40:
                d: i64 =
                    while d < e and buf[d.usize()] != 41 |d: i64 = c + 1| -> d:
                        d <- d + 1
                if d > c + 1:
                    vs[0] <- c + 1
                    ve[0] <- d
            return

        def rh_gem_find(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize, vs: usize, ve: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool, ns, ne, vs, ve|:
                n: RhPkgNode = pkgs[i.usize()]
                if n.eco == RH_ECO_RUBYGEMS and n.name_s >= 0 and n.ver_s >= 0:
                    if rh_span_eq2(pool, n.name_s.usize(), n.name_e.usize(), pool, ns, ne):
                        return i if rh_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, vs, ve)
                i <- i + 1
            -1

        def rh_gemfile_parse(buf: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            rroot: i64 = rh_node_add(pkgs, RH_ECO_RUBYGEMS)
            return -1 if rroot != 0
            rn: mutable darray[u8] = []
            Base::rh_push_text(rn, "root")
            rns: i64 = rh_pool_copy(pool, rn, 0, rn.count)
            rnode: mutable RhPkgNode = pkgs[0]
            rnode.name_s <- rns
            rnode.name_e <- rns + rn.count.i64()
            rnode.src_kind <- 3
            pkgs[0] <- rnode
            while true |sec: u8 = RH_GEMSEC_NONE, subsrc: u8 = RH_PSRC_REGISTRY, in_specs: i64 = 0, last_spec: i64 = -1, pos: i64 = 0, buf, pkgs, pool, reqs, edges, unresolved, unknown_out|:
                break if pos >= buf.count.i64()
                le: i64 =
                    while le < buf.count.i64() and buf[le.usize()] != 10 |le: i64 = pos| -> le:
                        le <- le + 1
                ind: i64 = rh_gem_indent(buf, pos, le)
                ts: mutable i64 = 0
                te: mutable i64 = 0
                rh_gem_trim(buf, pos, le, &ts, &te)
                if te > ts:
                    if ind == 0:
                        sec <- rh_gem_section(buf, ts, te)
                        if sec == RH_GEMSEC_GIT:
                            subsrc <- RH_PSRC_GIT
                        elif sec == RH_GEMSEC_PATH:
                            subsrc <- RH_PSRC_PATH
                        elif sec == RH_GEMSEC_GEM:
                            subsrc <- RH_PSRC_REGISTRY
                        in_specs <- 0
                        last_spec <- -1
                    elif sec == RH_GEMSEC_GEM or sec == RH_GEMSEC_GIT or sec == RH_GEMSEC_PATH:
                        if ind == 2:
                            # `remote:` / `specs:` / `revision:` / `branch:` metadata
                            if rh_gem_word(buf, ts, te, "specs:"):
                                in_specs <- 1
                            else:
                                unknown_out[0] <- unknown_out[0] + 1
                        elif in_specs == 1 and ind >= 4:
                            if ind == 4:
                                last_spec <- rh_gem_add_spec(buf, ts, te, pkgs, pool, subsrc)
                            elif ind == 6 and last_spec >= 0:
                                rh_gem_add_dep(buf, ts, te, pool, reqs, last_spec)
                            else:
                                unknown_out[0] <- unknown_out[0] + 1
                        else:
                            unknown_out[0] <- unknown_out[0] + 1
                    elif sec == RH_GEMSEC_DEPS:
                        if ind == 2:
                            rh_gem_add_require(buf, ts, te, pool, reqs, RH_SCOPE_DECLARED)
                        else:
                            unknown_out[0] <- unknown_out[0] + 1
                    else:
                        unknown_out[0] <- unknown_out[0] + 1
                pos <- le + 1
            # Resolve every recorded requirement (root DEPENDENCIES and nested spec
            # deps alike) against the full spec set: a requirement names a locked
            # spec -> edge; otherwise it stays an explicit unresolved entry and is
            # NEVER a guessed edge (R009).
            while i < reqs.count.i64() |i: i64 = 0, reqs, pkgs, pool, edges, unresolved|:
                q: RhRequire = reqs[i.usize()]
                if q.name_s >= 0:
                    hit: i64 = rh_gem_find_by_name(pkgs, pool, q.name_s.usize(), q.name_e.usize())
                    if hit >= 0:
                        edges.push(RhDepEdge{from: q.from, dst: hit, depctx: q.depctx, optional: 0})
                    else:
                        unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.req_s, req_e: q.req_e, reason: 0, optional: 0})
                i <- i + 1
            0

        def rh_gem_add_spec(buf: darray[u8]&, ts: i64, te: i64, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, skind: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            ns: mutable i64 = 0
            ne: mutable i64 = 0
            vs: mutable i64 = 0
            ve: mutable i64 = 0
            rh_gem_spec_split(buf, ts, te, &ns, &ne, &vs, &ve)
            if ne <= ns:
                return -1
            # Copy into the pool FIRST: rh_gem_find compares pool spans, so handing
            # it buf-relative offsets would compare the wrong bytes (and can trap
            # out of bounds when lengths coincide by accident).
            cname_s: i64 = rh_pool_copy(pool, buf, ns.usize(), ne.usize())
            cname_e: i64 = cname_s + (ne - ns)
            cver_s: mutable i64 = -1
            cver_e: mutable i64 = -1
            if vs >= 0:
                cver_s <- rh_pool_copy(pool, buf, vs.usize(), ve.usize())
                cver_e <- cver_s + (ve - vs)
            existing: mutable i64 = rh_gem_find(pkgs, pool, cname_s.usize(), cname_e.usize(), cver_s.usize(), cver_e.usize()) if vs >= 0 else -1
            if existing < 0:
                existing <- rh_node_add(pkgs, RH_ECO_RUBYGEMS)
                return -1 if existing < 0
                nd: mutable RhPkgNode = pkgs[existing.usize()]
                nd.name_s <- cname_s
                nd.name_e <- cname_e
                if vs >= 0:
                    nd.ver_s <- cver_s
                    nd.ver_e <- cver_e
                nd.src_kind <- skind
                pkgs[existing.usize()] <- nd
            existing

        def rh_gem_find_by_name(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool, ns, ne|:
                n: RhPkgNode = pkgs[i.usize()]
                if n.eco == RH_ECO_RUBYGEMS and n.name_s >= 0:
                    return i if rh_span_eq2(pool, n.name_s.usize(), n.name_e.usize(), pool, ns, ne)
                i <- i + 1
            -1

        def rh_gem_add_dep(buf: darray[u8]&, ts: i64, te: i64, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, from: i64) -> void can[Memory.Allocate, Abort.Panic]:
            ns: mutable i64 = 0
            ne: mutable i64 = 0
            vs: mutable i64 = 0
            ve: mutable i64 = 0
            rh_gem_spec_split(buf, ts, te, &ns, &ne, &vs, &ve)
            if ne <= ns:
                return
            # Record the nested dependency as a requirement from the spec node; the
            # caller resolves it AFTER every spec is known, so a forward reference
            # (a spec whose dependency appears later in the file) still resolves.
            name_s: i64 = rh_pool_copy(pool, buf, ns.usize(), ne.usize())
            rhs: mutable i64 = -1
            rhe: mutable i64 = -1
            if vs >= 0:
                rhs <- rh_pool_copy(pool, buf, vs.usize(), ve.usize())
                rhe <- rhs + (ve - vs)
            reqs.push(RhRequire{from: from, name_s: name_s, name_e: name_s + (ne - ns), ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: rhs, req_e: rhe, depctx: 0, optional: 0})
            return

        def rh_gem_add_require(buf: darray[u8]&, ts: i64, te: i64, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, depctx: u8) -> void can[Memory.Allocate, Abort.Panic]:
            ns: mutable i64 = 0
            ne: mutable i64 = 0
            vs: mutable i64 = 0
            ve: mutable i64 = 0
            rh_gem_spec_split(buf, ts, te, &ns, &ne, &vs, &ve)
            return if ne <= ns
            name_s: i64 = rh_pool_copy(pool, buf, ns.usize(), ne.usize())
            rhs: mutable i64 = -1
            rhe: mutable i64 = -1
            if vs >= 0:
                rhs <- rh_pool_copy(pool, buf, vs.usize(), ve.usize())
                rhe <- rhs + (ve - vs)
            reqs.push(RhRequire{from: 0, name_s: name_s, name_e: name_s + (ne - ns), ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: rhs, req_e: rhe, depctx: depctx, optional: 0})
            return

        # --- Composer composer.lock (M08 ecosystems lane) ---------------------
        # composer.lock is JSON with `packages` (runtime) and `packages-dev`
        # arrays; each entry has a vendor/package `name`, a `version` (native
        # Composer spelling, often with a leading `v` and stability suffixes) and
        # a `require` map whose values are Composer constraint expressions. The
        # locked entries ARE resolution evidence; the `require` map is the
        # declared-requirement side and becomes an edge only to an exactly-locked
        # name (R009). Platform requirements (`php`, `ext-*`, `lib-*`) are kept
        # as explicit context requirements, never as package edges. The root is
        # the synthetic project node; `require-dev` on a package marks the dev
        # scope so a test-only dependency is never reported as runtime.
        def rh_composer_add_pkg(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, reqs: mutable darray[RhRequire]&, entry: i64, depctx: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            namev: i64 = Json::rh_json_obj_get(jnodes, texts, entry, "name")
            ns: mutable i64 = -1
            ne: mutable i64 = -1
            return -1 if not Json::rh_json_str_span(jnodes, namev, &ns, &ne)
            verv: i64 = Json::rh_json_obj_get(jnodes, texts, entry, "version")
            vs: mutable i64 = -1
            ve: mutable i64 = -1
            has_ver: mutable bool = Json::rh_json_str_span(jnodes, verv, &vs, &ve)
            pname_s: i64 = rh_pool_copy(pool, texts, ns.usize(), ne.usize())
            pname_e: i64 = pname_s + (ne - ns)
            pver_s: mutable i64 = -1
            pver_e: mutable i64 = -1
            if has_ver:
                pver_s <- rh_pool_copy(pool, texts, vs.usize(), ve.usize())
                pver_e <- pver_s + (ve - vs)
            idx: mutable i64 = rh_composer_find(pkgs, pool, pname_s.usize(), pname_e.usize(), pver_s, pver_e)
            if idx < 0:
                idx <- rh_node_add(pkgs, RH_ECO_COMPOSER)
                return -1 if idx < 0
                nd: mutable RhPkgNode = pkgs[idx.usize()]
                nd.name_s <- pname_s
                nd.name_e <- pname_e
                if has_ver:
                    nd.ver_s <- pver_s
                    nd.ver_e <- pver_e
                nd.src_kind <- 0
                nd.dev <- depctx
                pkgs[idx.usize()] <- nd
            reqv: i64 = Json::rh_json_obj_get(jnodes, texts, entry, "require")
            if reqv >= 0:
                _ = rh_npm_req_map(jnodes, pool, texts, texts, reqv, idx, depctx, -1, reqs)
            idx

        def rh_composer_find(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize, vs: i64, ve: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool, ns, ne, vs, ve|:
                n: RhPkgNode = pkgs[i.usize()]
                if n.eco == RH_ECO_COMPOSER and n.name_s >= 0:
                    if rh_span_eq2(pool, n.name_s.usize(), n.name_e.usize(), pool, ns, ne):
                        return i if vs < 0 and n.ver_s < 0
                        if vs >= 0 and n.ver_s >= 0:
                            return i if rh_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, vs.usize(), ve.usize())
                i <- i + 1
            -1

        def rh_composer_parse(lock: darray[u8]&, jnodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            _ = lock
            return -1 if jnodes.count.i64() == 0
            rroot: i64 = rh_node_add(pkgs, RH_ECO_COMPOSER)
            return -1 if rroot != 0
            rn: mutable darray[u8] = []
            Base::rh_push_text(rn, "root")
            rns: i64 = rh_pool_copy(pool, rn, 0, rn.count)
            rnode: mutable RhPkgNode = pkgs[0]
            rnode.name_s <- rns
            rnode.name_e <- rns + rn.count.i64()
            rnode.src_kind <- 3
            pkgs[0] <- rnode
            # runtime packages then dev packages
            pa: i64 = Json::rh_json_obj_get(jnodes, texts, 0, "packages")
            rh_composer_add_array(jnodes, pool, texts, pkgs, reqs, pa, 0)
            pda: i64 = Json::rh_json_obj_get(jnodes, texts, 0, "packages-dev")
            rh_composer_add_array(jnodes, pool, texts, pkgs, reqs, pda, 1)
            # Resolve every recorded requirement (root and package `require` maps)
            # against the locked package set: a requirement that names a locked
            # vendor/package becomes an edge from its requiring node; a platform
            # requirement (php/ext-*/lib-*/php-*) stays context; anything else is
            # explicit unresolved. Never a guessed edge (R009).
            while i < reqs.count.i64() |i: i64 = 0, reqs, pkgs, pool, edges, unresolved|:
                q: RhRequire = reqs[i.usize()]
                if q.name_s >= 0:
                    if rh_composer_is_platform(pool, q.name_s.usize(), q.name_e.usize()):
                        unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.req_s, req_e: q.req_e, reason: 2, optional: 0})
                    else:
                        hit: i64 = rh_composer_find_by_name(pkgs, pool, q.name_s.usize(), q.name_e.usize())
                        if hit >= 0:
                            edges.push(RhDepEdge{from: q.from, dst: hit, depctx: q.depctx, optional: 0})
                        else:
                            unresolved.push(RhUnresolved{from: q.from, name_s: q.name_s, name_e: q.name_e, req_s: q.req_s, req_e: q.req_e, reason: 0, optional: 0})
                i <- i + 1
            0

        def rh_composer_add_array(jnodes: darray[Json::RhJsonNode]&, pool: mutable darray[u8]&, texts: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, reqs: mutable darray[RhRequire]&, arr: i64, depctx: u8) -> void can[Memory.Allocate, Abort.Panic]:
            return if arr < 0
            a: Json::RhJsonNode = jnodes[arr.usize()]
            return if a.kind != 4
            while child >= 0 |child: i64 = a.first_child, jnodes, pool, texts, pkgs, reqs, depctx|:
                _ = rh_composer_add_pkg(jnodes, pool, texts, pkgs, reqs, child, depctx)
                child <- jnodes[child.usize()].next_sibling
            return

        # Read one XML attribute from a bounded packages.config line. Attribute names
        # are matched exactly; both quote styles are accepted and decoded values stay
        # in the caller-owned source buffer.
        # (private to this file)
        def rh_nuget_attr(line: darray[u8]&, s: usize, e: usize, key: u8&, start_out: mutable i64&, end_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            start_out[0] <- -1
            end_out[0] <- -1
            key_len: usize = strlen(key)
            return false if key_len == 0
            while i + key_len < e |i: usize = s, e, line, key, key_len|:
                if Base::rh_bytes_equal_literal(line, i.i64(), (i + key_len).i64(), key):
                    before_ok: bool = i == s or line[i - 1] == 32 or line[i - 1] == 9 or line[i - 1] == 60 or line[i - 1] == 47
                    if before_ok:
                        j: mutable usize = i + key_len
                        while j < e and (line[j] == 32 or line[j] == 9) |j, e, line|:
                            j <- j + 1
                        if j < e and line[j] == 61:
                            j <- j + 1
                            while j < e and (line[j] == 32 or line[j] == 9) |j, e, line|:
                                j <- j + 1
                            return false if j >= e or (line[j] != 34 and line[j] != 39)
                            quote: u8 = line[j]
                            value_start: usize = j + 1
                            k: usize =
                                while k < e and line[k] != quote |k: usize = value_start| -> k:
                                    k <- k + 1
                            return false if k >= e
                            start_out[0] <- value_start.i64()
                            end_out[0] <- k.i64()
                            return true
                i <- i + 1
            false

        def rh_nuget_version_exact(data: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e <= s
            digits: mutable i64 = 0
            while i < e |i: i64 = s, e, data, digits|:
                b: u8 = data[i.usize()]
                return false if b == 32 or b == 9 or b == 91 or b == 93 or b == 40 or b == 41 or b == 44 or b == 42 or b == 60 or b == 62 or b == 124
                digits <- 1 if b >= 48 and b <= 57
                i <- i + 1
            digits == 1

        # Attribute scanning can find a quote belonging to the next attribute
        # when hostile XML omits a closing quote. Reject malformed package IDs
        # before copying their spans into the graph pool.
        def rh_nuget_id_valid(data: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e <= s or e > data.count.i64()
            while i < e |i: i64 = s, e, data|:
                b: u8 = data[i.usize()]
                return false if b <= 32 or b == 34 or b == 39 or b == 60 or b == 61 or b == 62
                i <- i + 1
            true

        # Parse the bounded NuGet `packages.config` format. Exact package versions
        # become resolved edges; range expressions and missing versions remain
        # explicit unresolved requirements. XML namespaces and package scripts are
        # outside this metadata-only subset and fail closed when malformed.
        def rh_nuget_parse(xml: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            root: i64 = rh_node_add(pkgs, RH_ECO_NUGET)
            return -1 if root != 0
            root_name: mutable darray[u8] = []
            Base::rh_push_text(root_name, "root")
            root_s: i64 = rh_pool_copy(pool, root_name, 0, root_name.count)
            root_node: mutable RhPkgNode = pkgs[0]
            root_node.name_s <- root_s
            root_node.name_e <- root_s + root_name.count.i64()
            root_node.src_kind <- RH_PSRC_UNKNOWN
            pkgs[0] <- root_node
            found: mutable i64 = 0
            while line_start <= xml.count |line_start: usize = 0, xml, pkgs, pool, reqs, edges, unresolved, unknown_out, found|:
                line_end: usize =
                    while j < xml.count and xml[j] != 10 |j: usize = line_start| -> j:
                        j <- j + 1
                s: mutable usize = line_start
                e: mutable usize = line_end
                while s < e and (xml[s] == 32 or xml[s] == 9 or xml[s] == 13) |s, e, xml|:
                    s <- s + 1
                while e > s and (xml[e - 1] == 32 or xml[e - 1] == 9 or xml[e - 1] == 13) |s, e, xml|:
                    e <- e - 1
                tag: mutable i64 = -1
                k: mutable usize = s
                while k + 8 < e |k, e, xml, tag|:
                    if xml[k] == 60 and Base::rh_bytes_equal_literal(xml, k.i64() + 1, k.i64() + 8, "package"):
                        after: u8 = xml[k + 8]
                        if after == 32 or after == 9 or after == 47 or after == 62:
                            tag <- k.i64()
                            break
                    k <- k + 1
                if tag >= 0:
                    return -1 if Base::rh_find_byte(xml, tag.usize(), 62) < 0
                    name_s: mutable i64 = -1
                    name_e: mutable i64 = -1
                    if not rh_nuget_attr(xml, s, e, "id", &name_s, &name_e):
                        return -1 if not rh_nuget_attr(xml, s, e, "Include", &name_s, &name_e)
                    return -1 if name_e <= name_s
                    return -1 if not rh_nuget_id_valid(xml, name_s, name_e)
                    ver_s: mutable i64 = -1
                    ver_e: mutable i64 = -1
                    _ = rh_nuget_attr(xml, s, e, "version", &ver_s, &ver_e)
                    if ver_s < 0:
                        _ = rh_nuget_attr(xml, s, e, "Version", &ver_s, &ver_e)
                    dev_s: mutable i64 = -1
                    dev_e: mutable i64 = -1
                    depctx: mutable u8 = RH_SCOPE_NORMAL
                    if rh_nuget_attr(xml, s, e, "developmentDependency", &dev_s, &dev_e) or rh_nuget_attr(xml, s, e, "DevelopmentDependency", &dev_s, &dev_e):
                        if dev_e - dev_s == 4 and xml[dev_s.usize()] == 116 and xml[(dev_s + 1).usize()] == 114 and xml[(dev_s + 2).usize()] == 117 and xml[(dev_s + 3).usize()] == 101:
                            depctx <- RH_SCOPE_DEV
                    nname: i64 = rh_pool_copy(pool, xml, name_s.usize(), name_e.usize())
                    nname_e: i64 = nname + (name_e - name_s)
                    req_ver_s: mutable i64 = -1
                    req_ver_e: mutable i64 = -1
                    if ver_s >= 0:
                        req_ver_s <- rh_pool_copy(pool, xml, ver_s.usize(), ver_e.usize())
                        req_ver_e <- req_ver_s + (ver_e - ver_s)
                    reqs.push(RhRequire{from: 0, name_s: nname, name_e: nname_e, ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: req_ver_s, req_e: req_ver_e, depctx: depctx, optional: 0})
                    if ver_s >= 0 and rh_nuget_version_exact(xml, ver_s, ver_e):
                        existing: mutable i64 = -1
                        while p < pkgs.count.i64() |p: i64 = 0, pkgs, pool, nname, nname_e, req_ver_s, req_ver_e|:
                            n: RhPkgNode = pkgs[p.usize()]
                            if n.eco == RH_ECO_NUGET and n.name_s >= 0 and rh_name_eq(RH_ECO_NUGET, pool, n.name_s.usize(), n.name_e.usize(), nname.usize(), nname_e.usize()):
                                if n.ver_s >= 0 and rh_span_eq2(pool, n.ver_s.usize(), n.ver_e.usize(), pool, req_ver_s.usize(), req_ver_e.usize()):
                                    existing <- p
                                    break
                            p <- p + 1
                        if existing < 0:
                            existing <- rh_node_add(pkgs, RH_ECO_NUGET)
                            return -1 if existing < 0
                            nd: mutable RhPkgNode = pkgs[existing.usize()]
                            nd.name_s <- nname
                            nd.name_e <- nname_e
                            nd.ver_s <- req_ver_s
                            nd.ver_e <- req_ver_e
                            nd.src_kind <- RH_PSRC_REGISTRY
                            nd.dev <- 1 if depctx == RH_SCOPE_DEV else 0
                            pkgs[existing.usize()] <- nd
                        edges.push(RhDepEdge{from: 0, dst: existing, depctx: depctx, optional: 0})
                    else:
                        unresolved.push(RhUnresolved{from: 0, name_s: nname, name_e: nname_e, req_s: req_ver_s, req_e: req_ver_e, reason: RH_UNRES_MISSING, optional: 0})
                    found <- found + 1
                line_start <- line_end + 1
            return -1 if found == 0
            0

        # Return one simple Maven XML tag value from a single bounded line. Nested
        # elements, entities, and multiline values are outside this metadata subset.
        def rh_maven_tag_value(line: darray[u8]&, s: usize, e: usize, tag: u8&, start_out: mutable i64&, end_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            start_out[0] <- -1
            end_out[0] <- -1
            n: usize = strlen(tag)
            return false if n == 0
            while i + n + 2 <= e |i: usize = s, e, line, tag, n|:
                if line[i] == 60 and line[i + 1] != 47 and Base::rh_bytes_equal_literal(line, (i + 1).i64(), (i + 1 + n).i64(), tag) and line[i + 1 + n] == 62:
                    value_s: mutable usize = i + n + 2
                    while value_s < e and (line[value_s] == 32 or line[value_s] == 9) |value_s, e, line|:
                        value_s <- value_s + 1
                    k: mutable usize = value_s
                    while k + n + 3 <= e |k, e, line, tag, n|:
                        if line[k] == 60 and line[k + 1] == 47 and Base::rh_bytes_equal_literal(line, (k + 2).i64(), (k + 2 + n).i64(), tag) and line[k + 2 + n] == 62:
                            value_e: mutable usize = k
                            while value_e > value_s and (line[value_e - 1] == 32 or line[value_e - 1] == 9) |value_e, value_s, line|:
                                value_e <- value_e - 1
                            return false if value_e <= value_s
                            start_out[0] <- value_s.i64()
                            end_out[0] <- value_e.i64()
                            return true
                        k <- k + 1
                i <- i + 1
            false

        def rh_maven_has_open(line: darray[u8]&, s: usize, e: usize, tag: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = strlen(tag)
            return false if n == 0
            while i + n + 2 <= e |i: usize = s, e, line, tag, n|:
                if line[i] == 60 and line[i + 1] != 47 and Base::rh_bytes_equal_literal(line, (i + 1).i64(), (i + 1 + n).i64(), tag):
                    after: u8 = line[i + 1 + n]
                    return true if after == 62 or after == 32 or after == 9 or after == 47
                i <- i + 1
            false

        def rh_maven_has_close(line: darray[u8]&, s: usize, e: usize, tag: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = strlen(tag)
            return false if n == 0
            while i + n + 3 <= e |i: usize = s, e, line, tag, n|:
                return true if line[i] == 60 and line[i + 1] == 47 and Base::rh_bytes_equal_literal(line, (i + 2).i64(), (i + 2 + n).i64(), tag) and line[i + 2 + n] == 62
                i <- i + 1
            false

        def rh_maven_coord(pool: mutable darray[u8]&, data: darray[u8]&, gs: usize, ge: usize, arts: usize, arte: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            start: i64 = pool.count.i64()
            while i < ge |i: usize = gs, ge, data, pool|:
                pool.push(data[i])
                i <- i + 1
            pool.push(58)
            while i < arte |i: usize = arts, arte, data, pool|:
                pool.push(data[i])
                i <- i + 1
            start

        def rh_maven_version_exact(data: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e <= s
            digits: mutable i64 = 0
            while i < e |i: i64 = s, e, data, digits|:
                b: u8 = data[i.usize()]
                return false if b == 32 or b == 9 or b == 91 or b == 93 or b == 40 or b == 41 or b == 44 or b == 42 or b == 60 or b == 62 or b == 124 or b == 36 or b == 123 or b == 125
                digits <- 1 if b >= 48 and b <= 57
                i <- i + 1
            digits == 1

        def rh_maven_add_dependency(xml: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, gs: i64, ge: i64, arts: i64, arte: i64, vs: i64, ve: i64, depctx: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if gs < 0 or ge <= gs or arts < 0 or arte <= arts
            name_s: i64 = rh_maven_coord(pool, xml, gs.usize(), ge.usize(), arts.usize(), arte.usize())
            name_e: i64 = pool.count.i64()
            req_s: mutable i64 = -1
            req_e: mutable i64 = -1
            if vs >= 0 and ve > vs:
                req_s <- rh_pool_copy(pool, xml, vs.usize(), ve.usize())
                req_e <- req_s + (ve - vs)
            reqs.push(RhRequire{from: 0, name_s: name_s, name_e: name_e, ver_s: -1, ver_e: -1, src_s: -1, src_e: -1, req_s: req_s, req_e: req_e, depctx: depctx, optional: 0})
            if vs >= 0 and rh_maven_version_exact(xml, vs, ve):
                node: i64 = rh_node_add(pkgs, RH_ECO_MAVEN)
                return -1 if node < 0
                nd: mutable RhPkgNode = pkgs[node.usize()]
                nd.name_s <- name_s
                nd.name_e <- name_e
                nd.ver_s <- req_s
                nd.ver_e <- req_e
                nd.src_kind <- RH_PSRC_REGISTRY
                nd.optional <- 1 if depctx == RH_SCOPE_OPTIONAL else 0
                nd.dev <- 1 if depctx == RH_SCOPE_DEV else 0
                pkgs[node.usize()] <- nd
                edges.push(RhDepEdge{from: 0, dst: node, depctx: depctx, optional: 0})
            else:
                unresolved.push(RhUnresolved{from: 0, name_s: name_s, name_e: name_e, req_s: req_s, req_e: req_e, reason: RH_UNRES_MISSING, optional: 0})
            0

        # Parse the bounded Maven POM subset. Project and dependency coordinates use
        # `groupId:artifactId`; exact literal versions become root edges. Properties,
        # dependency management, profiles, and non-default repository resolution stay
        # explicit unresolved/unsupported instead of being evaluated.
        def rh_maven_parse(xml: darray[u8]&, pkgs: mutable darray[RhPkgNode]&, pool: mutable darray[u8]&, reqs: mutable darray[RhRequire]&, edges: mutable darray[RhDepEdge]&, unresolved: mutable darray[RhUnresolved]&, unknown_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            unknown_out[0] <- 0
            root: i64 = rh_node_add(pkgs, RH_ECO_MAVEN)
            return -1 if root != 0
            project_gs: mutable i64 = -1
            project_ge: mutable i64 = -1
            project_as: mutable i64 = -1
            project_ae: mutable i64 = -1
            project_vs: mutable i64 = -1
            project_ve: mutable i64 = -1
            in_dep: mutable bool = false
            in_mgmt: mutable bool = false
            dep_gs: mutable i64 = -1
            dep_ge: mutable i64 = -1
            dep_as: mutable i64 = -1
            dep_ae: mutable i64 = -1
            dep_vs: mutable i64 = -1
            dep_ve: mutable i64 = -1
            dep_scope: mutable u8 = RH_SCOPE_NORMAL
            dep_optional: mutable bool = false
            line_start: mutable usize = 0
            while line_start <= xml.count |line_start, xml, pkgs, pool, reqs, edges, unresolved, unknown_out, project_gs, project_ge, project_as, project_ae, project_vs, project_ve, in_dep, in_mgmt, dep_gs, dep_ge, dep_as, dep_ae, dep_vs, dep_ve, dep_scope, dep_optional|:
                line_end: usize =
                    while j < xml.count and xml[j] != 10 |j: usize = line_start| -> j:
                        j <- j + 1
                s: mutable usize = line_start
                e: mutable usize = line_end
                while s < e and (xml[s] == 32 or xml[s] == 9 or xml[s] == 13) |s, e, xml|:
                    s <- s + 1
                while e > s and (xml[e - 1] == 32 or xml[e - 1] == 9 or xml[e - 1] == 13) |s, e, xml|:
                    e <- e - 1
                if rh_maven_has_open(xml, s, e, "dependencyManagement"):
                    in_mgmt <- true
                if rh_maven_has_close(xml, s, e, "dependencyManagement"):
                    in_mgmt <- false
                if rh_maven_has_open(xml, s, e, "dependency"):
                    return -1 if in_dep
                    in_dep <- true
                    dep_gs <- -1
                    dep_ge <- -1
                    dep_as <- -1
                    dep_ae <- -1
                    dep_vs <- -1
                    dep_ve <- -1
                    dep_scope <- RH_SCOPE_NORMAL
                    dep_optional <- false
                if rh_maven_has_close(xml, s, e, "dependency"):
                    return -1 if not in_dep
                    if not in_mgmt:
                        return -1 if rh_maven_add_dependency(xml, pkgs, pool, reqs, edges, unresolved, dep_gs, dep_ge, dep_as, dep_ae, dep_vs, dep_ve, dep_scope) != 0
                    in_dep <- false
                else:
                    ts: mutable i64 = -1
                    te: mutable i64 = -1
                    if in_dep:
                        if rh_maven_tag_value(xml, s, e, "groupId", &ts, &te):
                            dep_gs <- ts
                            dep_ge <- te
                        if rh_maven_tag_value(xml, s, e, "artifactId", &ts, &te):
                            dep_as <- ts
                            dep_ae <- te
                        if rh_maven_tag_value(xml, s, e, "version", &ts, &te):
                            dep_vs <- ts
                            dep_ve <- te
                        if rh_maven_tag_value(xml, s, e, "scope", &ts, &te):
                            dep_scope <- RH_SCOPE_DEV if rh_span_lit(xml, ts.usize(), te.usize(), "test") or rh_span_lit(xml, ts.usize(), te.usize(), "provided")
                        if rh_maven_tag_value(xml, s, e, "optional", &ts, &te):
                            dep_optional <- rh_span_lit(xml, ts.usize(), te.usize(), "true")
                            dep_scope <- RH_SCOPE_OPTIONAL if dep_optional
                    else:
                        if rh_maven_tag_value(xml, s, e, "groupId", &ts, &te):
                            project_gs <- ts
                            project_ge <- te
                        if rh_maven_tag_value(xml, s, e, "artifactId", &ts, &te):
                            project_as <- ts
                            project_ae <- te
                        if rh_maven_tag_value(xml, s, e, "version", &ts, &te):
                            project_vs <- ts
                            project_ve <- te
                line_start <- line_end + 1
            return -1 if in_dep or project_gs < 0 or project_as < 0
            root_name: i64 = rh_maven_coord(pool, xml, project_gs.usize(), project_ge.usize(), project_as.usize(), project_ae.usize())
            root_node: mutable RhPkgNode = pkgs[0]
            root_node.name_s <- root_name
            root_node.name_e <- pool.count.i64()
            if project_vs >= 0 and rh_maven_version_exact(xml, project_vs, project_ve):
                root_node.ver_s <- rh_pool_copy(pool, xml, project_vs.usize(), project_ve.usize())
                root_node.ver_e <- root_node.ver_s + (project_ve - project_vs)
            root_node.src_kind <- RH_PSRC_UNKNOWN
            pkgs[0] <- root_node
            0

        def rh_composer_is_platform(pool: darray[u8]&, ns: usize, ne: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if ne - ns == 3 and rh_name_eq_basic(pool, ns, ne, "php")
            return true if ne - ns >= 4 and rh_name_eq_basic(pool, ns, ns + 4, "ext-")
            return true if ne - ns >= 4 and rh_name_eq_basic(pool, ns, ns + 4, "lib-")
            return true if ne - ns >= 4 and rh_name_eq_basic(pool, ns, ns + 4, "php-")
            false

        def rh_composer_find_by_name(pkgs: darray[RhPkgNode]&, pool: darray[u8]&, ns: usize, ne: usize) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < pkgs.count.i64() |i: i64 = 0, pkgs, pool, ns, ne|:
                n: RhPkgNode = pkgs[i.usize()]
                if n.eco == RH_ECO_COMPOSER and n.name_s >= 0:
                    return i if rh_span_eq2(pool, n.name_s.usize(), n.name_e.usize(), pool, ns, ne)
                i <- i + 1
            -1

        def rh_name_eq_basic(pool: darray[u8]&, ns: usize, ne: usize, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(pool, ns.i64(), ne.i64(), lit)
