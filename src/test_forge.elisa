# test_forge.elisa — M02 adapter tests (normalizer goldens, transport).
#
# Usage: test_forge <workdir> [live]
# workdir holds github-repo.json, gitlab-project.json and their
# .canonical.json goldens (checked-in sanitized fixtures). With "live",
# one public GitHub fetch runs (opt-in network; never in the default
# gate). Exit 0 pass, 1 failure, 2 usage.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_forge.elisa"
include "./rh_git.elisa"


def tfail(text: u8&) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    buffer: mutable darray[u8] =
        buffer: mutable darray[u8] = []
        Base::rh_push_text(buffer, "FORGE-FAIL ")
        Base::rh_push_text(buffer, text)
        buffer.push(10)
        buffer
    Base::rh_write_stdout(buffer)
    1

def tjoin(dir: cstr, name: u8&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if Base::rh_cstr_len_c(dir) == 0
    Base::rh_push_cstr(out, dir)
    out.push(47)
    Base::rh_push_text(out, name)
    out.push(0)
    true

def tbytes_equal(a: darray[u8]&, b: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if a.count != b.count
    while i < a.count |i: usize = 0, a, b|:
        return false if a[i] != b[i]
        i <- i + 1
    true

def tcheck_golden(workdir: cstr, fixture: u8&, golden: u8&, github: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    fpath: mutable darray[u8] = []
    return tfail("join-fixture") if not tjoin(workdir, fixture, fpath)
    fp: cstr = (&fpath[0]).cast[cstr] can Unsafe.PointerCast
    input: mutable darray[u8] = []
    return tfail("read-fixture") if Base::rh_io_read(fp, input) < 0
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(input, nodes, texts)
    return tfail("parse-fixture") if root < 0
    produced: mutable darray[u8] = []
    ok: mutable bool = false
    if github:
        ok <- Forge::rh_github_repo_canonical(nodes, texts, input, root, 1700000000, produced)
    else:
        ok <- Forge::rh_gitlab_project_canonical(nodes, texts, input, root, 1700000000, produced)
    return tfail("normalize") if not ok
    gpath: mutable darray[u8] = []
    return tfail("join-golden") if not tjoin(workdir, golden, gpath)
    gp: cstr = (&gpath[0]).cast[cstr] can Unsafe.PointerCast
    want: mutable darray[u8] = []
    return tfail("read-golden") if Base::rh_io_read(gp, want) < 0
    if want.count > 0 and want[want.count - 1] == 10:
        want2: mutable darray[u8] = []
        while k + 1 < want.count |k: usize = 0, want, want2|:
            want2.push(want[k])
            k <- k + 1
        return tfail("golden-mismatch") if not tbytes_equal(produced, want2)
    else:
        return tfail("golden-mismatch") if not tbytes_equal(produced, want)
    0

def tcheck_escape() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    raw: mutable darray[u8] =
        raw: mutable darray[u8] = []
        raw.push(97)
        raw.push(34)
        raw.push(98)
        raw.push(92)
        raw.push(99)
        raw.push(10)
        raw
    got: mutable darray[u8] = []
    Base::rh_json_escape(got, raw, 0, raw.count)
    want: mutable darray[u8] =
        want: mutable darray[u8] = []
        want.push(97)
        want.push(92)
        want.push(34)
        want.push(98)
        want.push(92)
        want.push(92)
        want.push(99)
        want.push(92)
        want.push(117)
        want.push(48)
        want.push(48)
        want.push(48)
        want.push(97)
        want
    return tfail("escape") if not tbytes_equal(got, want)
    0

def tcheck_transport(workdir: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    src: mutable darray[u8] = []
    return tfail("join-src") if not tjoin(workdir, "github-repo.json", src)
    url: mutable darray[u8] =
        url: mutable darray[u8] = []
        Base::rh_push_text(url, "file://")
        Base::rh_push_cstr(url, (&src[0]).cast[cstr] can Unsafe.PointerCast)
        url.push(0)
        url
    up: cstr = (&url[0]).cast[cstr] can Unsafe.PointerCast
    body: mutable darray[u8] = []
    codef: mutable darray[u8] = []
    errf: mutable darray[u8] = []
    return tfail("join-body") if not tjoin(workdir, "t-body.json", body)
    return tfail("join-code") if not tjoin(workdir, "t-code.txt", codef)
    return tfail("join-err") if not tjoin(workdir, "t-err.txt", errf)
    bodyp: cstr = (&body[0]).cast[cstr] can Unsafe.PointerCast
    codep: cstr = (&codef[0]).cast[cstr] can Unsafe.PointerCast
    errp: cstr = (&errf[0]).cast[cstr] can Unsafe.PointerCast
    rc: i64 = Git::rh_run_https_get(up, bodyp, codep, errp)
    return tfail("transport-rc") if rc != 0
    codeb: mutable darray[u8] = []
    return tfail("read-code") if Base::rh_io_read(codep, codeb) < 0
    return tfail("file-code-not-000") if codeb.count != 3 or codeb[0] != 48 or codeb[1] != 48 or codeb[2] != 48
    direct: mutable darray[u8] = []
    srcp: cstr = (&src[0]).cast[cstr] can Unsafe.PointerCast
    return tfail("read-direct") if Base::rh_io_read(srcp, direct) < 0
    fetched: mutable darray[u8] = []
    return tfail("read-fetched") if Base::rh_io_read(bodyp, fetched) < 0
    return tfail("transport-bytes") if not tbytes_equal(direct, fetched)
    return tfail("loopback-not-blocked") if Git::rh_run_https_get("https://127.0.0.1/x", bodyp, codep, errp) != -1
    return tfail("http-not-blocked") if Git::rh_run_https_get("http://example.com/", bodyp, codep, errp) != -1
    0

def tcheck_live(workdir: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    body: mutable darray[u8] = []
    codef: mutable darray[u8] = []
    errf: mutable darray[u8] = []
    return tfail("join-live-body") if not tjoin(workdir, "live-body.json", body)
    return tfail("join-live-code") if not tjoin(workdir, "live-code.txt", codef)
    return tfail("join-live-err") if not tjoin(workdir, "live-err.txt", errf)
    lbodyp: cstr = (&body[0]).cast[cstr] can Unsafe.PointerCast
    lcodep: cstr = (&codef[0]).cast[cstr] can Unsafe.PointerCast
    rc: i64 = |errf|
        lerrp: cstr = (&errf[0]).cast[cstr] can Unsafe.PointerCast
        block_result: i64 = Git::rh_run_https_get("https://api.github.com/repos/octocat/Hello-World", lbodyp, lcodep, lerrp)
        block_result
    return tfail("live-transport") if rc != 0
    codeb: mutable darray[u8] = []
    return tfail("live-code-read") if Base::rh_io_read(lcodep, codeb) < 0
    return tfail("live-not-200") if codeb.count != 3 or codeb[0] != 50 or codeb[1] != 48 or codeb[2] != 48
    input: mutable darray[u8] = []
    return tfail("live-body-read") if Base::rh_io_read(lbodyp, input) < 0
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(input, nodes, texts)
    return tfail("live-parse") if root < 0
    produced: mutable darray[u8] = []
    return tfail("live-normalize") if not Forge::rh_github_repo_canonical(nodes, texts, input, root, 1700000000, produced)
    0

def tspan_starts_with(texts: darray[u8]&, s: usize, e: usize, prefix: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: usize = strlen(prefix)
    return false if e - s < n
    while k < n |k: usize = 0, texts, s, prefix|:
        return false if texts[s + k] != prefix[k]
        k <- k + 1
    true

def tspan_eq(texts: darray[u8]&, s: usize, e: usize, want: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: usize = strlen(want)
    return false if e - s != n
    tspan_starts_with(texts, s, e, want)

def tcheck_manifests(workdir: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    while c < 5 |c: i64 = 0, workdir|:
        name: u8& = Forge::rh_conn_name(c.u8())
        path: mutable darray[u8] = []
        return tfail("manifest-join") if not tjoin(workdir, name, path)
        ext: mutable darray[u8] =
            ext: mutable darray[u8] = []
            Base::rh_push_cstr(ext, (&path[0]).cast[cstr] can Unsafe.PointerCast)
            Base::rh_push_text(ext, ".json")
            ext.push(0)
            ext
        mp: cstr = (&ext[0]).cast[cstr] can Unsafe.PointerCast
        raw: mutable darray[u8] = []
        return tfail("manifest-read") if Base::rh_io_read(mp, raw) < 0
        nodes: mutable darray[Json::RhJsonNode] = []
        texts: mutable darray[u8] = []
        caps: i64 = |raw, nodes, texts|
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return tfail("manifest-parse") if root < 0
            cid: i64 = Json::rh_json_obj_get(nodes, texts, root, "connector_id")
            cs: mutable i64 = 0
            ce: mutable i64 = 0
            return tfail("manifest-id-type") if not Json::rh_json_str_span(nodes, cid, &cs, &ce)
            return tfail("manifest-id-mismatch") if not tspan_eq(texts, cs.usize(), ce.usize(), name)
            block_result: i64 = Json::rh_json_obj_get(nodes, texts, root, "capabilities")
            block_result
        return tfail("manifest-caps") if caps < 0
        return tfail("manifest-history") if not tcap_key(nodes, texts, caps, "history", 1, c)
        return tfail("manifest-issues") if not tcap_key(nodes, texts, caps, "issues", 2, c)
        return tfail("manifest-reviews") if not tcap_key(nodes, texts, caps, "reviews", 4, c)
        return tfail("manifest-releases") if not tcap_key(nodes, texts, caps, "releases", 8, c)
        return tfail("manifest-traffic") if not tcap_key(nodes, texts, caps, "traffic", 16, c)
        return tfail("manifest-permissions") if not tcap_key(nodes, texts, caps, "permissions", 32, c)
        c <- c + 1
    0

def tcap_key(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, caps: i64, key: u8&, bit: u64, conn: i64) -> bool can[Memory.Allocate, Abort.Panic]:
    starts: bool =
        idx: i64 = Json::rh_json_obj_get(nodes, texts, caps, key)
        s: mutable i64 = 0
        e: mutable i64 = 0
        return false if not Json::rh_json_str_span(nodes, idx, &s, &e)
        un: u8& = "unsupported"
        value: bool = tspan_starts_with(texts, s.usize(), e.usize(), un)
        value
    return not starts if Forge::rh_conn_has(conn.u8(), bit)
    starts

def main(argc: i64, argv: mutable void&) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if argc < 2:
        usage: mutable darray[u8] =
            usage: mutable darray[u8] = []
            Base::rh_push_text(usage, "usage: test_forge <workdir> [live]")
            usage.push(10)
            usage
        Base::rh_write_stderr(usage)
        return 2
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    workdir: cstr = slots[1]
    return 1 if tcheck_golden(workdir, "github-repo.json", "github-repo.canonical.json", true) != 0
    return 1 if tcheck_golden(workdir, "gitlab-project.json", "gitlab-project.canonical.json", false) != 0
    return 1 if tcheck_escape() != 0
    return 1 if tcheck_manifests(workdir) != 0
    return 1 if tcheck_transport(workdir) != 0
    if argc >= 3:
        flag: u8& = slots[2].cast[u8&] can Unsafe.PointerCast
        if Base::rh_streq(flag, "live"):
            return 1 if tcheck_live(workdir) != 0
    buffer: mutable darray[u8] =
        buffer: mutable darray[u8] = []
        Base::rh_push_text(buffer, "FORGE OK")
        buffer.push(10)
        buffer
    Base::rh_write_stdout(buffer)
    0
