# test_forge.elisa — M02 adapter tests (normalizer goldens, transport).
#
# Usage: test_forge <workdir> [live]
# workdir holds github-repo.json, gitlab-project.json and their
# .canonical.json goldens (checked-in sanitized fixtures). With "live",
# one public GitHub fetch runs (opt-in network; never in the default
# gate). Exit 0 pass, 1 failure, 2 usage.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_forge.elisa"
include "./rh_git.elisa"


def tfail(text: u8&) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    buffer: mutable darray[u8] = []
    rh_push_text(buffer, "FORGE-FAIL ")
    rh_push_text(buffer, text)
    buffer.push(10)
    rh_write_stdout(buffer)
    return 1

def tjoin(dir: cstr, name: u8&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    if rh_cstr_len_c(dir) == 0:
        return false
    rh_push_cstr(out, dir)
    out.push(47)
    rh_push_text(out, name)
    out.push(0)
    return true

def tbytes_equal(a: darray[u8]&, b: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    if a.count != b.count:
        return false
    i: mutable usize = 0
    while i < a.count |i, a, b|:
        if a[i] != b[i]:
            return false
        i <- i + 1
    return true

def tcheck_golden(workdir: cstr, fixture: u8&, golden: u8&, github: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    fpath: mutable darray[u8] = []
    if not tjoin(workdir, fixture, fpath):
        return tfail("join-fixture")
    fp: cstr = (&fpath[0]).cast[cstr] can Unsafe.PointerCast
    input: mutable darray[u8] = []
    if rh_io_read(fp, input) < 0:
        return tfail("read-fixture")
    nodes: mutable darray[RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = rh_json_parse(input, nodes, texts)
    if root < 0:
        return tfail("parse-fixture")
    produced: mutable darray[u8] = []
    ok: mutable bool = false
    if github:
        ok <- rh_github_repo_canonical(nodes, texts, input, root, 1700000000, produced)
    else:
        ok <- rh_gitlab_project_canonical(nodes, texts, input, root, 1700000000, produced)
    if not ok:
        return tfail("normalize")
    gpath: mutable darray[u8] = []
    if not tjoin(workdir, golden, gpath):
        return tfail("join-golden")
    gp: cstr = (&gpath[0]).cast[cstr] can Unsafe.PointerCast
    want: mutable darray[u8] = []
    if rh_io_read(gp, want) < 0:
        return tfail("read-golden")
    if want.count > 0 and want[want.count - 1] == 10:
        want2: mutable darray[u8] = []
        k: mutable usize = 0
        while k + 1 < want.count |k, want, want2|:
            want2.push(want[k])
            k <- k + 1
        if not tbytes_equal(produced, want2):
            return tfail("golden-mismatch")
    else:
        if not tbytes_equal(produced, want):
            return tfail("golden-mismatch")
    return 0

def tcheck_escape() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    raw: mutable darray[u8] = []
    raw.push(97)
    raw.push(34)
    raw.push(98)
    raw.push(92)
    raw.push(99)
    raw.push(10)
    got: mutable darray[u8] = []
    rh_json_escape(got, raw, 0, raw.count)
    want: mutable darray[u8] = []
    want.push(97)
    want.push(92)
    want.push(34)
    want.push(98)
    want.push(92)
    want.push(92)
    want.push(99)
    want.push(92)
    want.push(117)
    want.push(48)
    want.push(48)
    want.push(48)
    want.push(97)
    if not tbytes_equal(got, want):
        return tfail("escape")
    return 0

def tcheck_transport(workdir: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    src: mutable darray[u8] = []
    if not tjoin(workdir, "github-repo.json", src):
        return tfail("join-src")
    url: mutable darray[u8] = []
    rh_push_text(url, "file://")
    rh_push_cstr(url, (&src[0]).cast[cstr] can Unsafe.PointerCast)
    url.push(0)
    up: cstr = (&url[0]).cast[cstr] can Unsafe.PointerCast
    body: mutable darray[u8] = []
    codef: mutable darray[u8] = []
    errf: mutable darray[u8] = []
    if not tjoin(workdir, "t-body.json", body):
        return tfail("join-body")
    if not tjoin(workdir, "t-code.txt", codef):
        return tfail("join-code")
    if not tjoin(workdir, "t-err.txt", errf):
        return tfail("join-err")
    bodyp: cstr = (&body[0]).cast[cstr] can Unsafe.PointerCast
    codep: cstr = (&codef[0]).cast[cstr] can Unsafe.PointerCast
    errp: cstr = (&errf[0]).cast[cstr] can Unsafe.PointerCast
    rc: i64 = rh_run_https_get(up, bodyp, codep, errp)
    if rc != 0:
        return tfail("transport-rc")
    codeb: mutable darray[u8] = []
    if rh_io_read(codep, codeb) < 0:
        return tfail("read-code")
    if codeb.count != 3 or codeb[0] != 48 or codeb[1] != 48 or codeb[2] != 48:
        return tfail("file-code-not-000")
    direct: mutable darray[u8] = []
    srcp: cstr = (&src[0]).cast[cstr] can Unsafe.PointerCast
    if rh_io_read(srcp, direct) < 0:
        return tfail("read-direct")
    fetched: mutable darray[u8] = []
    if rh_io_read(bodyp, fetched) < 0:
        return tfail("read-fetched")
    if not tbytes_equal(direct, fetched):
        return tfail("transport-bytes")
    if rh_run_https_get("https://127.0.0.1/x", bodyp, codep, errp) != -1:
        return tfail("loopback-not-blocked")
    if rh_run_https_get("http://example.com/", bodyp, codep, errp) != -1:
        return tfail("http-not-blocked")
    return 0

def tcheck_live(workdir: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    body: mutable darray[u8] = []
    codef: mutable darray[u8] = []
    errf: mutable darray[u8] = []
    if not tjoin(workdir, "live-body.json", body):
        return tfail("join-live-body")
    if not tjoin(workdir, "live-code.txt", codef):
        return tfail("join-live-code")
    if not tjoin(workdir, "live-err.txt", errf):
        return tfail("join-live-err")
    lbodyp: cstr = (&body[0]).cast[cstr] can Unsafe.PointerCast
    lcodep: cstr = (&codef[0]).cast[cstr] can Unsafe.PointerCast
    lerrp: cstr = (&errf[0]).cast[cstr] can Unsafe.PointerCast
    rc: i64 = rh_run_https_get("https://api.github.com/repos/octocat/Hello-World", lbodyp, lcodep, lerrp)
    if rc != 0:
        return tfail("live-transport")
    codeb: mutable darray[u8] = []
    if rh_io_read(lcodep, codeb) < 0:
        return tfail("live-code-read")
    if codeb.count != 3 or codeb[0] != 50 or codeb[1] != 48 or codeb[2] != 48:
        return tfail("live-not-200")
    input: mutable darray[u8] = []
    if rh_io_read(lbodyp, input) < 0:
        return tfail("live-body-read")
    nodes: mutable darray[RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = rh_json_parse(input, nodes, texts)
    if root < 0:
        return tfail("live-parse")
    produced: mutable darray[u8] = []
    if not rh_github_repo_canonical(nodes, texts, input, root, 1700000000, produced):
        return tfail("live-normalize")
    return 0

def tspan_starts_with(texts: darray[u8]&, s: usize, e: usize, prefix: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: usize = strlen(prefix)
    if e - s < n:
        return false
    k: mutable usize = 0
    while k < n |k, texts, s, prefix|:
        if texts[s + k] != prefix[k]:
            return false
        k <- k + 1
    return true

def tspan_eq(texts: darray[u8]&, s: usize, e: usize, want: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: usize = strlen(want)
    if e - s != n:
        return false
    return tspan_starts_with(texts, s, e, want)

def tcheck_manifests(workdir: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    c: mutable i64 = 0
    while c < 5 |c, workdir|:
        name: u8& = rh_conn_name(c.u8())
        path: mutable darray[u8] = []
        if not tjoin(workdir, name, path):
            return tfail("manifest-join")
        ext: mutable darray[u8] = []
        rh_push_cstr(ext, (&path[0]).cast[cstr] can Unsafe.PointerCast)
        rh_push_text(ext, ".json")
        ext.push(0)
        mp: cstr = (&ext[0]).cast[cstr] can Unsafe.PointerCast
        raw: mutable darray[u8] = []
        if rh_io_read(mp, raw) < 0:
            return tfail("manifest-read")
        nodes: mutable darray[RhJsonNode] = []
        texts: mutable darray[u8] = []
        root: i64 = rh_json_parse(raw, nodes, texts)
        if root < 0:
            return tfail("manifest-parse")
        cid: i64 = rh_json_obj_get(nodes, texts, root, "connector_id")
        cs: mutable i64 = 0
        ce: mutable i64 = 0
        if not rh_json_str_span(nodes, cid, &cs, &ce):
            return tfail("manifest-id-type")
        if not tspan_eq(texts, cs.usize(), ce.usize(), name):
            return tfail("manifest-id-mismatch")
        caps: i64 = rh_json_obj_get(nodes, texts, root, "capabilities")
        if caps < 0:
            return tfail("manifest-caps")
        if not tcap_key(nodes, texts, caps, "history", 1, c):
            return tfail("manifest-history")
        if not tcap_key(nodes, texts, caps, "issues", 2, c):
            return tfail("manifest-issues")
        if not tcap_key(nodes, texts, caps, "reviews", 4, c):
            return tfail("manifest-reviews")
        if not tcap_key(nodes, texts, caps, "releases", 8, c):
            return tfail("manifest-releases")
        if not tcap_key(nodes, texts, caps, "traffic", 16, c):
            return tfail("manifest-traffic")
        if not tcap_key(nodes, texts, caps, "permissions", 32, c):
            return tfail("manifest-permissions")
        c <- c + 1
    return 0

def tcap_key(nodes: darray[RhJsonNode]&, texts: darray[u8]&, caps: i64, key: u8&, bit: u64, conn: i64) -> bool can[Memory.Allocate, Abort.Panic]:
    idx: i64 = rh_json_obj_get(nodes, texts, caps, key)
    s: mutable i64 = 0
    e: mutable i64 = 0
    if not rh_json_str_span(nodes, idx, &s, &e):
        return false
    un: u8& = "unsupported"
    starts: bool = tspan_starts_with(texts, s.usize(), e.usize(), un)
    if rh_conn_has(conn.u8(), bit):
        return not starts
    return starts

def main(argc: i64, argv: mutable void&) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if argc < 2:
        usage: mutable darray[u8] = []
        rh_push_text(usage, "usage: test_forge <workdir> [live]")
        usage.push(10)
        rh_write_stderr(usage)
        return 2
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    workdir: cstr = slots[1]
    if tcheck_golden(workdir, "github-repo.json", "github-repo.canonical.json", true) != 0:
        return 1
    if tcheck_golden(workdir, "gitlab-project.json", "gitlab-project.canonical.json", false) != 0:
        return 1
    if tcheck_escape() != 0:
        return 1
    if tcheck_manifests(workdir) != 0:
        return 1
    if tcheck_transport(workdir) != 0:
        return 1
    if argc >= 3:
        flag: u8& = slots[2].cast[u8&] can Unsafe.PointerCast
        if rh_streq(flag, "live"):
            if tcheck_live(workdir) != 0:
                return 1
    buffer: mutable darray[u8] = []
    rh_push_text(buffer, "FORGE OK")
    buffer.push(10)
    rh_write_stdout(buffer)
    return 0
