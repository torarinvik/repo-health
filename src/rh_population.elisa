                    ratio_def <- nodes[ratio_def.usize()].next_sibling
            dep_idx: i64 = Population::rh_population_get(nodes, texts, root, "dependents")
            return -1 if dep_idx < 0 or nodes[dep_idx.usize()].kind != Json::RH_JSON_ARR
            return -1 if nodes[dep_idx.usize()].child_count > RH_POP_MAX_DEPENDENTS
            dependents: mutable darray[RhPopulationDependent] = []
