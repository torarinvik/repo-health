                return -1 if not Population::rh_population_str(nodes, texts, dep, "id", &ids, &ide) or not Population::rh_population_str(nodes, texts, dep, "family", &fs, &fe) or not Population::rh_population_str(nodes, texts, dep, "package", &ps, &pe) or not Population::rh_population_str(nodes, texts, dep, "version", &vs, &ve) or not Population::rh_population_str(nodes, texts, dep, "relation", &rs, &re)
                return -1 if ids == ide or fs == fe or ps == pe or vs == ve or not Population::rh_population_relation_valid(texts, rs, re)
