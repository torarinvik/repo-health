            return -1 if as_of_ok == 0 or page_ok == 0 or mapping_ok == 0 or as_of < 0 or page_limit <= 0 or mapping_revision < 0
            truncated_code: i64 = Population::rh_population_bool(nodes, raw, texts, root, "truncated")
            return -1 if truncated_code < 0
            truncated: bool = truncated_code != 0
            provider_status: mutable u8 = RH_POP_PROVIDER_HEALTHY
