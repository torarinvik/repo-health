# rh_population.elisa — bounded focal-library downstream population report.
#
# The population is deliberately selected and source-scoped. It preserves the
# discovery mode/cap, mapping revision, family deduplication unit, exact path
# witnesses, and per-metric missingness. Intrinsic values are supplied by the
# dependent project evidence; this adapter never derives them from the focal
# package or turns an unavailable dependent into zero.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_observation.elisa"

module Population:
    private:

        const RH_POP_MAX_METRICS: i64 = 63
        const RH_POP_MAX_DEPENDENTS: i64 = 1000
        const RH_POP_MAX_UNRESOLVED: i64 = 1000
        const RH_POP_STATUS_OBSERVED: u8 = 0
        const RH_POP_STATUS_PARTIAL: u8 = 1
        const RH_POP_STATUS_UNAVAILABLE: u8 = 2
        const RH_POP_STATUS_UNKNOWN: u8 = 3
        const RH_POP_POLICY_PASS: u8 = 0
        const RH_POP_POLICY_FAIL: u8 = 1
        const RH_POP_POLICY_UNKNOWN: u8 = 2
        const RH_POP_PROVIDER_HEALTHY: u8 = 0
        const RH_POP_PROVIDER_RATE_LIMIT: u8 = 1
        const RH_POP_PROVIDER_AUTHORIZATION: u8 = 2
        const RH_POP_PROVIDER_UNAVAILABLE: u8 = 3

        struct RhPopulationMetric:
            key_s: mutable i64
            key_e: mutable i64
            version_s: mutable i64
            version_e: mutable i64

        struct RhPopulationRatio:
            key_s: mutable i64
            key_e: mutable i64
            version_s: mutable i64
            version_e: mutable i64
            numerator_index: mutable i64
            denominator_index: mutable i64

        struct RhPopulationCell:
            metric_index: mutable i64
            status: mutable u8
            value: mutable i64
            has_value: mutable bool
            policy: mutable u8

        struct RhPopulationRatioCoverage:
            numerator_observed: mutable i64
            numerator_partial: mutable i64
            numerator_unavailable: mutable i64
            numerator_unknown: mutable i64
            denominator_observed: mutable i64
            denominator_partial: mutable i64
            denominator_unavailable: mutable i64
            denominator_unknown: mutable i64

        struct RhPopulationProjectIdentity:
            graph_node_id: mutable i64
            accepted: mutable bool
            project_s: mutable i64
            project_e: mutable i64
            family_s: mutable i64
            family_e: mutable i64
            reviewer_id: mutable i64
            reviewed_at: mutable i64
            evidence_s: mutable i64
            evidence_e: mutable i64

        struct RhPopulationDependent:
            id_s: mutable i64
            id_e: mutable i64
            family_s: mutable i64
            family_e: mutable i64
            package_s: mutable i64
            package_e: mutable i64
            version_s: mutable i64
            version_e: mutable i64
            relation_s: mutable i64
            relation_e: mutable i64
            package_count: mutable i64
            path_index: mutable i64
            cell_start: mutable i64
            cell_count: mutable i64
            graph_node_id: mutable i64
            identity_index: mutable i64

        def rh_population_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_obj_get(nodes, texts, obj, key)

        def rh_population_unique_object_keys(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if object < 0 or nodes[object.usize()].kind != Json::RH_JSON_OBJ
            while key_node >= 0 |key_node: i64 = nodes[object.usize()].first_child, nodes, texts, object|:
                return false if nodes[key_node.usize()].kind != Json::RH_JSON_STR
                value_node: i64 = nodes[key_node.usize()].next_sibling
                return false if value_node < 0
                key_start: i64 = nodes[key_node.usize()].text_start
                key_end: i64 = nodes[key_node.usize()].text_end
                while other_key >= 0 |other_key: i64 = nodes[value_node.usize()].next_sibling, nodes, texts, key_start, key_end|:
                    return false if nodes[other_key.usize()].kind != Json::RH_JSON_STR
                    other_value: i64 = nodes[other_key.usize()].next_sibling
                    return false if other_value < 0
                    same: bool = Base::rh_bytes_equal_span(texts, key_start, key_end, texts, nodes[other_key.usize()].text_start, nodes[other_key.usize()].text_end)
                    return false if same
                    other_key <- nodes[other_value.usize()].next_sibling
                key_node <- nodes[value_node.usize()].next_sibling
            true

        def rh_population_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        def rh_population_relation_valid(texts: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            Population::rh_population_eq(texts, s, e, "direct") or Population::rh_population_eq(texts, s, e, "transitive")

        def rh_population_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, start_out: mutable i64&, end_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Population::rh_population_get(nodes, texts, obj, key)
            return false if idx < 0
            Json::rh_json_str_span(nodes, idx, start_out, end_out)

        def rh_population_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Population::rh_population_get(nodes, texts, obj, key)
            Json::rh_json_int(nodes, raw, idx, ok_out)

        def rh_population_bool(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Population::rh_population_get(nodes, texts, obj, key)
            return -1 if idx < 0 or nodes[idx.usize()].kind != Json::RH_JSON_BOOL
            return 1 if Json::rh_json_is_true(nodes, raw, idx)
            0

        def rh_population_status(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return RH_POP_STATUS_OBSERVED if Population::rh_population_eq(texts, s, e, "observed")
            return RH_POP_STATUS_PARTIAL if Population::rh_population_eq(texts, s, e, "partial")
            return RH_POP_STATUS_UNAVAILABLE if Population::rh_population_eq(texts, s, e, "unavailable")
            return RH_POP_STATUS_UNKNOWN if Population::rh_population_eq(texts, s, e, "unknown")
            -1

        def rh_population_policy(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return RH_POP_POLICY_PASS if Population::rh_population_eq(texts, s, e, "pass")
            return RH_POP_POLICY_FAIL if Population::rh_population_eq(texts, s, e, "fail")
            return RH_POP_POLICY_UNKNOWN if Population::rh_population_eq(texts, s, e, "unknown")
            -1

        def rh_population_policy_label(policy: u8) -> u8&:
            return "pass" if policy == RH_POP_POLICY_PASS
            return "fail" if policy == RH_POP_POLICY_FAIL
            "unknown"

        def rh_population_provider_status(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return RH_POP_PROVIDER_HEALTHY if Population::rh_population_eq(texts, s, e, "healthy")
            return RH_POP_PROVIDER_RATE_LIMIT if Population::rh_population_eq(texts, s, e, "rate_limit")
            return RH_POP_PROVIDER_AUTHORIZATION if Population::rh_population_eq(texts, s, e, "authorization")
            return RH_POP_PROVIDER_UNAVAILABLE if Population::rh_population_eq(texts, s, e, "unavailable")
            -1

        def rh_population_provider_label(status: u8) -> u8&:
            return "healthy" if status == RH_POP_PROVIDER_HEALTHY
            return "rate_limit" if status == RH_POP_PROVIDER_RATE_LIMIT
            return "authorization" if status == RH_POP_PROVIDER_AUTHORIZATION
            "unavailable"

        def rh_population_emit_summary_metric(out: mutable darray[u8]&, key: cstr, count: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{
                completeness: Observation::RhCompleteness.Complete,
                freshness: Observation::RhFreshness.Unknown,
                validity: Observation::RhValidity.Valid,
                provenance: Observation::RhProvenanceQuality.EvidenceBacked
            }
            evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
            Observation::rh_evidence_links_push_external(&evidence, string_view_slice(bytes_view("population-input"), 0, 16))
            observation: Observation::RhObservation = Observation::rh_observation_make_with_evidence(Observation::RH_ST_OBSERVED, Observation::RhMetricValue.Count(count), false, quality, evidence)
            Observation::rh_observation_emit_metric(out, key, "1.0.0", "", observation)

        def rh_population_emit_distribution(out: mutable darray[u8]&, distribution: Observation::RhMetricValue) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not Observation::rh_metric_value_valid(distribution)
            match distribution:
                Observation::RhMetricValue.CountSummary(count, sum, minimum, maximum):
                    Base::rh_push_text(out, "{\"count\":")
                    Base::rh_push_decimal_i64(out, count)
                    Base::rh_push_text(out, ",\"sum\":")
                    Base::rh_push_decimal_i64(out, sum)
                    Base::rh_push_text(out, ",\"min\":")
                    Base::rh_push_decimal_i64(out, minimum) if count > 0
                    Base::rh_push_text(out, "null") if count == 0
                    Base::rh_push_text(out, ",\"max\":")
                    Base::rh_push_decimal_i64(out, maximum) if count > 0
                    Base::rh_push_text(out, "null") if count == 0
                    Base::rh_push_text(out, "}")
                    true
                _:
                    false

        def rh_population_emit_span(out: mutable darray[u8]&, texts: darray[u8]&, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
            out.push(34)
            Base::rh_json_escape(out, texts, s.usize(), e.usize())
            out.push(34)

        def rh_population_emit_cell_metric(out: mutable darray[u8]&, texts: darray[u8]&, metric: RhPopulationMetric, cell: RhPopulationCell) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if cell.status > RH_POP_STATUS_UNKNOWN
            emitted: bool =
                observed: bool = cell.status == RH_POP_STATUS_OBSERVED
                incomplete: bool = cell.status == RH_POP_STATUS_PARTIAL
                status: u8 = Observation::RH_ST_OBSERVED if observed else Observation::RH_ST_PARTIAL if incomplete else Observation::RH_ST_UNAVAILABLE if cell.status == RH_POP_STATUS_UNAVAILABLE else Observation::RH_ST_NOT_OBSERVED
                value: Observation::RhMetricValue = Observation::RhMetricValue.Count(cell.value) if observed else Observation::RhMetricValue.Absent
                completeness: Observation::RhCompleteness = Observation::RhCompleteness.Complete if observed else Observation::RhCompleteness.Partial if incomplete else Observation::RhCompleteness.Unknown
                validity: Observation::RhValidity = Observation::RhValidity.Valid if observed else Observation::RhValidity.Unknown
                quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{completeness: completeness, freshness: Observation::RhFreshness.Unknown, validity: validity, provenance: Observation::RhProvenanceQuality.EvidenceBacked}
                evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
                Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.PopulationInput)
                reason: cstr = "population-cell-partial" if incomplete else "population-cell-unavailable" if cell.status == RH_POP_STATUS_UNAVAILABLE else "population-cell-unknown" if cell.status == RH_POP_STATUS_UNKNOWN else ""
                observation: Observation::RhObservation = Observation::rh_observation_make_with_evidence(status, value, incomplete, quality, evidence)
                key: sview = string_view_slice(bytes_view(texts), metric.key_s.usize(), metric.key_e.usize())
                version: sview = string_view_slice(bytes_view(texts), metric.version_s.usize(), metric.version_e.usize())
                Observation::rh_observation_emit_metric_views(out, key, version, reason, observation)
            return false if not emitted
            out.pop()
            Base::rh_push_text(out, ",\"policy\":\"")
            Base::rh_push_text(out, Population::rh_population_policy_label(cell.policy))
            Base::rh_push_text(out, "\"}")
            true

        def rh_population_emit_ratio_metric(out: mutable darray[u8]&, texts: darray[u8]&, ratio: RhPopulationRatio, numerator: i64, denominator: i64, observed_dependents: i64, not_applicable_dependents: i64, unknown_dependents: i64, selected_dependents: i64, coverage: RhPopulationRatioCoverage) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if numerator < 0 or denominator < 0 or numerator > denominator
            return false if observed_dependents < 0 or not_applicable_dependents < 0 or unknown_dependents < 0 or selected_dependents < 0 or observed_dependents + not_applicable_dependents + unknown_dependents != selected_dependents
            return false if coverage.numerator_observed + coverage.numerator_partial + coverage.numerator_unavailable + coverage.numerator_unknown != selected_dependents
            return false if coverage.denominator_observed + coverage.denominator_partial + coverage.denominator_unavailable + coverage.denominator_unknown != selected_dependents
            has_value: bool = denominator > 0
            emitted: bool =
                incomplete: bool = has_value and unknown_dependents > 0
                observation_status: u8 = Observation::RH_ST_OBSERVED if has_value and not incomplete else Observation::RH_ST_PARTIAL if incomplete else Observation::RH_ST_NOT_APPLICABLE if unknown_dependents == 0 else Observation::RH_ST_NOT_OBSERVED
                observation_value: Observation::RhMetricValue = Observation::RhMetricValue.Ratio(numerator, denominator) if has_value else Observation::RhMetricValue.Absent
                observation_completeness: Observation::RhCompleteness = Observation::RhCompleteness.Complete if has_value and not incomplete else Observation::RhCompleteness.Partial if incomplete else Observation::RhCompleteness.Unknown
                observation_validity: Observation::RhValidity = Observation::RhValidity.Valid if has_value else Observation::RhValidity.Unknown
                observation_quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{completeness: observation_completeness, freshness: Observation::RhFreshness.Unknown, validity: observation_validity, provenance: Observation::RhProvenanceQuality.EvidenceBacked}
                observation_evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
                Observation::rh_evidence_links_push(&observation_evidence, Observation::RhEvidenceObject.PopulationInput)
                observation_reason: cstr = "population-ratio-unknown-dependents" if incomplete else "population-ratio-no-positive-denominator" if unknown_dependents == 0 else "population-ratio-no-known-denominator"
                observation: Observation::RhObservation = Observation::rh_observation_make_with_evidence(observation_status, observation_value, incomplete, observation_quality, observation_evidence)
                key: sview = string_view_slice(bytes_view(texts), ratio.key_s.usize(), ratio.key_e.usize())
                version: sview = string_view_slice(bytes_view(texts), ratio.version_s.usize(), ratio.version_e.usize())
                Observation::rh_observation_emit_metric_views(out, key, version, observation_reason, observation)
            return false if not emitted
            out.pop()
            Base::rh_push_text(out, ",\"numerator_count\":")
            Base::rh_push_decimal_i64(out, numerator)
            Base::rh_push_text(out, ",\"denominator_count\":")
            Base::rh_push_decimal_i64(out, denominator)
            Base::rh_push_text(out, ",\"ratio\":")
            Base::rh_push_text(out, "null") if not has_value
            if has_value:
                Base::rh_push_text(out, "{\"num\":")
                Base::rh_push_decimal_i64(out, numerator)
                Base::rh_push_text(out, ",\"den\":")
                Base::rh_push_decimal_i64(out, denominator)
                out.push(125)
            Base::rh_push_text(out, ",\"coverage\":{\"observed_dependents\":")
            Base::rh_push_decimal_i64(out, observed_dependents)
            Base::rh_push_text(out, ",\"not_applicable_dependents\":")
            Base::rh_push_decimal_i64(out, not_applicable_dependents)
            Base::rh_push_text(out, ",\"unknown_dependents\":")
            Base::rh_push_decimal_i64(out, unknown_dependents)
            Base::rh_push_text(out, ",\"selected_dependents\":")
            Base::rh_push_decimal_i64(out, selected_dependents)
            Base::rh_push_text(out, ",\"numerator_metric\":{\"observed\":")
            Base::rh_push_decimal_i64(out, coverage.numerator_observed)
            Base::rh_push_text(out, ",\"partial\":")
            Base::rh_push_decimal_i64(out, coverage.numerator_partial)
            Base::rh_push_text(out, ",\"unavailable\":")
            Base::rh_push_decimal_i64(out, coverage.numerator_unavailable)
            Base::rh_push_text(out, ",\"unknown\":")
            Base::rh_push_decimal_i64(out, coverage.numerator_unknown)
            Base::rh_push_text(out, "},\"denominator_metric\":{\"observed\":")
            Base::rh_push_decimal_i64(out, coverage.denominator_observed)
            Base::rh_push_text(out, ",\"partial\":")
            Base::rh_push_decimal_i64(out, coverage.denominator_partial)
            Base::rh_push_text(out, ",\"unavailable\":")
            Base::rh_push_decimal_i64(out, coverage.denominator_unavailable)
            Base::rh_push_text(out, ",\"unknown\":")
            Base::rh_push_decimal_i64(out, coverage.denominator_unknown)
            Base::rh_push_text(out, "}},\"basis\":\"pooled-configured-count-pairs-over-selected-dependents\"}")
            true

        def rh_population_metric_index(metrics: darray[RhPopulationMetric]&, texts: darray[u8]&, key_s: i64, key_e: i64, version_s: i64, version_e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < metrics.count |i: usize = 0, metrics, texts, key_s, key_e, version_s, version_e|:
                m: RhPopulationMetric = metrics[i]
                return i.i64() if Base::rh_bytes_equal_span(texts, m.key_s, m.key_e, texts, key_s, key_e) and Base::rh_bytes_equal_span(texts, m.version_s, m.version_e, texts, version_s, version_e)
                i <- i + 1
            -1

        def rh_population_seen_span(values_s: darray[i64]&, values_e: darray[i64]&, texts: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < values_s.count |i: usize = 0, values_s, values_e, texts, s, e|:
                return true if Base::rh_bytes_equal_span(texts, values_s[i], values_e[i], texts, s, e)
                i <- i + 1
            false

        def rh_population_span_index_table(count: usize) -> mutable darray[i64] can[Memory.Allocate, Abort.Panic]:
            slots: mutable darray[i64] = []
            capacity: usize = count * 2 + 1
            while i < capacity |i: usize = 0, capacity, slots|:
                slots.push(-1)
                i <- i + 1
            slots

        def rh_population_span_index_insert(values_s: mutable darray[i64]&, values_e: mutable darray[i64]&, texts: darray[u8]&, slots: mutable darray[i64]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if s < 0 or e <= s or e > texts.count.i64() or slots.count == 0
            hash: usize = hash_sview(string_view_slice(bytes_view(texts), s.usize(), e.usize())).usize()
            slot: mutable usize = hash % slots.count
            while probe < slots.count |probe: usize = 0, slot, values_s, values_e, texts, slots, s, e|:
                index: i64 = slots[slot]
                if index < 0:
                    values_s.push(s)
                    values_e.push(e)
                    slots[slot] <- values_s.count.i64() - 1
                    return 1
                return 0 if Base::rh_bytes_equal_span(texts, values_s[index.usize()], values_e[index.usize()], texts, s, e)
                slot <- (slot + 1) % slots.count
                probe <- probe + 1
            -1

        def rh_population_path_valid(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, path_idx: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if path_idx < 0 or nodes[path_idx.usize()].kind != Json::RH_JSON_ARR or nodes[path_idx.usize()].child_count == 0
            path_nodes_s: mutable darray[i64] = []
            path_nodes_e: mutable darray[i64] = []
            while child >= 0 |child: i64 = nodes[path_idx.usize()].first_child, nodes, texts, path_nodes_s, path_nodes_e|:
                s: mutable i64 = 0
                e: mutable i64 = 0
                return false if not Json::rh_json_str_span(nodes, child, &s, &e) or s == e
                return false if Population::rh_population_seen_span(path_nodes_s, path_nodes_e, texts, s, e)
                path_nodes_s.push(s)
                path_nodes_e.push(e)
                child <- nodes[child.usize()].next_sibling
            true

        def rh_population_path_ends_at(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, path_idx: i64, target_s: i64, target_e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if path_idx < 0 or nodes[path_idx.usize()].kind != Json::RH_JSON_ARR or nodes[path_idx.usize()].child_count == 0
            last: mutable i64 = -1
            while child >= 0 |child: i64 = nodes[path_idx.usize()].first_child, nodes, path_idx, last|:
                last <- child
                child <- nodes[child.usize()].next_sibling
            return false if last < 0
            end_s: mutable i64 = 0
            end_e: mutable i64 = 0
            Json::rh_json_str_span(nodes, last, &end_s, &end_e) and Base::rh_bytes_equal_span(texts, end_s, end_e, texts, target_s, target_e)

        def rh_population_emit_path(out: mutable darray[u8]&, nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, path_idx: i64) -> void can[Memory.Allocate, Abort.Panic]:
            out.push(91)
            while child >= 0 |child: i64 = nodes[path_idx.usize()].first_child, nodes, texts, out|:
                if child != nodes[path_idx.usize()].first_child:
                    out.push(44)
                s: mutable i64 = 0
                e: mutable i64 = 0
                _ = Json::rh_json_str_span(nodes, child, &s, &e)
                Population::rh_population_emit_span(out, texts, s, e)
                child <- nodes[child.usize()].next_sibling
            out.push(93)

        def rh_population_project_identities(raw: darray[u8]&, nodes_out: mutable darray[Json::RhJsonNode]&, texts_out: mutable darray[u8]&, identities_out: mutable darray[RhPopulationProjectIdentity]&, node_ids_out: mutable darray[i64]&, node_slots_out: mutable darray[i64]&, identity_indices_out: mutable darray[i64]&, revision_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            root: i64 = Json::rh_json_parse(raw, nodes_out, texts_out)
            return false if root < 0 or not Population::rh_population_unique_object_keys(nodes_out, texts_out, root)
            schema_s: mutable i64 = 0
            schema_e: mutable i64 = 0
            return false if not Population::rh_population_str(nodes_out, texts_out, root, "schema", &schema_s, &schema_e)
            return false if not Base::rh_bytes_equal_literal(texts_out, schema_s, schema_e, "rh-downstream/3")
            transitive: i64 = Population::rh_population_get(nodes_out, texts_out, root, "transitive")
            identity_obj: i64 = Population::rh_population_get(nodes_out, texts_out, root, "project_identities")
            return false if transitive < 0 or nodes_out[transitive.usize()].kind != Json::RH_JSON_ARR or identity_obj < 0
            return false if nodes_out[transitive.usize()].child_count > RH_POP_MAX_DEPENDENTS
            return false if not Population::rh_population_unique_object_keys(nodes_out, texts_out, identity_obj)
            revision_ok: mutable i64 = 0
            revision_out[0] <- Population::rh_population_int(nodes_out, raw, texts_out, identity_obj, "revision", &revision_ok)
            return false if revision_ok != 1 or revision_out[0] < 0
            items: i64 = Population::rh_population_get(nodes_out, texts_out, identity_obj, "items")
            return false if items < 0 or nodes_out[items.usize()].kind != Json::RH_JSON_ARR
            coverage: i64 = Population::rh_population_get(nodes_out, texts_out, identity_obj, "coverage")
            return false if coverage < 0 or not Population::rh_population_unique_object_keys(nodes_out, texts_out, coverage)
            node_ids_out <- []
            node_slots_out <- Population::rh_population_node_index_table(nodes_out[transitive.usize()].child_count)
            while candidate >= 0 |candidate: i64 = nodes_out[transitive.usize()].first_child, nodes_out, texts_out, raw, node_ids_out, node_slots_out|:
                return false if not Population::rh_population_unique_object_keys(nodes_out, texts_out, candidate)
                candidate_id: i64 = Population::rh_population_get(nodes_out, texts_out, candidate, "id")
                candidate_ok: mutable i64 = 0
                parsed_id: i64 = Json::rh_json_int(nodes_out, raw, candidate_id, &candidate_ok)
                return false if candidate_ok != 1 or parsed_id < 0
                return false if not Population::rh_population_node_insert(node_ids_out, node_slots_out, parsed_id)
                candidate <- nodes_out[candidate.usize()].next_sibling
            identity_indices_out <- []
            while i < node_ids_out.count |i: usize = 0, node_ids_out, identity_indices_out|:
                identity_indices_out.push(-1)
                i <- i + 1
            accepted_count: mutable i64 = 0
            while row >= 0 |row: i64 = nodes_out[items.usize()].first_child, nodes_out, texts_out, raw, identities_out, node_ids_out, node_slots_out, identity_indices_out, accepted_count|:
                return false if not Population::rh_population_unique_object_keys(nodes_out, texts_out, row)
                id_ok: mutable i64 = 0
                graph_node_id: i64 = Population::rh_population_int(nodes_out, raw, texts_out, row, "graph_node_id", &id_ok)
                return false if id_ok != 1 or graph_node_id < 0
                transitive_index: i64 = Population::rh_population_node_index(node_ids_out, node_slots_out, graph_node_id)
                return false if transitive_index < 0 or identity_indices_out[transitive_index.usize()] >= 0
                status_s: mutable i64 = 0
                status_e: mutable i64 = 0
                return false if not Population::rh_population_str(nodes_out, texts_out, row, "mapping_status", &status_s, &status_e)
                accepted: bool = Base::rh_bytes_equal_literal(texts_out, status_s, status_e, "accepted")
                return false if not accepted and not Base::rh_bytes_equal_literal(texts_out, status_s, status_e, "unknown")
                identity: mutable RhPopulationProjectIdentity = RhPopulationProjectIdentity{graph_node_id: graph_node_id, accepted: accepted, project_s: 0, project_e: 0, family_s: 0, family_e: 0, reviewer_id: 0, reviewed_at: 0, evidence_s: 0, evidence_e: 0}
                if accepted:
                    return false if not Population::rh_population_str(nodes_out, texts_out, row, "project_id", &identity.project_s, &identity.project_e) or identity.project_s == identity.project_e
                    return false if not Population::rh_population_str(nodes_out, texts_out, row, "family_id", &identity.family_s, &identity.family_e) or identity.family_s == identity.family_e
                    reviewer_ok: mutable i64 = 0
                    identity.reviewer_id <- Population::rh_population_int(nodes_out, raw, texts_out, row, "reviewer_id", &reviewer_ok)
                    reviewed_ok: mutable i64 = 0
                    identity.reviewed_at <- Population::rh_population_int(nodes_out, raw, texts_out, row, "reviewed_at", &reviewed_ok)
                    return false if reviewer_ok != 1 or identity.reviewer_id <= 0 or reviewed_ok != 1 or identity.reviewed_at < 0
                    return false if not Population::rh_population_str(nodes_out, texts_out, row, "evidence_sha256", &identity.evidence_s, &identity.evidence_e) or identity.evidence_e - identity.evidence_s != 64
                    return false if not Population::rh_population_hex_sha256(texts_out, identity.evidence_s, identity.evidence_e)
                    accepted_count <- accepted_count + 1
                else:
                    return false if not Population::rh_population_all_null(nodes_out, texts_out, row, "project_id") or not Population::rh_population_all_null(nodes_out, texts_out, row, "family_id") or not Population::rh_population_all_null(nodes_out, texts_out, row, "reviewer_id") or not Population::rh_population_all_null(nodes_out, texts_out, row, "reviewed_at") or not Population::rh_population_all_null(nodes_out, texts_out, row, "evidence_sha256")
                identity_indices_out[transitive_index.usize()] <- identities_out.count.i64()
                identities_out.push(identity)
                row <- nodes_out[row.usize()].next_sibling
            return false if identities_out.count != node_ids_out.count
            selected_ok: mutable i64 = 0
            selected: i64 = Population::rh_population_int(nodes_out, raw, texts_out, coverage, "selected", &selected_ok)
            accepted_ok: mutable i64 = 0
            accepted: i64 = Population::rh_population_int(nodes_out, raw, texts_out, coverage, "accepted", &accepted_ok)
            unknown_ok: mutable i64 = 0
            unknown: i64 = Population::rh_population_int(nodes_out, raw, texts_out, coverage, "unknown", &unknown_ok)
            return false if selected_ok != 1 or accepted_ok != 1 or unknown_ok != 1
            return false if selected != node_ids_out.count.i64() or accepted != accepted_count or unknown != selected - accepted
            true

        def rh_population_hex_sha256(texts: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if e - s != 64
            while i < 64 |i: i64 = 0, texts, s|:
                c: u8 = texts[(s + i).usize()]
                valid: bool = (c >= 48 and c <= 57) or (c >= 97 and c <= 102)
                return false if not valid
                i <- i + 1
            true

        def rh_population_node_index_table(count: usize) -> mutable darray[i64] can[Memory.Allocate, Abort.Panic]:
            slots: mutable darray[i64] = []
            capacity: usize = count * 2 + 1
            while i < capacity |i: usize = 0, capacity, slots|:
                slots.push(-1)
                i <- i + 1
            slots

        def rh_population_node_index(node_ids: darray[i64]&, slots: darray[i64]&, node_id: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if node_id < 0 or slots.count == 0
            slot: mutable usize = Population::rh_population_node_hash(node_id, slots.count)
            while probe < slots.count |probe: usize = 0, slot, node_ids, slots, node_id|:
                node_index: i64 = slots[slot]
                return -1 if node_index < 0
                return node_index if node_ids[node_index.usize()] == node_id
                slot <- (slot + 1) % slots.count
                probe <- probe + 1
            -1

        def rh_population_node_insert(node_ids: mutable darray[i64]&, slots: mutable darray[i64]&, node_id: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if node_id < 0 or slots.count == 0
            slot: mutable usize = Population::rh_population_node_hash(node_id, slots.count)
            while probe < slots.count |probe: usize = 0, slot, node_ids, slots, node_id|:
                node_index: i64 = slots[slot]
                if node_index < 0:
                    node_ids.push(node_id)
                    slots[slot] <- node_ids.count.i64() - 1
                    return true
                return false if node_ids[node_index.usize()] == node_id
                slot <- (slot + 1) % slots.count
                probe <- probe + 1
            false

        def rh_population_node_hash(node_id: i64, capacity: usize) -> usize:
            value: mutable usize = node_id.usize()
            hash: mutable usize = 0
            while value > 0 |value, hash, capacity|:
                hash <- (hash * 31 + value % 10) % capacity
                value <- value / 10
            hash

        def rh_population_all_null(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64, key: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            value: i64 = Json::rh_json_obj_get(nodes, texts, object, key)
            value >= 0 and nodes[value.usize()].kind == Json::RH_JSON_NULL

        def rh_population_identity_index(node_ids: darray[i64]&, slots: darray[i64]&, identity_indices: darray[i64]&, graph_node_id: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            node_index: i64 = Population::rh_population_node_index(node_ids, slots, graph_node_id)
            return -1 if node_index < 0
            identity_indices[node_index.usize()]

    public:
        def rh_population_report(raw: darray[u8]&, downstream_raw: darray[u8]&, has_downstream: bool, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
