                return -1 if not Population::rh_population_str(nodes, texts, definition, "key", &ks, &ke) or not Population::rh_population_str(nodes, texts, definition, "version", &vs, &ve) or ks == ke or vs == ve
                return -1 if Population::rh_population_metric_index(metrics, texts, ks, ke, vs, ve) >= 0
                metrics.push(RhPopulationMetric{key_s: ks, key_e: ke, version_s: vs, version_e: ve})
                definition <- nodes[definition.usize()].next_sibling
            return -1 if metrics.count == 0
            ratios: mutable darray[RhPopulationRatio] = []
            ratio_defs_idx: i64 = Population::rh_population_get(nodes, texts, root, "ratio_definitions")
            if ratio_defs_idx >= 0:
                return -1 if nodes[ratio_defs_idx.usize()].kind != Json::RH_JSON_ARR or nodes[ratio_defs_idx.usize()].child_count > RH_POP_MAX_METRICS
                while ratio_def >= 0 |ratio_def: i64 = nodes[ratio_defs_idx.usize()].first_child, nodes, texts, metrics, ratios|:
                    return -1 if not Population::rh_population_unique_object_keys(nodes, texts, ratio_def)
                    ratio_key_s: mutable i64 = 0
                    ratio_key_e: mutable i64 = 0
                    ratio_version_s: mutable i64 = 0
                    ratio_version_e: mutable i64 = 0
                    numerator_key_s: mutable i64 = 0
                    numerator_key_e: mutable i64 = 0
                    numerator_version_s: mutable i64 = 0
                    numerator_version_e: mutable i64 = 0
                    denominator_key_s: mutable i64 = 0
