                    return -1 if not Population::rh_population_str(nodes, texts, ratio_def, "key", &ratio_key_s, &ratio_key_e) or not Population::rh_population_str(nodes, texts, ratio_def, "version", &ratio_version_s, &ratio_version_e) or not Population::rh_population_str(nodes, texts, ratio_def, "numerator_key", &numerator_key_s, &numerator_key_e) or not Population::rh_population_str(nodes, texts, ratio_def, "numerator_version", &numerator_version_s, &numerator_version_e) or not Population::rh_population_str(nodes, texts, ratio_def, "denominator_key", &denominator_key_s, &denominator_key_e) or not Population::rh_population_str(nodes, texts, ratio_def, "denominator_version", &denominator_version_s, &denominator_version_e)
                    return -1 if ratio_key_s == ratio_key_e or ratio_version_s == ratio_version_e or numerator_key_s == numerator_key_e or numerator_version_s == numerator_version_e or denominator_key_s == denominator_key_e or denominator_version_s == denominator_version_e
                    numerator_index: i64 = Population::rh_population_metric_index(metrics, texts, numerator_key_s, numerator_key_e, numerator_version_s, numerator_version_e)
                    denominator_index: i64 = Population::rh_population_metric_index(metrics, texts, denominator_key_s, denominator_key_e, denominator_version_s, denominator_version_e)
                    return -1 if numerator_index < 0 or denominator_index < 0 or numerator_index == denominator_index or Population::rh_population_metric_index(metrics, texts, ratio_key_s, ratio_key_e, ratio_version_s, ratio_version_e) >= 0
                    while prior_ratio < ratios.count |prior_ratio: usize = 0, ratios, texts, ratio_key_s, ratio_key_e, ratio_version_s, ratio_version_e|:
                        prior: RhPopulationRatio = ratios[prior_ratio]
                        return -1 if Base::rh_bytes_equal_span(texts, prior.key_s, prior.key_e, texts, ratio_key_s, ratio_key_e) and Base::rh_bytes_equal_span(texts, prior.version_s, prior.version_e, texts, ratio_version_s, ratio_version_e)
                        prior_ratio <- prior_ratio + 1
