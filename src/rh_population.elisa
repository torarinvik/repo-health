                metric_cell_indices.push(-1)
                i <- i + 1
            while dep >= 0 |dep: i64 = nodes[dep_idx.usize()].first_child, nodes, texts, metrics, dependents, cells, dependent_ids_s, dependent_ids_e, dependent_id_slots, metric_cell_indices, families_s, families_e, family_slots, canonical_families_s, canonical_families_e, canonical_family_slots, observed, partial, unavailable, unknown, sums, mins, maxs, policy_pass, policy_fail, policy_unknown, ratios, ratio_numerator_sums, ratio_denominator_sums, ratio_observed_dependents, ratio_unknown_dependents, ratio_not_applicable_dependents, has_downstream, identity_accepted, identities, identity_texts, project_node_ids, project_node_slots, identity_indices, identity_selected, canonical_family_count|:
                return -1 if not Population::rh_population_unique_object_keys(nodes, texts, dep)
                ids: mutable i64 = 0
                ide: mutable i64 = 0
                fs: mutable i64 = 0
                fe: mutable i64 = 0
                ps: mutable i64 = 0
                pe: mutable i64 = 0
