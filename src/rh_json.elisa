# rh_json.elisa — bounded JSON parser for forge payloads (M02-05).
#
# Produces a flat DOM (node pool + decoded-text buffer) over caller-owned
# buffers; no floats (numbers keep exact raw spans; i64 conversion is
# explicit with overflow checks). Hostile-input bounds (S012): maximum
# nesting depth, maximum node count, and no reads past the input end.
# Raw bytes >= 0x80 pass through uninterpreted (documented, like the git
# log path); \u escapes decode to UTF-8 with U+FFFD substitution for
# surrogates and out-of-range codepoints.


include "./rh_base.elisa"

const RH_JSON_NULL: u8 = 0
const RH_JSON_BOOL: u8 = 1
const RH_JSON_NUM: u8 = 2
const RH_JSON_STR: u8 = 3
const RH_JSON_ARR: u8 = 4
const RH_JSON_OBJ: u8 = 5

# private to this file (modules retried after re-seed; see CHANGELOG).
const RH_JSON_MAX_DEPTH: i64 = 32
# private to this file (modules retried after re-seed; see CHANGELOG).
const RH_JSON_MAX_NODES: i64 = 200000

struct RhJsonNode:
    kind: mutable u8
    text_start: mutable i64
    text_end: mutable i64
    first_child: mutable i64
    child_count: mutable i64
    next_sibling: mutable i64

def rh_json_node(kind: u8) -> RhJsonNode:
    return RhJsonNode{kind: kind, text_start: -1, text_end: -1, first_child: -1, child_count: 0, next_sibling: -1}

# Append a node; returns its index, or -1 past the node cap.
# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_json_emit(nodes: mutable darray[RhJsonNode]&, kind: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
    if nodes.count.i64() >= RH_JSON_MAX_NODES:
        return -1
    nodes.push(rh_json_node(kind))
    return (nodes.count - 1).i64()

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_json_skip_ws(input: darray[u8]&, pos: usize) -> usize can[Memory.Allocate, Abort.Panic]:
    i: mutable usize = pos
    while i < input.count |i, input|:
        b: u8 = input[i]
        break if b != 32 and b != 9 and b != 10 and b != 13
        i <- i + 1
    return i

# Link child into parent (O(siblings); fixture-scale docs only).
# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_json_link(nodes: mutable darray[RhJsonNode]&, parent: i64, child: i64) -> void can[Memory.Allocate, Abort.Panic]:
    p: RhJsonNode = nodes[parent.usize()]
    if p.first_child < 0:
        p.first_child <- child
        p.child_count <- 1
        nodes[parent.usize()] <- p
        return
    sib: mutable i64 = p.first_child
    while true |sib, nodes|:
        s: RhJsonNode = nodes[sib.usize()]
        if s.next_sibling < 0:
            s.next_sibling <- child
            nodes[sib.usize()] <- s
            break
        sib <- s.next_sibling
    p.child_count <- p.child_count + 1
    nodes[parent.usize()] <- p

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_json_hexval(b: u8) -> i64:
    if b >= 48 and b <= 57:
        return (b - 48).i64()
    if b >= 65 and b <= 70:
        return (b - 55).i64()
    if b >= 97 and b <= 102:
        return (b - 87).i64()
    return -1

# Parse a JSON string at pos (input[pos] == '"'). Decodes into texts;
# end_out = first byte past closing quote. Returns node idx or -1.
# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_json_string(input: darray[u8]&, pos: usize, nodes: mutable darray[RhJsonNode]&, texts: mutable darray[u8]&, end_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    end_out[0] <- -1
    t0: i64 = texts.count.i64()
    i: mutable usize = pos + 1
    while i < input.count |i, input, texts|:
        b: u8 = input[i]
        if b == 34:
            idx: i64 = rh_json_emit(nodes, RH_JSON_STR)
            if idx < 0:
                return -1
            n: RhJsonNode = nodes[idx.usize()]
            n.text_start <- t0
            n.text_end <- texts.count.i64()
            nodes[idx.usize()] <- n
            end_out[0] <- (i + 1).i64()
            return idx
        if b == 92:
            i <- i + 1
            if i >= input.count:
                return -1
            e: u8 = input[i]
            if e == 34 or e == 92 or e == 47:
                texts.push(e)
            elif e == 98:
                texts.push(8)
            elif e == 102:
                texts.push(12)
            elif e == 110:
                texts.push(10)
            elif e == 114:
                texts.push(13)
            elif e == 116:
                texts.push(9)
            elif e == 117:
                if i + 4 >= input.count:
                    return -1
                cp: mutable i64 = 0
                k: mutable usize = 1
                bad: mutable bool = false
                while k <= 4 |k, input, i, cp, bad|:
                    hv: i64 = rh_json_hexval(input[i + k])
                    if hv < 0:
                        bad <- true
                    else:
                        cp <- cp * 16 + hv
                    k <- k + 1
                if bad:
                    return -1
                i <- i + 4
                if cp >= 55296 and cp <= 57343:
                    cp <- 65533
                if cp > 1114111:
                    cp <- 65533
                if cp < 128:
                    texts.push(cp.u8())
                elif cp < 2048:
                    texts.push((192 + cp / 64).u8())
                    texts.push((128 + cp % 64).u8())
                else:
                    texts.push((224 + cp / 4096).u8())
                    texts.push((128 + (cp / 64) % 64).u8())
                    texts.push((128 + cp % 64).u8())
            else:
                return -1
            i <- i + 1
            continue
        if b < 32:
            return -1
        texts.push(b)
        i <- i + 1
    return -1

# Parse a JSON number at pos. Stores the raw span. Returns idx or -1.
# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_json_number(input: darray[u8]&, pos: usize, nodes: mutable darray[RhJsonNode]&, end_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    end_out[0] <- -1
    i: mutable usize = pos
    if i < input.count and input[i] == 45:
        i <- i + 1
    if i >= input.count:
        return -1
    if input[i] == 48:
        i <- i + 1
    elif input[i] >= 49 and input[i] <= 57:
        while i < input.count |i, input|:
            break if input[i] < 48 or input[i] > 57
            i <- i + 1
    else:
        return -1
    if i < input.count and input[i] == 46:
        i <- i + 1
        if i >= input.count or input[i] < 48 or input[i] > 57:
            return -1
        while i < input.count |i, input|:
            break if input[i] < 48 or input[i] > 57
            i <- i + 1
    if i < input.count and (input[i] == 101 or input[i] == 69):
        i <- i + 1
        if i < input.count and (input[i] == 43 or input[i] == 45):
            i <- i + 1
        if i >= input.count or input[i] < 48 or input[i] > 57:
            return -1
        while i < input.count |i, input|:
            break if input[i] < 48 or input[i] > 57
            i <- i + 1
    idx: i64 = rh_json_emit(nodes, RH_JSON_NUM)
    if idx < 0:
        return -1
    n: RhJsonNode = nodes[idx.usize()]
    n.text_start <- pos.i64()
    n.text_end <- i.i64()
    nodes[idx.usize()] <- n
    end_out[0] <- i.i64()
    return idx

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_json_literal(input: darray[u8]&, pos: usize, word: u8&, kind: u8, nodes: mutable darray[RhJsonNode]&, end_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    end_out[0] <- -1
    n: usize = strlen(word)
    if pos + n > input.count:
        return -1
    k: mutable usize = 0
    while k < n |k, input, pos, word|:
        if input[pos + k] != word[k]:
            return -1
        k <- k + 1
    idx: i64 = rh_json_emit(nodes, kind)
    if idx < 0:
        return -1
    node: RhJsonNode = nodes[idx.usize()]
    node.text_start <- pos.i64()
    node.text_end <- (pos + n).i64()
    nodes[idx.usize()] <- node
    end_out[0] <- (pos + n).i64()
    return idx

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_json_value(input: darray[u8]&, pos: usize, depth: i64, nodes: mutable darray[RhJsonNode]&, texts: mutable darray[u8]&, end_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    end_out[0] <- -1
    if depth > RH_JSON_MAX_DEPTH:
        return -1
    p: usize = rh_json_skip_ws(input, pos)
    if p >= input.count:
        return -1
    b: u8 = input[p]
    if b == 123:
        return rh_json_object(input, p, depth, nodes, texts, end_out)
    if b == 91:
        return rh_json_array(input, p, depth, nodes, texts, end_out)
    if b == 34:
        return rh_json_string(input, p, nodes, texts, end_out)
    if b == 116:
        return rh_json_literal(input, p, "true", RH_JSON_BOOL, nodes, end_out)
    if b == 102:
        return rh_json_literal(input, p, "false", RH_JSON_BOOL, nodes, end_out)
    if b == 110:
        return rh_json_literal(input, p, "null", RH_JSON_NULL, nodes, end_out)
    if b == 45 or (b >= 48 and b <= 57):
        return rh_json_number(input, p, nodes, end_out)
    return -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_json_object(input: darray[u8]&, pos: usize, depth: i64, nodes: mutable darray[RhJsonNode]&, texts: mutable darray[u8]&, end_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    end_out[0] <- -1
    self_idx: i64 = rh_json_emit(nodes, RH_JSON_OBJ)
    if self_idx < 0:
        return -1
    i: mutable usize = rh_json_skip_ws(input, pos + 1)
    if i < input.count and input[i] == 125:
        end_out[0] <- (i + 1).i64()
        return self_idx
    while true |i, input, depth, nodes, texts, self_idx|:
        i <- rh_json_skip_ws(input, i)
        if i >= input.count or input[i] != 34:
            return -1
        key_end: mutable i64 = 0
        key_idx: i64 = rh_json_string(input, i, nodes, texts, &key_end)
        if key_idx < 0:
            return -1
        i <- rh_json_skip_ws(input, key_end.usize())
        if i >= input.count or input[i] != 58:
            return -1
        val_end: mutable i64 = 0
        val_idx: i64 = rh_json_value(input, i + 1, depth + 1, nodes, texts, &val_end)
        if val_idx < 0:
            return -1
        rh_json_link(nodes, self_idx, key_idx)
        rh_json_link(nodes, self_idx, val_idx)
        i <- rh_json_skip_ws(input, val_end.usize())
        if i >= input.count:
            return -1
        if input[i] == 44:
            i <- i + 1
            continue
        if input[i] == 125:
            end_out[0] <- (i + 1).i64()
            return self_idx
        return -1
    return -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_json_array(input: darray[u8]&, pos: usize, depth: i64, nodes: mutable darray[RhJsonNode]&, texts: mutable darray[u8]&, end_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    end_out[0] <- -1
    self_idx: i64 = rh_json_emit(nodes, RH_JSON_ARR)
    if self_idx < 0:
        return -1
    i: mutable usize = rh_json_skip_ws(input, pos + 1)
    if i < input.count and input[i] == 93:
        end_out[0] <- (i + 1).i64()
        return self_idx
    while true |i, input, depth, nodes, texts, self_idx|:
        val_end: mutable i64 = 0
        val_idx: i64 = rh_json_value(input, i, depth + 1, nodes, texts, &val_end)
        if val_idx < 0:
            return -1
        rh_json_link(nodes, self_idx, val_idx)
        i <- rh_json_skip_ws(input, val_end.usize())
        if i >= input.count:
            return -1
        if input[i] == 44:
            i <- i + 1
            continue
        if input[i] == 93:
            end_out[0] <- (i + 1).i64()
            return self_idx
        return -1
    return -1

# Parse a whole document. Returns root idx, or -1 on any malformed input
# (including trailing garbage). Empty/whitespace-only input is malformed.
def rh_json_parse(input: darray[u8]&, nodes: mutable darray[RhJsonNode]&, texts: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    fin: mutable i64 = 0
    root: i64 = rh_json_value(input, 0, 0, nodes, texts, &fin)
    if root < 0:
        return -1
    rest: usize = rh_json_skip_ws(input, fin.usize())
    if rest != input.count:
        return -1
    return root

# Object member lookup by decoded key bytes. Returns value idx or -1.
# Children alternate key,value,key,value... (emitted as pairs).
def rh_json_obj_get(nodes: darray[RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
    if obj < 0:
        return -1
    o: RhJsonNode = nodes[obj.usize()]
    if o.kind != RH_JSON_OBJ:
        return -1
    kn: usize = strlen(key)
    child: mutable i64 = o.first_child
    while child >= 0 |child, nodes, texts, key, kn|:
        kn_node: RhJsonNode = nodes[child.usize()]
        vn: i64 = kn_node.next_sibling
        if kn_node.kind == RH_JSON_STR and vn >= 0:
            start: usize = kn_node.text_start.usize()
            stop: usize = kn_node.text_end.usize()
            if stop - start == kn:
                same: mutable bool = true
                k: mutable usize = 0
                while k < kn |k, texts, start, key, same|:
                    if texts[start + k] != key[k]:
                        same <- false
                    k <- k + 1
                if same:
                    return vn
            child <- nodes[vn.usize()].next_sibling
        else:
            if vn >= 0:
                child <- nodes[vn.usize()].next_sibling
            else:
                child <- -1
    return -1

# Array element by index. Returns idx or -1.
def rh_json_arr_get(nodes: darray[RhJsonNode]&, arr: i64, want: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    if arr < 0 or want < 0:
        return -1
    o: RhJsonNode = nodes[arr.usize()]
    if o.kind != RH_JSON_ARR:
        return -1
    child: mutable i64 = o.first_child
    at: mutable i64 = 0
    while child >= 0 |child, at, nodes, want|:
        if at == want:
            return child
        at <- at + 1
        child <- nodes[child.usize()].next_sibling
    return -1

# Decoded string span of a STR node into caller range check. ok_out 1/0.
def rh_json_str_span(nodes: darray[RhJsonNode]&, idx: i64, start_out: mutable i64&, end_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    if idx < 0:
        return false
    n: RhJsonNode = nodes[idx.usize()]
    if n.kind != RH_JSON_STR:
        return false
    start_out[0] <- n.text_start
    end_out[0] <- n.text_end
    return true

# Integer value of a NUM node with overflow check. ok_out 1/0.
def rh_json_int(nodes: darray[RhJsonNode]&, input: darray[u8]&, idx: i64, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    ok_out[0] <- 0
    if idx < 0:
        return 0
    n: RhJsonNode = nodes[idx.usize()]
    if n.kind != RH_JSON_NUM:
        return 0
    return rh_parse_i64(input, n.text_start.usize(), n.text_end.usize(), ok_out)

# True literal check.
def rh_json_is_true(nodes: darray[RhJsonNode]&, input: darray[u8]&, idx: i64) -> bool can[Memory.Allocate, Abort.Panic]:
    if idx < 0:
        return false
    n: RhJsonNode = nodes[idx.usize()]
    if n.kind != RH_JSON_BOOL:
        return false
    if n.text_end - n.text_start != 4:
        return false
    return input[n.text_start.usize()] == 116
