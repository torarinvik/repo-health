# test_forge_instance_events.elisa — focused harness for approved Gitea/Forgejo acquisition.

include "./rh_base.elisa"
include "./rh_git.elisa"
include "./rh_forge_events_fetch.elisa"

module ForgeInstanceEventsHarness:
    private:
        def rh_fieh_usage() -> i32:
            2

        def rh_fieh_run(instance_path: cstr, repository: cstr, page_limit: i64, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO, Memory.Release, Global{Read,Write}]:
            return 3 if not Git::rh_arg_safe(instance_path) or not Git::rh_arg_safe(repository) or not Git::rh_arg_safe(out_path) or Base::rh_streq(instance_path, out_path)
            instance_input: mutable darray[u8] = []
            read_status: i64 = Base::rh_io_read(instance_path, instance_input) can Global{Read,Write}
            return 4 if read_status < 0 or instance_input.count > 65536
            body: mutable darray[u8] = []
            fetch_status: i64 = ForgeEventsFetch::rh_forge_events_selfhosted_live(instance_input, repository, page_limit, out_path, body) can Global{Read,Write}
            return 4 if fetch_status != 0
            body.push(10)
            write_status: bool = Base::rh_io_write(out_path, body) can Global{Read,Write}
            return 4 if not write_status
            0

    public:
        def rh_forge_instance_events_harness_main(argc: i64, argv: mutable void&) -> i32 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO, Memory.Release, Global{Read,Write}]:
            return ForgeInstanceEventsHarness::rh_fieh_usage() if argc != 6
            slots: mutable cstr&& = argv.cast[mutable cstr&&]
            return ForgeInstanceEventsHarness::rh_fieh_usage() if not Base::rh_streq(slots[1], "--instance") or not Base::rh_streq(slots[3], "--max-pages")
            page_limit: i64 = 1 if Base::rh_streq(slots[4], "1") else 2 if Base::rh_streq(slots[4], "2") else 0
            return ForgeInstanceEventsHarness::rh_fieh_usage() if page_limit == 0
            ForgeInstanceEventsHarness::rh_fieh_run(slots[2], "owner/project", page_limit, slots[5]) can Global{Read,Write}

def main(argc: i64, argv: mutable void&) -> i32 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    ForgeInstanceEventsHarness::rh_forge_instance_events_harness_main(argc, argv) can Global{Read,Write}
