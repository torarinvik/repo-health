# rh_vcs_fossil.elisa — Fossil adapter (M08 native-VCS lane).
#
# Input is the documented machine format of `fossil timeline -F` (Fossil
# help: timeline), with a pipe-delimited placeholder string. This module
# expects exactly these seven fields per entry, in order:
#
#   %H | %a | %d | %b | %p | %t | %c
#   hash | author | date | branch | phase | tags | comment
#
# `%H` is the check-in artifact id (the manifest's own SHA hash). It is a
# FOSSIL artifact id, never converted to a Git hash and never treated as a
# Git revision. `%a` is a raw author login string, not an account and not a
# person. `%c` is documented by Fossil to have newlines/tabs replaced by
# spaces and LF erased, so a `|`-delimited record stays single-line; `|` is
# not produced inside `%a`/`%b`/`%p`/`%t`, and a comment containing `|` only
# affects that last field. `%p` carries Fossil phase tokens such as
# *CURRENT*, *MERGE*, *FORK*, *UNPUBLISHED*, *LEAF*, *BRANCH*; they are
# counted, not interpreted.
#
# Honest scope: Fossil artifact ids are SHA-1 (40 hex) or
# SHA-256 (64 hex) lowercase; any other shape is rejected, not guessed.
# Fields the format does not provide (reviews, proposals, traffic) stay
# unsupported in the capability manifest.
include "./rh_base.elisa"
include "./rh_temporal.elisa"

module Fossil:
    private:
        const RH_FOSSIL_MAX_ENTRIES_DEFAULT: i64 = 20000

        # One normalized entry. Spans index into the returned timeline pool.
    public:
        struct RhFossilEntry:
            hash_s: i64
            hash_e: i64
            author_s: i64
            author_e: i64
            has_author: bool
            date_s: i64
            date_e: i64
            utc: i64
            has_date: bool
            branch_s: i64
            branch_e: i64
            tag_count: i64
            phase_count: i64
            comment_s: i64
            comment_e: i64

    private:
        struct RhFossilLine:
            usable: bool
            entry: RhFossilEntry

    public:
        # Parsed timeline: ok, entries, decoded pool, rejected count.
        struct RhFossilTimeline:
            ok: bool
            entries: mutable darray[RhFossilEntry]
            pool: mutable darray[u8]
            rejected: mutable i64

        # 40 (SHA-1) or 64 (SHA-256) lowercase hex only.
        def rh_fossil_is_hash(data: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            ln: i64 = e - s
            return false if s < 0 or (ln != 40 and ln != 64)
            while i < e |valid: bool = true, i: i64 = s, e, data| -> valid:
                b: u8 = data[i.usize()]
                break false if not ((b >= 48 and b <= 57) or (b >= 97 and b <= 102))
                i <- i + 1

        def rh_fossil_parse(raw: darray[u8]&, max_entries: i64) -> RhFossilTimeline can[Memory.Allocate, Abort.Panic]:
            cap: i64 = RH_FOSSIL_MAX_ENTRIES_DEFAULT if max_entries <= 0 else max_entries
            entries: mutable darray[RhFossilEntry] = []
            pool: mutable darray[u8] = []
            return RhFossilTimeline{ok: false, entries: entries, pool: pool, rejected: 0} if raw.count == 0
            over, rejected =
                while true |over: bool = false, rejected: i64 = 0, pos: i64 = 0, raw, entries, pool, cap| -> over, rejected:
                    break if over
                    break if pos >= raw.count.i64()
                    le: i64 =
                        while le < raw.count.i64() and raw[le.usize()] != 10 |le: i64 = pos| -> le:
                            le <- le + 1
                    if le > pos:
                        if raw[pos.usize()] != 35:
                            if entries.count.i64() >= cap:
                                over <- true
                            else:
                                parsed: RhFossilLine = rh_fossil_line(raw, pos, le, pool)
                                if parsed.usable:
                                    entries.push(parsed.entry)
                                else:
                                    rejected <- rejected + 1
                    pos <- le + 1
            return RhFossilTimeline{ok: false, entries: entries, pool: pool, rejected: rejected} if over
            RhFossilTimeline{ok: true, entries: entries, pool: pool, rejected: rejected}

    private:
        # Count comma-separated non-empty items in [s,e).
        def rh_fossil_count_items(data: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if s < 0 or e <= s or e > data.count.i64()
            while i < e |total: i64 = 0, i: i64 = s, e, data| -> total:
                b: u8 = data[i.usize()]
                starts_item: bool = b != 44 and b != 32 and (i == s or data[(i - 1).usize()] == 44 or data[(i - 1).usize()] == 32)
                total <- total + (1 if starts_item else 0)
                i <- i + 1

        # Count Fossil phase tokens: occurrences of '*' in [s,e) divided by two
        # (each token is *NAME*). A lone '*' is ignored.
        def rh_fossil_count_phases(data: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if s < 0 or e <= s
            stars: i64 =
                while i < e |stars: i64 = 0, i: i64 = s| -> stars:
                    if data[i.usize()] == 42:
                        stars <- stars + 1
                    i <- i + 1
            stars / 2

        # Parse exactly two decimal digits beginning at s; -1 when malformed.
        def rh_fossil_num2(data: darray[u8]&, s: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if s < 0 or s + 2 > data.count.i64()
            a: u8 = data[s.usize()]
            b: u8 = data[(s + 1).usize()]
            return -1 if a < 48 or a > 57 or b < 48 or b > 57
            (a.i64() - 48) * 10 + (b.i64() - 48)

        # Parse YYYY-MM-DDTHH:MM:SS[.frac][Z|±HH:MM] into UTC seconds. Returns -1
        # on any shape we do not accept (never guessed). Seconds precision is
        # kept; fractional seconds are ignored.
        def rh_fossil_iso(data: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if s < 0 or e - s < 19 or e > data.count.i64()
            return -1 if data[(s + 4).usize()] != 45 or data[(s + 7).usize()] != 45
            return -1 if data[(s + 10).usize()] != 84
            return -1 if data[(s + 13).usize()] != 58 or data[(s + 16).usize()] != 58
            y: i64 =
                while i < s + 4 |y: i64 = 0, i: i64 = s| -> y:
                    c: u8 = data[i.usize()]
                    return -1 if c < 48 or c > 57
                    y <- y * 10 + (c.i64() - 48)
                    i <- i + 1
            mo: i64 = rh_fossil_num2(data, s + 5)
            return -1 if mo < 0
            dy: i64 = rh_fossil_num2(data, s + 8)
            return -1 if dy < 0
            hh: i64 = rh_fossil_num2(data, s + 11)
            return -1 if hh < 0
            mi: i64 = rh_fossil_num2(data, s + 14)
            return -1 if mi < 0
            ss: i64 = rh_fossil_num2(data, s + 17)
            return -1 if ss < 0
            return -1 if not Temporal::rh_civil_date_valid(y, mo, dy) or hh > 23 or mi > 59 or ss > 60
            tzoff: mutable i64 = 0
            rest: mutable i64 = s + 19
            if rest < e:
                c2: u8 = data[rest.usize()]
                if c2 == 90:
                    rest <- rest + 1
                elif c2 == 46:
                    rest <- rest + 1
                    while rest < e and data[rest.usize()] >= 48 and data[rest.usize()] <= 57 |rest, e, data|:
                        rest <- rest + 1
                    if rest < e and data[rest.usize()] == 90:
                        rest <- rest + 1
                elif c2 == 43 or c2 == 45:
                    sign: i64 = 1 if c2 == 43 else -1
                    oh: i64 = rh_fossil_num2(data, rest + 1)
                    return -1 if oh < 0 or rest + 4 > e or data[(rest + 3).usize()] != 58
                    om: i64 = rh_fossil_num2(data, rest + 4)
                    return -1 if om < 0
                    tzoff <- sign * (oh * 3600 + om * 60)
                    rest <- rest + 6
            return -1 if rest != e
            base: mutable i64 = 0
            return -1 if not Temporal::rh_unix_from_civil_time_checked(y, mo, dy, hh, mi, ss, tzoff, &base)
            base

        # Parse one pipe-delimited timeline record. Invalid native hashes return
        # an unusable result; valid records retain spans into the timeline pool.
        def rh_fossil_line(raw: darray[u8]&, s: i64, e: i64, pool: mutable darray[u8]&) -> RhFossilLine can[Memory.Allocate, Abort.Panic]:
            empty: RhFossilEntry = RhFossilEntry{hash_s: -1, hash_e: -1, author_s: -1, author_e: -1, has_author: false, date_s: -1, date_e: -1, utc: -1, has_date: false, branch_s: -1, branch_e: -1, tag_count: 0, phase_count: 0, comment_s: -1, comment_e: -1}
            f0: i64 = s
            f1: i64 = rh_fossil_pipe(raw, f0, e)
            return RhFossilLine{usable: false, entry: empty} if f1 < 0
            return RhFossilLine{usable: false, entry: empty} if not rh_fossil_is_hash(raw, f0, f1)
            hash_s: i64 = Base::rh_absorb_span(raw, f0, f1, pool)
            hash_e: i64 = hash_s + (f1 - f0)
            # author
            a0: i64 = f1 + 1
            a1: i64 =
                found: i64 = rh_fossil_pipe(raw, a0, e)
                e if found < 0 else found
            author_s: mutable i64 = -1
            author_e: mutable i64 = -1
            has_author: bool = a1 > a0
            if a1 > a0:
                author_s <- Base::rh_absorb_span(raw, a0, a1, pool)
                author_e <- author_s + (a1 - a0)
            # date
            d0: i64 = a1 + 1
            d1: i64 =
                found: i64 = rh_fossil_pipe(raw, d0, e)
                e if found < 0 else found
            date_s: mutable i64 = -1
            date_e: mutable i64 = -1
            utc: mutable i64 = -1
            has_date: mutable bool = false
            if d1 > d0:
                date_s <- Base::rh_absorb_span(raw, d0, d1, pool)
                date_e <- date_s + (d1 - d0)
                parsed: i64 = rh_fossil_iso(raw, d0, d1)
                if parsed >= 0:
                    utc <- parsed
                    has_date <- true
            # branch
            b0: i64 = d1 + 1
            b1: i64 =
                found: i64 = rh_fossil_pipe(raw, b0, e)
                e if found < 0 else found
            branch_s: mutable i64 = -1
            branch_e: mutable i64 = -1
            if b1 > b0:
                branch_s <- Base::rh_absorb_span(raw, b0, b1, pool)
                branch_e <- branch_s + (b1 - b0)
            # phase
            p0: i64 = b1 + 1
            p1: i64 =
                found: i64 = rh_fossil_pipe(raw, p0, e)
                e if found < 0 else found
            phase_count: i64 = rh_fossil_count_phases(raw, p0, p1)
            # tags
            t0: i64 = p1 + 1
            t1: i64 =
                found: i64 = rh_fossil_pipe(raw, t0, e)
                e if found < 0 else found
            tag_count: i64 = rh_fossil_count_items(raw, t0, t1)
            # comment (rest of line, may contain '|')
            c0: i64 = t1 + 1
            comment_s: mutable i64 = -1
            comment_e: mutable i64 = -1
            if c0 <= e:
                comment_s <- Base::rh_absorb_span(raw, c0, e, pool)
                comment_e <- comment_s + (e - c0)
            RhFossilLine{usable: true, entry: RhFossilEntry{hash_s: hash_s, hash_e: hash_e, author_s: author_s, author_e: author_e, has_author: has_author, date_s: date_s, date_e: date_e, utc: utc, has_date: has_date, branch_s: branch_s, branch_e: branch_e, tag_count: tag_count, phase_count: phase_count, comment_s: comment_s, comment_e: comment_e}}

        # Index of the next '|' in [from, e), or -1.
        def rh_fossil_pipe(data: darray[u8]&, from: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < e |i: i64 = from, e, data|:
                return i if data[i.usize()] == 124
                i <- i + 1
            -1
