# Field and lineage record for the PEP 621 to PEP 751 membership projection.
include "./rh_base.elisa"

module PylockProjectTransformation:
    public:
        def rh_pylock_project_transformation_report(configuration_sha: darray[u8]&, project_sha: darray[u8]&, audit_sha: darray[u8]&, output_sha: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"pep621-pylock-membership\",\"source_input_sha256\":\"")
            out.extend(bytes_view(project_sha))
            Base::rh_push_text(out, "\",\"source_audit_sha256\":\"")
            out.extend(bytes_view(audit_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-pylock-project-membership/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"PEP 621 direct requirements and optional-dependency keys\",\"target\":\"packages[].name|scope|optional_group|pinned_version\",\"state\":\"preserved\"},{\"source\":\"PEP 751 package names and versions\",\"target\":\"packages[].*_candidate_count|state\",\"state\":\"transformed\"},{\"source\":\"complete PEP 508 requirement text\",\"target\":\"packages[].declaration_sha256\",\"state\":\"transformed\"},{\"source\":\"direct-reference URL and credentials\",\"target\":\"report output\",\"state\":\"discarded\"},{\"source\":\"installer dependency edges and marker selection\",\"target\":\"installation_graph|markers_evaluated\",\"state\":\"unsupported\"}]}")
