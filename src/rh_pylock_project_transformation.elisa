# Field and lineage record for the PEP 621 to PEP 751 membership projection.
include "./rh_base.elisa"

module PylockProjectTransformation:
    public:
        def rh_pylock_project_transformation_report(configuration_sha: darray[u8]&, project_sha: darray[u8]&, audit_sha: darray[u8]&, context_sha: darray[u8]&, has_context: bool, output_sha: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"pep621-pylock-membership\",\"source_input_sha256\":\"")
            out.extend(bytes_view(project_sha))
            Base::rh_push_text(out, "\",\"source_audit_sha256\":\"")
            out.extend(bytes_view(audit_sha))
            Base::rh_push_text(out, "\",\"source_context_sha256\":")
            if has_context:
                out.push(34)
                out.extend(bytes_view(context_sha))
                out.push(34)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, ",\"output_schema\":\"rh-pylock-project-membership/1\",\"normalizer_version\":\"1.2.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"PEP 621 direct requirements and optional-dependency keys\",\"target\":\"packages[].name|scope|optional_group|pinned_version\",\"state\":\"preserved\"},{\"source\":\"PEP 751 package names and versions\",\"target\":\"packages[].*_candidate_count|state\",\"state\":\"transformed\"},")
            Base::rh_push_text(out, "{\"source\":\"bounded PEP 440 specifiers\",\"target\":\"packages[].specifier_candidate_count|coverage.specifier_match_count\",\"state\":\"transformed\"},")
            Base::rh_push_text(out, "{\"source\":\"PEP 621 markers and selected context\",\"target\":\"context_sha256|packages[].marker_state\",\"state\":\"transformed\"},{\"source\":\"complete PEP 508 requirement text\",\"target\":\"packages[].declaration_sha256\",\"state\":\"transformed\"},{\"source\":\"direct-reference URL and credentials\",\"target\":\"report output\",\"state\":\"discarded\"},{\"source\":\"installer dependency edges and complete resolution\",\"target\":\"installation_graph\",\"state\":\"unsupported\"}]}")
