    iso_ok: mutable i64 = 0
    iso_doc: mutable darray[u8] = []
    Base::rh_push_text(iso_doc, "2024-03-10T12:00:00Z")
    check(Forge::rh_parse_iso8601(iso_doc, 0, iso_doc.count, &iso_ok) == 1710072000 and iso_ok == 1, "iso-zulu", &fails)
    iso2: mutable darray[u8] = []
    Base::rh_push_text(iso2, "2024-03-10T14:00:00+02:00")
    iso_ok2: mutable i64 = 0
    check(Forge::rh_parse_iso8601(iso2, 0, iso2.count, &iso_ok2) == 1710072000 and iso_ok2 == 1, "iso-offset", &fails)
    bad_iso: mutable darray[u8] = []
    Base::rh_push_text(bad_iso, "2024-02-30T00:00:00Z")
    bad_ok: mutable i64 = 0
    Forge::rh_parse_iso8601(bad_iso, 0, bad_iso.count, &bad_ok)
    check(bad_ok == 0, "iso-feb30", &fails)
    bad_iso2: mutable darray[u8] = []
    Base::rh_push_text(bad_iso2, "2024-03-10T24:00:00Z")
    bad_ok2: mutable i64 = 0
    Forge::rh_parse_iso8601(bad_iso2, 0, bad_iso2.count, &bad_ok2)
    check(bad_ok2 == 0, "iso-hour24", &fails)
    bad_iso3: mutable darray[u8] = []
    Base::rh_push_text(bad_iso3, "2024-03-10 12:00:00Z")
    bad_ok3: mutable i64 = 0
    Forge::rh_parse_iso8601(bad_iso3, 0, bad_iso3.count, &bad_ok3)
    check(bad_ok3 == 0, "iso-space", &fails)

# --- M02 JSON inline vectors ---
    jdoc: mutable darray[u8] = []
    Base::rh_push_text(jdoc, "{\"id\": 7288, \"ok\": true, \"tags\": []}")
    jn: mutable darray[Json::RhJsonNode] = []
    jt: mutable darray[u8] = []
    jroot: i64 = Json::rh_json_parse(jdoc, jn, jt)
    check(jroot >= 0, "json-root", &fails)
    jid_ok: mutable i64 = 0
    check(Json::rh_json_int(jn, jdoc, Json::rh_json_obj_get(jn, jt, jroot, "id"), &jid_ok) == 7288 and jid_ok == 1, "json-int", &fails)
    check(Json::rh_json_is_true(jn, jdoc, Json::rh_json_obj_get(jn, jt, jroot, "ok")), "json-true", &fails)
    check(Json::rh_json_obj_get(jn, jt, jroot, "missing") == -1, "json-absent", &fails)
    jbad: mutable darray[u8] = []
    Base::rh_push_text(jbad, "{\"a\": }")
    jn2: mutable darray[Json::RhJsonNode] = []
    jt2: mutable darray[u8] = []
    check(Json::rh_json_parse(jbad, jn2, jt2) == -1, "json-malformed", &fails)

# --- M01-01/M01-02 URL classification + allowlist (S002/S003) ---
    check(Git::rh_url_kind("/tmp/repo") == Git::RH_URL_LOCAL, "url-local-abs", &fails)
    check(Git::rh_url_kind("./rel/repo") == Git::RH_URL_LOCAL, "url-local-rel", &fails)
    check(Git::rh_url_kind("https://example.com/a/b") == Git::RH_URL_HTTPS, "url-https", &fails)
    check(Git::rh_url_kind("http://example.com/a") == Git::RH_URL_UNSUPPORTED, "url-http-rejected", &fails)
    check(Git::rh_url_kind("ssh://example.com/a") == Git::RH_URL_UNSUPPORTED, "url-ssh-rejected", &fails)
    check(Git::rh_url_kind("git@example.com:a/b") == Git::RH_URL_UNSUPPORTED, "url-scp-rejected", &fails)
    check(Git::rh_url_kind("file:///tmp/x") == Git::RH_URL_UNSUPPORTED, "url-file-rejected", &fails)
    check(Git::rh_url_kind("") == Git::RH_URL_UNSUPPORTED, "url-empty-rejected", &fails)
    check(Git::rh_arg_safe("/tmp/rh-out-1"), "allow-path", &fails)
    check(Git::rh_arg_safe("https://example.com/a/b"), "allow-https", &fails)
    check(not Git::rh_arg_safe("a;b"), "deny-semicolon", &fails)
    check(not Git::rh_arg_safe("a b"), "deny-space", &fails)
    check(not Git::rh_arg_safe("a'b"), "deny-quote", &fails)
    check(not Git::rh_arg_safe("a$b"), "deny-dollar", &fails)
    check(not Git::rh_arg_safe("a`b"), "deny-backtick", &fails)
    check(not Git::rh_arg_safe("a|b"), "deny-pipe", &fails)
    check(not Git::rh_arg_safe("a&b"), "deny-amp", &fails)
    check(not Git::rh_arg_safe("a@b"), "deny-at", &fails)
    check(not Git::rh_arg_safe(""), "deny-empty", &fails)
    check(not Git::rh_arg_safe("$(id)"), "deny-subst", &fails)

    if fails == 0:
        Base::rh_print_line("ORACLES OK")
        return 0
    summary: mutable darray[u8] =
        summary: mutable darray[u8] = []
        Base::rh_push_text(summary, "ORACLES FAIL count=")
        Base::rh_push_decimal_i64(summary, fails)
        summary.push(10)
        summary
    Base::rh_write_stdout(summary)
    1
