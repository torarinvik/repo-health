# test_oracles.elisa — M00 acceptance oracles (independent of prod code paths
# except through the published function contracts; expected values below are
# hand-computed from the plan, not copied from implementation output).
#
# Exit 0 when every check passes, 1 otherwise. Prints one line per failure
# plus a final summary line.

include "./rh_base.elisa"
include "./rh_domain.elisa"
include "./rh_temporal.elisa"
include "./rh_observation.elisa"
include "./rh_observation_codec.elisa"
include "./rh_registry.elisa"
include "./rh_evidence.elisa"
include "./rh_metrics.elisa"
include "./rh_git.elisa"
include "./rh_json.elisa"
include "./rh_forge.elisa"


def check(condition: bool, label: u8&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    return if condition
    fails[0] <- fails[0] + 1
    buffer: mutable darray[u8] =
        buffer: mutable darray[u8] = []
        Base::rh_push_text(buffer, "FAIL ")
        Base::rh_push_text(buffer, label)
        buffer.push(10)
        buffer
    Base::rh_write_stdout(buffer)

def observation_roundtrip(observation: Observation::RhObservation) -> bool can[Memory.Allocate, Abort.Panic]:
    encoded: mutable darray[u8] = []
    return false if not ObservationCodec::rh_observation_encode(observation, encoded)
    decoded: mutable Observation::RhObservation = observation
    return false if not ObservationCodec::rh_observation_decode(encoded, &decoded)
    reencoded: mutable darray[u8] = []
    return false if not ObservationCodec::rh_observation_encode(decoded, reencoded)
    Base::rh_bytes_equal_span(encoded, 0, encoded.count.i64(), reencoded, 0, reencoded.count.i64())

def observation_decode_rejects(document: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    raw: mutable darray[u8] = []
    Base::rh_push_text(raw, document)
    decoded: mutable Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_UNAVAILABLE, Observation::RhMetricValue.Absent, false)
    not ObservationCodec::rh_observation_decode(raw, &decoded)

def observation_decode_rejects_overbound_evidence() -> bool can[Memory.Allocate, Abort.Panic]:
    raw: mutable darray[u8] = []
    Base::rh_push_text(raw, "{\"status\":0,\"value\":{\"kind\":\"count\",\"value\":0},\"incomplete\":false,\"quality\":{\"completeness\":\"unknown\",\"freshness\":\"unknown\",\"validity\":\"unknown\",\"provenance\":\"unknown\"},\"evidence\":[")
    for index in 0..<(Observation::RH_MAX_EVIDENCE_LINKS + 1) |index, raw|:
        Base::rh_push_text(raw, "\"git_log\"")
        Base::rh_push_text(raw, ",") if index < Observation::RH_MAX_EVIDENCE_LINKS
    Base::rh_push_text(raw, "]}")
    decoded: mutable Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_UNAVAILABLE, Observation::RhMetricValue.Absent, false)
    not ObservationCodec::rh_observation_decode(raw, &decoded)

def observation_metric_emits_value(value: Observation::RhMetricValue, expected_value: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
    quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{completeness: Observation::RhCompleteness.Complete, freshness: Observation::RhFreshness.Unknown, validity: Observation::RhValidity.Valid, provenance: Observation::RhProvenanceQuality.EvidenceBacked}
    evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
    Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.GitLog)
    observation: Observation::RhObservation = Observation::rh_observation_make_with_evidence(Observation::RH_ST_OBSERVED, value, false, quality, evidence)
    actual: mutable darray[u8] = []
    return false if not Observation::rh_observation_emit_metric(actual, "test.metric", "1.0.0", "", observation)
    expected: mutable darray[u8] = []
    Base::rh_push_text(expected, "{\"key\":\"test.metric\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
    Base::rh_push_cstr(expected, expected_value)
    Base::rh_push_text(expected, ",\"evidence\":[\"git_log\"],\"quality_dimensions\":{\"completeness\":\"complete\",\"freshness\":\"unknown\",\"validity\":\"valid\",\"provenance\":\"evidence_backed\"}}")
    Base::rh_bytes_equal_span(actual, 0, actual.count.i64(), expected, 0, expected.count.i64())

def observation_metric_emits_optional_reason(reason: cstr, expected_reason_field: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
    observation: Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_NOT_APPLICABLE, Observation::RhMetricValue.Absent, false)
    actual: mutable darray[u8] = []
    return false if not Observation::rh_observation_emit_metric(actual, "test.metric", "1.0.0", reason, observation)
    expected: mutable darray[u8] = []
    Base::rh_push_text(expected, "{\"key\":\"test.metric\",\"version\":\"1.0.0\",\"status\":\"not_applicable\",\"value\":null")
    Base::rh_push_cstr(expected, expected_reason_field)
    Base::rh_push_text(expected, ",\"evidence\":[],\"quality_dimensions\":{\"completeness\":\"unknown\",\"freshness\":\"unknown\",\"validity\":\"unknown\",\"provenance\":\"unknown\"}}")
    Base::rh_bytes_equal_span(actual, 0, actual.count.i64(), expected, 0, expected.count.i64())

def bitemporal_cross_product_oracle(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    # Compare the public predicates with the plan's interval definition over
    # every small endpoint combination. End modes 0..3 name a fixed endpoint;
    # mode 4 names an open endpoint.
    for valid_start in 0..<4 |valid_start, fails|:
        for valid_end_mode in 0..<5 |valid_end_mode, valid_start, fails|:
            valid_end_known: bool = valid_end_mode < 4
            valid_end: i64 = valid_end_mode if valid_end_known else 0
            for known_start in 0..<4 |known_start, valid_start, valid_end, valid_end_known, fails|:
                for known_end_mode in 0..<5 |known_end_mode, valid_start, valid_end, valid_end_known, known_start, fails|:
                    known_end_known: bool = known_end_mode < 4
                    known_end: i64 = known_end_mode if known_end_known else 0
                    fact: Temporal::RhBitemporal = Temporal::rh_bitemporal_make(valid_start, valid_end, valid_end_known, known_start, known_end, known_end_known)
                    expected_valid: bool = (not valid_end_known or valid_end > valid_start) and (not known_end_known or known_end > known_start)
                    check(Temporal::rh_bitemporal_valid(fact) == expected_valid, "bitemporal-cross-product-validity", fails)
                    for known_at in -1..<5 |known_at, fact, expected_valid, fails|:
                        expected_as_of: bool = expected_valid and known_at >= fact.known_start and (not fact.known_end_known or known_at < fact.known_end)
                        check(Temporal::rh_visible_as_of(fact, known_at) == expected_as_of, "bitemporal-cross-product-system-time", fails)
                        for valid_at in -1..<5 |valid_at, known_at, fact, expected_valid, fails|:
                            expected_visible: bool = expected_valid and valid_at >= fact.valid_start and (not fact.valid_end_known or valid_at < fact.valid_end) and known_at >= fact.known_start and (not fact.known_end_known or known_at < fact.known_end)
                            check(Temporal::rh_bitemporal_visible_at(fact, valid_at, known_at) == expected_visible, "bitemporal-cross-product-two-axis-visibility", fails)
    malformed_open_valid: Temporal::RhBitemporal = Temporal::RhBitemporal{valid_start: 0, valid_end: 1, valid_end_known: false, known_start: 0, known_end: 0, known_end_known: false}
    malformed_open_known: Temporal::RhBitemporal = Temporal::RhBitemporal{valid_start: 0, valid_end: 0, valid_end_known: false, known_start: 0, known_end: 1, known_end_known: false}
    check(not Temporal::rh_bitemporal_valid(malformed_open_valid), "bitemporal-open-valid-end-canonicalized", fails)
    check(not Temporal::rh_bitemporal_valid(malformed_open_known), "bitemporal-open-known-end-canonicalized", fails)

def gregorian_cycle_oracle(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    # Count days forward from the Unix epoch independently of the production
    # civil-date conversion, then check every date in one Gregorian cycle.
    expected_days: mutable i64 = 0
    for year in 1970..<2000 |year, expected_days|:
        expected_days <- expected_days + 365
        leap: bool = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
        expected_days <- expected_days + 1 if leap
    for year in 2000..<2400 |year, expected_days, fails|:
        for month in 1..<13 |month, year, expected_days, fails|:
            leap: bool = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
            days_in_month: i64 =
                if month == 2:
                    29 if leap else 28
                elif month == 4 or month == 6 or month == 9 or month == 11:
                    30
                else:
                    31
            for day in 1..<(days_in_month + 1) |day, year, month, expected_days, fails|:
                matches: bool =
                    instant: mutable i64 = -1
                    round_year: mutable i64 = 0
                    round_month: mutable i64 = 0
                    round_day: mutable i64 = 0
                    converted: bool = Temporal::rh_unix_from_civil_checked(year, month, day, &instant)
                    Temporal::rh_civil_from_days(expected_days, &round_year, &round_month, &round_day)
                    Temporal::rh_civil_date_valid(year, month, day) and converted and instant == expected_days * 86400 and Temporal::rh_days_from_civil(year, month, day) == expected_days and round_year == year and round_month == month and round_day == day
                check(matches, "gregorian-400-year-cycle-roundtrip", fails)
                expected_days <- expected_days + 1

def oracle_days_from_epoch(year: i64, month: i64, day: i64) -> i64:
    # Count Gregorian leap years arithmetically, independently of the
    # production civil-date conversion and without a year-sized iteration.
    last_year: i64 = year - 1
    leap_days_before_epoch: i64 = 1969 / 4 - 1969 / 100 + 1969 / 400
    leap_days: i64 = last_year / 4 - last_year / 100 + last_year / 400 - leap_days_before_epoch
    days: mutable i64 = (year - 1970) * 365 + leap_days
    for current_month in 1..<month |current_month, year, days|:
        leap: bool = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
        days_in_month: i64 =
            if current_month == 2:
                29 if leap else 28
            elif current_month == 4 or current_month == 6 or current_month == 9 or current_month == 11:
                30
            else:
                31
        days <- days + days_in_month
    days + day - 1

def timezone_offset_case(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64, offset_seconds: i64, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    local_seconds: i64 = oracle_days_from_epoch(year, month, day) * 86400 + hour * 3600 + minute * 60 + second
    expected_utc: i64 = local_seconds - offset_seconds
    instant: mutable i64 = 123
    converted: bool = Temporal::rh_unix_from_civil_time_checked(year, month, day, hour, minute, second, offset_seconds, &instant)
    matches: bool = instant == expected_utc if converted else expected_utc < 0 and instant == 123
    check(matches, "timezone-offset-independent-cross-product", fails)

def timezone_offset_date_oracle(year: i64, month: i64, day: i64, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    for hour_mode in 0..<2 |hour_mode, year, month, day, fails|:
        hour: i64 = 23 if hour_mode == 1 else 0
        for minute_mode in 0..<2 |minute_mode, year, month, day, hour, fails|:
            minute: i64 = 59 if minute_mode == 1 else 0
            for second_mode in 0..<2 |second_mode, year, month, day, hour, minute, fails|:
                second: i64 = 59 if second_mode == 1 else 0
                for offset_mode in 0..<5 |offset_mode, year, month, day, hour, minute, second, fails|:
                    offset_seconds: i64 =
                        if offset_mode == 0:
                            -86340
                        elif offset_mode == 1:
                            -3600
                        elif offset_mode == 2:
                            0
                        elif offset_mode == 3:
                            3600
                        else:
                            86340
                    timezone_offset_case(year, month, day, hour, minute, second, offset_seconds, fails)

def observation_evidence_roundtrip() -> bool can[Memory.Allocate, Abort.Panic]:
    quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{completeness: Observation::RhCompleteness.Unknown, freshness: Observation::RhFreshness.Unknown, validity: Observation::RhValidity.Unknown, provenance: Observation::RhProvenanceQuality.Unknown}
    evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
    Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.GitLog)
    Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.GitShallow)
    Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.GitFiles)
    Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.GitDefaultCount)
    Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.BundleManifest)
    observation: Observation::RhObservation = Observation::rh_observation_make_with_evidence(Observation::RH_ST_OBSERVED, Observation::RhMetricValue.Count(2), false, quality, evidence)
    encoded: mutable darray[u8] = []
    return false if not ObservationCodec::rh_observation_encode(observation, encoded)
    decoded: mutable Observation::RhObservation = observation
    return false if not ObservationCodec::rh_observation_decode(encoded, &decoded)
    return false if Observation::rh_evidence_links_count(decoded.evidence) != 5
    return false if Observation::rh_evidence_links_get(decoded.evidence, 0) != Observation::RhEvidenceObject.GitLog
    return false if Observation::rh_evidence_links_get(decoded.evidence, 1) != Observation::RhEvidenceObject.GitShallow
    return false if Observation::rh_evidence_links_get(decoded.evidence, 2) != Observation::RhEvidenceObject.GitFiles
    return false if Observation::rh_evidence_links_get(decoded.evidence, 3) != Observation::RhEvidenceObject.GitDefaultCount
    Observation::rh_evidence_links_get(decoded.evidence, 4) == Observation::RhEvidenceObject.BundleManifest

def observation_external_evidence_roundtrip() -> bool can[Memory.Allocate, Abort.Panic]:
    raw: mutable darray[u8] = []
    Base::rh_push_text(raw, "{\"status\":0,\"value\":{\"kind\":\"count\",\"value\":1},\"incomplete\":false,\"quality\":{\"completeness\":\"complete\",\"freshness\":\"unknown\",\"validity\":\"valid\",\"provenance\":\"evidence_backed\"},\"evidence\":[\"oci://registry.invalid/artifact/\\\"quoted\\\"\",\"s3://bucket/object/2\"]}")
    decoded: mutable Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_UNAVAILABLE, Observation::RhMetricValue.Absent, false)
    return false if not ObservationCodec::rh_observation_decode(raw, &decoded)
    return false if Observation::rh_evidence_links_count(decoded.evidence) != 2
    return false if Observation::rh_evidence_links_get(decoded.evidence, 0) != Observation::RhEvidenceObject.External
    encoded: mutable darray[u8] = []
    return false if not ObservationCodec::rh_observation_encode(decoded, encoded)
    roundtripped: mutable Observation::RhObservation = decoded
    return false if not ObservationCodec::rh_observation_decode(encoded, &roundtripped)
    expected_link: Observation::RhEvidenceLink = Observation::rh_evidence_links_get_link(decoded.evidence, 0)
    actual_link: Observation::RhEvidenceLink = Observation::rh_evidence_links_get_link(roundtripped.evidence, 0)
    expected_second: Observation::RhEvidenceLink = Observation::rh_evidence_links_get_link(decoded.evidence, 1)
    actual_second: Observation::RhEvidenceLink = Observation::rh_evidence_links_get_link(roundtripped.evidence, 1)
    string_views_eq(expected_link.locator, actual_link.locator) == 1 and string_views_eq(expected_second.locator, actual_second.locator) == 1

def check_byte_helpers(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    empty: darray[u8] = []
    check(Base::rh_bytes_equal_literal(empty, 0, 0, ""), "empty-span-equality", fails)
    check(not Base::rh_bytes_equal_literal(empty, 0, 1, ""), "invalid-span-not-clamped", fails)
    check(Base::rh_find_byte(empty, 0, 0) == -1, "empty-byte-search", fails)
    check(hash_sview(bytes_view(empty)) == 14695981039346656037, "fnv-empty-offset-basis", fails)
    binary: darray[u8] =
        bytes: mutable darray[u8] =
            bytes: mutable darray[u8] = []
            bytes.push(97)
            bytes.push(0)
            bytes.push(98)
            bytes
        bytes
    check(Base::rh_find_byte(binary, 0, 0) == 1, "binary-search-includes-nul", fails)
    check(Base::rh_find_byte(binary, 1, 98) == 2, "byte-search-absolute-offset", fails)
    check(Base::rh_find_byte(binary, 2, 97) == -1, "byte-search-respects-start", fails)
    check(Base::rh_find_byte(binary, 3, 0) == -1, "byte-search-at-end", fails)
    check(Base::rh_find_byte(binary, 99, 0) == -1, "byte-search-past-end", fails)
    check(Base::rh_bytes_equal_literal(binary, 2, 3, "b"), "span-after-nul", fails)
    check(not Base::rh_bytes_equal_literal(binary, 0, 3, "a"), "span-not-truncated-at-nul", fails)
    check(not Base::rh_bytes_equal_literal(binary, -1, 1, "a"), "negative-span-rejected", fails)
    check(not Base::rh_bytes_equal_literal(binary, 2, 1, ""), "reversed-span-rejected", fails)
    check(Base::rh_bytes_equal_literal(binary, 3, 3, ""), "empty-span-at-end", fails)
    check(not Base::rh_bytes_equal_literal(binary, 4, 4, ""), "empty-span-past-end-rejected", fails)
    check(Base::rh_bytes_equal_span(binary, 0, 3, binary, 0, 3), "binary-span-self-equality", fails)
    check(not Base::rh_bytes_equal_span(binary, 0, 1, binary, 2, 3), "distinct-byte-spans", fails)
    check(not Base::rh_bytes_equal_span(binary, 0, 3, binary, 0, 4), "invalid-right-span-rejected", fails)
    check(not Base::rh_bytes_equal_span(binary, -1, 3, binary, 0, 3), "invalid-left-span-rejected", fails)
    check(Base::rh_bytes_equal_span(empty, 0, 0, binary, 3, 3), "empty-cross-buffer-spans", fails)
    appended: darray[u8] = |fails|
        bytes: mutable darray[u8] = []
        Base::rh_push_text(bytes, "x")
        check(Base::rh_absorb_bytes(empty, bytes) == 0, "append-empty-count", fails)
        check(Base::rh_absorb_bytes(binary, bytes) == 3, "append-binary-count", fails)
        bytes
    check(appended.count == 4 and appended[0] == 120 and appended[1] == 97 and appended[2] == 0 and appended[3] == 98, "append-preserves-binary-bytes", fails)
    check(Base::rh_cstr_starts_with("abc", ""), "empty-prefix", fails)
    check(Base::rh_cstr_starts_with("abc", "ab"), "matching-prefix", fails)
    check(not Base::rh_cstr_starts_with("ab", "abc"), "longer-prefix-rejected", fails)
    check(hash_sview(sview("abc", 0, -1)) == 16654208175385433931, "fnv-abc-known-answer", fails)

def main() -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    fails: mutable i64 = 0
    check_byte_helpers(&fails)

# --- M00-02 identity invariants ---
    check(Domain::RH_KIND_ACCOUNT != Domain::RH_KIND_PERSON, "account-kind-ne-person", &fails)
    check(Domain::RH_KIND_PROJECT != Domain::RH_KIND_ACCOUNT, "project-kind-ne-account", &fails)
    check(Domain::RH_KIND_PACKAGE_VERSION != Domain::RH_KIND_ARTIFACT, "version-kind-ne-artifact", &fails)
    a: Domain::RhId = Domain::rh_id_make(Domain::RH_KIND_ACCOUNT, 7, 9)
    p: Domain::RhId = Domain::rh_id_make(Domain::RH_KIND_PERSON, 7, 9)
    check(Domain::rh_id_equal(a, a), "id-self-equal", &fails)
    check(not Domain::rh_id_equal(a, p), "cross-kind-never-equal", &fails)
    check(not Domain::rh_id_valid(Domain::rh_id_make(255, 7, 9)), "unknown-domain-kind-rejected", &fails)
    project_id: Domain::RhProjectId = Domain::rh_project_id_make(7, 9)
    account_id: Domain::RhAccountId = Domain::rh_account_id_make(7, 9)
    check(project_id.id.kind == Domain::RH_KIND_PROJECT and account_id.id.kind == Domain::RH_KIND_ACCOUNT, "nominal-domain-constructors-fix-kind", &fails)
    check(Domain::rh_project_id_valid(project_id) and Domain::rh_account_id_valid(account_id), "nominal-domain-validators-accept-matching-kinds", &fails)
    malformed_project: Domain::RhProjectId = Domain::RhProjectId{id: account_id.id}
    malformed_evidence: Domain::RhEvidenceId = Domain::RhEvidenceId{id: Domain::rh_artifact_id_make(1, 2).id}
    check(not Domain::rh_project_id_valid(malformed_project) and not Domain::rh_evidence_id_valid(malformed_evidence), "nominal-domain-validators-reject-cross-kind-wrappers", &fails)
    check(Domain::rh_repository_id_make(1, 2).id.kind == Domain::RH_KIND_REPOSITORY and Domain::rh_person_id_make(1, 2).id.kind == Domain::RH_KIND_PERSON and Domain::rh_revision_id_make(1, 2).id.kind == Domain::RH_KIND_REVISION, "nominal-repository-person-revision-kinds", &fails)
    check(Domain::rh_package_id_make(1, 2).id.kind == Domain::RH_KIND_PACKAGE and Domain::rh_package_version_id_make(1, 2).id.kind == Domain::RH_KIND_PACKAGE_VERSION, "nominal-package-kinds", &fails)
    check(Domain::rh_artifact_id_make(1, 2).id.kind == Domain::RH_KIND_ARTIFACT and Domain::rh_evidence_id_make(1, 2).id.kind == Domain::RH_KIND_EVIDENCE, "nominal-artifact-evidence-kinds", &fails)
    check(Domain::rh_graph_snapshot_id_make(1, 2).id.kind == Domain::RH_KIND_GRAPH_SNAPSHOT and Domain::rh_metric_definition_id_make(1, 2).id.kind == Domain::RH_KIND_METRIC_DEF, "nominal-snapshot-definition-kinds", &fails)
    valid_revision: Domain::RhRevisionRef = Domain::rh_revision_make(Domain::RH_REF_COMMIT, Domain::rh_revision_id_make(1, 2))
    invalid_revision: Domain::RhRevisionRef = Domain::RhRevisionRef{ref_kind: Domain::RH_REF_COMMIT, revision: Domain::RhRevisionId{id: Domain::rh_package_id_make(1, 2).id}}
    check(Domain::rh_revision_valid(valid_revision) and not Domain::rh_revision_valid(invalid_revision), "revision-ref-requires-revision-id", &fails)
    check(not Domain::rh_revision_valid(Domain::rh_revision_make(255, Domain::rh_revision_id_make(1, 2))), "unknown-revision-ref-kind-rejected", &fails)
    host_a: Domain::RhHostInstanceId = Domain::rh_host_instance_id_make(sview("https://gitlab.example", 0, -1))
    host_b: Domain::RhHostInstanceId = Domain::rh_host_instance_id_make(sview("https://gitlab.other", 0, -1))
    native_a: Domain::RhNativeRef = Domain::rh_native_make(Domain::RH_SRC_GITLAB, sview("gitlab", 0, -1), 8, host_a, sview("object-17", 0, -1))
    native_same: Domain::RhNativeRef = Domain::rh_native_make(Domain::RH_SRC_GITLAB, sview("gitlab", 0, -1), 8, host_a, sview("object-17", 0, -1))
    native_other_host: Domain::RhNativeRef = Domain::rh_native_make(Domain::RH_SRC_GITLAB, sview("gitlab", 0, -1), 8, host_b, sview("object-17", 0, -1))
    native_other_key: Domain::RhNativeRef = Domain::rh_native_make(Domain::RH_SRC_GITLAB, sview("gitlab", 0, -1), 8, host_a, sview("object-18", 0, -1))
    check(Domain::rh_native_valid(native_a) and not Domain::rh_native_valid(Domain::rh_native_make(7, sview("gitlab", 0, -1), 8, host_a, sview("object-17", 0, -1))), "native-ref-source-kind-validated", &fails)
    check(not Domain::rh_native_valid(Domain::rh_native_make(Domain::RH_SRC_GITHUB, sview("gitlab", 0, -1), 8, host_a, sview("object-17", 0, -1))), "native-ref-source-label-must-match-family", &fails)
    check(Domain::rh_source_kind_from_name(sview("github", 0, -1)) == Domain::RH_SRC_GITHUB and Domain::rh_source_kind_from_name(sview("custom-forge", 0, -1)) == Domain::RH_SRC_OTHER, "source-name-maps-to-stable-family-tag", &fails)
    check(Domain::rh_native_equal(native_a, native_same) and not Domain::rh_native_equal(native_a, native_other_host) and not Domain::rh_native_equal(native_a, native_other_key), "native-identity-includes-instance-and-exact-key", &fails)
    invalid_native: Domain::RhNativeRef = Domain::RhNativeRef{source_kind: Domain::RH_SRC_GITLAB, source_name: sview("gitlab", 0, -1), object_kind: 8, host_instance: Domain::RhHostInstanceId{key: sview("", 0, -1)}, native_id: sview("object-17", 0, -1)}
    check(not Domain::rh_native_valid(invalid_native), "native-ref-requires-host-instance", &fails)
    valid_artifact: Domain::RhArtifact = Domain::rh_artifact_make(Domain::rh_artifact_id_make(1, 2), Domain::RH_DIGEST_SHA256_TRUNC, 3, 4)
    invalid_artifact: Domain::RhArtifact = Domain::RhArtifact{id: Domain::RhArtifactId{id: Domain::rh_package_id_make(1, 2).id}, digest_algo: Domain::RH_DIGEST_SHA256_TRUNC, digest_high: 3, digest_low: 4}
    check(Domain::rh_artifact_valid(valid_artifact) and not Domain::rh_artifact_valid(invalid_artifact), "artifact-requires-artifact-id", &fails)
    check(not Domain::rh_artifact_valid(Domain::rh_artifact_make(Domain::rh_artifact_id_make(1, 2), 255, 3, 4)), "unknown-artifact-digest-rejected", &fails)
    check(Domain::RH_REF_TAG != Domain::RH_REF_RELEASE, "tag-ne-release", &fails)
    check(Domain::RH_EDGE_REQUIREMENT != Domain::RH_EDGE_RESOLVED, "requirement-ne-resolved", &fails)
    check(Domain::RH_FIND_REACHABLE != Domain::RH_FIND_EXPLOITABLE, "reachability-ne-exploitability", &fails)
    check(Domain::RH_FIND_SIG_VERIFIED != Domain::RH_FIND_CODE_SAFE, "signature-ne-safe", &fails)

# --- M00-04 observation states ---
    check(Base::rh_streq(Observation::rh_status_label(Observation::RH_ST_OBSERVED), "observed"), "label-observed", &fails)
    check(Base::rh_streq(Observation::rh_status_label(Observation::RH_ST_NOT_APPLICABLE), "not_applicable"), "label-na", &fails)
    check(Base::rh_streq(Observation::rh_status_label(Observation::RH_ST_UNSUPPORTED), "unsupported"), "label-unsupported", &fails)
    check(not Base::rh_streq(Observation::rh_status_label(Observation::RH_ST_NOT_APPLICABLE), "false"), "na-ne-false", &fails)
    distinct: bool =
        while i < 11 |i: i64 = 0, distinct: bool = true| -> distinct:
            while j < 11 |j: i64 = i + 1, i, distinct|:
                if Base::rh_streq(Observation::rh_status_label(i.u8()), Observation::rh_status_label(j.u8())):
                    distinct <- false
                j <- j + 1
            i <- i + 1
    check(distinct, "eleven-distinct-labels", &fails)
    check(Observation::rh_observation_consistent(Observation::RH_ST_OBSERVED, true), "obs-with-value", &fails)
    check(not Observation::rh_observation_consistent(Observation::RH_ST_OBSERVED, false), "obs-without-value-rejected", &fails)
    check(Observation::rh_observation_consistent(Observation::RH_ST_UNAVAILABLE, false), "unavailable-bare", &fails)
    check(not Observation::rh_observation_consistent(Observation::RH_ST_UNAVAILABLE, true), "unavailable-with-value-rejected", &fails)
    check(Observation::rh_observation_consistent(Observation::RH_ST_NOT_APPLICABLE, false), "na-bare", &fails)
    check(Observation::rh_observation_consistent(Observation::RH_ST_PARTIAL, true), "partial-with-value", &fails)
    check(not Observation::rh_observation_consistent(11, false), "unknown-status-rejected", &fails)
    check(not Observation::rh_status_valid(255), "out-of-range-status-rejected", &fails)
    check(not Observation::rh_ratio_valid(0, 0), "zero-denominator-rejected", &fails)
    check(Observation::rh_ratio_valid(0, 5), "zero-numerator-allowed", &fails)
    check(Observation::rh_ratio_valid(3, 4), "share-valid", &fails)
    check(not Observation::rh_ratio_valid(5, 4), "overfull-ratio-rejected", &fails)
    check(Observation::rh_ratio_defined(Observation::rh_ratio_make(-3, 2)), "signed-ratio-denominator-defined", &fails)
    check(not Observation::rh_ratio_defined(Observation::rh_ratio_make(1, 0)), "undefined-ratio-denominator-rejected", &fails)
    observed_count: Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_OBSERVED, Observation::RhMetricValue.Count(0), false)
    check(Observation::rh_observation_valid(observed_count), "typed-observed-zero-is-a-value", &fails)
    absent_unavailable: Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_UNAVAILABLE, Observation::RhMetricValue.Absent, false)
    check(Observation::rh_observation_valid(absent_unavailable), "typed-unavailable-without-value", &fails)
    invalid_contract_error: Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_ERROR, Observation::RhMetricValue.Absent, false)
    check(Observation::rh_observation_valid(invalid_contract_error) and Observation::rh_evidence_links_count(invalid_contract_error.evidence) == 0 and Base::rh_streq(Observation::rh_provenance_quality_label(invalid_contract_error.quality.provenance), "unknown"), "typed-contract-error-is-explicitly-unbacked", &fails)
    partial_ratio: Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_PARTIAL, Observation::RhMetricValue.Ratio(2, 3), true)
    check(Observation::rh_observation_valid(partial_ratio), "typed-partial-ratio-with-incompleteness", &fails)
    check(Base::rh_streq(Observation::rh_completeness_label(partial_ratio.quality.completeness), "partial"), "partial-completeness-dimension", &fails)
    stale_ratio: Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_STALE, Observation::RhMetricValue.Ratio(2, 3), true)
    check(Observation::rh_observation_valid(stale_ratio), "typed-stale-ratio-with-incompleteness", &fails)
    check(Base::rh_streq(Observation::rh_freshness_label(stale_ratio.quality.freshness), "stale"), "stale-freshness-dimension", &fails)
    partial_without_reason: Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_PARTIAL, Observation::RhMetricValue.Ratio(2, 3), false)
    check(not Observation::rh_observation_valid(partial_without_reason), "typed-partial-requires-incompleteness", &fails)
    unavailable_with_value: Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_UNAVAILABLE, Observation::RhMetricValue.Count(0), false)
    check(not Observation::rh_observation_valid(unavailable_with_value), "typed-unavailable-cannot-carry-zero", &fails)
    invalid_ratio: Observation::RhObservation = Observation::rh_observation_make(Observation::RH_ST_OBSERVED, Observation::RhMetricValue.Ratio(1, 0), false)
    check(not Observation::rh_observation_valid(invalid_ratio), "typed-observed-ratio-rejects-zero-denominator", &fails)
    valid_histogram: Observation::RhMetricValue = Observation::RhMetricValue.CountHistogram5(1, 2, 0, 3, 4, 10)
    invalid_histogram: Observation::RhMetricValue = Observation::RhMetricValue.CountHistogram5(1, 2, 0, 3, 4, 11)
    overflowing_histogram: Observation::RhMetricValue = Observation::RhMetricValue.CountHistogram5(9223372036854775807, 1, 0, 0, 0, 9223372036854775807)
    check(Observation::rh_observation_valid(Observation::rh_observation_make(Observation::RH_ST_OBSERVED, valid_histogram, false)), "typed-histogram-counts-match-population", &fails)
    check(not Observation::rh_observation_valid(Observation::rh_observation_make(Observation::RH_ST_OBSERVED, invalid_histogram, false)), "typed-histogram-rejects-denominator-mismatch", &fails)
    check(not Observation::rh_observation_valid(Observation::rh_observation_make(Observation::RH_ST_OBSERVED, overflowing_histogram, false)), "typed-histogram-rejects-overflowing-total", &fails)
    check(observation_roundtrip(Observation::rh_observation_make(Observation::RH_ST_OBSERVED, valid_histogram, false)), "typed-histogram-codec-roundtrip", &fails)
    all_value_variants: bool = Observation::rh_observation_valid(Observation::rh_observation_make(Observation::RH_ST_OBSERVED, Observation::RhMetricValue.Count(1), false)) and Observation::rh_observation_valid(Observation::rh_observation_make(Observation::RH_ST_OBSERVED, Observation::RhMetricValue.Timestamp(0), false)) and Observation::rh_observation_valid(Observation::rh_observation_make(Observation::RH_ST_OBSERVED, Observation::RhMetricValue.Ratio(-1, 2), false)) and Observation::rh_observation_valid(Observation::rh_observation_make(Observation::RH_ST_OBSERVED, Observation::RhMetricValue.Boolean(false), false)) and Observation::rh_observation_valid(Observation::rh_observation_make(Observation::RH_ST_OBSERVED, Observation::RhMetricValue.Enumeration(1), false))
    check(all_value_variants, "typed-all-value-variants", &fails)
    check(observation_metric_emits_value(Observation::RhMetricValue.Count(7), "7"), "typed-metric-emits-count", &fails)
    check(observation_metric_emits_value(Observation::RhMetricValue.CountPair(2, 9), "{\"first\":2,\"second\":9}"), "typed-metric-emits-count-pair", &fails)
    check(observation_metric_emits_value(Observation::RhMetricValue.CountHistogram5(1, 2, 0, 3, 4, 10), "{\"bins\":[1,2,0,3,4],\"population_count\":10}"), "typed-metric-emits-fixed-histogram", &fails)
    check(observation_metric_emits_value(Observation::RhMetricValue.Timestamp(1700000000), "1700000000"), "typed-metric-emits-timestamp", &fails)
    check(observation_metric_emits_value(Observation::RhMetricValue.Ratio(2, 3), "{\"num\":2,\"den\":3}"), "typed-metric-emits-ratio", &fails)
    check(observation_metric_emits_value(Observation::RhMetricValue.Boolean(true), "true"), "typed-metric-emits-boolean", &fails)
    check(observation_metric_emits_value(Observation::RhMetricValue.Enumeration(4), "4"), "typed-metric-emits-enumeration", &fails)
    check(observation_metric_emits_optional_reason("", ""), "typed-metric-omits-empty-reason", &fails)
    check(observation_metric_emits_optional_reason("no-population", ",\"reason\":\"no-population\""), "typed-metric-emits-nonempty-reason", &fails)
    state_value_cross_product: bool =
        for status in 0..<Observation::RH_ST_COUNT |valid: bool = true| -> valid:
            no_value: Observation::RhObservation = Observation::rh_observation_make(status, Observation::RhMetricValue.Absent, status == Observation::RH_ST_PARTIAL or status == Observation::RH_ST_STALE)
            has_value: Observation::RhObservation = Observation::rh_observation_make(status, Observation::RhMetricValue.Count(0), status == Observation::RH_ST_PARTIAL or status == Observation::RH_ST_STALE)
            accepts_no_value: bool = Observation::rh_observation_valid(no_value)
            accepts_value: bool = Observation::rh_observation_valid(has_value)
            expected_no_value: bool = status != Observation::RH_ST_OBSERVED
            expected_value: bool = status == Observation::RH_ST_OBSERVED or status == Observation::RH_ST_PARTIAL or status == Observation::RH_ST_STALE
            valid <- valid and accepts_no_value == expected_no_value and accepts_value == expected_value
    check(state_value_cross_product, "typed-status-value-cross-product", &fails)
    serialized_cross_product: bool =
        for status in 0..<Observation::RH_ST_COUNT |valid: bool = true| -> valid:
            incomplete: bool = status == Observation::RH_ST_PARTIAL or status == Observation::RH_ST_STALE
            absent: Observation::RhObservation = Observation::rh_observation_make(status, Observation::RhMetricValue.Absent, incomplete)
            absent_roundtrips: bool = Observation::rh_observation_valid(absent) and observation_roundtrip(absent)
            expected_absent: bool = status != Observation::RH_ST_OBSERVED
            valid <- valid and absent_roundtrips == expected_absent
            if status == Observation::RH_ST_OBSERVED or incomplete:
                valid <- valid and observation_roundtrip(Observation::rh_observation_make(status, Observation::RhMetricValue.Count(0), incomplete))
                valid <- valid and observation_roundtrip(Observation::rh_observation_make(status, Observation::RhMetricValue.CountPair(1, 2), incomplete))
                valid <- valid and observation_roundtrip(Observation::rh_observation_make(status, Observation::RhMetricValue.CountHistogram5(1, 2, 0, 3, 4, 10), incomplete))
                valid <- valid and observation_roundtrip(Observation::rh_observation_make(status, Observation::RhMetricValue.Timestamp(0), incomplete))
                valid <- valid and observation_roundtrip(Observation::rh_observation_make(status, Observation::RhMetricValue.Ratio(-1, 2), incomplete))
                valid <- valid and observation_roundtrip(Observation::rh_observation_make(status, Observation::RhMetricValue.Boolean(false), incomplete))
                valid <- valid and observation_roundtrip(Observation::rh_observation_make(status, Observation::RhMetricValue.Enumeration(0), incomplete))
    check(serialized_cross_product, "typed-observation-json-roundtrip-cross-product", &fails)
    check(observation_evidence_roundtrip(), "typed-observation-evidence-link-roundtrip", &fails)
    check(observation_external_evidence_roundtrip(), "typed-observation-external-evidence-roundtrip", &fails)
    report_quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{completeness: Observation::RhCompleteness.Partial, freshness: Observation::RhFreshness.Unknown, validity: Observation::RhValidity.Valid, provenance: Observation::RhProvenanceQuality.EvidenceBacked}
    duplicate_links: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
    Observation::rh_evidence_links_push(&duplicate_links, Observation::RhEvidenceObject.GitLog)
    Observation::rh_evidence_links_push(&duplicate_links, Observation::RhEvidenceObject.GitLog)
    duplicate_evidence: Observation::RhObservation = Observation::rh_observation_make_with_evidence(
        Observation::RH_ST_OBSERVED,
        Observation::RhMetricValue.Count(1),
        false,
        Observation::RhQualityDimensions{completeness: Observation::RhCompleteness.Complete, freshness: Observation::RhFreshness.Unknown, validity: Observation::RhValidity.Valid, provenance: Observation::RhProvenanceQuality.EvidenceBacked},
        duplicate_links
    )
    check(not Observation::rh_observation_valid(duplicate_evidence), "typed-observation-rejects-duplicate-evidence", &fails)
    quality_evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
    Observation::rh_evidence_links_push(&quality_evidence, Observation::RhEvidenceObject.GitLog)
    check(observation_roundtrip(Observation::rh_observation_make_with_evidence(Observation::RH_ST_PARTIAL, Observation::RhMetricValue.Ratio(1, 2), true, report_quality, quality_evidence)), "typed-quality-json-roundtrip", &fails)
    check(not Observation::rh_observation_valid(Observation::rh_observation_make_with_quality(Observation::RH_ST_OBSERVED, Observation::RhMetricValue.Count(0), false, Observation::RhQualityDimensions{completeness: Observation::RhCompleteness.Complete, freshness: Observation::RhFreshness.Unknown, validity: Observation::RhValidity.Valid, provenance: Observation::RhProvenanceQuality.EvidenceBacked})), "typed-evidence-backed-requires-links", &fails)
    observed_partial_quality: Observation::RhObservation = Observation::rh_observation_make_with_quality(Observation::RH_ST_OBSERVED, Observation::RhMetricValue.Count(1), false, Observation::RhQualityDimensions{completeness: Observation::RhCompleteness.Partial, freshness: Observation::RhFreshness.Unknown, validity: Observation::RhValidity.Valid, provenance: Observation::RhProvenanceQuality.Unknown})
    check(not Observation::rh_observation_valid(observed_partial_quality), "typed-observed-rejects-partial-completeness", &fails)
    unavailable_stale_quality: Observation::RhObservation = Observation::rh_observation_make_with_quality(Observation::RH_ST_UNAVAILABLE, Observation::RhMetricValue.Absent, false, Observation::RhQualityDimensions{completeness: Observation::RhCompleteness.Unknown, freshness: Observation::RhFreshness.Stale, validity: Observation::RhValidity.Unknown, provenance: Observation::RhProvenanceQuality.Unknown})
    check(not Observation::rh_observation_valid(unavailable_stale_quality), "typed-nonstale-rejects-stale-freshness", &fails)
    check(observation_decode_rejects("{\"status\":0,\"value\":{\"kind\":\"absent\"},\"incomplete\":false,\"quality\":{\"completeness\":\"unknown\",\"freshness\":\"unknown\",\"validity\":\"unknown\",\"provenance\":\"unknown\"},\"evidence\":[]}"), "codec-observed-absent-rejected", &fails)
    check(observation_decode_rejects("{\"status\":4,\"value\":{\"kind\":\"ratio\",\"num\":1,\"den\":2},\"incomplete\":false,\"quality\":{\"completeness\":\"partial\",\"freshness\":\"unknown\",\"validity\":\"unknown\",\"provenance\":\"unknown\"},\"evidence\":[]}"), "codec-partial-without-incompleteness-rejected", &fails)
    check(observation_decode_rejects("{\"status\":0,\"value\":{\"kind\":\"ratio\",\"num\":1,\"den\":0},\"incomplete\":false,\"quality\":{\"completeness\":\"unknown\",\"freshness\":\"unknown\",\"validity\":\"unknown\",\"provenance\":\"unknown\"},\"evidence\":[]}"), "codec-zero-denominator-rejected", &fails)
    check(observation_decode_rejects("{\"status\":0,\"value\":{\"kind\":\"count_pair\",\"first\":0,\"second\":-1},\"incomplete\":false,\"quality\":{\"completeness\":\"unknown\",\"freshness\":\"unknown\",\"validity\":\"unknown\",\"provenance\":\"unknown\"},\"evidence\":[]}"), "codec-negative-count-pair-rejected", &fails)
    check(observation_decode_rejects("{\"status\":0,\"value\":{\"kind\":\"count_pair\",\"first\":2,\"second\":1},\"incomplete\":false,\"quality\":{\"completeness\":\"unknown\",\"freshness\":\"unknown\",\"validity\":\"unknown\",\"provenance\":\"unknown\"},\"evidence\":[]}"), "codec-count-pair-order-rejected", &fails)
    check(observation_decode_rejects("{\"status\":0,\"value\":{\"kind\":\"count\",\"value\":0},\"incomplete\":false,\"quality\":{\"completeness\":\"nonsense\",\"freshness\":\"unknown\",\"validity\":\"unknown\",\"provenance\":\"unknown\"},\"evidence\":[]}"), "codec-unknown-quality-label-rejected", &fails)
    check(observation_decode_rejects("{\"status\":0,\"value\":{\"kind\":\"count\",\"value\":0},\"incomplete\":false,\"quality\":{\"completeness\":\"unknown\",\"freshness\":\"unknown\",\"validity\":\"unknown\",\"provenance\":\"unknown\"},\"evidence\":[\"\"]}"), "codec-empty-external-evidence-link-rejected", &fails)
    check(observation_decode_rejects_overbound_evidence(), "codec-evidence-overbound-rejected", &fails)
    check(observation_decode_rejects("{\"status\":0,\"value\":{\"kind\":\"count\",\"value\":0},\"incomplete\":false,\"quality\":{\"completeness\":\"unknown\",\"freshness\":\"unknown\",\"validity\":\"unknown\",\"provenance\":\"unknown\"},\"evidence\":[\"git_log\",\"git_log\"]}"), "codec-duplicate-evidence-rejected", &fails)
    check(observation_decode_rejects("not-json"), "codec-malformed-json-rejected", &fails)

# --- M00-03 temporal primitives ---
    check(Temporal::rh_interval_valid(10, 20), "interval-valid", &fails)
    check(not Temporal::rh_interval_valid(20, 20), "empty-interval-rejected", &fails)
    check(not Temporal::rh_interval_valid(30, 20), "inverted-interval-rejected", &fails)
    check(not Temporal::rh_interval_valid(-1, 20), "pre-epoch-interval-rejected", &fails)
    signed_duration: mutable i64 = 77
    check(Temporal::rh_signed_duration_checked(10, 4, &signed_duration) and signed_duration == -6, "signed-negative-preserved", &fails)
    check(Temporal::rh_signed_duration_checked(0, -9223372036854775807 - 1, &signed_duration) and signed_duration == -9223372036854775807 - 1, "signed-minimum-difference-supported", &fails)
    check(Temporal::rh_signed_duration_checked(-9223372036854775807 - 1, -1, &signed_duration) and signed_duration == 9223372036854775807, "signed-maximum-difference-supported", &fails)
    signed_duration <- 77
    check(not Temporal::rh_signed_duration_checked(-9223372036854775807 - 1, 1, &signed_duration) and signed_duration == 77, "signed-positive-overflow-rejected", &fails)
    check(not Temporal::rh_signed_duration_checked(9223372036854775807, -2, &signed_duration) and signed_duration == 77, "signed-negative-overflow-rejected", &fails)
    duration: mutable i64 = 77
    check(Temporal::rh_duration_checked(10, 20, &duration) and duration == 10, "checked-duration-valid-range", &fails)
    duration <- 77
    check(not Temporal::rh_duration_checked(20, 10, &duration) and duration == 77, "checked-duration-reversed-range-preserves-output", &fails)
    check(not Temporal::rh_duration_checked(-1, 10, &duration) and duration == 77, "checked-duration-pre-epoch-preserves-output", &fails)
    check(Temporal::rh_interval_contains(10, 20, 10), "contains-start", &fails)
    check(not Temporal::rh_interval_contains(10, 20, 20), "half-open-end", &fails)
    check(not Temporal::rh_interval_contains(20, 10, 15), "contains-rejects-reversed-range", &fails)
    check(not Temporal::rh_interval_contains(-1, 10, 1), "contains-rejects-pre-epoch-range", &fails)
    check(Temporal::rh_intervals_overlap(10, 20, 15, 25), "overlap", &fails)
    check(not Temporal::rh_intervals_overlap(10, 20, 20, 30), "adjacent-not-overlap", &fails)
    check(not Temporal::rh_intervals_overlap(10, 20, 25, 15), "inverted-second-interval-does-not-overlap", &fails)
    check(not Temporal::rh_intervals_overlap(20, 10, 5, 25), "inverted-first-interval-does-not-overlap", &fails)
    check(not Temporal::rh_intervals_overlap(-5, 5, 0, 10), "pre-epoch-interval-does-not-overlap", &fails)
    check(Temporal::rh_time_basis_valid(Temporal::RH_TIME_BASIS_AUTHOR), "author-time-basis-valid", &fails)
    check(Temporal::rh_time_basis_valid(Temporal::RH_TIME_BASIS_COMMITTER), "committer-time-basis-valid", &fails)
    check(Temporal::rh_time_basis_valid(Temporal::RH_TIME_BASIS_OBSERVED), "observed-time-basis-valid", &fails)
    check(Temporal::rh_time_basis_valid(Temporal::RH_TIME_BASIS_VALID), "valid-time-basis-valid", &fails)
    check(Temporal::rh_time_basis_valid(Temporal::RH_TIME_BASIS_SYSTEM), "system-time-basis-valid", &fails)
    check(Temporal::rh_time_basis_valid(Temporal::RH_TIME_BASIS_UNKNOWN), "unknown-time-basis-valid", &fails)
    check(not Temporal::rh_time_basis_valid(42), "invalid-time-basis-rejected", &fails)
    check(Base::rh_streq(Temporal::rh_time_basis_label(Temporal::RH_TIME_BASIS_AUTHOR), "author"), "author-time-basis-label", &fails)
    check(Base::rh_streq(Temporal::rh_time_basis_label(Temporal::RH_TIME_BASIS_COMMITTER), "committer"), "committer-time-basis-label", &fails)
    check(Base::rh_streq(Temporal::rh_time_basis_label(Temporal::RH_TIME_BASIS_OBSERVED), "observed"), "observed-time-basis-label", &fails)
    check(Base::rh_streq(Temporal::rh_time_basis_label(Temporal::RH_TIME_BASIS_VALID), "valid"), "valid-time-basis-label", &fails)
    check(Base::rh_streq(Temporal::rh_time_basis_label(Temporal::RH_TIME_BASIS_SYSTEM), "system"), "system-time-basis-label", &fails)
    check(Base::rh_streq(Temporal::rh_time_basis_label(Temporal::RH_TIME_BASIS_UNKNOWN), "unknown"), "unknown-time-basis-label", &fails)
    known_interval: Temporal::RhLeftCensoredInterval = Temporal::rh_left_censored_interval_make(true, 10, 20)
    check(Temporal::rh_left_censored_interval_valid(known_interval), "known-start-interval-valid", &fails)
    check(Temporal::rh_left_censored_membership(known_interval, 10) == Temporal::RH_INTERVAL_WITHIN, "known-start-inclusive", &fails)
    check(Temporal::rh_left_censored_membership(known_interval, 20) == Temporal::RH_INTERVAL_OUTSIDE, "known-end-exclusive", &fails)
    unknown_interval: Temporal::RhLeftCensoredInterval = Temporal::rh_left_censored_interval_make(false, 99, 20)
    check(unknown_interval.start == 0 and Temporal::rh_left_censored_interval_valid(unknown_interval), "unknown-start-canonicalized", &fails)
    check(Temporal::rh_left_censored_membership(unknown_interval, 10) == Temporal::RH_INTERVAL_UNKNOWN, "unknown-start-membership-stays-unknown", &fails)
    check(Temporal::rh_left_censored_membership(unknown_interval, 20) == Temporal::RH_INTERVAL_OUTSIDE, "known-end-outside-for-unknown-start", &fails)
    epoch_interval: Temporal::RhLeftCensoredInterval = Temporal::rh_left_censored_interval_make(true, 0, 1)
    check(Temporal::rh_left_censored_interval_valid(epoch_interval), "epoch-zero-is-valid-interval-start", &fails)
    no_range: Temporal::RhLeftCensoredInterval = Temporal::rh_left_censored_interval_make(false, 0, 0)
    check(not Temporal::rh_left_censored_interval_valid(no_range), "empty-unknown-start-interval-rejected", &fails)
    negative_start: Temporal::RhLeftCensoredInterval = Temporal::rh_left_censored_interval_make(true, -1, 1)
    check(not Temporal::rh_left_censored_interval_valid(negative_start), "pre-epoch-start-rejected", &fails)
    invalid_interval: Temporal::RhLeftCensoredInterval = Temporal::rh_left_censored_interval_make(true, 20, 20)
    check(not Temporal::rh_left_censored_interval_valid(invalid_interval), "invalid-left-censored-interval-rejected", &fails)
    check(Temporal::rh_left_censored_membership(invalid_interval, 10) == Temporal::RH_INTERVAL_INVALID, "invalid-interval-membership", &fails)
    leap: i64 = Temporal::rh_unix_from_civil(2024, 2, 29)
    ly: mutable i64 = 0
    lm: mutable i64 = 0
    ld: mutable i64 = 0
    Temporal::rh_civil_from_days(leap / 86400, &ly, &lm, &ld)
    check(ly == 2024 and lm == 2 and ld == 29, "leap-day-roundtrip", &fails)
    jan: i64 = Temporal::rh_unix_from_civil(2024, 1, 1)
    mar: i64 = Temporal::rh_unix_from_civil(2024, 3, 1)
    check(Temporal::rh_complete_months_between(jan, mar) == 2, "jan-to-mar-two-months", &fails)
    jan31: i64 = Temporal::rh_unix_from_civil(2024, 1, 31)
    feb1: i64 = Temporal::rh_unix_from_civil(2024, 2, 1)
    jan_midday: i64 = jan + 43200
    check(Temporal::rh_complete_months_between(jan, feb1) == 1, "whole-january-counted-at-next-month-boundary", &fails)
    check(Temporal::rh_complete_months_between(jan_midday, jan_midday + 3600) == 0, "same-month-partial-range-has-zero-complete-months", &fails)
    check(Temporal::rh_complete_months_between(jan31, feb1) == 0, "partial-start-month-not-counted", &fails)
    check(Temporal::rh_complete_months_between(jan_midday, feb1) == 0, "midday-start-excludes-partial-month", &fails)
    check(Temporal::rh_complete_months_between(jan_midday, mar) == 1, "midmonth-to-march-contains-only-complete-february", &fails)
    m1: mutable i64 = 0
    m2: mutable i64 = 0
    check(Temporal::rh_civil_date_valid(2000, 2, 29), "century-leap-year-valid", &fails)
    check(not Temporal::rh_civil_date_valid(1900, 2, 29), "non-leap-century-rejected", &fails)
    check(not Temporal::rh_civil_date_valid(2024, 2, 30), "normalized-invalid-date-rejected", &fails)
    check(not Temporal::rh_civil_date_valid(2024, 13, 1), "invalid-month-rejected", &fails)
    checked_instant: mutable i64 = -1
    check(Temporal::rh_unix_from_civil_checked(1970, 1, 1, &checked_instant) and checked_instant == 0, "checked-epoch-conversion", &fails)
    check(not Temporal::rh_unix_from_civil_checked(2024, 2, 30, &checked_instant) and checked_instant == 0, "invalid-date-conversion-does-not-mutate-output", &fails)
    checked_instant <- 123
    check(not Temporal::rh_unix_from_civil_checked(1969, 12, 31, &checked_instant) and checked_instant == 123, "pre-epoch-date-rejected-with-output-preserved", &fails)
    check(Temporal::rh_unix_from_civil_checked(292277026596, 1, 1, &checked_instant) and checked_instant == 9223372036825516800, "largest-year-with-representable-midnight-converts", &fails)
    checked_instant <- 123
    check(not Temporal::rh_unix_from_civil_checked(292277026597, 1, 1, &checked_instant) and checked_instant == 123, "unix-second-overflow-date-rejected-with-output-preserved", &fails)
    check(not Temporal::rh_unix_from_civil_checked(9223372036854775807, 1, 1, &checked_instant) and checked_instant == 123, "extreme-year-rejected-before-arithmetic-overflow", &fails)
    max_epoch_instant: i64 = oracle_days_from_epoch(292277026596, 12, 4) * 86400 + 15 * 3600 + 30 * 60 + 7
    check(max_epoch_instant == 9223372036854775807, "independent-epoch-oracle-reaches-signed-i64-maximum", &fails)
    check(Temporal::rh_unix_from_civil_time_checked(292277026596, 12, 4, 15, 30, 7, 0, &checked_instant) and checked_instant == max_epoch_instant, "maximum-representable-civil-instant-converts", &fails)
    checked_instant <- 123
    check(not Temporal::rh_unix_from_civil_time_checked(292277026596, 12, 4, 15, 30, 8, 0, &checked_instant) and checked_instant == 123, "civil-instant-one-second-past-signed-i64-rejected", &fails)
    check(not Temporal::rh_unix_from_civil_time_checked(292277026596, 12, 4, 15, 30, 7, -1, &checked_instant) and checked_instant == 123, "negative-offset-overflow-rejected-with-output-preserved", &fails)
    check(Temporal::rh_unix_from_civil_time_checked(292277026596, 12, 4, 15, 30, 7, 1, &checked_instant) and checked_instant == max_epoch_instant - 1, "positive-offset-near-maximum-remains-representable", &fails)
    check(Temporal::rh_unix_from_civil_time_checked(1969, 12, 31, 23, 0, 0, -3600, &checked_instant) and checked_instant == 0, "offset-corrected-pre-epoch-civil-time-reaches-epoch", &fails)
    checked_instant <- 123
    check(not Temporal::rh_unix_from_civil_time_checked(1970, 1, 1, 0, 0, 0, 3600, &checked_instant) and checked_instant == 123, "offset-adjusted-pre-epoch-instant-rejected", &fails)
    check(not Temporal::rh_unix_from_civil_time_checked(1970, 1, 1, 0, 0, 0, 86341, &checked_instant) and checked_instant == 123, "offset-beyond-iso-bound-rejected", &fails)
    check(not Temporal::rh_unix_from_civil_time_checked(1970, 1, 1, 24, 0, 0, 0, &checked_instant) and checked_instant == 123, "invalid-hour-rejected-with-output-preserved", &fails)
    check(not Temporal::rh_unix_from_civil_time_checked(2016, 12, 31, 23, 59, 60, 0, &checked_instant) and checked_instant == 123, "unrepresentable-leap-second-rejected-with-output-preserved", &fails)
    check(Temporal::rh_month_of_instant(jan31, &m1) and Temporal::rh_month_of_instant(feb1, &m2) and m2 - m1 == 1, "month-boundary", &fails)
    m1 <- 123
    check(not Temporal::rh_month_of_instant(-1, &m1) and m1 == 123, "month-conversion-rejects-pre-epoch-with-output-preserved", &fails)
    check(Temporal::rh_complete_months_between(-1, jan) == -1, "month-span-rejects-pre-epoch", &fails)
    check(Temporal::rh_complete_months_between(mar, jan) == -1, "month-span-rejects-reversed-range", &fails)
    intro: Temporal::RhBitemporal = Temporal::rh_bitemporal_make(Temporal::rh_unix_from_civil(2024, 6, 1), Temporal::rh_unix_from_civil(2024, 6, 2), true, Temporal::rh_unix_from_civil(2026, 1, 10), 0, false)
    check(Temporal::rh_bitemporal_valid(intro), "bitemporal-fact-valid", &fails)
    check(not Temporal::rh_visible_as_of(intro, Temporal::rh_unix_from_civil(2025, 1, 1)), "2026-discovery-hidden-in-2025", &fails)
    check(Temporal::rh_visible_as_of(intro, Temporal::rh_unix_from_civil(2026, 6, 1)), "2026-discovery-visible-retrospective", &fails)
    check(Temporal::rh_bitemporal_visible_at(intro, Temporal::rh_unix_from_civil(2024, 6, 1), Temporal::rh_unix_from_civil(2026, 6, 1)), "valid-start-inclusive-known-time-visible", &fails)
    check(not Temporal::rh_bitemporal_visible_at(intro, Temporal::rh_unix_from_civil(2024, 6, 2), Temporal::rh_unix_from_civil(2026, 6, 1)), "valid-end-exclusive", &fails)
    corrected: Temporal::RhBitemporal = Temporal::rh_bitemporal_make(Temporal::rh_unix_from_civil(2024, 6, 1), 0, false, Temporal::rh_unix_from_civil(2026, 1, 10), Temporal::rh_unix_from_civil(2027, 1, 10), true)
    check(Temporal::rh_bitemporal_visible_at(corrected, Temporal::rh_unix_from_civil(2028, 1, 1), Temporal::rh_unix_from_civil(2027, 1, 9)), "open-valid-time-and-known-before-end", &fails)
    check(not Temporal::rh_bitemporal_visible_at(corrected, Temporal::rh_unix_from_civil(2028, 1, 1), Temporal::rh_unix_from_civil(2027, 1, 10)), "known-end-exclusive", &fails)
    check(not Temporal::rh_visible_as_of(corrected, Temporal::rh_unix_from_civil(2027, 1, 10)), "system-end-exclusive", &fails)
    malformed_bitemporal: Temporal::RhBitemporal = Temporal::rh_bitemporal_make(20, 10, true, 0, 0, false)
    check(not Temporal::rh_bitemporal_valid(malformed_bitemporal), "inverted-bitemporal-valid-range-rejected", &fails)
    bitemporal_cross_product_oracle(&fails)
    gregorian_cycle_oracle(&fails)
    timezone_offset_date_oracle(1970, 1, 1, &fails)
    timezone_offset_date_oracle(1972, 2, 29, &fails)
    timezone_offset_date_oracle(2000, 2, 29, &fails)
    timezone_offset_date_oracle(2100, 3, 1, &fails)
    timezone_offset_date_oracle(2399, 12, 31, &fails)
    checked_instant <- 123
    check(not Temporal::rh_unix_from_civil_time_checked(2000, 1, 1, 0, 0, 0, -86341, &checked_instant) and checked_instant == 123, "offset-below-iso-bound-rejected-with-output-preserved", &fails)
    checked_instant <- 123
    check(not Temporal::rh_unix_from_civil_time_checked(2000, 1, 1, 0, 0, 0, 86341, &checked_instant) and checked_instant == 123, "offset-above-iso-bound-rejected-with-output-preserved", &fails)

# --- M04-07 numerical oracles (plan §9.4), computed here first ---
    c1: mutable darray[u64] =
        c1: mutable darray[u64] = []
        c1.push(9)
        c1.push(3)
        c1
    check(Metrics::rh_concentration(c1, 1, 2) == 1, "c93-half-is-1", &fails)
    check(Metrics::rh_concentration(c1, 4, 5) == 2, "c93-80pct-is-2", &fails)
    n1: mutable u64 = 0
    d1: mutable u64 = 0
    check(Metrics::rh_hhi(c1, &n1, &d1), "hhi93-ok", &fails)
    check(n1 == 5 and d1 == 8, "hhi93-is-5-8", &fails)
    c2: mutable darray[u64] =
        c2: mutable darray[u64] = []
        c2.push(25)
        c2.push(25)
        c2.push(25)
        c2.push(25)
        c2
    check(Metrics::rh_concentration(c2, 1, 2) == 2, "c25-half-is-2", &fails)
    check(Metrics::rh_concentration(c2, 4, 5) == 4, "c25-80pct-is-4", &fails)
    n2: mutable u64 = 0
    d2: mutable u64 = 0
    check(Metrics::rh_hhi(c2, &n2, &d2), "hhi25-ok", &fails)
    check(n2 == 1 and d2 == 4, "hhi25-is-1-4", &fails)
    c0: mutable darray[u64] = []
    check(Metrics::rh_concentration(c0, 1, 2) == -1, "empty-is-not-applicable", &fails)
    check(not Metrics::rh_hhi(c0, &n1, &d1), "empty-hhi-refused", &fails)
    check(Metrics::rh_concentration(c1, 0, 1) == -2, "zero-threshold-rejected", &fails)
    check(Metrics::rh_concentration(c1, 2, 1) == -2, "overfull-threshold-rejected", &fails)
    check(Metrics::rh_concentration(c1, 1, 0) == -2, "zero-denominator-threshold-rejected", &fails)
    member_ids: darray[i64] = [8, 3, 5, 1, 2]
    member_counts: darray[u64] = [25, 25, 25, 25, 0]
    members_half: mutable darray[i64] = []
    check(Metrics::rh_concentration_members(member_ids, member_counts, 1, 2, members_half) == 2, "concentration-members-half-count", &fails)
    check(members_half.count == 2, "concentration-members-half-length", &fails)
    check(members_half[0] == 1, "concentration-members-first-tie-id", &fails)
    check(members_half[1] == 3, "concentration-members-second-tie-id", &fails)
    members_three_quarters: mutable darray[i64] = []
    check(Metrics::rh_concentration_members(member_ids, member_counts, 3, 4, members_three_quarters) == 3, "concentration-members-three-quarter-count", &fails)
    check(members_three_quarters.count == 3, "concentration-members-prefix-length", &fails)
    check(members_three_quarters[0] == 1 and members_three_quarters[1] == 3 and members_three_quarters[2] == 5, "concentration-members-prefix-order", &fails)
    duplicate_actor_ids: darray[i64] = [7, 7]
    duplicate_actor_counts: darray[u64] = [5, 4]
    rejected_members: mutable darray[i64] = []
    check(Metrics::rh_concentration_members(duplicate_actor_ids, duplicate_actor_counts, 1, 2, rejected_members) == -4, "concentration-members-duplicate-actor-rejected", &fails)
    check(rejected_members.count == 0, "concentration-members-error-leaves-output-empty", &fails)
    check(Metrics::rh_concentration_members(member_ids, member_counts, 0, 1, rejected_members) == -2, "concentration-members-invalid-threshold-rejected", &fails)
    check(rejected_members.count == 0, "concentration-members-invalid-threshold-keeps-output-empty", &fails)
    no_member_ids: darray[i64] = []
    no_member_counts: darray[u64] = []
    no_members: mutable darray[i64] = []
    check(Metrics::rh_concentration_members(no_member_ids, no_member_counts, 1, 2, no_members) == -1, "concentration-members-empty-not-applicable", &fails)
    overflow_member_ids: darray[i64] = [1, 2]
    overflow_member_counts: darray[u64] = [18446744073709551615, 1]
    overflow_members: mutable darray[i64] = []
    check(Metrics::rh_concentration_members(overflow_member_ids, overflow_member_counts, 1, 2, overflow_members) == -3, "concentration-members-total-overflow-rejected", &fails)
    check(overflow_members.count == 0, "concentration-members-overflow-keeps-output-empty", &fails)

