    check(not Forge::rh_conn_has(Forge::RH_CONN_GIT, Forge::RH_CAP_ISSUES), "git-no-issues", &fails)
    check(not Forge::rh_conn_has(Forge::RH_CONN_FORGEJO, Forge::RH_CAP_TRAFFIC), "forgejo-no-traffic", &fails)
