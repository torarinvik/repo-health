# Shared maintenance overlap over an explicitly reviewed graph/role join.
include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_sha256.elisa"
include "./rh_store.elisa"

module MaintenanceExposure:
    private:
        const RH_EXPOSURE_MAX_NODES: i64 = 1024
        const RH_EXPOSURE_MAX_EDGES: i64 = 200000
        const RH_EXPOSURE_MAX_ROLE_EVENTS: i64 = 20000
        const RH_EXPOSURE_MAX_ACTORS_PER_NODE: i64 = 256

        struct RhExposureActor:
            node: mutable i64
            actor_s: mutable i64
            actor_e: mutable i64

        struct RhExposureMapping:
            node: mutable i64
            evidence_s: mutable i64
            evidence_e: mutable i64
            complete: mutable bool

        def rh_exposure_member(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, object: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_obj_get(nodes, texts, object, key)

        def rh_exposure_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, object: i64, key: u8&, value: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = rh_exposure_member(nodes, texts, object, key)
            return false if idx < 0
            ok: mutable i64 = 0
            value[0] <- Json::rh_json_int(nodes, raw, idx, &ok)
            ok == 1

        def rh_exposure_span_eq(texts: darray[u8]&, start: i64, end: i64, literal: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if start < 0 or end < start or end - start != strlen(literal).i64()
            while i < end - start |i: i64 = 0, texts, start, literal|:
                return false if texts[(start + i).usize()] != literal[i.usize()]
                i <- i + 1
            true

        def rh_exposure_hex(texts: darray[u8]&, start: i64, end: i64, width: i64) -> bool:
            return false if end - start != width
            while i < end |i: i64 = start, texts|:
                b: u8 = texts[i.usize()]
                return false if not ((b >= 48 and b <= 57) or (b >= 97 and b <= 102))
                i <- i + 1
            true

        def rh_exposure_emit(out: mutable darray[u8]&, texts: darray[u8]&, start: i64, end: i64) -> void can[Memory.Allocate, Abort.Panic]:
            out.push(34)
            Base::rh_json_escape(out, texts, start.usize(), end.usize())
            out.push(34)

        def rh_exposure_role(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_exposure_span_eq(texts, start, end, "author") or rh_exposure_span_eq(texts, start, end, "committer") or rh_exposure_span_eq(texts, start, end, "reviewer") or rh_exposure_span_eq(texts, start, end, "releaser")

    public:
        # Input binds one package graph to accepted, complete role-evidence
        # projections for selected nodes. Missing mappings remain unknown.
        def rh_maintenance_exposure_report(raw: darray[u8]&, evidence_root: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            return -1 if raw.count.i64() > 8388608
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema: i64 = rh_exposure_member(nodes, texts, root, "schema")
            schema_s: mutable i64 = -1
            schema_e: mutable i64 = -1
            return -1 if not Json::rh_json_str_span(nodes, schema, &schema_s, &schema_e) or not rh_exposure_span_eq(texts, schema_s, schema_e, "rh-maintenance-exposure-input/1")
            graph: i64 = rh_exposure_member(nodes, texts, root, "graph")
            mappings_idx: i64 = rh_exposure_member(nodes, texts, root, "mappings")
            return -1 if graph < 0 or mappings_idx < 0 or nodes[graph.usize()].kind != Json::RH_JSON_OBJ or nodes[mappings_idx.usize()].kind != Json::RH_JSON_ARR
            graph_schema: i64 = rh_exposure_member(nodes, texts, graph, "schema")
            graph_schema_s: mutable i64 = -1
            graph_schema_e: mutable i64 = -1
            return -1 if not Json::rh_json_str_span(nodes, graph_schema, &graph_schema_s, &graph_schema_e) or not rh_exposure_span_eq(texts, graph_schema_s, graph_schema_e, "rh-dep-graph/1")
            graph_nodes: i64 = rh_exposure_member(nodes, texts, graph, "nodes")
            edges: i64 = rh_exposure_member(nodes, texts, graph, "edges")
            return -1 if graph_nodes < 0 or edges < 0 or nodes[graph_nodes.usize()].kind != Json::RH_JSON_ARR or nodes[edges.usize()].kind != Json::RH_JSON_ARR
            node_count: i64 = nodes[graph_nodes.usize()].child_count
            return -1 if node_count <= 0 or node_count > RH_EXPOSURE_MAX_NODES
            return -1 if nodes[edges.usize()].child_count > RH_EXPOSURE_MAX_EDGES
            while graph_node >= 0 |graph_node: i64 = nodes[graph_nodes.usize()].first_child, graph_index: i64 = 0, nodes, raw, graph_nodes|:
                graph_node_id: mutable i64 = -1
                return -1 if not rh_exposure_int(nodes, raw, texts, graph_node, "id", &graph_node_id) or graph_node_id != graph_index
                graph_index <- graph_index + 1
                graph_node <- nodes[graph_node.usize()].next_sibling
            subject: mutable i64 = -1
            mapping_revision: mutable i64 = -1
            return -1 if not rh_exposure_int(nodes, raw, texts, root, "subject_node", &subject) or subject < 0 or subject >= node_count
            return -1 if not rh_exposure_int(nodes, raw, texts, root, "mapping_revision", &mapping_revision) or mapping_revision < 0
            visited: mutable darray[bool] = []
            mapped: mutable darray[bool] = []
            mapping_seen: mutable darray[bool] = []
            while i < node_count |i: i64 = 0, node_count, visited, mapped, mapping_seen|:
                visited.push(false)
                mapped.push(false)
                mapping_seen.push(false)
                i <- i + 1
            actors: mutable darray[RhExposureActor] = []
            actor_texts: mutable darray[u8] = []
            mapping_rows: mutable darray[RhExposureMapping] = []
            while mapping >= 0 |mapping: i64 = nodes[mappings_idx.usize()].first_child, nodes, texts, raw, graph_nodes, node_count, mapped, mapping_seen, actors, actor_texts, mapping_rows, evidence_root|:
                return -1 if nodes[mapping.usize()].kind != Json::RH_JSON_OBJ
                node_id: mutable i64 = -1
                return -1 if not rh_exposure_int(nodes, raw, texts, mapping, "node", &node_id) or node_id < 0 or node_id >= node_count or mapping_seen[node_id.usize()]
                state: i64 = rh_exposure_member(nodes, texts, mapping, "state")
                state_s: mutable i64 = -1
                state_e: mutable i64 = -1
                return -1 if not Json::rh_json_str_span(nodes, state, &state_s, &state_e) or not rh_exposure_span_eq(texts, state_s, state_e, "accepted")
                reviewed_by: i64 = rh_exposure_member(nodes, texts, mapping, "reviewed_by")
                reviewed_s: mutable i64 = -1
                reviewed_e: mutable i64 = -1
                return -1 if not Json::rh_json_str_span(nodes, reviewed_by, &reviewed_s, &reviewed_e) or reviewed_s == reviewed_e
                reviewed_at: mutable i64 = -1
                return -1 if not rh_exposure_int(nodes, raw, texts, mapping, "reviewed_at", &reviewed_at) or reviewed_at < 0
                complete_idx: i64 = rh_exposure_member(nodes, texts, mapping, "complete")
                return -1 if complete_idx < 0 or nodes[complete_idx.usize()].kind != Json::RH_JSON_BOOL
                is_complete: bool = Json::rh_json_is_true(nodes, raw, complete_idx)
                evidence_ref: i64 = rh_exposure_member(nodes, texts, mapping, "evidence_ref")
                evidence_s: mutable i64 = -1
                evidence_e: mutable i64 = -1
                return -1 if not Json::rh_json_str_span(nodes, evidence_ref, &evidence_s, &evidence_e) or not rh_exposure_hex(texts, evidence_s, evidence_e, 16)
                evidence_name: mutable darray[u8] = []
                while name_cursor < evidence_e |name_cursor: i64 = evidence_s, texts, evidence_name|:
                    evidence_name.push(texts[name_cursor.usize()])
                    name_cursor <- name_cursor + 1
                evidence_name.push(0)
                evidence_ptr: u8& = (&evidence_name[0]).cast[u8&] can Unsafe.PointerCast
                evidence_path: mutable darray[u8] = []
                Base::rh_push_cstr(evidence_path, evidence_root)
                evidence_path.push(47)
                while path_cursor < evidence_e - evidence_s |path_cursor: i64 = 0, texts, evidence_s, evidence_e, evidence_path|:
                    evidence_path.push(texts[(evidence_s + path_cursor).usize()])
                    path_cursor <- path_cursor + 1
                evidence_path.push(0)
                evidence_path_ptr: cstr = (&evidence_path[0]).cast[cstr] can Unsafe.PointerCast
                evidence_size: i64 = Base::rh_file_size(evidence_path_ptr)
                return -1 if evidence_size <= 0 or evidence_size > 1048576
                role_raw: mutable darray[u8] = []
                return -1 if Base::rh_io_read(evidence_path_ptr, role_raw) != evidence_size
                return -1 if not Store::rh_store_blob_content_matches(evidence_ptr, role_raw)
                role_nodes: mutable darray[Json::RhJsonNode] = []
                role_texts: mutable darray[u8] = []
                role_root: i64 = Json::rh_json_parse(role_raw, role_nodes, role_texts)
                return -1 if role_root < 0 or role_nodes[role_root.usize()].kind != Json::RH_JSON_OBJ
                role_schema: i64 = rh_exposure_member(role_nodes, role_texts, role_root, "schema")
                role_schema_s: mutable i64 = -1
                role_schema_e: mutable i64 = -1
                return -1 if not Json::rh_json_str_span(role_nodes, role_schema, &role_schema_s, &role_schema_e) or not rh_exposure_span_eq(role_texts, role_schema_s, role_schema_e, "rh-role-grain-result/1")
                identity_revision: mutable i64 = -1
                return -1 if not rh_exposure_int(role_nodes, role_raw, role_texts, role_root, "identity_revision", &identity_revision) or identity_revision < 0
                ledger: i64 = rh_exposure_member(role_nodes, role_texts, role_root, "current_event_ledger")
                return -1 if ledger < 0 or role_nodes[ledger.usize()].kind != Json::RH_JSON_ARR or role_nodes[ledger.usize()].child_count > RH_EXPOSURE_MAX_ROLE_EVENTS
                mapping_seen[node_id.usize()] <- true
                mapped[node_id.usize()] <- is_complete
                mapping_rows.push(RhExposureMapping{node: node_id, evidence_s: evidence_s, evidence_e: evidence_e, complete: is_complete})
                mapped_actor_count: mutable i64 = 0
                if is_complete:
                    while event >= 0 |event: i64 = role_nodes[ledger.usize()].first_child, role_nodes, role_texts, role_raw, actors, actor_texts, node_id|:
                        return -1 if role_nodes[event.usize()].kind != Json::RH_JSON_OBJ
                        event_id: i64 = rh_exposure_member(role_nodes, role_texts, event, "id")
                        event_id_s: mutable i64 = -1
                        event_id_e: mutable i64 = -1
                        return -1 if not Json::rh_json_str_span(role_nodes, event_id, &event_id_s, &event_id_e) or event_id_s == event_id_e
                        actor: i64 = rh_exposure_member(role_nodes, role_texts, event, "actor")
                        actor_s: mutable i64 = -1
                        actor_e: mutable i64 = -1
                        return -1 if not Json::rh_json_str_span(role_nodes, actor, &actor_s, &actor_e) or actor_s == actor_e
                        role: i64 = rh_exposure_member(role_nodes, role_texts, event, "role")
                        role_s: mutable i64 = -1
                        role_e: mutable i64 = -1
                        return -1 if not Json::rh_json_str_span(role_nodes, role, &role_s, &role_e) or not rh_exposure_role(role_texts, role_s, role_e)
                        event_at: mutable i64 = -1
                        return -1 if not rh_exposure_int(role_nodes, role_raw, role_texts, event, "at", &event_at) or event_at < 0
                        duplicate: mutable bool = false
                        while i < actors.count |i: usize = 0, actors, actor_texts, node_id, role_texts, actor_s, actor_e, duplicate|:
                            duplicate <- true if actors[i].node == node_id and Base::rh_bytes_equal_span(actor_texts, actors[i].actor_s, actors[i].actor_e, role_texts, actor_s, actor_e)
                            i <- i + 1
                        if not duplicate:
                            mapped_actor_count <- mapped_actor_count + 1
                            return -1 if mapped_actor_count > RH_EXPOSURE_MAX_ACTORS_PER_NODE
                            copied_actor_s: i64 = actor_texts.count.i64()
                            while actor_copy_cursor < actor_e |actor_copy_cursor: i64 = actor_s, role_texts, actor_texts|:
                                actor_texts.push(role_texts[actor_copy_cursor.usize()])
                                actor_copy_cursor <- actor_copy_cursor + 1
                            actors.push(RhExposureActor{node: node_id, actor_s: copied_actor_s, actor_e: actor_texts.count.i64()})
                        event <- role_nodes[event.usize()].next_sibling
                mapping <- nodes[mapping.usize()].next_sibling
            head: mutable darray[i64] = []
            while i < node_count |i: i64 = 0, node_count, head|:
                head.push(-1)
                i <- i + 1
            dependent: mutable darray[i64] = []
            next_edge: mutable darray[i64] = []
            while edge >= 0 |edge: i64 = nodes[edges.usize()].first_child, nodes, texts, raw, head, dependent, next_edge, node_count|:
                return -1 if nodes[edge.usize()].kind != Json::RH_JSON_OBJ
                from: mutable i64 = -1
                destination: mutable i64 = -1
                return -1 if not rh_exposure_int(nodes, raw, texts, edge, "from", &from) or not rh_exposure_int(nodes, raw, texts, edge, "to", &destination) or from < 0 or destination < 0 or from >= node_count or destination >= node_count
                dependent.push(from)
                next_edge.push(head[destination.usize()])
                head[destination.usize()] <- (dependent.count - 1).i64()
                edge <- nodes[edge.usize()].next_sibling
            visited[subject.usize()] <- true
            queue: mutable darray[i64] = [subject]
            while queue_position < queue.count |queue_position: usize = 0, queue, head, dependent, next_edge, visited|:
                target: i64 = queue[queue_position]
                edge_id: mutable i64 = head[target.usize()]
                while edge_id >= 0 |edge_id, dependent, next_edge, queue, visited|:
                    discovered: i64 = dependent[edge_id.usize()]
                    if not visited[discovered.usize()]:
                        visited[discovered.usize()] <- true
                        queue.push(discovered)
                    edge_id <- next_edge[edge_id.usize()]
                queue_position <- queue_position + 1
            known_pairs: mutable i64 = 0
            unknown_pairs: mutable i64 = 0
            input_sha: mutable darray[u8] = []
            Base::rh_push_text(out, "{\"schema\":\"rh-maintenance-exposure-result/1\",\"source_input_sha256\":\"")
            Sha256::rh_sha256(raw, input_sha)
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"mapping_revision\":")
            Base::rh_push_decimal_i64(out, mapping_revision)
            Base::rh_push_text(out, ",\"subject_node\":")
            Base::rh_push_decimal_i64(out, subject)
            Base::rh_push_text(out, ",\"dependents\":[")
            wrote_pair: mutable bool = false
            while node_id < node_count |node_id: i64 = 0, node_count, visited, mapped, mapping_rows, actors, actor_texts, texts, out, subject, known_pairs, unknown_pairs|:
                if visited[node_id.usize()] and node_id != subject:
                    if wrote_pair:
                        out.push(44)
                    Base::rh_push_text(out, "{\"node\":")
                    Base::rh_push_decimal_i64(out, node_id)
                    Base::rh_push_text(out, ",\"state\":\"")
                    if mapped[subject.usize()] and mapped[node_id.usize()]:
                        Base::rh_push_text(out, "known\",\"shared_actor_count\":")
                        overlap: mutable i64 = 0
                        while i < actors.count |i: usize = 0, actors, actor_texts, subject, node_id, overlap|:
                            current_actor: RhExposureActor = actors[i]
                            if current_actor.node == subject:
                                while j < actors.count |j: usize = 0, actors, actor_texts, current_actor, node_id, overlap|:
                                    overlap <- overlap + 1 if actors[j].node == node_id and Base::rh_bytes_equal_span(actor_texts, current_actor.actor_s, current_actor.actor_e, actor_texts, actors[j].actor_s, actors[j].actor_e)
                                    j <- j + 1
                            i <- i + 1
                        Base::rh_push_decimal_i64(out, overlap)
                        known_pairs <- known_pairs + 1
                    else:
                        Base::rh_push_text(out, "unknown\",\"shared_actor_count\":null")
                        unknown_pairs <- unknown_pairs + 1
                    Base::rh_push_text(out, ",\"subject_evidence_ref\":")
                    _ = rh_exposure_emit_mapping(out, mapping_rows, texts, subject)
                    Base::rh_push_text(out, ",\"dependent_evidence_ref\":")
                    _ = rh_exposure_emit_mapping(out, mapping_rows, texts, node_id)
                    Base::rh_push_text(out, "}")
                    wrote_pair <- true
                node_id <- node_id + 1
            Base::rh_push_text(out, "],\"known_pair_count\":")
            Base::rh_push_decimal_i64(out, known_pairs)
            Base::rh_push_text(out, ",\"unknown_pair_count\":")
            Base::rh_push_decimal_i64(out, unknown_pairs)
            Base::rh_push_text(out, "}")
            0

        def rh_exposure_emit_mapping(out: mutable darray[u8]&, mappings: darray[RhExposureMapping]&, texts: darray[u8]&, node: i64) -> void can[Memory.Allocate, Abort.Panic]:
            while i < mappings.count |i: usize = 0, mappings, texts, node|:
                if mappings[i].node == node:
                    rh_exposure_emit(out, texts, mappings[i].evidence_s, mappings[i].evidence_e)
                    return
                i <- i + 1
            Base::rh_push_text(out, "null")
