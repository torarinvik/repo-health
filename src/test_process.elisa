include "./rh_base.elisa"
include "./rh_process.elisa"

def process_check(condition: bool, label: u8&, failures: mutable i64&, output: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    return if condition
    failures[0] <- failures[0] + 1
    Base::rh_push_text(output, "process-fail: ")
    Base::rh_push_text(output, label)
    output.push(10)

def main() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    failures: mutable i64 = 0
    output: mutable darray[u8] = []
    args: mutable darray[u8] = []
    Process::rh_append_arg(args, "printf")
    Process::rh_append_arg(args, "%s")
    Process::rh_append_arg(args, "literal ; $(touch /tmp/rh-process-must-not-exist)")
    args.push(0)
    env: mutable darray[u8] = []
    Process::rh_append_arg(env, "LC_ALL=C")
    Process::rh_append_arg(env, "PATH=/usr/bin:/bin")
    env.push(0)
    args_ptr: cstr = (&args[0]).cast[cstr] can Unsafe.PointerCast
    env_ptr: cstr = (&env[0]).cast[cstr] can Unsafe.PointerCast
    literal_status: i32 = rh_process_run("/usr/bin/printf", args_ptr, env_ptr, "", 0, "/tmp/rh-process-literal.out", "/tmp/rh-process-literal.err", 1000)
    process_check(literal_status == 0, "successful-exit-status", &failures, output)
    bytes: mutable darray[u8] = []
    read_status: i64 = Base::rh_io_read("/tmp/rh-process-literal.out", bytes)
    process_check(read_status >= 0 and Base::rh_bytes_equal_literal(bytes, 0, bytes.count.i64(), "literal ; $(touch /tmp/rh-process-must-not-exist)"), "argv-is-literal", &failures, output)
    process_check(not file_exists("/tmp/rh-process-must-not-exist"), "shell-metacharacters-not-executed", &failures, output)
    byte_args: mutable darray[u8] = []
    Process::rh_append_arg(byte_args, "printf")
    Process::rh_append_arg(byte_args, "%s")
    byte_value: mutable darray[u8] = []
    Base::rh_push_text(byte_value, "byte-vector-argument")
    Process::rh_append_arg_bytes(byte_args, byte_value)
    byte_args.push(0)
    byte_status: i32 = Process::rh_run("/usr/bin/printf", byte_args, env, "/tmp/rh-process-bytes.out", "/dev/null")
    byte_output: mutable darray[u8] = []
    byte_read_status: i64 = Base::rh_io_read("/tmp/rh-process-bytes.out", byte_output)
    process_check(byte_status == 0 and byte_read_status >= 0 and Base::rh_bytes_equal_literal(byte_output, 0, byte_output.count.i64(), "byte-vector-argument"), "byte-vector-appends-one-terminator", &failures, output)
    cat_args: mutable darray[u8] = []
    Process::rh_append_arg(cat_args, "cat")
    cat_args.push(0)
    cat_input: mutable darray[u8] = []
    Base::rh_push_text(cat_input, "explicit stdin bytes")
    cat_status: i32 = Process::rh_run_with_input_timeout("/bin/cat", cat_args, env, cat_input, "/tmp/rh-process-stdin.out", "/tmp/rh-process-stdin.err", 1000)
    cat_output: mutable darray[u8] = []
    cat_read_status: i64 = Base::rh_io_read("/tmp/rh-process-stdin.out", cat_output)
    process_check(cat_status == 0 and cat_read_status >= 0 and Base::rh_bytes_equal_literal(cat_output, 0, cat_output.count.i64(), "explicit stdin bytes"), "bounded-explicit-stdin", &failures, output)
    timeout_args: mutable darray[u8] = []
    Process::rh_append_arg(timeout_args, "sleep")
    Process::rh_append_arg(timeout_args, "2")
    timeout_args.push(0)
    timeout_ptr: cstr = (&timeout_args[0]).cast[cstr] can Unsafe.PointerCast
    timed_out: i32 = rh_process_run("/bin/sleep", timeout_ptr, env_ptr, "", 0, "/dev/null", "/dev/null", 50)
    process_check(timed_out == 124, "bounded-timeout", &failures, output)
    bad_args: mutable darray[u8] = []
    Process::rh_append_arg(bad_args, "missing")
    bad_args.push(0)
    bad_ptr: cstr = (&bad_args[0]).cast[cstr] can Unsafe.PointerCast
    missing_status: i32 = rh_process_run("/missing/repo-health-command", bad_ptr, env_ptr, "", 0, "/dev/null", "/dev/null", 1000)
    process_check(missing_status < 0, "missing-executable-fails-closed", &failures, output)
    if failures > 0:
        Base::rh_write_stdout(output)
        return 1
    Base::rh_push_text(output, "PROCESS OK\n")
    Base::rh_write_stdout(output)
    0
