# rh_evidence.elisa — evidence digests (M00-06).
#
# FNV-1a 64 over the numeric event stream (counts, timestamps, month
# indices). The digest covers numbers, never report text, so verification
# needs no string-byte access: replay re-parses the retained bundle inputs
# and recomputes the same stream. u64 arithmetic wraps modulo 2^64, which
# is exactly the FNV specification.
#
# Reference vectors (spec): empty -> 0xcbf29ce484222325;
# "a" (0x61) -> 0xaf63dc4c8601ec8c; "foobar" -> 0x85944171f73967e8.

module Evidence:
    private:
        const RH_FNV_OFFSET: u64 = 14695981039346656037
        const RH_FNV_PRIME: u64 = 1099511628211

    public:
        def rh_fnv_begin() -> u64:
            RH_FNV_OFFSET

        def rh_fnv_byte(hash: u64, byte: u8) -> u64:
            (hash ^ byte.u64()) * RH_FNV_PRIME

        # Feed one u64 little-endian (8 bytes).
        def rh_fnv_u64(hash: u64, value: u64) -> u64:
            for k in 0..<8.usize() |h: u64 = hash| -> h:
                h <- Evidence::rh_fnv_byte(h, ((value >> k) & 255).u8())

        def rh_fnv_i64(hash: u64, value: i64) -> u64:
            h: u64 =
                magnitude: u64 = (-value).u64() if value < 0 else value.u64()
                Evidence::rh_fnv_u64(hash, magnitude)
            Evidence::rh_fnv_byte(h, 1 if value < 0 else 0)

        # Feed one raw byte value given as u64 (0..255) — used by oracle vectors.
        def rh_fnv_byte_value(hash: u64, byte_value: u64) -> u64:
            Evidence::rh_fnv_byte(hash, (byte_value & 255).u8())
