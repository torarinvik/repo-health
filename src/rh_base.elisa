# rh_base.elisa — shared foundation (M00).
#
# Standard-library first: the Elisa standard library (elisacore_std)
# provides the libc declarations and core services used here — strlen,
# strcmp, puts, write, getenv, file_exists, arenas, string views. This
# file declares NO extern that the standard library already provides.
# Remaining direct `extern`s are only what the standard library lacks:
# `system` (subprocess, allowlisted in rh_git), `mkdir`, and `time`.
# File I/O uses the standard error-union helpers. Byte operations use
# bounded string views so embedded NUL bytes remain ordinary data.
#
# Layout assumption (same default as tools/*.sh): Elisa-compiler is a
# sibling directory of this repository.
include "../../Elisa-compiler/elisacore_std/elisacore_runtime.elisa"
include "../../Elisa-compiler/elisacore_std/elisacore_fileio.elisa"

extern system(command: cstr) -> i32
extern mkdir(path: cstr, mode: u16) -> i32
# Environment read for explicit test hooks (e.g. lowering the history bound
# to exercise the truncation path). NULL when unset.
extern getenv(name: cstr) -> u8&?

@link_name("time")
extern c_time(arg: void&?) -> i64


# Current Unix time (seconds). -1 on failure; callers treat -1 as unknown,
# never as an epoch value.
def rh_now() -> i64:
    c_time(null)

# strlen as i64 (-1 on null).
def rh_cstr_len(text: u8&?) -> i64:
    return 0 if text == null
    src: u8& = text
    strlen(src).i64()

# C-string equality via strcmp.
def rh_streq(a: u8&, b: u8&) -> bool:
    strcmp(a, b) == 0

# Byte helpers on NUL-terminated cstr.
def rh_cstr_starts_with(s: cstr, prefix: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    sview_starts_with(sview(s, 0, -1), sview(prefix, 0, -1))

def rh_cstr_len_c(s: cstr) -> usize can[Memory.Allocate, Abort.Panic]:
    sview_len(sview(s, 0, -1))

# True when a "scheme://" prefix precedes any '/'. Used to reject
# non-https remotes without parsing URLs.
def rh_cstr_has_scheme(s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
    while true |i: usize = 0, s|:
        b: u8 = s[i]
        break if b == 0
        if b == 58:
            return true if s[i + 1] == 47 and s[i + 2] == 47
            return false
        return false if b == 47
        i <- i + 1
    false

# Append NUL-terminated text bytes to buffer.
def rh_push_text(buffer: mutable darray[u8]&, text: u8&) -> void can[Memory.Allocate, Abort.Panic]:
    buffer.extend(sview(text, 0, -1))

# Append raw bytes 0..count-1 of data to buffer.
def rh_push_raw(buffer: mutable darray[u8]&, data: u8&, count: usize) -> void can[Memory.Allocate, Abort.Panic]:
    while i < count |i: usize = 0, buffer, data|:
        buffer.push(data[i])
        i <- i + 1

# Unsigned decimal of a u64 value.
def rh_push_decimal_u64(buffer: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
    if value == 0:
        buffer.push(48)
        return
    digits: darray[u8] =
        for _step in 0..<64 |remaining: u64 = value, digits: darray[u8] = []| -> digits:
            break if remaining == 0
            digits.push((48 + (remaining % 10)).u8())
            remaining <- remaining / 10
    for reverse_index in 0..<digits.count |buffer, digits|:
        buffer.push(digits[digits.count - 1.usize() - reverse_index])

# Signed decimal of an i64 value (INT64_MIN spelled explicitly).
def rh_push_decimal_i64(buffer: mutable darray[u8]&, value: i64) -> void can[Memory.Allocate, Abort.Panic]:
    if value == -9223372036854775807 - 1:
        rh_push_text(buffer, "-9223372036854775808")
        return
    buffer.push(45) if value < 0
    if value == 0:
        buffer.push(48)
        return
    digits: darray[u8] =
        while magnitude > 0 |magnitude: i64 = -value if value < 0 else value, digits: darray[u8] = []| -> digits:
            digits.push((48 + (magnitude % 10)).u8())
            magnitude <- magnitude / 10
    for reverse_index in 0..<digits.count |buffer, digits|:
        buffer.push(digits[digits.count - 1.usize() - reverse_index])

# Lowercase hex of a u64 value, exactly 16 nibbles (digest rendering).
def rh_push_hex_u64(buffer: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
    while shift >= 0 |shift: i64 = 60, buffer, value|:
        nibble: u64 = (value >> shift.usize()) & 15
        buffer.push((48 + nibble).u8()) if nibble < 10
        buffer.push((87 + nibble).u8()) if nibble >= 10
        shift <- shift - 4

# Write buffer bytes to fd 1 (stdout) or 2 (stderr). Empty buffers are a no-op
# (never index buffer[0] when count is 0).
def rh_write_fd(fd: i32, buffer: darray[u8]&) -> void can[Console, Abort.Panic, Unsafe.PointerCast]:
    return if buffer.count == 0
    raw: void& = (&buffer[0]).cast[void&] can Unsafe.PointerCast
    _ = write(fd, raw, buffer.count)

def rh_write_stdout(buffer: darray[u8]&) -> void can[Console, Abort.Panic, Unsafe.PointerCast]:
    rh_write_fd(1, buffer)

def rh_write_stderr(buffer: darray[u8]&) -> void can[Console, Abort.Panic, Unsafe.PointerCast]:
    rh_write_fd(2, buffer)

# Convenience: single line to stdout (text + newline).
def rh_print_line(text: u8&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    buffer: mutable darray[u8] =
        buffer: mutable darray[u8] = []
        rh_push_text(buffer, text)
        buffer.push(10)
        buffer
    rh_write_stdout(buffer)

# --- Path helpers (M01). ---

# Append NUL-terminated cstr bytes to buffer.
def rh_push_cstr(buffer: mutable darray[u8]&, s: cstr) -> void can[Memory.Allocate, Abort.Panic]:
    buffer.extend(sview(s, 0, -1))

# NUL-terminate a path buffer IN PLACE for libc calls. Returns false when
# the buffer is empty (never fabricate a path).
def rh_terminate(buffer: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if buffer.count == 0
    buffer.push(0)
    true

# --- File I/O through the standard library (M01). The bounded wrappers
# below are the only file functions in this codebase: std
# `read_entire_file` / `write_entire_file` (arena-backed, error unions)
# with engine-style expression `catch`. Reads refuse files larger than
# RH_MAX_READ instead of growing without limit (S012). ---

const RH_MAX_READ: i64 = 67108864

# File size via std `file_size`. -1 when unknown (missing/unreadable).
def rh_file_size(path: cstr) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic]:
    got: i64 = catch file_size(path):
        value: value
        FileIoError.OpenFailed: -1
        FileIoError.ReadFailed: -1
        FileIoError.SeekFailed: -1
        FileIoError.WriteFailed: -1
    got

# Append src bytes to dst; returns the appended count.
def rh_absorb_bytes(src: darray[u8]&, dst: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    dst.extend(bytes_view(src))
    src.count.i64()

# Read the whole file, appended into buffer. Returns the byte count, or -1
# on any failure or when the file exceeds RH_MAX_READ.
def rh_io_read(path: cstr, buffer: mutable darray[u8]&) -> i64 can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic]:
    return -1 if rh_file_size(path) > RH_MAX_READ
    got: i64 = catch read_entire_file(&perm_arena, path):
        value: rh_absorb_bytes(value, buffer)
        FileIoError.OpenFailed: -1
        FileIoError.ReadFailed: -1
        FileIoError.SeekFailed: -1
        FileIoError.WriteFailed: -1
    got

# Write buffer bytes to path (truncate). True only on a full write.
def rh_io_write(path: cstr, data: mutable darray[u8]&) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
    wrote: bool = catch write_entire_file(path, bytes_view(data)):
        value: value == data.count.i64()
        FileIoError.OpenFailed: false
        FileIoError.ReadFailed: false
        FileIoError.SeekFailed: false
        FileIoError.WriteFailed: false
    wrote

def rh_make_dir(path: cstr) -> bool:
    mkdir(path, 493) == 0

# Parse decimal [start, end) from byte buffer. ok_out: 1 valid, 0 invalid.
# Optional leading '-'; empty span or any other byte is invalid.
def rh_parse_i64(data: darray[u8]&, start: usize, end: usize, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    ok_out[0] <- 0
    return 0 if start >= end
    return 0 if end > data.count
    negative: mutable bool = false
    cursor: mutable usize = start
    if data[cursor] == 45:
        negative <- true
        cursor <- cursor + 1
        return 0 if cursor >= end
    acc: i64 =
        while cursor < end |acc: i64 = 0, cursor| -> acc:
            place: i64 = |cursor|
                digit: u8 = data[cursor]
                return 0 if digit < 48 or digit > 57
                (digit - 48).i64()
            return 0 if acc > 9223372036854775807 / 10
            acc <- acc * 10
            return 0 if acc > 9223372036854775807 - place
            acc <- acc + place
            cursor <- cursor + 1
    ok_out[0] <- 1
    return -acc if negative
    acc

# Index of byte value at or after start; -1 when absent.
def rh_find_byte(data: darray[u8]&, start: usize, target: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
    return -1 if start >= data.count
    offset: i64 = sview_find_byte(string_view_suffix(bytes_view(data), start.i64()), target)
    -1 if offset < 0 else start.i64() + offset

# Length-bounded content comparison shared by adapters. Invalid spans are
# rejected before std's slicing helper (which intentionally clamps ranges).
def rh_bytes_equal_literal(data: darray[u8]&, start: i64, end: i64, literal: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if start < 0 or end < start or end > data.count.i64()
    string_view_eq(string_view_slice(bytes_view(data), start, end), literal) == 1

def rh_bytes_equal_span(a: darray[u8]&, a_start: i64, a_end: i64, b: darray[u8]&, b_start: i64, b_end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if a_start < 0 or a_end < a_start or a_end > a.count.i64()
    return false if b_start < 0 or b_end < b_start or b_end > b.count.i64()
    string_views_eq(string_view_slice(bytes_view(a), a_start, a_end), string_view_slice(bytes_view(b), b_start, b_end)) == 1

# Count non-empty lines.
def rh_count_lines(data: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    while start < data.count |total: i64 = 0, start: usize = 0| -> total:
        stop: i64 = rh_find_byte(data, start, 10)
        line_end: usize = stop.usize() if stop >= 0 else data.count
        if line_end > start:
            total <- total + 1
        if stop < 0:
            start <- data.count
        else:
            start <- stop.usize() + 1

# JSON string escaping (shared writer primitive).
def rh_push_hexdigit(buffer: mutable darray[u8]&, nibble: u64) -> void can[Memory.Allocate, Abort.Panic]:
    if nibble < 10:
        buffer.push((48 + nibble).u8())
    else:
        buffer.push((87 + nibble).u8())


def rh_json_escape(buffer: mutable darray[u8]&, texts: darray[u8]&, start: usize, end: usize) -> void can[Memory.Allocate, Abort.Panic]:
    while i < end |i: usize = start, buffer, texts, end|:
        b: u8 = texts[i]
        if b == 34:
            rh_push_text(buffer, "\\\"")
        elif b == 92:
            rh_push_text(buffer, "\\\\")
        elif b < 32:
            v: u64 = b.u64()
            rh_push_text(buffer, "\\u00")
            rh_push_hexdigit(buffer, v / 16)
            rh_push_hexdigit(buffer, v % 16)
        else:
            buffer.push(b)
        i <- i + 1
