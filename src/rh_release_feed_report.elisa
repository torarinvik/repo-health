# rh_release_feed_report.elisa — release-only source execution path
# (M08 archive/releases lane).
#
# Turns an `rh-release-feed-input/1` feed into `rh-release-feed-result/1`:
# each release keeps its published time (valid time) and the collector's
# first-seen time (known time) separately, counts assets and how many carry
# a digest, and is keyed by (tag, first-seen) — a tag is a label, not a
# release event. No history or author identity is derived from this family;
# the report says so explicitly. A missing published time stays unknown
# rather than being replaced by first-seen. Malformed input fails closed.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_release_feed.elisa"
include "./rh_observation.elisa"

module ReleaseFeedReport:
    private:
        struct RhReleaseMetricTotals:
            release_count: i64
            rejected_count: i64
            asset_count: i64
            digest_known_count: i64
            published_count: i64
            stable_count: i64
            prerelease_count: i64
            withdrawn_count: i64
            supported_line_count: i64
            support_end_known: i64
            support_end_latest: i64
            release_notes_known: i64
            release_notes_present: i64
            target_change_known: i64
            target_change_count: i64
            source_mapping_known: i64
            source_mapped_count: i64
            latest_stable_age_days: i64
            interrelease_median_days: i64
            interrelease_variance: i64

        def rh_rfr_emit_metric(out: mutable darray[u8]&, key: cstr, version: cstr, value: Observation::RhMetricValue, status: u8, incomplete: bool, reason: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{
                completeness: Observation::RhCompleteness.Complete if status == Observation::RH_ST_OBSERVED else Observation::RhCompleteness.Partial if status == Observation::RH_ST_PARTIAL else Observation::RhCompleteness.Unknown,
                freshness: Observation::RhFreshness.Unknown,
                validity: Observation::RhValidity.Valid if status == Observation::RH_ST_OBSERVED else Observation::RhValidity.Unknown,
                provenance: Observation::RhProvenanceQuality.EvidenceBacked
            }
            evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
            Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.ReleaseFeedInput)
            observation: Observation::RhObservation = Observation::rh_observation_make_with_evidence(status, value, incomplete, quality, evidence)
            Observation::rh_observation_emit_metric(out, key, version, reason, observation)

        def rh_rfr_emit_count_metric(out: mutable darray[u8]&, key: cstr, version: cstr, count: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_rfr_emit_metric(out, key, version, Observation::RhMetricValue.Count(count), Observation::RH_ST_OBSERVED, false, "")

        def rh_rfr_emit_timestamp_metric(out: mutable darray[u8]&, key: cstr, version: cstr, timestamp: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_rfr_emit_metric(out, key, version, Observation::RhMetricValue.Timestamp(timestamp), Observation::RH_ST_OBSERVED, false, "")

        def rh_rfr_emit_ratio_metric(out: mutable darray[u8]&, key: cstr, version: cstr, numerator: i64, denominator: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            Observation::rh_ratio_valid(numerator, denominator) and rh_rfr_emit_metric(out, key, version, Observation::RhMetricValue.Ratio(numerator, denominator), Observation::RH_ST_OBSERVED, false, "")

        def rh_rfr_emit_absent_metric(out: mutable darray[u8]&, key: cstr, version: cstr, status: u8, reason: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_rfr_emit_metric(out, key, version, Observation::RhMetricValue.Absent, status, status == Observation::RH_ST_PARTIAL, reason)

        def rh_rfr_emit_release_note_metric(out: mutable darray[u8]&, totals: RhReleaseMetricTotals) -> bool can[Memory.Allocate, Abort.Panic]:
            if totals.release_count == 0:
                rh_rfr_emit_absent_metric(out, "release.release_note_presence", "2.0.0", Observation::RH_ST_NOT_APPLICABLE, "no-included-releases")
            elif totals.release_notes_known == 0:
                rh_rfr_emit_absent_metric(out, "release.release_note_presence", "2.0.0", Observation::RH_ST_UNSUPPORTED, "release-note-retrieval-state-not-supplied")
            elif totals.release_notes_known < totals.release_count:
                rh_rfr_emit_absent_metric(out, "release.release_note_presence", "2.0.0", Observation::RH_ST_PARTIAL, "release-note-retrieval-state-incomplete")
            else:
                rh_rfr_emit_ratio_metric(out, "release.release_note_presence", "2.0.0", totals.release_notes_present, totals.release_count)

        def rh_rfr_emit_target_change_metric(out: mutable darray[u8]&, totals: RhReleaseMetricTotals) -> bool can[Memory.Allocate, Abort.Panic]:
            if totals.target_change_known == 0:
                rh_rfr_emit_absent_metric(out, "release.tag_target_changes", "1.0.0", Observation::RH_ST_UNSUPPORTED, "tag-target-not-supplied")
            elif totals.target_change_known < 2:
                rh_rfr_emit_absent_metric(out, "release.tag_target_changes", "1.0.0", Observation::RH_ST_NOT_APPLICABLE, "fewer-than-two-tag-target-observations")
            else:
                rh_rfr_emit_count_metric(out, "release.tag_target_changes", "1.0.0", totals.target_change_count)

        def rh_rfr_emit_source_mapping_metric(out: mutable darray[u8]&, totals: RhReleaseMetricTotals) -> bool can[Memory.Allocate, Abort.Panic]:
            if totals.source_mapping_known == 0:
                rh_rfr_emit_absent_metric(out, "release.release_source_mapping_coverage", "1.0.0", Observation::RH_ST_UNSUPPORTED, "source-mapping-not-supplied")
            else:
                rh_rfr_emit_ratio_metric(out, "release.release_source_mapping_coverage", "1.0.0", totals.source_mapped_count, totals.source_mapping_known)

        def rh_rfr_emit_metrics(out: mutable darray[u8]&, totals: RhReleaseMetricTotals) -> bool can[Memory.Allocate, Abort.Panic]:
            ok: bool = |out|
                Base::rh_push_text(out, "[")
                first: bool = rh_rfr_emit_count_metric(out, "release.release_count", "1.0.0", totals.release_count)
                out.push(44) if first
                second: bool = first and rh_rfr_emit_count_metric(out, "release.rejected_count", "1.0.0", totals.rejected_count)
                out.push(44) if second
                third: bool = second and rh_rfr_emit_count_metric(out, "release.asset_count", "1.0.0", totals.asset_count)
                out.push(44) if third
                fourth: bool = third and rh_rfr_emit_count_metric(out, "release.digest_known_count", "1.0.0", totals.digest_known_count)
                out.push(44) if fourth
                fifth: bool = fourth and rh_rfr_emit_count_metric(out, "release.published_time_known_count", "1.0.0", totals.published_count)
                out.push(44) if fifth
                sixth: bool = fifth and rh_rfr_emit_count_metric(out, "release.stable_count", "1.0.0", totals.stable_count)
                out.push(44) if sixth
                seventh: bool = sixth and rh_rfr_emit_count_metric(out, "release.prerelease_count", "1.0.0", totals.prerelease_count)
                out.push(44) if seventh
                eighth: bool = seventh and rh_rfr_emit_count_metric(out, "release.withdrawn_publications", "1.0.0", totals.withdrawn_count)
                out.push(44) if eighth
                ninth: bool = eighth and rh_rfr_emit_count_metric(out, "release.supported_lines", "1.0.0", totals.supported_line_count)
                out.push(44) if ninth
                tenth: bool = ninth and (rh_rfr_emit_absent_metric(out, "release.support_end_timestamp", "1.0.0", Observation::RH_ST_UNSUPPORTED, "support-end-not-supplied") if totals.support_end_known == 0 else rh_rfr_emit_timestamp_metric(out, "release.support_end_timestamp", "1.0.0", totals.support_end_latest))
                out.push(44) if tenth
                eleventh: bool = tenth and rh_rfr_emit_release_note_metric(out, totals)
                out.push(44) if eleventh
                twelfth: bool = eleventh and rh_rfr_emit_target_change_metric(out, totals)
                out.push(44) if twelfth
                thirteenth: bool = twelfth and rh_rfr_emit_source_mapping_metric(out, totals)
                out.push(44) if thirteenth
                fourteenth: bool = thirteenth and (rh_rfr_emit_count_metric(out, "release.latest_stable_age_days", "1.0.0", totals.latest_stable_age_days) if totals.latest_stable_age_days >= 0 else rh_rfr_emit_absent_metric(out, "release.latest_stable_age_days", "1.0.0", Observation::RH_ST_NOT_APPLICABLE, "no-published-stable-release"))
                out.push(44) if fourteenth
                fifteenth: bool = fourteenth and (rh_rfr_emit_count_metric(out, "release.interrelease_median_days", "1.0.0", totals.interrelease_median_days) if totals.interrelease_median_days >= 0 else rh_rfr_emit_absent_metric(out, "release.interrelease_median_days", "1.0.0", Observation::RH_ST_NOT_APPLICABLE, "fewer-than-two-published-stable-releases"))
                out.push(44) if fifteenth
                sixteenth: bool = fifteenth and (rh_rfr_emit_count_metric(out, "release.interrelease_variance", "1.0.0", totals.interrelease_variance) if totals.interrelease_variance >= 0 else rh_rfr_emit_absent_metric(out, "release.interrelease_variance", "1.0.0", Observation::RH_ST_NOT_APPLICABLE, "fewer-than-two-published-stable-releases"))
                Base::rh_push_text(out, "]")
                sixteenth
            ok

        def rh_rel_supported_line_count(pool: darray[u8]&, releases: darray[ReleaseFeed::RhRelease]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            pool_loop: mutable darray[u8]& = pool
            releases_loop: mutable darray[ReleaseFeed::RhRelease]& = releases
            while i < releases_loop.count.i64() |total: i64 = 0, i: i64 = 0, pool_loop, releases_loop| -> total:
                release: ReleaseFeed::RhRelease = releases_loop[i.usize()]
                seen: mutable bool = false
                if release.supported_line_s >= 0:
                    while j < i |j: i64 = 0, i, pool_loop, releases_loop, release, seen|:
                        prior: ReleaseFeed::RhRelease = releases_loop[j.usize()]
                        if prior.supported_line_s >= 0 and ReleaseFeedReport::rh_rel_span_equal(pool_loop, prior.supported_line_s, prior.supported_line_e, release.supported_line_s, release.supported_line_e):
                            seen <- true
                        j <- j + 1
                    total <- total + 1 if not seen
                i <- i + 1

        def rh_rel_span_equal(pool: darray[u8]&, left_s: i64, left_e: i64, right_s: i64, right_e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_span(pool, left_s, left_e, pool, right_s, right_e)

        def rh_rel_tag_target_change_count(pool: darray[u8]&, releases: darray[ReleaseFeed::RhRelease]&, known_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            pool_loop: mutable darray[u8]& = pool
            releases_loop: mutable darray[ReleaseFeed::RhRelease]& = releases
            known_out[0] <- 0
            while i < releases_loop.count.i64() |total: i64 = 0, i: i64 = 0, pool_loop, releases_loop, known_out| -> total:
                release: ReleaseFeed::RhRelease = releases_loop[i.usize()]
                if release.target_s >= 0:
                    known_out[0] <- known_out[0] + 1
                    previous: mutable i64 = -1
                    previous_time: mutable i64 = -1
                    while j < releases_loop.count.i64() |j: i64 = 0, i, pool_loop, releases_loop, release, previous, previous_time|:
                        candidate: ReleaseFeed::RhRelease = releases_loop[j.usize()]
                        same_tag: bool = ReleaseFeedReport::rh_rel_span_equal(pool_loop, release.tag_s, release.tag_e, candidate.tag_s, candidate.tag_e)
                        earlier: bool = candidate.first_seen < release.first_seen or (candidate.first_seen == release.first_seen and j < i)
                        if j != i and candidate.target_s >= 0 and same_tag and earlier:
                            if previous < 0 or candidate.first_seen > previous_time or (candidate.first_seen == previous_time and j > previous):
                                previous <- j
                                previous_time <- candidate.first_seen
                        j <- j + 1
                    if previous >= 0:
                        prior: ReleaseFeed::RhRelease = releases_loop[previous.usize()]
                        if not ReleaseFeedReport::rh_rel_span_equal(pool_loop, release.target_s, release.target_e, prior.target_s, prior.target_e):
                            total <- total + 1
                i <- i + 1

        def rh_rel_sort_times(values: mutable darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
            while i < values.count |i: i64 = 1, values|:
                value: i64 = values[i.usize()]
                j: i64 = i
                while j > 0 and values[(j - 1).usize()] > value |j: i64 = i, value, values|:
                    values[j.usize()] <- values[(j - 1).usize()]
                    j <- j - 1
                values[j.usize()] <- value
                i <- i + 1

    public:
        def rh_rfr_report(raw: darray[u8]&, first_seen: i64, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            pool: mutable darray[u8] = []
            releases: mutable darray[ReleaseFeed::RhRelease] = []
            rej: mutable i64 = 0
            return -1 if ReleaseFeed::rh_release_feed_parse(raw, first_seen, 0, pool, releases, &rej) != 0
            asset_total: mutable i64 = 0
            digest_total: mutable i64 = 0
            published_total: mutable i64 = 0
            stable_total: mutable i64 = 0
            prerelease_total: mutable i64 = 0
            withdrawn_total: mutable i64 = 0
            support_end_latest: mutable i64 = 0
            support_end_known: mutable i64 = 0
            release_notes_known: mutable i64 = 0
            release_notes_present: mutable i64 = 0
            supported_line_total: i64 = ReleaseFeedReport::rh_rel_supported_line_count(pool, releases)
            target_change_known: mutable i64 = 0
            target_change_total: i64 = ReleaseFeedReport::rh_rel_tag_target_change_count(pool, releases, &target_change_known)
            source_mapped_total: mutable i64 = 0
            source_mapping_known: mutable i64 = 0
            stable_times: mutable darray[i64] = []
            Base::rh_push_text(out, "{\"schema\":\"rh-release-feed-result/1\",\"releases\":[")
            while i < releases.count.i64() |i: i64 = 0, releases, pool, out, asset_total, digest_total, published_total, stable_total, prerelease_total, stable_times|:
                r: ReleaseFeed::RhRelease = releases[i.usize()]
                asset_total <- asset_total + r.asset_count
                digest_total <- digest_total + r.digest_known_count
                published_total <- published_total + 1 if r.has_published == 1
                stable_total <- stable_total + 1 if r.prerelease == 0
                prerelease_total <- prerelease_total + 1 if r.prerelease == 1
                withdrawn_total <- withdrawn_total + 1 if r.withdrawn == 1
                if r.has_support_end == 1:
                    support_end_latest <- r.support_end if support_end_known == 0 or r.support_end > support_end_latest
                    support_end_known <- support_end_known + 1
                if r.release_notes_retrievable >= 0:
                    release_notes_known <- release_notes_known + 1
                    release_notes_present <- release_notes_present + 1 if r.release_notes_retrievable == 1
                if r.source_mapped >= 0:
                    source_mapping_known <- source_mapping_known + 1
                    source_mapped_total <- source_mapped_total + 1 if r.source_mapped == 1
                stable_times.push(r.published) if r.prerelease == 0 and r.has_published == 1
                if i > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"tag\":\"")
                if r.tag_s >= 0 and r.tag_e >= r.tag_s and r.tag_e <= pool.count.i64():
                    Base::rh_json_escape(out, pool, r.tag_s.usize(), r.tag_e.usize())
                Base::rh_push_text(out, "\",\"published_at\":")
                if r.has_published == 1:
                    Base::rh_push_decimal_i64(out, r.published)
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"target\":")
                if r.target_s < 0:
                    Base::rh_push_text(out, "null")
                else:
                    out.push(34)
                    Base::rh_json_escape(out, pool, r.target_s.usize(), r.target_e.usize())
                    out.push(34)
                Base::rh_push_text(out, ",\"prerelease\":")
                if r.prerelease < 0:
                    Base::rh_push_text(out, "null")
                elif r.prerelease == 1:
                    Base::rh_push_text(out, "true")
                else:
                    Base::rh_push_text(out, "false")
                Base::rh_push_text(out, ",\"withdrawn\":")
                if r.withdrawn < 0:
                    Base::rh_push_text(out, "null")
                elif r.withdrawn == 1:
                    Base::rh_push_text(out, "true")
                else:
                    Base::rh_push_text(out, "false")
                Base::rh_push_text(out, ",\"supported_line\":")
                if r.supported_line_s < 0:
                    Base::rh_push_text(out, "null")
                else:
                    out.push(34)
                    Base::rh_json_escape(out, pool, r.supported_line_s.usize(), r.supported_line_e.usize())
                    out.push(34)
                Base::rh_push_text(out, ",\"support_end_at\":")
                if r.has_support_end == 1:
                    Base::rh_push_decimal_i64(out, r.support_end)
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"support_end_issuer\":")
                if r.support_end_issuer_s < 0:
                    Base::rh_push_text(out, "null")
                else:
                    out.push(34)
                    Base::rh_json_escape(out, pool, r.support_end_issuer_s.usize(), r.support_end_issuer_e.usize())
                    out.push(34)
                Base::rh_push_text(out, ",\"release_notes_retrievable\":")
                if r.release_notes_retrievable < 0:
                    Base::rh_push_text(out, "null")
                elif r.release_notes_retrievable == 1:
                    Base::rh_push_text(out, "true")
                else:
                    Base::rh_push_text(out, "false")
                Base::rh_push_text(out, ",\"source_mapped\":")
                if r.source_mapped < 0:
                    Base::rh_push_text(out, "null")
                elif r.source_mapped == 1:
                    Base::rh_push_text(out, "true")
                else:
                    Base::rh_push_text(out, "false")
                Base::rh_push_text(out, ",\"first_seen\":")
                Base::rh_push_decimal_i64(out, r.first_seen)
                Base::rh_push_text(out, ",\"asset_count\":")
                Base::rh_push_decimal_i64(out, r.asset_count)
                Base::rh_push_text(out, ",\"digest_known_count\":")
                Base::rh_push_decimal_i64(out, r.digest_known_count)
                Base::rh_push_text(out, "}")
                i <- i + 1
            ReleaseFeedReport::rh_rel_sort_times(stable_times)
            latest_stable_age: mutable i64 = -1
            if stable_times.count > 0:
                latest_stable_age <- (first_seen - stable_times[stable_times.count - 1]) / 86400
            interrelease_median: mutable i64 = -1
            interrelease_variance: mutable i64 = -1
            if stable_times.count > 1:
                gaps: mutable darray[i64] = []
                while i < stable_times.count |i: i64 = 1, stable_times, gaps|:
                    gaps.push((stable_times[i] - stable_times[i - 1]) / 86400)
                    i <- i + 1
                ReleaseFeedReport::rh_rel_sort_times(gaps)
                middle: i64 = gaps.count / 2
                interrelease_median <- gaps[middle.usize()]
                interrelease_median <- (gaps[(middle - 1).usize()] + gaps[middle.usize()]) / 2 if gaps.count % 2 == 0
                mean_gap_sum: i64 =
                    while i < gaps.count |mean_gap_sum: i64 = 0, i: i64 = 0, gaps| -> mean_gap_sum:
                        mean_gap_sum <- mean_gap_sum + gaps[i.usize()]
                        i <- i + 1
                mean_gap: mutable i64 = mean_gap_sum / gaps.count.i64()
                variance_sum: i64 =
                    while i < gaps.count |variance_sum: i64 = 0, i: i64 = 0, gaps, mean_gap| -> variance_sum:
                        delta: i64 = gaps[i.usize()] - mean_gap
                        variance_sum <- variance_sum + delta * delta
                        i <- i + 1
                interrelease_variance <- variance_sum / gaps.count.i64()
            metric_totals: RhReleaseMetricTotals = RhReleaseMetricTotals{
                release_count: releases.count.i64(),
                rejected_count: rej,
                asset_count: asset_total,
                digest_known_count: digest_total,
                published_count: published_total,
                stable_count: stable_total,
                prerelease_count: prerelease_total,
                withdrawn_count: withdrawn_total,
                supported_line_count: supported_line_total,
                support_end_known: support_end_known,
                support_end_latest: support_end_latest,
                release_notes_known: release_notes_known,
                release_notes_present: release_notes_present,
                target_change_known: target_change_known,
                target_change_count: target_change_total,
                source_mapping_known: source_mapping_known,
                source_mapped_count: source_mapped_total,
                latest_stable_age_days: latest_stable_age,
                interrelease_median_days: interrelease_median,
                interrelease_variance: interrelease_variance
            }
            Base::rh_push_text(out, "],\"rejected\":")
            Base::rh_push_decimal_i64(out, rej)
            Base::rh_push_text(out, ",\"source\":{\"history_supported\":")
            if ReleaseFeed::rh_release_feed_history_supported() == 1:
                Base::rh_push_text(out, "true")
            else:
                Base::rh_push_text(out, "false")
            Base::rh_push_text(out, ",\"identity_supported\":")
            if ReleaseFeed::rh_release_feed_identity_supported() == 1:
                Base::rh_push_text(out, "true")
            else:
                Base::rh_push_text(out, "false")
            Base::rh_push_text(out, "},\"metrics\":")
            return -1 if not ReleaseFeedReport::rh_rfr_emit_metrics(out, metric_totals)
            Base::rh_push_text(out, ",\"note\":\"release-only source: a tag is a label, not a release event; published time is valid time and first-seen is known time (both retained); missing published time and missing release classification stay unknown; stable/prerelease counts include only explicit boolean classification; freshness uses first_seen as the explicit report cutoff; no history or author identity is derived\"}")
            0
