# rh_pilot_review.elisa — bounded pilot and operations review record (RP-08).
#
# This records observed review inputs and outage/cost evidence. It does not
# manufacture an independent audit, release approval, or user-research result.

include "./rh_base.elisa"
include "./rh_json.elisa"

module PilotReview:
    private:
        const RH_PILOT_INVALID: i64 = -1
        const RH_PILOT_ABSENT: i64 = -2

        def rh_pilot_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_obj_get(nodes, texts, obj, key)

        def rh_pilot_eq(texts: darray[u8]&, s: i64, e: i64, literal: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, literal)

        def rh_pilot_span(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            valid: bool = |s_out, e_out|
                idx: i64 = PilotReview::rh_pilot_get(nodes, texts, obj, key)
                Json::rh_json_str_span(nodes, idx, s_out, e_out) and e_out[0] > s_out[0]
            valid

        def rh_pilot_bool(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            result: i64 =
                idx: i64 = PilotReview::rh_pilot_get(nodes, texts, obj, key)
                if idx < 0 or nodes[idx.usize()].kind != Json::RH_JSON_BOOL:
                    RH_PILOT_INVALID
                else:
                    1 if Json::rh_json_is_true(nodes, raw, idx) else 0
            result

        def rh_pilot_obj(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            idx: i64 = PilotReview::rh_pilot_get(nodes, texts, obj, key)
            return -1 if idx < 0 or nodes[idx.usize()].kind != Json::RH_JSON_OBJ
            idx

        def rh_pilot_emit_span(out: mutable darray[u8]&, texts: darray[u8]&, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
            out.push(34)
            Base::rh_json_escape(out, texts, s.usize(), e.usize())
            out.push(34)

        def rh_pilot_nonnegative(value: i64, ok: i64) -> bool:
            ok != 0 and value >= 0

        def rh_pilot_optional_nonnegative(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            result: i64 =
                idx: i64 = PilotReview::rh_pilot_get(nodes, texts, obj, key)
                if idx < 0 or nodes[idx.usize()].kind == Json::RH_JSON_NULL:
                    RH_PILOT_ABSENT
                else:
                    ok: mutable i64 = 0
                    value: i64 = Json::rh_json_int(nodes, raw, idx, &ok)
                    if not PilotReview::rh_pilot_nonnegative(value, ok):
                        RH_PILOT_INVALID
                    else:
                        value
            result

    public:
        def rh_pilot_review_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_valid: bool =
                schema_s: mutable i64 = -1
                schema_e: mutable i64 = -1
                PilotReview::rh_pilot_span(nodes, texts, root, "schema", &schema_s, &schema_e) and PilotReview::rh_pilot_eq(texts, schema_s, schema_e, "rh-pilot-review-input/1")
            return -1 if not schema_valid
            review_s: mutable i64 = -1
            review_e: mutable i64 = -1
            reviewer_s: mutable i64 = -1
            reviewer_e: mutable i64 = -1
            scope_s: mutable i64 = -1
            scope_e: mutable i64 = -1
            return -1 if not PilotReview::rh_pilot_span(nodes, texts, root, "review_id", &review_s, &review_e) or not PilotReview::rh_pilot_span(nodes, texts, root, "reviewer", &reviewer_s, &reviewer_e) or not PilotReview::rh_pilot_span(nodes, texts, root, "scope", &scope_s, &scope_e)
            reviewed_at: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, root, "reviewed_at")
            return -1 if reviewed_at < 0

            mapping: i64 = PilotReview::rh_pilot_obj(nodes, texts, root, "mapping_review")
            corrections: i64 = PilotReview::rh_pilot_obj(nodes, texts, root, "corrections")
            usefulness: i64 = PilotReview::rh_pilot_obj(nodes, texts, root, "decision_usefulness")
            outage: i64 = PilotReview::rh_pilot_obj(nodes, texts, root, "provider_outage")
            costs: i64 = PilotReview::rh_pilot_obj(nodes, texts, root, "costs")
            return -1 if mapping < 0 or corrections < 0 or usefulness < 0 or outage < 0 or costs < 0

            mapping_sampled: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, mapping, "sampled")
            mapping_accepted: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, mapping, "accepted")
            mapping_open: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, mapping, "needs_review")
            return -1 if mapping_sampled < 0 or mapping_accepted < 0 or mapping_open < 0
            return -1 if mapping_accepted > mapping_sampled
            return -1 if mapping_open > mapping_sampled - mapping_accepted

            corrections_requested: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, corrections, "requested")
            corrections_resolved: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, corrections, "resolved")
            median_turnaround: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, corrections, "median_turnaround_seconds")
            return -1 if corrections_requested < 0 or corrections_resolved < 0 or median_turnaround < 0 or corrections_resolved > corrections_requested
            maintainer_effort: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, corrections, "maintainer_effort_seconds")
            return -1 if maintainer_effort == RH_PILOT_INVALID

            understood: i64 = PilotReview::rh_pilot_bool(nodes, raw, texts, usefulness, "understood")
            false_positive: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, usefulness, "false_positive_count")
            false_negative: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, usefulness, "false_negative_count")
            return -1 if understood == RH_PILOT_INVALID or false_positive < 0 or false_negative < 0
            reviewed_findings: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, usefulness, "reviewed_findings")
            changed_decisions: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, usefulness, "decision_changed_count")
            correct_findings: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, usefulness, "correct_findings_count")
            actionable_findings: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, usefulness, "actionable_findings_count")
            resolved_unknowns: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, usefulness, "unknowns_resolved_by_evidence_count")
            return -1 if reviewed_findings == RH_PILOT_INVALID or changed_decisions == RH_PILOT_INVALID or correct_findings == RH_PILOT_INVALID or actionable_findings == RH_PILOT_INVALID or resolved_unknowns == RH_PILOT_INVALID
            detail_valid: bool =
                detail_fields_present: i64 = (1 if reviewed_findings != RH_PILOT_ABSENT else 0) + (1 if changed_decisions != RH_PILOT_ABSENT else 0) + (1 if correct_findings != RH_PILOT_ABSENT else 0) + (1 if actionable_findings != RH_PILOT_ABSENT else 0) + (1 if resolved_unknowns != RH_PILOT_ABSENT else 0)
                detail_fields_present == 0 or (detail_fields_present == 5 and changed_decisions <= reviewed_findings and correct_findings <= reviewed_findings and actionable_findings <= reviewed_findings and resolved_unknowns <= reviewed_findings and false_positive <= reviewed_findings and false_negative <= reviewed_findings and false_positive <= reviewed_findings - false_negative)
            return -1 if not detail_valid

            outage_cap_s: mutable i64 = -1
            outage_cap_e: mutable i64 = -1
            outage_status_s: mutable i64 = -1
            outage_status_e: mutable i64 = -1
            return -1 if not PilotReview::rh_pilot_span(nodes, texts, outage, "capability", &outage_cap_s, &outage_cap_e) or not PilotReview::rh_pilot_span(nodes, texts, outage, "status", &outage_status_s, &outage_status_e)
            other_capabilities_usable: i64 = PilotReview::rh_pilot_bool(nodes, raw, texts, outage, "other_capabilities_usable")
            return -1 if other_capabilities_usable == RH_PILOT_INVALID or not PilotReview::rh_pilot_eq(texts, outage_status_s, outage_status_e, "stale_unknown") and not PilotReview::rh_pilot_eq(texts, outage_status_s, outage_status_e, "recovered") and not PilotReview::rh_pilot_eq(texts, outage_status_s, outage_status_e, "unsupported")

            cost_events: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, costs, "events")
            cost_bytes: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, costs, "bytes")
            elapsed_ms: i64 = PilotReview::rh_pilot_optional_nonnegative(nodes, raw, texts, costs, "elapsed_ms")
            return -1 if cost_events < 0 or cost_bytes < 0 or elapsed_ms < 0

            Base::rh_push_text(out, "{\"schema\":\"rh-pilot-review-result/1\",\"review\":{\"id\":")
            PilotReview::rh_pilot_emit_span(out, texts, review_s, review_e)
            Base::rh_push_text(out, ",\"reviewer\":")
            PilotReview::rh_pilot_emit_span(out, texts, reviewer_s, reviewer_e)
            Base::rh_push_text(out, ",\"reviewed_at\":")
            Base::rh_push_decimal_i64(out, reviewed_at)
            Base::rh_push_text(out, ",\"scope\":")
            PilotReview::rh_pilot_emit_span(out, texts, scope_s, scope_e)
            Base::rh_push_text(out, "},\"mapping_review\":{\"sampled\":")
            Base::rh_push_decimal_i64(out, mapping_sampled)
            Base::rh_push_text(out, ",\"accepted\":")
            Base::rh_push_decimal_i64(out, mapping_accepted)
            Base::rh_push_text(out, ",\"needs_review\":")
            Base::rh_push_decimal_i64(out, mapping_open)
            Base::rh_push_text(out, "},\"corrections\":{\"requested\":")
            Base::rh_push_decimal_i64(out, corrections_requested)
            Base::rh_push_text(out, ",\"resolved\":")
            Base::rh_push_decimal_i64(out, corrections_resolved)
            Base::rh_push_text(out, ",\"median_turnaround_seconds\":")
            Base::rh_push_decimal_i64(out, median_turnaround)
            Base::rh_push_text(out, ",\"maintainer_effort_seconds\":")
            Base::rh_push_decimal_i64(out, maintainer_effort) if maintainer_effort >= 0
            Base::rh_push_text(out, "null") if maintainer_effort == RH_PILOT_ABSENT
            Base::rh_push_text(out, "},\"decision_usefulness\":{\"understood\":")
            Base::rh_push_text(out, "true" if understood == 1 else "false")
            Base::rh_push_text(out, ",\"false_positive_count\":")
            Base::rh_push_decimal_i64(out, false_positive)
            Base::rh_push_text(out, ",\"false_negative_count\":")
            Base::rh_push_decimal_i64(out, false_negative)
            Base::rh_push_text(out, ",\"reviewed_findings\":")
            Base::rh_push_decimal_i64(out, reviewed_findings) if reviewed_findings >= 0
            Base::rh_push_text(out, "null") if reviewed_findings == RH_PILOT_ABSENT
            Base::rh_push_text(out, ",\"decision_changed_count\":")
            Base::rh_push_decimal_i64(out, changed_decisions) if changed_decisions >= 0
            Base::rh_push_text(out, "null") if changed_decisions == RH_PILOT_ABSENT
            Base::rh_push_text(out, ",\"correct_findings_count\":")
            Base::rh_push_decimal_i64(out, correct_findings) if correct_findings >= 0
            Base::rh_push_text(out, "null") if correct_findings == RH_PILOT_ABSENT
            Base::rh_push_text(out, ",\"actionable_findings_count\":")
            Base::rh_push_decimal_i64(out, actionable_findings) if actionable_findings >= 0
            Base::rh_push_text(out, "null") if actionable_findings == RH_PILOT_ABSENT
            Base::rh_push_text(out, ",\"unknowns_resolved_by_evidence_count\":")
            Base::rh_push_decimal_i64(out, resolved_unknowns) if resolved_unknowns >= 0
            Base::rh_push_text(out, "null") if resolved_unknowns == RH_PILOT_ABSENT
            Base::rh_push_text(out, "},\"provider_outage\":{\"capability\":")
            PilotReview::rh_pilot_emit_span(out, texts, outage_cap_s, outage_cap_e)
            Base::rh_push_text(out, ",\"status\":")
            PilotReview::rh_pilot_emit_span(out, texts, outage_status_s, outage_status_e)
            Base::rh_push_text(out, ",\"other_capabilities_usable\":")
            Base::rh_push_text(out, "true" if other_capabilities_usable == 1 else "false")
            Base::rh_push_text(out, "},\"costs\":{\"events\":")
            Base::rh_push_decimal_i64(out, cost_events)
            Base::rh_push_text(out, ",\"bytes\":")
            Base::rh_push_decimal_i64(out, cost_bytes)
            Base::rh_push_text(out, ",\"elapsed_ms\":")
            Base::rh_push_decimal_i64(out, elapsed_ms)
            Base::rh_push_text(out, "},\"state\":\"recorded\",\"note\":\"pilot observations are recorded for review; this contract is not an independent audit, release approval, or claim of decision usefulness beyond the supplied counts\"}")
            0
