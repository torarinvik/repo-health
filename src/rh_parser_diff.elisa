# rh_parser_diff.elisa — retained parser-adoption differential report
# (M03-10). This compares two already-captured graph documents; it never
# executes a package manager or treats a provider response as canonical.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_store.elisa"

const RH_DIFF_MAX_NODES: i64 = 10000
const RH_DIFF_MAX_MISMATCHES: i64 = 10000

module ParserDiff:
    private:
        def rh_diff_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if obj < 0 or nodes[obj.usize()].kind != Json::RH_JSON_OBJ
            want: usize = strlen(key)
            child: mutable i64 = nodes[obj.usize()].first_child
            while child >= 0:
                kn: Json::RhJsonNode = nodes[child.usize()]
                value: i64 = kn.next_sibling
                if kn.kind == Json::RH_JSON_STR and value >= 0 and kn.text_end - kn.text_start == want.i64():
                    same: mutable bool = true
                    k: mutable usize = 0
                    while k < want:
                        if texts[(kn.text_start + k.i64()).usize()] != key[k]:
                            same <- false
                        k <- k + 1
                    return value if same
                child <- nodes[value.usize()].next_sibling if value >= 0 else -1
            -1

        def rh_diff_span(nodes: darray[Json::RhJsonNode]&, idx: i64, s_out: mutable i64&, e_out: mutable i64&) -> bool:
            return false if idx < 0
            n: Json::RhJsonNode = nodes[idx.usize()]
            return false if n.kind != Json::RH_JSON_STR or n.text_end < n.text_start
            s_out[0] <- n.text_start
            e_out[0] <- n.text_end
            true

        def rh_diff_span_equal(a: darray[u8]&, as_: i64, ae: i64, b: darray[u8]&, bs: i64, be: i64) -> bool:
            return false if as_ < 0 or ae < as_ or bs < 0 or be < bs or ae - as_ != be - bs
            while i < ae - as_ |i: i64 = 0, a, b, as_, bs|:
                return false if a[(as_ + i).usize()] != b[(bs + i).usize()]
                i <- i + 1
            true

        def rh_diff_identity_equal(na: darray[Json::RhJsonNode]&, ta: darray[u8]&, a: i64, nb: darray[Json::RhJsonNode]&, tb: darray[u8]&, b: i64) -> bool:
            ans: mutable i64 = -1
            ane: mutable i64 = -1
            bns: mutable i64 = -1
            bne: mutable i64 = -1
            ass: mutable i64 = -1
            ase: mutable i64 = -1
            bss: mutable i64 = -1
            bse: mutable i64 = -1
            return false if not ParserDiff::rh_diff_span(na, ParserDiff::rh_diff_get(na, ta, a, "name"), &ans, &ane)
            return false if not ParserDiff::rh_diff_span(nb, ParserDiff::rh_diff_get(nb, tb, b, "name"), &bns, &bne)
            return false if not ParserDiff::rh_diff_span(na, ParserDiff::rh_diff_get(na, ta, a, "source"), &ass, &ase)
            return false if not ParserDiff::rh_diff_span(nb, ParserDiff::rh_diff_get(nb, tb, b, "source"), &bss, &bse)
            return false if not ParserDiff::rh_diff_span_equal(ta, ans, ane, tb, bns, bne) or not ParserDiff::rh_diff_span_equal(ta, ass, ase, tb, bss, bse)
            av: i64 = ParserDiff::rh_diff_get(na, ta, a, "version")
            bv: i64 = ParserDiff::rh_diff_get(nb, tb, b, "version")
            if av < 0 or bv < 0:
                return av < 0 and bv < 0
            if na[av.usize()].kind == Json::RH_JSON_NULL or nb[bv.usize()].kind == Json::RH_JSON_NULL:
                return na[av.usize()].kind == Json::RH_JSON_NULL and nb[bv.usize()].kind == Json::RH_JSON_NULL
            avs: mutable i64 = -1
            ave: mutable i64 = -1
            bvs: mutable i64 = -1
            bve: mutable i64 = -1
            return false if not ParserDiff::rh_diff_span(na, av, &avs, &ave) or not ParserDiff::rh_diff_span(nb, bv, &bvs, &bve)
            ParserDiff::rh_diff_span_equal(ta, avs, ave, tb, bvs, bve)

        def rh_diff_bool_equal(na: darray[Json::RhJsonNode]&, ra: darray[u8]&, a: i64, ta: darray[u8]&, nb: darray[Json::RhJsonNode]&, rb: darray[u8]&, b: i64, tb: darray[u8]&, key: u8&) -> bool:
            ai: i64 = ParserDiff::rh_diff_get(na, ta, a, key)
            bi: i64 = ParserDiff::rh_diff_get(nb, tb, b, key)
            return false if ai < 0 or bi < 0 or na[ai.usize()].kind != Json::RH_JSON_BOOL or nb[bi.usize()].kind != Json::RH_JSON_BOOL
            Json::rh_json_is_true(na, ra, ai) == Json::rh_json_is_true(nb, rb, bi)

        def rh_diff_int_equal(na: darray[Json::RhJsonNode]&, ra: darray[u8]&, a: i64, ta: darray[u8]&, nb: darray[Json::RhJsonNode]&, rb: darray[u8]&, b: i64, tb: darray[u8]&, key: u8&) -> bool:
            ai: i64 = ParserDiff::rh_diff_get(na, ta, a, key)
            bi: i64 = ParserDiff::rh_diff_get(nb, tb, b, key)
            return false if ai < 0 or bi < 0
            aok: mutable i64 = 0
            bok: mutable i64 = 0
            av: i64 = Json::rh_json_int(na, ra, ai, &aok)
            bv: i64 = Json::rh_json_int(nb, rb, bi, &bok)
            aok == 1 and bok == 1 and av == bv

        def rh_diff_optional_span_equal(na: darray[Json::RhJsonNode]&, ta: darray[u8]&, a: i64, nb: darray[Json::RhJsonNode]&, tb: darray[u8]&, b: i64, key: u8&) -> bool:
            ai: i64 = ParserDiff::rh_diff_get(na, ta, a, key)
            bi: i64 = ParserDiff::rh_diff_get(nb, tb, b, key)
            return true if ai < 0 and bi < 0
            return false if ai < 0 or bi < 0
            return true if na[ai.usize()].kind == Json::RH_JSON_NULL and nb[bi.usize()].kind == Json::RH_JSON_NULL
            return false if na[ai.usize()].kind == Json::RH_JSON_NULL or nb[bi.usize()].kind == Json::RH_JSON_NULL
            as_: mutable i64 = -1
            ae: mutable i64 = -1
            bs_: mutable i64 = -1
            be: mutable i64 = -1
            return false if not ParserDiff::rh_diff_span(na, ai, &as_, &ae) or not ParserDiff::rh_diff_span(nb, bi, &bs_, &be)
            ParserDiff::rh_diff_span_equal(ta, as_, ae, tb, bs_, be)

        def rh_diff_edge_key_equal(na: darray[Json::RhJsonNode]&, ra: darray[u8]&, a: i64, ta: darray[u8]&, nb: darray[Json::RhJsonNode]&, rb: darray[u8]&, b: i64, tb: darray[u8]&) -> bool:
            ParserDiff::rh_diff_int_equal(na, ra, a, ta, nb, rb, b, tb, "from") and ParserDiff::rh_diff_int_equal(na, ra, a, ta, nb, rb, b, tb, "to")

        def rh_diff_unresolved_key_equal(na: darray[Json::RhJsonNode]&, ra: darray[u8]&, a: i64, ta: darray[u8]&, nb: darray[Json::RhJsonNode]&, rb: darray[u8]&, b: i64, tb: darray[u8]&) -> bool:
            return false if not ParserDiff::rh_diff_int_equal(na, ra, a, ta, nb, rb, b, tb, "from")
            ParserDiff::rh_diff_optional_span_equal(na, ta, a, nb, tb, b, "name") and ParserDiff::rh_diff_optional_span_equal(na, ta, a, nb, tb, b, "requirement")

        def rh_diff_emit_mismatch(out: mutable darray[u8]&, kind: u8&, detail: u8&, count: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            return if count >= RH_DIFF_MAX_MISMATCHES
            if count > 0:
                out.push(44)
            rh_push_text(out, "{\"class\":\"")
            rh_push_text(out, kind)
            rh_push_text(out, "\",\"detail\":\"")
            rh_push_text(out, detail)
            rh_push_text(out, "\"}")
            count <- count + 1

        def rh_diff_parser_meta(out: mutable darray[u8]&, native_parser: cstr, candidate_parser: cstr, configuration: cstr, visibility: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            rh_push_text(out, "\"parsers\":{\"native\":\"")
            rh_push_cstr(out, native_parser)
            rh_push_text(out, "\",\"candidate\":\"")
            rh_push_cstr(out, candidate_parser)
            rh_push_text(out, "\",\"configuration\":\"")
            rh_push_cstr(out, configuration)
            rh_push_text(out, "\",\"visibility\":\"")
            rh_push_cstr(out, visibility)
            rh_push_text(out, "\"}")

    public:
        # Compare two retained graph documents. Returns 0 for a report, -1
        # when the native input is malformed, and -2 when the candidate is an
        # unsupported parser result (the output still records that state).
        def rh_parser_diff_report(native_raw: darray[u8]&, candidate_raw: darray[u8]&, out: mutable darray[u8]&, native_parser: cstr, candidate_parser: cstr, configuration: cstr, visibility: cstr) -> i64 can[Memory.Allocate, Abort.Panic]:
            nn: mutable darray[Json::RhJsonNode] = []
            nt: mutable darray[u8] = []
            cn: mutable darray[Json::RhJsonNode] = []
            ct: mutable darray[u8] = []
            nr: i64 = Json::rh_json_parse(native_raw, nn, nt)
            cr: i64 = Json::rh_json_parse(candidate_raw, cn, ct)
            return -1 if nr < 0 or nn[nr.usize()].kind != Json::RH_JSON_OBJ
            nd_schema: i64 = ParserDiff::rh_diff_get(nn, nt, nr, "schema")
            ns: mutable i64 = -1
            ne: mutable i64 = -1
            return -1 if not ParserDiff::rh_diff_span(nn, nd_schema, &ns, &ne) or not rh_bytes_equal_literal(nt, ns, ne, "rh-dep-graph/1")
            ndigest: mutable darray[u8] = []
            cdigest: mutable darray[u8] = []
            Store::rh_digest_hex(native_raw, ndigest)
            Store::rh_digest_hex(candidate_raw, cdigest)
            cache_input: mutable darray[u8] = []
            cache_input.extend(bytes_view(native_raw))
            cache_input.extend(bytes_view(candidate_raw))
            rh_push_cstr(cache_input, native_parser)
            rh_push_cstr(cache_input, candidate_parser)
            rh_push_cstr(cache_input, configuration)
            rh_push_cstr(cache_input, visibility)
            cache_key: mutable darray[u8] = []
            Store::rh_digest_hex(cache_input, cache_key)
            rh_push_text(out, "{\"schema\":\"rh-parser-diff/1\",\"status\":\"")
            if cr < 0 or cn[cr.usize()].kind != Json::RH_JSON_OBJ:
                rh_push_text(out, "unsupported\",\"reason\":\"candidate parser did not produce a valid JSON object\",")
                rh_diff_parser_meta(out, native_parser, candidate_parser, configuration, visibility)
                rh_push_text(out, ",\"inputs\":{\"native_digest\":\"")
                out.extend(bytes_view(ndigest))
                rh_push_text(out, "\",\"candidate_digest\":\"")
                out.extend(bytes_view(cdigest))
                rh_push_text(out, "\",\"output_schema\":\"rh-dep-graph/1\"},\"cache_key\":\"")
                out.extend(bytes_view(cache_key))
                rh_push_text(out, "\",\"summary\":{\"mismatches\":0},\"mismatches\":[],\"note\":\"unsupported candidate input is distinct from a successful empty graph\"}")
                return -2
            cd_schema: i64 = ParserDiff::rh_diff_get(cn, ct, cr, "schema")
            cs: mutable i64 = -1
            ce: mutable i64 = -1
            if not ParserDiff::rh_diff_span(cn, cd_schema, &cs, &ce) or not rh_bytes_equal_literal(ct, cs, ce, "rh-dep-graph/1"):
                rh_push_text(out, "unsupported\",\"reason\":\"candidate parser emitted an unsupported schema\",")
                rh_diff_parser_meta(out, native_parser, candidate_parser, configuration, visibility)
                rh_push_text(out, ",\"inputs\":{\"native_digest\":\"")
                out.extend(bytes_view(ndigest))
                rh_push_text(out, "\",\"candidate_digest\":\"")
                out.extend(bytes_view(cdigest))
                rh_push_text(out, "\",\"output_schema\":\"rh-dep-graph/1\"},\"cache_key\":\"")
                out.extend(bytes_view(cache_key))
                rh_push_text(out, "\",\"summary\":{\"mismatches\":0},\"mismatches\":[],\"note\":\"unsupported candidate schema is distinct from a successful empty graph\"}")
                return -2
            nn_idx: i64 = ParserDiff::rh_diff_get(nn, nt, nr, "nodes")
            cn_idx: i64 = ParserDiff::rh_diff_get(cn, ct, cr, "nodes")
            return -1 if nn_idx < 0 or cn_idx < 0 or nn[nn_idx.usize()].kind != Json::RH_JSON_ARR or cn[cn_idx.usize()].kind != Json::RH_JSON_ARR
            return -1 if nn[nn_idx.usize()].child_count > RH_DIFF_MAX_NODES or cn[cn_idx.usize()].child_count > RH_DIFF_MAX_NODES
            native_nodes: mutable darray[i64] = []
            candidate_nodes: mutable darray[i64] = []
            while ni >= 0 |ni: i64 = nn[nn_idx.usize()].first_child, nn, native_nodes|:
                native_nodes.push(ni)
                ni <- nn[ni.usize()].next_sibling
            while ci >= 0 |ci: i64 = cn[cn_idx.usize()].first_child, cn, candidate_nodes|:
                candidate_nodes.push(ci)
                ci <- cn[ci.usize()].next_sibling
            used: mutable darray[i64] = []
            while ui < candidate_nodes.count.i64() |ui: i64 = 0, candidate_nodes, used|:
                used.push(0)
                ui <- ui + 1
            mismatches: mutable darray[u8] = []
            mismatch_count: mutable i64 = 0
            mapping_count: mutable i64 = 0
            context_count: mutable i64 = 0
            parser_count: mutable i64 = 0
            normalization_count: mutable i64 = 0
            i: mutable i64 = 0
            while i < native_nodes.count.i64():
                ni_obj: i64 = native_nodes[i.usize()]
                found: mutable i64 = -1
                j: mutable i64 = 0
                while j < candidate_nodes.count.i64():
                    if used[j.usize()] == 0 and ParserDiff::rh_diff_identity_equal(nn, nt, ni_obj, cn, ct, candidate_nodes[j.usize()]):
                        found <- j
                        break
                    j <- j + 1
                if found < 0:
                    ParserDiff::rh_diff_emit_mismatch(mismatches, "mapping", "native package identity has no candidate match", &mismatch_count)
                    mapping_count <- mapping_count + 1
                else:
                    used[found.usize()] <- 1
                    ci_obj: i64 = candidate_nodes[found.usize()]
                    if not ParserDiff::rh_diff_bool_equal(nn, native_raw, ni_obj, nt, cn, candidate_raw, ci_obj, ct, "dev") or not ParserDiff::rh_diff_bool_equal(nn, native_raw, ni_obj, nt, cn, candidate_raw, ci_obj, ct, "optional"):
                        ParserDiff::rh_diff_emit_mismatch(mismatches, "context", "scope or optionality differs for a matched package", &mismatch_count)
                        context_count <- context_count + 1
                    if not ParserDiff::rh_diff_bool_equal(nn, native_raw, ni_obj, nt, cn, candidate_raw, ci_obj, ct, "digest"):
                        ParserDiff::rh_diff_emit_mismatch(mismatches, "normalization", "artifact digest evidence differs for a matched package", &mismatch_count)
                        normalization_count <- normalization_count + 1
                i <- i + 1
            j2: mutable i64 = 0
            while j2 < candidate_nodes.count.i64():
                if used[j2.usize()] == 0:
                    ParserDiff::rh_diff_emit_mismatch(mismatches, "parser_support", "candidate package has no native identity match", &mismatch_count)
                    parser_count <- parser_count + 1
                j2 <- j2 + 1
            edges_a: i64 = ParserDiff::rh_diff_get(nn, nt, nr, "edges")
            edges_b: i64 = ParserDiff::rh_diff_get(cn, ct, cr, "edges")
            if edges_a < 0 or edges_b < 0 or nn[edges_a.usize()].kind != Json::RH_JSON_ARR or cn[edges_b.usize()].kind != Json::RH_JSON_ARR:
                ParserDiff::rh_diff_emit_mismatch(mismatches, "parser_support", "one parser omitted the edge array", &mismatch_count)
                parser_count <- parser_count + 1
            else:
                return -1 if nn[edges_a.usize()].child_count > RH_DIFF_MAX_NODES or cn[edges_b.usize()].child_count > RH_DIFF_MAX_NODES
                native_edges: mutable darray[i64] = []
                candidate_edges: mutable darray[i64] = []
                while ei >= 0 |ei: i64 = nn[edges_a.usize()].first_child, nn, native_edges|:
                    native_edges.push(ei)
                    ei <- nn[ei.usize()].next_sibling
                while ei >= 0 |ei: i64 = cn[edges_b.usize()].first_child, cn, candidate_edges|:
                    candidate_edges.push(ei)
                    ei <- cn[ei.usize()].next_sibling
                edge_used: mutable darray[i64] = []
                while ei < candidate_edges.count.i64() |ei: i64 = 0, candidate_edges, edge_used|:
                    edge_used.push(0)
                    ei <- ei + 1
                ei: mutable i64 = 0
                while ei < native_edges.count.i64():
                    native_edge: i64 = native_edges[ei.usize()]
                    edge_match: mutable i64 = -1
                    ej: mutable i64 = 0
                    while ej < candidate_edges.count.i64():
                        if edge_used[ej.usize()] == 0 and ParserDiff::rh_diff_edge_key_equal(nn, native_raw, native_edge, nt, cn, candidate_raw, candidate_edges[ej.usize()], ct):
                            edge_match <- ej
                            break
                        ej <- ej + 1
                    if edge_match < 0:
                        ParserDiff::rh_diff_emit_mismatch(mismatches, "mapping", "resolved edge has no candidate endpoint pair", &mismatch_count)
                        mapping_count <- mapping_count + 1
                    else:
                        edge_used[edge_match.usize()] <- 1
                        candidate_edge: i64 = candidate_edges[edge_match.usize()]
                        if not ParserDiff::rh_diff_optional_span_equal(nn, nt, native_edge, cn, ct, candidate_edge, "scope"):
                            ParserDiff::rh_diff_emit_mismatch(mismatches, "context", "resolved edge scope differs", &mismatch_count)
                            context_count <- context_count + 1
                    ei <- ei + 1
                ei <- 0
                while ei < candidate_edges.count.i64():
                    if edge_used[ei.usize()] == 0:
                        ParserDiff::rh_diff_emit_mismatch(mismatches, "mapping", "candidate edge has no native endpoint pair", &mismatch_count)
                        mapping_count <- mapping_count + 1
                    ei <- ei + 1
            unresolved_a: i64 = ParserDiff::rh_diff_get(nn, nt, nr, "unresolved")
            unresolved_b: i64 = ParserDiff::rh_diff_get(cn, ct, cr, "unresolved")
            if unresolved_a < 0 or unresolved_b < 0 or nn[unresolved_a.usize()].kind != Json::RH_JSON_ARR or cn[unresolved_b.usize()].kind != Json::RH_JSON_ARR:
                ParserDiff::rh_diff_emit_mismatch(mismatches, "parser_support", "unresolved requirement evidence is missing", &mismatch_count)
                parser_count <- parser_count + 1
            else:
                return -1 if nn[unresolved_a.usize()].child_count > RH_DIFF_MAX_NODES or cn[unresolved_b.usize()].child_count > RH_DIFF_MAX_NODES
                native_unresolved: mutable darray[i64] = []
                candidate_unresolved: mutable darray[i64] = []
                while ui >= 0 |ui: i64 = nn[unresolved_a.usize()].first_child, nn, native_unresolved|:
                    native_unresolved.push(ui)
                    ui <- nn[ui.usize()].next_sibling
                while ui >= 0 |ui: i64 = cn[unresolved_b.usize()].first_child, cn, candidate_unresolved|:
                    candidate_unresolved.push(ui)
                    ui <- cn[ui.usize()].next_sibling
                unresolved_used: mutable darray[i64] = []
                while ui < candidate_unresolved.count.i64() |ui: i64 = 0, candidate_unresolved, unresolved_used|:
                    unresolved_used.push(0)
                    ui <- ui + 1
                ui: mutable i64 = 0
                while ui < native_unresolved.count.i64():
                    native_item: i64 = native_unresolved[ui.usize()]
                    unresolved_match: mutable i64 = -1
                    uj: mutable i64 = 0
                    while uj < candidate_unresolved.count.i64():
                        if unresolved_used[uj.usize()] == 0 and ParserDiff::rh_diff_unresolved_key_equal(nn, native_raw, native_item, nt, cn, candidate_raw, candidate_unresolved[uj.usize()], ct):
                            unresolved_match <- uj
                            break
                        uj <- uj + 1
                    if unresolved_match < 0:
                        ParserDiff::rh_diff_emit_mismatch(mismatches, "parser_support", "unresolved requirement identity differs", &mismatch_count)
                        parser_count <- parser_count + 1
                    else:
                        unresolved_used[unresolved_match.usize()] <- 1
                        candidate_item: i64 = candidate_unresolved[unresolved_match.usize()]
                        if not ParserDiff::rh_diff_optional_span_equal(nn, nt, native_item, cn, ct, candidate_item, "reason"):
                            ParserDiff::rh_diff_emit_mismatch(mismatches, "normalization", "unresolved requirement reason differs", &mismatch_count)
                            normalization_count <- normalization_count + 1
                    ui <- ui + 1
                ui <- 0
                while ui < candidate_unresolved.count.i64():
                    if unresolved_used[ui.usize()] == 0:
                        ParserDiff::rh_diff_emit_mismatch(mismatches, "parser_support", "candidate unresolved requirement has no native identity match", &mismatch_count)
                        parser_count <- parser_count + 1
                    ui <- ui + 1
            rh_push_text(out, "different\",") if mismatch_count > 0 else rh_push_text(out, "match\",")
            rh_diff_parser_meta(out, native_parser, candidate_parser, configuration, visibility)
            rh_push_text(out, ",\"inputs\":{\"native_digest\":\"")
            out.extend(bytes_view(ndigest))
            rh_push_text(out, "\",\"candidate_digest\":\"")
            out.extend(bytes_view(cdigest))
            rh_push_text(out, "\",\"output_schema\":\"rh-dep-graph/1\"},\"cache_key\":\"")
            out.extend(bytes_view(cache_key))
            rh_push_text(out, "\",\"summary\":{\"mismatches\":")
            rh_push_decimal_i64(out, mismatch_count)
            rh_push_text(out, ",\"mapping\":")
            rh_push_decimal_i64(out, mapping_count)
            rh_push_text(out, ",\"context\":")
            rh_push_decimal_i64(out, context_count)
            rh_push_text(out, ",\"parser_support\":")
            rh_push_decimal_i64(out, parser_count)
            rh_push_text(out, ",\"normalization\":")
            rh_push_decimal_i64(out, normalization_count)
            rh_push_text(out, "},\"mismatches\":[")
            out.extend(bytes_view(mismatches))
            rh_push_text(out, "],\"note\":\"differential comparison preserves parser/version/configuration identity; unsupported input is distinct from successful emptiness; visibility is part of the cache identity\"}")
            0
