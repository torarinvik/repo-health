# rh_query_report.elisa — query contract execution path (M06-01).
#
# Turns an `rh-query-input/1` request into `rh-query-result/1`: cursor
# pagination over an ascending id list, a per-capability scan-status
# breakdown (so one failed capability cannot read as a failed project), an
# optional bounded graph traversal, and an optional bounded-job lease sequence
# (claim/renew/finish/budget) with fencing tokens. Malformed requests fail
# closed.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_query.elisa"
include "./rh_graph.elisa"

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_qr_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    rh_bytes_equal_literal(texts, s, e, lit)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_qr_kind(texts: darray[u8]&, s: i64, e: i64) -> i64:
    return Query::RH_Q_IDENTITY if rh_qr_eq(texts, s, e, "identity")
    return Query::RH_Q_METRICS if rh_qr_eq(texts, s, e, "metrics")
    return Query::RH_Q_CONTINUITY if rh_qr_eq(texts, s, e, "continuity")
    return Query::RH_Q_UPSTREAM if rh_qr_eq(texts, s, e, "upstream")
    return Query::RH_Q_DOWNSTREAM if rh_qr_eq(texts, s, e, "downstream")
    return Query::RH_Q_FINDINGS if rh_qr_eq(texts, s, e, "findings")
    return Query::RH_Q_EVIDENCE if rh_qr_eq(texts, s, e, "evidence")
    return Query::RH_Q_SCAN_STATUS if rh_qr_eq(texts, s, e, "scan_status")
    -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_qr_state(texts: darray[u8]&, s: i64, e: i64) -> i64:
    return 0 if rh_qr_eq(texts, s, e, "observed")
    return 1 if rh_qr_eq(texts, s, e, "not_observed")
    return 2 if rh_qr_eq(texts, s, e, "unavailable")
    return 3 if rh_qr_eq(texts, s, e, "unauthorized")
    return 4 if rh_qr_eq(texts, s, e, "partial")
    return 5 if rh_qr_eq(texts, s, e, "stale")
    return 6 if rh_qr_eq(texts, s, e, "not_applicable")
    return 7 if rh_qr_eq(texts, s, e, "error")
    return 8 if rh_qr_eq(texts, s, e, "conflicted")
    return 9 if rh_qr_eq(texts, s, e, "suppressed")
    return 10 if rh_qr_eq(texts, s, e, "unsupported")
    -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_qr_phase(texts: darray[u8]&, s: i64, e: i64) -> i64:
    return Query::RH_JOB_QUEUED if rh_qr_eq(texts, s, e, "queued")
    return Query::RH_JOB_LEASED if rh_qr_eq(texts, s, e, "leased")
    return Query::RH_JOB_RUNNING if rh_qr_eq(texts, s, e, "running")
    return Query::RH_JOB_SUCCEEDED if rh_qr_eq(texts, s, e, "succeeded")
    return Query::RH_JOB_FAILED_TERMINAL if rh_qr_eq(texts, s, e, "failed_terminal")
    return Query::RH_JOB_CANCELED if rh_qr_eq(texts, s, e, "canceled")
    -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_qr_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
    return false if idx < 0
    Json::rh_json_str_span(nodes, idx, s_out, e_out)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_qr_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    ok_out[0] <- 0
    idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
    return 0 if idx < 0
    Json::rh_json_int(nodes, raw, idx, ok_out)

def rh_qr_kind_label(k: i64) -> u8&:
    return "identity" if k == 0
    return "metrics" if k == 1
    return "continuity" if k == 2
    return "upstream" if k == 3
    return "downstream" if k == 4
    return "findings" if k == 5
    return "evidence" if k == 6
    "scan_status"

def rh_qr_graph_direction(texts: darray[u8]&, s: i64, e: i64) -> i64:
    return 0 if rh_qr_eq(texts, s, e, "downstream")
    return 1 if rh_qr_eq(texts, s, e, "upstream")
    -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_qr_emit_phase(out: mutable darray[u8]&, p: u8) -> void can[Memory.Allocate, Abort.Panic]:
    if p == Query::RH_JOB_QUEUED:
        rh_push_text(out, "queued")
    elif p == Query::RH_JOB_LEASED:
        rh_push_text(out, "leased")
    elif p == Query::RH_JOB_RUNNING:
        rh_push_text(out, "running")
    elif p == Query::RH_JOB_SUCCEEDED:
        rh_push_text(out, "succeeded")
    elif p == Query::RH_JOB_FAILED_TERMINAL:
        rh_push_text(out, "failed_terminal")
    else:
        rh_push_text(out, "canceled")

def rh_query_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
    kind: i64 = |nodes, texts|
        ss: mutable i64 = 0
        se: mutable i64 = 0
        return -1 if not rh_qr_str(nodes, texts, root, "schema", &ss, &se)
        return -1 if not rh_qr_eq(texts, ss, se, "rh-query-input/1")
        ks: mutable i64 = 0
        ke: mutable i64 = 0
        return -1 if not rh_qr_str(nodes, texts, root, "kind", &ks, &ke)
        block_result: i64 = rh_qr_kind(texts, ks, ke)
        block_result
    return -1 if kind < 0
    return -1 if not Query::rh_query_kind_valid(kind.u8())
    ids_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "ids")
    return -1 if ids_idx < 0 or nodes[ids_idx.usize()].kind != Json::RH_JSON_ARR
    ids: mutable darray[i64] = []
    iarr: Json::RhJsonNode = nodes[ids_idx.usize()]
    while child >= 0 |child: i64 = iarr.first_child, nodes, raw, texts, ids|:
        return -1 if nodes[child.usize()].kind != Json::RH_JSON_NUM
        okv: mutable i64 = 0
        v: i64 = Json::rh_json_int(nodes, raw, child, &okv)
        return -1 if okv == 0
        ids.push(v)
        child <- nodes[child.usize()].next_sibling
    okc: mutable i64 = 0
    cursor: mutable i64 = rh_qr_int(nodes, raw, texts, root, "cursor", &okc)
    if okc == 0:
        cursor <- -1
    okl: mutable i64 = 0
    limit: mutable i64 = rh_qr_int(nodes, raw, texts, root, "limit", &okl)
    if okl == 0:
        limit <- 10
    page: mutable darray[i64] = []
    next_cursor: mutable i64 = -1
    complete: mutable i64 = 0
    _ = Query::rh_query_page(ids, cursor, limit, page, &next_cursor, &complete)

    # Optional scan-status tally.
    has_states: mutable bool = false
    so: mutable i64 = 0
    st: mutable i64 = 0
    pa: mutable i64 = 0
    un: mutable i64 = 0
    au: mutable i64 = 0
    ot: mutable i64 = 0
    st_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "scan_states")
    if st_idx >= 0:
        return -1 if nodes[st_idx.usize()].kind != Json::RH_JSON_ARR
        has_states <- true
        codes: mutable darray[u8] = []
        sarr: Json::RhJsonNode = nodes[st_idx.usize()]
        while sc >= 0 |sc: i64 = sarr.first_child, nodes, texts, codes|:
            code: i64 = |nodes, texts|
                cxs: mutable i64 = 0
                cxe: mutable i64 = 0
                return -1 if not Json::rh_json_str_span(nodes, sc, &cxs, &cxe)
                block_result: i64 = rh_qr_state(texts, cxs, cxe)
                block_result
            return -1 if code < 0
            codes.push(code.u8())
            sc <- nodes[sc.usize()].next_sibling
        Query::rh_scan_status_tally(codes, &so, &st, &pa, &un, &au, &ot)

    # Optional bounded graph operation. The caller supplies a graph snapshot
    # and a direction; traversal remains local, iterative, and capped by the
    # declared node/depth budgets. No range or implicit node is invented.
    has_graph: mutable bool = false
    graph_direction: mutable i64 = 0
    graph_result: mutable darray[i64] = []
    graph_truncated: mutable i64 = 0
    graph_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "graph")
    if graph_idx >= 0:
        return -1 if nodes[graph_idx.usize()].kind != Json::RH_JSON_OBJ
        graph_nodes_idx: i64 = Json::rh_json_obj_get(nodes, texts, graph_idx, "nodes")
        graph_edges_idx: i64 = Json::rh_json_obj_get(nodes, texts, graph_idx, "edges")
        subject_ok: mutable i64 = 0
        subject: i64 = rh_qr_int(nodes, raw, texts, graph_idx, "subject", &subject_ok)
        return -1 if graph_nodes_idx < 0 or graph_edges_idx < 0 or subject_ok == 0
        return -1 if nodes[graph_nodes_idx.usize()].kind != Json::RH_JSON_ARR or nodes[graph_edges_idx.usize()].kind != Json::RH_JSON_ARR
        direction_s: mutable i64 = 0
        direction_e: mutable i64 = 0
        if rh_qr_str(nodes, texts, graph_idx, "direction", &direction_s, &direction_e):
            graph_direction <- rh_qr_graph_direction(texts, direction_s, direction_e)
            return -1 if graph_direction < 0
        graph_max_nodes_ok: mutable i64 = 0
        graph_max_nodes: mutable i64 = rh_qr_int(nodes, raw, texts, graph_idx, "max_nodes", &graph_max_nodes_ok)
        if graph_max_nodes_ok == 0:
            graph_max_nodes <- 100
        return -1 if graph_max_nodes <= 0 or graph_max_nodes > Query::RH_QPAGE_MAX
        graph_max_depth_ok: mutable i64 = 0
        graph_max_depth: mutable i64 = rh_qr_int(nodes, raw, texts, graph_idx, "max_depth", &graph_max_depth_ok)
        if graph_max_depth_ok == 0:
            graph_max_depth <- 8
        return -1 if graph_max_depth <= 0 or graph_max_depth > Query::RH_QPAGE_MAX
        graph_ids: mutable darray[i64] = []
        graph_nodes_arr: Json::RhJsonNode = nodes[graph_nodes_idx.usize()]
        while gn >= 0 |gn: i64 = graph_nodes_arr.first_child, nodes, raw, graph_ids|:
            return -1 if nodes[gn.usize()].kind != Json::RH_JSON_NUM
            graph_ok: mutable i64 = 0
            graph_value: i64 = Json::rh_json_int(nodes, raw, gn, &graph_ok)
            return -1 if graph_ok == 0 or graph_value < 0 or Graph::rh_contains(graph_ids, graph_value)
            graph_ids.push(graph_value)
            gn <- nodes[gn.usize()].next_sibling
        return -1 if not Graph::rh_contains(graph_ids, subject)
        graph_edges: mutable darray[Graph::RhGraphEdge] = []
        graph_edges_arr: Json::RhJsonNode = nodes[graph_edges_idx.usize()]
        while ge >= 0 |ge: i64 = graph_edges_arr.first_child, nodes, raw, texts, graph_ids, graph_edges|:
            return -1 if nodes[ge.usize()].kind != Json::RH_JSON_OBJ
            from_ok: mutable i64 = 0
            to_ok: mutable i64 = 0
            from_value: i64 = rh_qr_int(nodes, raw, texts, ge, "from", &from_ok)
            to_value: i64 = rh_qr_int(nodes, raw, texts, ge, "to", &to_ok)
            return -1 if from_ok == 0 or to_ok == 0 or from_value < 0 or to_value < 0
            return -1 if not Graph::rh_contains(graph_ids, from_value) or not Graph::rh_contains(graph_ids, to_value)
            graph_edges.push(Graph::RhGraphEdge{from: from_value, dst: to_value, scope: Graph::RH_SCOPE_ALL, platform: 0, introduced: 0, removed: 0, first_seen: 0})
            ge <- nodes[ge.usize()].next_sibling
        projection: Graph::RhProjection = Graph::rh_projection_make(1, Graph::RH_SCOPE_ALL, 0, 0, 0, 0, 0, false, graph_max_nodes, graph_max_depth)
        graph_vis: mutable darray[u8] = []
        if graph_direction == 0:
            _ = Graph::rh_transitive_dependents(graph_edges, graph_vis, subject, projection, graph_result, &graph_truncated)
        else:
            _ = Graph::rh_transitive_dependencies(graph_edges, graph_vis, subject, projection, graph_result, &graph_truncated)
        has_graph <- true

    rh_push_text(out, "{\"schema\":\"rh-query-result/1\",\"kind\":\"")
    rh_push_text(out, rh_qr_kind_label(kind))
    rh_push_text(out, "\",\"page\":{\"ids\":[")
    while i < page.count.i64() |i: i64 = 0, page, out|:
        if i > 0:
            out.push(44)
        rh_push_decimal_i64(out, page[i.usize()])
        i <- i + 1
    rh_push_text(out, "],\"next_cursor\":")
    if next_cursor < 0:
        rh_push_text(out, "null")
    else:
        rh_push_decimal_i64(out, next_cursor)
    rh_push_text(out, ",\"complete\":")
    if complete == 1:
        rh_push_text(out, "true")
    else:
        rh_push_text(out, "false")
    rh_push_text(out, "}")
    if has_states:
        rh_push_text(out, ",\"scan_status\":{\"observed\":")
        rh_push_decimal_i64(out, so)
        rh_push_text(out, ",\"stale\":")
        rh_push_decimal_i64(out, st)
        rh_push_text(out, ",\"partial\":")
        rh_push_decimal_i64(out, pa)
        rh_push_text(out, ",\"unavailable\":")
        rh_push_decimal_i64(out, un)
        rh_push_text(out, ",\"unauthorized\":")
        rh_push_decimal_i64(out, au)
        rh_push_text(out, ",\"other\":")
        rh_push_decimal_i64(out, ot)
        rh_push_text(out, "}")
    if has_graph:
        rh_push_text(out, ",\"graph\":{\"direction\":\"")
        rh_push_text(out, "downstream" if graph_direction == 0 else "upstream")
        rh_push_text(out, "\",\"nodes\":[")
        while i < graph_result.count.i64() |i: i64 = 0, graph_result, out|:
            if i > 0:
                out.push(44)
            rh_push_decimal_i64(out, graph_result[i.usize()])
            i <- i + 1
        rh_push_text(out, "],\"truncated\":")
        rh_push_text(out, "true" if graph_truncated == 1 else "false")
        rh_push_text(out, ",\"complete\":")
        rh_push_text(out, "false" if graph_truncated == 1 else "true")
        rh_push_text(out, "}")
    # Optional job lease sequence.
    job_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "job")
    if job_idx >= 0:
        return -1 if nodes[job_idx.usize()].kind != Json::RH_JSON_OBJ
        okj: mutable i64 = 0
        job_id: mutable i64 = rh_qr_int(nodes, raw, texts, job_idx, "job_id", &okj)
        if okj == 0:
            job_id <- 1
        lease: mutable Query::RhJobLease = Query::rh_job_make(job_id)
        ops_idx: i64 = Json::rh_json_obj_get(nodes, texts, job_idx, "ops")
        return -1 if ops_idx < 0 or nodes[ops_idx.usize()].kind != Json::RH_JSON_ARR
        rh_push_text(out, ",\"job\":{\"job_id\":")
        rh_push_decimal_i64(out, job_id)
        rh_push_text(out, ",\"ops\":[")
        oarr: Json::RhJsonNode = nodes[ops_idx.usize()]
        while oc >= 0 |oc: i64 = oarr.first_child, first_op: bool = true, nodes, texts, raw, out, lease|:
            return -1 if nodes[oc.usize()].kind != Json::RH_JSON_OBJ
            if not first_op:
                out.push(44)
            first_op <- false
            os: mutable i64 = 0
            oe: mutable i64 = 0
            return -1 if not rh_qr_str(nodes, texts, oc, "op", &os, &oe)
            rh_push_text(out, "{\"op\":\"")
            if rh_qr_eq(texts, os, oe, "claim"):
                tok: i64 = |nodes, texts, lease|
                    okow: mutable i64 = 0
                    oknw: mutable i64 = 0
                    oktt: mutable i64 = 0
                    ow: i64 = rh_qr_int(nodes, raw, texts, oc, "owner", &okow)
                    nw: i64 = rh_qr_int(nodes, raw, texts, oc, "now", &oknw)
                    tt: i64 = rh_qr_int(nodes, raw, texts, oc, "ttl", &oktt)
                    return -1 if okow == 0 or oknw == 0 or oktt == 0
                    block_result: i64 = Query::rh_job_claim(&lease, ow, nw, tt)
                    block_result
                rh_push_text(out, "claim\",\"result\":")
                if tok >= 0:
                    rh_push_text(out, "{\"outcome\":\"claimed\",\"token\":")
                    rh_push_decimal_i64(out, tok)
                    rh_push_text(out, ",\"phase\":\"")
                    rh_qr_emit_phase(out, lease.phase)
                    rh_push_text(out, "\"}")
                elif tok == -1:
                    rh_push_text(out, "{\"outcome\":\"held\"}")
                else:
                    rh_push_text(out, "{\"outcome\":\"terminal\"}")
            elif rh_qr_eq(texts, os, oe, "renew"):
                rn: bool = |nodes, texts, lease|
                    okt: mutable i64 = 0
                    okrw: mutable i64 = 0
                    oktl: mutable i64 = 0
                    tk: i64 = rh_qr_int(nodes, raw, texts, oc, "token", &okt)
                    rw: i64 = rh_qr_int(nodes, raw, texts, oc, "now", &okrw)
                    tl: i64 = rh_qr_int(nodes, raw, texts, oc, "ttl", &oktl)
                    return -1 if okt == 0 or okrw == 0 or oktl == 0
                    block_result: bool = Query::rh_job_renew(&lease, tk, rw, tl)
                    block_result
                rh_push_text(out, "renew\",\"result\":{\"applied\":")
                if rn:
                    rh_push_text(out, "true")
                else:
                    rh_push_text(out, "false")
                rh_push_text(out, ",\"phase\":\"")
                rh_qr_emit_phase(out, lease.phase)
                rh_push_text(out, "\"}")
            elif rh_qr_eq(texts, os, oe, "finish"):
                fn: bool = |nodes, texts, lease|
                    okt2: mutable i64 = 0
                    tk2: i64 = rh_qr_int(nodes, raw, texts, oc, "token", &okt2)
                    pcode: i64 = |nodes, texts, okt2|
                        phs: mutable i64 = 0
                        phe: mutable i64 = 0
                        return -1 if okt2 == 0 or not rh_qr_str(nodes, texts, oc, "phase", &phs, &phe)
                        block_result: i64 = rh_qr_phase(texts, phs, phe)
                        block_result
                    return -1 if pcode < 0
                    block_result: bool = Query::rh_job_finish(&lease, tk2, pcode.u8())
                    block_result
                rh_push_text(out, "finish\",\"result\":{\"applied\":")
                if fn:
                    rh_push_text(out, "true")
                else:
                    rh_push_text(out, "false")
                rh_push_text(out, ",\"phase\":\"")
                rh_qr_emit_phase(out, lease.phase)
                rh_push_text(out, "\"}")
            elif rh_qr_eq(texts, os, oe, "budget"):
                wb: bool = |nodes, texts|
                    okv1: mutable i64 = 0
                    okv2: mutable i64 = 0
                    okv3: mutable i64 = 0
                    okv4: mutable i64 = 0
                    visited: i64 = rh_qr_int(nodes, raw, texts, oc, "visited_nodes", &okv1)
                    dl: i64 = rh_qr_int(nodes, raw, texts, oc, "deadline", &okv2)
                    nw2: i64 = rh_qr_int(nodes, raw, texts, oc, "now", &okv3)
                    mx: i64 = rh_qr_int(nodes, raw, texts, oc, "max_nodes", &okv4)
                    return -1 if okv1 == 0 or okv2 == 0 or okv3 == 0 or okv4 == 0
                    block_result: bool = Query::rh_job_within_budget(visited, dl, nw2, mx)
                    block_result
                rh_push_text(out, "budget\",\"result\":{\"within\":")
                if wb:
                    rh_push_text(out, "true")
                else:
                    rh_push_text(out, "false")
                rh_push_text(out, "}")
            else:
                return -1
            out.push(125)
            oc <- nodes[oc.usize()].next_sibling
        rh_push_text(out, "]}")
    rh_push_text(out, ",\"note\":\"cursor pagination is idempotent for a replayed cursor; scan status is a per-capability breakdown, never one project verdict; job leases carry fencing tokens\"}")
    0
