# Bounded read-only capability probes for explicitly approved Gitea/Forgejo instances.
include "./rh_base.elisa"
include "./rh_git.elisa"
include "./rh_json.elisa"
include "./rh_connector.elisa"

module ForgeInstanceProbe:
    private:
        struct RhFipCapture:
            status: mutable darray[u8]
            transport: i64
            valid: bool

        def rh_fip_char(byte: u8) -> bool:
            (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 45 or byte == 46 or byte == 95

        def rh_fip_path(evidence: cstr, name: cstr, ext: cstr) -> mutable darray[u8] can[Memory.Allocate, Abort.Panic]:
            path: mutable darray[u8] = []
            Base::rh_push_cstr(path, evidence)
            Base::rh_push_text(path, ".forge-")
            Base::rh_push_cstr(path, name)
            Base::rh_push_text(path, ".")
            Base::rh_push_cstr(path, ext)
            path.push(0)
            path

        def rh_fip_repo_valid(repository: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            length: usize = Base::rh_cstr_len_c(repository)
            return false if length < 3 or length > 255
            slash: mutable usize = 0
            while i < length |i: usize = 0, slash, repository|:
                if repository[i] == 47:
                    return false if slash != 0 or i == 0 or i + 1 == length
                    slash <- i + 1
                else:
                    return false if not ForgeInstanceProbe::rh_fip_char(repository[i])
                i <- i + 1
            slash > 0 and not (slash == 1 and repository[0] == 46) and not (length - slash == 1 and repository[slash] == 46)

        def rh_fip_status(raw: darray[u8]&, transport: i64, valid: bool) -> u8&:
            return "unavailable" if transport != 0
            return "observed" if Base::rh_bytes_equal_literal(raw, 0, raw.count.i64(), "200") and valid
            return "malformed" if Base::rh_bytes_equal_literal(raw, 0, raw.count.i64(), "200")
            return "unauthorized" if Base::rh_bytes_equal_literal(raw, 0, raw.count.i64(), "401")
            return "forbidden_or_rate_limited" if Base::rh_bytes_equal_literal(raw, 0, raw.count.i64(), "403")
            return "not_found_or_private" if Base::rh_bytes_equal_literal(raw, 0, raw.count.i64(), "404")
            return "rate_limited" if Base::rh_bytes_equal_literal(raw, 0, raw.count.i64(), "429")
            "unavailable"

        def rh_fip_emit_capability(out: mutable darray[u8]&, name: cstr, capture: RhFipCapture&) -> void can[Memory.Allocate, Abort.Panic]:
            label: u8& = ForgeInstanceProbe::rh_fip_status(capture.status, capture.transport, capture.valid)
            Base::rh_push_text(out, "\"")
            Base::rh_push_cstr(out, name)
            Base::rh_push_text(out, "\":{\"status\":\"")
            Base::rh_push_text(out, label)
            Base::rh_push_text(out, "\",\"coverage_state\":\"")
            Base::rh_push_text(out, "observed" if Base::rh_streq(label, "observed") else "partial" if Base::rh_streq(label, "malformed") else "unauthorized" if Base::rh_streq(label, "unauthorized") else "unavailable")
            Base::rh_push_text(out, "\"}")

        def rh_fip_capture(base: cstr, repository: cstr, route: cstr, name: cstr, evidence: cstr) -> RhFipCapture can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            url: mutable darray[u8] = []
            Base::rh_push_cstr(url, base)
            Base::rh_push_text(url, "/api/v1/repos/")
            Base::rh_push_cstr(url, repository)
            Base::rh_push_text(url, "/")
            Base::rh_push_cstr(url, route)
            url.push(0)
            url_ptr: cstr = (&url[0]).cast[cstr] can Unsafe.PointerCast
            body_path: mutable darray[u8] = ForgeInstanceProbe::rh_fip_path(evidence, name, "json")
            status_path: mutable darray[u8] = ForgeInstanceProbe::rh_fip_path(evidence, name, "status")
            error_path: mutable darray[u8] = ForgeInstanceProbe::rh_fip_path(evidence, name, "err")
            url_path: mutable darray[u8] = ForgeInstanceProbe::rh_fip_path(evidence, name, "url")
            body_ptr: cstr = (&body_path[0]).cast[cstr] can Unsafe.PointerCast
            status_ptr: cstr = (&status_path[0]).cast[cstr] can Unsafe.PointerCast
            error_ptr: cstr = (&error_path[0]).cast[cstr] can Unsafe.PointerCast
            url_ptr_path: cstr = (&url_path[0]).cast[cstr] can Unsafe.PointerCast
            url_record: mutable darray[u8] = []
            Base::rh_push_cstr(url_record, url_ptr)
            url_record.push(10)
            return RhFipCapture{status: [], transport: -1, valid: false} if not Base::rh_io_write(url_ptr_path, url_record)
            transport: i64 = Git::rh_run_https_get(url_ptr, body_ptr, status_ptr, error_ptr)
            return RhFipCapture{status: [], transport: transport, valid: false} if transport < 0
            status: mutable darray[u8] = []
            _ = Base::rh_io_read(status_ptr, status)
            body: mutable darray[u8] = []
            body_read: i64 = Base::rh_io_read(body_ptr, body)
            return RhFipCapture{status: status, transport: -1, valid: false} if body_read < 0 or body.count.i64() > 3145728
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(body, nodes, texts) if Base::rh_bytes_equal_literal(status, 0, status.count.i64(), "200") else -1
            RhFipCapture{status: status, transport: transport, valid: root >= 0 and nodes[root.usize()].kind == Json::RH_JSON_ARR}

    public:
        # The instance document is the sole source of the base URL and must pass the shared
        # connector approval and public-host transport guard before any request is issued.
        def rh_forge_instance_capability_matrix(instance_path: cstr, repository: cstr, evidence: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if not ForgeInstanceProbe::rh_fip_repo_valid(repository) or not Git::rh_arg_safe(instance_path) or not Git::rh_arg_safe(evidence)
            raw: mutable darray[u8] = []
            read: i64 = Base::rh_io_read(instance_path, raw)
            return -1 if read < 0 or read > 65536
            inst: mutable Connector::RhConnectorInstance = Connector::RhConnectorInstance{id_start: 0, id_end: 0, url_start: 0, url_end: 0, approved: false}
            caps: mutable darray[i64] = []
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or Connector::rh_connector_instance_parse(raw, inst, caps) != 0
            id_node: i64 = Json::rh_json_obj_get(nodes, texts, root, "connector_id")
            url_node: i64 = Json::rh_json_obj_get(nodes, texts, root, "base_url")
            id_start: mutable i64 = 0
            id_end: mutable i64 = 0
            url_start: mutable i64 = 0
            url_end: mutable i64 = 0
            return -1 if not Json::rh_json_str_span(nodes, id_node, &id_start, &id_end) or not Json::rh_json_str_span(nodes, url_node, &url_start, &url_end)
            return -1 if not inst.approved
            id: mutable darray[u8] = []
            url: mutable darray[u8] = []
            while j < id_end |j: i64 = id_start, id_end, url_start, url_end, texts, id, url|:
                id.push(texts[j.usize()])
                j <- j + 1
            id.push(0)
            idc: cstr = (&id[0]).cast[cstr] can Unsafe.PointerCast
            while j < url_end |j: i64 = url_start, url_end, texts, url|:
                url.push(texts[j.usize()])
                j <- j + 1
            url.push(0)
            return -1 if not Base::rh_streq(idc, "gitea") and not Base::rh_streq(idc, "forgejo")
            # Instance URLs may include a path prefix; reject ambiguous query, fragment, userinfo, and trailing slash forms.
            while k < url.count |k: usize = 0, url|:
                return -1 if url[k] == 63 or url[k] == 35
                k <- k + 1
            base: cstr = (&url[0]).cast[cstr] can Unsafe.PointerCast
            return -1 if not Git::rh_fetch_guard(base)
            base_len: usize = Base::rh_cstr_len_c(base)
            return -1 if base_len == 0 or url[base_len - 1] == 47
            issues: RhFipCapture = ForgeInstanceProbe::rh_fip_capture(base, repository, "issues?limit=1&type=issues", "issues", evidence)
            pulls: RhFipCapture = ForgeInstanceProbe::rh_fip_capture(base, repository, "pulls?limit=1", "pulls", evidence)
            releases: RhFipCapture = ForgeInstanceProbe::rh_fip_capture(base, repository, "releases?limit=1", "releases", evidence)
            captured: i64 = Base::rh_now()
            return -1 if captured < 0
            Base::rh_push_text(out, "{\"schema\":\"rh-forge-capability-matrix/1\",\"provider\":\"")
            Base::rh_push_cstr(out, idc)
            Base::rh_push_text(out, "\",\"captured_at\":")
            Base::rh_push_decimal_i64(out, captured)
            Base::rh_push_text(out, ",\"repository\":\"")
            Base::rh_push_cstr(out, repository)
            Base::rh_push_text(out, "\",\"capabilities\":{")
            ForgeInstanceProbe::rh_fip_emit_capability(out, "issues", issues)
            Base::rh_push_text(out, ",")
            ForgeInstanceProbe::rh_fip_emit_capability(out, "pulls", pulls)
            Base::rh_push_text(out, ",")
            ForgeInstanceProbe::rh_fip_emit_capability(out, "releases", releases)
            Base::rh_push_text(out, "},\"note\":\"Fixed one-item list requests; response bodies are retained only in adjacent evidence files.\"}")
            0
