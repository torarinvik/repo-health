# Field transformation contract for dependency resolution instances.
include "./rh_base.elisa"

module ResolutionTransformation:
    public:
        def rh_resolution_transformation_report(configuration_sha: darray[u8]&, input_sha: darray[u8]&,
                                                output_sha: darray[u8]&,
                                                out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"dependency-resolution-instances\",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-resolution-instance/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"package identity and graph node id\",\"target\":\"instances[].package|node_id\",\"state\":\"preserved\"},{\"source\":\"dependency edges and root relationships\",\"target\":\"instances[].dependencies|root\",\"state\":\"transformed\"},{\"source\":\"unresolved dependency requirements\",\"target\":\"unresolved[]\",\"state\":\"preserved\"},{\"source\":\"absent optional package metadata\",\"target\":\"instance coverage\",\"state\":\"unknown\"},{\"source\":\"graph fields outside resolution contract\",\"target\":\"resolution result\",\"state\":\"discarded\"}]}")
