# rh_ops.elisa — M07 operations surfaces: backup/restore drills (M07-10),
# monitoring exposition with service vs project separation (M07-11), and
# source-respect quotas/backoff/operator-stop (M07-12).
#
# Adaptation notes (honest scope): the evidence store uses a FNV-1a
# digest, so "verification" here detects accidental corruption and
# tampering-in-transit by a non-adversary; it is NOT a cryptographic
# signature and must never be presented as proof of safety (S011, M07-04).
# Signing needs a real keyed primitive the stage1 slice does not provide;
# that gap stays in STATUS until implemented.
include "./rh_base.elisa"
include "./rh_store.elisa"

# ---------------------------------------------------------------------------
# M07-10 backup + restore
# ---------------------------------------------------------------------------

# Write a canonical backup manifest: a header line naming the digest
# algorithm, then one evidence object name per line in caller order
# (callers sort for determinism). Deterministic: identical input -> bytes.
module Ops:
    public:
        def rh_backup_write(manifest_path: cstr, names: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return false if not rh_backup_names_valid(names, 0)
            out: mutable darray[u8] =
                out: mutable darray[u8] = []
                Base::rh_push_text(out, "rh-backup/1 fnv1a-64-hex\n")
                out.extend(bytes_view(names))
                out
            if out.count > 0:
                last: u8 = out[out.count - 1]
                if last != 10:
                    out.push(10)
            Base::rh_io_write(manifest_path, out)

        # Build "root/name\0" into a caller-owned buffer; return the cstr view.
        # The caller keeps the buffer alive for the duration of the call.
        # (private to this file)
        def rh_backup_verify(evidence_root: cstr, manifest_path: cstr, present_out: mutable i64&, missing_out: mutable i64&, corrupt_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            present_out[0] <- 0
            missing_out[0] <- 0
            corrupt_out[0] <- 0
            raw: mutable darray[u8] = []
            return -1 if Base::rh_io_read(manifest_path, raw) < 0
            return -1 if not rh_backup_header_ok(raw)
            while start < raw.count |start: usize = rh_backup_header_end(raw), raw, evidence_root, present_out, missing_out, corrupt_out|:
                stop: i64 = Base::rh_find_byte(raw, start, 10)
                line_end: usize = stop.usize() if stop >= 0 else raw.count
                if line_end > start:
                    name: mutable darray[u8] = []
                    rh_backup_copy_span(raw, start, line_end, name)
                    name.push(0)
                    nn: cstr = (&name[0]).cast[cstr] can Unsafe.PointerCast
                    pbuf: mutable darray[u8] = []
                    pstr: cstr = rh_backup_path_cstr(evidence_root, nn, pbuf)
                    if not file_exists(pstr):
                        missing_out[0] <- missing_out[0] + 1
                    else:
                        ok: mutable i64 = 0
                        _ = Store::rh_store_blob_verify(evidence_root, nn, &ok)
                        if ok == 1:
                            present_out[0] <- present_out[0] + 1
                        else:
                            corrupt_out[0] <- corrupt_out[0] + 1
                if stop < 0:
                    start <- raw.count
                else:
                    start <- stop.usize() + 1
            0

        # Copy every verified object from evidence_root to dest_root. Unverified
        # names are skipped (never restored): a corrupt backup must not silently
        # become live evidence. Returns 0 on success (count in restored_out).
        def rh_backup_restore(evidence_root: cstr, dest_root: cstr, manifest_path: cstr, restored_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            restored_out[0] <- 0
            raw: mutable darray[u8] = []
            return -1 if Base::rh_io_read(manifest_path, raw) < 0
            return -1 if not rh_backup_header_ok(raw)
            while start < raw.count |start: usize = rh_backup_header_end(raw), raw, evidence_root, dest_root, restored_out|:
                stop: i64 = Base::rh_find_byte(raw, start, 10)
                line_end: usize = stop.usize() if stop >= 0 else raw.count
                if line_end > start:
                    name: mutable darray[u8] = []
                    rh_backup_copy_span(raw, start, line_end, name)
                    name.push(0)
                    nn: cstr = (&name[0]).cast[cstr] can Unsafe.PointerCast
                    ok: mutable i64 = 0
                    _ = Store::rh_store_blob_verify(evidence_root, nn, &ok)
                    if ok == 1:
                        src_buf: mutable darray[u8] = []
                        src: cstr = rh_backup_path_cstr(evidence_root, nn, src_buf)
                        back: mutable darray[u8] = []
                        if Base::rh_io_read(src, back) >= 0:
                            restored_name: mutable darray[u8] = []
                            return -1 if Store::rh_store_blob(dest_root, back, restored_name) != 0
                            return -1 if not Base::rh_bytes_equal_span(restored_name, 0, restored_name.count.i64(), raw, start.i64(), line_end.i64())
                            restored_out[0] <- restored_out[0] + 1
                if stop < 0:
                    start <- raw.count
                else:
                    start <- stop.usize() + 1
            0

        # (private to this file)
        const RH_REPLAY_UNKNOWN: i64 = 0
        const RH_REPLAY_REPLAYABLE: i64 = 1
        const RH_REPLAY_NOT_REPLAYABLE: i64 = 2

        # referenced: newline-separated evidence object names.
        def rh_replay_label(evidence_dir: cstr, referenced: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            seen: i64 =
                while start < referenced.count |seen: i64 = 0, start: usize = 0| -> seen:
                    stop: i64 = Base::rh_find_byte(referenced, start, 10)
                    line_end: mutable usize = stop.usize() if stop >= 0 else referenced.count
                    if line_end > start:
                        seen <- seen + 1
                        path: mutable darray[u8] =
                            path: mutable darray[u8] = []
                            Base::rh_push_cstr(path, evidence_dir)
                            path.push(47)
                            path
                        while k < line_end |k: usize = start, referenced, path, line_end|:
                            path.push(referenced[k])
                            k <- k + 1
                        path.push(0)
                        pp: cstr = (&path[0]).cast[cstr] can Unsafe.PointerCast
                        return RH_REPLAY_NOT_REPLAYABLE if Base::rh_file_size(pp) < 0
                    if stop < 0:
                        start <- referenced.count
                    else:
                        start <- stop.usize() + 1
            return RH_REPLAY_UNKNOWN if seen == 0
            RH_REPLAY_REPLAYABLE

        # ---------------------------------------------------------------------------
        # M07-11 monitoring: service health and project health are SEPARATE series.
        # A source outage moves service freshness/lag; it must not move project
        # activity/unknown counters (the M02 coverage propagation rule).
        # ---------------------------------------------------------------------------

        struct RhMon:
            observed: mutable i64
            unknown: mutable i64
            stale_partial: mutable i64
            errors: mutable i64
            parser_rejects: mutable i64
            object_failures: mutable i64
            truncations: mutable i64
            queue_age_max: mutable i64
            cursor_lag_max: mutable i64
            last_success_epoch: mutable i64
            expected_interval: mutable i64

        def rh_mon_new(expected_interval: i64) -> RhMon:
            RhMon{observed: 0, unknown: 0, stale_partial: 0, errors: 0, parser_rejects: 0, object_failures: 0, truncations: 0, queue_age_max: 0, cursor_lag_max: 0, last_success_epoch: 0, expected_interval: expected_interval}

        def rh_mon_observed(m: mutable RhMon&) -> void:
            m.observed <- m.observed + 1

        def rh_mon_unknown(m: mutable RhMon&) -> void:
            m.unknown <- m.unknown + 1

        def rh_mon_stale_partial(m: mutable RhMon&) -> void:
            m.stale_partial <- m.stale_partial + 1

        def rh_mon_error(m: mutable RhMon&) -> void:
            m.errors <- m.errors + 1

        def rh_mon_parser_reject(m: mutable RhMon&) -> void:
            m.parser_rejects <- m.parser_rejects + 1

        def rh_mon_object_failure(m: mutable RhMon&) -> void:
            m.object_failures <- m.object_failures + 1

        def rh_mon_truncation(m: mutable RhMon&) -> void:
            m.truncations <- m.truncations + 1

        def rh_mon_success(m: mutable RhMon&, now: i64) -> void:
            m.last_success_epoch <- now

        # Observed ratio in basis points. -1 means "no denominator" and callers
        # MUST surface unknown rather than 0 (S006).
        def rh_mon_observed_rate_bp(m: mutable RhMon&) -> i64:
            total: i64 = m.observed + m.unknown
            return -1 if total <= 0
            (m.observed * 10000) / total

        def rh_mon_freshness_age(m: mutable RhMon&, now: i64) -> i64:
            return -1 if m.last_success_epoch <= 0
            return 0 if now < m.last_success_epoch
            now - m.last_success_epoch

        # Deterministic exposition text; field order is stable so diffs are
        # meaningful. Two series namespaces: rh_service_* and rh_project_*.
        def rh_mon_text(m: mutable RhMon&, now: i64, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "rh_service_queue_age_seconds_max ")
            Base::rh_push_decimal_i64(out, m.queue_age_max)
            out.push(10)
            Base::rh_push_text(out, "rh_service_cursor_lag_seconds_max ")
            Base::rh_push_decimal_i64(out, m.cursor_lag_max)
            out.push(10)
            Base::rh_push_text(out, "rh_service_last_success_epoch ")
            Base::rh_push_decimal_i64(out, m.last_success_epoch)
            out.push(10)
            Base::rh_push_text(out, "rh_service_freshness_age_seconds ")
            Base::rh_push_decimal_i64(out, rh_mon_freshness_age(m, now))
            out.push(10)
            Base::rh_push_text(out, "rh_service_errors_total ")
            Base::rh_push_decimal_i64(out, m.errors)
            out.push(10)
            Base::rh_push_text(out, "rh_service_parser_rejects_total ")
            Base::rh_push_decimal_i64(out, m.parser_rejects)
            out.push(10)
            Base::rh_push_text(out, "rh_service_object_failures_total ")
            Base::rh_push_decimal_i64(out, m.object_failures)
            out.push(10)
            Base::rh_push_text(out, "rh_project_observed_total ")
            Base::rh_push_decimal_i64(out, m.observed)
            out.push(10)
            Base::rh_push_text(out, "rh_project_unknown_total ")
            Base::rh_push_decimal_i64(out, m.unknown)
            out.push(10)
            Base::rh_push_text(out, "rh_project_observed_rate_bp ")
            Base::rh_push_decimal_i64(out, rh_mon_observed_rate_bp(m))
            out.push(10)
            Base::rh_push_text(out, "rh_project_stale_partial_total ")
            Base::rh_push_decimal_i64(out, m.stale_partial)
            out.push(10)
            Base::rh_push_text(out, "rh_project_truncations_total ")
            Base::rh_push_decimal_i64(out, m.truncations)
            out.push(10)

        # ---------------------------------------------------------------------------
        # M07-12 source-respect: per-host token bucket + exponential backoff +
        # operator stop. Backoff is measured from the last failure; while backing
        # off the host is not contacted, so a failing provider is not hammered.
        # Cancel refunds a token; stop is an operator kill switch.
        # ---------------------------------------------------------------------------

        struct RhHostPolicy:
            capacity: i64
            refill_per_second: i64
            base_backoff_seconds: i64
            max_backoff_seconds: i64

        struct RhHostState:
            host_id: mutable i64
            tokens: mutable i64
            last_refill: mutable i64
            backoff_until: mutable i64
            consecutive_failures: mutable i64
            stopped: mutable i64

        def rh_host_new(host_id: i64, capacity: i64) -> RhHostState:
            RhHostState{host_id: host_id, tokens: capacity, last_refill: 0, backoff_until: 0, consecutive_failures: 0, stopped: 0}

        # (private to this file)
        def rh_host_allow(st: mutable RhHostState&, policy: RhHostPolicy&, now: i64) -> i64:
            return 0 if st.stopped != 0
            return 0 if st.backoff_until > now
            rh_host_refill(st, policy, now)
            return 1 if st.tokens > 0
            0

        # 1 consumed; 0 refused (caller must not issue the request).
        def rh_host_consume(st: mutable RhHostState&, policy: RhHostPolicy&, now: i64) -> i64:
            return 0 if rh_host_allow(st, policy, now) != 1
            st.tokens <- st.tokens - 1
            1

        def rh_host_record_failure(st: mutable RhHostState&, policy: RhHostPolicy&, now: i64) -> i64:
            st.consecutive_failures <- st.consecutive_failures + 1
            shift: mutable i64 = st.consecutive_failures - 1
            if shift > 20:
                shift <- 20
            wait: mutable i64 =
                while k < shift |wait: i64 = policy.base_backoff_seconds, k: i64 = 0| -> wait:
                    wait <- wait * 2
                    k <- k + 1
            if wait > policy.max_backoff_seconds:
                wait <- policy.max_backoff_seconds
            st.backoff_until <- now + wait
            wait

        def rh_host_record_success(st: mutable RhHostState&) -> void:
            st.consecutive_failures <- 0
            st.backoff_until <- 0

        def rh_host_stop(st: mutable RhHostState&) -> void:
            st.stopped <- 1

        # Operator cancel: refund the in-flight token so a cancelled job does not
        # consume the host's budget.
        def rh_host_cancel(st: mutable RhHostState&, policy: RhHostPolicy&) -> void:
            if st.tokens < policy.capacity:
                st.tokens <- st.tokens + 1

        # Build a portable, bounded transfer package from a verified backup
        # manifest. The package is transport-neutral; its FNV checks detect
        # accidental damage but do not authenticate the sender.
        def rh_transfer_export(evidence_root: cstr, manifest_path: cstr, bundle_path: cstr) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            manifest: mutable darray[u8] = []
            return false if Base::rh_io_read(manifest_path, manifest) < 0
            return false if not rh_backup_header_ok(manifest) or not rh_transfer_manifest_sorted(manifest)
            return false if Base::rh_streq(manifest_path, bundle_path)
            bundle: mutable darray[u8] =
                bundle: mutable darray[u8] = []
                Base::rh_push_text(bundle, "rh-evidence-transfer/1 fnv1a-64-hex\n")
                bundle
            while start < manifest.count |start: usize = rh_backup_header_end(manifest), manifest, evidence_root, bundle_path, bundle|:
                stop: i64 = Base::rh_find_byte(manifest, start, 10)
                line_end: usize = stop.usize() if stop >= 0 else manifest.count
                name: mutable darray[u8] = []
                rh_backup_copy_span(manifest, start, line_end, name)
                name.push(0)
                name_cstr: cstr = (&name[0]).cast[cstr] can Unsafe.PointerCast
                source_buffer: mutable darray[u8] = []
                source_path: cstr = rh_backup_path_cstr(evidence_root, name_cstr, source_buffer)
                return false if Base::rh_streq(bundle_path, source_path)
                blob: mutable darray[u8] = []
                return false if Base::rh_io_read(source_path, blob) < 0
                return false if not Store::rh_store_blob_content_matches(name_cstr, blob)
                Base::rh_push_text(bundle, "blob ")
                rh_backup_copy_span(name, 0, 16, bundle)
                bundle.push(32)
                Base::rh_push_decimal_i64(bundle, blob.count.i64())
                bundle.push(10)
                return false if bundle.count >= RH_TRANSFER_MAX_BYTES
                return false if blob.count > RH_TRANSFER_MAX_BYTES - bundle.count - 1.usize()
                bundle.extend(bytes_view(blob))
                bundle.push(10)
                start <- manifest.count if stop < 0 else stop.usize() + 1
            Base::rh_io_write(bundle_path, bundle)

        # Import validates the complete package before publishing any object.
        # Publication is atomic and no-clobber per blob, so a storage failure
        # halfway through can be retried safely with the same package.
        def rh_transfer_import(dest_root: cstr, bundle_path: cstr, imported_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            imported_out[0] <- 0
            bundle: mutable darray[u8] = []
            return -1 if Base::rh_io_read(bundle_path, bundle) < 0
            return -1 if not rh_transfer_bundle_valid(bundle, imported_out)
            imported_out[0] <- 0
            cursor: mutable usize = rh_transfer_header_end()
            while cursor < bundle.count |cursor, bundle, dest_root, imported_out|:
                name: mutable darray[u8] = []
                data_start: mutable usize = 0
                data_end: mutable usize = 0
                state: i64 = rh_transfer_next(bundle, cursor, name, &data_start, &data_end)
                return -1 if state != 1
                blob: mutable darray[u8] = []
                rh_backup_copy_span(bundle, data_start, data_end, blob)
                stored_name: mutable darray[u8] = []
                return -1 if Store::rh_store_blob(dest_root, blob, stored_name) != 0
                return -1 if stored_name.count != 16 or not Base::rh_bytes_equal_span(stored_name, 0, 16, name, 0, 16)
                imported_out[0] <- imported_out[0] + 1
            0

    private:
        const RH_TRANSFER_MAX_BYTES: usize = 67108864

        # `rh-evidence-transfer/1` frames each blob as one ASCII header line
        # (`blob <16-hex-name> <decimal-length>`) followed by exactly that many
        # bytes and one LF delimiter. Length framing preserves arbitrary bytes.
        def rh_transfer_header_ok(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            expected: mutable darray[u8] = []
            Base::rh_push_text(expected, "rh-evidence-transfer/1 fnv1a-64-hex\n")
            Base::rh_bytes_equal_span(raw, 0, expected.count.i64(), expected, 0, expected.count.i64())

        def rh_transfer_header_end() -> usize can[Memory.Allocate, Abort.Panic]:
            expected: mutable darray[u8] = []
            Base::rh_push_text(expected, "rh-evidence-transfer/1 fnv1a-64-hex\n")
            expected.count.usize()

        # Decode one framed record. Returns 1 for a record, 0 at clean EOF, and
        # -1 for malformed framing. The name output includes a trailing NUL.
        def rh_transfer_next(raw: darray[u8]&, cursor: mutable usize&, name_out: mutable darray[u8]&, data_start_out: mutable usize&, data_end_out: mutable usize&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if cursor[0] == raw.count
            return -1 if cursor[0] > raw.count or name_out.count != 0
            line_start: usize = cursor[0]
            line_break: i64 = Base::rh_find_byte(raw, line_start, 10)
            return -1 if line_break < 0
            line_end: usize = line_break.usize()
            return -1 if line_end - line_start < 23
            prefix: mutable darray[u8] = []
            Base::rh_push_text(prefix, "blob ")
            while k < prefix.count.usize() |k: usize = 0, raw, line_start, prefix|:
                return -1 if raw[line_start + k] != prefix[k]
                k <- k + 1
            name_start: usize = line_start + 5.usize()
            name_end: usize = name_start + 16.usize()
            return -1 if raw[name_end] != 32
            while i < name_end |i: usize = name_start, raw, name_out, name_end|:
                b: u8 = raw[i]
                return -1 if not ((b >= 48 and b <= 57) or (b >= 97 and b <= 102))
                name_out.push(b)
                i <- i + 1
            size_start: usize = name_end + 1.usize()
            return -1 if size_start >= line_end
            return -1 if line_end - size_start > 1 and raw[size_start] == 48
            size_bytes: mutable darray[u8] = []
            rh_backup_copy_span(raw, size_start, line_end, size_bytes)
            size: usize =
                while digit_index < size_bytes.count.usize() |size: mutable usize = 0, digit_index: usize = 0, size_bytes| -> size:
                    digit: u8 = size_bytes[digit_index]
                    return -1 if digit < 48 or digit > 57
                    value: usize = (digit - 48).usize()
                    return -1 if size > (RH_TRANSFER_MAX_BYTES - value) / 10.usize()
                    size <- size * 10.usize() + value
                    digit_index <- digit_index + 1
            return -1 if size > RH_TRANSFER_MAX_BYTES
            data_start: usize = line_end + 1.usize()
            return -1 if data_start > raw.count or size >= raw.count - data_start
            data_end: usize = data_start + size
            return -1 if raw[data_end] != 10
            name_out.push(0)
            data_start_out[0] <- data_start
            data_end_out[0] <- data_end
            cursor[0] <- data_end + 1.usize()
            1

        def rh_transfer_name_after(name: darray[u8]&, previous: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if previous.count == 0
            while i < 16.usize() |i: usize = 0, name, previous|:
                return true if name[i] > previous[i]
                return false if name[i] < previous[i]
                i <- i + 1
            false

        def rh_transfer_manifest_sorted(manifest: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            previous: mutable darray[u8] = []
            while start < manifest.count |start: usize = rh_backup_header_end(manifest), manifest, previous|:
                stop: i64 = Base::rh_find_byte(manifest, start, 10)
                line_end: usize = stop.usize() if stop >= 0 else manifest.count
                current: mutable darray[u8] = []
                rh_backup_copy_span(manifest, start, line_end, current)
                return false if not rh_transfer_name_after(current, previous)
                previous <- current
                start <- manifest.count if stop < 0 else stop.usize() + 1
            true

        def rh_transfer_bundle_valid(raw: darray[u8]&, count_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            count_out[0] <- 0
            return false if raw.count > RH_TRANSFER_MAX_BYTES or not rh_transfer_header_ok(raw)
            previous: mutable darray[u8] = []
            cursor: mutable usize = rh_transfer_header_end()
            while cursor < raw.count |cursor, raw, previous, count_out|:
                name: mutable darray[u8] = []
                data_start: mutable usize = 0
                data_end: mutable usize = 0
                state: i64 = rh_transfer_next(raw, cursor, name, &data_start, &data_end)
                return false if state != 1 or not rh_transfer_name_after(name, previous)
                name_cstr: cstr = (&name[0]).cast[cstr] can Unsafe.PointerCast
                blob: mutable darray[u8] = []
                rh_backup_copy_span(raw, data_start, data_end, blob)
                return false if not Store::rh_store_blob_content_matches(name_cstr, blob)
                previous <- name
                count_out[0] <- count_out[0] + 1
            true

        def rh_backup_path_cstr(root: cstr, name: u8&, buf: mutable darray[u8]&) -> cstr can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_cstr(buf, root)
            buf.push(47)
            Base::rh_push_text(buf, name)
            buf.push(0)
            (&buf[0]).cast[cstr] can Unsafe.PointerCast

        # Copy bytes in the half-open span [s0, s1) into out.
        # (private to this file)
        def rh_backup_copy_span(raw: darray[u8]&, s0: usize, s1: usize, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            while k < s1 |k: usize = s0, raw, s1, out|:
                out.push(raw[k])
                k <- k + 1

        # For every named object under evidence_root: count present+digest-verified
        # and present-but-corrupt. Missing files are counted missing. A restore is
        # trustworthy only when both failure counts are zero; the caller decides
        # policy (M07-10: unrestored backup is not evidence).
        def rh_backup_header_ok(raw: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            want: mutable darray[u8] = []
            Base::rh_push_text(want, "rh-backup/1 fnv1a-64-hex\n")
            return false if raw.count < want.count.usize()
            while k < want.count.usize() |k: usize = 0, raw, want|:
                return false if raw[k] != want[k]
                k <- k + 1
            rh_backup_names_valid(raw, want.count.usize())

        # Validate the complete newline-separated transfer list before reading
        # source paths or publishing destination objects.
        def rh_backup_names_valid(raw: darray[u8]&, offset: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            while start < raw.count |start: usize = offset, raw|:
                stop: i64 = Base::rh_find_byte(raw, start, 10)
                end: usize = stop.usize() if stop >= 0 else raw.count
                return false if end - start != 16
                while i < end |i: usize = start, raw|:
                    b: u8 = raw[i]
                    return false if not ((b >= 48 and b <= 57) or (b >= 97 and b <= 102))
                    i <- i + 1
                start <- end + 1 if stop >= 0 else raw.count
            true

        # (private to this file)
        def rh_backup_header_end(raw: darray[u8]&) -> usize can[Memory.Allocate, Abort.Panic]:
            want: mutable darray[u8] = []
            Base::rh_push_text(want, "rh-backup/1 fnv1a-64-hex\n")
            want.count.usize()

        # ---------------------------------------------------------------------------
        # M07-08 replayability label. After a deletion drill or any retention
        # change, a report whose referenced raw inputs are gone is NOT replayable,
        # and must say so rather than silently recomputing or substituting live
        # data. Presence is checked here; digest verification is separate (M07-10).
        # ---------------------------------------------------------------------------

        def rh_host_refill(st: mutable RhHostState&, policy: RhHostPolicy&, now: i64) -> void:
            return if now <= st.last_refill
            add: i64 =
                delta: i64 = now - st.last_refill
                delta * policy.refill_per_second
            if add > 0:
                st.tokens <- st.tokens + add
                if st.tokens > policy.capacity:
                    st.tokens <- policy.capacity
            st.last_refill <- now
