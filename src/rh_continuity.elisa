            Base::rh_push_text(out, ",\"evidence\":[\"evidence/git-log.bin\"]},")
            # concentration.change_absence_factor_50
            Base::rh_push_text(out, "{\"key\":\"concentration.change_absence_factor_50\",\"version\":\"1.0.0\",\"status\":\"")
            if fifty < 0:
                Base::rh_push_text(out, "not_applicable\",\"reason\":\"no-qualifying-commit-events\"")
            else:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, fifty)
            Base::rh_push_text(out, ",\"evidence\":[\"evidence/git-log.bin\"]},")
            # concentration.change_top1_share
            Base::rh_push_text(out, "{\"key\":\"concentration.change_top1_share\",\"version\":\"1.0.0\",\"status\":\"")
            if top_d == 0:
                Base::rh_push_text(out, "not_applicable\",\"reason\":\"no-qualifying-commit-events\"")
            else:
                Base::rh_push_text(out, "observed\",\"value\":{\"num\":")
