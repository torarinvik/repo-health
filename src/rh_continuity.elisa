module Continuity:
    public:
        # rh_continuity.elisa — persistence cohorts, retention censoring,
        # concentration inputs, transitions, role visibility (M04-05/06/07/08).
        #
        # Exact populations only: presence is built from qualifying events over
        # COMPLETE calendar months (the caller passes a month range that already
        # excludes the current partial month; see Temporal::rh_complete_months_between).
        # One day with three commits is one active month, never three. Cohorts
        # return their components (active months, span, recency) alongside
        # membership so a reader can inspect the rule rather than trust a label.
        # Empty populations return not_applicable (-1) for ratios and counts
        # whose semantics require events — never a synthetic zero.

        const RH_EV_COMMIT: u8 = 0
        const RH_EV_RELEASE: u8 = 1
        const RH_EV_REVIEW: u8 = 2

        const RH_RET_RETAINED: i64 = 0
        const RH_RET_NOT_RETAINED: i64 = 1
        const RH_RET_CENSORED: i64 = 2
        const RH_RET_UNOBSERVABLE: i64 = 3

        # Local arithmetic helper. Metrics::rh_gcd remains private to its module;
        # continuity owns this small reduction operation for its effective-count
        # projection instead of reaching through a private implementation detail.
        # Actor-by-month presence matrix, row-major actor*n_months + month.
        def rh_presence_build(actor: darray[i64]&, month: darray[i64]&, kind: darray[u8]&, kind_filter: i64, n_actors: i64, month_lo: i64, n_months: i64, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if n_actors < 0 or n_months < 0
            total: i64 = n_actors * n_months
            while i < total |i: i64 = 0, out|:
                out.push(0)
                i <- i + 1
            while e < actor.count |used: i64 = 0, e: usize = 0, out| -> used:
                a: i64 = actor[e]
                m: i64 = month[e]
                k: u8 = kind[e]
                e <- e + 1
                continue if kind_filter >= 0 and k.i64() != kind_filter
                continue if a < 0 or a >= n_actors
                idx: i64 = m - month_lo
                continue if idx < 0 or idx >= n_months
                slot: i64 = a * n_months + idx
                if out[slot.usize()] == 0:
                    out[slot.usize()] <- 1
                    used <- used + 1

        def rh_actor_active_months(presence: darray[u8]&, actor: i64, n_months: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while m < n_months |total: i64 = 0, m: i64 = 0| -> total:
                if rh_presence_get(presence, actor, n_months, m):
                    total <- total + 1
                m <- m + 1

        # First-to-last active span in months, inclusive. 0 when never active.
        def rh_actor_span(presence: darray[u8]&, actor: i64, n_months: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            first, last =
                while m < n_months |first: i64 = -1, last: i64 = -1, m: i64 = 0| -> first, last:
                    if rh_presence_get(presence, actor, n_months, m):
                        if first < 0:
                            first <- m
                        last <- m
                    m <- m + 1
            return 0 if first < 0
            last - first + 1

        def rh_actor_recent(presence: darray[u8]&, actor: i64, n_months: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_presence_get(presence, actor, n_months, n_months - 1)

        # Persistence cohort membership. Components stay separately available to
        # callers (active months, span, recency) so explanations can show the
        # rule's parts, not just the verdict.
        def rh_persistent(active_months: i64, span: i64, recent: bool, min_active: i64, min_span: i64, need_recent: bool) -> bool:
            return false if active_months < min_active
            return false if span < min_span
            return false if need_recent and not recent
            true

        # Count members of the persistence cohort.
        def rh_persistent_count(presence: darray[u8]&, n_actors: i64, n_months: i64, min_active: i64, min_span: i64, need_recent: bool) -> i64 can[Memory.Allocate, Abort.Panic]:
            while a < n_actors |total: i64 = 0, a: i64 = 0| -> total:
                active: i64 = rh_actor_active_months(presence, a, n_months)
                span: i64 = rh_actor_span(presence, a, n_months)
                recent: bool = rh_actor_recent(presence, a, n_months)
                if rh_persistent(active, span, recent, min_active, min_span, need_recent):
                    total <- total + 1
                a <- a + 1

        # Count actors meeting an activity threshold over the trailing twelve
        # complete months. Fewer than twelve complete months is unsupported;
        # observed quietness must not be promoted to a lifetime claim.
        def rh_active_threshold_count(presence: darray[u8]&, n_actors: i64, n_months: i64, min_active: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if n_months < 12
            presence_loop: mutable darray[u8]& = presence
            actors_loop: mutable i64 = n_actors
            months_loop: mutable i64 = n_months
            threshold_loop: mutable i64 = min_active
            while a < actors_loop |total: i64 = 0, a: i64 = 0, presence_loop, months_loop, threshold_loop| -> total:
                active: i64 =
                    while m < months_loop |count: i64 = 0, m: i64 = months_loop - 12, a, presence_loop, months_loop| -> count:
                        count <- count + 1 if rh_presence_get(presence_loop, a, months_loop, m)
                        m <- m + 1
                total <- total + 1 if active >= threshold_loop
                a <- a + 1

        # Numerator for persistence.event_share: only qualifying events owned by
        # actors in the declared persistence cohort are included.
        def rh_persistent_event_count(actor: darray[i64]&, presence: darray[u8]&, n_actors: i64, n_months: i64, min_active: i64, min_span: i64, need_recent: bool) -> i64 can[Memory.Allocate, Abort.Panic]:
            actor_loop: mutable darray[i64]& = actor
            presence_loop: mutable darray[u8]& = presence
            actors_loop: mutable i64 = n_actors
            months_loop: mutable i64 = n_months
            min_active_loop: mutable i64 = min_active
            min_span_loop: mutable i64 = min_span
            recent_loop: mutable bool = need_recent
            while e < actor_loop.count |total: i64 = 0, e: usize = 0, actor_loop, presence_loop, actors_loop, months_loop, min_active_loop, min_span_loop, recent_loop| -> total:
                aid: i64 = actor_loop[e]
                active: i64 = rh_actor_active_months(presence_loop, aid, months_loop)
                span: i64 = rh_actor_span(presence_loop, aid, months_loop)
                recent: bool = rh_actor_recent(presence_loop, aid, months_loop)
                total <- total + 1 if rh_persistent(active, span, recent, min_active_loop, min_span_loop, recent_loop)
                e <- e + 1

        # Median observed actor tenure, measured from first to last qualifying
        # event in the retained stream. Windowed history is surfaced as partial
        # by the caller because the first observed event may not be first-ever.
        def rh_median_tenure_days(actor: darray[i64]&, inst: darray[i64]&, n_actors: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            spans: mutable darray[i64] = []
            while a < n_actors |a: i64 = 0, actor, inst, spans, n_actors|:
                first: mutable i64 = 9223372036854775807
                last: mutable i64 = 0
                while e < actor.count |e: usize = 0, actor, inst, a, first, last|:
                    if actor[e] == a:
                        if inst[e] < first:
                            first <- inst[e]
                        if inst[e] > last:
                            last <- inst[e]
                    e <- e + 1
                if first != 9223372036854775807:
                    spans.push((last - first) / 86400)
                a <- a + 1
            return -1 if spans.count == 0
            while i < spans.count |i: usize = 1, spans|:
                value: i64 = spans[i]
                j: usize = i
                while j > 0 and spans[j - 1] > value |j: usize = i, value, spans|:
                    spans[j] <- spans[j - 1]
                    j <- j - 1
                spans[j] <- value
                i <- i + 1
            middle: usize = spans.count / 2
            if spans.count % 2 == 0:
                (spans[middle - 1] + spans[middle]) / 2
            else:
                spans[middle]

        # Continuity concern: NOT about one-off ratios. A project is flagged only
        # when fewer than `min_persistent` actors meet the persistence cohort
        # rule; a high one-off ratio with a stable core is explicitly not a
        # concern (fixture A vs B).
        def rh_concern(persistent_actors: i64, min_persistent: i64) -> bool:
            return false if min_persistent <= 0
            persistent_actors < min_persistent

        # Per-actor event counts in [from_idx, to_idx), optionally filtered by
        # kind (-1 = all kinds). out is filled with n_actors zeros then counted.
        def rh_actor_counts(actor: darray[i64]&, kind: darray[u8]&, kind_filter: i64, from_idx: i64, to_idx: i64, n_actors: i64, out: mutable darray[u64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if n_actors < 0
            while i < n_actors |i: i64 = 0, out|:
                out.push(0)
                i <- i + 1
            lo: i64 = from_idx if from_idx > 0 else 0
            hi: i64 = to_idx if to_idx < actor.count.i64() else actor.count.i64()
            while e < hi |e: i64 = lo, actor, kind, kind_filter, n_actors, out, hi|:
                a: i64 = actor[e.usize()]
                k: u8 = kind[e.usize()]
                e <- e + 1
                continue if kind_filter >= 0 and k.i64() != kind_filter
                continue if a < 0 or a >= n_actors
                out[a.usize()] <- out[a.usize()] + 1
            while j < n_actors |total: i64 = 0, j: i64 = 0, out| -> total:
                total <- total + out[j.usize()].i64()
                j <- j + 1

        # Effective actor count = reciprocal of HHI, exact rational den/num
        # reduced. False when the population is empty (not_applicable) or on
        # overflow (bounded error) — never a fabricated number.
        def rh_effective_count(counts: darray[u64]&, num_out: mutable u64&, den_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
            hn: mutable u64 = 0
            hd: mutable u64 = 0
            return false if not Metrics::rh_hhi(counts, &hn, &hd)
            return false if hn == 0
            g: u64 = rh_continuity_gcd(hd, hn)
            num_out[0] <- hd / g
            den_out[0] <- hn / g
            true

        # The 50% absence factor and 80% concentration over one actor-count
        # population, returning the shared Metrics::rh_concentration contract (k>=1,
        # -1 not_applicable, -2 bad threshold, -3 overflow).
        def rh_absence_factor_50(counts: mutable darray[u64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Metrics::rh_concentration(counts, 1, 2)

        def rh_concentration_80(counts: mutable darray[u64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Metrics::rh_concentration(counts, 4, 5)

        # Retention per actor (plan §19.3). t0 is the first observed qualifying
        # event instant under the selected history policy; the return interval is
        # [t0 + start_days, t0 + end_days). Censoring beats unobservability
        # because it needs no extra data to decide.
        def rh_retention_status(t0: i64, start_days: i64, end_days: i64, cutoff: i64, coverage_start: i64, coverage_end: i64, has_return_event: bool) -> i64:
            w_start: i64 = t0 + start_days * 86400
            w_end: i64 = t0 + end_days * 86400
            return RH_RET_CENSORED if w_end > cutoff
            return RH_RET_UNOBSERVABLE if coverage_start > w_start
            return RH_RET_UNOBSERVABLE if coverage_end < w_end
            return RH_RET_RETAINED if has_return_event
            RH_RET_NOT_RETAINED

        # Coverage basis for a continuity result (R029/R002). Distinguishes a
        # full-history observation from one that is limited by how the source was
        # collected:
        #   1 full     — complete history, non-shallow: activity changes are real.
        #   2 windowed — only the last N days were collected: earlier absence is
        #                unknown-start, not inactivity, so a "quiet" month before
        #                the window must never be read as a change in activity.
        #   3 shallow  — a shallow clone: depth is unknown, so counts are a lower
        #                bound; retention/first-seen are unsupported.
        # A coverage-limited result is never presented as an activity decline.
        def rh_coverage_basis(full_history: bool, shallow: bool) -> u8:
            return 3 if shallow
            return 1 if full_history
            2

        def rh_coverage_basis_label(basis: u8) -> u8&:
            return "full" if basis == 1
            return "windowed" if basis == 2
            "shallow"

        # Coverage change vs activity change: given the coverage basis and whether a
        # qualifying event was observed in the period, returns:
        #   1 observed-activity      (full basis + event: a real observation)
        #   0 observed-quiet         (full basis + no event: a real quiet period)
        #  -1 coverage-limited       (limited basis: absence is NOT activity evidence)
        # This is the mechanical form of R029: a coverage gap must never be reported
        # as an activity change.
        def rh_coverage_vs_activity(basis: u8, event_observed: bool) -> i64:
            return -1 if basis != 1
            return 1 if event_observed
            0

        # Monotonic count of retained actors over a per-actor status array.
        def rh_retention_tally(status: darray[i64]&, retained_out: mutable i64&, eligible_out: mutable i64&, censored_out: mutable i64&, unobservable_out: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            retained_out[0] <- 0
            eligible_out[0] <- 0
            censored_out[0] <- 0
            unobservable_out[0] <- 0
            while i < status.count |i: usize = 0, status, retained_out, eligible_out, censored_out, unobservable_out|:
                s: i64 = status[i]
                i <- i + 1
                if s == RH_RET_RETAINED:
                    retained_out[0] <- retained_out[0] + 1
                    eligible_out[0] <- eligible_out[0] + 1
                if s == RH_RET_NOT_RETAINED:
                    eligible_out[0] <- eligible_out[0] + 1
                if s == RH_RET_CENSORED:
                    censored_out[0] <- censored_out[0] + 1
                if s == RH_RET_UNOBSERVABLE:
                    unobservable_out[0] <- unobservable_out[0] + 1
            return

        # Primary actor by event count (deterministic: highest count, lowest
        # actor id breaks ties). -1 for an empty population.
        def rh_primary_actor(counts: darray[u64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < counts.count.i64() |best: i64 = -1, best_count: u64 = 0, i: i64 = 0| -> best:
                c: u64 = counts[i.usize()]
                if c > best_count:
                    best_count <- c
                    best <- i
                i <- i + 1

        # Months in which BOTH actors are present (handover overlap measure).
        def rh_overlap_months(presence: darray[u8]&, a: i64, b: i64, n_months: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while m < n_months |total: i64 = 0, m: i64 = 0| -> total:
                if rh_presence_get(presence, a, n_months, m) and rh_presence_get(presence, b, n_months, m):
                    total <- total + 1
                m <- m + 1

        # Top-1 share: the largest single actor's share of the qualifying event
        # population, as an exact rational (num = top count, den = total). Zero-total
        # is not_applicable (-1), never 0 (unknown != zero). Ties resolve
        # deterministically to the lowest actor id (same rule as rh_primary_actor),
        # but the COUNT is identical for any tied maximum.
        def rh_top1_share(counts: mutable darray[u64]&, num_out: mutable u64&, den_out: mutable u64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            num_out[0] <- 0
            den_out[0] <- 0
            total, top =
                while i < counts.count.i64() |total: u64 = 0, top: u64 = 0, i: i64 = 0, counts| -> total, top:
                    c: u64 = counts[i.usize()]
                    total <- total + c
                    if c > top:
                        top <- c
                    i <- i + 1
            return -1 if total == 0
            num_out[0] <- top
            den_out[0] <- total
            1

        # Exact top-k share over the same attributed event population. The small
        # fixed insertion set keeps this allocation-free and deterministic; k is
        # bounded to five because these catalog metrics are top-three and top-five
        # shares. Zero totals remain not_applicable rather than false zero shares.
        def rh_topk_share(counts: darray[u64]&, k: i64, num_out: mutable u64&, den_out: mutable u64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            num_out[0] <- 0
            den_out[0] <- 0
            return -2 if k <= 0 or k > 5
            top1: mutable u64 = 0
            top2: mutable u64 = 0
            top3: mutable u64 = 0
            top4: mutable u64 = 0
            top5: mutable u64 = 0
            total: mutable u64 = 0
            while i < counts.count.i64() |i: i64 = 0, counts, k, top1, top2, top3, top4, top5, total|:
                c: u64 = counts[i.usize()]
                total <- total + c
                if c > top1:
                    top5 <- top4
                    top4 <- top3
                    top3 <- top2
                    top2 <- top1
                    top1 <- c
                elif c > top2:
                    top5 <- top4
                    top4 <- top3
                    top3 <- top2
                    top2 <- c
                elif c > top3:
                    top5 <- top4
                    top4 <- top3
                    top3 <- c
                elif c > top4:
                    top5 <- top4
                    top4 <- c
                elif c > top5:
                    top5 <- c
                i <- i + 1
            return -1 if total == 0
            selected: mutable u64 = top1 + top2 if k == 2 else top1
            selected <- top1 + top2 + top3 if k == 3
            selected <- top1 + top2 + top3 + top4 if k == 4
            selected <- top1 + top2 + top3 + top4 + top5 if k == 5
            num_out[0] <- selected
            den_out[0] <- total
            1


        # Role visibility: a maintainer who reviews consistently but authors few
        # commits must remain visible through role-specific events. This is a
        # boolean statement about evidence shapes, not a score.
        def rh_role_visible(commit_count: i64, review_count: i64, min_reviews: i64) -> bool:
            return true if review_count >= min_reviews
            return true if commit_count >= min_reviews
            false

        # Publish continuity metric observations (M00-04/M09):
        #   persistence.retained_90d                      ratio retained/eligible
        #   concentration.change_hhi                      exact HHI over commit events
        #   concentration.change_effective_actor_count    exact reciprocal of HHI
        #   concentration.change_absence_factor_50        actors for >=50% share
        # first_seen_supported=false -> `unsupported` (a windowed or shallow scan
        # cannot establish an actor's first observation). An empty/zero denominator
        # is `not_applicable`, never 0 (unknown != zero). Censored/unobservable and
        # the raw concentration components are reported alongside so every
        # denominator can be audited. Raw emails never appear here.
        def rh_continuity_metrics_write(out: mutable darray[u8]&, identity_rev: i64, actors_total: i64, persistent: i64, active3: i64, active6: i64, active9: i64, event_share_num: i64, event_share_den: i64, tenure_days: i64, retained: i64, eligible: i64, censored: i64, unobservable: i64, retained_365: i64, eligible_365: i64, censored_365: i64, unobservable_365: i64, first_seen_supported: bool, hhi_n: u64, hhi_d: u64, eff_n: u64, eff_d: u64, fifty: i64, eighty: i64, top_n: u64, top_d: u64, top3_n: u64, top3_d: u64, top5_n: u64, top5_d: u64, gini_n: u64, gini_d: u64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-continuity-metrics/1\",\"identity_revision\":")
            Base::rh_push_decimal_i64(out, identity_rev)
            Base::rh_push_text(out, ",\"actors_total\":")
            Base::rh_push_decimal_i64(out, actors_total)
            Base::rh_push_text(out, ",\"metrics\":[{\"key\":\"persistence.retained_90d\",\"version\":\"1.0.0\",\"status\":\"")
            if not first_seen_supported:
                Base::rh_push_text(out, "unsupported\",\"reason\":\"windowed-or-shallow-history-cannot-establish-first-observation\"")
            elif eligible <= 0:
                Base::rh_push_text(out, "not_applicable\",\"reason\":\"no-eligible-complete-window\"")
            else:
                Base::rh_push_text(out, "observed\",\"value\":{\"num\":")
                Base::rh_push_decimal_i64(out, retained)
                Base::rh_push_text(out, ",\"den\":")
                Base::rh_push_decimal_i64(out, eligible)
                Base::rh_push_text(out, "}")
            Base::rh_push_text(out, ",\"evidence\":[\"evidence/git-log.bin\"]},")
            Base::rh_push_text(out, "{\"key\":\"persistence.retained_365d\",\"version\":\"1.0.0\",\"status\":\"")
            if not first_seen_supported:
                Base::rh_push_text(out, "unsupported\",\"reason\":\"windowed-or-shallow-history-cannot-establish-first-observation\"")
            elif eligible_365 <= 0:
                Base::rh_push_text(out, "not_applicable\",\"reason\":\"no-eligible-complete-window\"")
            else:
                Base::rh_push_text(out, "observed\",\"value\":{\"num\":")
                Base::rh_push_decimal_i64(out, retained_365)
                Base::rh_push_text(out, ",\"den\":")
                Base::rh_push_decimal_i64(out, eligible_365)
                Base::rh_push_text(out, "}")
            Base::rh_push_text(out, ",\"evidence\":[\"evidence/git-log.bin\"]},")
            Base::rh_push_text(out, "{\"key\":\"persistence.persistent_12m\",\"version\":\"1.0.0\",\"status\":\"")
            if actors_total <= 0:
                Base::rh_push_text(out, "not_applicable\",\"reason\":\"no-actors\"")
            elif not first_seen_supported:
                Base::rh_push_text(out, "partial\",\"value\":")
                Base::rh_push_decimal_i64(out, persistent)
            else:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, persistent)
            Base::rh_push_text(out, ",\"evidence\":[\"evidence/git-log.bin\"]},")
            Base::rh_push_text(out, "{\"key\":\"persistence.retention_censored\",\"version\":\"1.0.0\",\"status\":\"")
            if actors_total <= 0:
                Base::rh_push_text(out, "not_applicable\",\"reason\":\"no-actors\"")
            else:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, censored)
            Base::rh_push_text(out, ",\"evidence\":[\"evidence/git-log.bin\"]},")
            Base::rh_push_text(out, "{\"key\":\"persistence.active_3_of_12_months\",\"version\":\"1.0.0\",\"status\":\"")
            if active3 < 0:
                Base::rh_push_text(out, "unsupported\",\"reason\":\"fewer-than-twelve-complete-months\"")
            else:
                Base::rh_push_text(out, "partial\",\"value\":") if not first_seen_supported else Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, active3)
            Base::rh_push_text(out, ",\"evidence\":[\"evidence/git-log.bin\"]},")
            Base::rh_push_text(out, "{\"key\":\"persistence.active_6_of_12_months\",\"version\":\"1.0.0\",\"status\":\"")
            if active6 < 0:
                Base::rh_push_text(out, "unsupported\",\"reason\":\"fewer-than-twelve-complete-months\"")
            else:
                Base::rh_push_text(out, "partial\",\"value\":") if not first_seen_supported else Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, active6)
            Base::rh_push_text(out, ",\"evidence\":[\"evidence/git-log.bin\"]},")
            Base::rh_push_text(out, "{\"key\":\"persistence.active_9_of_12_months\",\"version\":\"1.0.0\",\"status\":\"")
            if active9 < 0:
                Base::rh_push_text(out, "unsupported\",\"reason\":\"fewer-than-twelve-complete-months\"")
            else:
                Base::rh_push_text(out, "partial\",\"value\":") if not first_seen_supported else Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, active9)
            Base::rh_push_text(out, ",\"evidence\":[\"evidence/git-log.bin\"]},")
            Base::rh_push_text(out, "{\"key\":\"persistence.persistent_event_share\",\"version\":\"1.0.0\",\"status\":\"")
            if event_share_den <= 0:
                Base::rh_push_text(out, "not_applicable\",\"reason\":\"no-qualifying-events\"")
            else:
                Base::rh_push_text(out, "partial\",\"value\":{\"num\":") if not first_seen_supported else Base::rh_push_text(out, "observed\",\"value\":{\"num\":")
                Base::rh_push_decimal_i64(out, event_share_num)
                Base::rh_push_text(out, ",\"den\":")
                Base::rh_push_decimal_i64(out, event_share_den)
                Base::rh_push_text(out, "}")
            Base::rh_push_text(out, ",\"evidence\":[\"evidence/git-log.bin\"]},")
