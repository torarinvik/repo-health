include "./rh_observation.elisa"
include "../../Elisa-compiler/elisacore_std/collections.elisa"

module Continuity:
    public:
        # rh_continuity.elisa — persistence cohorts, retention censoring,
        # concentration inputs, transitions, role visibility (M04-05/06/07/08).
        #
        # Exact populations only: presence is built from qualifying events over
        # COMPLETE calendar months (the caller passes a month range that already
        # excludes the current partial month; see Temporal::rh_complete_months_between).
        # One day with three commits is one active month, never three. Cohorts
        # return their components (active months, span, recency) alongside
        # membership so a reader can inspect the rule rather than trust a label.
        # Empty populations return not_applicable (-1) for ratios and counts
        # whose semantics require events — never a synthetic zero.

        const RH_EV_COMMIT: u8 = 0
        const RH_EV_RELEASE: u8 = 1
        const RH_EV_REVIEW: u8 = 2

        const RH_RET_RETAINED: i64 = 0
        const RH_RET_NOT_RETAINED: i64 = 1
        const RH_RET_CENSORED: i64 = 2
        const RH_RET_UNOBSERVABLE: i64 = 3
        const RH_RET_INVALID: i64 = -1

        # Local arithmetic helper. Metrics::rh_gcd remains private to its module;
        # continuity owns this small reduction operation for its effective-count
        # projection instead of reaching through a private implementation detail.
        # Actor-by-month presence matrix, row-major actor*n_months + month.
        # Output buffers must be empty on entry; reject reuse rather than mix
        # prior values into a newly computed population.
        def rh_presence_build(actor: darray[i64]&, month: darray[i64]&, kind: darray[u8]&, kind_filter: i64, n_actors: i64, month_lo: i64, n_months: i64, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if n_actors < 0 or n_months < 0
            return -1 if actor.count != month.count or actor.count != kind.count
            return -1 if out.count != 0
            return -1 if n_actors > 0 and n_months > 9223372036854775807 / n_actors
            total: i64 = n_actors * n_months
            while i < total |i: i64 = 0, out|:
                out.push(0)
                i <- i + 1
            while e < actor.count |used: i64 = 0, e: usize = 0, out| -> used:
                a: i64 = actor[e]
                m: i64 = month[e]
                k: u8 = kind[e]
                e <- e + 1
                continue if kind_filter >= 0 and k.i64() != kind_filter
                continue if a < 0 or a >= n_actors
                # A nonnegative delta that cannot fit in i64 is necessarily
                # outside this (i64-sized) requested month window.
                continue if month_lo < 0 and m > 9223372036854775807 + month_lo
                idx: i64 = m - month_lo
                continue if idx < 0 or idx >= n_months
                slot: i64 = a * n_months + idx
                if out[slot.usize()] == 0:
                    out[slot.usize()] <- 1
                    used <- used + 1

        def rh_actor_active_months(presence: darray[u8]&, actor: i64, n_months: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while m < n_months |total: i64 = 0, m: i64 = 0| -> total:
                if rh_presence_get(presence, actor, n_months, m):
                    total <- total + 1
                m <- m + 1

        # First-to-last active span in months, inclusive. 0 when never active.
        def rh_actor_span(presence: darray[u8]&, actor: i64, n_months: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            first, last =
                while m < n_months |first: i64 = -1, last: i64 = -1, m: i64 = 0| -> first, last:
                    if rh_presence_get(presence, actor, n_months, m):
                        if first < 0:
                            first <- m
                        last <- m
                    m <- m + 1
            return 0 if first < 0
            last - first + 1

        def rh_actor_recent(presence: darray[u8]&, actor: i64, n_months: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_presence_get(presence, actor, n_months, n_months - 1)

        # Persistence cohort membership. Components stay separately available to
        # callers (active months, span, recency) so explanations can show the
        # rule's parts, not just the verdict.
        def rh_persistent(active_months: i64, span: i64, recent: bool, min_active: i64, min_span: i64, need_recent: bool) -> bool:
            return false if active_months < min_active
            return false if span < min_span
            return false if need_recent and not recent
            true

        # Count members of the persistence cohort.
        def rh_persistent_count(presence: darray[u8]&, n_actors: i64, n_months: i64, min_active: i64, min_span: i64, need_recent: bool) -> i64 can[Memory.Allocate, Abort.Panic]:
            while a < n_actors |total: i64 = 0, a: i64 = 0| -> total:
                active: i64 = rh_actor_active_months(presence, a, n_months)
                span: i64 = rh_actor_span(presence, a, n_months)
                recent: bool = rh_actor_recent(presence, a, n_months)
                if rh_persistent(active, span, recent, min_active, min_span, need_recent):
                    total <- total + 1
                a <- a + 1

        # Count actors meeting the explicit trailing twenty-four-month
        # persistence profile. The profile requires twelve active months over a
        # twelve-month span and activity in the latest complete month. A short
        # complete history is unsupported rather than a quiet zero.
        def rh_persistent_24_count(presence: darray[u8]&, n_actors: i64, n_months: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if n_months < 24
            count: i64 =
                presence_loop: mutable darray[u8]& = presence
                actors_loop: mutable i64 = n_actors
                months_loop: mutable i64 = n_months
                start_loop: mutable i64 = n_months - 24
                while a < actors_loop |total: i64 = 0, a: i64 = 0, presence_loop, actors_loop, months_loop, start_loop| -> total:
                    active: mutable i64 = 0
                    first: mutable i64 = -1
                    last: mutable i64 = -1
                    while m < months_loop |m: i64 = start_loop, a, presence_loop, months_loop, active, first, last|:
                        if rh_presence_get(presence_loop, a, months_loop, m):
                            active <- active + 1
                            first <- m if first < 0
                            last <- m
                        m <- m + 1
                    total <- total + 1 if active >= 12 and last - first + 1 >= 12 and rh_presence_get(presence_loop, a, months_loop, months_loop - 1)
                    a <- a + 1
            count

        # Count actors meeting an activity threshold over the trailing twelve
        # complete months. Fewer than twelve complete months is unsupported;
        # observed quietness must not be promoted to a lifetime claim.
        def rh_active_threshold_count(presence: darray[u8]&, n_actors: i64, n_months: i64, min_active: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if n_months < 12
            count: i64 =
                presence_loop: mutable darray[u8]& = presence
                actors_loop: mutable i64 = n_actors
                months_loop: mutable i64 = n_months
                threshold_loop: mutable i64 = min_active
                while a < actors_loop |total: i64 = 0, a: i64 = 0, presence_loop, actors_loop, months_loop, threshold_loop| -> total:
                    active: i64 =
                        while m < months_loop |count: i64 = 0, m: i64 = months_loop - 12, a, presence_loop, months_loop| -> count:
                            count <- count + 1 if rh_presence_get(presence_loop, a, months_loop, m)
                            m <- m + 1
                    total <- total + 1 if active >= threshold_loop
                    a <- a + 1
            count

        # Numerator for persistence.event_share: only qualifying events owned by
        # actors in the declared persistence cohort are included.
        def rh_persistent_event_count(actor: darray[i64]&, presence: darray[u8]&, n_actors: i64, n_months: i64, min_active: i64, min_span: i64, need_recent: bool) -> i64 can[Memory.Allocate, Abort.Panic]:
            count: i64 =
                actor_loop: mutable darray[i64]& = actor
                presence_loop: mutable darray[u8]& = presence
                months_loop: mutable i64 = n_months
                min_active_loop: mutable i64 = min_active
                min_span_loop: mutable i64 = min_span
                recent_loop: mutable bool = need_recent
                while e < actor_loop.count |total: i64 = 0, e: usize = 0, actor_loop, presence_loop, months_loop, min_active_loop, min_span_loop, recent_loop| -> total:
                    aid: i64 = actor_loop[e]
                    active: i64 = rh_actor_active_months(presence_loop, aid, months_loop)
                    span: i64 = rh_actor_span(presence_loop, aid, months_loop)
                    recent: bool = rh_actor_recent(presence_loop, aid, months_loop)
                    total <- total + 1 if rh_persistent(active, span, recent, min_active_loop, min_span_loop, recent_loop)
                    e <- e + 1
            count

        # Median observed actor tenure, measured from first to last qualifying
        # event in the retained stream. Windowed history is surfaced as partial
        # by the caller because the first observed event may not be first-ever.
        def rh_median_tenure_days(actor: darray[i64]&, inst: darray[i64]&, n_actors: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if n_actors < 0 or actor.count != inst.count
            spans: mutable darray[i64] = []
            while a < n_actors |a: i64 = 0, actor, inst, spans, n_actors|:
                first: mutable i64 = 9223372036854775807
                last: mutable i64 = 0
                while e < actor.count |e: usize = 0, actor, inst, a, first, last|:
                    if actor[e] == a:
                        if inst[e] < first:
                            first <- inst[e]
                        if inst[e] > last:
                            last <- inst[e]
                    e <- e + 1
                if first != 9223372036854775807:
                    spans.push((last - first) / 86400)
                a <- a + 1
            return -1 if spans.count == 0
            while i < spans.count |i: usize = 1, spans|:
                value: i64 = spans[i]
                j: usize = i
                while j > 0 and spans[j - 1] > value |j: usize = i, value, spans|:
                    spans[j] <- spans[j - 1]
                    j <- j - 1
                spans[j] <- value
                i <- i + 1
            middle: usize = spans.count / 2
            if spans.count % 2 == 0:
                (spans[middle - 1] + spans[middle]) / 2
            else:
                spans[middle]

        # Continuity concern: NOT about one-off ratios. A project is flagged only
        # when fewer than `min_persistent` actors meet the persistence cohort
        # rule; a high one-off ratio with a stable core is explicitly not a
        # concern (fixture A vs B).
        def rh_concern(persistent_actors: i64, min_persistent: i64) -> bool:
            return false if min_persistent <= 0
            persistent_actors < min_persistent

        # Per-actor event counts in [from_idx, to_idx), optionally filtered by
        # kind (-1 = all kinds). Empty `out` is filled with n_actors zeros then
        # counted; nonempty buffers fail closed rather than blend populations.
        def rh_actor_counts(actor: darray[i64]&, kind: darray[u8]&, kind_filter: i64, from_idx: i64, to_idx: i64, n_actors: i64, out: mutable darray[u64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if n_actors < 0
            return -1 if actor.count != kind.count
            return -1 if out.count != 0
            while i < n_actors |i: i64 = 0, out|:
                out.push(0)
                i <- i + 1
            lo: i64 = from_idx if from_idx > 0 else 0
            hi: i64 = to_idx if to_idx < actor.count.i64() else actor.count.i64()
            while e < hi |e: i64 = lo, actor, kind, kind_filter, n_actors, out, hi|:
                a: i64 = actor[e.usize()]
                k: u8 = kind[e.usize()]
                e <- e + 1
                continue if kind_filter >= 0 and k.i64() != kind_filter
                continue if a < 0 or a >= n_actors
                out[a.usize()] <- out[a.usize()] + 1
            while j < n_actors |total: i64 = 0, j: i64 = 0, out| -> total:
                total <- total + out[j.usize()].i64()
                j <- j + 1

        # Effective actor count = reciprocal of HHI, exact rational den/num
        # reduced. False when the population is empty (not_applicable) or on
        # overflow (bounded error) — never a fabricated number.
        def rh_effective_count(counts: darray[u64]&, num_out: mutable u64&, den_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
            hn: mutable u64 = 0
            hd: mutable u64 = 0
            return false if not Metrics::rh_hhi(counts, &hn, &hd)
            return false if hn == 0
            g: u64 = rh_continuity_gcd(hd, hn)
            num_out[0] <- hd / g
            den_out[0] <- hn / g
            true

        # The 50% absence factor and 80% concentration over one actor-count
        # population, returning the shared Metrics::rh_concentration contract (k>=1,
        # -1 not_applicable, -2 bad threshold, -3 overflow).
        def rh_absence_factor_50(counts: mutable darray[u64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Metrics::rh_concentration(counts, 1, 2)

        def rh_concentration_80(counts: mutable darray[u64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Metrics::rh_concentration(counts, 4, 5)

        # Retention per actor (plan §19.3). t0 is the first observed qualifying
        # event instant under the selected history policy; the return interval is
        # [t0 + start_days, t0 + end_days). Censoring beats unobservability
        # because it needs no extra data to decide. Invalid times, reversed day
        # ranges, and unrepresentable window endpoints return RH_RET_INVALID.
        def rh_retention_window_bounds(t0: i64, start_days: i64, end_days: i64, start_out: mutable i64&, end_out: mutable i64&) -> bool:
            return false if t0 < 0 or start_days < 0 or end_days <= start_days
            return false if start_days > 9223372036854775807 / 86400 or end_days > 9223372036854775807 / 86400
            start_offset: i64 = start_days * 86400
            end_offset: i64 = end_days * 86400
            return false if t0 > 9223372036854775807 - start_offset or t0 > 9223372036854775807 - end_offset
            start_out[0] <- t0 + start_offset
            end_out[0] <- t0 + end_offset
            true

        def rh_retention_status(t0: i64, start_days: i64, end_days: i64, cutoff: i64, coverage_start: i64, coverage_end: i64, has_return_event: bool) -> i64:
            return RH_RET_INVALID if cutoff < 0 or coverage_start < 0 or coverage_end < coverage_start
            w_start: mutable i64 = 0
            w_end: mutable i64 = 0
            return RH_RET_INVALID if not rh_retention_window_bounds(t0, start_days, end_days, &w_start, &w_end)
            return RH_RET_CENSORED if w_end > cutoff
            return RH_RET_UNOBSERVABLE if coverage_start > w_start
            return RH_RET_UNOBSERVABLE if coverage_end < w_end
            return RH_RET_RETAINED if has_return_event
            RH_RET_NOT_RETAINED

    private:
        struct RhActorInstant:
            actor: i64
            instant: i64

        def rh_actor_instant_less(left: RhActorInstant, right: RhActorInstant) -> bool:
            return left.actor < right.actor if left.actor != right.actor
            left.instant < right.instant

    public:
        # Count actors with consecutive qualifying events separated by at least
        # the configured gap. Full-history callers provide the complete
        # intervening coverage required by the metric; windowed callers publish
        # unsupported instead of treating an unobserved interval as inactivity.
        # An actor is counted once, even if several qualifying gaps occur.
        def rh_returning_after_gap(actor: darray[i64]&, inst: darray[i64]&, n_actors: i64, gap_days: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if n_actors < 0 or gap_days <= 0
            return -1 if actor.count != inst.count or gap_days > 9223372036854775807 / 86400
            while i < inst.count |i: usize = 0, actor, inst, n_actors|:
                return -1 if inst[i] < 0 or actor[i] < 0 or actor[i] >= n_actors
                i <- i + 1
            count: i64 =
                gap_seconds: i64 = gap_days * 86400
                actor_loop: mutable darray[i64]& = actor
                inst_loop: mutable darray[i64]& = inst
                gap_loop: mutable i64 = gap_seconds
                actor_instants: mutable darray[RhActorInstant] = []
                while e < actor_loop.count |e: usize = 0, actor_loop, inst_loop, actor_instants|:
                    actor_instants.push(RhActorInstant{actor: actor_loop[e], instant: inst_loop[e]})
                    e <- e + 1
                sort[RhActorInstant](actor_instants, rh_actor_instant_less)
                last_counted_actor: mutable i64 = -1
                while index < actor_instants.count |returning: i64 = 0, index: usize = 1, actor_instants, gap_loop, last_counted_actor| -> returning:
                    previous: RhActorInstant = actor_instants[index - 1]
                    current: RhActorInstant = actor_instants[index]
                    if current.actor == previous.actor and current.instant - previous.instant >= gap_loop:
                        returning <- returning + 1 if current.actor != last_counted_actor
                        last_counted_actor <- current.actor
                    index <- index + 1
            count

        # Coverage basis for a continuity result (R029/R002). Distinguishes a
        # full-history observation from one that is limited by how the source was
        # collected:
        #   1 full     — complete history, non-shallow: activity changes are real.
        #   2 windowed — only the last N days were collected: earlier absence is
        #                unknown-start, not inactivity, so a "quiet" month before
        #                the window must never be read as a change in activity.
        #   3 shallow  — a shallow clone: depth is unknown, so counts are a lower
        #                bound; retention/first-seen are unsupported.
        # A coverage-limited result is never presented as an activity decline.
        def rh_coverage_basis(full_history: bool, shallow: bool) -> u8:
            return 3 if shallow
            return 1 if full_history
            2

        def rh_coverage_basis_label(basis: u8) -> u8&:
            return "full" if basis == 1
            return "windowed" if basis == 2
            "shallow"

        # Coverage change vs activity change: given the coverage basis and whether a
        # qualifying event was observed in the period, returns:
        #   1 observed-activity      (full basis + event: a real observation)
        #   0 observed-quiet         (full basis + no event: a real quiet period)
        #  -1 coverage-limited       (limited basis: absence is NOT activity evidence)
        # This is the mechanical form of R029: a coverage gap must never be reported
        # as an activity change.
        def rh_coverage_vs_activity(basis: u8, event_observed: bool) -> i64:
            return -1 if basis != 1
            return 1 if event_observed
            0

        # Monotonic count of retained actors over a per-actor status array.
        def rh_retention_tally(status: darray[i64]&, retained_out: mutable i64&, eligible_out: mutable i64&, censored_out: mutable i64&, unobservable_out: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            retained_out[0] <- 0
            eligible_out[0] <- 0
            censored_out[0] <- 0
            unobservable_out[0] <- 0
            while i < status.count |i: usize = 0, status, retained_out, eligible_out, censored_out, unobservable_out|:
                s: i64 = status[i]
                i <- i + 1
                if s == RH_RET_RETAINED:
                    retained_out[0] <- retained_out[0] + 1
                    eligible_out[0] <- eligible_out[0] + 1
                if s == RH_RET_NOT_RETAINED:
                    eligible_out[0] <- eligible_out[0] + 1
                if s == RH_RET_CENSORED:
                    censored_out[0] <- censored_out[0] + 1
                if s == RH_RET_UNOBSERVABLE:
                    unobservable_out[0] <- unobservable_out[0] + 1
            return

        # Primary actor by event count (deterministic: highest count, lowest
        # actor id breaks ties). -1 for an empty population.
        def rh_primary_actor(counts: darray[u64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < counts.count.i64() |best: i64 = -1, best_count: u64 = 0, i: i64 = 0| -> best:
                c: u64 = counts[i.usize()]
                if c > best_count:
                    best_count <- c
                    best <- i
                i <- i + 1

        # Months in which BOTH actors are present (handover overlap measure).
        def rh_overlap_months(presence: darray[u8]&, a: i64, b: i64, n_months: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while m < n_months |total: i64 = 0, m: i64 = 0| -> total:
                if rh_presence_get(presence, a, n_months, m) and rh_presence_get(presence, b, n_months, m):
                    total <- total + 1
                m <- m + 1

        # Top-1 share: the largest single actor's share of the qualifying event
        # population, as an exact rational (num = top count, den = total). Zero-total
        # is not_applicable (-1), never 0 (unknown != zero). Ties resolve
        # deterministically to the lowest actor id (same rule as rh_primary_actor),
        # but the COUNT is identical for any tied maximum.
        def rh_top1_share(counts: mutable darray[u64]&, num_out: mutable u64&, den_out: mutable u64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            num_out[0] <- 0
            den_out[0] <- 0
            total, top =
                while i < counts.count.i64() |total: u64 = 0, top: u64 = 0, i: i64 = 0, counts| -> total, top:
                    c: u64 = counts[i.usize()]
                    total <- total + c
                    if c > top:
                        top <- c
                    i <- i + 1
            return -1 if total == 0
            num_out[0] <- top
            den_out[0] <- total
            1

        # Exact top-k share over the same attributed event population. The small
        # fixed insertion set keeps this allocation-free and deterministic; k is
        # bounded to five because these catalog metrics are top-three and top-five
        # shares. Zero totals remain not_applicable rather than false zero shares.
        def rh_topk_share(counts: darray[u64]&, k: i64, num_out: mutable u64&, den_out: mutable u64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            num_out[0] <- 0
            den_out[0] <- 0
            return -2 if k <= 0 or k > 5
            top1: mutable u64 = 0
            top2: mutable u64 = 0
            top3: mutable u64 = 0
            top4: mutable u64 = 0
            top5: mutable u64 = 0
            total: mutable u64 = 0
            while i < counts.count.i64() |i: i64 = 0, counts, k, top1, top2, top3, top4, top5, total|:
                c: u64 = counts[i.usize()]
                total <- total + c
                if c > top1:
                    top5 <- top4
                    top4 <- top3
                    top3 <- top2
                    top2 <- top1
                    top1 <- c
                elif c > top2:
                    top5 <- top4
                    top4 <- top3
                    top3 <- top2
                    top2 <- c
                elif c > top3:
                    top5 <- top4
                    top4 <- top3
                    top3 <- c
                elif c > top4:
                    top5 <- top4
                    top4 <- c
                elif c > top5:
                    top5 <- c
                i <- i + 1
            return -1 if total == 0
            selected: mutable u64 = top1 + top2 if k == 2 else top1
            selected <- top1 + top2 + top3 if k == 3
            selected <- top1 + top2 + top3 + top4 if k == 4
            selected <- top1 + top2 + top3 + top4 + top5 if k == 5
            num_out[0] <- selected
            den_out[0] <- total
            1


        # Role visibility: a maintainer who reviews consistently but authors few
        # commits must remain visible through role-specific events. This is a
        # boolean statement about evidence shapes, not a score.
        def rh_role_visible(commit_count: i64, review_count: i64, min_reviews: i64) -> bool:
            return true if review_count >= min_reviews
            return true if commit_count >= min_reviews
            false

        # Publish continuity metric observations (M00-04/M09):
        #   persistence.retained_90d                      ratio retained/eligible
        #   concentration.change_hhi                      exact HHI over commit events
        #   concentration.change_effective_actor_count    exact reciprocal of HHI
        #   concentration.change_absence_factor_50        actors for >=50% share
        # first_seen_supported=false -> `unsupported` (a windowed or shallow scan
        # cannot establish an actor's first observation). An empty/zero denominator
        # is `not_applicable`, never 0 (unknown != zero). Censored/unobservable and
        # the raw concentration components are reported alongside so every
        # denominator can be audited. Raw emails never appear here.
    private:
        def rh_continuity_emit_observation(out: mutable darray[u8]&, key: cstr, value: Observation::RhMetricValue, status: u8, reason: cstr, extra_fields: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
            Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.GitLogBundleFile)
            quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{
                completeness: Observation::RhCompleteness.Complete if status == Observation::RH_ST_OBSERVED else Observation::RhCompleteness.Partial if status == Observation::RH_ST_PARTIAL else Observation::RhCompleteness.Unknown,
                freshness: Observation::RhFreshness.Unknown,
                validity: Observation::RhValidity.Valid if status == Observation::RH_ST_OBSERVED else Observation::RhValidity.Unknown,
                provenance: Observation::RhProvenanceQuality.EvidenceBacked
            }
            observation: Observation::RhObservation = Observation::rh_observation_make_with_evidence(status, value, status == Observation::RH_ST_PARTIAL, quality, evidence)
            emitted: bool = Observation::rh_observation_emit_metric(out, key, "1.0.0", reason, observation)
            if emitted and Base::rh_cstr_len_c(extra_fields) > 0:
                out.pop()
                Base::rh_push_text(out, extra_fields)
                out.push(125)
            emitted

        def rh_continuity_emit_count(out: mutable darray[u8]&, key: cstr, count: i64, status: u8, reason: cstr, extra_fields: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            has_value: bool = status == Observation::RH_ST_OBSERVED or status == Observation::RH_ST_PARTIAL
            return false if has_value and count < 0
            value: Observation::RhMetricValue = Observation::RhMetricValue.Count(count) if has_value else Observation::RhMetricValue.Absent
            rh_continuity_emit_observation(out, key, value, status, reason, extra_fields)

        def rh_continuity_emit_ratio(out: mutable darray[u8]&, key: cstr, numerator: i64, denominator: i64, status: u8, reason: cstr, bounded: bool) -> bool can[Memory.Allocate, Abort.Panic]:
            has_value: bool = status == Observation::RH_ST_OBSERVED or status == Observation::RH_ST_PARTIAL
            return false if has_value and (denominator <= 0 or numerator < 0 or bounded and numerator > denominator)
            value: Observation::RhMetricValue = Observation::RhMetricValue.Ratio(numerator, denominator) if has_value else Observation::RhMetricValue.Absent
            rh_continuity_emit_observation(out, key, value, status, reason, "")

        def rh_continuity_emit_u64_ratio(out: mutable darray[u8]&, key: cstr, numerator: u64, denominator: u64, bounded: bool) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if denominator == 0
            return false if numerator > 9223372036854775807 or denominator > 9223372036854775807
            rh_continuity_emit_ratio(out, key, numerator.i64(), denominator.i64(), Observation::RH_ST_OBSERVED, "", bounded)

        def rh_continuity_emit_u64_ratio_or_absent(out: mutable darray[u8]&, key: cstr, numerator: u64, denominator: u64, reason: cstr, bounded: bool) -> bool can[Memory.Allocate, Abort.Panic]:
            return rh_continuity_emit_observation(out, key, Observation::RhMetricValue.Absent, Observation::RH_ST_NOT_APPLICABLE, reason, "") if denominator == 0
            rh_continuity_emit_u64_ratio(out, key, numerator, denominator, bounded)

        def rh_continuity_emit_follow_up_count(out: mutable darray[u8]&, count: i64, status: u8, reason: cstr, has_follow_up: bool, observed_months: i64, requested_months: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            emitted: bool = rh_continuity_emit_count(out, "succession.successor_follow_up_active_months", count, status, reason, "")
            return false if not emitted
            if has_follow_up:
                out.pop()
                Base::rh_push_text(out, ",\"observed_months\":")
                Base::rh_push_decimal_i64(out, observed_months)
                Base::rh_push_text(out, ",\"requested_months\":")
                Base::rh_push_decimal_i64(out, requested_months)
                out.push(125)
            true

        def rh_continuity_emit_activity_change_count(out: mutable darray[u8]&, count: i64, status: u8, reason: cstr, eligible_month_pairs: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            emitted: bool = rh_continuity_emit_count(out, "succession.activity_primary_actor_changes", count, status, reason, "")
            return false if not emitted
            if status == Observation::RH_ST_OBSERVED:
                out.pop()
                Base::rh_push_text(out, ",\"eligible_month_pairs\":")
                Base::rh_push_decimal_i64(out, eligible_month_pairs)
                out.push(125)
            true

    public:
        # Publish the 23 continuity observations through the shared typed writer.
        # The exact window, denominator components, profiles, and evidence paths
        # remain part of rh-continuity-metrics/1 for existing consumers.
        def rh_continuity_metrics_write(out: mutable darray[u8]&, identity_rev: i64, observation_start: i64, observation_end: i64, actors_total: i64, persistent: i64, persistent_24: i64, active3: i64, active6: i64, active9: i64, event_share_num: i64, event_share_den: i64, tenure_days: i64, retained: i64, eligible: i64, censored: i64, unobservable: i64, retained_365: i64, eligible_365: i64, censored_365: i64, unobservable_365: i64, returning_after_gap: i64, first_seen_supported: bool, hhi_n: u64, hhi_d: u64, eff_n: u64, eff_d: u64, fifty: i64, eighty: i64, top_n: u64, top_d: u64, top3_n: u64, top3_d: u64, top5_n: u64, top5_d: u64, gini_n: u64, gini_d: u64) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-continuity-metrics/1\",\"identity_revision\":")
            Base::rh_push_decimal_i64(out, identity_rev)
            Base::rh_push_text(out, ",\"observation_window\":{\"start\":")
            Base::rh_push_decimal_i64(out, observation_start)
            Base::rh_push_text(out, ",\"end\":")
            Base::rh_push_decimal_i64(out, observation_end)
            Base::rh_push_text(out, "},\"actors_total\":")
            Base::rh_push_decimal_i64(out, actors_total)
            Base::rh_push_text(out, ",\"metrics\":[")
            metrics_ok: bool = |out|
                retained_90d_ok: bool = rh_continuity_emit_ratio(out, "persistence.retained_90d", retained, eligible, Observation::RH_ST_UNSUPPORTED if not first_seen_supported else Observation::RH_ST_NOT_APPLICABLE if eligible <= 0 else Observation::RH_ST_OBSERVED, "windowed-or-shallow-history-cannot-establish-first-observation" if not first_seen_supported else "no-eligible-complete-window" if eligible <= 0 else "", true)
                out.push(44) if retained_90d_ok
                retained_365d_ok: bool = retained_90d_ok and rh_continuity_emit_ratio(out, "persistence.retained_365d", retained_365, eligible_365, Observation::RH_ST_UNSUPPORTED if not first_seen_supported else Observation::RH_ST_NOT_APPLICABLE if eligible_365 <= 0 else Observation::RH_ST_OBSERVED, "windowed-or-shallow-history-cannot-establish-first-observation" if not first_seen_supported else "no-eligible-complete-window" if eligible_365 <= 0 else "", true)
                out.push(44) if retained_365d_ok
                returning_after_gap_ok: bool = retained_365d_ok and rh_continuity_emit_count(out, "persistence.returning_after_gap", returning_after_gap, Observation::RH_ST_UNSUPPORTED if not first_seen_supported else Observation::RH_ST_NOT_APPLICABLE if actors_total <= 0 else Observation::RH_ST_OBSERVED, "windowed-or-shallow-history-cannot-establish-complete-intervening-coverage" if not first_seen_supported else "no-actors" if actors_total <= 0 else "", ",\"gap_days\":90")
                out.push(44) if returning_after_gap_ok
                persistent_24m_ok: bool = returning_after_gap_ok and rh_continuity_emit_count(out, "persistence.persistent_24m", persistent_24, Observation::RH_ST_NOT_APPLICABLE if actors_total <= 0 else Observation::RH_ST_UNSUPPORTED if persistent_24 < 0 else Observation::RH_ST_PARTIAL if not first_seen_supported else Observation::RH_ST_OBSERVED, "no-actors" if actors_total <= 0 else "fewer-than-twenty-four-complete-months" if persistent_24 < 0 else "", ",\"profile\":{\"window_complete_months\":24,\"min_active_months\":12,\"min_span_months\":12,\"recent_required\":true}")
                out.push(44) if persistent_24m_ok
                persistent_12m_ok: bool = persistent_24m_ok and rh_continuity_emit_count(out, "persistence.persistent_12m", persistent, Observation::RH_ST_NOT_APPLICABLE if actors_total <= 0 else Observation::RH_ST_UNSUPPORTED if persistent < 0 else Observation::RH_ST_PARTIAL if not first_seen_supported else Observation::RH_ST_OBSERVED, "no-actors" if actors_total <= 0 else "fewer-than-six-complete-months" if persistent < 0 else "", ",\"profile\":{\"min_active_months\":6,\"min_span_months\":6,\"recent_required\":false}")
                out.push(44) if persistent_12m_ok
                retention_censored_ok: bool = persistent_12m_ok and rh_continuity_emit_count(out, "persistence.retention_censored", censored, Observation::RH_ST_NOT_APPLICABLE if actors_total <= 0 else Observation::RH_ST_OBSERVED, "no-actors" if actors_total <= 0 else "", "")
                out.push(44) if retention_censored_ok
                active_3_ok: bool = retention_censored_ok and rh_continuity_emit_count(out, "persistence.active_3_of_12_months", active3, Observation::RH_ST_UNSUPPORTED if active3 < 0 else Observation::RH_ST_PARTIAL if not first_seen_supported else Observation::RH_ST_OBSERVED, "fewer-than-twelve-complete-months" if active3 < 0 else "", "")
                out.push(44) if active_3_ok
                active_6_ok: bool = active_3_ok and rh_continuity_emit_count(out, "persistence.active_6_of_12_months", active6, Observation::RH_ST_UNSUPPORTED if active6 < 0 else Observation::RH_ST_PARTIAL if not first_seen_supported else Observation::RH_ST_OBSERVED, "fewer-than-twelve-complete-months" if active6 < 0 else "", "")
                out.push(44) if active_6_ok
                active_9_ok: bool = active_6_ok and rh_continuity_emit_count(out, "persistence.active_9_of_12_months", active9, Observation::RH_ST_UNSUPPORTED if active9 < 0 else Observation::RH_ST_PARTIAL if not first_seen_supported else Observation::RH_ST_OBSERVED, "fewer-than-twelve-complete-months" if active9 < 0 else "", "")
                out.push(44) if active_9_ok
                persistent_event_share_ok: bool = active_9_ok and rh_continuity_emit_ratio(out, "persistence.persistent_event_share", event_share_num, event_share_den, Observation::RH_ST_NOT_APPLICABLE if event_share_den <= 0 else Observation::RH_ST_PARTIAL if not first_seen_supported else Observation::RH_ST_OBSERVED, "no-qualifying-events" if event_share_den <= 0 else "", true)
                out.push(44) if persistent_event_share_ok
                tenure_ok: bool = persistent_event_share_ok and rh_continuity_emit_count(out, "persistence.median_observed_tenure_days", tenure_days, Observation::RH_ST_NOT_APPLICABLE if tenure_days < 0 else Observation::RH_ST_PARTIAL if not first_seen_supported else Observation::RH_ST_OBSERVED, "no-observed-actor-tenure" if tenure_days < 0 else "", "")
                out.push(44) if tenure_ok
                change_hhi_ok: bool = tenure_ok and rh_continuity_emit_u64_ratio_or_absent(out, "concentration.change_hhi", hhi_n, hhi_d, "no-qualifying-commit-events", true)
                out.push(44) if change_hhi_ok
                change_effective_ok: bool = change_hhi_ok and rh_continuity_emit_u64_ratio_or_absent(out, "concentration.change_effective_actor_count", eff_n, eff_d, "no-qualifying-commit-events", false)
                out.push(44) if change_effective_ok
                change_absence_ok: bool = change_effective_ok and rh_continuity_emit_count(out, "concentration.change_absence_factor_50", fifty, Observation::RH_ST_NOT_APPLICABLE if fifty < 0 else Observation::RH_ST_OBSERVED, "no-qualifying-commit-events" if fifty < 0 else "", "")
                out.push(44) if change_absence_ok
                change_top1_ok: bool = change_absence_ok and rh_continuity_emit_u64_ratio_or_absent(out, "concentration.change_top1_share", top_n, top_d, "no-qualifying-commit-events", true)
                out.push(44) if change_top1_ok
                change_gini_ok: bool = change_top1_ok and rh_continuity_emit_u64_ratio_or_absent(out, "concentration.change_gini", gini_n, gini_d, "fewer-than-two-nonzero-actors", true)
                out.push(44) if change_gini_ok
                top1_share_ok: bool = change_gini_ok and rh_continuity_emit_u64_ratio_or_absent(out, "concentration.top1_event_share", top_n, top_d, "no-qualifying-commit-events", true)
                out.push(44) if top1_share_ok
                top3_share_ok: bool = top1_share_ok and rh_continuity_emit_u64_ratio_or_absent(out, "concentration.top3_event_share", top3_n, top3_d, "no-qualifying-commit-events", true)
                out.push(44) if top3_share_ok
                top5_share_ok: bool = top3_share_ok and rh_continuity_emit_u64_ratio_or_absent(out, "concentration.top5_event_share", top5_n, top5_d, "no-qualifying-commit-events", true)
                out.push(44) if top5_share_ok
                hhi_ok: bool = top5_share_ok and rh_continuity_emit_u64_ratio_or_absent(out, "concentration.hhi", hhi_n, hhi_d, "no-qualifying-commit-events", true)
                out.push(44) if hhi_ok
                effective_ok: bool = hhi_ok and rh_continuity_emit_u64_ratio_or_absent(out, "concentration.effective_actor_count", eff_n, eff_d, "no-qualifying-commit-events", false)
                out.push(44) if effective_ok
                absence_50_ok: bool = effective_ok and rh_continuity_emit_count(out, "concentration.absence_factor_50", fifty, Observation::RH_ST_NOT_APPLICABLE if fifty < 0 else Observation::RH_ST_OBSERVED, "no-qualifying-commit-events" if fifty < 0 else "", "")
                out.push(44) if absence_50_ok
                absence_80_ok: bool = absence_50_ok and rh_continuity_emit_count(out, "concentration.actor_count_80", eighty, Observation::RH_ST_NOT_APPLICABLE if eighty < 0 else Observation::RH_ST_OBSERVED, "no-qualifying-commit-events" if eighty < 0 else "", "")
                absence_80_ok
            return false if not metrics_ok
            Base::rh_push_text(out, "],\"retention_components\":{\"retained\":")
            Base::rh_push_decimal_i64(out, retained)
            Base::rh_push_text(out, ",\"eligible\":")
            Base::rh_push_decimal_i64(out, eligible)
            Base::rh_push_text(out, ",\"censored\":")
            Base::rh_push_decimal_i64(out, censored)
            Base::rh_push_text(out, ",\"unobservable\":")
            Base::rh_push_decimal_i64(out, unobservable)
            Base::rh_push_text(out, ",\"first_seen_supported\":")
            rh_cpush_bool(out, first_seen_supported)
            Base::rh_push_text(out, "},\"retention_365d_components\":{\"retained\":")
            Base::rh_push_decimal_i64(out, retained_365)
            Base::rh_push_text(out, ",\"eligible\":")
            Base::rh_push_decimal_i64(out, eligible_365)
            Base::rh_push_text(out, ",\"censored\":")
            Base::rh_push_decimal_i64(out, censored_365)
            Base::rh_push_text(out, ",\"unobservable\":")
            Base::rh_push_decimal_i64(out, unobservable_365)
            Base::rh_push_text(out, ",\"first_seen_supported\":")
            rh_cpush_bool(out, first_seen_supported)
            Base::rh_push_text(out, "},\"concentration_components\":{\"hhi_num\":")
            Base::rh_push_decimal_u64(out, hhi_n)
            Base::rh_push_text(out, ",\"hhi_den\":")
            Base::rh_push_decimal_u64(out, hhi_d)
            Base::rh_push_text(out, ",\"effective_num\":")
            Base::rh_push_decimal_u64(out, eff_n)
            Base::rh_push_text(out, ",\"effective_den\":")
            Base::rh_push_decimal_u64(out, eff_d)
            Base::rh_push_text(out, ",\"absence_factor_50\":")
            Base::rh_push_decimal_i64(out, fifty)
            Base::rh_push_text(out, ",\"absence_factor_80\":")
            Base::rh_push_decimal_i64(out, eighty)
            Base::rh_push_text(out, "}}")
            true

        # Continuity report (rh-continuity/1). Every published number is paired
        # with the rule or denominator that produced it: cohort thresholds,
        # coverage months, identity revision, concentration components, retention
        # tallies, and per-event-type totals. Empty-population ratios serialize
        # as null, never 0 (unknown != zero).
        def rh_continuity_write_json(out: mutable darray[u8]&, window_lo: i64, months: i64, min_active: i64, min_span: i64, need_recent: bool, identity_rev: i64, actors_total: i64, persistent: i64, hhi_n: u64, hhi_d: u64, eff_n: u64, eff_d: u64, fifty: i64, eighty: i64, retained_n: i64, eligible_n: i64, censored_n: i64, unobservable_n: i64, commits: i64, releases: i64, reviews: i64, coverage_basis: u8) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-continuity/1\",\"window\":{\"first_month_index\":")
            Base::rh_push_decimal_i64(out, window_lo)
            Base::rh_push_text(out, ",\"complete_months\":")
            Base::rh_push_decimal_i64(out, months)
            Base::rh_push_text(out, "},\"coverage\":{\"basis\":\"")
            Base::rh_push_text(out, rh_coverage_basis_label(coverage_basis))
            Base::rh_push_text(out, "\",\"activity_change_claims_supported\":")
            rh_cpush_bool(out, coverage_basis == 1)
            Base::rh_push_text(out, ",\"first_observation_basis\":\"")
            Base::rh_push_text(out, "first-ever" if coverage_basis == 1 else "first-observed")
            Base::rh_push_text(out, "\"")
            Base::rh_push_text(out, ",\"note\":\"a coverage-limited basis (windowed/shallow) means absence is not activity evidence; a quiet period is only an observation when the basis is full\"},\"cohort_rule\":{\"min_active_months\":")
            Base::rh_push_decimal_i64(out, min_active)
            Base::rh_push_text(out, ",\"min_span_months\":")
            Base::rh_push_decimal_i64(out, min_span)
            Base::rh_push_text(out, ",\"recent_required\":")
            rh_cpush_bool(out, need_recent)
            Base::rh_push_text(out, "},\"identity_revision\":")
            Base::rh_push_decimal_i64(out, identity_rev)
            Base::rh_push_text(out, ",\"actor_identity_basis\":\"project-mailmap-author-email\"")
            Base::rh_push_text(out, ",\"coverage_months\":")
            Base::rh_push_decimal_i64(out, months)
            Base::rh_push_text(out, ",\"actors_total\":")
            Base::rh_push_decimal_i64(out, actors_total)
            Base::rh_push_text(out, ",\"persistent_actors\":")
            Base::rh_push_decimal_i64(out, persistent)
            Base::rh_push_text(out, ",\"concentration\":{\"hhi\":")
            if hhi_d == 0:
                Base::rh_push_text(out, "null")
            else:
                Base::rh_push_text(out, "{\"num\":")
                Base::rh_push_decimal_u64(out, hhi_n)
                Base::rh_push_text(out, ",\"den\":")
                Base::rh_push_decimal_u64(out, hhi_d)
                Base::rh_push_text(out, "}")
            Base::rh_push_text(out, ",\"effective\":")
            if eff_d == 0:
                Base::rh_push_text(out, "null")
            else:
                Base::rh_push_text(out, "{\"num\":")
                Base::rh_push_decimal_u64(out, eff_n)
                Base::rh_push_text(out, ",\"den\":")
                Base::rh_push_decimal_u64(out, eff_d)
                Base::rh_push_text(out, "}")
            Base::rh_push_text(out, ",\"fifty_percent_actor_count\":")
            if fifty < 0:
                Base::rh_push_text(out, "null")
            else:
                Base::rh_push_decimal_i64(out, fifty)
            Base::rh_push_text(out, ",\"eighty_percent_actor_count\":")
            if eighty < 0:
                Base::rh_push_text(out, "null")
            else:
                Base::rh_push_decimal_i64(out, eighty)
            Base::rh_push_text(out, "},\"retention\":{\"retained\":")
            Base::rh_push_decimal_i64(out, retained_n)
            Base::rh_push_text(out, ",\"eligible\":")
            Base::rh_push_decimal_i64(out, eligible_n)
            Base::rh_push_text(out, ",\"censored\":")
            Base::rh_push_decimal_i64(out, censored_n)
            Base::rh_push_text(out, ",\"unobservable\":")
            Base::rh_push_decimal_i64(out, unobservable_n)
            Base::rh_push_text(out, "},\"event_types\":{\"commit\":")
            Base::rh_push_decimal_i64(out, commits)
            Base::rh_push_text(out, ",\"release\":")
            Base::rh_push_decimal_i64(out, releases)
            Base::rh_push_text(out, ",\"review\":")
            Base::rh_push_decimal_i64(out, reviews)
            Base::rh_push_text(out, "}}")

        # Succession: months in which an explicit predecessor/successor pair are BOTH
        # active (`succession.handover_overlap_months`). This is published as its own
        # observation so the overlap of a *declared* handover is visible and never
        # conflated with an activity-derived primary change (no motive attribution,
        # R030). `predecessor`/`successor` are the actor indices of an explicit pair;
        # when the caller has no declared pair (either index < 0) the metric is
        # `not_applicable` — an absent declaration is not a claim of zero overlap.
        # A non-positive complete-month count is `not_applicable` too (no window,
        # nothing to measure). The count is a plain count (unit: count), not a ratio.
        def rh_succession_metrics_write(out: mutable darray[u8]&, presence: darray[u8]&, predecessor: i64, successor: i64, n_months: i64, handover_month: i64, follow_up_months: i64, activity_counts: darray[i64]&, activity_counts_present: bool) -> bool can[Memory.Allocate, Abort.Panic]:
            pair_valid: bool = predecessor >= 0 and successor >= 0 and predecessor != successor and n_months > 0
            overlap: mutable i64 = -1
            if pair_valid:
                overlap <- rh_overlap_months(presence, predecessor, successor, n_months)
            follow_start: i64 = handover_month + 1
            follow_observed_months: i64 =
                if handover_month >= 0 and follow_up_months > 0 and follow_start < n_months:
                    follow_up_months if follow_start + follow_up_months <= n_months else n_months - follow_start
                else:
                    0
            follow_presence: mutable darray[u8]& = presence
            follow_successor: mutable i64 = successor
            follow_month_count: mutable i64 = n_months
            follow_start_month: mutable i64 = follow_start
            follow_active_months: i64 =
                while m < follow_observed_months |active: i64 = 0, m: i64 = 0, follow_presence, follow_successor, follow_month_count, follow_start_month| -> active:
                    if rh_presence_get(follow_presence, follow_successor, follow_month_count, follow_start_month + m):
                        active <- active + 1
                    m <- m + 1
            follow_complete: bool = follow_up_months > 0 and follow_observed_months == follow_up_months
            activity_loop: mutable darray[i64]& = activity_counts
            activity_month_count: mutable i64 = n_months
            actor_count: i64 = activity_counts.count.i64() / n_months if n_months > 0 else 0
            activity_change_by_month: mutable darray[i64] = []
            activity_change_count: mutable i64 = 0
            eligible_month_pairs: mutable i64 = 0
            previous_primary_actor: mutable i64 = -1
            while month < activity_month_count and activity_counts_present |month: i64 = 0, activity_loop, activity_month_count, actor_count, activity_change_by_month, activity_change_count, eligible_month_pairs, previous_primary_actor|:
                best_actor: mutable i64 = -1
                best_count: mutable i64 = 0
                tied: mutable bool = false
                while actor < actor_count |actor: i64 = 0, month, activity_loop, activity_month_count, best_actor, best_count, tied|:
                    count: i64 = activity_loop[(actor * activity_month_count + month).usize()]
                    if count > best_count:
                        best_count <- count
                        best_actor <- actor
                        tied <- false
                    elif count == best_count and count > 0:
                        tied <- true
                    actor <- actor + 1
                primary_actor: i64 = -1 if best_count == 0 or tied else best_actor
                if month == 0 or previous_primary_actor < 0 or primary_actor < 0:
                    activity_change_by_month.push(-1)
                else:
                    eligible_month_pairs <- eligible_month_pairs + 1
                    if previous_primary_actor != primary_actor:
                        activity_change_count <- activity_change_count + 1
                        activity_change_by_month.push(1)
                    else:
                        activity_change_by_month.push(0)
                previous_primary_actor <- primary_actor
                month <- month + 1
            Base::rh_push_text(out, "{\"schema\":\"rh-continuity-metrics/1\",\"metric\":\"succession.handover_overlap_months\",\"version\":\"1.0.0\",\"status\":\"")
            if predecessor < 0 or successor < 0 or n_months <= 0:
                Base::rh_push_text(out, "not_applicable\",\"reason\":\"no-declared-predecessor-successor-pair\"")
            elif predecessor == successor:
                Base::rh_push_text(out, "not_applicable\",\"reason\":\"predecessor-and-successor-are-the-same-actor\"")
            else:
                Base::rh_push_text(out, "observed\",\"value\":")
                Base::rh_push_decimal_i64(out, overlap)
            Base::rh_push_text(out, ",\"pair\":{\"predecessor\":")
            Base::rh_push_decimal_i64(out, predecessor)
            Base::rh_push_text(out, ",\"successor\":")
            Base::rh_push_decimal_i64(out, successor)
            Base::rh_push_text(out, "},\"window_complete_months\":")
            Base::rh_push_decimal_i64(out, n_months)
            Base::rh_push_text(out, ",\"handover_month\":")
            if handover_month < 0:
                Base::rh_push_text(out, "null")
            else:
                Base::rh_push_decimal_i64(out, handover_month)
            Base::rh_push_text(out, ",\"follow_up\":{\"requested_months\":")
            if follow_up_months < 0:
                Base::rh_push_text(out, "null")
            else:
                Base::rh_push_decimal_i64(out, follow_up_months)
            Base::rh_push_text(out, ",\"observed_months\":")
            Base::rh_push_decimal_i64(out, follow_observed_months)
            Base::rh_push_text(out, ",\"successor_active_months\":")
            if predecessor < 0 or successor < 0 or handover_month < 0 or follow_up_months <= 0:
                Base::rh_push_text(out, "null")
            else:
                Base::rh_push_decimal_i64(out, follow_active_months)
            Base::rh_push_text(out, "},\"activity_primary_actor_change_by_month\":[")
            while activity_index < activity_change_by_month.count.i64() |activity_index: i64 = 0, activity_change_by_month, out|:
                Base::rh_push_text(out, ",") if activity_index > 0
                if activity_change_by_month[activity_index.usize()] < 0:
                    Base::rh_push_text(out, "null")
                elif activity_change_by_month[activity_index.usize()] == 0:
                    Base::rh_push_text(out, "false")
                else:
                    Base::rh_push_text(out, "true")
                activity_index <- activity_index + 1
            Base::rh_push_text(out, "],\"evidence\":[\"evidence/git-log.bin\"],\"note\":\"declared predecessor/successor overlap and successor activity after the explicit handover month; activity-derived primary actor is selected only for a unique positive monthly event-count maximum; ties and empty months are unknown; incomplete follow-up is censored; no motive attribution or causal transfer is inferred\",\"metrics\":[")
            pair_reason: cstr = "predecessor-and-successor-are-the-same-actor" if predecessor == successor and predecessor >= 0 else "no-declared-predecessor-successor-pair"
            pair_status: u8 = Observation::RH_ST_OBSERVED if pair_valid else Observation::RH_ST_NOT_APPLICABLE
            handover_ok: bool = rh_continuity_emit_count(out, "succession.handover_overlap_months", overlap, pair_status, pair_reason if not pair_valid else "", "")
            out.push(44) if handover_ok
            declared_ok: bool = handover_ok and rh_continuity_emit_count(out, "succession.declared_handovers", 1, pair_status, pair_reason if not pair_valid else "", "")
            out.push(44) if declared_ok
            overlap_ok: bool = declared_ok and rh_continuity_emit_count(out, "succession.observed_activity_overlap_months", overlap, pair_status, pair_reason if not pair_valid else "", "")
            out.push(44) if overlap_ok
            has_follow_up: bool = predecessor >= 0 and successor >= 0 and handover_month >= 0 and follow_up_months > 0
            follow_status: u8 = Observation::RH_ST_NOT_APPLICABLE if not has_follow_up else Observation::RH_ST_PARTIAL if not follow_complete else Observation::RH_ST_OBSERVED
            follow_reason: cstr = "no-explicit-handover-follow-up-window" if not has_follow_up else ""
            follow_ok: bool = overlap_ok and rh_continuity_emit_follow_up_count(out, follow_active_months, follow_status, follow_reason, has_follow_up, follow_observed_months, follow_up_months)
            out.push(44) if follow_ok
            activity_status: u8 = Observation::RH_ST_UNSUPPORTED if not activity_counts_present or activity_change_by_month.count == 0 else Observation::RH_ST_NOT_APPLICABLE if eligible_month_pairs == 0 else Observation::RH_ST_OBSERVED
            activity_reason: cstr = "monthly-event-count-matrix-not-supplied" if not activity_counts_present or activity_change_by_month.count == 0 else "no-adjacent-known-primary-actors" if eligible_month_pairs == 0 else ""
            activity_ok: bool = follow_ok and rh_continuity_emit_activity_change_count(out, activity_change_count, activity_status, activity_reason, eligible_month_pairs)
            return false if not activity_ok
            Base::rh_push_text(out, "]}")
            true

    private:
        def rh_continuity_gcd(a: u64, b: u64) -> u64:
            while y != 0 |x: u64 = a, y: u64 = b| -> x:
                r: u64 = x % y
                x <- y
                y <- r
        def rh_presence_get(presence: darray[u8]&, actor: i64, n_months: i64, month_idx: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if actor < 0 or n_months <= 0 or month_idx < 0 or month_idx >= n_months
            return false if actor > 9223372036854775807 / n_months
            slot: i64 = actor * n_months + month_idx
            return false if slot < 0 or slot >= presence.count.i64()
            presence[slot.usize()] != 0
        def rh_cpush_bool(out: mutable darray[u8]&, value: bool) -> void can[Memory.Allocate, Abort.Panic]:
            if value:
                Base::rh_push_text(out, "true")
            else:
                Base::rh_push_text(out, "false")
