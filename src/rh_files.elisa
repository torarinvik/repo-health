# rh_files.elisa — snapshot-local file classification for low-cost observations.
#
# The collector retains `git ls-tree -z` output as evidence.  This module only
# classifies exact, repository-root paths; it does not inspect file contents and
# therefore does not imply that documentation is accurate or that a license is
# legally sufficient.

include "./rh_base.elisa"

module Files:
    public:
        struct RhFileMetrics:
            readme: mutable i64
            contributing: mutable i64
            license: mutable i64
            installation: mutable i64
            api_reference: mutable i64
            governance: mutable i64
            code_ownership: mutable i64
            notice: mutable i64
            release_process: mutable i64
            succession_process: mutable i64
            license_files: mutable i64
            examples: mutable i64
            security_policy: mutable i64
            release_notes: mutable i64
            source_files: mutable i64
            ci_configuration: mutable i64
            test_files: mutable i64
            source_bytes: mutable i64

        def rh_file_metrics(files: darray[u8]&) -> RhFileMetrics can[Memory.Allocate, Abort.Panic]:
            paths: mutable darray[u8] = []
            source_bytes: i64 = Files::rh_normalize_snapshot(files, paths)
            license_files: mutable i64 = Files::rh_root_count(paths, 2)
            examples: mutable i64 = Files::rh_path_count(paths, "examples/")
            source_files: mutable i64 = Files::rh_source_file_count(paths)
            RhFileMetrics{
                readme: Files::rh_root_name(paths, 0),
                contributing: Files::rh_root_name(paths, 1),
                license: 1 if license_files > 0 else 0,
                installation: Files::rh_root_name(paths, 3),
                api_reference: Files::rh_root_name(paths, 4),
                governance: Files::rh_root_name(paths, 5),
                code_ownership: Files::rh_root_name(paths, 6),
                notice: Files::rh_root_name(paths, 7),
                release_process: Files::rh_root_name(paths, 8),
                succession_process: Files::rh_root_name(paths, 9),
                license_files: license_files,
                examples: examples,
                security_policy: Files::rh_root_name(paths, 10),
                release_notes: Files::rh_root_name(paths, 11),
                source_files: source_files,
                ci_configuration: Files::rh_ci_configuration_present(paths),
                test_files: Files::rh_test_file_count(paths),
                source_bytes: source_bytes,
            }

    private:
        def rh_normalize_snapshot(files: darray[u8]&, paths: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            source_bytes: mutable i64 = 0
            complete: mutable bool = true
            while start < files.count |start: usize = 0, files, paths, source_bytes, complete|:
                stop: i64 = Base::rh_find_byte(files, start, 0)
                finish: usize = stop.usize() if stop >= 0 else files.count
                tab: mutable i64 = -1
                while cursor < finish |cursor: usize = start, files, finish, tab|:
                    if files[cursor] == 9:
                        tab <- cursor.i64()
                        break
                    cursor <- cursor + 1
                path_start: usize = (tab + 1).usize() if tab >= 0 else start
                complete <- false if tab < 0
                if tab >= 0:
                    size_start: mutable usize = start
                    while cursor2 < tab.usize() |cursor2: usize = start, files, tab, size_start|:
                        size_start <- cursor2 + 1 if files[cursor2] == 32
                        cursor2 <- cursor2 + 1
                    size_ok: mutable i64 = 0
                    size: i64 = Base::rh_parse_i64(files, size_start, tab.usize(), &size_ok)
                    complete <- false if size_ok == 0 or size < 0
                    source_bytes <- source_bytes + size if size_ok == 1 and size >= 0 and Files::rh_source_suffix(files, path_start, finish)
                while copy < finish |copy: usize = path_start, files, paths, finish|:
                    paths.push(files[copy])
                    copy <- copy + 1
                paths.push(0)
                start <- finish + 1
            return -1 if not complete
            source_bytes

        # kind: 0 README, 1 CONTRIBUTING, 2 license declaration.
        def rh_root_name(files: darray[u8]&, kind: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 1 if Files::rh_root_count(files, kind) > 0 else 0

        def rh_root_count(files: darray[u8]&, kind: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            total: mutable i64 = 0
            while start < files.count |start: usize = 0, files, kind|:
                stop: i64 = Base::rh_find_byte(files, start, 0)
                finish: usize = stop.usize() if stop >= 0 else files.count
                if Files::rh_name_matches(files, start, finish, kind):
                    total <- total + 1
                start <- finish + 1
            total

        def rh_path_count(files: darray[u8]&, prefix: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            total: mutable i64 = 0
            width: usize = strlen(prefix)
            while start < files.count |start: usize = 0, files, prefix, width, total|:
                stop: i64 = Base::rh_find_byte(files, start, 0)
                finish: usize = stop.usize() if stop >= 0 else files.count
                if finish - start > width and Files::rh_prefix(files, start, finish, prefix):
                    total <- total + 1
                start <- finish + 1
            total

        def rh_source_file_count(files: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            total: mutable i64 = 0
            while start < files.count |start: usize = 0, files, total|:
                stop: i64 = Base::rh_find_byte(files, start, 0)
                finish: usize = stop.usize() if stop >= 0 else files.count
                total <- total + 1 if Files::rh_source_suffix(files, start, finish)
                start <- finish + 1
            total

        def rh_ci_configuration_present(files: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while start < files.count |start: usize = 0, files|:
                stop: i64 = Base::rh_find_byte(files, start, 0)
                finish: usize = stop.usize() if stop >= 0 else files.count
                return 1 if Files::rh_eq(files, start, finish, ".travis.yml") or Files::rh_eq(files, start, finish, ".gitlab-ci.yml") or Files::rh_eq(files, start, finish, "Jenkinsfile") or Files::rh_eq(files, start, finish, "azure-pipelines.yml") or Files::rh_eq(files, start, finish, "buildkite.yml") or (finish - start > 16 and Files::rh_prefix(files, start, finish, ".github/workflows/")) or (finish - start > 9 and Files::rh_prefix(files, start, finish, ".circleci/"))
                start <- finish + 1
            0

        def rh_test_file_count(files: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            total: mutable i64 = 0
            while start < files.count |start: usize = 0, files, total|:
                stop: i64 = Base::rh_find_byte(files, start, 0)
                finish: usize = stop.usize() if stop >= 0 else files.count
                total <- total + 1 if (finish - start > 6 and Files::rh_prefix(files, start, finish, "tests/")) or (finish - start > 5 and Files::rh_prefix(files, start, finish, "test/")) or (finish - start > 5 and Files::rh_prefix(files, start, finish, "spec/"))
                start <- finish + 1
            total

        def rh_name_matches(files: darray[u8]&, start: usize, finish: usize, kind: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if start >= finish
            slash: bool = sview_find_byte(string_view_slice(bytes_view(files), start.i64(), finish.i64()), 47) >= 0
            return false if slash and kind != 4 and kind != 6 and kind != 8 and kind != 9
            return Files::rh_eq(files, start, finish, "README") or Files::rh_eq(files, start, finish, "README.md") or Files::rh_eq(files, start, finish, "README.rst") or Files::rh_eq(files, start, finish, "README.txt") if kind == 0
            return Files::rh_eq(files, start, finish, "CONTRIBUTING") or Files::rh_eq(files, start, finish, "CONTRIBUTING.md") or Files::rh_eq(files, start, finish, "CONTRIBUTING.rst") or Files::rh_eq(files, start, finish, "CONTRIBUTING.txt") if kind == 1
            return Files::rh_eq(files, start, finish, "LICENSE") or Files::rh_eq(files, start, finish, "LICENSE.md") or Files::rh_eq(files, start, finish, "LICENSE.txt") or Files::rh_eq(files, start, finish, "COPYING") if kind == 2
            return Files::rh_eq(files, start, finish, "INSTALL") or Files::rh_eq(files, start, finish, "INSTALL.md") or Files::rh_eq(files, start, finish, "INSTALL.rst") or Files::rh_eq(files, start, finish, "BUILDING.md") if kind == 3
            return Files::rh_eq(files, start, finish, "API.md") or Files::rh_eq(files, start, finish, "API.rst") or Files::rh_eq(files, start, finish, "docs/API.md") or Files::rh_eq(files, start, finish, "docs/api.md") if kind == 4
            return Files::rh_eq(files, start, finish, "GOVERNANCE.md") or Files::rh_eq(files, start, finish, "GOVERNANCE.rst") or Files::rh_eq(files, start, finish, "CODE_OF_CONDUCT.md") if kind == 5
            return Files::rh_eq(files, start, finish, "CODEOWNERS") or Files::rh_eq(files, start, finish, ".github/CODEOWNERS") if kind == 6
            return Files::rh_eq(files, start, finish, "NOTICE") or Files::rh_eq(files, start, finish, "NOTICE.md") or Files::rh_eq(files, start, finish, "NOTICE.txt") if kind == 7
            return Files::rh_eq(files, start, finish, "RELEASE.md") or Files::rh_eq(files, start, finish, "RELEASING.md") or Files::rh_eq(files, start, finish, "docs/RELEASE.md") or Files::rh_eq(files, start, finish, "docs/RELEASING.md") if kind == 8
            return Files::rh_eq(files, start, finish, "SUCCESSION.md") or Files::rh_eq(files, start, finish, "HANDOVER.md") or Files::rh_eq(files, start, finish, "docs/SUCCESSION.md") or Files::rh_eq(files, start, finish, "docs/HANDOVER.md") if kind == 9
            return Files::rh_eq(files, start, finish, "SECURITY.md") or Files::rh_eq(files, start, finish, "SECURITY.txt") or Files::rh_eq(files, start, finish, "docs/SECURITY.md") if kind == 10
            Files::rh_eq(files, start, finish, "CHANGELOG.md") or Files::rh_eq(files, start, finish, "NEWS.md") or Files::rh_eq(files, start, finish, "RELEASE_NOTES.md") or Files::rh_eq(files, start, finish, "docs/RELEASE_NOTES.md")

        def rh_eq(files: darray[u8]&, start: usize, finish: usize, literal: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(files, start.i64(), finish.i64(), literal)

        def rh_prefix(files: darray[u8]&, start: usize, finish: usize, literal: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            width: usize = strlen(literal)
            return false if finish - start < width
            sview_starts_with(string_view_slice(bytes_view(files), start.i64(), finish.i64()), sview(literal, 0, width.i64()))

        def rh_source_suffix(files: darray[u8]&, start: usize, finish: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return Files::rh_suffix(files, start, finish, ".c") or Files::rh_suffix(files, start, finish, ".cc") or Files::rh_suffix(files, start, finish, ".cpp") or Files::rh_suffix(files, start, finish, ".h") or Files::rh_suffix(files, start, finish, ".hpp") or Files::rh_suffix(files, start, finish, ".rs") or Files::rh_suffix(files, start, finish, ".go") or Files::rh_suffix(files, start, finish, ".py") or Files::rh_suffix(files, start, finish, ".js") or Files::rh_suffix(files, start, finish, ".ts") or Files::rh_suffix(files, start, finish, ".java") or Files::rh_suffix(files, start, finish, ".kt") or Files::rh_suffix(files, start, finish, ".swift") or Files::rh_suffix(files, start, finish, ".elisa")

        def rh_suffix(files: darray[u8]&, start: usize, finish: usize, literal: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            width: usize = strlen(literal)
            return false if finish - start < width
            Files::rh_eq(files, finish - width, finish, literal)
