# rh_adoption.elisa — staged dependency adoption evidence (M05-07).
#
# Exposes first-seen, confirmed introduction/removal, and censored duration
# semantics already owned by rh_downstream. Missing or null times stay
# unknown; an observed newer version never becomes a migration claim.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_downstream.elisa"

module Adoption:
    private:
        def rh_adoption_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_obj_get(nodes, texts, obj, key)

        def rh_adoption_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        def rh_adoption_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Adoption::rh_adoption_get(nodes, texts, obj, key)
            Json::rh_json_int(nodes, raw, idx, ok_out)

        def rh_adoption_optional(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, value_out: mutable i64&, present_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Adoption::rh_adoption_get(nodes, texts, obj, key)
            return false if idx < 0
            if nodes[idx.usize()].kind == Json::RH_JSON_NULL:
                value_out[0] <- 0
                present_out[0] <- 0
                return true
            ok: mutable i64 = 0
            value: i64 = Json::rh_json_int(nodes, raw, idx, &ok)
            return false if ok == 0 or value < 0
            value_out[0] <- value
            present_out[0] <- 1
            true

        def rh_adoption_optional_field(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, value_out: mutable i64&, present_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Adoption::rh_adoption_get(nodes, texts, obj, key)
            if idx < 0:
                value_out[0] <- 0
                present_out[0] <- 0
                return true
            if nodes[idx.usize()].kind == Json::RH_JSON_NULL:
                value_out[0] <- 0
                present_out[0] <- 0
                return true
            ok: mutable i64 = 0
            value: i64 = Json::rh_json_int(nodes, raw, idx, &ok)
            return false if ok == 0 or value < 0
            value_out[0] <- value
            present_out[0] <- 1
            true

        def rh_adoption_metric(out: mutable darray[u8]&, key: u8&, value: i64, population_count: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, ",{\"key\":\"")
            Base::rh_push_text(out, key)
            Base::rh_push_text(out, "\",\"version\":\"1.0.0\",\"status\":\"")
            Base::rh_push_text(out, "observed\",\"value\":") if population_count > 0 else Base::rh_push_text(out, "not_applicable\",\"value\":null")
            Base::rh_push_decimal_i64(out, value) if population_count > 0
            Base::rh_push_text(out, ",\"evidence\":[\"adoption-input\"]}")

        def rh_adoption_ratio_metric(out: mutable darray[u8]&, numerator: i64, denominator: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, ",{\"key\":\"downstream_condition.supported_version_adoption_share\",\"version\":\"1.0.0\",\"status\":\"")
            if denominator > 0:
                Base::rh_push_text(out, "observed\",\"value\":{\"num\":")
                Base::rh_push_decimal_i64(out, numerator)
                Base::rh_push_text(out, ",\"den\":")
                Base::rh_push_decimal_i64(out, denominator)
                Base::rh_push_text(out, "}")
            else:
                Base::rh_push_text(out, "not_applicable\",\"value\":null")
            Base::rh_push_text(out, ",\"evidence\":[\"adoption-input\"]}")

        def rh_adoption_duration_bin(duration: i64) -> i64:
            return 0 if duration < 604800
            return 1 if duration < 2592000
            return 2 if duration < 7776000
            return 3 if duration < 31536000
            4

        def rh_adoption_duration_metric(out: mutable darray[u8]&, key: u8&, counts: darray[i64]&, population_count: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, ",{\"key\":\"")
            Base::rh_push_text(out, key)
            Base::rh_push_text(out, "\",\"version\":\"1.0.0\",\"status\":\"")
            Base::rh_push_text(out, "observed\",\"value\":{\"bucket_upper_seconds\":[604799,2591999,7775999,31535999,null],\"counts\":[") if population_count > 0 else Base::rh_push_text(out, "not_applicable\",\"value\":null")
            if population_count > 0:
                while i < counts.count |i: usize = 0, counts, out|:
                    Base::rh_push_text(out, ",") if i > 0
                    Base::rh_push_decimal_i64(out, counts[i])
                    i <- i + 1
                Base::rh_push_text(out, "]}")
            Base::rh_push_text(out, ",\"evidence\":[\"adoption-input\"]}")

    public:
        def rh_adoption_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_idx: i64 = Adoption::rh_adoption_get(nodes, texts, root, "schema")
            return -1 if schema_idx < 0 or nodes[schema_idx.usize()].kind != Json::RH_JSON_STR
            schema: Json::RhJsonNode = nodes[schema_idx.usize()]
            return -1 if not Adoption::rh_adoption_eq(texts, schema.text_start, schema.text_end, "rh-adoption-input/1")
            cutoff_ok: mutable i64 = 0
            cutoff: mutable i64 = Adoption::rh_adoption_int(nodes, raw, texts, root, "cutoff", &cutoff_ok)
            return -1 if cutoff_ok == 0 or cutoff < 0
            raw_loop: mutable darray[u8]& = raw
            arr_idx: i64 = Adoption::rh_adoption_get(nodes, texts, root, "adoptions")
            return -1 if arr_idx < 0 or nodes[arr_idx.usize()].kind != Json::RH_JSON_ARR
            body, adoption_count, unknown, first_seen_only, confirmed_intro, confirmed_removal, version_comparisons, observed_upgrades, supported_line_assessments, supported_line_adoptions, duration_confirmed, duration_censored, duration_unknown, confirmed_duration_bins, censored_duration_bins =
                while child >= 0 |child: i64 = nodes[arr_idx.usize()].first_child, first_child: i64 = nodes[arr_idx.usize()].first_child, body: darray[u8] = [91], adoption_count: i64 = 0, unknown: i64 = 0, first_seen_only: i64 = 0, confirmed_intro: i64 = 0, confirmed_removal: i64 = 0, version_comparisons: i64 = 0, observed_upgrades: i64 = 0, supported_line_assessments: i64 = 0, supported_line_adoptions: i64 = 0, duration_confirmed: i64 = 0, duration_censored: i64 = 0, duration_unknown: i64 = 0, confirmed_duration_bins: darray[i64] = [0, 0, 0, 0, 0], censored_duration_bins: darray[i64] = [0, 0, 0, 0, 0], nodes, raw_loop, texts, cutoff| -> body, adoption_count, unknown, first_seen_only, confirmed_intro, confirmed_removal, version_comparisons, observed_upgrades, supported_line_assessments, supported_line_adoptions, duration_confirmed, duration_censored, duration_unknown, confirmed_duration_bins, censored_duration_bins:
                    return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                    first: mutable i64 = 0
                    intro: mutable i64 = 0
                    removal: mutable i64 = 0
                    has_first: mutable i64 = 0
                    has_intro: mutable i64 = 0
                    has_removal: mutable i64 = 0
                    return -1 if not Adoption::rh_adoption_optional(nodes, raw_loop, texts, child, "first_seen", &first, &has_first) or not Adoption::rh_adoption_optional(nodes, raw_loop, texts, child, "confirmed_introduction", &intro, &has_intro) or not Adoption::rh_adoption_optional(nodes, raw_loop, texts, child, "confirmed_removal", &removal, &has_removal)
                    last: mutable i64 = 0
                    first_version: mutable i64 = 0
                    latest_version: mutable i64 = 0
                    supported_major: mutable i64 = 0
                    has_last: mutable i64 = 0
                    has_first_version: mutable i64 = 0
                    has_latest_version: mutable i64 = 0
                    has_supported_major: mutable i64 = 0
                    return -1 if not Adoption::rh_adoption_optional_field(nodes, raw_loop, texts, child, "last_seen", &last, &has_last) or not Adoption::rh_adoption_optional_field(nodes, raw_loop, texts, child, "first_version_ord", &first_version, &has_first_version) or not Adoption::rh_adoption_optional_field(nodes, raw_loop, texts, child, "latest_version_ord", &latest_version, &has_latest_version) or not Adoption::rh_adoption_optional_field(nodes, raw_loop, texts, child, "supported_major", &supported_major, &has_supported_major)
                    return -1 if has_first != 0 and first > cutoff or has_last != 0 and last > cutoff or has_intro != 0 and intro > cutoff or has_removal != 0 and removal > cutoff
                    return -1 if has_intro != 0 and has_removal != 0 and removal < intro
                    return -1 if has_first != 0 and has_last != 0 and last < first
                    return -1 if has_intro != 0 and has_last != 0 and last < intro
                    return -1 if has_first_version != 0 and first_version <= 0 or has_latest_version != 0 and latest_version <= 0 or has_supported_major != 0 and supported_major <= 0
                    adoption: Downstream::RhAdoption = Downstream::RhAdoption{first_seen: first, has_first_seen: has_first != 0, confirmed_intro: intro, has_confirmed_intro: has_intro != 0, last_seen: last, has_last_seen: has_last != 0, confirmed_removal: removal, has_confirmed_removal: has_removal != 0}
                    if child != first_child:
                        body.push(44)
                    Downstream::rh_adoption_write(body, adoption, cutoff, first_version, has_first_version != 0, latest_version, has_latest_version != 0, supported_major, has_supported_major != 0)
                    adoption_count <- adoption_count + 1
                    state: u8 = Downstream::rh_adoption_status(adoption)
                    if state == Downstream::RH_ADOPT_UNKNOWN:
                        unknown <- unknown + 1
                    elif state == Downstream::RH_ADOPT_FIRST_SEEN_ONLY:
                        first_seen_only <- first_seen_only + 1
                    elif state == Downstream::RH_ADOPT_CONFIRMED_INTRO:
                        confirmed_intro <- confirmed_intro + 1
                    else:
                        confirmed_removal <- confirmed_removal + 1
                    if has_first_version != 0 and has_latest_version != 0:
                        version_comparisons <- version_comparisons + 1
                        observed_upgrades <- observed_upgrades + 1 if Downstream::rh_observed_upgrade(first_version, latest_version)
                    if has_latest_version != 0 and has_supported_major != 0:
                        supported_line_assessments <- supported_line_assessments + 1
                        supported_line_adoptions <- supported_line_adoptions + 1 if Downstream::rh_on_supported_line(latest_version, supported_major)
                    if has_intro == 0:
                        duration_unknown <- duration_unknown + 1
                    elif has_removal == 0:
                        duration_censored <- duration_censored + 1
                        duration_end: i64 = last if has_last != 0 else cutoff
                        censored_bin: i64 = Adoption::rh_adoption_duration_bin(duration_end - intro)
                        censored_duration_bins[censored_bin.usize()] <- censored_duration_bins[censored_bin.usize()] + 1
                    else:
                        duration_confirmed <- duration_confirmed + 1
                        confirmed_bin: i64 = Adoption::rh_adoption_duration_bin(removal - intro)
                        confirmed_duration_bins[confirmed_bin.usize()] <- confirmed_duration_bins[confirmed_bin.usize()] + 1
                    child <- nodes[child.usize()].next_sibling
            body.push(93)
            Base::rh_push_text(out, "{\"schema\":\"rh-adoption-result/1\",\"cutoff\":")
            Base::rh_push_decimal_i64(out, cutoff)
            Base::rh_push_text(out, ",\"adoptions\":")
            out.extend(bytes_view(body))
            Base::rh_push_text(out, ",\"status_counts\":{\"unknown\":")
            Base::rh_push_decimal_i64(out, unknown)
            Base::rh_push_text(out, ",\"first_seen_only\":")
            Base::rh_push_decimal_i64(out, first_seen_only)
            Base::rh_push_text(out, ",\"confirmed_introduced\":")
            Base::rh_push_decimal_i64(out, confirmed_intro)
            Base::rh_push_text(out, ",\"confirmed_removal\":")
            Base::rh_push_decimal_i64(out, confirmed_removal)
            Base::rh_push_text(out, "},\"evidence_counts\":{\"version_comparison\":")
            Base::rh_push_decimal_i64(out, version_comparisons)
            Base::rh_push_text(out, ",\"version_comparison_unknown\":")
            Base::rh_push_decimal_i64(out, adoption_count - version_comparisons)
            Base::rh_push_text(out, ",\"supported_line_assessed\":")
            Base::rh_push_decimal_i64(out, supported_line_assessments)
            Base::rh_push_text(out, ",\"supported_line_unknown\":")
            Base::rh_push_decimal_i64(out, adoption_count - supported_line_assessments)
            Base::rh_push_text(out, "},\"duration_counts\":{\"confirmed\":")
            Base::rh_push_decimal_i64(out, duration_confirmed)
            Base::rh_push_text(out, ",\"right_censored\":")
            Base::rh_push_decimal_i64(out, duration_censored)
            Base::rh_push_text(out, ",\"unknown\":")
            Base::rh_push_decimal_i64(out, duration_unknown)
            Base::rh_push_text(out, "},\"metrics\":[")
            Base::rh_push_text(out, "{\"key\":\"adoption.unknown_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, unknown)
            Base::rh_push_text(out, ",\"evidence\":[\"adoption-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"adoption.first_seen_only_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, first_seen_only)
            Base::rh_push_text(out, ",\"evidence\":[\"adoption-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"adoption.confirmed_introduction_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, confirmed_intro)
            Base::rh_push_text(out, ",\"evidence\":[\"adoption-input\"]},")
            Base::rh_push_text(out, "{\"key\":\"adoption.confirmed_removal_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
            Base::rh_push_decimal_i64(out, confirmed_removal)
            Base::rh_push_text(out, ",\"evidence\":[\"adoption-input\"]}")
            Adoption::rh_adoption_metric(out, "adoption.observed_upgrade_count", observed_upgrades, adoption_count)
            Adoption::rh_adoption_metric(out, "adoption.version_comparison_count", version_comparisons, adoption_count)
            Adoption::rh_adoption_metric(out, "adoption.supported_line_adoption_count", supported_line_adoptions, adoption_count)
            Adoption::rh_adoption_metric(out, "adoption.supported_line_assessed_count", supported_line_assessments, adoption_count)
            Adoption::rh_adoption_metric(out, "adoption.duration_confirmed_count", duration_confirmed, adoption_count)
            Adoption::rh_adoption_metric(out, "adoption.duration_right_censored_count", duration_censored, adoption_count)
            Adoption::rh_adoption_metric(out, "adoption.duration_unknown_count", duration_unknown, adoption_count)
            Adoption::rh_adoption_duration_metric(out, "adoption.confirmed_duration_distribution", confirmed_duration_bins, duration_confirmed)
            Adoption::rh_adoption_duration_metric(out, "adoption.right_censored_duration_distribution", censored_duration_bins, duration_censored)
            Adoption::rh_adoption_ratio_metric(out, supported_line_adoptions, supported_line_assessments)
            Base::rh_push_text(out, "],\"note\":\"first_seen is a collector observation; confirmed introduction/removal remain separate assertions; elapsed duration is seconds and right-censored at last_seen or cutoff; missing follow-up is right-censored and an observed upgrade is not proof of migration\"}")
            0
