# rh_adoption.elisa — staged dependency adoption evidence (M05-07).
#
# Exposes first-seen, confirmed introduction/removal, and censored duration
# semantics already owned by rh_downstream. Missing or null times stay
# unknown; an observed newer version never becomes a migration claim.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_downstream.elisa"
include "./rh_postgres.elisa"

module Adoption:
    private:
        struct RhAdoptionLag:
            status: u8
            seconds: i64
            through: i64

        struct RhAdoptionCoverage:
            present: bool
            reconstructed: bool
            valid: bool
            interval_count: i64
            gap_count: i64
            uncovered_seconds: i64

        const RH_ADOPTION_MAX_STORE_RUNS: i64 = 4096

        def rh_adoption_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_obj_get(nodes, texts, obj, key)

        def rh_adoption_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        def rh_adoption_store_segment(texts: darray[u8]&, start: i64, finish: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if start < 0 or finish <= start or finish - start > 128
            while i < finish - start |i: i64 = 0, texts, start, finish|:
                c: u8 = texts[(start + i).usize()]
                safe: bool = (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 45 or c == 46 or c == 95
                return false if not safe
                i <- i + 1
            return false if finish - start == 1 and texts[start.usize()] == 46
            return false if finish - start == 2 and texts[start.usize()] == 46 and texts[(start + 1).usize()] == 46
            true

        def rh_adoption_store_status_known(raw: darray[u8]&, start: i64, finish: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(raw, start, finish, "observed") or Base::rh_bytes_equal_literal(raw, start, finish, "not_observed") or Base::rh_bytes_equal_literal(raw, start, finish, "unavailable") or Base::rh_bytes_equal_literal(raw, start, finish, "unauthorized") or Base::rh_bytes_equal_literal(raw, start, finish, "partial") or Base::rh_bytes_equal_literal(raw, start, finish, "stale") or Base::rh_bytes_equal_literal(raw, start, finish, "not_applicable") or Base::rh_bytes_equal_literal(raw, start, finish, "error") or Base::rh_bytes_equal_literal(raw, start, finish, "conflicted") or Base::rh_bytes_equal_literal(raw, start, finish, "suppressed") or Base::rh_bytes_equal_literal(raw, start, finish, "unsupported")

        def rh_adoption_store_runs(root_path: cstr, source: darray[u8]&, source_s: i64, source_e: i64, capability_s: i64, capability_e: i64, runs_out: mutable darray[u8]&) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            path: mutable darray[u8] = []
            Base::rh_push_cstr(path, root_path)
            Base::rh_push_text(path, "/sources/")
            while i < source_e - source_s |i: i64 = 0, source, source_s, source_e, path|:
                path.push(source[(source_s + i).usize()])
                i <- i + 1
            Base::rh_push_text(path, "/coverage/")
            while i < capability_e - capability_s |i: i64 = 0, source, capability_s, capability_e, path|:
                path.push(source[(capability_s + i).usize()])
                i <- i + 1
            Base::rh_push_text(path, ".interval")
            path.push(0)
            path_ptr: cstr = (&path[0]).cast[cstr] can Unsafe.PointerCast
            size: i64 = Base::rh_file_size(path_ptr)
            runs_out.push(91)
            if size < 0:
                runs_out.push(93)
                return true
            raw: mutable darray[u8] = []
            return false if Base::rh_io_read(path_ptr, raw) != size
            cursor: mutable usize = 0
            previous_end: mutable i64 = -1
            count: mutable i64 = 0
            while cursor < raw.count |cursor, raw, previous_end, count, runs_out|:
                return false if count >= RH_ADOPTION_MAX_STORE_RUNS
                line_end: mutable usize = cursor
                while line_end < raw.count and raw[line_end] != 10 |line_end, raw|:
                    line_end <- line_end + 1
                return false if line_end == cursor or line_end == raw.count
                first_end: mutable usize = cursor
                while first_end < line_end and raw[first_end] != 32 |first_end, raw|:
                    first_end <- first_end + 1
                second_end: mutable usize = first_end + 1
                while second_end < line_end and raw[second_end] != 32 |second_end, raw|:
                    second_end <- second_end + 1
                return false if first_end == cursor or second_end == first_end + 1 or second_end >= line_end
                status_start: usize = second_end + 1
                return false if status_start >= line_end
                status_cursor: mutable usize = status_start
                status_has_space: mutable bool = false
                while status_cursor < line_end |status_cursor, line_end, raw, status_has_space|:
                    status_has_space <- true if raw[status_cursor] == 32
                    status_cursor <- status_cursor + 1
                return false if status_has_space or not Adoption::rh_adoption_store_status_known(raw, status_start.i64(), line_end.i64())
                start_ok: mutable i64 = 0
                finish_ok: mutable i64 = 0
                start: i64 = Base::rh_parse_i64(raw, cursor, first_end, &start_ok)
                finish: i64 = Base::rh_parse_i64(raw, first_end + 1, second_end, &finish_ok)
                return false if start_ok == 0 or finish_ok == 0 or start < 0 or finish <= start or (previous_end >= 0 and start < previous_end)
                if count > 0:
                    runs_out.push(44)
                Base::rh_push_text(runs_out, "{\"from\":")
                Base::rh_push_decimal_i64(runs_out, start)
                Base::rh_push_text(runs_out, ",\"through\":")
                Base::rh_push_decimal_i64(runs_out, finish)
                Base::rh_push_text(runs_out, ",\"complete\":")
                is_observed: bool = Base::rh_bytes_equal_literal(raw, status_start.i64(), line_end.i64(), "observed")
                Base::rh_push_text(runs_out, "true" if is_observed else "false")
                runs_out.push(125)
                previous_end <- finish
                count <- count + 1
                cursor <- line_end + 1
            runs_out.push(93)
            true

        def rh_adoption_augment_store(raw: darray[u8]&, root_path: cstr, conninfo: cstr, use_postgres: bool, augmented: mutable darray[u8]&) -> bool can[Blocking.IO, Memory.Allocate, Memory.Release, Abort.Panic, Unsafe.PointerCast]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return false if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            adoptions_idx: i64 = Adoption::rh_adoption_get(nodes, texts, root, "adoptions")
            return false if adoptions_idx < 0 or nodes[adoptions_idx.usize()].kind != Json::RH_JSON_ARR
            cursor: mutable usize = 0
            while child >= 0 |child: i64 = nodes[adoptions_idx.usize()].first_child, nodes, raw, texts, augmented, cursor, root_path|:
                return false if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                source_idx: i64 = Adoption::rh_adoption_get(nodes, texts, child, "coverage_source")
                capability_idx: i64 = Adoption::rh_adoption_get(nodes, texts, child, "coverage_capability")
                if source_idx < 0 and capability_idx < 0:
                    child <- nodes[child.usize()].next_sibling
                    continue
                return false if source_idx < 0 or capability_idx < 0
                source_null: bool = nodes[source_idx.usize()].kind == Json::RH_JSON_NULL
                capability_null: bool = nodes[capability_idx.usize()].kind == Json::RH_JSON_NULL
                return false if source_null or capability_null or nodes[source_idx.usize()].kind != Json::RH_JSON_STR or nodes[capability_idx.usize()].kind != Json::RH_JSON_STR
                source_node: Json::RhJsonNode = nodes[source_idx.usize()]
                capability_node: Json::RhJsonNode = nodes[capability_idx.usize()]
                return false if not Adoption::rh_adoption_store_segment(texts, source_node.text_start, source_node.text_end) or not Adoption::rh_adoption_store_segment(texts, capability_node.text_start, capability_node.text_end)
                coverage_idx: i64 = Adoption::rh_adoption_get(nodes, texts, child, "snapshot_coverage")
                history_idx: i64 = Adoption::rh_adoption_get(nodes, texts, child, "snapshot_runs")
                return false if coverage_idx >= 0 and nodes[coverage_idx.usize()].kind != Json::RH_JSON_NULL
                return false if history_idx >= 0 and nodes[history_idx.usize()].kind != Json::RH_JSON_NULL
                runs: mutable darray[u8] = []
                if use_postgres:
                    source_id: mutable darray[u8] = []
                    capability: mutable darray[u8] = []
                    while i < source_node.text_end - source_node.text_start |i: i64 = 0, texts, source_node, source_id|:
                        source_id.push(texts[(source_node.text_start + i).usize()])
                        i <- i + 1
                    source_id.push(0)
                    while i < capability_node.text_end - capability_node.text_start |i: i64 = 0, texts, capability_node, capability|:
                        capability.push(texts[(capability_node.text_start + i).usize()])
                        i <- i + 1
                    capability.push(0)
                    source_ptr: cstr = (&source_id[0]).cast[cstr] can Unsafe.PointerCast
                    capability_ptr: cstr = (&capability[0]).cast[cstr] can Unsafe.PointerCast
                    history_status: i64 = Postgres::rh_pg_adoption_history(conninfo, source_ptr, capability_ptr, runs)
                    return false if history_status <= 0
                else:
                    return false if not Adoption::rh_adoption_store_runs(root_path, texts, source_node.text_start, source_node.text_end, capability_node.text_start, capability_node.text_end, runs)
                entry: Json::RhJsonNode = nodes[child.usize()]
                return false if entry.text_start < cursor.i64() or entry.text_end <= entry.text_start or raw[(entry.text_end - 1).usize()] != 125
                while i < entry.text_end - 1 - cursor.i64() |i: usize = 0, raw, augmented, cursor, entry|:
                    augmented.push(raw[cursor + i])
                    i <- i + 1
                augmented.push(44) if entry.child_count > 0
                Base::rh_push_text(augmented, "\"snapshot_runs\":")
                augmented.extend(bytes_view(runs))
                augmented.push(125)
                cursor <- entry.text_end.usize()
                child <- nodes[child.usize()].next_sibling
            while i < raw.count |i: usize = cursor, raw, augmented|:
                augmented.push(raw[i])
                i <- i + 1
            true

        def rh_adoption_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Adoption::rh_adoption_get(nodes, texts, obj, key)
            Json::rh_json_int(nodes, raw, idx, ok_out)

        def rh_adoption_optional(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, value_out: mutable i64&, present_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Adoption::rh_adoption_get(nodes, texts, obj, key)
            return false if idx < 0
            if nodes[idx.usize()].kind == Json::RH_JSON_NULL:
                value_out[0] <- 0
                present_out[0] <- 0
                return true
            ok: mutable i64 = 0
            value: i64 = Json::rh_json_int(nodes, raw, idx, &ok)
            return false if ok == 0 or value < 0
            value_out[0] <- value
            present_out[0] <- 1
            true

        def rh_adoption_optional_field(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, value_out: mutable i64&, present_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Adoption::rh_adoption_get(nodes, texts, obj, key)
            if idx < 0:
                value_out[0] <- 0
                present_out[0] <- 0
                return true
            if nodes[idx.usize()].kind == Json::RH_JSON_NULL:
                value_out[0] <- 0
                present_out[0] <- 0
                return true
            ok: mutable i64 = 0
            value: i64 = Json::rh_json_int(nodes, raw, idx, &ok)
            return false if ok == 0 or value < 0
            value_out[0] <- value
            present_out[0] <- 1
            true

        def rh_adoption_coverage(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, adoption: i64, cutoff: i64, release_at: i64, has_release: bool, followup_through: i64, has_followup: bool) -> RhAdoptionCoverage can[Memory.Allocate, Abort.Panic]:
            supplied_idx: i64 = Adoption::rh_adoption_get(nodes, texts, adoption, "snapshot_coverage")
            history_idx: i64 = Adoption::rh_adoption_get(nodes, texts, adoption, "snapshot_runs")
            has_supplied: bool = supplied_idx >= 0 and nodes[supplied_idx.usize()].kind != Json::RH_JSON_NULL
            has_history: bool = history_idx >= 0 and nodes[history_idx.usize()].kind != Json::RH_JSON_NULL
            return RhAdoptionCoverage{present: false, reconstructed: false, valid: true, interval_count: 0, gap_count: 0, uncovered_seconds: 0} if not has_supplied and not has_history
            return RhAdoptionCoverage{present: true, reconstructed: has_history, valid: false, interval_count: 0, gap_count: 0, uncovered_seconds: 0} if has_supplied and has_history
            idx: i64 = history_idx if has_history else supplied_idx
            return RhAdoptionCoverage{present: true, reconstructed: has_history, valid: false, interval_count: 0, gap_count: 0, uncovered_seconds: 0} if nodes[idx.usize()].kind != Json::RH_JSON_ARR
            arr: Json::RhJsonNode = nodes[idx.usize()]
            nodes_loop: mutable darray[Json::RhJsonNode]& = nodes
            raw_loop: mutable darray[u8]& = raw
            texts_loop: mutable darray[u8]& = texts
            arr_loop: mutable Json::RhJsonNode = arr
            cutoff_loop: mutable i64 = cutoff
            release_loop: mutable i64 = release_at
            has_release_loop: mutable bool = has_release
            followup_loop: mutable i64 = followup_through
            has_followup_loop: mutable bool = has_followup
            history_loop: mutable bool = has_history
            interval_count, gap_count_state, uncovered_state, previous_through, last_interval_through, cursor, valid =
                while child >= 0 |child: i64 = arr_loop.first_child, interval_count: i64 = 0, gap_count: i64 = 0, uncovered_seconds: i64 = 0, previous_through: i64 = -1, last_interval_through: i64 = -1, cursor: i64 = release_loop, valid: bool = true, nodes_loop, raw_loop, texts_loop, arr_loop, cutoff_loop, has_release_loop, has_followup_loop, followup_loop, history_loop| -> interval_count, gap_count, uncovered_seconds, previous_through, last_interval_through, cursor, valid:
                    if nodes_loop[child.usize()].kind != Json::RH_JSON_OBJ:
                        valid <- false
                        break
                    from_ok: mutable i64 = 0
                    through_ok: mutable i64 = 0
                    start: i64 = Adoption::rh_adoption_int(nodes_loop, raw_loop, texts_loop, child, "from", &from_ok)
                    finish: i64 = Adoption::rh_adoption_int(nodes_loop, raw_loop, texts_loop, child, "through", &through_ok)
                    if from_ok == 0 or through_ok == 0 or start < 0 or finish <= start or finish > cutoff_loop or last_interval_through >= 0 and start < last_interval_through:
                        valid <- false
                        break
                    interval_count <- interval_count + 1
                    complete: mutable bool = true
                    if history_loop:
                        complete_idx: i64 = Adoption::rh_adoption_get(nodes_loop, texts_loop, child, "complete")
                        if complete_idx < 0 or nodes_loop[complete_idx.usize()].kind != Json::RH_JSON_BOOL:
                            valid <- false
                            break
                        complete <- Json::rh_json_is_true(nodes_loop, raw_loop, complete_idx)
                    if complete and (not has_release_loop or not has_followup_loop) and previous_through >= 0 and start > previous_through:
                        gap_count <- gap_count + 1
                        uncovered_seconds <- uncovered_seconds + start - previous_through
                    if complete and has_release_loop and has_followup_loop:
                        clipped_start: i64 = release_loop if start < release_loop else start
                        clipped_finish: i64 = followup_loop if finish > followup_loop else finish
                        if clipped_finish > clipped_start:
                            if clipped_start > cursor:
                                gap_count <- gap_count + 1
                                uncovered_seconds <- uncovered_seconds + clipped_start - cursor
                            cursor <- clipped_finish if clipped_finish > cursor
                    previous_through <- finish if complete
                    last_interval_through <- finish
                    child <- nodes[child.usize()].next_sibling
            gap_count: mutable i64 = gap_count_state
            uncovered_seconds: mutable i64 = uncovered_state
            if has_release and has_followup and cursor < followup_through:
                gap_count <- gap_count + 1
                uncovered_seconds <- uncovered_seconds + followup_through - cursor
            RhAdoptionCoverage{present: true, reconstructed: has_history, valid: valid, interval_count: interval_count, gap_count: gap_count, uncovered_seconds: uncovered_seconds}

        def rh_adoption_metric(out: mutable darray[u8]&, key: u8&, value: i64, population_count: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, ",{\"key\":\"")
            Base::rh_push_text(out, key)
            Base::rh_push_text(out, "\",\"version\":\"1.0.0\",\"status\":\"")
            Base::rh_push_text(out, "observed\",\"value\":") if population_count > 0 else Base::rh_push_text(out, "not_applicable\",\"value\":null")
            Base::rh_push_decimal_i64(out, value) if population_count > 0
            Base::rh_push_text(out, ",\"evidence\":[\"adoption-input\"]}")

        def rh_adoption_ratio_metric(out: mutable darray[u8]&, numerator: i64, denominator: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, ",{\"key\":\"downstream_condition.supported_version_adoption_share\",\"version\":\"1.0.0\",\"status\":\"")
            if denominator > 0:
                Base::rh_push_text(out, "observed\",\"value\":{\"num\":")
                Base::rh_push_decimal_i64(out, numerator)
                Base::rh_push_text(out, ",\"den\":")
                Base::rh_push_decimal_i64(out, denominator)
                Base::rh_push_text(out, "}")
            else:
                Base::rh_push_text(out, "not_applicable\",\"value\":null")
            Base::rh_push_text(out, ",\"evidence\":[\"adoption-input\"]}")

        def rh_adoption_duration_bin(duration: i64) -> i64:
            return 0 if duration < 604800
            return 1 if duration < 2592000
            return 2 if duration < 7776000
            return 3 if duration < 31536000
            4

        def rh_adoption_duration_metric(out: mutable darray[u8]&, key: u8&, counts: darray[i64]&, population_count: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, ",{\"key\":\"")
            Base::rh_push_text(out, key)
            Base::rh_push_text(out, "\",\"version\":\"1.0.0\",\"status\":\"")
            Base::rh_push_text(out, "observed\",\"value\":{\"bucket_upper_seconds\":[604799,2591999,7775999,31535999,null],\"counts\":[") if population_count > 0 else Base::rh_push_text(out, "not_applicable\",\"value\":null")
            if population_count > 0:
                while i < counts.count |i: usize = 0, counts, out|:
                    Base::rh_push_text(out, ",") if i > 0
                    Base::rh_push_decimal_i64(out, counts[i])
                    i <- i + 1
                Base::rh_push_text(out, "]}")
            Base::rh_push_text(out, ",\"evidence\":[\"adoption-input\"]}")

        def rh_adoption_lag(release_at: i64, has_release: bool, target_version: i64, has_target: bool, qualifying_version: i64, has_qualifying_version: bool, qualifying_at: i64, has_qualifying_at: bool, followup_through: i64, has_followup: bool, coverage: RhAdoptionCoverage) -> RhAdoptionLag:
            observed: bool = has_release and has_target and has_qualifying_version and has_qualifying_at and qualifying_version >= target_version
            censored: bool = not observed and not has_qualifying_version and has_release and has_target and has_followup and (not coverage.present or coverage.gap_count == 0)
            if observed:
                RhAdoptionLag{status: Downstream::RH_ADOPTION_LAG_OBSERVED, seconds: qualifying_at - release_at, through: 0}
            elif censored:
                RhAdoptionLag{status: Downstream::RH_ADOPTION_LAG_CENSORED, seconds: followup_through - release_at, through: followup_through}
            else:
                RhAdoptionLag{status: Downstream::RH_ADOPTION_LAG_UNKNOWN, seconds: 0, through: 0}

        def rh_adoption_lag_metric(out: mutable darray[u8]&, key: u8&, counts: darray[i64]&, population_count: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, ",{\"key\":\"")
            Base::rh_push_text(out, key)
            Base::rh_push_text(out, "\",\"version\":\"1.0.0\",\"status\":\"")
            Base::rh_push_text(out, "observed\",\"value\":{\"bucket_upper_seconds\":[604799,2591999,7775999,31535999,null],\"counts\":[") if population_count > 0 else Base::rh_push_text(out, "not_applicable\",\"value\":null")
            if population_count > 0:
                while i < counts.count |i: usize = 0, counts, out|:
                    Base::rh_push_text(out, ",") if i > 0
                    Base::rh_push_decimal_i64(out, counts[i])
                    i <- i + 1
                Base::rh_push_text(out, "]}")
            Base::rh_push_text(out, ",\"evidence\":[\"adoption-input\"]}")

    public:
        def rh_adoption_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_idx: i64 = Adoption::rh_adoption_get(nodes, texts, root, "schema")
            return -1 if schema_idx < 0 or nodes[schema_idx.usize()].kind != Json::RH_JSON_STR
            schema: Json::RhJsonNode = nodes[schema_idx.usize()]
            return -1 if not Adoption::rh_adoption_eq(texts, schema.text_start, schema.text_end, "rh-adoption-input/1")
            cutoff_ok: mutable i64 = 0
            cutoff: mutable i64 = Adoption::rh_adoption_int(nodes, raw, texts, root, "cutoff", &cutoff_ok)
            return -1 if cutoff_ok == 0 or cutoff < 0
            raw_loop: mutable darray[u8]& = raw
            arr_idx: i64 = Adoption::rh_adoption_get(nodes, texts, root, "adoptions")
            return -1 if arr_idx < 0 or nodes[arr_idx.usize()].kind != Json::RH_JSON_ARR
            body, adoption_count, unknown, first_seen_only, confirmed_intro, confirmed_removal, version_comparisons, observed_upgrades, supported_line_assessments, supported_line_adoptions, duration_confirmed, duration_censored, duration_unknown, confirmed_duration_bins, censored_duration_bins, lag_observed_count, lag_censored_count, lag_unknown_count, lag_observed_bins, lag_censored_bins, coverage_record_count, coverage_gap_total, uncovered_seconds_total =
