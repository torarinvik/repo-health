# rh_adoption.elisa — staged dependency adoption evidence (M05-07).
#
# Exposes first-seen, confirmed introduction/removal, and censored duration
# semantics already owned by rh_downstream. Missing or null times stay
# unknown; an observed newer version never becomes a migration claim.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_downstream.elisa"

module Adoption:
    private:
        def rh_adoption_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_obj_get(nodes, texts, obj, key)

        def rh_adoption_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        def rh_adoption_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Adoption::rh_adoption_get(nodes, texts, obj, key)
            Json::rh_json_int(nodes, raw, idx, ok_out)

        def rh_adoption_optional(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, value_out: mutable i64&, present_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Adoption::rh_adoption_get(nodes, texts, obj, key)
            return false if idx < 0
            if nodes[idx.usize()].kind == Json::RH_JSON_NULL:
                value_out[0] <- 0
                present_out[0] <- 0
                return true
            ok: mutable i64 = 0
            value: i64 = Json::rh_json_int(nodes, raw, idx, &ok)
            return false if ok == 0 or value < 0
            value_out[0] <- value
            present_out[0] <- 1
            true

    public:
        def rh_adoption_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_idx: i64 = Adoption::rh_adoption_get(nodes, texts, root, "schema")
            return -1 if schema_idx < 0 or nodes[schema_idx.usize()].kind != Json::RH_JSON_STR
            schema: Json::RhJsonNode = nodes[schema_idx.usize()]
            return -1 if not Adoption::rh_adoption_eq(texts, schema.text_start, schema.text_end, "rh-adoption-input/1")
            cutoff_ok: mutable i64 = 0
            cutoff: mutable i64 = Adoption::rh_adoption_int(nodes, raw, texts, root, "cutoff", &cutoff_ok)
            return -1 if cutoff_ok == 0 or cutoff < 0
            raw_loop: mutable darray[u8]& = raw
            arr_idx: i64 = Adoption::rh_adoption_get(nodes, texts, root, "adoptions")
            return -1 if arr_idx < 0 or nodes[arr_idx.usize()].kind != Json::RH_JSON_ARR
            body, unknown, first_seen_only, confirmed_intro, confirmed_removal =
                while child >= 0 |child: i64 = nodes[arr_idx.usize()].first_child, first_child: i64 = nodes[arr_idx.usize()].first_child, body: darray[u8] = [91], unknown: i64 = 0, first_seen_only: i64 = 0, confirmed_intro: i64 = 0, confirmed_removal: i64 = 0, nodes, raw_loop, texts, cutoff| -> body, unknown, first_seen_only, confirmed_intro, confirmed_removal:
                    return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                    first: mutable i64 = 0
                    intro: mutable i64 = 0
                    removal: mutable i64 = 0
                    has_first: mutable i64 = 0
                    has_intro: mutable i64 = 0
                    has_removal: mutable i64 = 0
                    return -1 if not Adoption::rh_adoption_optional(nodes, raw_loop, texts, child, "first_seen", &first, &has_first) or not Adoption::rh_adoption_optional(nodes, raw_loop, texts, child, "confirmed_introduction", &intro, &has_intro) or not Adoption::rh_adoption_optional(nodes, raw_loop, texts, child, "confirmed_removal", &removal, &has_removal)
                    return -1 if has_first != 0 and first > cutoff or has_intro != 0 and intro > cutoff or has_removal != 0 and removal > cutoff
                    return -1 if has_intro != 0 and has_removal != 0 and removal < intro
                    adoption: Downstream::RhAdoption = Downstream::RhAdoption{first_seen: first, confirmed_intro: intro, last_seen: 0, confirmed_removal: removal}
                    if child != first_child:
                        body.push(44)
                    Downstream::rh_adoption_write(body, adoption, cutoff)
                    state: u8 = Downstream::rh_adoption_status(adoption)
                    if state == Downstream::RH_ADOPT_UNKNOWN:
                        unknown <- unknown + 1
                    elif state == Downstream::RH_ADOPT_FIRST_SEEN_ONLY:
                        first_seen_only <- first_seen_only + 1
                    elif state == Downstream::RH_ADOPT_CONFIRMED_INTRO:
                        confirmed_intro <- confirmed_intro + 1
                    else:
                        confirmed_removal <- confirmed_removal + 1
                    child <- nodes[child.usize()].next_sibling
            body.push(93)
            Base::rh_push_text(out, "{\"schema\":\"rh-adoption-result/1\",\"cutoff\":")
            Base::rh_push_decimal_i64(out, cutoff)
            Base::rh_push_text(out, ",\"adoptions\":")
            out.extend(bytes_view(body))
            Base::rh_push_text(out, ",\"status_counts\":{\"unknown\":")
            Base::rh_push_decimal_i64(out, unknown)
            Base::rh_push_text(out, ",\"first_seen_only\":")
            Base::rh_push_decimal_i64(out, first_seen_only)
            Base::rh_push_text(out, ",\"confirmed_introduced\":")
            Base::rh_push_decimal_i64(out, confirmed_intro)
            Base::rh_push_text(out, ",\"confirmed_removal\":")
            Base::rh_push_decimal_i64(out, confirmed_removal)
            Base::rh_push_text(out, "},\"note\":\"first_seen is a collector observation; confirmed introduction/removal remain separate assertions; missing follow-up is right-censored and an observed upgrade is not proof of migration\"}")
            0
