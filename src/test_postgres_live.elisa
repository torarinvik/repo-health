include "./rh_postgres.elisa"

def main() -> i32:
    conninfo: u8&? = getenv("RH_TEST_PG_CONNINFO")
    return 10 if conninfo == null
    connection: cstr = conninfo.cast[cstr] can Unsafe.PointerCast
    first: i64 = Postgres::rh_pg_commit_collection_page(
        connection,
        "00000000-0000-0000-0000-000000000003",
        0,
        "pg-adapter-live",
        "",
        "{\"page\":1}",
        "complete",
        2,
        "",
        "2026-09-21T00:00:00Z"
    )
    return 1 if first != 1
    second: i64 = Postgres::rh_pg_commit_collection_page(
        connection,
        "00000000-0000-0000-0000-000000000003",
        0,
        "pg-adapter-live",
        "",
        "{\"page\":1}",
        "complete",
        2,
        "",
        "2026-09-21T00:00:00Z"
    )
    return 2 if second != 0
    renewed: i64 = Postgres::rh_pg_heartbeat_job(
        connection,
        "00000000-0000-0000-0000-000000000002",
        4,
        "2026-09-21T00:00:00Z",
        60
    )
    return 3 if renewed != 1
    stale: i64 = Postgres::rh_pg_heartbeat_job(
        connection,
        "00000000-0000-0000-0000-000000000002",
        3,
        "2026-09-21T00:00:00Z",
        60
    )
    return 4 if stale != 0
    finished: i64 = Postgres::rh_pg_finish_job(
        connection,
        "00000000-0000-0000-0000-000000000002",
        4,
        "succeeded",
        "2026-09-21T00:00:00Z",
        "ok",
        ""
    )
    return 5 if finished != 1
    repeated_finish: i64 = Postgres::rh_pg_finish_job(
        connection,
        "00000000-0000-0000-0000-000000000002",
        4,
        "succeeded",
        "2026-09-21T00:00:00Z",
        "ok",
        ""
    )
    return 6 if repeated_finish != 0
    job_id: mutable darray[u8] = []
    token: mutable i64 = 0
    expires: mutable darray[u8] = []
    claimed: i64 = Postgres::rh_pg_claim_next_job(
        connection,
        "worker-a",
        "2026-09-21T00:00:00Z",
        60,
        job_id,
        &token,
        expires
    )
    return 7 if claimed != 1 or token != 1 or expires.count == 0
    claimed_id: u8& = (&job_id[0]).cast[u8&] can Unsafe.PointerCast
    return 8 if not Base::rh_streq(claimed_id, "00000000-0000-0000-0000-000000000004")
    empty_claim: i64 = Postgres::rh_pg_claim_next_job(
        connection,
        "worker-a",
        "2026-09-21T00:00:00Z",
        60,
        job_id,
        &token,
        expires
    )
    return 0 if empty_claim == 0 and token == 0 and job_id.count == 0 and expires.count == 0
    9
