# rh_postgres_report.elisa — bounded PostgreSQL operation command (M02-01).

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_postgres.elisa"
include "./rh_sha256.elisa"
include "./rh_store.elisa"
include "./rh_query_report.elisa"
include "./rh_job.elisa"

module PostgresReport:
    private:
        const RH_PG_REPORT_MAX_BYTES: usize = 1048576
        const RH_PG_REPORT_MAX_NORMALIZATION_BYTES: usize = 20971520
        const RH_PG_REPORT_MAX_INGEST_BYTES: usize = 4194304
        const RH_PG_REPORT_MAX_EVIDENCE_BYTES: i64 = 67108864
        const RH_PG_REPORT_MAX_INGEST_EVIDENCE_BYTES: i64 = 67108864

        def rh_pg_report_eq(texts: darray[u8]&, start: i64, end: i64, literal: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, start, end, literal)

        def rh_pg_report_span(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, start_out: mutable i64&, end_out: mutable i64&, allow_empty: bool) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return false if idx < 0 or not Json::rh_json_str_span(nodes, idx, start_out, end_out)
            return false if end_out[0] < start_out[0] or (not allow_empty and end_out[0] == start_out[0])
            while i < end_out[0] - start_out[0] |i: i64 = 0, texts, start_out, end_out|:
                return false if texts[(start_out[0] + i).usize()] == 0
                i <- i + 1
            true

        def rh_pg_report_text(texts: darray[u8]&, start: i64, end: i64) -> mutable darray[u8] can[Memory.Allocate, Abort.Panic]:
            bytes: mutable darray[u8] = []
            while i < end |i: i64 = start, bytes, texts, end|:
                bytes.push(texts[i.usize()])
                i <- i + 1
            bytes.push(0)
            bytes

        def rh_pg_report_raw_object(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, max_bytes: i64) -> mutable darray[u8] can[Memory.Allocate, Abort.Panic]:
            bytes: mutable darray[u8] = []
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return bytes if idx < 0 or nodes[idx.usize()].kind != Json::RH_JSON_OBJ
            node: Json::RhJsonNode = nodes[idx.usize()]
            return bytes if node.text_start < 0 or node.text_end <= node.text_start or node.text_end - node.text_start > max_bytes
            while i < node.text_end |i: i64 = node.text_start, bytes, raw, node|:
                bytes.push(raw[i.usize()])
                i <- i + 1
            bytes.push(0)
            bytes

        def rh_pg_report_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, min_value: i64, max_value: i64, value_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            ok: mutable i64 = 0
            value: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, obj, key), &ok)
            return false if ok == 0 or value < min_value or value > max_value
            value_out[0] <- value
            true

        # Split a validated projection document into bounded database calls.
        # Chunk buffers and edge cursors stay inside each scoped iteration.
        def rh_pg_report_stage_projection_chunks(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, projection_idx: i64, edges_node: Json::RhJsonNode, expected_edges: i64, conninfo: cstr, status_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            projection_node: Json::RhJsonNode = nodes[projection_idx.usize()]
            return -1 if projection_node.text_start < 0 or projection_node.text_end <= projection_node.text_start
            return -1 if expected_edges != edges_node.child_count.i64()
            chunk_count: i64 = (expected_edges + 9999) / 10000 if expected_edges > 0 else 1
            chunk_index: mutable i64 = 0
            remaining_edges: mutable i64 = edges_node.child_count.i64()
            edge_idx: mutable i64 = edges_node.first_child
            while chunk_index < chunk_count |chunk_index, remaining_edges, edge_idx, nodes, raw, projection_node, edges_node, expected_edges, chunk_count, conninfo, status_out|:
                chunk_json: mutable darray[u8] = []
                Base::rh_push_text(chunk_json, "{\"schema\":\"rh-postgres-projection-chunk/1\",\"projection\":")
                while raw_offset < projection_node.text_end |raw_offset: i64 = projection_node.text_start, raw, projection_node, chunk_json|:
                    chunk_json.push(raw[raw_offset.usize()])
                    raw_offset <- raw_offset + 1
                Base::rh_push_text(chunk_json, ",\"expected_edge_count\":")
                Base::rh_push_decimal_i64(chunk_json, expected_edges)
                Base::rh_push_text(chunk_json, ",\"chunk_index\":")
                Base::rh_push_decimal_i64(chunk_json, chunk_index)
                Base::rh_push_text(chunk_json, ",\"chunk_count\":")
                Base::rh_push_decimal_i64(chunk_json, chunk_count)
                Base::rh_push_text(chunk_json, ",\"edges\":[")
                chunk_edge_count: mutable i64 = 10000
                if remaining_edges < 10000:
                    chunk_edge_count <- remaining_edges
                copied_edges: mutable i64 = 0
                while copied_edges < chunk_edge_count |copied_edges, edge_idx, nodes, raw, chunk_json|:
                    return -1 if edge_idx < 0
                    edge_node: Json::RhJsonNode = nodes[edge_idx.usize()]
                    return -1 if edge_node.text_start < 0 or edge_node.text_end <= edge_node.text_start
                    if copied_edges > 0:
                        chunk_json.push(44)
                    while edge_offset < edge_node.text_end |edge_offset: i64 = edge_node.text_start, raw, edge_node, chunk_json|:
                        chunk_json.push(raw[edge_offset.usize()])
                        edge_offset <- edge_offset + 1
                    edge_idx <- nodes[edge_idx.usize()].next_sibling
                    copied_edges <- copied_edges + 1
                return -1 if copied_edges != chunk_edge_count
                Base::rh_push_text(chunk_json, "]}")
                chunk_json.push(0)
                chunk_ptr: cstr = (&chunk_json[0]).cast[cstr] can Unsafe.PointerCast
                chunk_status: mutable darray[u8] = []
                return -1 if Postgres::rh_pg_stage_graph_projection_chunk(conninfo, chunk_ptr, chunk_status) <= 0
                return -1 if not Base::rh_bytes_equal_literal(chunk_status, 0, chunk_status.count.i64(), "staged") and not Base::rh_bytes_equal_literal(chunk_status, 0, chunk_status.count.i64(), "stored") and not Base::rh_bytes_equal_literal(chunk_status, 0, chunk_status.count.i64(), "replay")
                status_out <- chunk_status
                remaining_edges <- remaining_edges - copied_edges
                chunk_index <- chunk_index + 1
            return -1 if remaining_edges != 0
            status_out.count.i64()

        def rh_pg_report_emit_text(out: mutable darray[u8]&, texts: darray[u8]&, start: i64, end: i64) -> void can[Memory.Allocate, Abort.Panic]:
            out.push(34)
            Base::rh_json_escape(out, texts, start.usize(), end.usize())
            out.push(34)

        def rh_pg_report_hex16(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if end - start != 16
            while i < end |i: i64 = start, texts|:
                b: u8 = texts[i.usize()]
                return false if not ((b >= 48 and b <= 57) or (b >= 97 and b <= 102))
                i <- i + 1
            true

        def rh_pg_report_hex64(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if end - start != 64
            while i < end |i: i64 = start, texts|:
                b: u8 = texts[i.usize()]
                return false if not ((b >= 48 and b <= 57) or (b >= 97 and b <= 102))
                i <- i + 1
            true

        def rh_pg_report_uuid_valid(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if end - start != 36
            while index < 36 |index: i64 = 0, texts, start|:
                byte: u8 = texts[(start + index).usize()]
                if index == 8 or index == 13 or index == 18 or index == 23:
                    return false if byte != 45
                else:
                    valid_hex: bool = (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 70) or (byte >= 97 and byte <= 102)
                    return false if not valid_hex
                index <- index + 1
            true

        def rh_pg_report_visibility_ok(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            if PostgresReport::rh_pg_report_eq(texts, start, end, "public"):
                true
            elif PostgresReport::rh_pg_report_eq(texts, start, end, "tenant-private"):
                true
            elif PostgresReport::rh_pg_report_eq(texts, start, end, "restricted-personal"):
                true
            elif PostgresReport::rh_pg_report_eq(texts, start, end, "embargoed-security"):
                true
            else:
                PostgresReport::rh_pg_report_eq(texts, start, end, "suppressed")

        def rh_pg_report_emit_cstr(out: mutable darray[u8]&, bytes: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            raw: mutable darray[u8] = []
            while i + 1 < bytes.count |i: usize = 0, bytes, raw|:
                raw.push(bytes[i])
                i <- i + 1
            out.push(34)
            Base::rh_json_escape(out, raw, 0, raw.count)
            out.push(34)

        def rh_pg_report_reference_has(names: darray[u8]&, name_count: i64, target: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            low: mutable usize = 0
            high: mutable usize = name_count.usize()
            while low < high |low, high, names, target, start, end|:
                middle: usize = low + (high - low) / 2
                offset: usize = middle * 17
                order: mutable i64 = 0
                while i < end - start |i: i64 = 0, names, target, start, end, offset, order|:
                    left: u8 = target[(start + i).usize()]
                    right: u8 = names[offset + i.usize()]
                    if left != right:
                        order <- -1 if left < right
                        order <- 1 if left > right
                        i <- end - start
                    else:
                        i <- i + 1
                return true if order == 0
                low <- middle + 1 if order > 0
                high <- middle if order < 0
            false

        def rh_pg_report_reference_names(snapshot: darray[u8]&, names_out: mutable darray[u8]&, count_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(snapshot, nodes, texts)
            return false if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            keys_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "storage_keys")
            return false if keys_idx < 0 or nodes[keys_idx.usize()].kind != Json::RH_JSON_ARR
            invalid_ok: mutable i64 = 0
            invalid_count: i64 = Json::rh_json_int(nodes, snapshot, Json::rh_json_obj_get(nodes, texts, root, "invalid_count"), &invalid_ok)
            return false if invalid_ok == 0 or invalid_count != 0
            count_ok: mutable i64 = 0
            count: i64 = Json::rh_json_int(nodes, snapshot, Json::rh_json_obj_get(nodes, texts, root, "count"), &count_ok)
            return false if count_ok == 0 or count < 0 or count > 100000 or nodes[keys_idx.usize()].child_count != count
            truncated_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "truncated")
            return false if truncated_idx < 0 or nodes[truncated_idx.usize()].kind != Json::RH_JSON_BOOL or Json::rh_json_is_true(nodes, snapshot, truncated_idx)
            count_out[0] <- count
            keys: Json::RhJsonNode = nodes[keys_idx.usize()]
            while child >= 0 |child: i64 = keys.first_child, nodes, texts, names_out|:
                key_start: mutable i64 = 0
                key_end: mutable i64 = 0
                return false if not Json::rh_json_str_span(nodes, child, &key_start, &key_end) or key_end - key_start != 24
                return false if texts[key_start.usize()] != 102 or texts[(key_start + 1).usize()] != 110 or texts[(key_start + 2).usize()] != 118 or texts[(key_start + 3).usize()] != 49 or texts[(key_start + 4).usize()] != 97 or texts[(key_start + 5).usize()] != 54 or texts[(key_start + 6).usize()] != 52 or texts[(key_start + 7).usize()] != 58
                return false if not PostgresReport::rh_pg_report_hex16(texts, key_start + 8, key_end)
                if names_out.count > 0:
                    previous_start: usize = names_out.count - 17
                    order: mutable i64 = 0
                    while i < 16 |i: usize = 0, names_out, texts, previous_start, key_start, order|:
                        left: u8 = names_out[previous_start + i]
                        right: u8 = texts[(key_start + 8).usize() + i]
                        if left != right:
                            order <- -1 if left < right
                            order <- 1 if left > right
                            i <- 16
                        else:
                            i <- i + 1
                    return false if order >= 0
                while i < key_end |i: i64 = key_start + 8, texts, names_out|:
                    names_out.push(texts[i.usize()])
                    i <- i + 1
                names_out.push(10)
                child <- nodes[child.usize()].next_sibling
            true

        def rh_pg_report_evidence_gc_under_guard(conninfo: cstr, evidence_root: cstr, candidates: mutable darray[u8]&, candidate_count: mutable i64&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if Store::rh_store_gc_candidate_names_under_guard(evidence_root, candidates, candidate_count) != 0
            snapshot: mutable darray[u8] = []
            return -1 if Postgres::rh_pg_evidence_references(conninfo, snapshot) <= 0
            references: mutable darray[u8] = []
            reference_count: mutable i64 = 0
            return -1 if not PostgresReport::rh_pg_report_reference_names(snapshot, references, &reference_count)
            orphan_candidates: mutable darray[u8] = []
            while start < candidates.count |start: usize = 0, candidates, references, orphan_candidates|:
                stop: i64 = Base::rh_find_byte(candidates, start, 10)
                line_end: usize = stop.usize() if stop >= 0 else candidates.count
                referenced: bool = PostgresReport::rh_pg_report_reference_has(references, reference_count, candidates, start.i64(), line_end.i64())
                if line_end > start and not referenced:
                    while i < line_end |i: usize = start, candidates, orphan_candidates|:
                        orphan_candidates.push(candidates[i])
                        i <- i + 1
                    orphan_candidates.push(10)
                start <- candidates.count if stop < 0 else stop.usize() + 1
            deleted: mutable i64 = 0
            gc_result: i64 = Store::rh_store_gc_sorted_under_guard(evidence_root, candidates, references, reference_count, &deleted)
            Base::rh_push_text(out, "{\"schema\":\"rh-postgres-result/1\",\"operation\":\"evidence_gc\",\"status\":\"")
            Base::rh_push_text(out, "collected" if gc_result == 0 else "partial")
            Base::rh_push_text(out, "\",\"candidate_count\":")
            Base::rh_push_decimal_i64(out, candidate_count)
            Base::rh_push_text(out, ",\"deleted_count\":")
            Base::rh_push_decimal_i64(out, deleted)
            Base::rh_push_text(out, ",\"reference_count\":")
            Base::rh_push_decimal_i64(out, reference_count)
            Base::rh_push_text(out, ",\"deleted_names\":[")
            emitted: mutable i64 = 0
            while start < orphan_candidates.count and emitted < deleted |start: usize = 0, orphan_candidates, emitted, out|:
                stop: i64 = Base::rh_find_byte(orphan_candidates, start, 10)
                line_end: usize = stop.usize() if stop >= 0 else orphan_candidates.count
                if line_end > start:
                    Base::rh_push_text(out, "," if emitted > 0 else "")
                    out.push(34)
                    while i < line_end |i: usize = start, orphan_candidates, out|:
                        out.push(orphan_candidates[i])
                        i <- i + 1
                    out.push(34)
                    emitted <- emitted + 1
                start <- orphan_candidates.count if stop < 0 else stop.usize() + 1
            Base::rh_push_text(out, "]}")
            0

        def rh_pg_report_register_evidence_unlocked(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, root: i64, conninfo: cstr, evidence_root: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            evidence_id_s: mutable i64 = 0
            evidence_id_e: mutable i64 = 0
            visibility_s: mutable i64 = 0
            visibility_e: mutable i64 = 0
            blob_name_s: mutable i64 = 0
            blob_name_e: mutable i64 = 0
            media_s: mutable i64 = 0
            media_e: mutable i64 = 0
            retention_s: mutable i64 = 0
            retention_e: mutable i64 = 0
            transform_s: mutable i64 = 0
            transform_e: mutable i64 = 0
            created_s: mutable i64 = 0
            created_e: mutable i64 = 0
            return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "evidence_id", &evidence_id_s, &evidence_id_e, false)
            return -1 if not PostgresReport::rh_pg_report_uuid_valid(texts, evidence_id_s, evidence_id_e)
            return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "visibility_scope", &visibility_s, &visibility_e, false)
            return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "blob_name", &blob_name_s, &blob_name_e, false) or not PostgresReport::rh_pg_report_hex16(texts, blob_name_s, blob_name_e)
            return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "media_type", &media_s, &media_e, false)
            return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "retention_class", &retention_s, &retention_e, false)
            return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "transformation_kind", &transform_s, &transform_e, false)
            return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "created_at", &created_s, &created_e, false)
            return -1 if not PostgresReport::rh_pg_report_visibility_ok(texts, visibility_s, visibility_e)

            blob_path: mutable darray[u8] = []
            Base::rh_push_cstr(blob_path, evidence_root)
            blob_path.push(47)
            while i < blob_name_e |i: i64 = blob_name_s, blob_path, texts, blob_name_e|:
                blob_path.push(texts[i.usize()])
                i <- i + 1
            blob_path.push(0)
            blob_path_ptr: cstr = (&blob_path[0]).cast[cstr] can Unsafe.PointerCast
            byte_length: i64 = Base::rh_file_size(blob_path_ptr)
            return -1 if byte_length < 0 or byte_length > RH_PG_REPORT_MAX_EVIDENCE_BYTES
            blob: mutable darray[u8] = []
            return -1 if Base::rh_io_read(blob_path_ptr, blob) < 0 or blob.count.i64() != byte_length
            stored_name: mutable darray[u8] = []
            Base::rh_push_hex_u64(stored_name, hash_sview(bytes_view(blob)))
            return -1 if not Base::rh_bytes_equal_span(stored_name, 0, stored_name.count.i64(), texts, blob_name_s, blob_name_e)
            digest_value: mutable darray[u8] = []
            Sha256::rh_sha256(blob, digest_value)
            digest_value.push(0)
            digest_ptr: cstr = (&digest_value[0]).cast[cstr] can Unsafe.PointerCast

            evidence_id: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, evidence_id_s, evidence_id_e)
            visibility: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, visibility_s, visibility_e)
            media: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, media_s, media_e)
            retention: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, retention_s, retention_e)
            transform: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, transform_s, transform_e)
            created_at: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, created_s, created_e)
            storage_key: mutable darray[u8] = []
            Base::rh_push_text(storage_key, "fnv1a64:")
            while i < blob_name_e |i: i64 = blob_name_s, storage_key, texts, blob_name_e|:
                storage_key.push(texts[i.usize()])
                i <- i + 1
            storage_key.push(0)
            evidence_ptr: cstr = (&evidence_id[0]).cast[cstr] can Unsafe.PointerCast
            visibility_ptr: cstr = (&visibility[0]).cast[cstr] can Unsafe.PointerCast
            media_ptr: cstr = (&media[0]).cast[cstr] can Unsafe.PointerCast
            storage_ptr: cstr = (&storage_key[0]).cast[cstr] can Unsafe.PointerCast
            retention_ptr: cstr = (&retention[0]).cast[cstr] can Unsafe.PointerCast
            transform_ptr: cstr = (&transform[0]).cast[cstr] can Unsafe.PointerCast
            created_ptr: cstr = (&created_at[0]).cast[cstr] can Unsafe.PointerCast
            registered: i64 = Postgres::rh_pg_register_evidence_object(conninfo, evidence_ptr, visibility_ptr, digest_ptr, byte_length, media_ptr, storage_ptr, retention_ptr, transform_ptr, created_ptr)
            return -1 if registered < 0
            Base::rh_push_text(out, "{\"schema\":\"rh-postgres-result/1\",\"operation\":\"register_evidence\",\"status\":\"")
            Base::rh_push_text(out, "registered" if registered == 1 else "duplicate")
            Base::rh_push_text(out, "\",\"evidence_id\":")
            PostgresReport::rh_pg_report_emit_text(out, texts, evidence_id_s, evidence_id_e)
            Base::rh_push_text(out, ",\"digest_algorithm\":\"sha256\",\"digest_value\":")
            PostgresReport::rh_pg_report_emit_cstr(out, digest_value)
            Base::rh_push_text(out, ",\"byte_length\":")
            Base::rh_push_decimal_i64(out, byte_length)
            Base::rh_push_text(out, ",\"storage_key\":")
            PostgresReport::rh_pg_report_emit_cstr(out, storage_key)
            Base::rh_push_text(out, "}")
            0

        def rh_pg_report_ingest_evidence_local_valid(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, evidence: i64, evidence_root: cstr, total_bytes: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            evidence_id_start: mutable i64 = 0
            evidence_id_end: mutable i64 = 0
            visibility_start: mutable i64 = 0
            visibility_end: mutable i64 = 0
            blob_name_start: mutable i64 = 0
            blob_name_end: mutable i64 = 0
            media_start: mutable i64 = 0
            media_end: mutable i64 = 0
            retention_start: mutable i64 = 0
            retention_end: mutable i64 = 0
            transformation_start: mutable i64 = 0
            transformation_end: mutable i64 = 0
            created_start: mutable i64 = 0
            created_end: mutable i64 = 0
            return false if nodes[evidence.usize()].kind != Json::RH_JSON_OBJ
            return false if not PostgresReport::rh_pg_report_span(nodes, texts, evidence, "evidence_id", &evidence_id_start, &evidence_id_end, false) or not PostgresReport::rh_pg_report_uuid_valid(texts, evidence_id_start, evidence_id_end)
            return false if not PostgresReport::rh_pg_report_span(nodes, texts, evidence, "visibility_scope", &visibility_start, &visibility_end, false) or not PostgresReport::rh_pg_report_visibility_ok(texts, visibility_start, visibility_end)
            return false if not PostgresReport::rh_pg_report_span(nodes, texts, evidence, "blob_name", &blob_name_start, &blob_name_end, false) or not PostgresReport::rh_pg_report_hex16(texts, blob_name_start, blob_name_end)
            return false if not PostgresReport::rh_pg_report_span(nodes, texts, evidence, "media_type", &media_start, &media_end, false)
            return false if not PostgresReport::rh_pg_report_span(nodes, texts, evidence, "retention_class", &retention_start, &retention_end, false)
            return false if not PostgresReport::rh_pg_report_span(nodes, texts, evidence, "transformation_kind", &transformation_start, &transformation_end, false)
            return false if not PostgresReport::rh_pg_report_span(nodes, texts, evidence, "created_at", &created_start, &created_end, false)
            blob_path: mutable darray[u8] = []
            Base::rh_push_cstr(blob_path, evidence_root)
            blob_path.push(47)
            while index < blob_name_end - blob_name_start |index: i64 = 0, blob_path, texts, blob_name_start, blob_name_end|:
                blob_path.push(texts[(blob_name_start + index).usize()])
                index <- index + 1
            blob_path.push(0)
            blob_path_ptr: cstr = (&blob_path[0]).cast[cstr] can Unsafe.PointerCast
            byte_length: i64 = Base::rh_file_size(blob_path_ptr)
            return false if byte_length < 0 or byte_length > RH_PG_REPORT_MAX_EVIDENCE_BYTES or total_bytes[0] > RH_PG_REPORT_MAX_INGEST_EVIDENCE_BYTES - byte_length
            blob_name: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, blob_name_start, blob_name_end)
            blob_name_ptr: u8& = (&blob_name[0]).cast[u8&] can Unsafe.PointerCast
            verified: mutable i64 = 0
            return false if Store::rh_store_blob_verify(evidence_root, blob_name_ptr, &verified) != 0 or verified == 0
            total_bytes[0] <- total_bytes[0] + byte_length
            true

    public:
        # Register evidence objects embedded in a normalized PostgreSQL ingest
        # input while holding the blob root guard across verification and inserts.
        def rh_postgres_register_ingest_evidence(raw: darray[u8]&, conninfo: cstr, evidence_root: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if raw.count == 0 or raw.count > RH_PG_REPORT_MAX_INGEST_BYTES or Base::rh_cstr_len_c(evidence_root) == 0 or Base::rh_cstr_len_c(evidence_root) > 4096
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_start: mutable i64 = 0
            schema_end: mutable i64 = 0
            return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "schema", &schema_start, &schema_end, false) or not PostgresReport::rh_pg_report_eq(texts, schema_start, schema_end, "rh-postgres-ingest-input/1")
            objects_index: i64 = Json::rh_json_obj_get(nodes, texts, root, "evidence_objects")
            return 0 if objects_index < 0
            return -1 if nodes[objects_index.usize()].kind != Json::RH_JSON_ARR or nodes[objects_index.usize()].child_count > 1000
            return 0 if nodes[objects_index.usize()].child_count == 0

            guard_fd: mutable i32 = -1
            return -1 if Store::rh_store_guard_acquire(evidence_root, &guard_fd) != 0
            failed: mutable bool = false
            total_bytes: mutable i64 = 0
            while evidence >= 0 and not failed |evidence: i64 = nodes[objects_index.usize()].first_child, nodes, texts, evidence_root, failed, total_bytes|:
                failed <- not PostgresReport::rh_pg_report_ingest_evidence_local_valid(nodes, texts, evidence, evidence_root, &total_bytes)
                evidence <- nodes[evidence.usize()].next_sibling if not failed
            while registration_node >= 0 and not failed |registration_node: i64 = nodes[objects_index.usize()].first_child, nodes, texts, conninfo, evidence_root, failed|:
                registration: i64 =
                    report: mutable darray[u8] = []
                    PostgresReport::rh_pg_report_register_evidence_unlocked(nodes, texts, registration_node, conninfo, evidence_root, report)
                failed <- registration != 0
                registration_node <- nodes[registration_node.usize()].next_sibling if not failed
            released: i64 = Store::rh_store_guard_release(guard_fd)
            return -1 if failed or released != 0
            0

        # Commands contain no connection settings. RH_DATABASE_URL is read by
        # the CLI and is never copied into the result or diagnostics.
        def rh_postgres_command(raw: darray[u8]&, conninfo: cstr, evidence_root: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if raw.count == 0 or raw.count > RH_PG_REPORT_MAX_NORMALIZATION_BYTES or Base::rh_cstr_len_c(conninfo) == 0 or Base::rh_cstr_len_c(conninfo) > 4096
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse_large_bounded(raw, nodes, texts, 2000000) if raw.count > RH_PG_REPORT_MAX_BYTES else Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ

            schema_s: mutable i64 = 0
            schema_e: mutable i64 = 0
            return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "schema", &schema_s, &schema_e, false)
            return -1 if not PostgresReport::rh_pg_report_eq(texts, schema_s, schema_e, "rh-postgres-command/1")
            operation_s: mutable i64 = 0
            operation_e: mutable i64 = 0
            return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "operation", &operation_s, &operation_e, false)

            normalization_operation: bool = PostgresReport::rh_pg_report_eq(texts, operation_s, operation_e, "commit_staged_normalization")
            projection_operation: bool = PostgresReport::rh_pg_report_eq(texts, operation_s, operation_e, "store_graph_projection")
            projection_chunk_operation: bool = PostgresReport::rh_pg_report_eq(texts, operation_s, operation_e, "stage_graph_projection_chunk")
            return -1 if raw.count > RH_PG_REPORT_MAX_BYTES and not normalization_operation and not projection_operation and not projection_chunk_operation
            return -1 if projection_operation and raw.count > RH_PG_REPORT_MAX_NORMALIZATION_BYTES
            return -1 if projection_chunk_operation and raw.count > 4194304

            if normalization_operation:
                normalization_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "normalization")
                return -1 if normalization_idx < 0 or nodes[normalization_idx.usize()].kind != Json::RH_JSON_OBJ
                normalization_schema_s: mutable i64 = 0
                normalization_schema_e: mutable i64 = 0
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, normalization_idx, "schema", &normalization_schema_s, &normalization_schema_e, false)
                return -1 if not PostgresReport::rh_pg_report_eq(texts, normalization_schema_s, normalization_schema_e, "rh-postgres-staged-normalize-result/1")

                source_s: mutable i64 = 0
                source_e: mutable i64 = 0
                run_s: mutable i64 = 0
                run_e: mutable i64 = 0
                input_sha_s: mutable i64 = 0
                input_sha_e: mutable i64 = 0
                config_sha_s: mutable i64 = 0
                config_sha_e: mutable i64 = 0
                normalizer_s: mutable i64 = 0
                normalizer_e: mutable i64 = 0
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, normalization_idx, "source_id", &source_s, &source_e, false) or not PostgresReport::rh_pg_report_uuid_valid(texts, source_s, source_e)
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, normalization_idx, "collection_run_id", &run_s, &run_e, false) or not PostgresReport::rh_pg_report_uuid_valid(texts, run_s, run_e)
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, normalization_idx, "input_sha256", &input_sha_s, &input_sha_e, false) or not PostgresReport::rh_pg_report_hex64(texts, input_sha_s, input_sha_e)
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, normalization_idx, "configuration_sha256", &config_sha_s, &config_sha_e, false) or not PostgresReport::rh_pg_report_hex64(texts, config_sha_s, config_sha_e)
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, normalization_idx, "normalizer", &normalizer_s, &normalizer_e, false) or normalizer_e - normalizer_s > 128
                return -1 if not PostgresReport::rh_pg_report_eq(texts, normalizer_s, normalizer_e, "rh-forge-events/1")

                normalized_idx: i64 = Json::rh_json_obj_get(nodes, texts, normalization_idx, "normalized")
                return -1 if normalized_idx < 0 or nodes[normalized_idx.usize()].kind != Json::RH_JSON_OBJ
                normalized_schema_s: mutable i64 = 0
                normalized_schema_e: mutable i64 = 0
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, normalized_idx, "schema", &normalized_schema_s, &normalized_schema_e, false)
                return -1 if not PostgresReport::rh_pg_report_eq(texts, normalized_schema_s, normalized_schema_e, "rh-forge-events-result/1")
                captured_ok: mutable i64 = 0
                captured_at: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, normalized_idx, "captured_at"), &captured_ok)
                return -1 if captured_ok == 0 or captured_at < 0 or captured_at > 253402300799
                events_idx: i64 = Json::rh_json_obj_get(nodes, texts, normalized_idx, "events")
                return -1 if events_idx < 0 or nodes[events_idx.usize()].kind != Json::RH_JSON_ARR or nodes[events_idx.usize()].child_count > 10000

                while event_idx >= 0 |event_idx: i64 = nodes[events_idx.usize()].first_child, nodes, raw, texts|:
                    return -1 if nodes[event_idx.usize()].kind != Json::RH_JSON_OBJ
                    event_kind_s: mutable i64 = 0
                    event_kind_e: mutable i64 = 0
                    native_id_s: mutable i64 = 0
                    native_id_e: mutable i64 = 0
                    return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, event_idx, "kind", &event_kind_s, &event_kind_e, false)
                    return -1 if not PostgresReport::rh_pg_report_eq(texts, event_kind_s, event_kind_e, "issues") and not PostgresReport::rh_pg_report_eq(texts, event_kind_s, event_kind_e, "proposals") and not PostgresReport::rh_pg_report_eq(texts, event_kind_s, event_kind_e, "reviews") and not PostgresReport::rh_pg_report_eq(texts, event_kind_s, event_kind_e, "releases")
                    return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, event_idx, "native_id", &native_id_s, &native_id_e, false) or native_id_e - native_id_s > 512
                    created_ok: mutable i64 = 0
                    created_at: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, event_idx, "created_at"), &created_ok)
                    return -1 if created_ok == 0 or created_at < 0 or created_at > 253402300799
                    status_idx: i64 = Json::rh_json_obj_get(nodes, texts, event_idx, "status")
                    return -1 if status_idx >= 0 and nodes[status_idx.usize()].kind != Json::RH_JSON_STR
                    origin_idx: i64 = Json::rh_json_obj_get(nodes, texts, event_idx, "staged_origin")
                    return -1 if origin_idx < 0 or nodes[origin_idx.usize()].kind != Json::RH_JSON_OBJ
                    page_ok: mutable i64 = 0
                    page_number: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, origin_idx, "page_number"), &page_ok)
                    return -1 if page_ok == 0 or page_number < 0 or page_number > 2147483647
                    ordinal_ok: mutable i64 = 0
                    record_ordinal: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, origin_idx, "record_ordinal"), &ordinal_ok)
                    return -1 if ordinal_ok == 0 or record_ordinal < 0 or record_ordinal > 2147483647
                    evidence_s: mutable i64 = 0
                    evidence_e: mutable i64 = 0
                    return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, origin_idx, "evidence_id", &evidence_s, &evidence_e, false) or not PostgresReport::rh_pg_report_uuid_valid(texts, evidence_s, evidence_e)
                    event_idx <- nodes[event_idx.usize()].next_sibling

                event_node: Json::RhJsonNode = nodes[events_idx.usize()]
                return -1 if event_node.text_start < 0 or event_node.text_end <= event_node.text_start or event_node.text_end - event_node.text_start > 16777216
                events_json: mutable darray[u8] = []
                while raw_index < event_node.text_end |raw_index: i64 = event_node.text_start, raw, event_node, events_json|:
                    events_json.push(raw[raw_index.usize()])
                    raw_index <- raw_index + 1
                output_sha: mutable darray[u8] = []
                Sha256::rh_sha256(events_json, output_sha)
                output_sha.push(0)
                events_json.push(0)

                source_bytes: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, source_s, source_e)
                run_bytes: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, run_s, run_e)
                input_sha_bytes: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, input_sha_s, input_sha_e)
                config_sha_bytes: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, config_sha_s, config_sha_e)
                normalizer_bytes: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, normalizer_s, normalizer_e)
                source_ptr: cstr = (&source_bytes[0]).cast[cstr] can Unsafe.PointerCast
                run_ptr: cstr = (&run_bytes[0]).cast[cstr] can Unsafe.PointerCast
                input_sha_ptr: cstr = (&input_sha_bytes[0]).cast[cstr] can Unsafe.PointerCast
                config_sha_ptr: cstr = (&config_sha_bytes[0]).cast[cstr] can Unsafe.PointerCast
                normalizer_ptr: cstr = (&normalizer_bytes[0]).cast[cstr] can Unsafe.PointerCast
                output_sha_ptr: cstr = (&output_sha[0]).cast[cstr] can Unsafe.PointerCast
                events_json_ptr: cstr = (&events_json[0]).cast[cstr] can Unsafe.PointerCast
                committed: i64 = Postgres::rh_pg_commit_staged_normalization(conninfo, source_ptr, run_ptr, input_sha_ptr, config_sha_ptr, output_sha_ptr, normalizer_ptr, captured_at, events_json_ptr)
                return -1 if committed < 0
                Base::rh_push_text(out, "{\"schema\":\"rh-postgres-result/1\",\"operation\":\"commit_staged_normalization\",\"status\":\"")
                Base::rh_push_text(out, "committed\"" if committed == 1 else "duplicate\"")
                Base::rh_push_text(out, ",\"event_count\":")
                Base::rh_push_decimal_i64(out, event_node.child_count)
                Base::rh_push_text(out, ",\"input_sha256\":\"")
                Base::rh_json_escape(out, texts, input_sha_s.usize(), input_sha_e.usize())
                Base::rh_push_text(out, "\",\"configuration_sha256\":\"")
                Base::rh_json_escape(out, texts, config_sha_s.usize(), config_sha_e.usize())
                Base::rh_push_text(out, "\",\"output_sha256\":\"")
                while sha_index < 64 |sha_index: usize = 0, output_sha, out|:
                    out.push(output_sha[sha_index])
                    sha_index <- sha_index + 1
                Base::rh_push_text(out, "\"}")
                return 0

            if projection_chunk_operation:
                chunk_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "chunk")
                return -1 if chunk_idx < 0 or nodes[chunk_idx.usize()].kind != Json::RH_JSON_OBJ
                chunk_node: Json::RhJsonNode = nodes[chunk_idx.usize()]
                return -1 if chunk_node.text_start < 0 or chunk_node.text_end <= chunk_node.text_start or chunk_node.text_end - chunk_node.text_start > 4194304
                chunk_json: mutable darray[u8] = []
                while raw_offset < chunk_node.text_end |raw_offset: i64 = chunk_node.text_start, raw, chunk_node, chunk_json|:
                    chunk_json.push(raw[raw_offset.usize()])
                    raw_offset <- raw_offset + 1
                chunk_json.push(0)
                chunk_ptr: cstr = (&chunk_json[0]).cast[cstr] can Unsafe.PointerCast
                staged_status: mutable darray[u8] = []
                return -1 if Postgres::rh_pg_stage_graph_projection_chunk(conninfo, chunk_ptr, staged_status) <= 0
                Base::rh_push_text(out, "{\"schema\":\"rh-postgres-result/1\",\"operation\":\"stage_graph_projection_chunk\",\"status\":\"")
                out.extend(bytes_view(staged_status))
                Base::rh_push_text(out, "\"}")
                return 0

            if PostgresReport::rh_pg_report_eq(texts, operation_s, operation_e, "reconcile_source_objects"):
                source_s: mutable i64 = 0
                source_e: mutable i64 = 0
                run_s: mutable i64 = 0
                run_e: mutable i64 = 0
                capability_s: mutable i64 = 0
                capability_e: mutable i64 = 0
                scope_s: mutable i64 = 0
                scope_e: mutable i64 = 0
                acquisition_s: mutable i64 = 0
                acquisition_e: mutable i64 = 0
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "source_instance_id", &source_s, &source_e, false) or not PostgresReport::rh_pg_report_uuid_valid(texts, source_s, source_e)
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "collection_run_id", &run_s, &run_e, false) or not PostgresReport::rh_pg_report_uuid_valid(texts, run_s, run_e)
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "capability", &capability_s, &capability_e, false) or capability_e - capability_s > 128
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "scope", &scope_s, &scope_e, false) or scope_e - scope_s > 512
                return -1 if not PostgresReport::rh_pg_report_span(nodes, texts, root, "acquisition", &acquisition_s, &acquisition_e, false)
                complete_acquisition: bool = PostgresReport::rh_pg_report_eq(texts, acquisition_s, acquisition_e, "complete")
                empty_acquisition: bool = PostgresReport::rh_pg_report_eq(texts, acquisition_s, acquisition_e, "empty")
                partial_acquisition: bool = PostgresReport::rh_pg_report_eq(texts, acquisition_s, acquisition_e, "partial")
                failed_acquisition: bool = PostgresReport::rh_pg_report_eq(texts, acquisition_s, acquisition_e, "failed")
                unsupported_acquisition: bool = PostgresReport::rh_pg_report_eq(texts, acquisition_s, acquisition_e, "unsupported")
                return -1 if not complete_acquisition and not empty_acquisition and not partial_acquisition and not failed_acquisition and not unsupported_acquisition
                captured_at: mutable i64 = 0
                return -1 if not PostgresReport::rh_pg_report_int(nodes, raw, texts, root, "captured_at", 0, 253402300799, &captured_at)
                observed_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "observed")
                return -1 if observed_idx < 0 or nodes[observed_idx.usize()].kind != Json::RH_JSON_ARR or nodes[observed_idx.usize()].child_count > 100000
                observed_node: Json::RhJsonNode = nodes[observed_idx.usize()]
                return -1 if observed_node.text_start < 0 or observed_node.text_end <= observed_node.text_start or observed_node.text_end - observed_node.text_start > 1048576
                observed_count: mutable i64 = 0
                observed_bytes: mutable i64 = 0
                while observed_child >= 0 |observed_child: i64 = observed_node.first_child, nodes, texts, observed_count, observed_bytes|:
                    return -1 if nodes[observed_child.usize()].kind != Json::RH_JSON_STR
                    id_s: mutable i64 = 0
                    id_e: mutable i64 = 0
                    return -1 if not Json::rh_json_str_span(nodes, observed_child, &id_s, &id_e) or id_e <= id_s or id_e - id_s > 512
                    while id_offset < id_e - id_s |id_offset: i64 = 0, texts, id_s, id_e|:
                        return -1 if texts[(id_s + id_offset).usize()] == 0
                        id_offset <- id_offset + 1
                    observed_bytes <- observed_bytes + id_e - id_s
                    return -1 if observed_bytes > 4194304
                    observed_count <- observed_count + 1
                    observed_child <- nodes[observed_child.usize()].next_sibling
                return -1 if (empty_acquisition or failed_acquisition or unsupported_acquisition) and observed_count != 0
                return -1 if complete_acquisition and observed_count == 0
                observed_json: mutable darray[u8] = []
                while observed_offset < observed_node.text_end |observed_offset: i64 = observed_node.text_start, observed_node, raw, observed_json|:
                    observed_json.push(raw[observed_offset.usize()])
                    observed_offset <- observed_offset + 1
                observed_json.push(0)
                source_bytes: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, source_s, source_e)
                run_bytes: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, run_s, run_e)
                capability_bytes: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, capability_s, capability_e)
                scope_bytes: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, scope_s, scope_e)
                acquisition_bytes: mutable darray[u8] = PostgresReport::rh_pg_report_text(texts, acquisition_s, acquisition_e)
                source_ptr: cstr = (&source_bytes[0]).cast[cstr] can Unsafe.PointerCast
                run_ptr: cstr = (&run_bytes[0]).cast[cstr] can Unsafe.PointerCast
                capability_ptr: cstr = (&capability_bytes[0]).cast[cstr] can Unsafe.PointerCast
                scope_ptr: cstr = (&scope_bytes[0]).cast[cstr] can Unsafe.PointerCast
                acquisition_ptr: cstr = (&acquisition_bytes[0]).cast[cstr] can Unsafe.PointerCast
                observed_ptr: cstr = (&observed_json[0]).cast[cstr] can Unsafe.PointerCast
                reconciliation: mutable darray[u8] = []
                return -1 if Postgres::rh_pg_reconcile_source_objects(conninfo, source_ptr, run_ptr, capability_ptr, scope_ptr, acquisition_ptr, observed_ptr, captured_at, reconciliation) <= 0
                Base::rh_push_text(out, "{\"schema\":\"rh-postgres-result/1\",\"operation\":\"reconcile_source_objects\",\"status\":\"recorded\",\"reconciliation\":")
                out.extend(bytes_view(reconciliation))
                out.push(125)
                return 0

            if PostgresReport::rh_pg_report_eq(texts, operation_s, operation_e, "evidence_references"):
                references: mutable darray[u8] = []
                return -1 if Postgres::rh_pg_evidence_references(conninfo, references) <= 0
                Base::rh_push_text(out, "{\"schema\":\"rh-postgres-result/1\",\"operation\":\"evidence_references\",\"status\":\"listed\",\"reference_snapshot\":")
                out.extend(bytes_view(references))
                out.push(125)
                return 0

            if PostgresReport::rh_pg_report_eq(texts, operation_s, operation_e, "evidence_gc"):
                return -1 if Base::rh_cstr_len_c(evidence_root) == 0 or Base::rh_cstr_len_c(evidence_root) > 4096
                candidates: mutable darray[u8] = []
                candidate_count: mutable i64 = 0
                guard_fd: mutable i32 = -1
                return -1 if Store::rh_store_guard_acquire(evidence_root, &guard_fd) != 0
                result: i64 = PostgresReport::rh_pg_report_evidence_gc_under_guard(conninfo, evidence_root, &candidates, &candidate_count, out)
                released: i64 = Store::rh_store_guard_release(guard_fd)
                return -1 if result != 0 or released != 0
                return 0

            if PostgresReport::rh_pg_report_eq(texts, operation_s, operation_e, "register_evidence"):
                return -1 if Base::rh_cstr_len_c(evidence_root) == 0 or Base::rh_cstr_len_c(evidence_root) > 4096
                guard_fd: mutable i32 = -1
                return -1 if Store::rh_store_guard_acquire(evidence_root, &guard_fd) != 0
                result: i64 = PostgresReport::rh_pg_report_register_evidence_unlocked(nodes, texts, root, conninfo, evidence_root, out)
                released: i64 = Store::rh_store_guard_release(guard_fd)
