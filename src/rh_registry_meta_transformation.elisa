# Field transformation contract for registry version metadata.
include "./rh_base.elisa"

module RegistryMetaTransformation:
    public:
        def rh_registry_meta_transformation_report(configuration_sha: darray[u8]&,
                                                   input_sha: darray[u8]&,
                                                   output_sha: darray[u8]&,
                                                   out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"registry-version-metadata\",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-registry-meta-result/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"num|version\",\"target\":\"versions[].version\",\"state\":\"preserved\"},{\"source\":\"yanked|deprecated\",\"target\":\"versions[].yanked|deprecated\",\"state\":\"preserved\"},{\"source\":\"time fields\",\"target\":\"versions[].published_at\",\"state\":\"transformed\"},{\"source\":\"repository/source links\",\"target\":\"versions[].repository|source_link\",\"state\":\"transformed\"},{\"source\":\"dependency counts\",\"target\":\"versions[].*_dep_count\",\"state\":\"preserved\"},{\"source\":\"missing optional fields\",\"target\":\"null values and unknown counts\",\"state\":\"unknown\"},{\"source\":\"provider fields outside contract\",\"target\":\"metadata result\",\"state\":\"discarded\"}]}")
