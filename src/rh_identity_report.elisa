# rh_identity_report.elisa — reversible identity-link execution path
# (M04-03, R016).
#
# Turns an `rh-identity-input/1` link ledger into `rh-identity-result/1`:
# the identity revision, clusters derived ONLY from accepted links, and a
# per-actor cluster map. A rejected or revoked link changes nothing;
# revoking an accepted link recomputes clusters and changes the revision
# without rewriting any raw record. Duplicate/repeated accepted links still
# count toward the revision (each accepted-state change is a revision step),
# matching Identity::rh_identity_revision. Malformed input fails closed.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_identity.elisa"

module IdentityReport:
    private:
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_ir_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_ir_link_state(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Identity::RH_LINK_PROPOSED if rh_ir_eq(texts, s, e, "proposed")
            return Identity::RH_LINK_ACCEPTED if rh_ir_eq(texts, s, e, "accepted")
            return Identity::RH_LINK_REJECTED if rh_ir_eq(texts, s, e, "rejected")
            return Identity::RH_LINK_REVOKED if rh_ir_eq(texts, s, e, "revoked")
            -1

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_ir_actor_kind(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Identity::RH_ACTOR_HUMAN if rh_ir_eq(texts, s, e, "human")
            return Identity::RH_ACTOR_BOT_KNOWN if rh_ir_eq(texts, s, e, "bot_known")
            return Identity::RH_ACTOR_UNRESOLVED if rh_ir_eq(texts, s, e, "unresolved")
            -1

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_ir_state_label(s: u8) -> u8&:
            return "accepted" if s == Identity::RH_LINK_ACCEPTED
            return "rejected" if s == Identity::RH_LINK_REJECTED
            return "revoked" if s == Identity::RH_LINK_REVOKED
            "proposed"

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_ir_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            ok_out[0] <- 0
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return 0 if idx < 0
            Json::rh_json_int(nodes, raw, idx, ok_out)

        struct RhIdentityActor:
            source_s: mutable i64
            source_e: mutable i64
            instance_s: mutable i64
            instance_e: mutable i64
            native_s: mutable i64
            native_e: mutable i64
            display_s: mutable i64
            display_e: mutable i64
            alias_start: mutable i64
            alias_count: mutable i64

        struct RhIdentityAlias:
            value_s: mutable i64
            value_e: mutable i64
            observed_at: mutable i64

    public:
        def rh_identity_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            sspan: mutable i64 = 0
            espan: mutable i64 = 0
            sidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
            return -1 if sidx < 0 or not Json::rh_json_str_span(nodes, sidx, &sspan, &espan)
            return -1 if not rh_ir_eq(texts, sspan, espan, "rh-identity-input/1")
            oks: mutable i64 = 0
            actor_count: i64 = rh_ir_int(nodes, raw, texts, root, "actor_count", &oks)
            return -1 if oks == 0 or actor_count < 0 or actor_count > 1000000
            links_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "links")
            return -1 if links_idx < 0 or nodes[links_idx.usize()].kind != Json::RH_JSON_ARR
            links: mutable darray[Identity::RhIdentityLink] = []
            arr: Json::RhJsonNode = nodes[links_idx.usize()]
            while child >= 0 |child: i64 = arr.first_child, nodes, texts, raw, links, actor_count|:
                return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                oka: mutable i64 = 0
                okb: mutable i64 = 0
                a: i64 = rh_ir_int(nodes, raw, texts, child, "a", &oka)
                b: i64 = rh_ir_int(nodes, raw, texts, child, "b", &okb)
                return -1 if oka == 0 or okb == 0 or a < 0 or b < 0 or a >= actor_count or b >= actor_count
                state: i64 = |nodes, texts|
                    sts: mutable i64 = 0
                    ste: mutable i64 = 0
                    return -1 if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, child, "state"), &sts, &ste)
                    block_result: i64 = rh_ir_link_state(texts, sts, ste)
                    block_result
                return -1 if state < 0
                radd: i64 = |nodes, texts|
                    okr: mutable i64 = 0
                    block_result: i64 = rh_ir_int(nodes, raw, texts, child, "revision_added", &okr)
                    block_result
                links.push(Identity::RhIdentityLink{a: a, b: b, state: state.u8(), revision_added: radd})
                child <- nodes[child.usize()].next_sibling
            rev: i64 = Identity::rh_identity_revision(links)
            parent: mutable darray[i64] = []
            cmap: mutable darray[i64] = []
            clusters: i64 = Identity::rh_identity_clusters(links, actor_count, parent, cmap)

            # Optional actor-kind stratification.
            has_kinds: mutable bool = false
            humans: mutable i64 = 0
            bots: mutable i64 = 0
            unresolved: mutable i64 = 0
            kinds_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "actor_kinds")
            if kinds_idx >= 0:
                return -1 if nodes[kinds_idx.usize()].kind != Json::RH_JSON_ARR
                has_kinds <- true
                kinds: mutable darray[u8] = []
                karr: Json::RhJsonNode = nodes[kinds_idx.usize()]
                while kc >= 0 |kc: i64 = karr.first_child, nodes, texts, kinds|:
                    code: i64 = |nodes, texts|
                        kxs: mutable i64 = 0
                        kxe: mutable i64 = 0
                        return -1 if not Json::rh_json_str_span(nodes, kc, &kxs, &kxe)
                        block_result: i64 = rh_ir_actor_kind(texts, kxs, kxe)
                        block_result
                    return -1 if code < 0
                    kinds.push(code.u8())
                    kc <- nodes[kc.usize()].next_sibling
                Identity::rh_actor_kinds(kinds, &humans, &bots, &unresolved)

            # Optional source-native actor metadata. When present, this is an
            # immutable namespace/alias ledger: display names never identify actors,
            # and aliases remain attached to their source instance and observation.
            actors: mutable darray[RhIdentityActor] = []
            aliases: mutable darray[RhIdentityAlias] = []
            actors_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "actors")
            if actors_idx >= 0:
                return -1 if nodes[actors_idx.usize()].kind != Json::RH_JSON_ARR
                actor_node: Json::RhJsonNode = nodes[actors_idx.usize()]
                while actor >= 0 |actor: i64 = actor_node.first_child, nodes, texts, raw, actors, aliases, actor_count|:
                    return -1 if actors.count.i64() >= actor_count or nodes[actor.usize()].kind != Json::RH_JSON_OBJ
                    source_s: mutable i64 = 0
                    source_e: mutable i64 = 0
                    instance_s: mutable i64 = 0
                    instance_e: mutable i64 = 0
                    native_s: mutable i64 = 0
                    native_e: mutable i64 = 0
                    display_s: mutable i64 = 0
                    display_e: mutable i64 = 0
                    return -1 if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, actor, "source"), &source_s, &source_e) or not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, actor, "source_instance"), &instance_s, &instance_e) or not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, actor, "native_object_id"), &native_s, &native_e) or not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, actor, "display_name"), &display_s, &display_e)
                    return -1 if source_s == source_e or instance_s == instance_e or native_s == native_e or display_s == display_e
                    aliases_idx: i64 = Json::rh_json_obj_get(nodes, texts, actor, "aliases")
                    return -1 if aliases_idx < 0 or nodes[aliases_idx.usize()].kind != Json::RH_JSON_ARR
                    alias_start: i64 = aliases.count.i64()
                    while alias >= 0 |alias: i64 = nodes[aliases_idx.usize()].first_child, nodes, texts, raw, aliases|:
                        return -1 if nodes[alias.usize()].kind != Json::RH_JSON_OBJ
                        alias_s: mutable i64 = 0
                        alias_e: mutable i64 = 0
                        return -1 if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, alias, "value"), &alias_s, &alias_e) or alias_s == alias_e
                        alias_ok: mutable i64 = 0
                        alias_time: i64 = rh_ir_int(nodes, raw, texts, alias, "observed_at", &alias_ok)
                        return -1 if alias_ok == 0 or alias_time < 0
                        aliases.push(RhIdentityAlias{value_s: alias_s, value_e: alias_e, observed_at: alias_time})
                        alias <- nodes[alias.usize()].next_sibling
                    actors.push(RhIdentityActor{source_s: source_s, source_e: source_e, instance_s: instance_s, instance_e: instance_e, native_s: native_s, native_e: native_e, display_s: display_s, display_e: display_e, alias_start: alias_start, alias_count: aliases.count.i64() - alias_start})
                    actor <- nodes[actor.usize()].next_sibling
                return -1 if actors.count.i64() != actor_count

            Base::rh_push_text(out, "{\"schema\":\"rh-identity-result/1\",\"actor_count\":")
            Base::rh_push_decimal_i64(out, actor_count)
            Base::rh_push_text(out, ",\"identity_revision\":")
            Base::rh_push_decimal_i64(out, rev)
            Base::rh_push_text(out, ",\"cluster_count\":")
            Base::rh_push_decimal_i64(out, clusters)
            Base::rh_push_text(out, ",\"cluster_id_by_actor\":[")
            while m < actor_count |m: i64 = 0, cmap, out|:
                if m > 0:
                    out.push(44)
                cid: i64 = Identity::rh_cluster_of(cmap, m)
                Base::rh_push_decimal_i64(out, cid)
                m <- m + 1
            Base::rh_push_text(out, "],\"clusters\":[")
            while g < actor_count |first_group: bool = true, g: i64 = 0, cmap, actor_count, out|:
                croot: i64 = Identity::rh_cluster_of(cmap, g)
                seen_before: bool =
                    while p < g |seen_before: bool = false, p: i64 = 0, cmap| -> seen_before:
                        if Identity::rh_cluster_of(cmap, p) == croot:
                            seen_before <- true
                        p <- p + 1
                if not seen_before:
                    if not first_group:
                        out.push(44)
                    first_group <- false
                    out.push(91)
                    while q < actor_count |inner_first: bool = true, q: i64 = 0, cmap, croot, out|:
                        if Identity::rh_cluster_of(cmap, q) == croot:
                            if not inner_first:
                                out.push(44)
                            inner_first <- false
                            Base::rh_push_decimal_i64(out, q)
                        q <- q + 1
                    out.push(93)
                g <- g + 1
            Base::rh_push_text(out, "]")
            if has_kinds:
                Base::rh_push_text(out, ",\"actor_kinds\":{\"human\":")
                Base::rh_push_decimal_i64(out, humans)
                Base::rh_push_text(out, ",\"bot_known\":")
                Base::rh_push_decimal_i64(out, bots)
                Base::rh_push_text(out, ",\"unresolved\":")
                Base::rh_push_decimal_i64(out, unresolved)
                Base::rh_push_text(out, "}")
            if actors.count.i64() > 0:
                Base::rh_push_text(out, ",\"actors\":[")
                while i < actors.count |i: usize = 0, actors, aliases, texts, out|:
                    if i > 0:
                        out.push(44)
                    actor: RhIdentityActor = actors[i]
                    Base::rh_push_text(out, "{\"source\":")
                    out.push(34)
                    Base::rh_json_escape(out, texts, actor.source_s.usize(), actor.source_e.usize())
                    out.push(34)
                    Base::rh_push_text(out, ",\"source_instance\":")
                    out.push(34)
                    Base::rh_json_escape(out, texts, actor.instance_s.usize(), actor.instance_e.usize())
                    out.push(34)
                    Base::rh_push_text(out, ",\"native_object_id\":")
                    out.push(34)
                    Base::rh_json_escape(out, texts, actor.native_s.usize(), actor.native_e.usize())
                    out.push(34)
                    Base::rh_push_text(out, ",\"display_name\":")
                    out.push(34)
                    Base::rh_json_escape(out, texts, actor.display_s.usize(), actor.display_e.usize())
                    out.push(34)
                    Base::rh_push_text(out, ",\"aliases\":[")
                    while j < actor.alias_count |j: i64 = 0, actor, aliases, texts, out|:
                        if j > 0:
                            out.push(44)
                        alias: RhIdentityAlias = aliases[(actor.alias_start + j).usize()]
                        Base::rh_push_text(out, "{\"value\":")
                        out.push(34)
                        Base::rh_json_escape(out, texts, alias.value_s.usize(), alias.value_e.usize())
                        out.push(34)
                        Base::rh_push_text(out, ",\"observed_at\":")
                        Base::rh_push_decimal_i64(out, alias.observed_at)
                        Base::rh_push_text(out, "}")
                        j <- j + 1
                    Base::rh_push_text(out, "]}")
                    i <- i + 1
                Base::rh_push_text(out, "]")
            Base::rh_push_text(out, ",\"note\":\"clusters derive only from ACCEPTED links; rejected/revoked links change nothing; revoking recomputes clusters and advances the revision with no raw record rewritten; unresolved never forced human\"}")
            0
