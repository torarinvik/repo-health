# rh_release_feed.elisa — release-only source adapter (M08 archives/releases
# lane). Some sites publish releases and downloadable artifacts but no
# revision history. This adapter reports exactly that: releases, their
# published time (VALID time), the collector's first-seen time (KNOWN
# time), and artifact metadata. It never invents commits, authors, or
# history, and its capability manifest marks history `unsupported`.
#
# A tag is a label on a release, not the release identity by itself: the
# record is (tag, first_seen) so a re-published tag is a new observation
# rather than a silent overwrite. `published` absent stays unknown (0), not
# the collector time.
include "./rh_base.elisa"
include "./rh_json.elisa"

module ReleaseFeed:
    private:
        # Helpers used only while normalizing one release feed. Keeping these
        # private makes the public adapter boundary explicit and prevents
        # parser scratch operations from becoming cross-module contracts.
        def rh_rel_copy(pool: mutable darray[u8]&, texts: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if s < 0 or e < s
            texts_loop: mutable darray[u8]& = texts
            e_loop: mutable i64 = e
            while k < e_loop |k: i64 = s, start: i64 = pool.count.i64(), texts_loop, pool, e_loop| -> start:
                pool.push(texts_loop[k.usize()])
                k <- k + 1

        def rh_rel_arr_count(nodes: darray[Json::RhJsonNode]&, arr: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if arr < 0
            o: Json::RhJsonNode = nodes[arr.usize()]
            return 0 if o.kind != Json::RH_JSON_ARR
            o.child_count

        # Count assets in an assets array that carry a non-empty "digest" string.
        def rh_rel_digest_count(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, arr: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if arr < 0
            o: Json::RhJsonNode = nodes[arr.usize()]
            return 0 if o.kind != Json::RH_JSON_ARR
            while child >= 0 |total: i64 = 0, child: i64 = o.first_child| -> total:
                nxt: i64 = nodes[child.usize()].next_sibling
                ds: mutable i64 = -1
                de: mutable i64 = -1
                if Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, child, "digest"), &ds, &de):
                    if de > ds:
                        total <- total + 1
                child <- nxt

    public:
        const RH_RELEASE_FEED_MAX: i64 = 5000
        const RH_RELEASE_FEED_VERSION: i64 = 1

        struct RhRelease:
            tag_s: i64
            tag_e: i64
            target_s: i64
            target_e: i64
            published: i64
            has_published: i64
            # -1 = classification not supplied; 0 = explicitly stable;
            # 1 = explicitly prerelease. Missing classification stays unknown.
            prerelease: i64
            # -1 = withdrawal state not supplied; 0 = explicitly active;
            # 1 = explicitly withdrawn.
            withdrawn: i64
            supported_line_s: i64
            supported_line_e: i64
            support_end: i64
            has_support_end: i64
            support_end_issuer_s: i64
            support_end_issuer_e: i64
            release_notes_retrievable: i64
            source_mapped: i64
            first_seen: i64
            asset_count: i64
            digest_known_count: i64

        # Explicit: this source family has no revision-history capability.
        def rh_release_feed_history_supported() -> i64:
            0

        # Explicit: no author/identity evidence is derived here.
        def rh_release_feed_identity_supported() -> i64:
            0

        # Parse a release feed. Accepts either a top-level array of release objects
        # or an object with a "releases" array. Each release needs a non-empty
        # string "tag"; "published_at" and "assets" are optional. Returns 0 on
        # success (rejects counted), -1 when the payload shape is unusable or the
        # release cap is exceeded.
        def rh_release_feed_parse(raw: darray[u8]&, first_seen: i64, max_releases: i64, pool: mutable darray[u8]&, out: mutable darray[RhRelease]&, reject_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            reject_out[0] <- 0
            cap: mutable i64 = max_releases
            if cap <= 0:
                cap <- RH_RELEASE_FEED_MAX
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0
            rn: Json::RhJsonNode = nodes[root.usize()]
            arr: mutable i64 = -1
            if rn.kind == Json::RH_JSON_ARR:
                arr <- root
            elif rn.kind == Json::RH_JSON_OBJ:
                arr <- Json::rh_json_obj_get(nodes, texts, root, "releases")
                return -1 if arr < 0
                an: Json::RhJsonNode = nodes[arr.usize()]
                return -1 if an.kind != Json::RH_JSON_ARR
            else:
                return -1
            while child >= 0 |child: i64 = nodes[arr.usize()].first_child, nodes, texts, pool, out, reject_out, cap, raw, first_seen|:
                nxt: i64 = nodes[child.usize()].next_sibling
                return -1 if out.count.i64() >= cap
                ts: mutable i64 = -1
                te: mutable i64 = -1
                if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, child, "tag"), &ts, &te) or te <= ts:
                    reject_out[0] <- reject_out[0] + 1
                else:
                    tag_s: i64 = rh_rel_copy(pool, texts, ts, te)
                    tag_e: i64 = tag_s + (te - ts)
                    target_s: mutable i64 = -1
                    target_e: mutable i64 = -1
                    target_idx: i64 = Json::rh_json_obj_get(nodes, texts, child, "target")
                    if target_idx >= 0 and Json::rh_json_str_span(nodes, target_idx, &target_s, &target_e) and target_e <= target_s:
                        target_s <- -1
                        target_e <- -1
                    target_copy: mutable i64 = -1
                    if target_s >= 0:
                        target_copy <- rh_rel_copy(pool, texts, target_s, target_e)
                        target_e <- target_copy + (target_e - target_s)
                        target_s <- target_copy
                    pub: mutable i64 = 0
                    has_pub: mutable i64 = 0
                    pok: mutable i64 = 0
                    pub <- Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, child, "published_at"), &pok)
                    if pok == 1:
                        has_pub <- 1
                    pre: mutable i64 = -1
                    pre_idx: i64 = Json::rh_json_obj_get(nodes, texts, child, "prerelease")
                    if pre_idx >= 0 and nodes[pre_idx.usize()].kind == Json::RH_JSON_BOOL:
                        pre <- 1 if Json::rh_json_is_true(nodes, raw, pre_idx) else 0
                    withdrawn: mutable i64 = -1
                    withdrawn_idx: i64 = Json::rh_json_obj_get(nodes, texts, child, "withdrawn")
                    if withdrawn_idx >= 0 and nodes[withdrawn_idx.usize()].kind == Json::RH_JSON_BOOL:
                        withdrawn <- 1 if Json::rh_json_is_true(nodes, raw, withdrawn_idx) else 0
                    support_s: mutable i64 = -1
                    support_e: mutable i64 = -1
                    support_idx: i64 = Json::rh_json_obj_get(nodes, texts, child, "supported_line")
                    if support_idx >= 0 and Json::rh_json_str_span(nodes, support_idx, &support_s, &support_e) and support_e <= support_s:
                        support_s <- -1
                        support_e <- -1
                    support_copy: mutable i64 = -1
                    if support_s >= 0:
                        support_copy <- rh_rel_copy(pool, texts, support_s, support_e)
                        support_e <- support_copy + (support_e - support_s)
                        support_s <- support_copy
                    support_end: mutable i64 = 0
                    has_support_end: mutable i64 = 0
                    support_end_ok: mutable i64 = 0
                    support_end <- Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, child, "support_end_at"), &support_end_ok)
                    if support_end_ok == 1:
                        has_support_end <- 1
                    support_issuer_s: mutable i64 = -1
                    support_issuer_e: mutable i64 = -1
                    support_issuer_idx: i64 = Json::rh_json_obj_get(nodes, texts, child, "support_end_issuer")
                    if support_issuer_idx >= 0 and Json::rh_json_str_span(nodes, support_issuer_idx, &support_issuer_s, &support_issuer_e) and support_issuer_e <= support_issuer_s:
                        support_issuer_s <- -1
                        support_issuer_e <- -1
                    support_issuer_copy: mutable i64 = -1
                    if support_issuer_s >= 0:
                        support_issuer_copy <- rh_rel_copy(pool, texts, support_issuer_s, support_issuer_e)
                        support_issuer_e <- support_issuer_copy + (support_issuer_e - support_issuer_s)
                        support_issuer_s <- support_issuer_copy
                    release_notes_retrievable: mutable i64 = -1
                    release_notes_idx: i64 = Json::rh_json_obj_get(nodes, texts, child, "release_notes_retrievable")
                    if release_notes_idx >= 0 and nodes[release_notes_idx.usize()].kind == Json::RH_JSON_BOOL:
                        release_notes_retrievable <- 1 if Json::rh_json_is_true(nodes, raw, release_notes_idx) else 0
                    source_mapped: mutable i64 = -1
                    source_idx: i64 = Json::rh_json_obj_get(nodes, texts, child, "source_mapped")
                    if source_idx >= 0 and nodes[source_idx.usize()].kind == Json::RH_JSON_BOOL:
                        source_mapped <- 1 if Json::rh_json_is_true(nodes, raw, source_idx) else 0
                    asset_arr: i64 = Json::rh_json_obj_get(nodes, texts, child, "assets")
                    ac: i64 = rh_rel_arr_count(nodes, asset_arr)
                    dc: i64 = rh_rel_digest_count(nodes, texts, asset_arr)
                    out.push(RhRelease{tag_s: tag_s, tag_e: tag_e, target_s: target_s, target_e: target_e, published: pub, has_published: has_pub, prerelease: pre, withdrawn: withdrawn, supported_line_s: support_s, supported_line_e: support_e, support_end: support_end, has_support_end: has_support_end, support_end_issuer_s: support_issuer_s, support_end_issuer_e: support_issuer_e, release_notes_retrievable: release_notes_retrievable, source_mapped: source_mapped, first_seen: first_seen, asset_count: ac, digest_known_count: dc})
                child <- nxt
            0

        # Smallest first_seen among releases whose tag equals the given span; -1
        # when none. Lets a caller distinguish a genuinely new release from a
        # re-observation without treating the tag as identity.
        def rh_release_first_seen_for(pool: darray[u8]&, out: darray[RhRelease]&, ts: i64, te: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < out.count.i64() |best: i64 = -1, i: i64 = 0| -> best:
                r: RhRelease = out[i.usize()]
                if r.tag_e - r.tag_s == te - ts:
                    same: bool = Base::rh_bytes_equal_span(pool, r.tag_s, r.tag_e, pool, ts, te)
                    if same:
                        if best < 0 or r.first_seen < best:
                            best <- r.first_seen
                i <- i + 1
