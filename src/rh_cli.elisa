                cc <- cc + 1
        return rh_cli_usage(2) if cb_idx < 0 or co_idx < 0
        return rh_do_continuity(slots[cb_idx], slots[co_idx])

    if rh_streq(cmd, "succession"):
        ssi, sso =
            while ssq < argc |ssi: i64 = -1, sso: i64 = -1, ssq: i64 = 2, slots| -> ssi, sso:
                ass: u8& = slots[ssq].cast[u8&] can Unsafe.PointerCast
                if rh_streq(ass, "--input"):
                    if ssq + 1 < argc:
