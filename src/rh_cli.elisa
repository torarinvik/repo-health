                else:
                    return rh_cli_usage(2)
                option_index <- option_index + 1
        return rh_cli_usage(2) if pylock_input < 0 or pylock_output < 0
        return rh_do_pylock(slots[pylock_input], slots[pylock_output])
    if Base::rh_streq(cmd, "pylock-observe"):
        audit_idx, artifact_idx, file_idx, out_idx, artifact_id =
            while poq < argc |audit_idx: i64 = -1, artifact_idx: i64 = -1, file_idx: i64 = -1, out_idx: i64 = -1, artifact_id: i64 = -1, poq: i64 = 2, slots| -> audit_idx, artifact_idx, file_idx, out_idx, artifact_id:
                option: u8& = slots[poq].cast[u8&] can Unsafe.PointerCast
                if Base::rh_streq(option, "--audit"):
                    return rh_cli_usage(2) if audit_idx >= 0 or poq + 1 >= argc
                    poq <- poq + 1
                    audit_idx <- poq
                elif Base::rh_streq(option, "--artifact"):
                    return rh_cli_usage(2) if artifact_idx >= 0 or poq + 1 >= argc
                    poq <- poq + 1
                    artifact_idx <- poq
                    artifact_ok: mutable i64 = 0
                    artifact_id <- rh_parse_cstr_int(slots[poq], &artifact_ok)
                    return rh_cli_usage(2) if artifact_ok != 1 or artifact_id < 0
                elif Base::rh_streq(option, "--file"):
                    return rh_cli_usage(2) if file_idx >= 0 or poq + 1 >= argc
                    poq <- poq + 1
                    file_idx <- poq
                elif Base::rh_streq(option, "--out"):
                    return rh_cli_usage(2) if out_idx >= 0 or poq + 1 >= argc
                    poq <- poq + 1
                    out_idx <- poq
                else:
                    return rh_cli_usage(2)
                poq <- poq + 1
        return rh_cli_usage(2) if audit_idx < 0 or artifact_idx < 0 or file_idx < 0 or out_idx < 0
        return rh_do_pylock_observation(slots[audit_idx], artifact_id, slots[file_idx], slots[out_idx])
    if Base::rh_streq(cmd, "osv-query"):
        return rh_cli_usage(2) if argc < 6 or argc > 8
        osv_out_flag: u8& = slots[4].cast[u8&] can Unsafe.PointerCast
        return rh_cli_usage(2) if not Base::rh_streq(osv_out_flag, "--out")
        osv_mode_flag: u8& = slots[2].cast[u8&] can Unsafe.PointerCast
        continue_pages: mutable bool = false
