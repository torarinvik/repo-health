    rh_cli_out("findings: assessment observed")
    0

# --- M03-11 resolution-instance execution path. ---
def rh_do_resolution(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected resolution argument (allowlist)")
        return 3
    raw: mutable darray[u8] = []
    if rh_io_read(input_path, raw) < 0:
        rh_cli_err("resolution: cannot read --input")
        return 4
    body: mutable darray[u8] = []
    if Resolution::rh_resolution_report(raw, body) != 0:
        rh_cli_err("resolution: not a valid rh-dep-graph/1 document (fail closed)")
        return 4
    body.push(10)
    return 4 if not rh_io_write(out_path, body)
    rh_cli_out("resolution: instances observed")
    0

# --- M03-10 parser-adoption differential path. ---
def rh_do_parser_diff(native_path: cstr, candidate_path: cstr, out_path: cstr, native_parser: cstr, candidate_parser: cstr, configuration: cstr, visibility: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(native_path) or not Git::rh_arg_safe(candidate_path) or not Git::rh_arg_safe(out_path) or not Git::rh_arg_safe(native_parser) or not Git::rh_arg_safe(candidate_parser) or not Git::rh_arg_safe(configuration) or not Git::rh_arg_safe(visibility):
        rh_cli_err("rejected parser-diff argument (allowlist)")
        return 3
    native_raw: mutable darray[u8] = []
    candidate_raw: mutable darray[u8] = []
    if rh_io_read(native_path, native_raw) < 0 or rh_io_read(candidate_path, candidate_raw) < 0:
        rh_cli_err("parser-diff: cannot read retained input")
        return 4
    body: mutable darray[u8] = []
    diff_rc: i64 = ParserDiff::rh_parser_diff_report(native_raw, candidate_raw, body, native_parser, candidate_parser, configuration, visibility)
    if diff_rc == -1:
        rh_cli_err("parser-diff: malformed native graph (fail closed)")
        return 4
    body.push(10)
    if not rh_io_write(out_path, body):
        rh_cli_err("parser-diff: cannot write --out")
        return 4
    if diff_rc == -2:
        rh_cli_err("parser-diff: candidate parser unsupported")
        return 3
    rh_cli_out("parser-diff: comparison observed")
    0

def rh_path_arg_ok(s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if rh_cstr_len_c(s) == 0
    while true |i: usize = 0, s|:
        b: u8 = s[i]
        break if b == 0
        return false if b < 32 or b == 127
        i <- i + 1
    true

def rh_span_is(texts: darray[u8]&, start: i64, end: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: i64 =
        while i < end |n: i64 = 0, i: i64 = start| -> n:
            b: u8 = texts[i.usize()]
            l: u8 = lit[n.usize()]
            return false if l == 0
            return false if b != l
            n <- n + 1
            i <- i + 1
    lit[n.usize()] == 0

def rh_span_copy(texts: darray[u8]&, start: i64, end: i64) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    out: mutable darray[u8] = []
    while i < end |i: i64 = start, texts, out|:
        out.push(texts[i.usize()])
        i <- i + 1
    out

def rh_do_sign(key_path: cstr, subject_path: cstr, sig_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    key: mutable darray[u8] = []
    if rh_io_read(key_path, key) < 0:
        rh_cli_err("sign: cannot read key file")
        return 4
    if key.count == 0:
        rh_cli_err("sign: refusing to sign with an empty key")
        return 3
    subject: mutable darray[u8] = []
    if rh_io_read(subject_path, subject) < 0:
        rh_cli_err("sign: cannot read subject file")
        return 4
    sig: mutable darray[u8] = []
    rh_hmac_sha256(key, subject, sig)
    subj_hash: mutable darray[u8] = []
    rh_sha256(subject, subj_hash)
    out: mutable darray[u8] = []
    rh_push_text(out, "{\"format\":\"rh-release-signature/1\",\"algorithm\":\"hmac-sha256\",\"subject_sha256\":\"")
    _ = rh_absorb_bytes(subj_hash, out)
    rh_push_text(out, "\",\"signature\":\"")
    _ = rh_absorb_bytes(sig, out)
    rh_push_text(out, "\"}\n")
    if not rh_io_write(sig_path, out):
        rh_cli_err("sign: cannot write signature file")
        return 4
    rh_cli_out("signed hmac-sha256 (integrity + key possession; not a code-safety claim)")
    0

def rh_do_verify(key_path: cstr, subject_path: cstr, sig_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    key: mutable darray[u8] = []
    if rh_io_read(key_path, key) < 0:
        rh_cli_err("verify: cannot read key file")
        return 4
    if key.count == 0:
        rh_cli_err("verify: empty key cannot verify")
        return 3
    subject: mutable darray[u8] = []
    if rh_io_read(subject_path, subject) < 0:
        rh_cli_err("verify: cannot read subject file")
        return 4
    sigbytes: mutable darray[u8] = []
    if rh_io_read(sig_path, sigbytes) < 0:
        rh_cli_err("verify: cannot read signature file")
        return 4
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(sigbytes, nodes, texts)
    if root < 0:
        rh_cli_err("verify: signature file is not valid JSON")
        return 3
    algo: i64 = Json::rh_json_obj_get(nodes, texts, root, "algorithm")
    a_start: mutable i64 = 0
    a_end: mutable i64 = 0
    if algo < 0 or not Json::rh_json_str_span(nodes, algo, &a_start, &a_end):
        rh_cli_err("verify: signature missing string algorithm")
        return 3
    if not rh_span_is(texts, a_start, a_end, "hmac-sha256"):
        rh_cli_err("verify: unsupported signature algorithm")
        return 3
    sig_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "signature")
    s_start: mutable i64 = 0
    s_end: mutable i64 = 0
    if sig_idx < 0 or not Json::rh_json_str_span(nodes, sig_idx, &s_start, &s_end):
        rh_cli_err("verify: signature missing string signature")
        return 3
    want: mutable darray[u8] = []
    rh_hmac_sha256(key, subject, want)
    got: darray[u8] = rh_span_copy(texts, s_start, s_end)
    if not rh_hex_eq(want, got):
        rh_cli_err("verify: signature does not match subject (integrity FAILED)")
        return 5
    subj_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "subject_sha256")
    h_start: mutable i64 = 0
    h_end: mutable i64 = 0
    if subj_idx < 0 or not Json::rh_json_str_span(nodes, subj_idx, &h_start, &h_end):
        rh_cli_err("verify: signature missing string subject_sha256")
        return 3
    actual_subj: mutable darray[u8] = []
    rh_sha256(subject, actual_subj)
    claimed_subj: darray[u8] = rh_span_copy(texts, h_start, h_end)
    if not rh_hex_eq(actual_subj, claimed_subj):
        rh_cli_err("verify: subject digest mismatch (signature paired with different bytes)")
        return 5
    rh_cli_out("signature ok: integrity + key possession verified (not a code-safety claim)")
    0

# --- M04 continuity execution path: publish continuity + persistence. ---
# Reads the pinned bundle written by `scan` (no live data), builds raw
# project-local author identity presence over complete months, and writes
# continuity.json (rh-continuity/1) plus continuity-metrics.json
# (persistence.retained_90d). Retention requires full, non-shallow history:
# a windowed or shallow scan cannot establish an actor's first observation,
# so it reports `unsupported` rather than a misleading rate.
def rh_do_continuity(bundle: cstr, out: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(bundle):
        rh_cli_err("rejected bundle argument (allowlist)")
        return 3
    if not Git::rh_arg_safe(out):
        rh_cli_err("rejected output argument (allowlist)")
        return 3
    manb: mutable darray[u8] = []
    bpath: mutable darray[u8] =
        bpath: mutable darray[u8] = []
        rh_push_cstr(bpath, bundle)
        bpath.push(0)
        bpath
    bp: cstr = (&bpath[0]).cast[cstr] can Unsafe.PointerCast
    if rh_io_read(bp, manb) < 0:
        rh_cli_err("cannot read bundle manifest")
        return 4
    ok_days: mutable i64 = 0
    days: i64 = rh_manifest_int(manb, "window-days: ", &ok_days)
    if ok_days == 0 or days <= 0:
        rh_cli_err("manifest has no parseable window-days")
        return 4
    full: bool = rh_manifest_flag(manb, "full-history: ") == 1
    ok_cut: mutable i64 = 0
    cutoff: i64 = rh_manifest_int(manb, "evidence-cutoff: ", &ok_cut)
    if ok_cut == 0 or cutoff <= 0:
        rh_cli_err("manifest has no parseable evidence-cutoff")
        return 4
    dir: mutable darray[u8] = []
    has_dir: bool = rh_dirname(bundle, dir)
    logpath: mutable darray[u8] = []
    if has_dir:
        rh_push_cstr(logpath, (&dir[0]).cast[cstr] can Unsafe.PointerCast)
        logpath.push(47)
    rh_push_text(logpath, "evidence/git-log.bin")
    logpath.push(0)
    logb: mutable darray[u8] = []
    logp: cstr = (&logpath[0]).cast[cstr] can Unsafe.PointerCast
    if rh_io_read(logp, logb) < 0:
        rh_cli_err("cannot read retained log evidence (no live data substituted)")
        return 4
    shapath: mutable darray[u8] = []
    if has_dir:
        rh_push_cstr(shapath, (&dir[0]).cast[cstr] can Unsafe.PointerCast)
        shapath.push(47)
    rh_push_text(shapath, "evidence/git-shallow.txt")
    shapath.push(0)
    shab: mutable darray[u8] = []
    shallow: mutable bool = false
    shap: cstr = (&shapath[0]).cast[cstr] can Unsafe.PointerCast
    if rh_io_read(shap, shab) >= 0:
        if shab.count >= 4:
            if shab[0] == 116 and shab[1] == 114 and shab[2] == 117 and shab[3] == 101:
                shallow <- true
    window_start: i64 = cutoff - days * 86400 if not full else 0
    actor: mutable darray[i64] = []
    month: mutable darray[i64] = []
    inst: mutable darray[i64] = []
    kind: mutable darray[u8] = []
    n_actors: mutable i64 = 0
    accepted: i64 = rh_cs_parse(logb, window_start, cutoff, actor, month, inst, kind, &n_actors)
    if accepted < 0:
        rh_cli_err("continuity: invalid window inputs")
        return 4
    first_seen_supported: bool = full and not shallow
    identity_rev: i64 = 0
    min_active: i64 = 6
    min_span: i64 = 6
    recent_required: bool = false
    presence: mutable darray[u8] = []
    n_months: mutable i64 = 0
    mlo: mutable i64 = 0
    if accepted > 0:
        min_at: i64 =
            while e < inst.count |min_at: i64 = inst[0], e: usize = 1, inst| -> min_at:
                t: i64 = inst[e]
                if t < min_at:
                    min_at <- t
                e <- e + 1
        lo_src: i64 = min_at if full else window_start
        mhi: mutable i64 = 0
        Temporal::rh_month_of_instant(lo_src, &mlo)
        Temporal::rh_month_of_instant(cutoff, &mhi)
        n_months <- mhi - mlo + 1
        if n_months < 0:
            n_months <- 0
        _ = Continuity::rh_presence_build(actor, month, kind, -1, n_actors, mlo, n_months, presence)
    persistent: i64 = Continuity::rh_persistent_count(presence, n_actors, n_months, min_active, min_span, recent_required)
    counts: mutable darray[u64] = []
    _ = Continuity::rh_actor_counts(actor, kind, -1, 0, actor.count.i64(), n_actors, counts)
    fifty: i64 = Continuity::rh_absence_factor_50(counts)
    eighty: i64 = Continuity::rh_concentration_80(counts)
    hhi_n: mutable u64 = 0
    hhi_d: mutable u64 = 0
    _ = Metrics::rh_hhi(counts, &hhi_n, &hhi_d)
    eff_n: mutable u64 = 0
    eff_d: mutable u64 = 0
    _ = Continuity::rh_effective_count(counts, &eff_n, &eff_d)
    top_n: mutable u64 = 0
    top_d: mutable u64 = 0
    _ = Continuity::rh_top1_share(counts, &top_n, &top_d)
    gini_n: mutable u64 = 0
    gini_d: mutable u64 = 0
    if not Metrics::rh_gini(counts, &gini_n, &gini_d):
        gini_n <- 0
        gini_d <- 0
    statuses: mutable darray[i64] = []
    rh_cs_retention(actor, inst, n_actors, cutoff, window_start, cutoff, 90, 120, first_seen_supported, statuses)
    retained: mutable i64 = 0
    eligible: mutable i64 = 0
    censored: mutable i64 = 0
    unobservable: mutable i64 = 0
    Continuity::rh_retention_tally(statuses, &retained, &eligible, &censored, &unobservable)
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("cannot create output directory")
        return 4
    cj: mutable darray[u8] = []
    cm: mutable darray[u8] = []
    if not rh_out_path(out, "continuity.json", cj):
        rh_cli_err("cannot stage continuity path")
        return 4
    if not rh_out_path(out, "continuity-metrics.json", cm):
        rh_cli_err("cannot stage continuity-metrics path")
        return 4
    body: mutable darray[u8] = []
    basis: u8 = Continuity::rh_coverage_basis(full, shallow)
    Continuity::rh_continuity_write_json(body, mlo, n_months, min_active, min_span, recent_required, identity_rev, n_actors, persistent, hhi_n, hhi_d, eff_n, eff_d, fifty, eighty, retained, eligible, censored, unobservable, accepted, 0, 0, basis)
    body.push(10)
    cjp: cstr = (&cj[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(cjp, body):
        rh_cli_err("cannot write continuity.json")
        return 4
    mbody: mutable darray[u8] = []
    Continuity::rh_continuity_metrics_write(mbody, identity_rev, n_actors, retained, eligible, censored, unobservable, first_seen_supported, hhi_n, hhi_d, eff_n, eff_d, fifty, eighty, top_n, top_d, gini_n, gini_d)
    mbody.push(10)
    cmp: cstr = (&cm[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(cmp, mbody):
        rh_cli_err("cannot write continuity-metrics.json")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        rh_push_text(done, "continuity: actors=")
        rh_push_decimal_i64(done, n_actors)
        rh_push_text(done, " events=")
        rh_push_decimal_i64(done, accepted)
        rh_push_text(done, " persistent=")
        rh_push_decimal_i64(done, persistent)
        rh_push_text(done, " retention=")
        rh_push_decimal_i64(done, retained)
        rh_push_text(done, "/")
        rh_push_decimal_i64(done, eligible)
        rh_push_text(done, " first_seen_supported=")
        done
    if first_seen_supported:
        rh_push_text(done, "true")
    else:
        rh_push_text(done, "false")
    done.push(10)
    rh_write_stdout(done)
    0

# --- M04-08 succession execution path. ---
# Reads an `rh-succession-input/1` document (a per-actor complete-month
# presence matrix, an explicit declared predecessor/successor pair, and the
# complete-month count) and writes `rh-continuity-metrics/1` for
# `succession.handover_overlap_months`. An absent declared pair is
# `not_applicable` (not zero overlap), so an activity-derived primary change
# is never passed off as a declared handover (no motive attribution).
def rh_do_succession(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected succession argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if rh_io_read(ipp, raw) < 0:
        rh_cli_err("succession: cannot read --input")
        return 4
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ:
        rh_cli_err("succession: not a valid rh-succession-input/1 document (fail closed)")
        return 4
    ss: mutable i64 = 0
    se: mutable i64 = 0
    sidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
    if sidx < 0 or not Json::rh_json_str_span(nodes, sidx, &ss, &se):
        rh_cli_err("succession: not a valid rh-succession-input/1 document (fail closed)")
        return 4
    if not Job::rh_job_lit_eq(texts, ss, se, "rh-succession-input/1"):
        rh_cli_err("succession: not a valid rh-succession-input/1 document (fail closed)")
        return 4
    okm: mutable i64 = 0
    months: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "complete_months"), &okm)
    if okm == 0 or months < 0:
        rh_cli_err("succession: missing/invalid complete_months (fail closed)")
        return 4
    # Declared pair is optional; a missing pair is not_applicable, not an error.
    pred: mutable i64 = -1
    succ: mutable i64 = -1
    pidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "predecessor")
    if pidx >= 0:
        okp: mutable i64 = 0
        pv: i64 = Json::rh_json_int(nodes, raw, pidx, &okp)
        if okp == 0 or pv < -1:
            rh_cli_err("succession: invalid predecessor (fail closed)")
            return 4
        pred <- pv
    ridx2: i64 = Json::rh_json_obj_get(nodes, texts, root, "successor")
    if ridx2 >= 0:
        okr: mutable i64 = 0
        rv: i64 = Json::rh_json_int(nodes, raw, ridx2, &okr)
        if okr == 0 or rv < -1:
            rh_cli_err("succession: invalid successor (fail closed)")
            return 4
        succ <- rv
    midx: i64 = Json::rh_json_obj_get(nodes, texts, root, "presence")
    if midx < 0 or nodes[midx.usize()].kind != Json::RH_JSON_ARR:
        rh_cli_err("succession: missing presence matrix (fail closed)")
        return 4
    rows: mutable darray[u8] = []
    while row >= 0 |row: i64 = nodes[midx.usize()].first_child, nodes, rows|:
        if nodes[row.usize()].kind != Json::RH_JSON_ARR:
            rh_cli_err("succession: presence row is not an array (fail closed)")
            return 4
        while col >= 0 |col: i64 = nodes[row.usize()].first_child, nodes, raw, months, rows|:
            if nodes[col.usize()].kind != Json::RH_JSON_BOOL:
                rh_cli_err("succession: presence cell is not a boolean (fail closed)")
                return 4
            if Json::rh_json_is_true(nodes, raw, col):
                rows.push(1)
            else:
                rows.push(0)
            col <- nodes[col.usize()].next_sibling
        if months > 0 and rows.count.i64() % months != 0:
            rh_cli_err("succession: presence matrix is not complete_months wide (fail closed)")
            return 4
        row <- nodes[row.usize()].next_sibling
    body: mutable darray[u8] = []
    Continuity::rh_succession_metrics_write(body, rows, pred, succ, months)
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("succession: cannot write --out")
        return 4
    rh_cli_out("succession: ok")
    0

# --- M05 downstream execution path. ---
# Reads an rh-dep-graph/1 document and writes an rh-downstream/1 report:
# direct + bounded transitive dependents under a labeled public projection,
# SCC count, optional simulated-unavailability scenario, explicit truncation
# (never a total), and private-node exclusion (S007/F030).
def rh_do_downstream(graph: cstr, subject: i64, out: cstr, snapshot_root: cstr, has_snapshot: bool, max_nodes: i64, max_depth: i64, unavailable: i64, has_unavailable: bool, private_ids: darray[i64]&, asserts: darray[Graph::RhAssertion]&, intr_path: cstr, has_intr: bool, mapping_path: cstr, has_mapping: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(graph) or not Git::rh_arg_safe(out):
        rh_cli_err("rejected downstream argument (allowlist)")
        return 3
    if has_intr:
        if not Git::rh_arg_safe(intr_path):
            rh_cli_err("rejected downstream argument (allowlist)")
            return 3
    if has_mapping and not Git::rh_arg_safe(mapping_path):
        rh_cli_err("rejected downstream mapping argument (allowlist)")
        return 3
    if has_snapshot:
        if not Git::rh_arg_safe(snapshot_root):
            rh_cli_err("rejected downstream snapshot argument (allowlist)")
            return 3
    gp: mutable darray[u8] =
        gp: mutable darray[u8] = []
        rh_push_cstr(gp, graph)
        gp.push(0)
        gp
    gpp: cstr = (&gp[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if rh_io_read(gpp, raw) < 0:
        rh_cli_err("downstream: cannot read graph file")
        return 4
    intr_raw: mutable darray[u8] = []
    if has_intr:
        ip: mutable darray[u8] =
            ip: mutable darray[u8] = []
            rh_push_cstr(ip, intr_path)
            ip.push(0)
            ip
        ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
        if rh_io_read(ipp, intr_raw) < 0:
            rh_cli_err("downstream: cannot read intrinsics file")
            return 4
    mapping_revision: mutable i64 = 0
    if has_mapping:
        mp: mutable darray[u8] =
            mp: mutable darray[u8] = []
            rh_push_cstr(mp, mapping_path)
            mp.push(0)
            mp
        mpp: cstr = (&mp[0]).cast[cstr] can Unsafe.PointerCast
        mapping_raw: mutable darray[u8] = []
        if rh_io_read(mpp, mapping_raw) < 0:
            rh_cli_err("downstream: cannot read mapping file")
            return 4
        mapping_records: mutable darray[RhMappingAssertion] = []
        if Mapping::rh_mapping_parse(mapping_raw, &mapping_revision, mapping_records) != 0:
            rh_cli_err("downstream: mapping is not a valid rh-mapping-input/1 document")
            return 4
        while mi < mapping_records.count |mi: usize = 0, mapping_records, asserts|:
            mr: RhMappingAssertion = mapping_records[mi]
            if mr.state == RH_MAPPING_STATE_ACCEPTED and (mr.relation == RH_MAPPING_REL_MIRROR or mr.relation == RH_MAPPING_REL_MIGRATION):
                asserts.push(Graph::RhAssertion{a: mr.a, b: mr.b, state: Graph::RH_ASSERT_ACCEPTED})
            mi <- mi + 1
        
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("downstream: cannot create output directory")
        return 4
    body: mutable darray[u8] = []
    snapshot_id: mutable darray[u8] = []
    empty_snapshot: mutable darray[u8] = []
    rc: mutable i64 = rh_downstream_report(raw, graph, subject, private_ids, asserts, mapping_revision, intr_raw, has_intr, max_nodes, max_depth, unavailable, has_unavailable, empty_snapshot, body)
    if rc == -1:
        rh_cli_err("downstream: graph is not a valid rh-dep-graph/1 document")
        return 4
    if rc == -2:
        rh_cli_err("downstream: subject id not present in graph")
        return 3
    if rc == -3:
        rh_cli_err("downstream: intrinsics is not a valid rh-intrinsics/1 document")
        return 4
    if has_snapshot:
        if Git::rh_ensure_dir(snapshot_root) != 0:
            rh_cli_err("downstream: cannot create snapshot root")
            return 4
        projection: Graph::RhProjection = Graph::rh_projection_make(1, Graph::RH_SCOPE_ALL, 0, 0, 0, 0, mapping_revision, true, max_nodes, max_depth)
        if ProjectionStore::rh_projection_snapshot_store(snapshot_root, raw, projection, snapshot_id) != 0:
            rh_cli_err("downstream: cannot persist projection snapshot")
            return 4
        body <- []
        rc <- rh_downstream_report(raw, graph, subject, private_ids, asserts, mapping_revision, intr_raw, has_intr, max_nodes, max_depth, unavailable, has_unavailable, snapshot_id, body)
        return 4 if rc != 0
    body.push(10)
    op: mutable darray[u8] = []
    if not rh_out_path(out, "downstream.json", op):
        rh_cli_err("downstream: bad output directory")
        return 3
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("downstream: cannot write downstream.json")
        return 4
    rh_cli_out("downstream: ok")
    0

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_emit_i64_array(out: mutable darray[u8]&, values: darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
    out.push(91)
    while i < values.count |i: usize = 0, values, out|:
        if i > 0:
            out.push(44)
        rh_push_decimal_i64(out, values[i])
        i <- i + 1
    out.push(93)

# --- M06 policy execution path. ---
# Parses an rh-policy/1 rule set and an rh-policy-input/1 observation file,
# aligns inputs to rules by id, evaluates the four-valued lattice, and
# writes rh-policy-result/1 bound to the policy/context/artifact/time
# digests. Unknown is never permission; warn never overrides deny; a rule
# with no input is unknown. Structured failure, never a default allow.
#
# With --state <file>, durable exception state (`rh-policy-state/1`) is
# loaded before evaluation and rewritten afterward: a rule-scoped exception
# supplied inline in the policy document takes precedence over the persisted
# row for the same (rule_id, subject_id, digest); an exception whose
# `expires_at` is at or before `now` is expired and never grants permission
# (the engine already enforces this). A missing state file is a fresh state.
def rh_do_policy_state(policy_path: cstr, input_path: cstr, out: cstr, state_path: cstr, has_state: bool, state_root: cstr, has_state_root: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(policy_path) or not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out):
        rh_cli_err("rejected policy argument (allowlist)")
        return 3
    if has_state and not Git::rh_arg_safe(state_path):
        rh_cli_err("rejected policy state argument (allowlist)")
        return 3
    if has_state and has_state_root:
        rh_cli_err("policy: --state and --state-store are mutually exclusive")
        return 2
    if has_state_root and not Git::rh_arg_safe(state_root):
        rh_cli_err("rejected policy state-store argument (allowlist)")
        return 3
    ppath: mutable darray[u8] =
        ppath: mutable darray[u8] = []
        rh_push_cstr(ppath, policy_path)
        ppath.push(0)
        ppath
    praw: mutable darray[u8] = []
    prawwp: cstr = (&ppath[0]).cast[cstr] can Unsafe.PointerCast
    if rh_io_read(prawwp, praw) < 0:
        rh_cli_err("policy: cannot read --policy file")
        return 4
    rules: mutable darray[RhRule] = []
    excs: mutable darray[RhException] = []
    if rh_policy_parse(praw, rules, excs) != 0:
        rh_cli_err("policy: not a valid rh-policy/1 document (fail closed)")
        return 4
    spath: mutable darray[u8] = []
    spp: mutable cstr = prawwp
    prior: mutable darray[RhException] = []
    if has_state:
        rh_push_cstr(spath, state_path)
        spath.push(0)
        spp <- (&spath[0]).cast[cstr] can Unsafe.PointerCast
        sraw: mutable darray[u8] = []
        if file_exists(spp):
            if rh_io_read(spp, sraw) < 0:
                rh_cli_err("policy: cannot read --state file")
                return 4
        if rh_policy_state_parse(sraw, prior) != 0:
            rh_cli_err("policy: not a valid rh-policy-state/1 document (fail closed)")
            return 4
    elif has_state_root:
        if Git::rh_ensure_dir(state_root) != 0:
            rh_cli_err("policy: cannot create --state-store")
            return 4
        sraw: mutable darray[u8] = []
        loaded: i64 = StateStore::rh_state_store_load(state_root, sraw)
        if loaded < 0:
            rh_cli_err("policy: corrupt --state-store (fail closed)")
            return 4
        if rh_policy_state_parse(sraw, prior) != 0:
            rh_cli_err("policy: not a valid rh-policy-state/1 document (fail closed)")
            return 4
    # Persisted rows supplement inline exceptions: a row whose
    # (rule_id, subject_id, digest) is already declared inline is dropped so
    # inline (current) intent wins over stale state.
    while ri < prior.count |ri: usize = 0, prior, excs|:
        p: RhException = prior[ri]
        dup: bool =
            while xi < excs.count |dup: bool = false, xi: usize = 0, excs| -> dup:
                e: RhException = excs[xi]
                if e.rule_id == p.rule_id and e.subject_id == p.subject_id and e.digest_high == p.digest_high and e.digest_low == p.digest_low:
                    dup <- true
                xi <- xi + 1
        if not dup:
            excs.push(p)
        ri <- ri + 1
    ipath: mutable darray[u8] =
        ipath: mutable darray[u8] = []
        rh_push_cstr(ipath, input_path)
        ipath.push(0)
        ipath
    iraw: mutable darray[u8] = []
    irawp: cstr = (&ipath[0]).cast[cstr] can Unsafe.PointerCast
    if rh_io_read(irawp, iraw) < 0:
        rh_cli_err("policy: cannot read --input file")
        return 4
    in_ids: mutable darray[i64] = []
    inputs: mutable darray[RhPolicyInput] = []
    subject: mutable i64 = 0
    artifact: mutable u64 = 0
    context: mutable u64 = 0
    now: mutable i64 = 0
    if rh_policy_input_parse(iraw, in_ids, inputs, &subject, &artifact, &context, &now) != 0:
        rh_cli_err("policy: not a valid rh-policy-input/1 document (fail closed)")
        return 4
    aligned: mutable darray[RhPolicyInput] = []
    missing: mutable darray[i64] = []
    rh_policy_align(rules, in_ids, inputs, aligned, missing)
    digest: u64 = rh_policy_digest(rules, context, subject, artifact, now)
    fired: mutable darray[i64] = []
    excepted: mutable darray[i64] = []
    decision: u8 = rh_policy_eval(rules, aligned, excs, subject, digest, 0, now, fired, excepted)
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("policy: cannot create output directory")
        return 4
    body: mutable darray[u8] =
        body: mutable darray[u8] = []
        rh_push_text(body, "{\"schema\":\"rh-policy-result/1\",\"subject_id\":")
        rh_push_decimal_i64(body, subject)
        rh_push_text(body, ",\"binding\":{\"policy_digest\":\"")
        rh_push_hex_u64(body, digest)
        rh_push_text(body, "\",\"context_digest\":\"")
        rh_push_hex_u64(body, context)
        rh_push_text(body, "\",\"artifact_digest\":\"")
        rh_push_hex_u64(body, artifact)
        rh_push_text(body, "\",\"now\":")
        rh_push_decimal_i64(body, now)
        rh_push_text(body, "},\"decision\":\"")
        rh_push_text(body, rh_decision_label(decision))
        rh_push_text(body, "\",\"fired_rule_ids\":")
        body
    rh_emit_i64_array(body, fired)
    rh_push_text(body, ",\"excepted_rule_ids\":")
    rh_emit_i64_array(body, excepted)
    rh_push_text(body, ",\"missing_input_rule_ids\":")
    rh_emit_i64_array(body, missing)
    rh_push_text(body, ",\"explanation\":")
    rh_policy_explain(body, rules, decision, fired, excepted)
    rh_push_text(body, ",\"note\":\"unknown is never permission; warn never overrides deny; this decision is bound to the digests above (TOCTOU)\"}")
    body.push(10)
    op: mutable darray[u8] = []
    if not rh_out_path(out, "policy-result.json", op):
        rh_cli_err("policy: bad output directory")
        return 3
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("policy: cannot write policy-result.json")
        return 4
    if has_state:
        sb: mutable darray[u8] = []
        rh_policy_state_emit(excs, sb)
        sb.push(10)
        if not rh_io_write(spp, sb):
            rh_cli_err("policy: cannot write --state file")
            return 4
    elif has_state_root:
        sb2: mutable darray[u8] = []
        sid: mutable darray[u8] = []
        rh_policy_state_emit(excs, sb2)
        sb2.push(10)
        if StateStore::rh_state_store_publish(state_root, sb2, sid) != 0:
            rh_cli_err("policy: cannot publish --state-store")
            return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        rh_push_text(done, "policy: decision=")
        rh_push_text(done, rh_decision_label(decision))
        rh_push_text(done, " fired=")
        rh_push_decimal_i64(done, fired.count.i64())
        rh_push_text(done, " excepted=")
        rh_push_decimal_i64(done, excepted.count.i64())
        rh_push_text(done, " missing_inputs=")
        rh_push_decimal_i64(done, missing.count.i64())
        done.push(10)
        done
    rh_write_stdout(done)
    0

# --- M06 correction execution path. ---
# Reads an rh-corrections/1 document, applies corrections in order, and
# writes rh-corrections-result/1. Accepted corrections advance the revision
# and supersede only that subject's older derived results; raw replay inputs
# are never rewritten. Malformed/unknown kind/state/combine fails closed.
#
# With --state <file>, an `rh-corrections-state/1` document carries the
# revision floor, the greatest target_id already folded in (watermark), and
# the subjects superseded so far; it is loaded before the run and rewritten
# after. Replaying the same corrections file is therefore idempotent (no
# second advance, no re-supersede), matching S005. A corrupt or wrong-schema
# state file fails closed (exit 4), never defaults to permission.
def rh_do_correct_state(corrections_path: cstr, out: cstr, state_path: cstr, has_state: bool, state_root: cstr, has_state_root: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(corrections_path) or not Git::rh_arg_safe(out):
        rh_cli_err("rejected correct argument (allowlist)")
        return 3
    if has_state and not Git::rh_arg_safe(state_path):
        rh_cli_err("rejected correct state argument (allowlist)")
        return 3
    if has_state and has_state_root:
        rh_cli_err("correct: --state and --state-store are mutually exclusive")
        return 2
    if has_state_root and not Git::rh_arg_safe(state_root):
        rh_cli_err("rejected correct state-store argument (allowlist)")
        return 3
    cp: mutable darray[u8] =
        cp: mutable darray[u8] = []
        rh_push_cstr(cp, corrections_path)
        cp.push(0)
        cp
    cpp: cstr = (&cp[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if rh_io_read(cpp, raw) < 0:
        rh_cli_err("correct: cannot read --corrections file")
        return 4
    spath: mutable darray[u8] = []
    spp: mutable cstr = cpp
    p_rev: mutable i64 = 0
    p_wm: mutable i64 = 0
    prior_sup: mutable darray[i64] = []
    if has_state:
        rh_push_cstr(spath, state_path)
        spath.push(0)
        spp <- (&spath[0]).cast[cstr] can Unsafe.PointerCast
        sraw: mutable darray[u8] = []
        if file_exists(spp):
            if rh_io_read(spp, sraw) < 0:
                rh_cli_err("correct: cannot read --state file")
                return 4
        if CorrectionReport::rh_correction_state_parse(sraw, &p_rev, &p_wm, prior_sup) != 0:
            rh_cli_err("correct: not a valid rh-corrections-state/1 document (fail closed)")
            return 4
    elif has_state_root:
        if Git::rh_ensure_dir(state_root) != 0:
            rh_cli_err("correct: cannot create --state-store")
            return 4
        sraw: mutable darray[u8] = []
        loaded: i64 = StateStore::rh_state_store_load(state_root, sraw)
        if loaded < 0:
            rh_cli_err("correct: corrupt --state-store (fail closed)")
            return 4
        if CorrectionReport::rh_correction_state_parse(sraw, &p_rev, &p_wm, prior_sup) != 0:
            rh_cli_err("correct: not a valid rh-corrections-state/1 document (fail closed)")
            return 4
    body: mutable darray[u8] = []
    new_sup: mutable darray[i64] = []
    final_rev: mutable i64 = 0
    final_wm: mutable i64 = 0
    if CorrectionReport::rh_correction_report_state(raw, p_rev, p_wm, new_sup, &final_rev, &final_wm, body) != 0:
        rh_cli_err("correct: not a valid rh-corrections/1 document (fail closed)")
        return 4
    body.push(10)
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("correct: cannot create output directory")
        return 4
    op: mutable darray[u8] = []
    if not rh_out_path(out, "corrections-result.json", op):
        rh_cli_err("correct: bad output directory")
        return 3
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("correct: cannot write corrections-result.json")
        return 4
    if has_state or has_state_root:
        merged: mutable darray[i64] = []
        while mi < prior_sup.count |mi: usize = 0, prior_sup, merged|:
            merged.push(prior_sup[mi])
            mi <- mi + 1
        while ni < new_sup.count |ni: usize = 0, new_sup, merged|:
            v: i64 = new_sup[ni]
            present: bool =
                while mj < merged.count |present: bool = false, mj: usize = 0, merged| -> present:
                    if merged[mj] == v:
                        present <- true
                    mj <- mj + 1
            if not present:
                merged.push(v)
            ni <- ni + 1
        sb: mutable darray[u8] = []
        CorrectionReport::rh_correction_state_emit(final_rev, final_wm, merged, sb)
        sb.push(10)
        if has_state:
            if not rh_io_write(spp, sb):
                rh_cli_err("correct: cannot write --state file")
                return 4
        else:
            sid: mutable darray[u8] = []
            if StateStore::rh_state_store_publish(state_root, sb, sid) != 0:
                rh_cli_err("correct: cannot publish --state-store")
                return 4
    rh_cli_out("correct: ok")
    0

# --- M02 store + M07 ops execution paths. ---
# Content-addressed evidence store: put is idempotent for identical bytes
# and refuses to overwrite a different blob under the same digest; verify
# recomputes the digest and fails closed on missing/corrupt evidence.
def rh_do_store_put(root: cstr, file: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(file):
        rh_cli_err("rejected store argument (allowlist)")
        return 3
    buf: mutable darray[u8] = []
    if rh_io_read(file, buf) < 0:
        rh_cli_err("store: cannot read --file")
        return 4
    if Git::rh_ensure_dir(root) != 0:
        rh_cli_err("store: cannot create root")
        return 4
    hex: mutable darray[u8] = []
    if Store::rh_store_blob(root, buf, hex) != 0:
        rh_cli_err("store: refusing to overwrite a different blob under the same digest")
        return 4
    done: mutable darray[u8] = []
    rh_push_text(done, "store: put ")
    _ = rh_absorb_bytes(hex, done)
    rh_push_text(done, " bytes=")
    rh_push_decimal_i64(done, buf.count.i64())
    done.push(10)
    rh_write_stdout(done)
    0

def rh_do_store_verify(root: cstr, name: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(name):
        rh_cli_err("rejected store argument (allowlist)")
        return 3
    ok: mutable i64 = 0
    if Store::rh_store_blob_verify(root, name, &ok) != 0 or ok != 1:
        rh_cli_err("store: verification FAILED (missing or corrupt evidence blocks publication)")
        return 5
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        rh_push_text(done, "store: verified ")
        rh_push_cstr(done, name)
        done.push(10)
        done
    rh_write_stdout(done)
    0

# Backup manifest from a names file (one blob hex name per line).
def rh_do_ops_backup(root: cstr, manifest: cstr, names_file: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(manifest) or not Git::rh_arg_safe(names_file):
        rh_cli_err("rejected ops argument (allowlist)")
        return 3
    names: mutable darray[u8] = []
    if rh_io_read(names_file, names) < 0:
        rh_cli_err("ops: cannot read --names")
        return 4
    if not Ops::rh_backup_write(manifest, names):
        rh_cli_err("ops: cannot write backup manifest")
        return 4
    rh_cli_out("ops: backup manifest written")
    0

# Verify every object named in a manifest: present+digest-verified vs
# missing vs corrupt. Any missing/corrupt is exit 5 (not a clean restore).
def rh_do_ops_verify(root: cstr, manifest: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(manifest):
        rh_cli_err("rejected ops argument (allowlist)")
        return 3
    p: mutable i64 = 0
    m: mutable i64 = 0
    c: mutable i64 = 0
    if Ops::rh_backup_verify(root, manifest, &p, &m, &c) != 0:
        rh_cli_err("ops: cannot read backup manifest (fail closed)")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        rh_push_text(done, "ops verify: verified=")
        rh_push_decimal_i64(done, p)
        rh_push_text(done, " missing=")
        rh_push_decimal_i64(done, m)
        rh_push_text(done, " corrupt=")
        rh_push_decimal_i64(done, c)
        done.push(10)
        done
    rh_write_stdout(done)
    return 5 if m > 0 or c > 0
    0

# Restore only digest-verified objects; an unverified name is skipped and
# never silently becomes live evidence.
def rh_do_ops_restore(root: cstr, dest: cstr, manifest: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(dest) or not Git::rh_arg_safe(manifest):
        rh_cli_err("rejected ops argument (allowlist)")
        return 3
    if Git::rh_ensure_dir(dest) != 0:
        rh_cli_err("ops: cannot create restore destination")
        return 4
    r: mutable i64 = 0
    if Ops::rh_backup_restore(root, dest, manifest, &r) != 0:
        rh_cli_err("ops: cannot read backup manifest (fail closed)")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        rh_push_text(done, "ops restore: restored=")
        rh_push_decimal_i64(done, r)
        done.push(10)
        done
    rh_write_stdout(done)
    0

# --- M02 forge normalization execution path. ---
# Normalizes a captured forge payload into the canonical-repo/1 form with a
# real connector id and a caller-supplied (or current) collection time.
# Only connectors with an implemented normalizer are accepted; an unknown
# connector is rejected, never guessed. Malformed payloads fail closed.
def rh_do_forge_normalize(conn: cstr, input_path: cstr, out_path: cstr, fetched_at: i64, has_fetched: bool, source_url: cstr, has_url: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(conn) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected forge argument (allowlist)")
        return 3
    raw: mutable darray[u8] = []
    if has_url:
        return 3 if not Git::rh_fetch_arg_safe(source_url)
        source_path: mutable darray[u8] =
            source_path: mutable darray[u8] = []
            rh_push_cstr(source_path, out_path)
            rh_push_text(source_path, ".source")
            source_path.push(0)
            source_path
        status_path: mutable darray[u8] =
            status_path: mutable darray[u8] = []
            rh_push_cstr(status_path, out_path)
            rh_push_text(status_path, ".source.status")
            status_path.push(0)
            status_path
        error_path: mutable darray[u8] =
            error_path: mutable darray[u8] = []
            rh_push_cstr(error_path, out_path)
            rh_push_text(error_path, ".source.err")
            error_path.push(0)
            error_path
        source_ptr: cstr = (&source_path[0]).cast[cstr] can Unsafe.PointerCast
        status_ptr: cstr = (&status_path[0]).cast[cstr] can Unsafe.PointerCast
        error_ptr: cstr = (&error_path[0]).cast[cstr] can Unsafe.PointerCast
        if Git::rh_run_https_get(source_url, source_ptr, status_ptr, error_ptr) != 0:
            rh_cli_err("forge: fetch failed; source and stderr evidence retained")
            return 4
        status_raw: mutable darray[u8] = []
        if rh_io_read(status_ptr, status_raw) < 0 or status_raw.count == 0:
            rh_cli_err("forge: fetch did not produce a status")
            return 4
        ok_status: bool = status_raw[0] == 50
        file_transport: bool = status_raw.count >= 3 and status_raw[0] == 48 and status_raw[1] == 48 and status_raw[2] == 48 and rh_cstr_starts_with(source_url, "file://")
        if not ok_status and not file_transport:
            rh_cli_err("forge: fetch returned non-2xx; no result published")
            return 4
        if rh_io_read(source_ptr, raw) < 0:
            rh_cli_err("forge: cannot read fetched source evidence")
            return 4
    else:
        return 3 if not Git::rh_arg_safe(input_path)
        ip: mutable darray[u8] =
            ip: mutable darray[u8] = []
            rh_push_cstr(ip, input_path)
            ip.push(0)
            ip
        ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
        if rh_io_read(ipp, raw) < 0:
            rh_cli_err("forge: cannot read --input")
            return 4
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    if root < 0:
        rh_cli_err("forge: --input is not valid JSON")
        return 4
    ts: mutable i64 = fetched_at
    if not has_fetched:
        ts <- rh_now()
        if ts < 0:
            rh_cli_err("forge: no clock; pass --fetched-at")
            return 4
    produced: mutable darray[u8] = []
    ok: mutable bool = false
    if rh_streq(conn, "github"):
        ok <- Forge::rh_github_repo_canonical(nodes, texts, raw, root, ts, produced)
    elif rh_streq(conn, "gitlab"):
        ok <- Forge::rh_gitlab_project_canonical(nodes, texts, raw, root, ts, produced)
    elif rh_streq(conn, "gitea"):
        ok <- Forge::rh_gitea_repo_canonical(nodes, texts, raw, root, ts, "gitea", produced)
    elif rh_streq(conn, "forgejo"):
        ok <- Forge::rh_gitea_repo_canonical(nodes, texts, raw, root, ts, "forgejo", produced)
    elif rh_streq(conn, "bitbucket"):
        ok <- Forge::rh_bitbucket_repo_canonical(nodes, texts, raw, root, ts, produced)
    else:
        rh_cli_err("forge: unsupported connector (implemented normalizers: github, gitlab, gitea, forgejo, bitbucket)")
        return 3
    if not ok:
        rh_cli_err("forge: input does not match the connector payload shape (fail closed)")
        return 4
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, produced):
        rh_cli_err("forge: cannot write --out")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        rh_push_text(done, "forge: normalized ")
        rh_push_cstr(done, conn)
        done.push(10)
        done
    rh_write_stdout(done)
    0

# --- M02-05 bounded workflow-event import path. ---
# Provider-native captured arrays are normalized through rh-forge-events/1;
# this path does not perform live authentication or pagination.
def rh_do_forge_events(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected forge events argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if rh_io_read(ipp, raw) < 0:
        rh_cli_err("forge events: cannot read --input")
        return 4
    body: mutable darray[u8] = []
    if ForgeEvents::rh_forge_events_report(raw, body) != 0:
        rh_cli_err("forge events: unsupported or malformed captured payload (fail closed)")
        return 4
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("forge events: cannot write --out")
        return 4
    rh_cli_out("forge events: ok")
    0

# --- M02-04/05 connector instance execution path. ---
# Reads an rh-connector-instance/1 document and writes
# rh-connector-instance-result/1: the connector's capability table (with
# unsupported stated, never omitted), the operator-declared capabilities,
# and a usability verdict. Approval and transport are separate gates:
# an unapproved instance is `unapproved`, and an approved instance whose
# base URL fails the transport guard is `transport-rejected` regardless of
# approval (S002). Unknown connector ids, unknown capability keys, and a
# capability the connector does not declare all fail closed (exit 4).
def rh_do_connector_check(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected connector argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if rh_io_read(ipp, raw) < 0:
        rh_cli_err("connector: cannot read --instance")
        return 4
    inst: mutable RhConnectorInstance = RhConnectorInstance{id_start: 0, id_end: 0, url_start: 0, url_end: 0, approved: false}
    caps: mutable darray[i64] = []
    if rh_connector_instance_parse(raw, &inst, caps) != 0:
        rh_cli_err("connector: not a valid rh-connector-instance/1 document (fail closed)")
        return 4
    # Re-parse to recover the text buffer spans referenced by the instance.
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    _ = Json::rh_json_parse(raw, nodes, texts)
    verdict: i64 = rh_connector_instance_verdict(&inst, texts)
    body: mutable darray[u8] = []
    rh_connector_instance_emit(&inst, texts, caps, verdict, body)
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("connector: cannot write --out")
        return 4
    done: mutable darray[u8] = []
    rh_push_text(done, "connector: ok verdict=")
    if verdict == 0:
        rh_push_text(done, "usable")
    elif verdict == 1:
        rh_push_text(done, "unapproved")
    else:
        rh_push_text(done, "transport-rejected")
    done.push(10)
    rh_write_stdout(done)
    0

# --- M02-03 job classification execution path. ---
# Reads an rh-job-event/1 document (kind, attempt, now, max_attempts,
# backoff_cap_secs) and writes rh-job-next/1: the disposition, the next
# phase, the wake time for retries, and the incremented attempt. Failure
# kinds are distinct and never collapsed; an unknown kind fails closed
# (exit 4), an exhausted retryable failure dead-letters (never success).
def rh_do_job_classify(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected job argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if rh_io_read(ipp, raw) < 0:
        rh_cli_err("job: cannot read --input")
        return 4
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ:
        rh_cli_err("job: not a valid rh-job-event/1 document (fail closed)")
        return 4
    kind: i64 = |nodes, texts|
        ss: mutable i64 = 0
        se: mutable i64 = 0
        sidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
        if sidx < 0 or not Json::rh_json_str_span(nodes, sidx, &ss, &se):
            rh_cli_err("job: not a valid rh-job-event/1 document (fail closed)")
            return 4
        if not Job::rh_job_lit_eq(texts, ss, se, "rh-job-event/1"):
            rh_cli_err("job: not a valid rh-job-event/1 document (fail closed)")
            return 4
        ks: mutable i64 = 0
        ke: mutable i64 = 0
        kidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "kind")
        if kidx < 0 or not Json::rh_json_str_span(nodes, kidx, &ks, &ke):
            rh_cli_err("job: missing kind (fail closed)")
            return 4
        block_result: i64 = Job::rh_job_classify(texts, ks, ke)
        block_result
    if kind < 0:
        rh_cli_err("job: unknown failure kind (fail closed)")
        return 4
    ok_att: mutable i64 = 0
    ok_now: mutable i64 = 0
    atte: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "attempt"), &ok_att)
    nowi: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "now"), &ok_now)
    if ok_att == 0 or ok_now == 0 or atte < 1 or nowi < 0:
        rh_cli_err("job: missing/invalid attempt or now (fail closed)")
        return 4
    maxa: mutable i64 = 0
    cap: mutable i64 = 3600
    mi: i64 = Json::rh_json_obj_get(nodes, texts, root, "max_attempts")
    if mi >= 0:
        ok_m: mutable i64 = 0
        mv: i64 = Json::rh_json_int(nodes, raw, mi, &ok_m)
        if ok_m == 0 or mv < 0:
            rh_cli_err("job: invalid max_attempts (fail closed)")
            return 4
        maxa <- mv
    ci: i64 = Json::rh_json_obj_get(nodes, texts, root, "backoff_cap_secs")
    if ci >= 0:
        ok_c: mutable i64 = 0
        cv: i64 = Json::rh_json_int(nodes, raw, ci, &ok_c)
        if ok_c == 0 or cv < 0:
            rh_cli_err("job: invalid backoff_cap_secs (fail closed)")
            return 4
        cap <- cv
    nxt: Job::RhJobNext = Job::rh_job_on_failure(kind, atte, nowi, maxa, cap)
    body: mutable darray[u8] =
        body: mutable darray[u8] = []
        rh_push_text(body, "{\"schema\":\"rh-job-next/1\",\"kind\":\"")
        rh_push_text(body, Job::rh_job_kind_label(kind))
        rh_push_text(body, "\",\"disposition\":\"")
        body
    if nxt.phase == 4:
        rh_push_text(body, "terminal")
    elif nxt.phase == 7:
        rh_push_text(body, "dead_letter")
    else:
        rh_push_text(body, "retry")
    rh_push_text(body, "\",\"next_phase\":\"")
    rh_push_text(body, Job::rh_job_phase_label(nxt.phase))
    rh_push_text(body, "\",\"wake_at\":")
    rh_push_decimal_i64(body, nxt.wake_at)
    rh_push_text(body, ",\"next_attempt\":")
    rh_push_decimal_i64(body, nxt.attempt)
    rh_push_text(body, ",\"note\":\"failure kinds are distinct and never collapsed; auth/unsupported are terminal, malformed dead-letters, transient/rate-limit/budget retry with backoff, and an exhausted retry dead-letters rather than succeeding\"}")
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("job: cannot write --out")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        rh_push_text(done, "job: kind=")
        rh_push_text(done, Job::rh_job_kind_label(kind))
        rh_push_text(done, " next=")
        rh_push_text(done, Job::rh_job_phase_label(nxt.phase))
        done.push(10)
        done
    rh_write_stdout(done)
    0

# --- M02-03 scheduler execution path. ---
# Reads an rh-sched-input/1 document (queue capacity, host quota policy, and
# an ordered op sequence) and writes rh-sched-result/1 with the outcome of
# every op, the final per-slot phases, and the host quota/backoff state.
# Ops are applied in order, so the same input replays identically. A
# malformed/unknown op or invalid policy fails closed (exit 4).
def rh_do_job_run(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected job argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if rh_io_read(ipp, raw) < 0:
        rh_cli_err("job: cannot read --input")
        return 4
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ:
        rh_cli_err("job: not a valid rh-sched-input/1 document (fail closed)")
        return 4
    ss: mutable i64 = 0
    se: mutable i64 = 0
    sidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
    if sidx < 0 or not Json::rh_json_str_span(nodes, sidx, &ss, &se):
        rh_cli_err("job: not a valid rh-sched-input/1 document (fail closed)")
        return 4
    if not Job::rh_job_lit_eq(texts, ss, se, "rh-sched-input/1"):
        rh_cli_err("job: not a valid rh-sched-input/1 document (fail closed)")
        return 4
    ok_cap: mutable i64 = 0
    cap: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "capacity"), &ok_cap)
    if ok_cap == 0 or cap <= 0 or cap > 100000:
        rh_cli_err("job: missing/invalid capacity (fail closed)")
        return 4
    # Host policy (optional; defaults are conservative).
    hq: mutable i64 = 1
    hb: mutable i64 = 2
    hm: mutable i64 = 60
    hidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "quota")
    if hidx >= 0:
        if nodes[hidx.usize()].kind != Json::RH_JSON_OBJ:
            rh_cli_err("job: invalid quota (fail closed)")
            return 4
        okq: mutable i64 = 0
        okb: mutable i64 = 0
        okm: mutable i64 = 0
        qv: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, hidx, "refill_per_second"), &okq)
        if okq == 1:
            hq <- qv
        bv: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, hidx, "base_backoff_seconds"), &okb)
        if okb == 1:
            hb <- bv
        mv: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, hidx, "max_backoff_seconds"), &okm)
        if okm == 1:
            hm <- mv
        if hq < 0 or hb < 0 or hm < 0:
            rh_cli_err("job: invalid quota value (fail closed)")
            return 4
    qidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "ops")
    if qidx < 0 or nodes[qidx.usize()].kind != Json::RH_JSON_ARR:
        rh_cli_err("job: missing ops (fail closed)")
        return 4
    slots: mutable darray[Job::RhSlot] = Job::rh_sched_slots(cap)
    h: mutable Job::RhHost = Job::rh_sched_host(1000000, hq, hb, hm)
    opts_n: i64 = nodes[qidx.usize()].child_count
    if opts_n > 100000:
        rh_cli_err("job: op sequence too large (fail closed)")
        return 4
    op_idx: mutable darray[i64] = []
    op_code: mutable darray[i64] = []
    op_out: mutable darray[i64] = []
    while child >= 0 |child: i64 = nodes[qidx.usize()].first_child, oi: i64 = 0, nodes, texts, raw, slots, h, op_idx, op_code, op_out|:
        if nodes[child.usize()].kind != Json::RH_JSON_OBJ:
            rh_cli_err("job: op is not an object (fail closed)")
            return 4
        code: i64 = |nodes, texts|
            cs: mutable i64 = 0
            ce: mutable i64 = 0
            cidx: i64 = Json::rh_json_obj_get(nodes, texts, child, "op")
            if cidx < 0 or not Json::rh_json_str_span(nodes, cidx, &cs, &ce):
                rh_cli_err("job: op has no code (fail closed)")
                return 4
            block_result: i64 = Job::rh_job_op_code(texts, cs, ce)
            block_result
        if code < 0:
            rh_cli_err("job: unknown op (fail closed)")
            return 4
        op: Job::RhSchedOp = Job::RhSchedOp{code: code, a: 0, b: 0, c: 0, d: 0, e: 0, f: 0}
        if code == 0:
            op.a <- Job::rh_opt_int(nodes, raw, texts, child, "now", 0)
        elif code == 1:
            op.a <- Job::rh_opt_int(nodes, raw, texts, child, "owner", 0)
            op.b <- Job::rh_opt_int(nodes, raw, texts, child, "now", 0)
            op.c <- Job::rh_opt_int(nodes, raw, texts, child, "ttl", 0)
        elif code == 2:
            op.a <- Job::rh_opt_int(nodes, raw, texts, child, "slot", 0)
            op.b <- Job::rh_opt_int(nodes, raw, texts, child, "token", 0)
        elif code == 3:
            op.a <- Job::rh_opt_int(nodes, raw, texts, child, "slot", 0)
            op.b <- Job::rh_opt_int(nodes, raw, texts, child, "token", 0)
            kind_s: mutable i64 = 0
            kind_e: mutable i64 = 0
            kidx2: i64 = Json::rh_json_obj_get(nodes, texts, child, "kind")
            if kidx2 < 0 or not Json::rh_json_str_span(nodes, kidx2, &kind_s, &kind_e):
                rh_cli_err("job: fail op has no kind (fail closed)")
                return 4
            op.c <- Job::rh_job_classify(texts, kind_s, kind_e)
            if op.c < 0:
                rh_cli_err("job: unknown failure kind (fail closed)")
                return 4
            op.d <- Job::rh_opt_int(nodes, raw, texts, child, "now", 0)
            op.e <- Job::rh_opt_int(nodes, raw, texts, child, "max_attempts", 0)
            op.f <- Job::rh_opt_int(nodes, raw, texts, child, "backoff_cap_secs", 3600)
        elif code == 4:
            op.a <- Job::rh_opt_int(nodes, raw, texts, child, "slot", 0)
        elif code == 5:
            op.a <- Job::rh_opt_int(nodes, raw, texts, child, "slot", 0)
            op.b <- Job::rh_opt_int(nodes, raw, texts, child, "now", 0)
        outv: i64 = Job::rh_sched_apply(slots, &h, &op)
        op_idx.push(oi)
        op_code.push(code)
        op_out.push(outv)
        oi <- oi + 1
        child <- nodes[child.usize()].next_sibling
    # Emit.
    body: mutable darray[u8] =
        body: mutable darray[u8] = []
        rh_push_text(body, "{\"schema\":\"rh-sched-result/1\",\"capacity\":")
        rh_push_decimal_i64(body, cap)
        rh_push_text(body, ",\"ops\":[")
        body
    while k < op_idx.count |k: usize = 0, op_idx, op_code, op_out, body|:
        if k > 0:
            body.push(44)
        rh_push_text(body, "{\"index\":")
        rh_push_decimal_i64(body, op_idx[k])
        rh_push_text(body, ",\"op\":\"")
        rh_push_text(body, Job::rh_job_op_label(op_code[k]))
        rh_push_text(body, "\",\"outcome\":")
        rh_push_decimal_i64(body, op_out[k])
        rh_push_text(body, "}")
        k <- k + 1
    rh_push_text(body, "],\"slots\":[")
    while s2 < slots.count |s2: usize = 0, slots, body|:
        if s2 > 0:
            body.push(44)
        sl: Job::RhSlot = slots[s2]
        rh_push_text(body, "{\"slot\":")
        rh_push_decimal_i64(body, s2.i64())
        rh_push_text(body, ",\"used\":")
        if sl.used:
            rh_push_text(body, "true")
        else:
            rh_push_text(body, "false")
        rh_push_text(body, ",\"phase\":\"")
        if sl.used:
            rh_push_text(body, Job::rh_job_phase_label(sl.phase))
        else:
            rh_push_text(body, "empty")
        rh_push_text(body, "\",\"attempt\":")
        rh_push_decimal_i64(body, sl.attempt)
        rh_push_text(body, ",\"token\":")
        rh_push_decimal_i64(body, sl.token)
        rh_push_text(body, "}")
        s2 <- s2 + 1
    rh_push_text(body, "],\"host\":{\"tokens\":")
    rh_push_decimal_i64(body, h.tokens)
    rh_push_text(body, ",\"backoff_until\":")
    rh_push_decimal_i64(body, h.backoff_until)
    rh_push_text(body, ",\"consecutive_failures\":")
    rh_push_decimal_i64(body, h.consecutive_failures)
    rh_push_text(body, "},\"note\":\"ops are applied in order and replay identically; the queue is bounded (enqueue past capacity is refused), claims consume a host token, and a failed job retries with backoff, dead-letters, or goes terminal by classification, never silent success\"}")
    body.push(10)
    op2: mutable darray[u8] =
        op2: mutable darray[u8] = []
        rh_push_cstr(op2, out_path)
        op2.push(0)
        op2
    opp: cstr = (&op2[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("job: cannot write --out")
        return 4
    rh_cli_out("job: run ok")
    0

# --- M02-06 reconciliation execution path. ---
# Reads an `rh-reconcile-input/1` document (last successful full reconcile
# time, reconcile interval, optional last incremental cursor time, overlap
# window, and now) and writes `rh-reconcile-result/1` with the tick mode, the
# look-back horizon a full reconcile must cover, the incremental overlap
# start, and the schedule debt. A missing/invalid interval fails closed
# (exit 4), so a misconfigured zero interval can never cause a tight loop.
def rh_do_reconcile(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected reconcile argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if rh_io_read(ipp, raw) < 0:
        rh_cli_err("reconcile: cannot read --input")
        return 4
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ:
        rh_cli_err("reconcile: not a valid rh-reconcile-input/1 document (fail closed)")
        return 4
    ss: mutable i64 = 0
    se: mutable i64 = 0
    sidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
    if sidx < 0 or not Json::rh_json_str_span(nodes, sidx, &ss, &se):
        rh_cli_err("reconcile: not a valid rh-reconcile-input/1 document (fail closed)")
        return 4
    if not Job::rh_job_lit_eq(texts, ss, se, "rh-reconcile-input/1"):
        rh_cli_err("reconcile: not a valid rh-reconcile-input/1 document (fail closed)")
        return 4
    ok_iv: mutable i64 = 0
    interval: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "interval_secs"), &ok_iv)
    if ok_iv == 0 or interval <= 0:
        rh_cli_err("reconcile: missing/invalid interval_secs (fail closed)")
        return 4
    ok_now: mutable i64 = 0
    now: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "now"), &ok_now)
    if ok_now == 0 or now < 0:
        rh_cli_err("reconcile: missing/invalid now (fail closed)")
        return 4
    last_full: mutable i64 = -1
    lf: i64 = Json::rh_json_obj_get(nodes, texts, root, "last_full_reconcile")
    if lf >= 0:
        ok_lf: mutable i64 = 0
        v: i64 = Json::rh_json_int(nodes, raw, lf, &ok_lf)
        if ok_lf == 0 or v < -1:
            rh_cli_err("reconcile: invalid last_full_reconcile (fail closed)")
            return 4
        last_full <- v
    cursor: mutable i64 = -1
    ci: i64 = Json::rh_json_obj_get(nodes, texts, root, "cursor_time")
    if ci >= 0:
        ok_c: mutable i64 = 0
        cv: i64 = Json::rh_json_int(nodes, raw, ci, &ok_c)
        if ok_c == 0 or cv < -1:
            rh_cli_err("reconcile: invalid cursor_time (fail closed)")
            return 4
        cursor <- cv
    overlap: mutable i64 = 3600
    oi: i64 = Json::rh_json_obj_get(nodes, texts, root, "overlap_secs")
    if oi >= 0:
        ok_o: mutable i64 = 0
        ov: i64 = Json::rh_json_int(nodes, raw, oi, &ok_o)
        if ok_o == 0 or ov < 0:
            rh_cli_err("reconcile: invalid overlap_secs (fail closed)")
            return 4
        overlap <- ov
    mode: u8 = Reconcile::rh_reconcile_mode(last_full, interval, now)
    horizon: i64 = Reconcile::rh_reconcile_horizon(last_full, now)
    debt: i64 = Reconcile::rh_reconcile_debt(last_full, interval, now)
    next_due: i64 = Reconcile::rh_reconcile_next_due(last_full, interval)
    ovl_start: i64 = Reconcile::rh_cursor_overlap_start(cursor, overlap)
    body: mutable darray[u8] = []
    rh_push_text(body, "{\"schema\":\"rh-reconcile-result/1\",\"mode\":\"")
    if mode == Reconcile::RH_RECON_DUE:
        rh_push_text(body, "full")
    else:
        rh_push_text(body, "incremental")
    rh_push_text(body, "\",\"interval_secs\":")
    rh_push_decimal_i64(body, interval)
    rh_push_text(body, ",\"last_full_reconcile\":")
    rh_push_decimal_i64(body, last_full)
    rh_push_text(body, ",\"next_due_at\":")
    rh_push_decimal_i64(body, next_due)
    rh_push_text(body, ",\"horizon_secs\":")
    rh_push_decimal_i64(body, horizon)
    rh_push_text(body, ",\"schedule_debt\":")
    rh_push_decimal_i64(body, debt)
    rh_push_text(body, ",\"cursor_time\":")
    rh_push_decimal_i64(body, cursor)
    rh_push_text(body, ",\"overlap_start\":")
    rh_push_decimal_i64(body, ovl_start)
    rh_push_text(body, ",\"note\":\"only a completed full reconcile advances the full-reconcile clock; incremental cursors never do; a due full reconcile covers the whole interval since the last full reconcile because a cursor proves which updates were seen, not what was deleted; schedule debt raises a service-health signal and never silently skips reconciles\"}")
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("reconcile: cannot write --out")
        return 4
    done: mutable darray[u8] = []
    rh_push_text(done, "reconcile: mode=")
    if mode == Reconcile::RH_RECON_DUE:
        rh_push_text(done, "full")
    else:
        rh_push_text(done, "incremental")
    rh_push_text(done, " debt=")
    rh_push_decimal_i64(done, debt)
    done.push(10)
    rh_write_stdout(done)
    0

# --- M02-03/M02-06 unattended worker pass. ---
# Reads an `rh-worker-input/1` document (queue capacity, host quota policy,
# the source table, and now) and writes `rh-worker-plan/1`: one decision per
# source (full reconcile / incremental / skipped), the reconcile horizon and
# overlap start, the schedule debt, and an aggregate service-health summary.
# The pass is deterministic and bounded (no loop), so replaying it at the
# same `now` yields the identical plan. Malformed/invalid input fails closed.
def rh_do_worker_tick(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected worker argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if rh_io_read(ipp, raw) < 0:
        rh_cli_err("worker: cannot read --input")
        return 4
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ:
        rh_cli_err("worker: not a valid rh-worker-input/1 document (fail closed)")
        return 4
    ss: mutable i64 = 0
    se: mutable i64 = 0
    sidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
    if sidx < 0 or not Json::rh_json_str_span(nodes, sidx, &ss, &se):
        rh_cli_err("worker: not a valid rh-worker-input/1 document (fail closed)")
        return 4
    if not Job::rh_job_lit_eq(texts, ss, se, "rh-worker-input/1"):
        rh_cli_err("worker: not a valid rh-worker-input/1 document (fail closed)")
        return 4
    ok_cap: mutable i64 = 0
    cap: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "capacity"), &ok_cap)
    if ok_cap == 0 or cap <= 0 or cap > 100000:
        rh_cli_err("worker: missing/invalid capacity (fail closed)")
        return 4
    ok_now: mutable i64 = 0
    now: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "now"), &ok_now)
    if ok_now == 0 or now < 0:
        rh_cli_err("worker: missing/invalid now (fail closed)")
        return 4
    # Host quota (optional; conservative defaults).
    hq: mutable i64 = 1
    hb: mutable i64 = 2
    hm: mutable i64 = 60
    hidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "quota")
    if hidx >= 0:
        if nodes[hidx.usize()].kind != Json::RH_JSON_OBJ:
            rh_cli_err("worker: invalid quota (fail closed)")
            return 4
        okq: mutable i64 = 0
        okb: mutable i64 = 0
        okm: mutable i64 = 0
        qv: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, hidx, "refill_per_second"), &okq)
        if okq == 1:
            hq <- qv
        bv: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, hidx, "base_backoff_seconds"), &okb)
        if okb == 1:
            hb <- bv
        mv: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, hidx, "max_backoff_seconds"), &okm)
        if okm == 1:
            hm <- mv
        if hq < 0 or hb < 0 or hm < 0:
            rh_cli_err("worker: invalid quota value (fail closed)")
            return 4
    sid: i64 = Json::rh_json_obj_get(nodes, texts, root, "sources")
    if sid < 0 or nodes[sid.usize()].kind != Json::RH_JSON_ARR:
        rh_cli_err("worker: missing sources (fail closed)")
        return 4
    srcs: mutable darray[RhSourceJob] = []
    while child >= 0 |child: i64 = nodes[sid.usize()].first_child, nodes, texts, raw, srcs|:
        if nodes[child.usize()].kind != Json::RH_JSON_OBJ:
            rh_cli_err("worker: source is not an object (fail closed)")
            return 4
        oksi: mutable i64 = 0
        oki: mutable i64 = 0
        source_id: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, child, "source_id"), &oksi)
        interval: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, child, "interval_secs"), &oki)
        if oksi == 0 or oki == 0 or interval <= 0:
            rh_cli_err("worker: source missing/invalid source_id or interval_secs (fail closed)")
            return 4
        last_full: mutable i64 = -1
        lfi: i64 = Json::rh_json_obj_get(nodes, texts, child, "last_full_reconcile")
        if lfi >= 0:
            okl: mutable i64 = 0
            lv: i64 = Json::rh_json_int(nodes, raw, lfi, &okl)
            if okl == 0 or lv < -1:
                rh_cli_err("worker: invalid last_full_reconcile (fail closed)")
                return 4
            last_full <- lv
        cursor: mutable i64 = -1
        ci: i64 = Json::rh_json_obj_get(nodes, texts, child, "cursor_time")
        if ci >= 0:
            okc: mutable i64 = 0
            cv: i64 = Json::rh_json_int(nodes, raw, ci, &okc)
            if okc == 0 or cv < -1:
                rh_cli_err("worker: invalid cursor_time (fail closed)")
                return 4
            cursor <- cv
        overlap: mutable i64 = 3600
        oi: i64 = Json::rh_json_obj_get(nodes, texts, child, "overlap_secs")
        if oi >= 0:
            oko: mutable i64 = 0
            ov: i64 = Json::rh_json_int(nodes, raw, oi, &oko)
            if oko == 0 or ov < 0:
                rh_cli_err("worker: invalid overlap_secs (fail closed)")
                return 4
            overlap <- ov
        srcs.push(rh_worker_source(source_id, interval, last_full, cursor, overlap))
        child <- nodes[child.usize()].next_sibling
    slots: mutable darray[Job::RhSlot] = Job::rh_sched_slots(cap)
    h: mutable Job::RhHost = Job::rh_sched_host(1000000, hq, hb, hm)
    dec: mutable darray[RhWorkerDecision] = []
    hl: RhWorkerHealth =
        enq: i64 = rh_worker_pass(srcs, &h, slots, now, dec)
        rh_worker_health(dec, enq)
    body: mutable darray[u8] =
        body: mutable darray[u8] = []
        rh_push_text(body, "{\"schema\":\"rh-worker-plan/1\",\"capacity\":")
        rh_push_decimal_i64(body, cap)
        rh_push_text(body, ",\"now\":")
        rh_push_decimal_i64(body, now)
        rh_push_text(body, ",\"decisions\":[")
        body
    while k < dec.count |k: usize = 0, dec, body|:
        if k > 0:
            body.push(44)
        d: RhWorkerDecision = dec[k]
        rh_push_text(body, "{\"source_id\":")
        rh_push_decimal_i64(body, d.source_id)
        rh_push_text(body, ",\"mode\":\"")
        if d.mode == 1:
            rh_push_text(body, "full")
        elif d.mode == 2:
            rh_push_text(body, "incremental")
        else:
            rh_push_text(body, "skipped")
        rh_push_text(body, "\",\"slot\":")
        rh_push_decimal_i64(body, d.slot)
        rh_push_text(body, ",\"horizon_secs\":")
        rh_push_decimal_i64(body, d.horizon_secs)
        rh_push_text(body, ",\"overlap_start\":")
        rh_push_decimal_i64(body, d.overlap_start)
        rh_push_text(body, ",\"schedule_debt\":")
        rh_push_decimal_i64(body, d.debt)
        rh_push_text(body, "}")
        k <- k + 1
    rh_push_text(body, "],\"health\":{\"enqueued\":")
    rh_push_decimal_i64(body, hl.enqueued)
    rh_push_text(body, ",\"skipped\":")
    rh_push_decimal_i64(body, hl.skipped)
    rh_push_text(body, ",\"overdue\":")
    rh_push_decimal_i64(body, hl.overdue)
    rh_push_text(body, ",\"max_debt\":")
    rh_push_decimal_i64(body, hl.max_debt)
    rh_push_text(body, "},\"note\":\"one bounded, deterministic scheduling pass; a due full reconcile takes priority over an incremental; a skipped source keeps its schedule debt visible so the next tick retries and never silently drops it\"}")
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("worker: cannot write --out")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        rh_push_text(done, "worker: enqueued=")
        rh_push_decimal_i64(done, hl.enqueued)
        rh_push_text(done, " skipped=")
        rh_push_decimal_i64(done, hl.skipped)
        rh_push_text(done, " overdue=")
        rh_push_decimal_i64(done, hl.overdue)
        done.push(10)
        done
    rh_write_stdout(done)
    0

# Parses a CycloneDX or SPDX-2.3 document and writes rh-inventory/1. An
# unsupported declared spec version is reported (exit 3), never interpreted;
# a document of the wrong format fails closed (exit 4). The notice states
# that validity does not imply completeness. URL input retains bounded
# source/status/error evidence before parsing.
def rh_do_inventory(format: cstr, input_path: cstr, out_path: cstr, source_url: cstr, has_url: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(format) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected inventory argument (allowlist)")
        return 3
    fmt: mutable u8 = 0
    if rh_streq(format, "cyclonedx"):
        fmt <- 0
    elif rh_streq(format, "spdx"):
        fmt <- 1
    else:
        rh_cli_err("inventory: unsupported --format (cyclonedx|spdx)")
        return 3
    raw: mutable darray[u8] = []
    if has_url:
        return 3 if not Git::rh_fetch_arg_safe(source_url)
        source_path: mutable darray[u8] =
            source_path: mutable darray[u8] = []
            rh_push_cstr(source_path, out_path)
            rh_push_text(source_path, ".source")
            source_path.push(0)
            source_path
        status_path: mutable darray[u8] =
            status_path: mutable darray[u8] = []
            rh_push_cstr(status_path, out_path)
            rh_push_text(status_path, ".source.status")
            status_path.push(0)
            status_path
        error_path: mutable darray[u8] =
            error_path: mutable darray[u8] = []
            rh_push_cstr(error_path, out_path)
            rh_push_text(error_path, ".source.err")
            error_path.push(0)
            error_path
        source_ptr: cstr = (&source_path[0]).cast[cstr] can Unsafe.PointerCast
        status_ptr: cstr = (&status_path[0]).cast[cstr] can Unsafe.PointerCast
        error_ptr: cstr = (&error_path[0]).cast[cstr] can Unsafe.PointerCast
        if Git::rh_run_https_get(source_url, source_ptr, status_ptr, error_ptr) != 0:
            rh_cli_err("inventory: fetch failed; source and stderr evidence retained")
            return 4
        status_raw: mutable darray[u8] = []
        if rh_io_read(status_ptr, status_raw) < 0 or status_raw.count == 0:
            rh_cli_err("inventory: fetch did not produce a status")
            return 4
        ok_status: bool = status_raw[0] == 50
        file_transport: bool = status_raw.count >= 3 and status_raw[0] == 48 and status_raw[1] == 48 and status_raw[2] == 48 and rh_cstr_starts_with(source_url, "file://")
        if not ok_status and not file_transport:
            rh_cli_err("inventory: fetch returned non-2xx; no result published")
            return 4
        if rh_io_read(source_ptr, raw) < 0:
            rh_cli_err("inventory: cannot read fetched source evidence")
            return 4
    else:
        return 3 if not Git::rh_arg_safe(input_path)
        ip: mutable darray[u8] =
            ip: mutable darray[u8] = []
            rh_push_cstr(ip, input_path)
            ip.push(0)
            ip
        ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
        if rh_io_read(ipp, raw) < 0:
            rh_cli_err("inventory: cannot read --input")
            return 4
    body: mutable darray[u8] = []
    rc: i64 = rh_inventory_report(raw, fmt, body)
    if rc == -1:
        rh_cli_err("inventory: input is not a valid document for the requested format (fail closed)")
        return 4
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("inventory: cannot write --out")
        return 4
    if rc == 1:
        rh_cli_err("inventory: declared spec version is unsupported (reported, not interpreted)")
        return 3
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        rh_push_text(done, "inventory: normalized ")
        rh_push_cstr(done, format)
        done.push(10)
        done
    rh_write_stdout(done)
    0

# --- M08 native-VCS / non-PR execution path. ---
# `--format hg` parses `hg log -Tjson` into rh-vcs/1 (native node id, local
# rev, raw author, tags-not-releases, rejected-not-guessed). `--format patch`
# parses an mbox-like series into rh-patch/1 (logical-change collapse,
# trailer counts, Fixes: is a claim). `--repo` runs a bounded native command,
# retains its source and stderr beside the normalized report, and then uses the
# same parser as `--input`. Wrong shape / unknown format fails closed.
def rh_do_vcs(format: cstr, input_path: cstr, out_path: cstr, repo_path: cstr, has_repo: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(format) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected vcs argument (allowlist)")
        return 3
    if has_repo:
        if not Git::rh_arg_safe(repo_path):
            rh_cli_err("rejected vcs repository argument (allowlist)")
            return 3
    elif not Git::rh_arg_safe(input_path):
        rh_cli_err("rejected vcs input argument (allowlist)")
        return 3
    fmt: mutable u8 = 0
    if rh_streq(format, "hg"):
        fmt <- 0
    elif rh_streq(format, "patch"):
        fmt <- 1
    elif rh_streq(format, "svn"):
        fmt <- 2
    elif rh_streq(format, "fossil"):
        fmt <- 3
    elif rh_streq(format, "gerrit"):
        fmt <- 4
    else:
        rh_cli_err("vcs: unsupported --format (hg|svn|fossil|patch|gerrit)")
        return 3
    raw: mutable darray[u8] = []
    if has_repo:
        return 3 if fmt == 1 or fmt == 4
        source_path: mutable darray[u8] =
            source_path: mutable darray[u8] = []
            rh_push_cstr(source_path, out_path)
            rh_push_text(source_path, ".source")
            source_path.push(0)
            source_path
        error_path: mutable darray[u8] =
            error_path: mutable darray[u8] = []
            rh_push_cstr(error_path, out_path)
            rh_push_text(error_path, ".source.err")
            error_path.push(0)
            error_path
        source_ptr: cstr = (&source_path[0]).cast[cstr] can Unsafe.PointerCast
        error_ptr: cstr = (&error_path[0]).cast[cstr] can Unsafe.PointerCast
        command_rc: i64 =
            if fmt == 0:
                Git::rh_run_hg_log(repo_path, source_ptr, error_ptr)
            elif fmt == 2:
                Git::rh_run_svn_log(repo_path, source_ptr, error_ptr)
            else:
                Git::rh_run_fossil_timeline(repo_path, source_ptr, error_ptr)
        if command_rc != 0:
            rh_cli_err("vcs: native collector failed; source and stderr evidence retained")
            return 4
        if rh_io_read(source_ptr, raw) < 0:
            rh_cli_err("vcs: cannot read native source evidence")
            return 4
    else:
        ip: mutable darray[u8] =
            ip: mutable darray[u8] = []
            rh_push_cstr(ip, input_path)
            ip.push(0)
            ip
        ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
        if rh_io_read(ipp, raw) < 0:
            rh_cli_err("vcs: cannot read --input")
            return 4
    body: mutable darray[u8] = []
    if rh_vcs_report(raw, fmt, body) != 0:
        rh_cli_err("vcs: input does not parse for the requested format (fail closed)")
        return 4
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("vcs: cannot write --out")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        rh_push_text(done, "vcs: normalized ")
        rh_push_cstr(done, format)
        done.push(10)
        done
    rh_write_stdout(done)
    0

# --- M06-08 notification execution path. ---
# Reads an rh-notify-input/1 event stream and writes rh-notify-result/1.
# An upstream maintainer destination is refused unless subscribed; the
# refusal records nothing (no phantom cooldown). Dedup/cooldown on
# (rule, subject, artifact digest); outage suppresses; ack/resolve silence.
# With --state <file>, prior state is loaded (missing file = fresh) and the
# updated state is written back, so cooldowns/acks/resolutions persist
# across runs.
def rh_do_notify_state(input_path: cstr, out_path: cstr, state_path: cstr, has_state: bool, state_root: cstr, has_state_root: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected notify argument (allowlist)")
        return 3
    if has_state and not Git::rh_arg_safe(state_path):
        rh_cli_err("rejected notify state argument (allowlist)")
        return 3
    if has_state and has_state_root:
        rh_cli_err("notify: --state and --state-store are mutually exclusive")
        return 2
    if has_state_root and not Git::rh_arg_safe(state_root):
        rh_cli_err("rejected notify state-store argument (allowlist)")
        return 3
