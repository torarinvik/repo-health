# --- M03-02 local package-archive byte observation. ---
def rh_do_artifact_observation(graph_path: cstr, artifact_id: i64, artifact_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    graph_size: i64 = Base::rh_file_size(graph_path)
    if graph_size <= 0 or graph_size > ArtifactObservation::RH_ARTIFACT_OBSERVATION_MAX_GRAPH_BYTES:
        rh_cli_err("artifact-observe: graph size is empty, unavailable, or over the 8 MiB bound")
        return 4
    graph: mutable darray[u8] = []
    if Base::rh_io_read(graph_path, graph) != graph_size:
        rh_cli_err("artifact-observe: cannot read --graph")
        return 4
    artifact_size: i64 = Base::rh_file_size(artifact_path)
    if artifact_size <= 0 or artifact_size > ArtifactObservation::RH_ARTIFACT_OBSERVATION_MAX_BYTES:
        rh_cli_err("artifact-observe: file size is empty, unavailable, or over the 64 MiB bound")
        return 4
    artifact_bytes: mutable darray[u8] = []
    if Base::rh_io_read(artifact_path, artifact_bytes) != artifact_size:
        rh_cli_err("artifact-observe: cannot read complete local artifact bytes")
        return 4
    body: mutable darray[u8] = []
    if ArtifactObservation::rh_artifact_observation(graph, artifact_bytes, artifact_id, body) != 0:
        rh_cli_err("artifact-observe: graph record is malformed or outside the supported Cargo, npm, or Go go.mod digest contract")
        return 3
    body.push(10)
    if not Base::rh_io_write(out_path, body):
        rh_cli_err("artifact-observe: cannot write --out")
        return 4
    rh_cli_out("artifact-observe: local artifact digest recorded against graph and artifact identity")
    0

# --- M03-10 parser-adoption differential path. ---
def rh_do_parser_diff(native_path: cstr, candidate_path: cstr, out_path: cstr, native_parser: cstr, candidate_parser: cstr, configuration: cstr, visibility: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(native_path) or not Git::rh_arg_safe(candidate_path) or not Git::rh_arg_safe(out_path) or not Git::rh_arg_safe(native_parser) or not Git::rh_arg_safe(candidate_parser) or not Git::rh_arg_safe(configuration) or not Git::rh_arg_safe(visibility):
        rh_cli_err("rejected parser-diff argument (allowlist)")
        return 3
    native_raw: mutable darray[u8] = []
    candidate_raw: mutable darray[u8] = []
    if Base::rh_io_read(native_path, native_raw) < 0 or Base::rh_io_read(candidate_path, candidate_raw) < 0:
        rh_cli_err("parser-diff: cannot read retained input")
        return 4
    body: mutable darray[u8] = []
    diff_rc: i64 = ParserDiff::rh_parser_diff_report(native_raw, candidate_raw, body, native_parser, candidate_parser, configuration, visibility)
    if diff_rc == -1:
        rh_cli_err("parser-diff: malformed native graph (fail closed)")
        return 4
    body.push(10)
    if not Base::rh_io_write(out_path, body):
        rh_cli_err("parser-diff: cannot write --out")
        return 4
    if diff_rc == -2:
        rh_cli_err("parser-diff: candidate parser unsupported")
        return 3
    rh_cli_out("parser-diff: comparison observed")
    0

def rh_path_arg_ok(s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if Base::rh_cstr_len_c(s) == 0
    while true |i: usize = 0, s|:
        b: u8 = s[i]
        break if b == 0
        return false if b < 32 or b == 127
        i <- i + 1
    true

def rh_span_is(texts: darray[u8]&, start: i64, end: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: i64 =
        while i < end |n: i64 = 0, i: i64 = start| -> n:
            b: u8 = texts[i.usize()]
            l: u8 = lit[n.usize()]
            return false if l == 0
            return false if b != l
            n <- n + 1
            i <- i + 1
    lit[n.usize()] == 0

def rh_span_copy(texts: darray[u8]&, start: i64, end: i64) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    out: mutable darray[u8] = []
    while i < end |i: i64 = start, texts, out|:
        out.push(texts[i.usize()])
        i <- i + 1
    out

def rh_do_sign(key_path: cstr, subject_path: cstr, sig_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    key: mutable darray[u8] = []
    if Base::rh_io_read(key_path, key) < 0:
        rh_cli_err("sign: cannot read key file")
        return 4
    if key.count == 0:
        rh_cli_err("sign: refusing to sign with an empty key")
        return 3
    subject: mutable darray[u8] = []
    if Base::rh_io_read(subject_path, subject) < 0:
        rh_cli_err("sign: cannot read subject file")
        return 4
    sig: mutable darray[u8] = []
    Sha256::rh_hmac_sha256(key, subject, sig)
    subj_hash: mutable darray[u8] = []
    Sha256::rh_sha256(subject, subj_hash)
    out: mutable darray[u8] = []
    Base::rh_push_text(out, "{\"format\":\"rh-release-signature/1\",\"algorithm\":\"hmac-sha256\",\"subject_sha256\":\"")
    _ = Base::rh_absorb_bytes(subj_hash, out)
    Base::rh_push_text(out, "\",\"signature\":\"")
    _ = Base::rh_absorb_bytes(sig, out)
    Base::rh_push_text(out, "\"}\n")
    if not Base::rh_io_write(sig_path, out):
        rh_cli_err("sign: cannot write signature file")
        return 4
    rh_cli_out("signed hmac-sha256 (integrity + key possession; not a code-safety claim)")
    0

def rh_do_verify(key_path: cstr, subject_path: cstr, sig_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    key: mutable darray[u8] = []
    if Base::rh_io_read(key_path, key) < 0:
        rh_cli_err("verify: cannot read key file")
        return 4
    if key.count == 0:
        rh_cli_err("verify: empty key cannot verify")
        return 3
    subject: mutable darray[u8] = []
    if Base::rh_io_read(subject_path, subject) < 0:
        rh_cli_err("verify: cannot read subject file")
        return 4
    sigbytes: mutable darray[u8] = []
    if Base::rh_io_read(sig_path, sigbytes) < 0:
        rh_cli_err("verify: cannot read signature file")
        return 4
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(sigbytes, nodes, texts)
    if root < 0:
        rh_cli_err("verify: signature file is not valid JSON")
        return 3
    algo: i64 = Json::rh_json_obj_get(nodes, texts, root, "algorithm")
    a_start: mutable i64 = 0
    a_end: mutable i64 = 0
    if algo < 0 or not Json::rh_json_str_span(nodes, algo, &a_start, &a_end):
        rh_cli_err("verify: signature missing string algorithm")
        return 3
    if not rh_span_is(texts, a_start, a_end, "hmac-sha256"):
        rh_cli_err("verify: unsupported signature algorithm")
        return 3
    sig_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "signature")
    s_start: mutable i64 = 0
    s_end: mutable i64 = 0
    if sig_idx < 0 or not Json::rh_json_str_span(nodes, sig_idx, &s_start, &s_end):
        rh_cli_err("verify: signature missing string signature")
        return 3
    want: mutable darray[u8] = []
    Sha256::rh_hmac_sha256(key, subject, want)
    got: darray[u8] = rh_span_copy(texts, s_start, s_end)
    if not Sha256::rh_hex_eq(want, got):
        rh_cli_err("verify: signature does not match subject (integrity FAILED)")
        return 5
    subj_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "subject_sha256")
    h_start: mutable i64 = 0
    h_end: mutable i64 = 0
    if subj_idx < 0 or not Json::rh_json_str_span(nodes, subj_idx, &h_start, &h_end):
        rh_cli_err("verify: signature missing string subject_sha256")
        return 3
    actual_subj: mutable darray[u8] = []
    Sha256::rh_sha256(subject, actual_subj)
    claimed_subj: darray[u8] = rh_span_copy(texts, h_start, h_end)
    if not Sha256::rh_hex_eq(actual_subj, claimed_subj):
        rh_cli_err("verify: subject digest mismatch (signature paired with different bytes)")
        return 5
    rh_cli_out("signature ok: integrity + key possession verified (not a code-safety claim)")
    0

# --- M04 continuity execution path: publish continuity + persistence. ---
# Reads the pinned bundle written by `scan` (no live data), builds raw
# project-local author identity presence over complete months, and writes
# continuity.json (rh-continuity/1) plus continuity-metrics.json
# (persistence.retained_90d). Retention requires full, non-shallow history:
# a windowed or shallow scan cannot establish an actor's first observation,
# so it reports `unsupported` rather than a misleading rate.
def rh_do_continuity(bundle: cstr, out: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(bundle):
        rh_cli_err("rejected bundle argument (allowlist)")
        return 3
    if not Git::rh_arg_safe(out):
        rh_cli_err("rejected output argument (allowlist)")
        return 3
    manb: mutable darray[u8] = []
    bpath: mutable darray[u8] =
        bpath: mutable darray[u8] = []
        Base::rh_push_cstr(bpath, bundle)
        bpath.push(0)
        bpath
    bp: cstr = (&bpath[0]).cast[cstr] can Unsafe.PointerCast
    if Base::rh_io_read(bp, manb) < 0:
        rh_cli_err("cannot read bundle manifest")
        return 4
    ok_days: mutable i64 = 0
    days: i64 = Report::rh_report_manifest_int(manb, "window-days: ", &ok_days)
    if ok_days == 0 or days <= 0:
        rh_cli_err("manifest has no parseable window-days")
        return 4
    full: bool = Report::rh_report_manifest_flag(manb, "full-history: ") == 1
    ok_cut: mutable i64 = 0
    cutoff: i64 = Report::rh_report_manifest_int(manb, "evidence-cutoff: ", &ok_cut)
    if ok_cut == 0 or cutoff <= 0:
        rh_cli_err("manifest has no parseable evidence-cutoff")
        return 4
    dir: mutable darray[u8] = []
    has_dir: bool = rh_dirname(bundle, dir)
    logpath: mutable darray[u8] = []
    if has_dir:
        Base::rh_push_cstr(logpath, (&dir[0]).cast[cstr] can Unsafe.PointerCast)
        logpath.push(47)
    Base::rh_push_text(logpath, "evidence/git-log.bin")
    logpath.push(0)
    logb: mutable darray[u8] = []
    logp: cstr = (&logpath[0]).cast[cstr] can Unsafe.PointerCast
    if Base::rh_io_read(logp, logb) < 0:
        rh_cli_err("cannot read retained log evidence (no live data substituted)")
        return 4
    shapath: mutable darray[u8] = []
    if has_dir:
        Base::rh_push_cstr(shapath, (&dir[0]).cast[cstr] can Unsafe.PointerCast)
        shapath.push(47)
    Base::rh_push_text(shapath, "evidence/git-shallow.txt")
    shapath.push(0)
    shab: mutable darray[u8] = []
    shallow: mutable bool = false
    shap: cstr = (&shapath[0]).cast[cstr] can Unsafe.PointerCast
    if Base::rh_io_read(shap, shab) >= 0:
        if shab.count >= 4:
            if shab[0] == 116 and shab[1] == 114 and shab[2] == 117 and shab[3] == 101:
                shallow <- true
    window_start: i64 = cutoff - days * 86400 if not full else 0
    actor: mutable darray[i64] = []
    month: mutable darray[i64] = []
    inst: mutable darray[i64] = []
    kind: mutable darray[u8] = []
    n_actors: mutable i64 = 0
    accepted: i64 = ContinuityScan::rh_cs_parse(logb, window_start, cutoff, actor, month, inst, kind, &n_actors)
    if accepted < 0:
        rh_cli_err("continuity: invalid window inputs")
        return 4
    first_seen_supported: bool = full and not shallow
    identity_rev: i64 = 0
    min_active: i64 = 6
    min_span: i64 = 6
    recent_required: bool = false
    presence: mutable darray[u8] = []
    n_months: mutable i64 = 0
    mlo: mutable i64 = 0
    if accepted > 0:
        min_at: i64 =
            while e < inst.count |min_at: i64 = inst[0], e: usize = 1, inst| -> min_at:
                t: i64 = inst[e]
                if t < min_at:
                    min_at <- t
                e <- e + 1
        lo_src: i64 = min_at if full else window_start
        mhi: mutable i64 = 0
        Temporal::rh_month_of_instant(lo_src, &mlo)
        Temporal::rh_month_of_instant(cutoff, &mhi)
        n_months <- mhi - mlo + 1
        if n_months < 0:
            n_months <- 0
        _ = Continuity::rh_presence_build(actor, month, kind, -1, n_actors, mlo, n_months, presence)
    persistent: i64 = Continuity::rh_persistent_count(presence, n_actors, n_months, min_active, min_span, recent_required)
    persistent_24: i64 = Continuity::rh_persistent_24_count(presence, n_actors, n_months)
    active3: i64 = Continuity::rh_active_threshold_count(presence, n_actors, n_months, 3)
    active6: i64 = Continuity::rh_active_threshold_count(presence, n_actors, n_months, 6)
    active9: i64 = Continuity::rh_active_threshold_count(presence, n_actors, n_months, 9)
    event_share_num: i64 = Continuity::rh_persistent_event_count(actor, presence, n_actors, n_months, min_active, min_span, recent_required)
    event_share_den: i64 = accepted
    tenure_days: i64 = Continuity::rh_median_tenure_days(actor, inst, n_actors)
    counts: mutable darray[u64] = []
    _ = Continuity::rh_actor_counts(actor, kind, -1, 0, actor.count.i64(), n_actors, counts)
    fifty: i64 = Continuity::rh_absence_factor_50(counts)
    eighty: i64 = Continuity::rh_concentration_80(counts)
    hhi_n: mutable u64 = 0
    hhi_d: mutable u64 = 0
    _ = Metrics::rh_hhi(counts, &hhi_n, &hhi_d)
    eff_n: mutable u64 = 0
    eff_d: mutable u64 = 0
    _ = Continuity::rh_effective_count(counts, &eff_n, &eff_d)
    top_n: mutable u64 = 0
    top_d: mutable u64 = 0
    _ = Continuity::rh_top1_share(counts, &top_n, &top_d)
    top3_n: mutable u64 = 0
    top3_d: mutable u64 = 0
    _ = Continuity::rh_topk_share(counts, 3, &top3_n, &top3_d)
    top5_n: mutable u64 = 0
    top5_d: mutable u64 = 0
    _ = Continuity::rh_topk_share(counts, 5, &top5_n, &top5_d)
    gini_n: mutable u64 = 0
    gini_d: mutable u64 = 0
    if not Metrics::rh_gini(counts, &gini_n, &gini_d):
        gini_n <- 0
        gini_d <- 0
    statuses: mutable darray[i64] = []
    ContinuityScan::rh_cs_retention(actor, inst, n_actors, cutoff, window_start, cutoff, 90, 120, first_seen_supported, statuses)
    retained: mutable i64 = 0
    eligible: mutable i64 = 0
    censored: mutable i64 = 0
    unobservable: mutable i64 = 0
    Continuity::rh_retention_tally(statuses, &retained, &eligible, &censored, &unobservable)
    statuses_365: mutable darray[i64] = []
    ContinuityScan::rh_cs_retention(actor, inst, n_actors, cutoff, window_start, cutoff, 365, 395, first_seen_supported, statuses_365)
    retained_365: mutable i64 = 0
    eligible_365: mutable i64 = 0
    censored_365: mutable i64 = 0
    unobservable_365: mutable i64 = 0
    Continuity::rh_retention_tally(statuses_365, &retained_365, &eligible_365, &censored_365, &unobservable_365)
    returning_after_gap: i64 = Continuity::rh_returning_after_gap(actor, inst, n_actors, 90)
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("cannot create output directory")
        return 4
    cj: mutable darray[u8] = []
    cm: mutable darray[u8] = []
    if not rh_out_path(out, "continuity.json", cj):
        rh_cli_err("cannot stage continuity path")
        return 4
    if not rh_out_path(out, "continuity-metrics.json", cm):
        rh_cli_err("cannot stage continuity-metrics path")
        return 4
    body: mutable darray[u8] = []
    basis: u8 = Continuity::rh_coverage_basis(full, shallow)
    Continuity::rh_continuity_write_json(body, mlo, n_months, min_active, min_span, recent_required, identity_rev, n_actors, persistent, hhi_n, hhi_d, eff_n, eff_d, fifty, eighty, retained, eligible, censored, unobservable, accepted, 0, 0, basis)
    body.push(10)
    cjp: cstr = (&cj[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(cjp, body):
        rh_cli_err("cannot write continuity.json")
        return 4
    mbody: mutable darray[u8] = []
    Continuity::rh_continuity_metrics_write(mbody, identity_rev, n_actors, persistent, persistent_24, active3, active6, active9, event_share_num, event_share_den, tenure_days, retained, eligible, censored, unobservable, retained_365, eligible_365, censored_365, unobservable_365, returning_after_gap, first_seen_supported, hhi_n, hhi_d, eff_n, eff_d, fifty, eighty, top_n, top_d, top3_n, top3_d, top5_n, top5_d, gini_n, gini_d)
    mbody.push(10)
    cmp: cstr = (&cm[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(cmp, mbody):
        rh_cli_err("cannot write continuity-metrics.json")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        Base::rh_push_text(done, "continuity: actors=")
        Base::rh_push_decimal_i64(done, n_actors)
        Base::rh_push_text(done, " events=")
        Base::rh_push_decimal_i64(done, accepted)
        Base::rh_push_text(done, " persistent=")
        Base::rh_push_decimal_i64(done, persistent)
        Base::rh_push_text(done, " retention=")
        Base::rh_push_decimal_i64(done, retained)
        Base::rh_push_text(done, "/")
        Base::rh_push_decimal_i64(done, eligible)
        Base::rh_push_text(done, " first_seen_supported=")
        done
    if first_seen_supported:
        Base::rh_push_text(done, "true")
    else:
        Base::rh_push_text(done, "false")
    done.push(10)
    Base::rh_write_stdout(done)
    0

# --- M04-08 succession execution path. ---
# Reads an `rh-succession-input/1` document (a per-actor complete-month
# presence matrix, an explicit declared predecessor/successor pair, and the
# complete-month count) and writes `rh-continuity-metrics/1` for
# `succession.handover_overlap_months`. An absent declared pair is
# `not_applicable` (not zero overlap), so an activity-derived primary change
# is never passed off as a declared handover (no motive attribution).
def rh_do_succession(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected succession argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        Base::rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if Base::rh_io_read(ipp, raw) < 0:
        rh_cli_err("succession: cannot read --input")
        return 4
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ:
        rh_cli_err("succession: not a valid rh-succession-input/1 document (fail closed)")
        return 4
    ss: mutable i64 = 0
    se: mutable i64 = 0
    sidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
    if sidx < 0 or not Json::rh_json_str_span(nodes, sidx, &ss, &se):
        rh_cli_err("succession: not a valid rh-succession-input/1 document (fail closed)")
        return 4
    input_v1: bool = Job::rh_job_lit_eq(texts, ss, se, "rh-succession-input/1")
    input_v2: bool = Job::rh_job_lit_eq(texts, ss, se, "rh-succession-input/2")
    input_v3: bool = Job::rh_job_lit_eq(texts, ss, se, "rh-succession-input/3")
    if not input_v1 and not input_v2 and not input_v3:
        rh_cli_err("succession: not a valid rh-succession-input/1 document (fail closed)")
        return 4
    handover_month: mutable i64 = -1
    follow_up_months: mutable i64 = -1
    if input_v2 or input_v3:
        okh: mutable i64 = 0
        handover_month <- Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "handover_month"), &okh)
        okf: mutable i64 = 0
        follow_up_months <- Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "follow_up_months"), &okf)
        if okh == 0 or okf == 0 or handover_month < 0 or follow_up_months <= 0 or follow_up_months > 120:
            rh_cli_err("succession: invalid handover month or follow-up window (fail closed)")
            return 4
    okm: mutable i64 = 0
    months: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "complete_months"), &okm)
    if okm == 0 or months < 0:
        rh_cli_err("succession: missing/invalid complete_months (fail closed)")
        return 4
    # Declared pair is optional; a missing pair is not_applicable, not an error.
    pred: mutable i64 = -1
    succ: mutable i64 = -1
    pidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "predecessor")
    if pidx >= 0:
        okp: mutable i64 = 0
        pv: i64 = Json::rh_json_int(nodes, raw, pidx, &okp)
        if okp == 0 or pv < -1:
            rh_cli_err("succession: invalid predecessor (fail closed)")
            return 4
        pred <- pv
    ridx2: i64 = Json::rh_json_obj_get(nodes, texts, root, "successor")
    if ridx2 >= 0:
        okr: mutable i64 = 0
        rv: i64 = Json::rh_json_int(nodes, raw, ridx2, &okr)
        if okr == 0 or rv < -1:
            rh_cli_err("succession: invalid successor (fail closed)")
            return 4
        succ <- rv
    midx: i64 = Json::rh_json_obj_get(nodes, texts, root, "presence")
    if midx < 0 or nodes[midx.usize()].kind != Json::RH_JSON_ARR:
        rh_cli_err("succession: missing presence matrix (fail closed)")
        return 4
    rows: mutable darray[u8] = []
    presence_rows: mutable i64 = 0
    while row >= 0 |row: i64 = nodes[midx.usize()].first_child, nodes, rows, presence_rows|:
        if nodes[row.usize()].kind != Json::RH_JSON_ARR:
            rh_cli_err("succession: presence row is not an array (fail closed)")
            return 4
        while col >= 0 |col: i64 = nodes[row.usize()].first_child, nodes, raw, months, rows|:
            if nodes[col.usize()].kind != Json::RH_JSON_BOOL:
                rh_cli_err("succession: presence cell is not a boolean (fail closed)")
                return 4
            if Json::rh_json_is_true(nodes, raw, col):
                rows.push(1)
            else:
                rows.push(0)
            col <- nodes[col.usize()].next_sibling
        if months > 0 and rows.count.i64() % months != 0:
            rh_cli_err("succession: presence matrix is not complete_months wide (fail closed)")
            return 4
        presence_rows <- presence_rows + 1
        row <- nodes[row.usize()].next_sibling
    if handover_month >= months:
        rh_cli_err("succession: handover_month must fall within complete history (fail closed)")
        return 4
    activity_counts: mutable darray[i64] = []
    activity_counts_present: bool = input_v3
    if input_v3:
        counts_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "activity_counts")
        if counts_idx < 0 or nodes[counts_idx.usize()].kind != Json::RH_JSON_ARR:
            rh_cli_err("succession: missing activity_counts matrix (fail closed)")
            return 4
        count_rows: mutable i64 = 0
        while count_row >= 0 |count_row: i64 = nodes[counts_idx.usize()].first_child, nodes, raw, months, activity_counts, count_rows|:
            if count_rows >= presence_rows:
                rh_cli_err("succession: activity counts contain an unmatched actor row (fail closed)")
                return 4
            if nodes[count_row.usize()].kind != Json::RH_JSON_ARR:
                rh_cli_err("succession: activity count row is not an array (fail closed)")
                return 4
            row_width: mutable i64 = 0
            while count_cell >= 0 |count_cell: i64 = nodes[count_row.usize()].first_child, nodes, raw, activity_counts, row_width|:
                ok_count: mutable i64 = 0
                count: i64 = Json::rh_json_int(nodes, raw, count_cell, &ok_count)
                if ok_count == 0 or count < 0:
                    rh_cli_err("succession: activity counts must be nonnegative integers (fail closed)")
                    return 4
                if (rows[activity_counts.count.usize()] == 1) != (count > 0):
                    rh_cli_err("succession: activity counts disagree with presence matrix (fail closed)")
                    return 4
                activity_counts.push(count)
                row_width <- row_width + 1
                count_cell <- nodes[count_cell.usize()].next_sibling
            if row_width != months:
                rh_cli_err("succession: activity count row width differs from complete_months (fail closed)")
                return 4
            count_rows <- count_rows + 1
            count_row <- nodes[count_row.usize()].next_sibling
        if months <= 0 or count_rows != presence_rows:
            rh_cli_err("succession: invalid complete history for activity counts (fail closed)")
            return 4
    body: mutable darray[u8] = []
    Continuity::rh_succession_metrics_write(body, rows, pred, succ, months, handover_month, follow_up_months, activity_counts, activity_counts_present)
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        Base::rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(opp, body):
        rh_cli_err("succession: cannot write --out")
        return 4
    rh_cli_out("succession: ok")
    0

# --- M05 downstream execution path. ---
# Reads an rh-dep-graph/1 document and writes an rh-downstream/1 report:
# direct + bounded transitive dependents under a labeled public projection,
# SCC count, optional simulated-unavailability scenario, explicit truncation
# (never a total), and private-node exclusion (S007/F030).
def rh_do_downstream(graph: cstr, subject: i64, out: cstr, snapshot_root: cstr, has_snapshot: bool, max_nodes: i64, max_depth: i64, unavailable: i64, has_unavailable: bool, private_ids: darray[i64]&, asserts: darray[Graph::RhAssertion]&, intr_path: cstr, has_intr: bool, mapping_path: cstr, has_mapping: bool, scope_filter: u8, platform_filter: i64, valid_as_of: i64, known_as_of: i64, schema_version: i64) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(graph) or not Git::rh_arg_safe(out):
        rh_cli_err("rejected downstream argument (allowlist)")
        return 3
    if has_intr:
        if not Git::rh_arg_safe(intr_path):
            rh_cli_err("rejected downstream argument (allowlist)")
            return 3
    if has_mapping and not Git::rh_arg_safe(mapping_path):
        rh_cli_err("rejected downstream mapping argument (allowlist)")
        return 3
    if has_snapshot:
        if not Git::rh_arg_safe(snapshot_root):
            rh_cli_err("rejected downstream snapshot argument (allowlist)")
            return 3
    gp: mutable darray[u8] =
        gp: mutable darray[u8] = []
        Base::rh_push_cstr(gp, graph)
        gp.push(0)
        gp
    gpp: cstr = (&gp[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if Base::rh_io_read(gpp, raw) < 0:
        rh_cli_err("downstream: cannot read graph file")
        return 4
    intr_raw: mutable darray[u8] = []
    if has_intr:
        ip: mutable darray[u8] =
            ip: mutable darray[u8] = []
            Base::rh_push_cstr(ip, intr_path)
            ip.push(0)
            ip
        ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
        if Base::rh_io_read(ipp, intr_raw) < 0:
            rh_cli_err("downstream: cannot read intrinsics file")
            return 4
    mapping_revision: mutable i64 = 0
    if has_mapping:
        mp: mutable darray[u8] =
            mp: mutable darray[u8] = []
            Base::rh_push_cstr(mp, mapping_path)
            mp.push(0)
            mp
        mpp: cstr = (&mp[0]).cast[cstr] can Unsafe.PointerCast
        mapping_raw: mutable darray[u8] = []
        if Base::rh_io_read(mpp, mapping_raw) < 0:
            rh_cli_err("downstream: cannot read mapping file")
            return 4
        mapping_records: mutable darray[RhMappingAssertion] = []
        if Mapping::rh_mapping_parse(mapping_raw, &mapping_revision, mapping_records) != 0:
            rh_cli_err("downstream: mapping is not a valid rh-mapping-input/1 document")
            return 4
        while mi < mapping_records.count |mi: usize = 0, mapping_records, asserts|:
            mr: RhMappingAssertion = mapping_records[mi]
            if mr.state == RH_MAPPING_STATE_ACCEPTED and (mr.relation == RH_MAPPING_REL_MIRROR or mr.relation == RH_MAPPING_REL_MIGRATION):
                asserts.push(Graph::RhAssertion{a: mr.a, b: mr.b, state: Graph::RH_ASSERT_ACCEPTED})
            mi <- mi + 1
        
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("downstream: cannot create output directory")
        return 4
    body: mutable darray[u8] = []
    snapshot_id: mutable darray[u8] = []
    empty_snapshot: mutable darray[u8] = []
    rc: mutable i64 = DownstreamReport::rh_downstream_report(raw, graph, subject, private_ids, asserts, mapping_revision, scope_filter, platform_filter, valid_as_of, known_as_of, schema_version, intr_raw, has_intr, max_nodes, max_depth, unavailable, has_unavailable, empty_snapshot, body)
    if rc == -1:
        rh_cli_err("downstream: graph is not a valid rh-dep-graph/1 document")
        return 4
    if rc == -2:
        rh_cli_err("downstream: subject id not present in graph")
        return 3
    if rc == -3:
        rh_cli_err("downstream: intrinsics is not a valid rh-intrinsics/1 document")
        return 4
    if has_snapshot:
        if Git::rh_ensure_dir(snapshot_root) != 0:
            rh_cli_err("downstream: cannot create snapshot root")
            return 4
        projection: Graph::RhProjection = Graph::rh_projection_make(1, scope_filter, platform_filter, valid_as_of, known_as_of, 0, mapping_revision, true, max_nodes, max_depth)
        if ProjectionStore::rh_projection_snapshot_store(snapshot_root, raw, private_ids, projection, snapshot_id) != 0:
            rh_cli_err("downstream: cannot persist projection snapshot")
            return 4
        body <- []
        rc <- DownstreamReport::rh_downstream_report(raw, graph, subject, private_ids, asserts, mapping_revision, scope_filter, platform_filter, valid_as_of, known_as_of, schema_version, intr_raw, has_intr, max_nodes, max_depth, unavailable, has_unavailable, snapshot_id, body)
        return 4 if rc != 0
    body.push(10)
    op: mutable darray[u8] = []
    if not rh_out_path(out, "downstream.json", op):
        rh_cli_err("downstream: bad output directory")
        return 3
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(opp, body):
        rh_cli_err("downstream: cannot write downstream.json")
        return 4
    rh_cli_out("downstream: ok")
    0

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_emit_i64_array(out: mutable darray[u8]&, values: darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
    out.push(91)
    while i < values.count |i: usize = 0, values, out|:
        if i > 0:
            out.push(44)
        Base::rh_push_decimal_i64(out, values[i])
        i <- i + 1
    out.push(93)

# --- M06 policy execution path. ---
# Parses an rh-policy/1 rule set and an rh-policy-input/1 observation file,
# aligns inputs to rules by id, evaluates the four-valued lattice, and
# writes rh-policy-result/1 bound to the policy/context/artifact/time
# digests. Unknown is never permission; warn never overrides deny; a rule
# with no input is unknown. Structured failure, never a default allow.
#
# With --state <file>, durable exception state (`rh-policy-state/1`) is
# loaded before evaluation and rewritten afterward: a rule-scoped exception
# supplied inline in the policy document takes precedence over the persisted
# row for the same (rule_id, subject_id, digest); an exception whose
# `expires_at` is at or before `now` is expired and never grants permission
# (the engine already enforces this). A missing state file is a fresh state.
def rh_do_policy_state(policy_path: cstr, input_path: cstr, out: cstr, state_path: cstr, has_state: bool, state_root: cstr, has_state_root: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(policy_path) or not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out):
        rh_cli_err("rejected policy argument (allowlist)")
        return 3
    if has_state and not Git::rh_arg_safe(state_path):
        rh_cli_err("rejected policy state argument (allowlist)")
        return 3
    if has_state and has_state_root:
        rh_cli_err("policy: --state and --state-store are mutually exclusive")
        return 2
    if has_state_root and not Git::rh_arg_safe(state_root):
        rh_cli_err("rejected policy state-store argument (allowlist)")
        return 3
    ppath: mutable darray[u8] =
        ppath: mutable darray[u8] = []
        Base::rh_push_cstr(ppath, policy_path)
        ppath.push(0)
        ppath
    praw: mutable darray[u8] = []
    prawwp: cstr = (&ppath[0]).cast[cstr] can Unsafe.PointerCast
    if Base::rh_io_read(prawwp, praw) < 0:
        rh_cli_err("policy: cannot read --policy file")
        return 4
    rules: mutable darray[Policy::RhRule] = []
    excs: mutable darray[Policy::RhException] = []
    if PolicyParse::rh_policy_parse(praw, rules, excs) != 0:
        rh_cli_err("policy: not a valid rh-policy/1 document (fail closed)")
        return 4
    spath: mutable darray[u8] = []
    spp: mutable cstr = prawwp
    prior: mutable darray[Policy::RhException] = []
    if has_state:
        Base::rh_push_cstr(spath, state_path)
        spath.push(0)
        spp <- (&spath[0]).cast[cstr] can Unsafe.PointerCast
        sraw: mutable darray[u8] = []
        if file_exists(spp):
            if Base::rh_io_read(spp, sraw) < 0:
                rh_cli_err("policy: cannot read --state file")
                return 4
        if PolicyParse::rh_policy_state_parse(sraw, prior) != 0:
            rh_cli_err("policy: not a valid rh-policy-state/1 document (fail closed)")
            return 4
    elif has_state_root:
        if Git::rh_ensure_dir(state_root) != 0:
            rh_cli_err("policy: cannot create --state-store")
            return 4
        sraw: mutable darray[u8] = []
        loaded: i64 = StateStore::rh_state_store_load(state_root, sraw)
        if loaded < 0:
            rh_cli_err("policy: corrupt --state-store (fail closed)")
            return 4
        if PolicyParse::rh_policy_state_parse(sraw, prior) != 0:
            rh_cli_err("policy: not a valid rh-policy-state/1 document (fail closed)")
            return 4
    # Persisted rows supplement inline exceptions: a row whose
    # (rule_id, subject_id, digest) is already declared inline is dropped so
    # inline (current) intent wins over stale state.
    while ri < prior.count |ri: usize = 0, prior, excs|:
        p: Policy::RhException = prior[ri]
        dup: bool =
            while xi < excs.count |dup: bool = false, xi: usize = 0, excs| -> dup:
                e: Policy::RhException = excs[xi]
                if e.rule_id == p.rule_id and e.subject_id == p.subject_id and e.digest_high == p.digest_high and e.digest_low == p.digest_low:
                    dup <- true
                xi <- xi + 1
        if not dup:
            excs.push(p)
        ri <- ri + 1
    ipath: mutable darray[u8] =
        ipath: mutable darray[u8] = []
        Base::rh_push_cstr(ipath, input_path)
        ipath.push(0)
        ipath
    iraw: mutable darray[u8] = []
    irawp: cstr = (&ipath[0]).cast[cstr] can Unsafe.PointerCast
    if Base::rh_io_read(irawp, iraw) < 0:
        rh_cli_err("policy: cannot read --input file")
        return 4
    in_ids: mutable darray[i64] = []
    inputs: mutable darray[Policy::RhPolicyInput] = []
    subject: mutable i64 = 0
    artifact: mutable u64 = 0
    context: mutable u64 = 0
    now: mutable i64 = 0
    if PolicyParse::rh_policy_input_parse(iraw, in_ids, inputs, &subject, &artifact, &context, &now) != 0:
        rh_cli_err("policy: not a valid rh-policy-input/1 document (fail closed)")
        return 4
    aligned: mutable darray[Policy::RhPolicyInput] = []
    missing: mutable darray[i64] = []
    PolicyParse::rh_policy_align(rules, in_ids, inputs, aligned, missing)
    digest: u64 = Policy::rh_policy_digest(rules, context, subject, artifact, now)
    fired: mutable darray[i64] = []
    excepted: mutable darray[i64] = []
    decision: u8 = Policy::rh_policy_eval(rules, aligned, excs, subject, digest, 0, now, fired, excepted)
    exception_expiry_days: i64 = Policy::rh_exception_expiry_days(excs, excepted, subject, digest, 0, now)
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("policy: cannot create output directory")
        return 4
    body: mutable darray[u8] =
        body: mutable darray[u8] = []
        Base::rh_push_text(body, "{\"schema\":\"rh-policy-result/1\",\"subject_id\":")
        Base::rh_push_decimal_i64(body, subject)
        Base::rh_push_text(body, ",\"binding\":{\"policy_digest\":\"")
        Base::rh_push_hex_u64(body, digest)
        Base::rh_push_text(body, "\",\"context_digest\":\"")
        Base::rh_push_hex_u64(body, context)
        Base::rh_push_text(body, "\",\"artifact_digest\":\"")
        Base::rh_push_hex_u64(body, artifact)
        Base::rh_push_text(body, "\",\"now\":")
        Base::rh_push_decimal_i64(body, now)
        Base::rh_push_text(body, "},\"decision\":\"")
        Base::rh_push_text(body, Policy::rh_decision_label(decision))
        Base::rh_push_text(body, "\",\"fired_rule_ids\":")
        body
    rh_emit_i64_array(body, fired)
    Base::rh_push_text(body, ",\"excepted_rule_ids\":")
    rh_emit_i64_array(body, excepted)
    Base::rh_push_text(body, ",\"missing_input_rule_ids\":")
    rh_emit_i64_array(body, missing)
    Base::rh_push_text(body, ",\"explanation\":")
    Policy::rh_policy_explain(body, rules, decision, fired, excepted)
    Base::rh_push_text(body, ",\"metrics\":[{\"key\":\"policy.evaluations\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":1,\"evidence\":[\"policy-result\"]},{\"key\":\"policy.allow_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
    Base::rh_push_decimal_i64(body, 1 if decision == Policy::RH_DEC_ALLOW else 0)
    Base::rh_push_text(body, ",\"evidence\":[\"policy-result\"]},{\"key\":\"policy.warn_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
    Base::rh_push_decimal_i64(body, 1 if decision == Policy::RH_DEC_WARN else 0)
    Base::rh_push_text(body, ",\"evidence\":[\"policy-result\"]},{\"key\":\"policy.deny_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
    Base::rh_push_decimal_i64(body, 1 if decision == Policy::RH_DEC_DENY else 0)
    Base::rh_push_text(body, ",\"evidence\":[\"policy-result\"]},{\"key\":\"policy.unknown_count\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
    Base::rh_push_decimal_i64(body, 1 if decision == Policy::RH_DEC_UNKNOWN else 0)
    Base::rh_push_text(body, ",\"evidence\":[\"policy-result\"]},{\"key\":\"policy.active_exceptions\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":")
    Base::rh_push_decimal_i64(body, excepted.count.i64())
    Base::rh_push_text(body, ",\"evidence\":[\"policy-result\"]},{\"key\":\"policy.exception_expiry_days\",\"version\":\"1.0.0\",\"status\":\"")
    if exception_expiry_days < 0:
        Base::rh_push_text(body, "not_applicable\",\"reason\":\"no-active-exception\"")
    else:
        Base::rh_push_text(body, "observed\",\"value\":")
        Base::rh_push_decimal_i64(body, exception_expiry_days)
    Base::rh_push_text(body, ",\"evidence\":[\"policy-result\"]}],\"note\":\"unknown is never permission; warn never overrides deny; this decision is bound to the digests above (TOCTOU)\"}")
    body.push(10)
    op: mutable darray[u8] = []
    if not rh_out_path(out, "policy-result.json", op):
        rh_cli_err("policy: bad output directory")
        return 3
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(opp, body):
        rh_cli_err("policy: cannot write policy-result.json")
        return 4
    if has_state:
        sb: mutable darray[u8] = []
        PolicyParse::rh_policy_state_emit(excs, sb)
        sb.push(10)
        if not Base::rh_io_write(spp, sb):
            rh_cli_err("policy: cannot write --state file")
            return 4
    elif has_state_root:
        sb2: mutable darray[u8] = []
        sid: mutable darray[u8] = []
        PolicyParse::rh_policy_state_emit(excs, sb2)
        sb2.push(10)
        if StateStore::rh_state_store_publish(state_root, sb2, sid) != 0:
            rh_cli_err("policy: cannot publish --state-store")
            return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        Base::rh_push_text(done, "policy: decision=")
        Base::rh_push_text(done, Policy::rh_decision_label(decision))
        Base::rh_push_text(done, " fired=")
        Base::rh_push_decimal_i64(done, fired.count.i64())
        Base::rh_push_text(done, " excepted=")
        Base::rh_push_decimal_i64(done, excepted.count.i64())
        Base::rh_push_text(done, " missing_inputs=")
        Base::rh_push_decimal_i64(done, missing.count.i64())
        done.push(10)
        done
    Base::rh_write_stdout(done)
    0

# --- M06 correction execution path. ---
# Reads an rh-corrections/1 document, applies corrections in order, and
# writes rh-corrections-result/1 and rh-correction-notices/1. Accepted
# corrections advance the revision and supersede only that subject's older
# derived results; raw replay inputs are never rewritten. Malformed/unknown
# kind/state/combine fails closed.
#
# With --state <file>, an `rh-corrections-state/1` document carries the
# revision floor, the greatest target_id already folded in (watermark), and
# the subjects superseded so far; it is loaded before the run and rewritten
# after. Replaying the same corrections file is therefore idempotent (no
# second advance, no re-supersede), matching S005. A corrupt or wrong-schema
# state file fails closed (exit 4), never defaults to permission.
def rh_correct_verify_evidence(raw: darray[u8]&, evidence_root: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
    corrections_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "corrections")
    return -1 if corrections_idx < 0 or nodes[corrections_idx.usize()].kind != Json::RH_JSON_ARR
    arr: Json::RhJsonNode = nodes[corrections_idx.usize()]
    while item >= 0 |item: i64 = arr.first_child, nodes, texts, evidence_root|:
        ref_idx: i64 = Json::rh_json_obj_get(nodes, texts, item, "evidence_ref")
        ref_s: mutable i64 = 0
        ref_e: mutable i64 = 0
        return -1 if ref_idx < 0 or not Json::rh_json_str_span(nodes, ref_idx, &ref_s, &ref_e) or ref_e - ref_s != 16
        name: mutable darray[u8] = []
        while byte_idx < 16 |byte_idx: i64 = 0, ref_s, ref_e, texts, name|:
            digit: u8 = texts[(ref_s + byte_idx).usize()]
            valid: bool = (digit >= 48 and digit <= 57) or (digit >= 97 and digit <= 102)
            return -1 if not valid
            name.push(digit)
            byte_idx <- byte_idx + 1
        name.push(0)
        ok: mutable i64 = 0
        ref_name: u8& = (&name[0]).cast[u8&] can Unsafe.PointerCast
        return -1 if Store::rh_store_blob_verify(evidence_root, ref_name, &ok) != 0 or ok != 1
        item <- nodes[item.usize()].next_sibling
    0

def rh_correct_notice_document(result: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(result, nodes, texts)
    return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
    notices_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "notices")
    revision_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "final_revision")
    return -1 if notices_idx < 0 or nodes[notices_idx.usize()].kind != Json::RH_JSON_ARR or revision_idx < 0
    revision_ok: mutable i64 = 0
    revision: i64 = Json::rh_json_int(nodes, result, revision_idx, &revision_ok)
    return -1 if revision_ok == 0 or revision < 0
    start: i64 = nodes[notices_idx.usize()].text_start
    finish: i64 = nodes[notices_idx.usize()].text_end
    return -1 if start < 0 or finish < start or finish > result.count.i64()
    Base::rh_push_text(out, "{\"schema\":\"rh-correction-notices/1\",\"revision\":")
    Base::rh_push_decimal_i64(out, revision)
    Base::rh_push_text(out, ",\"notices\":")
    while i < finish |i: i64 = start, result, out|:
        out.push(result[i.usize()])
        i <- i + 1
    Base::rh_push_text(out, "}")
    0

def rh_do_correct_state(corrections_path: cstr, out: cstr, state_path: cstr, has_state: bool, state_root: cstr, has_state_root: bool, evidence_root: cstr, has_evidence_root: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(corrections_path) or not Git::rh_arg_safe(out):
        rh_cli_err("rejected correct argument (allowlist)")
        return 3
    if has_state and not Git::rh_arg_safe(state_path):
        rh_cli_err("rejected correct state argument (allowlist)")
        return 3
    if has_state and has_state_root:
        rh_cli_err("correct: --state and --state-store are mutually exclusive")
        return 2
    if has_state_root and not Git::rh_arg_safe(state_root):
        rh_cli_err("rejected correct state-store argument (allowlist)")
        return 3
    if has_evidence_root and not Git::rh_arg_safe(evidence_root):
        rh_cli_err("rejected correct evidence-store argument (allowlist)")
        return 3
    cp: mutable darray[u8] =
        cp: mutable darray[u8] = []
        Base::rh_push_cstr(cp, corrections_path)
        cp.push(0)
        cp
    cpp: cstr = (&cp[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if Base::rh_io_read(cpp, raw) < 0:
        rh_cli_err("correct: cannot read --corrections file")
        return 4
    if has_evidence_root and rh_correct_verify_evidence(raw, evidence_root) != 0:
        rh_cli_err("correct: evidence reference is malformed, missing, or corrupt")
        return 4
    spath: mutable darray[u8] = []
    spp: mutable cstr = cpp
    p_rev: mutable i64 = 0
    p_wm: mutable i64 = 0
    prior_sup: mutable darray[i64] = []
    if has_state:
        Base::rh_push_cstr(spath, state_path)
        spath.push(0)
        spp <- (&spath[0]).cast[cstr] can Unsafe.PointerCast
        sraw: mutable darray[u8] = []
        if file_exists(spp):
            if Base::rh_io_read(spp, sraw) < 0:
                rh_cli_err("correct: cannot read --state file")
                return 4
        if CorrectionReport::rh_correction_state_parse(sraw, &p_rev, &p_wm, prior_sup) != 0:
            rh_cli_err("correct: not a valid rh-corrections-state/1 document (fail closed)")
            return 4
    elif has_state_root:
        if Git::rh_ensure_dir(state_root) != 0:
            rh_cli_err("correct: cannot create --state-store")
            return 4
        sraw: mutable darray[u8] = []
        loaded: i64 = StateStore::rh_state_store_load(state_root, sraw)
        if loaded < 0:
            rh_cli_err("correct: corrupt --state-store (fail closed)")
            return 4
        if CorrectionReport::rh_correction_state_parse(sraw, &p_rev, &p_wm, prior_sup) != 0:
            rh_cli_err("correct: not a valid rh-corrections-state/1 document (fail closed)")
            return 4
    body: mutable darray[u8] = []
    new_sup: mutable darray[i64] = []
    final_rev: mutable i64 = 0
    final_wm: mutable i64 = 0
    if CorrectionReport::rh_correction_report_state(raw, p_rev, p_wm, new_sup, &final_rev, &final_wm, body) != 0:
        rh_cli_err("correct: not a valid rh-corrections/1 document (fail closed)")
        return 4
    body.push(10)
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("correct: cannot create output directory")
        return 4
    op: mutable darray[u8] = []
    if not rh_out_path(out, "corrections-result.json", op):
        rh_cli_err("correct: bad output directory")
        return 3
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(opp, body):
        rh_cli_err("correct: cannot write corrections-result.json")
        return 4
    notices: mutable darray[u8] = []
    if rh_correct_notice_document(body, notices) != 0:
        rh_cli_err("correct: cannot construct correction notice document")
        return 4
    notices.push(10)
    notice_path: mutable darray[u8] = []
    return 3 if not rh_out_path(out, "corrections-notices.json", notice_path)
    notice_ptr: cstr = (&notice_path[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(notice_ptr, notices):
        rh_cli_err("correct: cannot write corrections-notices.json")
        return 4
    if has_state or has_state_root:
        merged: mutable darray[i64] = []
        while mi < prior_sup.count |mi: usize = 0, prior_sup, merged|:
            merged.push(prior_sup[mi])
            mi <- mi + 1
        while ni < new_sup.count |ni: usize = 0, new_sup, merged|:
            v: i64 = new_sup[ni]
            present: bool =
                while mj < merged.count |present: bool = false, mj: usize = 0, merged| -> present:
                    if merged[mj] == v:
                        present <- true
                    mj <- mj + 1
            if not present:
                merged.push(v)
            ni <- ni + 1
        sb: mutable darray[u8] = []
        CorrectionReport::rh_correction_state_emit(final_rev, final_wm, merged, sb)
        sb.push(10)
        if has_state:
            if not Base::rh_io_write(spp, sb):
                rh_cli_err("correct: cannot write --state file")
                return 4
        else:
            sid: mutable darray[u8] = []
            if StateStore::rh_state_store_publish(state_root, sb, sid) != 0:
                rh_cli_err("correct: cannot publish --state-store")
                return 4
    rh_cli_out("correct: ok")
    0

# --- M02 store + M07 ops execution paths. ---
# Content-addressed evidence store: put is idempotent for identical bytes
# and refuses to overwrite a different blob under the same digest; verify
# recomputes the digest and fails closed on missing/corrupt evidence.
def rh_do_store_put(root: cstr, file: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(file):
        rh_cli_err("rejected store argument (allowlist)")
        return 3
    buf: mutable darray[u8] = []
    if Base::rh_io_read(file, buf) < 0:
        rh_cli_err("store: cannot read --file")
        return 4
    if Git::rh_ensure_dir(root) != 0:
        rh_cli_err("store: cannot create root")
        return 4
    hex: mutable darray[u8] = []
    if Store::rh_store_blob(root, buf, hex) != 0:
        rh_cli_err("store: refusing to overwrite a different blob under the same digest")
        return 4
    done: mutable darray[u8] = []
    Base::rh_push_text(done, "store: put ")
    _ = Base::rh_absorb_bytes(hex, done)
    Base::rh_push_text(done, " bytes=")
    Base::rh_push_decimal_i64(done, buf.count.i64())
    done.push(10)
    Base::rh_write_stdout(done)
    0

def rh_do_store_verify(root: cstr, name: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(name):
        rh_cli_err("rejected store argument (allowlist)")
        return 3
    ok: mutable i64 = 0
    if Store::rh_store_blob_verify(root, name, &ok) != 0 or ok != 1:
        rh_cli_err("store: verification FAILED (missing or corrupt evidence blocks publication)")
        return 5
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        Base::rh_push_text(done, "store: verified ")
        Base::rh_push_cstr(done, name)
        done.push(10)
        done
    Base::rh_write_stdout(done)
    0

# Backup manifest from a names file (one blob hex name per line).
def rh_do_ops_backup(root: cstr, manifest: cstr, names_file: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(manifest) or not Git::rh_arg_safe(names_file):
        rh_cli_err("rejected ops argument (allowlist)")
        return 3
    names: mutable darray[u8] = []
    if Base::rh_io_read(names_file, names) < 0:
        rh_cli_err("ops: cannot read --names")
        return 4
    if not Ops::rh_backup_write(manifest, names):
        rh_cli_err("ops: cannot write backup manifest")
        return 4
    rh_cli_out("ops: backup manifest written")
    0

# Export verified evidence into a portable file that operators can copy through
# their existing authenticated transport between hosts.
def rh_do_ops_export(root: cstr, manifest: cstr, bundle: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(manifest) or not Git::rh_arg_safe(bundle):
        rh_cli_err("rejected ops argument (allowlist)")
        return 3
    if not Ops::rh_transfer_export(root, manifest, bundle):
        rh_cli_err("ops: cannot create verified evidence package (fail closed)")
        return 4
    rh_cli_out("ops export: package written")
    0

# Import validates every framed object before publishing any of them. If the
# filesystem fails during publication, rerunning the same package is safe.
def rh_do_ops_import(dest: cstr, bundle: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(dest) or not Git::rh_arg_safe(bundle):
        rh_cli_err("rejected ops argument (allowlist)")
        return 3
    if Git::rh_ensure_dir(dest) != 0:
        rh_cli_err("ops: cannot create import destination")
        return 4
    imported: mutable i64 = 0
    if Ops::rh_transfer_import(dest, bundle, &imported) != 0:
        rh_cli_err("ops: cannot import evidence package (fail closed)")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        Base::rh_push_text(done, "ops import: imported=")
        Base::rh_push_decimal_i64(done, imported)
        done.push(10)
        done
    Base::rh_write_stdout(done)
    0

# Verify every object named in a manifest: present+digest-verified vs
# missing vs corrupt. Any missing/corrupt is exit 5 (not a clean restore).
def rh_do_ops_verify(root: cstr, manifest: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(manifest):
        rh_cli_err("rejected ops argument (allowlist)")
        return 3
    p: mutable i64 = 0
    m: mutable i64 = 0
    c: mutable i64 = 0
    if Ops::rh_backup_verify(root, manifest, &p, &m, &c) != 0:
        rh_cli_err("ops: cannot read backup manifest (fail closed)")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        Base::rh_push_text(done, "ops verify: verified=")
        Base::rh_push_decimal_i64(done, p)
        Base::rh_push_text(done, " missing=")
        Base::rh_push_decimal_i64(done, m)
        Base::rh_push_text(done, " corrupt=")
        Base::rh_push_decimal_i64(done, c)
        done.push(10)
        done
    Base::rh_write_stdout(done)
    return 5 if m > 0 or c > 0
    0

# Restore only digest-verified objects; an unverified name is skipped and
# never silently becomes live evidence.
def rh_do_ops_restore(root: cstr, dest: cstr, manifest: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(dest) or not Git::rh_arg_safe(manifest):
        rh_cli_err("rejected ops argument (allowlist)")
        return 3
    if Git::rh_ensure_dir(dest) != 0:
        rh_cli_err("ops: cannot create restore destination")
        return 4
    r: mutable i64 = 0
    if Ops::rh_backup_restore(root, dest, manifest, &r) != 0:
        rh_cli_err("ops: cannot read backup manifest (fail closed)")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        Base::rh_push_text(done, "ops restore: restored=")
        Base::rh_push_decimal_i64(done, r)
        done.push(10)
        done
    Base::rh_write_stdout(done)
    0

# --- M02 forge normalization execution path. ---
# Normalizes a captured forge payload into the canonical-repo/1 form with a
# real connector id and a caller-supplied (or current) collection time.
# Only connectors with an implemented normalizer are accepted; an unknown
# connector is rejected, never guessed. Malformed payloads fail closed.
def rh_do_forge_normalize(conn: cstr, input_path: cstr, out_path: cstr, fetched_at: i64, has_fetched: bool, source_url: cstr, has_url: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(conn) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected forge argument (allowlist)")
        return 3
    raw: mutable darray[u8] = []
    if has_url:
        return 3 if not Git::rh_fetch_arg_safe(source_url)
        source_path: mutable darray[u8] =
            source_path: mutable darray[u8] = []
            Base::rh_push_cstr(source_path, out_path)
            Base::rh_push_text(source_path, ".source")
            source_path.push(0)
            source_path
        status_path: mutable darray[u8] =
            status_path: mutable darray[u8] = []
            Base::rh_push_cstr(status_path, out_path)
            Base::rh_push_text(status_path, ".source.status")
            status_path.push(0)
            status_path
        error_path: mutable darray[u8] =
            error_path: mutable darray[u8] = []
            Base::rh_push_cstr(error_path, out_path)
            Base::rh_push_text(error_path, ".source.err")
            error_path.push(0)
            error_path
        source_ptr: cstr = (&source_path[0]).cast[cstr] can Unsafe.PointerCast
        status_ptr: cstr = (&status_path[0]).cast[cstr] can Unsafe.PointerCast
        error_ptr: cstr = (&error_path[0]).cast[cstr] can Unsafe.PointerCast
        fetch_status: i64 = Git::rh_run_github_api_get(source_url, source_ptr, status_ptr, error_ptr) if Base::rh_streq(conn, "github") else Git::rh_run_https_get(source_url, source_ptr, status_ptr, error_ptr)
        if fetch_status != 0:
            rh_cli_err("forge: fetch failed; source and stderr evidence retained")
            return 4
        status_raw: mutable darray[u8] = []
        if Base::rh_io_read(status_ptr, status_raw) < 0 or status_raw.count == 0:
            rh_cli_err("forge: fetch did not produce a status")
            return 4
        ok_status: bool = status_raw[0] == 50
        file_transport: bool = status_raw.count >= 3 and status_raw[0] == 48 and status_raw[1] == 48 and status_raw[2] == 48 and Base::rh_cstr_starts_with(source_url, "file://")
        if not ok_status and not file_transport:
            rh_cli_err("forge: fetch returned non-2xx; no result published")
            return 4
        if Base::rh_io_read(source_ptr, raw) < 0:
            rh_cli_err("forge: cannot read fetched source evidence")
            return 4
    else:
        return 3 if not Git::rh_arg_safe(input_path)
        ip: mutable darray[u8] =
            ip: mutable darray[u8] = []
            Base::rh_push_cstr(ip, input_path)
            ip.push(0)
            ip
        ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
        if Base::rh_io_read(ipp, raw) < 0:
            rh_cli_err("forge: cannot read --input")
            return 4
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    if root < 0:
        rh_cli_err("forge: --input is not valid JSON")
        return 4
    ts: mutable i64 = fetched_at
    if not has_fetched:
        ts <- Base::rh_now()
        if ts < 0:
            rh_cli_err("forge: no clock; pass --fetched-at")
            return 4
    produced: mutable darray[u8] = []
    ok: mutable bool = false
    if Base::rh_streq(conn, "github"):
        ok <- Forge::rh_github_repo_canonical(nodes, texts, raw, root, ts, produced)
    elif Base::rh_streq(conn, "gitlab"):
        ok <- Forge::rh_gitlab_project_canonical(nodes, texts, raw, root, ts, produced)
    elif Base::rh_streq(conn, "gitea"):
        ok <- Forge::rh_gitea_repo_canonical(nodes, texts, raw, root, ts, "gitea", produced)
    elif Base::rh_streq(conn, "forgejo"):
        ok <- Forge::rh_gitea_repo_canonical(nodes, texts, raw, root, ts, "forgejo", produced)
    elif Base::rh_streq(conn, "bitbucket"):
        ok <- Forge::rh_bitbucket_repo_canonical(nodes, texts, raw, root, ts, produced)
    else:
        rh_cli_err("forge: unsupported connector (implemented normalizers: github, gitlab, gitea, forgejo, bitbucket)")
        return 3
    if not ok:
        rh_cli_err("forge: input does not match the connector payload shape (fail closed)")
        return 4
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        Base::rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(opp, produced):
        rh_cli_err("forge: cannot write --out")
        return 4
    transformations: mutable darray[u8] = []
    transformation_config: mutable darray[u8] = []
    Base::rh_push_text(transformation_config, "repo-health/forge-repo-normalizer/1:")
    Base::rh_push_cstr(transformation_config, conn)
    configuration_sha: mutable darray[u8] = []
    source_sha: mutable darray[u8] = []
    normalized_sha: mutable darray[u8] = []
    Sha256::rh_sha256(transformation_config, configuration_sha)
    Sha256::rh_sha256(raw, source_sha)
    Sha256::rh_sha256(produced, normalized_sha)
    ForgeTransformation::rh_forge_transformation_report(conn, configuration_sha, source_sha, normalized_sha, transformations)
    transformations.push(10)
    transformation_path: mutable darray[u8] = []
    Base::rh_push_cstr(transformation_path, out_path)
    Base::rh_push_text(transformation_path, ".transformations.json")
    transformation_path.push(0)
    transformation_ptr: cstr = (&transformation_path[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(transformation_ptr, transformations):
        rh_cli_err("forge: cannot write transformation report")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        Base::rh_push_text(done, "forge: normalized ")
        Base::rh_push_cstr(done, conn)
        done.push(10)
        done
    Base::rh_write_stdout(done)
    0

# --- M02-05 bounded workflow-event import path. ---
# Provider-native captured arrays are normalized through rh-forge-events/1;
# this path does not perform live authentication or pagination.
def rh_do_forge_events(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected forge events argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        Base::rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if Base::rh_io_read(ipp, raw) < 0:
        rh_cli_err("forge events: cannot read --input")
        return 4
    body: mutable darray[u8] = []
    if ForgeEvents::rh_forge_events_report(raw, body) != 0:
        rh_cli_err("forge events: unsupported or malformed captured payload (fail closed)")
        return 4
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        Base::rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(opp, body):
        rh_cli_err("forge events: cannot write --out")
        return 4
    rh_cli_out("forge events: ok")
    0

# Replay committed PostgreSQL forge stage rows through the provider-native
# normalizer, preserving an exact input digest and row cursors.
def rh_do_staged_forge_normalize(input_path: cstr, out_path: cstr, commit_to_postgres: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected staged normalization argument (allowlist)")
        return 3
    raw: mutable darray[u8] = []
    if Base::rh_io_read(input_path, raw) < 0:
        rh_cli_err("staged normalize: cannot read --input")
        return 4
    body: mutable darray[u8] = []
    if StagedForge::rh_staged_forge_report(raw, body) != 0:
        rh_cli_err("staged normalize: unsupported or malformed committed forge stage (fail closed)")
        return 4
    if commit_to_postgres:
        database_url: u8&? = getenv("RH_DATABASE_URL")
        if database_url == null:
            rh_cli_err("staged normalize: RH_DATABASE_URL is required for --postgres")
            return 4
        command: mutable darray[u8] = []
        Base::rh_push_text(command, "{\"schema\":\"rh-postgres-command/1\",\"operation\":\"commit_staged_normalization\",\"normalization\":")
        command.extend(bytes_view(body))
        command.push(125)
        conninfo: cstr = database_url.cast[cstr] can Unsafe.PointerCast
        result: mutable darray[u8] = []
        if PostgresReport::rh_postgres_command(command, conninfo, "", result) != 0:
            rh_cli_err("staged normalize: PostgreSQL rejected canonical write-back")
            return 4
        result.push(10)
        if not Base::rh_io_write(out_path, result):
            rh_cli_err("staged normalize: cannot write PostgreSQL result")
            return 4
        rh_cli_out("staged normalize: forge events normalized and committed to PostgreSQL")
    else:
        body.push(10)
        if not Base::rh_io_write(out_path, body):
            rh_cli_err("staged normalize: cannot write --out")
            return 4
        rh_cli_out("staged normalize: forge events normalized")
    0

def rh_do_forge_events_github(repository: cstr, out_path: cstr, max_pages: i64) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected forge events output path (allowlist)")
        return 3
    body: mutable darray[u8] = []
    if ForgeEventsFetch::rh_forge_events_github_live(repository, max_pages, out_path, body) != 0:
        rh_cli_err("forge events: GitHub event collection failed (see page evidence)")
        return 4
    body.push(10)
    if not Base::rh_io_write(out_path, body):
        rh_cli_err("forge events: cannot write --out")
        return 4
    rh_cli_out("forge events: GitHub issues, proposals, and releases collected")
    0

def rh_do_forge_events_github_reviews(repository: cstr, pull_request: i64, start_page: i64, out_path: cstr, max_pages: i64) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
