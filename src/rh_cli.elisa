# --- R013 declared-roles execution path. ---
# Reads an rh-roles-input/1 document and writes rh-roles-result/1. Declared
# roles are time-scoped evidence, separate from observed actions; unknown
# role strings stay unknown; revoked/not-yet-effective is inactive. URL input
# retains bounded transport evidence beside the result and never sends auth.
def rh_do_roles(input_path: cstr, out_path: cstr, source_url: cstr, has_url: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected roles argument (allowlist)")
        return 3
    raw: mutable darray[u8] = []
    if has_url:
        return 3 if not Git::rh_fetch_arg_safe(source_url)
        fetch_dir: mutable darray[u8] = []
        if not rh_dirname(out_path, fetch_dir):
            rh_push_text(fetch_dir, ".")
        fetch_dir.push(0)
        fetch_dir_ptr: cstr = (&fetch_dir[0]).cast[cstr] can Unsafe.PointerCast
        body_path: mutable darray[u8] = []
        code_path: mutable darray[u8] = []
        err_path: mutable darray[u8] = []
        if not rh_out_path(fetch_dir_ptr, "roles-fetch-body.json", body_path) or not rh_out_path(fetch_dir_ptr, "roles-fetch-status.txt", code_path) or not rh_out_path(fetch_dir_ptr, "roles-fetch.err", err_path):
            rh_cli_err("roles: cannot stage fetch evidence")
            return 4
        body_path.push(0)
        code_path.push(0)
        err_path.push(0)
        body_ptr: cstr = (&body_path[0]).cast[cstr] can Unsafe.PointerCast
        code_ptr: cstr = (&code_path[0]).cast[cstr] can Unsafe.PointerCast
        err_ptr: cstr = (&err_path[0]).cast[cstr] can Unsafe.PointerCast
        if Git::rh_run_https_get(source_url, body_ptr, code_ptr, err_ptr) != 0:
            rh_cli_err("roles: fetch failed; no result published")
            return 4
        code_raw: mutable darray[u8] = []
        if rh_io_read(code_ptr, code_raw) < 0 or code_raw.count == 0:
            rh_cli_err("roles: fetch did not produce a status")
            return 4
        ok_status: bool = code_raw[0] == 50
        file_transport: bool = code_raw.count >= 3 and code_raw[0] == 48 and code_raw[1] == 48 and code_raw[2] == 48 and rh_cstr_starts_with(source_url, "file://")
        if not ok_status and not file_transport:
            rh_cli_err("roles: fetch returned non-2xx; no result published")
            return 4
        url_data: mutable darray[u8] = []
        rh_push_cstr(url_data, source_url)
        status: mutable darray[u8] = []
        rh_push_text(status, "{\"schema\":\"rh-roles-fetch/1\",\"source_url\":\"")
        rh_json_escape(status, url_data, 0, url_data.count)
        rh_push_text(status, "\",\"status\":\"")
        code_data: u8& = (&code_raw[0]).cast[u8&] can Unsafe.PointerCast
        rh_push_raw(status, code_data, code_raw.count)
        rh_push_text(status, "\",\"body_file\":\"roles-fetch-body.json\",\"state\":\"collected\",\"note\":\"bounded permission-document capture retained before role parsing\"}\n")
        if not rh_io_write(code_ptr, status):
            rh_cli_err("roles: cannot write fetch status")
            return 4
        if rh_io_read(body_ptr, raw) < 0:
            rh_cli_err("roles: cannot read fetched body")
            return 4
    else:
        return 3 if not Git::rh_arg_safe(input_path)
        ip: mutable darray[u8] =
            ip: mutable darray[u8] = []
            rh_push_cstr(ip, input_path)
            ip.push(0)
            ip
        ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
        if rh_io_read(ipp, raw) < 0:
            rh_cli_err("roles: cannot read --input")
            return 4
    body: mutable darray[u8] = []
    if rh_roles_report(raw, body) != 0:
        rh_cli_err("roles: not a valid rh-roles-input/1 document (fail closed)")
        return 4
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("roles: cannot write --out")
        return 4
    rh_cli_out("roles: ok")
    0

