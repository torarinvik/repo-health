    rh_cli_err("usage: rh_cli scan --repo <local-path|https-url> --out <dir> [--full-history] [--window-days N]")
    rh_cli_err("       rh_cli replay --bundle <manifest> --out <dir>")
    rh_cli_err("       rh_cli continuity --bundle <manifest> --out <dir>")
    rh_cli_err("       rh_cli succession --input <file> --out <file>")
    rh_cli_err("       rh_cli deps --repo <local-dir> --out <dir> [--osv <file> | --osv-url <https-or-file-url>]")
    rh_cli_err("       rh_cli depsdev (--input <file> | --url <https-or-file-url>) --out <file>")
    rh_cli_err("       rh_cli ecosystem lookup --input <captured-lookup.json> --out <file>")
    rh_cli_err("       rh_cli adapter-manifest --input <file> --out <file>")
    rh_cli_err("       rh_cli findings --input <file> --out <file>")
    rh_cli_err("       rh_cli resolution --input <rh-dep-graph/1> --out <file>")
    rh_cli_err("       rh_cli parser-diff --native <file> --candidate <file> --out <file> [--native-parser N] [--candidate-parser N] [--config C] [--visibility public|private]")
    rh_cli_err("       rh_cli downstream --graph <dep-graph.json> --subject <id> --out <dir> [--snapshot-root <dir>] [--mapping <file>] [--mirror a:b]... [--intrinsics <file>] [--private <id>]... [--unavailable <id>]")
    rh_cli_err("            [--max-nodes N] [--max-depth D] [--unavailable <id>] [--private <id>]...")
