                else:
                    return rh_cli_usage(2)
                j <- j + 1
        return rh_cli_usage(2) if bundle_idx < 0 or out_idx < 0
        return rh_do_replay(slots[bundle_idx], slots[out_idx])
    if rh_streq(cmd, "continuity"):
        cb_idx, co_idx =
            while cc < argc |cb_idx: i64 = -1, co_idx: i64 = -1, cc: i64 = 2, slots| -> cb_idx, co_idx:
                arg6: u8& = slots[cc].cast[u8&] can Unsafe.PointerCast
