# --- M02 research conformance execution path. ---
# Replays bounded pages through the real event/index, cursor, and lease store.
def rh_do_postgres_ingest(store_root: cstr, input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if (Base::rh_cstr_len_c(store_root) > 0 and not Git::rh_arg_safe(store_root)) or not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected PostgreSQL ingest argument (allowlist)")
        return 3
    database_url: u8&? = getenv("RH_DATABASE_URL")
    if database_url == null:
        rh_cli_err("postgres ingest: RH_DATABASE_URL is required")
        return 4
    input_bytes: mutable darray[u8] =
        bytes: mutable darray[u8] = []
        Base::rh_push_cstr(bytes, input_path)
        bytes.push(0)
        bytes
    input_path_ptr: cstr = (&input_bytes[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if Base::rh_io_read(input_path_ptr, raw) < 0:
        rh_cli_err("postgres ingest: cannot read --input")
        return 4
    conninfo: cstr = database_url.cast[cstr] can Unsafe.PointerCast
    evidence_root: mutable darray[u8] = []
    if Base::rh_cstr_len_c(store_root) > 0:
        Base::rh_push_cstr(evidence_root, store_root)
        Base::rh_push_text(evidence_root, "/evidence")
        evidence_root.push(0)
    evidence_root_ptr: cstr = "" if evidence_root.count == 0 else (&evidence_root[0]).cast[cstr] can Unsafe.PointerCast
    expanded_raw: mutable darray[u8] = []
    if PostgresLegacyIngest::rh_postgres_legacy_expand(raw, expanded_raw) != 0:
        rh_cli_err("postgres ingest: unsupported or malformed ingest input (fail closed)")
        return 3
    body: mutable darray[u8] = []
    if PostgresIngest::rh_postgres_ingest_report(expanded_raw, conninfo, evidence_root_ptr, body) != 0:
        rh_cli_err("postgres ingest: collection page execution failed (fail closed)")
        return 4
    body.push(10)
    if not Base::rh_io_write(out_path, body):
        rh_cli_err("postgres ingest: cannot write --out")
        return 4
    rh_cli_out("postgres ingest: collection run finalized")
    0

def rh_do_ingest(root: cstr, input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected ingest argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        Base::rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if Base::rh_io_read(ipp, raw) < 0:
        rh_cli_err("ingest: cannot read --input")
        return 4
    body: mutable darray[u8] = []
    if IngestConformance::rh_ingest_conformance_report(raw, root, body) != 0:
        rh_cli_err("ingest: unsupported or malformed conformance input (fail closed)")
        return 4
    body.push(10)
    if not Base::rh_io_write(out_path, body):
        rh_cli_err("ingest: cannot write --out")
        return 4
    rh_cli_out("ingest: conformance replay complete")
    0

