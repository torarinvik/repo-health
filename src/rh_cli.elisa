def rh_do_serve(root: cstr, port: i64, maxc: i64) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    notice: mutable darray[u8] =
        notice: mutable darray[u8] = []
        Base::rh_push_text(notice, "serve: loopback 127.0.0.1 port ")
        Base::rh_push_decimal_i64(notice, port)
        Base::rh_push_text(notice, " root ")
        Base::rh_push_cstr(notice, root)
        notice.push(10)
        notice
    Base::rh_write_stdout(notice)
    n: i64 = Http::rh_http_serve(root, port.i32(), maxc)
    done: mutable darray[u8] = []
    if n < 0:
        Base::rh_push_text(done, "serve: could not bind loopback port")
    else:
        Base::rh_push_text(done, "serve: served ")
        Base::rh_push_decimal_i64(done, n)
        Base::rh_push_text(done, " connection(s)")
    done.push(10)
    Base::rh_write_stdout(done)
    return 4 if n < 0
    0

# --- M07-04 publication integrity: sign/verify a release artifact. ---
# A signature file is a small JSON object:
#   {"algorithm":"hmac-sha256","subject_sha256":"<hex>","signature":"<hex>"}
# The key is a raw byte file held separately from workers. Verification
# proves integrity of the subject bytes and possession of the shared key;
# it is NOT a claim that the subject is correct, safe, or trustworthy (S011).

# --- PEP 751 lock observation path. ---
def rh_do_pylock(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    return 3 if not rh_path_arg_ok(input_path) or not rh_path_arg_ok(out_path)
    input: mutable darray[u8] =
        input: mutable darray[u8] = []
        Base::rh_push_cstr(input, input_path)
        input.push(0)
        input
    input_ptr: cstr = (&input[0]).cast[cstr] can Unsafe.PointerCast
    input_size: i64 = Base::rh_file_size(input_ptr)
    return 4 if input_size <= 0 or input_size > 8388608
    raw: mutable darray[u8] = []
    return 4 if Base::rh_io_read(input_ptr, raw) < 0 or raw.count.i64() != input_size
    result: mutable darray[u8] = []
    if Pylock::rh_pylock_audit(raw, result) != 0:
        rh_cli_err("pylock: unsupported or malformed PEP 751 lock (bounded projection, fail closed)")
        return 4
    result.push(10)
    output: mutable darray[u8] =
        output: mutable darray[u8] = []
        Base::rh_push_cstr(output, out_path)
        output.push(0)
        output
    output_ptr: cstr = (&output[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(output_ptr, result):
        rh_cli_err("pylock: cannot write --out")
        return 4
    configuration: mutable darray[u8] = []
    Base::rh_push_text(configuration, "repo-health/pep751-lock-audit/1")
    configuration_sha: mutable darray[u8] = []
    input_sha: mutable darray[u8] = []
    output_sha: mutable darray[u8] = []
    Sha256::rh_sha256(configuration, configuration_sha)
    Sha256::rh_sha256(raw, input_sha)
    Sha256::rh_sha256(result, output_sha)
    transformations: mutable darray[u8] = []
    PylockTransformation::rh_pylock_transformation_report(configuration_sha, input_sha, output_sha, transformations)
    transformations.push(10)
    transformation_path: mutable darray[u8] = []
    Base::rh_push_cstr(transformation_path, out_path)
    Base::rh_push_text(transformation_path, ".transformations.json")
    transformation_path.push(0)
    transformation_ptr: cstr = (&transformation_path[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(transformation_ptr, transformations):
        rh_cli_err("pylock: cannot write transformation report")
        return 4
    rh_cli_out("pylock: PEP 751 audit emitted")
    0

def rh_do_pylock_observation(audit_path: cstr, artifact_id: i64, artifact_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    return 3 if not rh_path_arg_ok(audit_path) or not rh_path_arg_ok(artifact_path) or not rh_path_arg_ok(out_path)
    audit_size: i64 = Base::rh_file_size(audit_path)
    return 4 if audit_size <= 0 or audit_size > PylockObservation::RH_PYLOCK_OBSERVATION_MAX_AUDIT_BYTES
    audit: mutable darray[u8] = []
    return 4 if Base::rh_io_read(audit_path, audit) != audit_size
    file_size: i64 = Base::rh_file_size(artifact_path)
    return 4 if file_size <= 0 or file_size > PylockObservation::RH_PYLOCK_OBSERVATION_MAX_FILE_BYTES
    file_bytes: mutable darray[u8] = []
    return 4 if Base::rh_io_read(artifact_path, file_bytes) != file_size
    result: mutable darray[u8] = []
    if PylockObservation::rh_pylock_artifact_observation(audit, file_bytes, artifact_id, result) != 0:
        rh_cli_err("pylock-observe: audit artifact or expected hashes are malformed, unsupported, or outside bounds")
        return 4
    result.push(10)
    if not Base::rh_io_write(out_path, result):
        rh_cli_err("pylock-observe: cannot write --out")
        return 4
    rh_cli_out("pylock-observe: local artifact hash evidence recorded")
    0

# --- M03 dependency graph execution path. ---
# Reads a local project's Cargo.lock and npm package.json plus a
# package-lock.json, npm-shrinkwrap.json, pnpm v9 pnpm-lock.yaml, or fallback Yarn Classic v1 yarn.lock,
# requirements.txt, bounded PEP 621 pyproject.toml, go.mod, Gemfile.lock,
# composer.lock, packages.config, or the bounded pom.xml subset,
# resolves the version-aware graph, and writes one rh-dep-graph/1 report per
# ecosystem plus rh-deps-metrics/1. Requirements that do not resolve stay
# explicit unresolved nodes with reasons (never guessed edges, R009); a
# malformed lockfile fails closed with no partial graph (M07-03). An
# optional offline OSV JSON supplies advisories; without it, advisories are
# simply not collected (never fabricated). `--osv-url` is an explicit,
# bounded fetch path: the response and a source-status envelope are retained
# in the output directory before parsing, and non-2xx responses fail closed.
def rh_do_deps(repo: cstr, out: cstr, osv_path: cstr, has_osv: bool, osv_url: cstr, has_osv_url: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(repo) or not Git::rh_arg_safe(out):
        rh_cli_err("rejected deps argument (allowlist)")
        return 3
    if has_osv and not Git::rh_arg_safe(osv_path):
        rh_cli_err("rejected osv argument (allowlist)")
        return 3
    if has_osv and has_osv_url:
        rh_cli_err("deps: --osv and --osv-url are mutually exclusive")
        return 2
    if has_osv_url and not Git::rh_fetch_arg_safe(osv_url):
        rh_cli_err("deps: rejected --osv-url (transport/shell policy)")
        return 3
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("deps: cannot create output directory")
        return 4
    resolved_osv_path: mutable cstr = osv_path
    resolved_has_osv: mutable bool = has_osv
    if has_osv_url:
        body_path: mutable darray[u8] = []
        code_path: mutable darray[u8] = []
        err_path: mutable darray[u8] = []
        if not rh_out_path(out, "osv-fetch-body.json", body_path) or not rh_out_path(out, "osv-fetch-status.txt", code_path) or not rh_out_path(out, "osv-fetch.err", err_path):
            rh_cli_err("deps: cannot stage OSV fetch evidence")
            return 4
        body_path.push(0)
        code_path.push(0)
        err_path.push(0)
        body_ptr: cstr = (&body_path[0]).cast[cstr] can Unsafe.PointerCast
        code_ptr: cstr = (&code_path[0]).cast[cstr] can Unsafe.PointerCast
        fetch_rc: i64 = |err_path|
            err_ptr: cstr = (&err_path[0]).cast[cstr] can Unsafe.PointerCast
            block_result: i64 = Git::rh_run_https_get(osv_url, body_ptr, code_ptr, err_ptr)
            block_result
        if fetch_rc != 0:
            rh_cli_err("deps: OSV fetch failed; no advisory result published")
            return 4
        code_raw: mutable darray[u8] = []
        if Base::rh_io_read(code_ptr, code_raw) < 0 or code_raw.count == 0:
            rh_cli_err("deps: OSV fetch did not produce a status")
            return 4
        ok_status: bool = code_raw[0] == 50
        file_transport: bool = code_raw.count >= 3 and code_raw[0] == 48 and code_raw[1] == 48 and code_raw[2] == 48 and Base::rh_cstr_starts_with(osv_url, "file://")
        if not ok_status and not file_transport:
            rh_cli_err("deps: OSV fetch returned non-2xx; no advisory result published")
            return 4
        status: mutable darray[u8] =
            status: mutable darray[u8] = []
            Base::rh_push_text(status, "{\"schema\":\"rh-osv-fetch/1\",\"source_url\":\"")
            Base::rh_push_cstr(status, osv_url)
            Base::rh_push_text(status, "\",\"status\":\"")
            status
        code_data: u8& = (&code_raw[0]).cast[u8&] can Unsafe.PointerCast
        Base::rh_push_raw(status, code_data, code_raw.count)
        Base::rh_push_text(status, "\",\"body_file\":\"osv-fetch-body.json\",\"state\":\"collected\",\"note\":\"bounded transport capture retained before offline OSV matching\"}\n")
        if not Base::rh_io_write(code_ptr, status):
            rh_cli_err("deps: cannot write OSV fetch status")
            return 4
        resolved_osv_path <- body_ptr
        resolved_has_osv <- true
    osv_nodes: mutable darray[Json::RhJsonNode] = []
    osv_texts: mutable darray[u8] = []
    osv_root: mutable i64 = -1
    if resolved_has_osv:
        parsed_osv: i64 = |resolved_osv_path, osv_nodes, osv_texts|
            op: mutable darray[u8] =
                op: mutable darray[u8] = []
                Base::rh_push_cstr(op, resolved_osv_path)
                op.push(0)
                op
            oreadp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
            oraw: mutable darray[u8] = []
            if Base::rh_io_read(oreadp, oraw) < 0:
                rh_cli_err("deps: cannot read --osv file")
                return 4
            block_result: i64 = Json::rh_json_parse(oraw, osv_nodes, osv_texts)
            block_result
        if parsed_osv < 0:
            rh_cli_err("deps: --osv file is not valid JSON")
            return 4
        osv_root <- parsed_osv
    eco_codes: mutable darray[i64] = []
    declared: mutable darray[i64] = []
    resolved: mutable darray[i64] = []
    unresolved_n: mutable darray[i64] = []
    unsupported_n: mutable darray[i64] = []
    direct_declared_n: mutable darray[i64] = []
    direct_resolved_n: mutable darray[i64] = []
    direct_unresolved_n: mutable darray[i64] = []
    transitive_resolved_n: mutable darray[i64] = []
    runtime_requirements_n: mutable darray[i64] = []
    development_requirements_n: mutable darray[i64] = []
    optional_requirements_n: mutable darray[i64] = []
    peer_requirements_n: mutable darray[i64] = []
    unknown_scope_requirements_n: mutable darray[i64] = []
    runtime_direct_n: mutable darray[i64] = []
    build_direct_n: mutable darray[i64] = []
    optional_direct_n: mutable darray[i64] = []
    unknown_scope_direct_n: mutable darray[i64] = []
    unpinned_n: mutable darray[i64] = []
    digest_known_n: mutable darray[i64] = []
    digest_total_n: mutable darray[i64] = []
    maximum_depth_n: mutable darray[i64] = []
    resolution_complete_n: mutable darray[i64] = []
    node_count_n: mutable darray[i64] = []
    edge_count_n: mutable darray[i64] = []
    advisory_unknown_nodes_n: mutable darray[i64] = []
    fixed_version_available_n: mutable darray[i64] = []
    runtime_edges_n: mutable darray[i64] = []
    development_edges_n: mutable darray[i64] = []
    optional_edges_n: mutable darray[i64] = []
    peer_edges_n: mutable darray[i64] = []
    unknown_scope_edges_n: mutable darray[i64] = []
    advisories_n: mutable darray[i64] = []
    advisory_records_n: mutable darray[i64] = []
    affected_nodes_n: mutable darray[i64] = []
    affected_direct_nodes_n: mutable darray[i64] = []
    affected_transitive_nodes_n: mutable darray[i64] = []
    affected_unreachable_nodes_n: mutable darray[i64] = []
    withdrawn_n: mutable darray[i64] = []
    found: mutable i64 = 0

    # --- Cargo.lock ---
    cl: mutable darray[u8] = []
    if not rh_out_path(repo, "Cargo.lock", cl):
        rh_cli_err("deps: bad repo path")
        return 3
    clp: cstr = (&cl[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(clp):
        lockb: mutable darray[u8] = []
        if Base::rh_io_read(clp, lockb) < 0:
            rh_cli_err("deps: cannot read Cargo.lock")
            return 4
        cpkgs: mutable darray[Package::RhPkgNode] = []
        cpool: mutable darray[u8] = []
        creqs: mutable darray[Package::RhRequire] = []
        cn: i64 = |lockb, cpkgs, cpool, creqs|
            cunk: mutable i64 = 0
            block_result: i64 = Package::rh_cargo_parse(lockb, cpkgs, cpool, creqs, &cunk)
            block_result
        if cn < 0:
            rh_cli_err("deps: malformed Cargo.lock (structured failure, no partial graph)")
            return 4
        cedges: mutable darray[Package::RhDepEdge] = []
        cunres: mutable darray[Package::RhUnresolved] = []
        _ = Package::rh_cargo_resolve(cpkgs, cpool, creqs, cedges, cunres)
        cunsup: i64 = Package::rh_unsupported_range_count(creqs, cpool)
        cfind: mutable darray[Package::RhAdvisory] = []
        cwd: mutable i64 = 0
        csk: mutable i64 = 0
        if resolved_has_osv:
            _ = Package::rh_osv_match(cpkgs, cpool, osv_nodes, osv_texts, osv_root, cfind, &cwd, &csk)
        cartifacts: mutable darray[Package::RhArtifact] = []
        _ = Package::rh_artifacts_from_packages(cpkgs, cartifacts)
        croot: i64 = Package::rh_deps_cargo_root(cpkgs, cedges)
        gb: mutable darray[u8] = []
        Package::rh_graph_write_json(gb, 0, cpkgs, cpool, cartifacts, cedges, cunres, cfind, osv_texts, croot)
        gb.push(10)
        gf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-cargo-graph.json", gf):
            rh_cli_err("deps: cannot stage cargo graph path")
            return 4
        gfp: cstr = (&gf[0]).cast[cstr] can Unsafe.PointerCast
        if not Base::rh_io_write(gfp, gb):
            rh_cli_err("deps: cannot write cargo graph")
            return 4
        eco_codes.push(0)
        declared.push(creqs.count.i64())
        resolved.push(cedges.count.i64())
        unresolved_n.push(cunres.count.i64())
        unsupported_n.push(cunsup)
        direct_declared_n.push(Package::rh_direct_requirement_count(creqs, croot))
        direct_resolved_n.push(Package::rh_direct_resolved_count(cedges, croot))
        direct_unresolved_n.push(Package::rh_direct_unresolved_count(cunres, croot))
        transitive_resolved_n.push(Package::rh_reachable_dependency_count(cedges, cpkgs.count.i64(), croot))
        runtime_requirements_n.push(Package::rh_scope_count(creqs, Package::RH_SCOPE_NORMAL))
        development_requirements_n.push(Package::rh_scope_count(creqs, Package::RH_SCOPE_DEV))
        optional_requirements_n.push(Package::rh_scope_count(creqs, Package::RH_SCOPE_OPTIONAL))
        peer_requirements_n.push(Package::rh_scope_count(creqs, Package::RH_SCOPE_PEER))
        unknown_scope_requirements_n.push(Package::rh_scope_count(creqs, Package::RH_SCOPE_DECLARED))
        runtime_direct_n.push(Package::rh_direct_scope_count(creqs, croot, Package::RH_SCOPE_NORMAL))
        build_direct_n.push(Package::rh_direct_scope_count(creqs, croot, Package::RH_SCOPE_DEV))
        optional_direct_n.push(Package::rh_direct_scope_count(creqs, croot, Package::RH_SCOPE_OPTIONAL))
        unknown_scope_direct_n.push(Package::rh_direct_scope_count(creqs, croot, Package::RH_SCOPE_DECLARED))
        unpinned_n.push(Package::rh_unpinned_requirement_count(creqs, cpool))
        digest_known_n.push(Package::rh_resolved_node_metric_count(cpkgs, cedges, true))
        digest_total_n.push(Package::rh_resolved_node_metric_count(cpkgs, cedges, false))
        maximum_depth_n.push(Package::rh_max_dependency_depth(cedges, cpkgs.count.i64(), croot))
        resolution_complete_n.push(1 if Package::rh_resolution_complete(cedges, cunres, cpkgs.count.i64(), croot) else 0)
        node_count_n.push(cpkgs.count.i64())
        edge_count_n.push(cedges.count.i64())
        advisory_unknown_nodes_n.push(Package::rh_advisory_unknown_node_count(cpkgs, cedges) if resolved_has_osv else -1)
        fixed_version_available_n.push(1 if resolved_has_osv and Package::rh_fixed_version_available(cfind) else 0 if resolved_has_osv else -1)
        runtime_edges_n.push(Package::rh_edge_scope_count(cedges, Package::RH_SCOPE_NORMAL))
        development_edges_n.push(Package::rh_edge_scope_count(cedges, Package::RH_SCOPE_DEV))
        optional_edges_n.push(Package::rh_edge_scope_count(cedges, Package::RH_SCOPE_OPTIONAL))
        peer_edges_n.push(Package::rh_edge_scope_count(cedges, Package::RH_SCOPE_PEER))
        unknown_scope_edges_n.push(Package::rh_edge_scope_count(cedges, Package::RH_SCOPE_DECLARED))
        advisories_n.push(cfind.count.i64() if resolved_has_osv else -1)
        advisory_records_n.push(Package::rh_advisory_record_count(cfind) if resolved_has_osv else -1)
        affected_nodes_n.push(Package::rh_advisory_node_count(cfind) if resolved_has_osv else -1)
        affected_direct_nodes_n.push(Package::rh_advisory_scope_count(cfind, cedges, croot, cpkgs.count.i64(), 0) if resolved_has_osv else -1)
        affected_transitive_nodes_n.push(Package::rh_advisory_scope_count(cfind, cedges, croot, cpkgs.count.i64(), 1) if resolved_has_osv else -1)
        affected_unreachable_nodes_n.push(Package::rh_advisory_scope_count(cfind, cedges, croot, cpkgs.count.i64(), 2) if resolved_has_osv else -1)
        withdrawn_n.push(cwd if resolved_has_osv else -1)
        found <- found + 1

    # --- Node lockfile precedence: shrinkwrap, npm, pnpm v9, then Yarn v1 ---
    pl: mutable darray[u8] = []
    if not rh_out_path(repo, "package-lock.json", pl):
        rh_cli_err("deps: bad repo path")
        return 3
    plp: cstr = (&pl[0]).cast[cstr] can Unsafe.PointerCast
    sw: mutable darray[u8] = []
    if not rh_out_path(repo, "npm-shrinkwrap.json", sw):
        rh_cli_err("deps: bad repo path")
        return 3
    yl: mutable darray[u8] = []
    if not rh_out_path(repo, "yarn.lock", yl):
        rh_cli_err("deps: bad repo path")
        return 3
    pn: mutable darray[u8] = []
    if not rh_out_path(repo, "pnpm-lock.yaml", pn):
        rh_cli_err("deps: bad repo path")
        return 3
    swp: cstr = (&sw[0]).cast[cstr] can Unsafe.PointerCast
    ylp: cstr = (&yl[0]).cast[cstr] can Unsafe.PointerCast
    pnp: cstr = (&pn[0]).cast[cstr] can Unsafe.PointerCast
    use_shrinkwrap: bool = file_exists(swp)
    use_package_lock: bool = file_exists(plp)
    use_pnpm_lock: bool = not use_shrinkwrap and not use_package_lock and file_exists(pnp)
    use_yarn_lock: bool = not use_shrinkwrap and not use_package_lock and not use_pnpm_lock and file_exists(ylp)
    npm_lock_path: mutable cstr = swp if use_shrinkwrap else plp
    npm_lock_path <- pnp if use_pnpm_lock
    npm_lock_path <- ylp if use_yarn_lock
    if use_shrinkwrap or use_package_lock or use_pnpm_lock or use_yarn_lock:
        nlock: mutable darray[u8] = []
        if Base::rh_io_read(npm_lock_path, nlock) < 0:
            rh_cli_err("deps: cannot read Node lockfile")
            return 4
        pj: mutable darray[u8] = []
        if not rh_out_path(repo, "package.json", pj):
            rh_cli_err("deps: bad repo path")
            return 3
        pjp: cstr = (&pj[0]).cast[cstr] can Unsafe.PointerCast
        npkg: mutable darray[u8] = []
        if file_exists(pjp):
            if Base::rh_io_read(pjp, npkg) < 0:
                rh_cli_err("deps: cannot read package.json")
                return 4
        npkgs: mutable darray[Package::RhPkgNode] = []
        npool: mutable darray[u8] = []
        npaths: mutable darray[i64] = []
        nreqs: mutable darray[Package::RhRequire] = []
        nedges: mutable darray[Package::RhDepEdge] = []
        nunres: mutable darray[Package::RhUnresolved] = []
        nroot: i64 = Package::rh_npm_lock_parse(nlock, npkg, npkgs, npool, npaths, nreqs) if not use_yarn_lock and not use_pnpm_lock else Package::rh_yarn_lock_parse(nlock, npkg, npkgs, npool, nreqs, nedges, nunres) if use_yarn_lock else Package::rh_pnpm_lock_parse(nlock, npkg, npkgs, npool, nreqs, nedges, nunres)
        if nroot < 0:
            rh_cli_err("deps: malformed Node lockfile (structured failure, no partial graph)")
            return 4
        if not use_yarn_lock and not use_pnpm_lock:
            _ = Package::rh_npm_resolve(npkgs, npaths, npool, nreqs, nedges, nunres)
        nunsup: i64 = Package::rh_unsupported_range_count(nreqs, npool)
        nfind: mutable darray[Package::RhAdvisory] = []
        nwd: mutable i64 = 0
        nsk: mutable i64 = 0
        if resolved_has_osv:
            _ = Package::rh_osv_match(npkgs, npool, osv_nodes, osv_texts, osv_root, nfind, &nwd, &nsk)
        nartifacts: mutable darray[Package::RhArtifact] = []
        _ = Package::rh_artifacts_from_packages(npkgs, nartifacts)
        ng: mutable darray[u8] = []
        Package::rh_graph_write_json(ng, 1, npkgs, npool, nartifacts, nedges, nunres, nfind, osv_texts, nroot)
        ng.push(10)
        nf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-npm-graph.json", nf):
            rh_cli_err("deps: cannot stage npm graph path")
            return 4
        nfp: cstr = (&nf[0]).cast[cstr] can Unsafe.PointerCast
        if not Base::rh_io_write(nfp, ng):
            rh_cli_err("deps: cannot write npm graph")
            return 4
        eco_codes.push(1)
        declared.push(nreqs.count.i64())
        resolved.push(nedges.count.i64())
        unresolved_n.push(nunres.count.i64())
        unsupported_n.push(nunsup)
        direct_declared_n.push(Package::rh_direct_requirement_count(nreqs, nroot))
        direct_resolved_n.push(Package::rh_direct_resolved_count(nedges, nroot))
        direct_unresolved_n.push(Package::rh_direct_unresolved_count(nunres, nroot))
        transitive_resolved_n.push(Package::rh_reachable_dependency_count(nedges, npkgs.count.i64(), nroot))
        runtime_requirements_n.push(Package::rh_scope_count(nreqs, Package::RH_SCOPE_NORMAL))
        development_requirements_n.push(Package::rh_scope_count(nreqs, Package::RH_SCOPE_DEV))
        optional_requirements_n.push(Package::rh_scope_count(nreqs, Package::RH_SCOPE_OPTIONAL))
        peer_requirements_n.push(Package::rh_scope_count(nreqs, Package::RH_SCOPE_PEER))
        unknown_scope_requirements_n.push(Package::rh_scope_count(nreqs, Package::RH_SCOPE_DECLARED))
        runtime_direct_n.push(Package::rh_direct_scope_count(nreqs, nroot, Package::RH_SCOPE_NORMAL))
        build_direct_n.push(Package::rh_direct_scope_count(nreqs, nroot, Package::RH_SCOPE_DEV))
        optional_direct_n.push(Package::rh_direct_scope_count(nreqs, nroot, Package::RH_SCOPE_OPTIONAL))
        unknown_scope_direct_n.push(Package::rh_direct_scope_count(nreqs, nroot, Package::RH_SCOPE_DECLARED))
        unpinned_n.push(Package::rh_unpinned_requirement_count(nreqs, npool))
        digest_known_n.push(Package::rh_resolved_node_metric_count(npkgs, nedges, true))
        digest_total_n.push(Package::rh_resolved_node_metric_count(npkgs, nedges, false))
        maximum_depth_n.push(Package::rh_max_dependency_depth(nedges, npkgs.count.i64(), nroot))
        resolution_complete_n.push(1 if Package::rh_resolution_complete(nedges, nunres, npkgs.count.i64(), nroot) else 0)
        node_count_n.push(npkgs.count.i64())
        edge_count_n.push(nedges.count.i64())
        advisory_unknown_nodes_n.push(Package::rh_advisory_unknown_node_count(npkgs, nedges) if resolved_has_osv else -1)
        fixed_version_available_n.push(1 if resolved_has_osv and Package::rh_fixed_version_available(nfind) else 0 if resolved_has_osv else -1)
        runtime_edges_n.push(Package::rh_edge_scope_count(nedges, Package::RH_SCOPE_NORMAL))
        development_edges_n.push(Package::rh_edge_scope_count(nedges, Package::RH_SCOPE_DEV))
        optional_edges_n.push(Package::rh_edge_scope_count(nedges, Package::RH_SCOPE_OPTIONAL))
        peer_edges_n.push(Package::rh_edge_scope_count(nedges, Package::RH_SCOPE_PEER))
        unknown_scope_edges_n.push(Package::rh_edge_scope_count(nedges, Package::RH_SCOPE_DECLARED))
        advisories_n.push(nfind.count.i64() if resolved_has_osv else -1)
        advisory_records_n.push(Package::rh_advisory_record_count(nfind) if resolved_has_osv else -1)
        affected_nodes_n.push(Package::rh_advisory_node_count(nfind) if resolved_has_osv else -1)
        affected_direct_nodes_n.push(Package::rh_advisory_scope_count(nfind, nedges, nroot, npkgs.count.i64(), 0) if resolved_has_osv else -1)
        affected_transitive_nodes_n.push(Package::rh_advisory_scope_count(nfind, nedges, nroot, npkgs.count.i64(), 1) if resolved_has_osv else -1)
        affected_unreachable_nodes_n.push(Package::rh_advisory_scope_count(nfind, nedges, nroot, npkgs.count.i64(), 2) if resolved_has_osv else -1)
        withdrawn_n.push(nwd if resolved_has_osv else -1)
        found <- found + 1

    # --- requirements.txt (PyPI) ---
    rq: mutable darray[u8] = []
    if not rh_out_path(repo, "requirements.txt", rq):
        rh_cli_err("deps: bad repo path")
        return 3
    rqp: cstr = (&rq[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(rqp):
        rb: mutable darray[u8] = []
        if Base::rh_io_read(rqp, rb) < 0:
            rh_cli_err("deps: cannot read requirements.txt")
            return 4
        ppkgs: mutable darray[Package::RhPkgNode] = []
        ppool: mutable darray[u8] = []
        preqs: mutable darray[Package::RhRequire] = []
        pedges: mutable darray[Package::RhDepEdge] = []
        punres: mutable darray[Package::RhUnresolved] = []
        proot: i64 = |rb, ppkgs, ppool, preqs, pedges, punres|
            punk: mutable i64 = 0
            block_result: i64 = Package::rh_pypi_parse(rb, ppkgs, ppool, preqs, pedges, punres, &punk)
            block_result
        if proot < 0:
            rh_cli_err("deps: malformed requirements.txt (structured failure, no partial graph)")
            return 4
        punsup: i64 = Package::rh_unsupported_range_count(preqs, ppool)
        pfind: mutable darray[Package::RhAdvisory] = []
        pwd: mutable i64 = 0
        psk: mutable i64 = 0
        if resolved_has_osv:
            _ = Package::rh_osv_match(ppkgs, ppool, osv_nodes, osv_texts, osv_root, pfind, &pwd, &psk)
        partifacts: mutable darray[Package::RhArtifact] = []
        _ = Package::rh_artifacts_from_packages(ppkgs, partifacts)
        pg: mutable darray[u8] = []
        Package::rh_graph_write_json(pg, 2, ppkgs, ppool, partifacts, pedges, punres, pfind, osv_texts, proot)
        pg.push(10)
        pf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-pypi-graph.json", pf):
            rh_cli_err("deps: cannot stage pypi graph path")
            return 4
        pfp: cstr = (&pf[0]).cast[cstr] can Unsafe.PointerCast
        if not Base::rh_io_write(pfp, pg):
            rh_cli_err("deps: cannot write pypi graph")
            return 4
        eco_codes.push(2)
        declared.push(preqs.count.i64())
        resolved.push(pedges.count.i64())
        unresolved_n.push(punres.count.i64())
        unsupported_n.push(punsup)
        direct_declared_n.push(Package::rh_direct_requirement_count(preqs, proot))
        direct_resolved_n.push(Package::rh_direct_resolved_count(pedges, proot))
        direct_unresolved_n.push(Package::rh_direct_unresolved_count(punres, proot))
        transitive_resolved_n.push(Package::rh_reachable_dependency_count(pedges, ppkgs.count.i64(), proot))
        runtime_requirements_n.push(Package::rh_scope_count(preqs, Package::RH_SCOPE_NORMAL))
        development_requirements_n.push(Package::rh_scope_count(preqs, Package::RH_SCOPE_DEV))
        optional_requirements_n.push(Package::rh_scope_count(preqs, Package::RH_SCOPE_OPTIONAL))
        peer_requirements_n.push(Package::rh_scope_count(preqs, Package::RH_SCOPE_PEER))
        unknown_scope_requirements_n.push(Package::rh_scope_count(preqs, Package::RH_SCOPE_DECLARED))
        runtime_direct_n.push(Package::rh_direct_scope_count(preqs, proot, Package::RH_SCOPE_NORMAL))
        build_direct_n.push(Package::rh_direct_scope_count(preqs, proot, Package::RH_SCOPE_DEV))
        optional_direct_n.push(Package::rh_direct_scope_count(preqs, proot, Package::RH_SCOPE_OPTIONAL))
        unknown_scope_direct_n.push(Package::rh_direct_scope_count(preqs, proot, Package::RH_SCOPE_DECLARED))
        unpinned_n.push(Package::rh_unpinned_requirement_count(preqs, ppool))
        digest_known_n.push(Package::rh_resolved_node_metric_count(ppkgs, pedges, true))
        digest_total_n.push(Package::rh_resolved_node_metric_count(ppkgs, pedges, false))
        maximum_depth_n.push(Package::rh_max_dependency_depth(pedges, ppkgs.count.i64(), proot))
        resolution_complete_n.push(1 if Package::rh_resolution_complete(pedges, punres, ppkgs.count.i64(), proot) else 0)
        node_count_n.push(ppkgs.count.i64())
        edge_count_n.push(pedges.count.i64())
        advisory_unknown_nodes_n.push(Package::rh_advisory_unknown_node_count(ppkgs, pedges) if resolved_has_osv else -1)
        fixed_version_available_n.push(1 if resolved_has_osv and Package::rh_fixed_version_available(pfind) else 0 if resolved_has_osv else -1)
        runtime_edges_n.push(Package::rh_edge_scope_count(pedges, Package::RH_SCOPE_NORMAL))
        development_edges_n.push(Package::rh_edge_scope_count(pedges, Package::RH_SCOPE_DEV))
        optional_edges_n.push(Package::rh_edge_scope_count(pedges, Package::RH_SCOPE_OPTIONAL))
        peer_edges_n.push(Package::rh_edge_scope_count(pedges, Package::RH_SCOPE_PEER))
        unknown_scope_edges_n.push(Package::rh_edge_scope_count(pedges, Package::RH_SCOPE_DECLARED))
        advisories_n.push(pfind.count.i64() if resolved_has_osv else -1)
        advisory_records_n.push(Package::rh_advisory_record_count(pfind) if resolved_has_osv else -1)
        affected_nodes_n.push(Package::rh_advisory_node_count(pfind) if resolved_has_osv else -1)
        affected_direct_nodes_n.push(Package::rh_advisory_scope_count(pfind, pedges, proot, ppkgs.count.i64(), 0) if resolved_has_osv else -1)
        affected_transitive_nodes_n.push(Package::rh_advisory_scope_count(pfind, pedges, proot, ppkgs.count.i64(), 1) if resolved_has_osv else -1)
        affected_unreachable_nodes_n.push(Package::rh_advisory_scope_count(pfind, pedges, proot, ppkgs.count.i64(), 2) if resolved_has_osv else -1)
        withdrawn_n.push(pwd if resolved_has_osv else -1)
        found <- found + 1

    # --- pyproject.toml (PEP 621 declared dependencies) ---
    py: mutable darray[u8] = []
    if not rh_out_path(repo, "pyproject.toml", py):
        rh_cli_err("deps: bad repo path")
        return 3
    pyp: cstr = (&py[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(pyp):
        if file_exists(rqp):
            rh_cli_err("deps: requirements.txt and pyproject.toml are both present; choose one declared PyPI source")
            return 4
        pyb: mutable darray[u8] = []
        if Base::rh_io_read(pyp, pyb) < 0:
            rh_cli_err("deps: cannot read pyproject.toml")
            return 4
        ypkgs: mutable darray[Package::RhPkgNode] = []
        ypool: mutable darray[u8] = []
        yreqs: mutable darray[Package::RhRequire] = []
        yedges: mutable darray[Package::RhDepEdge] = []
        yunres: mutable darray[Package::RhUnresolved] = []
        yroot: i64 = |pyb, ypkgs, ypool, yreqs, yedges, yunres|
            yunk: mutable i64 = 0
            block_result: i64 = Package::rh_pypi_parse_pep621(pyb, ypkgs, ypool, yreqs, yedges, yunres, &yunk)
            block_result
        if yroot < 0:
            rh_cli_err("deps: malformed pyproject.toml PEP 621 subset (structured failure, no partial graph)")
            return 4
        yunsup: i64 = Package::rh_unsupported_range_count(yreqs, ypool)
        yfind: mutable darray[Package::RhAdvisory] = []
        ywd: mutable i64 = 0
        ysk: mutable i64 = 0
        if resolved_has_osv:
            _ = Package::rh_osv_match(ypkgs, ypool, osv_nodes, osv_texts, osv_root, yfind, &ywd, &ysk)
        yartifacts: mutable darray[Package::RhArtifact] = []
        _ = Package::rh_artifacts_from_packages(ypkgs, yartifacts)
        yg: mutable darray[u8] = []
        Package::rh_graph_write_json(yg, 2, ypkgs, ypool, yartifacts, yedges, yunres, yfind, osv_texts, yroot)
        yg.push(10)
        yf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-pypi-graph.json", yf):
            rh_cli_err("deps: cannot stage pypi graph path")
            return 4
        yfp: cstr = (&yf[0]).cast[cstr] can Unsafe.PointerCast
        if not Base::rh_io_write(yfp, yg):
            rh_cli_err("deps: cannot write pypi graph")
            return 4
        eco_codes.push(2)
        declared.push(yreqs.count.i64())
        resolved.push(yedges.count.i64())
        unresolved_n.push(yunres.count.i64())
        unsupported_n.push(yunsup)
        direct_declared_n.push(Package::rh_direct_requirement_count(yreqs, yroot))
        direct_resolved_n.push(Package::rh_direct_resolved_count(yedges, yroot))
        direct_unresolved_n.push(Package::rh_direct_unresolved_count(yunres, yroot))
        transitive_resolved_n.push(Package::rh_reachable_dependency_count(yedges, ypkgs.count.i64(), yroot))
        runtime_requirements_n.push(Package::rh_scope_count(yreqs, Package::RH_SCOPE_NORMAL))
        development_requirements_n.push(Package::rh_scope_count(yreqs, Package::RH_SCOPE_DEV))
        optional_requirements_n.push(Package::rh_scope_count(yreqs, Package::RH_SCOPE_OPTIONAL))
        peer_requirements_n.push(Package::rh_scope_count(yreqs, Package::RH_SCOPE_PEER))
        unknown_scope_requirements_n.push(Package::rh_scope_count(yreqs, Package::RH_SCOPE_DECLARED))
        runtime_direct_n.push(Package::rh_direct_scope_count(yreqs, yroot, Package::RH_SCOPE_NORMAL))
        build_direct_n.push(Package::rh_direct_scope_count(yreqs, yroot, Package::RH_SCOPE_DEV))
        optional_direct_n.push(Package::rh_direct_scope_count(yreqs, yroot, Package::RH_SCOPE_OPTIONAL))
        unknown_scope_direct_n.push(Package::rh_direct_scope_count(yreqs, yroot, Package::RH_SCOPE_DECLARED))
        unpinned_n.push(Package::rh_unpinned_requirement_count(yreqs, ypool))
        digest_known_n.push(Package::rh_resolved_node_metric_count(ypkgs, yedges, true))
        digest_total_n.push(Package::rh_resolved_node_metric_count(ypkgs, yedges, false))
        maximum_depth_n.push(Package::rh_max_dependency_depth(yedges, ypkgs.count.i64(), yroot))
        resolution_complete_n.push(1 if Package::rh_resolution_complete(yedges, yunres, ypkgs.count.i64(), yroot) else 0)
        node_count_n.push(ypkgs.count.i64())
        edge_count_n.push(yedges.count.i64())
        advisory_unknown_nodes_n.push(Package::rh_advisory_unknown_node_count(ypkgs, yedges) if resolved_has_osv else -1)
        fixed_version_available_n.push(1 if resolved_has_osv and Package::rh_fixed_version_available(yfind) else 0 if resolved_has_osv else -1)
        runtime_edges_n.push(Package::rh_edge_scope_count(yedges, Package::RH_SCOPE_NORMAL))
        development_edges_n.push(Package::rh_edge_scope_count(yedges, Package::RH_SCOPE_DEV))
        optional_edges_n.push(Package::rh_edge_scope_count(yedges, Package::RH_SCOPE_OPTIONAL))
        peer_edges_n.push(Package::rh_edge_scope_count(yedges, Package::RH_SCOPE_PEER))
        unknown_scope_edges_n.push(Package::rh_edge_scope_count(yedges, Package::RH_SCOPE_DECLARED))
        advisories_n.push(yfind.count.i64() if resolved_has_osv else -1)
        advisory_records_n.push(Package::rh_advisory_record_count(yfind) if resolved_has_osv else -1)
        affected_nodes_n.push(Package::rh_advisory_node_count(yfind) if resolved_has_osv else -1)
        affected_direct_nodes_n.push(Package::rh_advisory_scope_count(yfind, yedges, yroot, ypkgs.count.i64(), 0) if resolved_has_osv else -1)
        affected_transitive_nodes_n.push(Package::rh_advisory_scope_count(yfind, yedges, yroot, ypkgs.count.i64(), 1) if resolved_has_osv else -1)
        affected_unreachable_nodes_n.push(Package::rh_advisory_scope_count(yfind, yedges, yroot, ypkgs.count.i64(), 2) if resolved_has_osv else -1)
        withdrawn_n.push(ywd if resolved_has_osv else -1)
        found <- found + 1

    # --- go.mod (Go modules) ---
    gm: mutable darray[u8] = []
    if not rh_out_path(repo, "go.mod", gm):
        rh_cli_err("deps: bad repo path")
        return 3
    gmp: cstr = (&gm[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(gmp):
        gb: mutable darray[u8] = []
        if Base::rh_io_read(gmp, gb) < 0:
            rh_cli_err("deps: cannot read go.mod")
            return 4
        gpkgs: mutable darray[Package::RhPkgNode] = []
        gpool: mutable darray[u8] = []
        greqs: mutable darray[Package::RhRequire] = []
        gedges: mutable darray[Package::RhDepEdge] = []
        gunres: mutable darray[Package::RhUnresolved] = []
        groot: i64 = |gb, gpkgs, gpool, greqs, gedges, gunres|
            gunk: mutable i64 = 0
            block_result: i64 = Package::rh_go_parse(gb, gpkgs, gpool, greqs, gedges, gunres, &gunk)
            block_result
        if groot < 0:
            rh_cli_err("deps: malformed go.mod (structured failure, no partial graph)")
            return 4
        # go.sum is optional for a module-only capture, but when present every
        # non-empty line must be a valid checksum record. Matching h1: module
        # checksums become module artifacts; /go.mod records become go_mod
        # artifacts for independent file verification.
        gartifacts: mutable darray[Package::RhArtifact] = []
        gs: mutable darray[u8] = []
        if not rh_out_path(repo, "go.sum", gs):
            rh_cli_err("deps: bad repo path")
            return 3
        gsp: cstr = (&gs[0]).cast[cstr] can Unsafe.PointerCast
        if file_exists(gsp):
            gsb: mutable darray[u8] = []
            if Base::rh_io_read(gsp, gsb) < 0:
                rh_cli_err("deps: cannot read go.sum")
                return 4
            if Package::rh_go_sum_parse(gsb, gpkgs, gpool, gartifacts) != 0:
                rh_cli_err("deps: malformed go.sum (structured failure, no partial graph)")
                return 4
        gunsup: i64 = Package::rh_unsupported_range_count(greqs, gpool)
        gfind: mutable darray[Package::RhAdvisory] = []
        gwd: mutable i64 = 0
        gsk: mutable i64 = 0
        if resolved_has_osv:
            _ = Package::rh_osv_match(gpkgs, gpool, osv_nodes, osv_texts, osv_root, gfind, &gwd, &gsk)
        _ = Package::rh_artifacts_from_packages(gpkgs, gartifacts)
        gg: mutable darray[u8] = []
        Package::rh_graph_write_json(gg, 3, gpkgs, gpool, gartifacts, gedges, gunres, gfind, osv_texts, groot)
        gg.push(10)
        gf2: mutable darray[u8] = []
        if not rh_out_path(out, "deps-go-graph.json", gf2):
            rh_cli_err("deps: cannot stage go graph path")
            return 4
        gf2p: cstr = (&gf2[0]).cast[cstr] can Unsafe.PointerCast
        if not Base::rh_io_write(gf2p, gg):
            rh_cli_err("deps: cannot write go graph")
            return 4
        eco_codes.push(3)
        declared.push(greqs.count.i64())
        resolved.push(gedges.count.i64())
        unresolved_n.push(gunres.count.i64())
        unsupported_n.push(gunsup)
        direct_declared_n.push(Package::rh_direct_requirement_count(greqs, groot))
        direct_resolved_n.push(Package::rh_direct_resolved_count(gedges, groot))
        direct_unresolved_n.push(Package::rh_direct_unresolved_count(gunres, groot))
        transitive_resolved_n.push(Package::rh_reachable_dependency_count(gedges, gpkgs.count.i64(), groot))
        runtime_requirements_n.push(Package::rh_scope_count(greqs, Package::RH_SCOPE_NORMAL))
        development_requirements_n.push(Package::rh_scope_count(greqs, Package::RH_SCOPE_DEV))
        optional_requirements_n.push(Package::rh_scope_count(greqs, Package::RH_SCOPE_OPTIONAL))
        peer_requirements_n.push(Package::rh_scope_count(greqs, Package::RH_SCOPE_PEER))
        unknown_scope_requirements_n.push(Package::rh_scope_count(greqs, Package::RH_SCOPE_DECLARED))
        runtime_direct_n.push(Package::rh_direct_scope_count(greqs, groot, Package::RH_SCOPE_NORMAL))
        build_direct_n.push(Package::rh_direct_scope_count(greqs, groot, Package::RH_SCOPE_DEV))
        optional_direct_n.push(Package::rh_direct_scope_count(greqs, groot, Package::RH_SCOPE_OPTIONAL))
        unknown_scope_direct_n.push(Package::rh_direct_scope_count(greqs, groot, Package::RH_SCOPE_DECLARED))
        unpinned_n.push(Package::rh_unpinned_requirement_count(greqs, gpool))
        digest_known_n.push(Package::rh_resolved_node_metric_count(gpkgs, gedges, true))
        digest_total_n.push(Package::rh_resolved_node_metric_count(gpkgs, gedges, false))
        maximum_depth_n.push(Package::rh_max_dependency_depth(gedges, gpkgs.count.i64(), groot))
        resolution_complete_n.push(1 if Package::rh_resolution_complete(gedges, gunres, gpkgs.count.i64(), groot) else 0)
        node_count_n.push(gpkgs.count.i64())
        edge_count_n.push(gedges.count.i64())
        advisory_unknown_nodes_n.push(Package::rh_advisory_unknown_node_count(gpkgs, gedges) if resolved_has_osv else -1)
        fixed_version_available_n.push(1 if resolved_has_osv and Package::rh_fixed_version_available(gfind) else 0 if resolved_has_osv else -1)
        runtime_edges_n.push(Package::rh_edge_scope_count(gedges, Package::RH_SCOPE_NORMAL))
        development_edges_n.push(Package::rh_edge_scope_count(gedges, Package::RH_SCOPE_DEV))
        optional_edges_n.push(Package::rh_edge_scope_count(gedges, Package::RH_SCOPE_OPTIONAL))
        peer_edges_n.push(Package::rh_edge_scope_count(gedges, Package::RH_SCOPE_PEER))
        unknown_scope_edges_n.push(Package::rh_edge_scope_count(gedges, Package::RH_SCOPE_DECLARED))
        advisories_n.push(gfind.count.i64() if resolved_has_osv else -1)
        advisory_records_n.push(Package::rh_advisory_record_count(gfind) if resolved_has_osv else -1)
        affected_nodes_n.push(Package::rh_advisory_node_count(gfind) if resolved_has_osv else -1)
        affected_direct_nodes_n.push(Package::rh_advisory_scope_count(gfind, gedges, groot, gpkgs.count.i64(), 0) if resolved_has_osv else -1)
        affected_transitive_nodes_n.push(Package::rh_advisory_scope_count(gfind, gedges, groot, gpkgs.count.i64(), 1) if resolved_has_osv else -1)
        affected_unreachable_nodes_n.push(Package::rh_advisory_scope_count(gfind, gedges, groot, gpkgs.count.i64(), 2) if resolved_has_osv else -1)
        withdrawn_n.push(gwd if resolved_has_osv else -1)
        found <- found + 1

    # --- Gemfile.lock (RubyGems) ---
    gl: mutable darray[u8] = []
    if not rh_out_path(repo, "Gemfile.lock", gl):
        rh_cli_err("deps: bad repo path")
        return 3
    glp: cstr = (&gl[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(glp):
        gemb: mutable darray[u8] = []
        if Base::rh_io_read(glp, gemb) < 0:
            rh_cli_err("deps: cannot read Gemfile.lock")
            return 4
        gempkgs: mutable darray[Package::RhPkgNode] = []
        gempool: mutable darray[u8] = []
        gemreqs: mutable darray[Package::RhRequire] = []
        gemedges: mutable darray[Package::RhDepEdge] = []
        gemunres: mutable darray[Package::RhUnresolved] = []
        gemroot: i64 = |gemb, gempkgs, gempool, gemreqs, gemedges, gemunres|
            gemunk: mutable i64 = 0
            block_result: i64 = Package::rh_gemfile_parse(gemb, gempkgs, gempool, gemreqs, gemedges, gemunres, &gemunk)
            block_result
        if gemroot < 0:
            rh_cli_err("deps: malformed Gemfile.lock (structured failure, no partial graph)")
            return 4
        gemunsup: i64 = Package::rh_unsupported_range_count(gemreqs, gempool)
        gemfind: mutable darray[Package::RhAdvisory] = []
        gemwd: mutable i64 = 0
        gemsk: mutable i64 = 0
        if resolved_has_osv:
            _ = Package::rh_osv_match(gempkgs, gempool, osv_nodes, osv_texts, osv_root, gemfind, &gemwd, &gemsk)
        gemartifacts: mutable darray[Package::RhArtifact] = []
        _ = Package::rh_artifacts_from_packages(gempkgs, gemartifacts)
        geg: mutable darray[u8] = []
        Package::rh_graph_write_json(geg, 4, gempkgs, gempool, gemartifacts, gemedges, gemunres, gemfind, osv_texts, gemroot)
        geg.push(10)
        gef: mutable darray[u8] = []
        if not rh_out_path(out, "deps-rubygems-graph.json", gef):
            rh_cli_err("deps: cannot stage rubygems graph path")
            return 4
        gefp: cstr = (&gef[0]).cast[cstr] can Unsafe.PointerCast
        if not Base::rh_io_write(gefp, geg):
            rh_cli_err("deps: cannot write rubygems graph")
            return 4
        eco_codes.push(4)
        declared.push(gemreqs.count.i64())
        resolved.push(gemedges.count.i64())
        unresolved_n.push(gemunres.count.i64())
        unsupported_n.push(gemunsup)
        direct_declared_n.push(Package::rh_direct_requirement_count(gemreqs, gemroot))
        direct_resolved_n.push(Package::rh_direct_resolved_count(gemedges, gemroot))
        direct_unresolved_n.push(Package::rh_direct_unresolved_count(gemunres, gemroot))
        transitive_resolved_n.push(Package::rh_reachable_dependency_count(gemedges, gempkgs.count.i64(), gemroot))
        runtime_requirements_n.push(Package::rh_scope_count(gemreqs, Package::RH_SCOPE_NORMAL))
        development_requirements_n.push(Package::rh_scope_count(gemreqs, Package::RH_SCOPE_DEV))
        optional_requirements_n.push(Package::rh_scope_count(gemreqs, Package::RH_SCOPE_OPTIONAL))
        peer_requirements_n.push(Package::rh_scope_count(gemreqs, Package::RH_SCOPE_PEER))
        unknown_scope_requirements_n.push(Package::rh_scope_count(gemreqs, Package::RH_SCOPE_DECLARED))
        runtime_direct_n.push(Package::rh_direct_scope_count(gemreqs, gemroot, Package::RH_SCOPE_NORMAL))
        build_direct_n.push(Package::rh_direct_scope_count(gemreqs, gemroot, Package::RH_SCOPE_DEV))
        optional_direct_n.push(Package::rh_direct_scope_count(gemreqs, gemroot, Package::RH_SCOPE_OPTIONAL))
        unknown_scope_direct_n.push(Package::rh_direct_scope_count(gemreqs, gemroot, Package::RH_SCOPE_DECLARED))
        unpinned_n.push(Package::rh_unpinned_requirement_count(gemreqs, gempool))
        digest_known_n.push(Package::rh_resolved_node_metric_count(gempkgs, gemedges, true))
        digest_total_n.push(Package::rh_resolved_node_metric_count(gempkgs, gemedges, false))
        maximum_depth_n.push(Package::rh_max_dependency_depth(gemedges, gempkgs.count.i64(), gemroot))
        resolution_complete_n.push(1 if Package::rh_resolution_complete(gemedges, gemunres, gempkgs.count.i64(), gemroot) else 0)
        node_count_n.push(gempkgs.count.i64())
        edge_count_n.push(gemedges.count.i64())
        advisory_unknown_nodes_n.push(Package::rh_advisory_unknown_node_count(gempkgs, gemedges) if resolved_has_osv else -1)
        fixed_version_available_n.push(1 if resolved_has_osv and Package::rh_fixed_version_available(gemfind) else 0 if resolved_has_osv else -1)
        runtime_edges_n.push(Package::rh_edge_scope_count(gemedges, Package::RH_SCOPE_NORMAL))
        development_edges_n.push(Package::rh_edge_scope_count(gemedges, Package::RH_SCOPE_DEV))
        optional_edges_n.push(Package::rh_edge_scope_count(gemedges, Package::RH_SCOPE_OPTIONAL))
        peer_edges_n.push(Package::rh_edge_scope_count(gemedges, Package::RH_SCOPE_PEER))
        unknown_scope_edges_n.push(Package::rh_edge_scope_count(gemedges, Package::RH_SCOPE_DECLARED))
        advisories_n.push(gemfind.count.i64() if resolved_has_osv else -1)
        advisory_records_n.push(Package::rh_advisory_record_count(gemfind) if resolved_has_osv else -1)
        affected_nodes_n.push(Package::rh_advisory_node_count(gemfind) if resolved_has_osv else -1)
        affected_direct_nodes_n.push(Package::rh_advisory_scope_count(gemfind, gemedges, gemroot, gempkgs.count.i64(), 0) if resolved_has_osv else -1)
        affected_transitive_nodes_n.push(Package::rh_advisory_scope_count(gemfind, gemedges, gemroot, gempkgs.count.i64(), 1) if resolved_has_osv else -1)
        affected_unreachable_nodes_n.push(Package::rh_advisory_scope_count(gemfind, gemedges, gemroot, gempkgs.count.i64(), 2) if resolved_has_osv else -1)
        withdrawn_n.push(gemwd if resolved_has_osv else -1)
        found <- found + 1

    # --- composer.lock (Composer/Packagist) ---
    cl2: mutable darray[u8] = []
    if not rh_out_path(repo, "composer.lock", cl2):
        rh_cli_err("deps: bad repo path")
        return 3
    cl2p: cstr = (&cl2[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(cl2p):
        cpb: mutable darray[u8] = []
        if Base::rh_io_read(cl2p, cpb) < 0:
            rh_cli_err("deps: cannot read composer.lock")
            return 4
        cjnodes: mutable darray[Json::RhJsonNode] = []
        cjtexts: mutable darray[u8] = []
        cproot2: i64 = Json::rh_json_parse(cpb, cjnodes, cjtexts)
        if cproot2 < 0:
            rh_cli_err("deps: malformed composer.lock (structured failure, no partial graph)")
            return 4
        cppkgs: mutable darray[Package::RhPkgNode] = []
        cppool: mutable darray[u8] = []
        cpreqs: mutable darray[Package::RhRequire] = []
        cpedges: mutable darray[Package::RhDepEdge] = []
        cpunres: mutable darray[Package::RhUnresolved] = []
        cproot3: i64 = |cpb, cjnodes, cjtexts, cppkgs, cppool, cpreqs, cpedges, cpunres|
            cpunk: mutable i64 = 0
            block_result: i64 = Package::rh_composer_parse(cpb, cjnodes, cjtexts, cppkgs, cppool, cpreqs, cpedges, cpunres, &cpunk)
            block_result
        if cproot3 < 0:
            rh_cli_err("deps: malformed composer.lock (structured failure, no partial graph)")
            return 4
        cpunsup: i64 = Package::rh_unsupported_range_count(cpreqs, cppool)
        cpfind: mutable darray[Package::RhAdvisory] = []
        cpwd: mutable i64 = 0
        cpsk: mutable i64 = 0
        if resolved_has_osv:
            _ = Package::rh_osv_match(cppkgs, cppool, osv_nodes, osv_texts, osv_root, cpfind, &cpwd, &cpsk)
        cpartifacts: mutable darray[Package::RhArtifact] = []
        _ = Package::rh_artifacts_from_packages(cppkgs, cpartifacts)
        cpg: mutable darray[u8] = []
        Package::rh_graph_write_json(cpg, 5, cppkgs, cppool, cpartifacts, cpedges, cpunres, cpfind, osv_texts, cproot3)
        cpg.push(10)
        cpf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-composer-graph.json", cpf):
            rh_cli_err("deps: cannot stage composer graph path")
            return 4
        cpfp: cstr = (&cpf[0]).cast[cstr] can Unsafe.PointerCast
        if not Base::rh_io_write(cpfp, cpg):
            rh_cli_err("deps: cannot write composer graph")
            return 4
        eco_codes.push(5)
        declared.push(cpreqs.count.i64())
        resolved.push(cpedges.count.i64())
        unresolved_n.push(cpunres.count.i64())
        unsupported_n.push(cpunsup)
        direct_declared_n.push(Package::rh_direct_requirement_count(cpreqs, cproot3))
        direct_resolved_n.push(Package::rh_direct_resolved_count(cpedges, cproot3))
        direct_unresolved_n.push(Package::rh_direct_unresolved_count(cpunres, cproot3))
        transitive_resolved_n.push(Package::rh_reachable_dependency_count(cpedges, cppkgs.count.i64(), cproot3))
        runtime_requirements_n.push(Package::rh_scope_count(cpreqs, Package::RH_SCOPE_NORMAL))
        development_requirements_n.push(Package::rh_scope_count(cpreqs, Package::RH_SCOPE_DEV))
        optional_requirements_n.push(Package::rh_scope_count(cpreqs, Package::RH_SCOPE_OPTIONAL))
        peer_requirements_n.push(Package::rh_scope_count(cpreqs, Package::RH_SCOPE_PEER))
        unknown_scope_requirements_n.push(Package::rh_scope_count(cpreqs, Package::RH_SCOPE_DECLARED))
        runtime_direct_n.push(Package::rh_direct_scope_count(cpreqs, cproot3, Package::RH_SCOPE_NORMAL))
        build_direct_n.push(Package::rh_direct_scope_count(cpreqs, cproot3, Package::RH_SCOPE_DEV))
        optional_direct_n.push(Package::rh_direct_scope_count(cpreqs, cproot3, Package::RH_SCOPE_OPTIONAL))
        unknown_scope_direct_n.push(Package::rh_direct_scope_count(cpreqs, cproot3, Package::RH_SCOPE_DECLARED))
        unpinned_n.push(Package::rh_unpinned_requirement_count(cpreqs, cppool))
        digest_known_n.push(Package::rh_resolved_node_metric_count(cppkgs, cpedges, true))
        digest_total_n.push(Package::rh_resolved_node_metric_count(cppkgs, cpedges, false))
        maximum_depth_n.push(Package::rh_max_dependency_depth(cpedges, cppkgs.count.i64(), cproot3))
        resolution_complete_n.push(1 if Package::rh_resolution_complete(cpedges, cpunres, cppkgs.count.i64(), cproot3) else 0)
        node_count_n.push(cppkgs.count.i64())
        edge_count_n.push(cpedges.count.i64())
        advisory_unknown_nodes_n.push(Package::rh_advisory_unknown_node_count(cppkgs, cpedges) if resolved_has_osv else -1)
        fixed_version_available_n.push(1 if resolved_has_osv and Package::rh_fixed_version_available(cpfind) else 0 if resolved_has_osv else -1)
        runtime_edges_n.push(Package::rh_edge_scope_count(cpedges, Package::RH_SCOPE_NORMAL))
        development_edges_n.push(Package::rh_edge_scope_count(cpedges, Package::RH_SCOPE_DEV))
        optional_edges_n.push(Package::rh_edge_scope_count(cpedges, Package::RH_SCOPE_OPTIONAL))
        peer_edges_n.push(Package::rh_edge_scope_count(cpedges, Package::RH_SCOPE_PEER))
        unknown_scope_edges_n.push(Package::rh_edge_scope_count(cpedges, Package::RH_SCOPE_DECLARED))
        advisories_n.push(cpfind.count.i64() if resolved_has_osv else -1)
        advisory_records_n.push(Package::rh_advisory_record_count(cpfind) if resolved_has_osv else -1)
        affected_nodes_n.push(Package::rh_advisory_node_count(cpfind) if resolved_has_osv else -1)
        affected_direct_nodes_n.push(Package::rh_advisory_scope_count(cpfind, cpedges, cproot3, cppkgs.count.i64(), 0) if resolved_has_osv else -1)
        affected_transitive_nodes_n.push(Package::rh_advisory_scope_count(cpfind, cpedges, cproot3, cppkgs.count.i64(), 1) if resolved_has_osv else -1)
        affected_unreachable_nodes_n.push(Package::rh_advisory_scope_count(cpfind, cpedges, cproot3, cppkgs.count.i64(), 2) if resolved_has_osv else -1)
        withdrawn_n.push(cpwd if resolved_has_osv else -1)
        found <- found + 1

    # --- packages.lock.json / packages.config (NuGet) ---
    ncfg: mutable darray[u8] = []
    if not rh_out_path(repo, "packages.config", ncfg):
        rh_cli_err("deps: bad repo path")
        return 3
    ncfgp: cstr = (&ncfg[0]).cast[cstr] can Unsafe.PointerCast
    nu_lock: mutable darray[u8] = []
    if not rh_out_path(repo, "packages.lock.json", nu_lock):
        rh_cli_err("deps: bad repo path")
        return 3
    nu_lock_ptr: cstr = (&nu_lock[0]).cast[cstr] can Unsafe.PointerCast
    nu_config_exists: bool = file_exists(ncfgp)
    nu_lock_exists: bool = file_exists(nu_lock_ptr)
    if nu_config_exists and nu_lock_exists:
        rh_cli_err("deps: packages.config and packages.lock.json are both present; choose one NuGet source")
        return 4
    if nu_config_exists or nu_lock_exists:
        nb: mutable darray[u8] = []
        nu_source: cstr = nu_lock_ptr if nu_lock_exists else ncfgp
        if Base::rh_io_read(nu_source, nb) < 0:
            rh_cli_err("deps: cannot read NuGet dependency file")
            return 4
        nupkgs: mutable darray[Package::RhPkgNode] = []
        nupool: mutable darray[u8] = []
        nureqs: mutable darray[Package::RhRequire] = []
        nuedges: mutable darray[Package::RhDepEdge] = []
        nuunres: mutable darray[Package::RhUnresolved] = []
        nuartifacts: mutable darray[Package::RhArtifact] = []
        nuroot: i64 = |nb, nupkgs, nupool, nureqs, nuedges, nuunres, nuartifacts|
            block_result: mutable i64 = -1
            if nu_lock_exists:
                block_result <- NugetLock::rh_nuget_lock_parse(nb, nupkgs, nupool, nureqs, nuedges, nuunres, nuartifacts)
            else:
                nunk: mutable i64 = 0
                block_result <- Package::rh_nuget_parse(nb, nupkgs, nupool, nureqs, nuedges, nuunres, &nunk)
            block_result
        if nuroot < 0:
            if nu_lock_exists:
                rh_cli_err("deps: malformed packages.lock.json (unsupported NuGet lock subset or structured failure; no partial graph)")
            else:
                rh_cli_err("deps: malformed packages.config (structured failure, no partial graph)")
            return 4
        nuunsup: i64 = Package::rh_unsupported_range_count(nureqs, nupool)
        nufind: mutable darray[Package::RhAdvisory] = []
        nuwd: mutable i64 = 0
        nusk: mutable i64 = 0
        if resolved_has_osv:
            _ = Package::rh_osv_match(nupkgs, nupool, osv_nodes, osv_texts, osv_root, nufind, &nuwd, &nusk)
        if not nu_lock_exists:
            _ = Package::rh_artifacts_from_packages(nupkgs, nuartifacts)
        nug: mutable darray[u8] = []
        Package::rh_graph_write_json(nug, 6, nupkgs, nupool, nuartifacts, nuedges, nuunres, nufind, osv_texts, nuroot)
        nug.push(10)
        nuf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-nuget-graph.json", nuf):
            rh_cli_err("deps: cannot stage nuget graph path")
            return 4
        nufp: cstr = (&nuf[0]).cast[cstr] can Unsafe.PointerCast
        if not Base::rh_io_write(nufp, nug):
            rh_cli_err("deps: cannot write nuget graph")
            return 4
        eco_codes.push(8 if nu_lock_exists else 6)
        declared.push(nureqs.count.i64())
        resolved.push(nuedges.count.i64())
        unresolved_n.push(nuunres.count.i64())
        unsupported_n.push(nuunsup)
        direct_declared_n.push(Package::rh_direct_requirement_count(nureqs, nuroot))
        direct_resolved_n.push(Package::rh_direct_resolved_count(nuedges, nuroot))
        direct_unresolved_n.push(Package::rh_direct_unresolved_count(nuunres, nuroot))
        transitive_resolved_n.push(Package::rh_reachable_dependency_count(nuedges, nupkgs.count.i64(), nuroot))
        runtime_requirements_n.push(Package::rh_scope_count(nureqs, Package::RH_SCOPE_NORMAL))
        development_requirements_n.push(Package::rh_scope_count(nureqs, Package::RH_SCOPE_DEV))
        optional_requirements_n.push(Package::rh_scope_count(nureqs, Package::RH_SCOPE_OPTIONAL))
        peer_requirements_n.push(Package::rh_scope_count(nureqs, Package::RH_SCOPE_PEER))
        unknown_scope_requirements_n.push(Package::rh_scope_count(nureqs, Package::RH_SCOPE_DECLARED))
        runtime_direct_n.push(Package::rh_direct_scope_count(nureqs, nuroot, Package::RH_SCOPE_NORMAL))
        build_direct_n.push(Package::rh_direct_scope_count(nureqs, nuroot, Package::RH_SCOPE_DEV))
        optional_direct_n.push(Package::rh_direct_scope_count(nureqs, nuroot, Package::RH_SCOPE_OPTIONAL))
        unknown_scope_direct_n.push(Package::rh_direct_scope_count(nureqs, nuroot, Package::RH_SCOPE_DECLARED))
        unpinned_n.push(Package::rh_unpinned_requirement_count(nureqs, nupool))
        digest_known_n.push(Package::rh_resolved_node_metric_count(nupkgs, nuedges, true))
        digest_total_n.push(Package::rh_resolved_node_metric_count(nupkgs, nuedges, false))
        maximum_depth_n.push(Package::rh_max_dependency_depth(nuedges, nupkgs.count.i64(), nuroot))
        resolution_complete_n.push(1 if Package::rh_resolution_complete(nuedges, nuunres, nupkgs.count.i64(), nuroot) else 0)
        node_count_n.push(nupkgs.count.i64())
        edge_count_n.push(nuedges.count.i64())
        advisory_unknown_nodes_n.push(Package::rh_advisory_unknown_node_count(nupkgs, nuedges) if resolved_has_osv else -1)
        fixed_version_available_n.push(1 if resolved_has_osv and Package::rh_fixed_version_available(nufind) else 0 if resolved_has_osv else -1)
        runtime_edges_n.push(Package::rh_edge_scope_count(nuedges, Package::RH_SCOPE_NORMAL))
        development_edges_n.push(Package::rh_edge_scope_count(nuedges, Package::RH_SCOPE_DEV))
        optional_edges_n.push(Package::rh_edge_scope_count(nuedges, Package::RH_SCOPE_OPTIONAL))
        peer_edges_n.push(Package::rh_edge_scope_count(nuedges, Package::RH_SCOPE_PEER))
        unknown_scope_edges_n.push(Package::rh_edge_scope_count(nuedges, Package::RH_SCOPE_DECLARED))
        advisories_n.push(nufind.count.i64() if resolved_has_osv else -1)
        advisory_records_n.push(Package::rh_advisory_record_count(nufind) if resolved_has_osv else -1)
        affected_nodes_n.push(Package::rh_advisory_node_count(nufind) if resolved_has_osv else -1)
        affected_direct_nodes_n.push(Package::rh_advisory_scope_count(nufind, nuedges, nuroot, nupkgs.count.i64(), 0) if resolved_has_osv else -1)
        affected_transitive_nodes_n.push(Package::rh_advisory_scope_count(nufind, nuedges, nuroot, nupkgs.count.i64(), 1) if resolved_has_osv else -1)
        affected_unreachable_nodes_n.push(Package::rh_advisory_scope_count(nufind, nuedges, nuroot, nupkgs.count.i64(), 2) if resolved_has_osv else -1)
        withdrawn_n.push(nuwd if resolved_has_osv else -1)
        found <- found + 1

    # --- pom.xml (Maven) ---
    pom: mutable darray[u8] = []
    if not rh_out_path(repo, "pom.xml", pom):
        rh_cli_err("deps: bad repo path")
        return 3
    pomp: cstr = (&pom[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(pomp):
        pomb: mutable darray[u8] = []
        if Base::rh_io_read(pomp, pomb) < 0:
            rh_cli_err("deps: cannot read pom.xml")
            return 4
        mpkgs: mutable darray[Package::RhPkgNode] = []
        mpool: mutable darray[u8] = []
        mreqs: mutable darray[Package::RhRequire] = []
        medges: mutable darray[Package::RhDepEdge] = []
        munres: mutable darray[Package::RhUnresolved] = []
        mroot: i64 = |pomb, mpkgs, mpool, mreqs, medges, munres|
            munk: mutable i64 = 0
            block_result: i64 = Package::rh_maven_parse(pomb, mpkgs, mpool, mreqs, medges, munres, &munk)
            block_result
        if mroot < 0:
            rh_cli_err("deps: malformed pom.xml bounded Maven subset (structured failure, no partial graph)")
            return 4
        munsup: i64 = Package::rh_unsupported_range_count(mreqs, mpool)
        mfind: mutable darray[Package::RhAdvisory] = []
        mwd: mutable i64 = 0
        msk: mutable i64 = 0
        if resolved_has_osv:
            _ = Package::rh_osv_match(mpkgs, mpool, osv_nodes, osv_texts, osv_root, mfind, &mwd, &msk)
        martifacts: mutable darray[Package::RhArtifact] = []
        _ = Package::rh_artifacts_from_packages(mpkgs, martifacts)
        mg: mutable darray[u8] = []
        Package::rh_graph_write_json(mg, 7, mpkgs, mpool, martifacts, medges, munres, mfind, osv_texts, mroot)
        mg.push(10)
        mf2: mutable darray[u8] = []
        if not rh_out_path(out, "deps-maven-graph.json", mf2):
            rh_cli_err("deps: cannot stage maven graph path")
            return 4
        mf2p: cstr = (&mf2[0]).cast[cstr] can Unsafe.PointerCast
        if not Base::rh_io_write(mf2p, mg):
            rh_cli_err("deps: cannot write maven graph")
            return 4
        eco_codes.push(7)
        declared.push(mreqs.count.i64())
        resolved.push(medges.count.i64())
        unresolved_n.push(munres.count.i64())
        unsupported_n.push(munsup)
        direct_declared_n.push(Package::rh_direct_requirement_count(mreqs, mroot))
        direct_resolved_n.push(Package::rh_direct_resolved_count(medges, mroot))
        direct_unresolved_n.push(Package::rh_direct_unresolved_count(munres, mroot))
        transitive_resolved_n.push(Package::rh_reachable_dependency_count(medges, mpkgs.count.i64(), mroot))
        runtime_requirements_n.push(Package::rh_scope_count(mreqs, Package::RH_SCOPE_NORMAL))
        development_requirements_n.push(Package::rh_scope_count(mreqs, Package::RH_SCOPE_DEV))
        optional_requirements_n.push(Package::rh_scope_count(mreqs, Package::RH_SCOPE_OPTIONAL))
        peer_requirements_n.push(Package::rh_scope_count(mreqs, Package::RH_SCOPE_PEER))
        unknown_scope_requirements_n.push(Package::rh_scope_count(mreqs, Package::RH_SCOPE_DECLARED))
        runtime_direct_n.push(Package::rh_direct_scope_count(mreqs, mroot, Package::RH_SCOPE_NORMAL))
        build_direct_n.push(Package::rh_direct_scope_count(mreqs, mroot, Package::RH_SCOPE_DEV))
        optional_direct_n.push(Package::rh_direct_scope_count(mreqs, mroot, Package::RH_SCOPE_OPTIONAL))
        unknown_scope_direct_n.push(Package::rh_direct_scope_count(mreqs, mroot, Package::RH_SCOPE_DECLARED))
        unpinned_n.push(Package::rh_unpinned_requirement_count(mreqs, mpool))
        digest_known_n.push(Package::rh_resolved_node_metric_count(mpkgs, medges, true))
        digest_total_n.push(Package::rh_resolved_node_metric_count(mpkgs, medges, false))
        maximum_depth_n.push(Package::rh_max_dependency_depth(medges, mpkgs.count.i64(), mroot))
        resolution_complete_n.push(1 if Package::rh_resolution_complete(medges, munres, mpkgs.count.i64(), mroot) else 0)
        node_count_n.push(mpkgs.count.i64())
        edge_count_n.push(medges.count.i64())
        advisory_unknown_nodes_n.push(Package::rh_advisory_unknown_node_count(mpkgs, medges) if resolved_has_osv else -1)
        fixed_version_available_n.push(1 if resolved_has_osv and Package::rh_fixed_version_available(mfind) else 0 if resolved_has_osv else -1)
        runtime_edges_n.push(Package::rh_edge_scope_count(medges, Package::RH_SCOPE_NORMAL))
        development_edges_n.push(Package::rh_edge_scope_count(medges, Package::RH_SCOPE_DEV))
        optional_edges_n.push(Package::rh_edge_scope_count(medges, Package::RH_SCOPE_OPTIONAL))
        peer_edges_n.push(Package::rh_edge_scope_count(medges, Package::RH_SCOPE_PEER))
        unknown_scope_edges_n.push(Package::rh_edge_scope_count(medges, Package::RH_SCOPE_DECLARED))
        advisories_n.push(mfind.count.i64() if resolved_has_osv else -1)
        advisory_records_n.push(Package::rh_advisory_record_count(mfind) if resolved_has_osv else -1)
        affected_nodes_n.push(Package::rh_advisory_node_count(mfind) if resolved_has_osv else -1)
        affected_direct_nodes_n.push(Package::rh_advisory_scope_count(mfind, medges, mroot, mpkgs.count.i64(), 0) if resolved_has_osv else -1)
        affected_transitive_nodes_n.push(Package::rh_advisory_scope_count(mfind, medges, mroot, mpkgs.count.i64(), 1) if resolved_has_osv else -1)
        affected_unreachable_nodes_n.push(Package::rh_advisory_scope_count(mfind, medges, mroot, mpkgs.count.i64(), 2) if resolved_has_osv else -1)
        withdrawn_n.push(mwd if resolved_has_osv else -1)
        found <- found + 1

    if found == 0:
        rh_cli_err("deps: no supported dependency manifest found in repo")
        return 4
    mf: mutable darray[u8] = []
    if not rh_out_path(out, "deps-metrics.json", mf):
        rh_cli_err("deps: cannot stage metrics path")
        return 4
    mb: mutable darray[u8] = []
    Package::rh_deps_metrics_emit(mb, eco_codes, declared, resolved, unresolved_n, unsupported_n, direct_declared_n, direct_resolved_n, direct_unresolved_n, transitive_resolved_n, runtime_requirements_n, development_requirements_n, optional_requirements_n, peer_requirements_n, unknown_scope_requirements_n, runtime_direct_n, build_direct_n, optional_direct_n, unknown_scope_direct_n, unpinned_n, digest_known_n, digest_total_n, maximum_depth_n, resolution_complete_n, node_count_n, edge_count_n, advisory_unknown_nodes_n, fixed_version_available_n, runtime_edges_n, development_edges_n, optional_edges_n, peer_edges_n, unknown_scope_edges_n, advisories_n, advisory_records_n, affected_nodes_n, affected_direct_nodes_n, affected_transitive_nodes_n, affected_unreachable_nodes_n, withdrawn_n)
    mb.push(10)
    mfp: cstr = (&mf[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(mfp, mb):
        rh_cli_err("deps: cannot write deps-metrics.json")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        Base::rh_push_text(done, "deps: ecosystems=")
        Base::rh_push_decimal_i64(done, found)
        done
    while i < eco_codes.count.i64() |i: i64 = 0, eco_codes, declared, resolved, unresolved_n, unsupported_n, done|:
        Base::rh_push_text(done, " ")
        Base::rh_push_text(done, Package::rh_deps_eco(eco_codes[i.usize()]))
        Base::rh_push_text(done, "=")
        Base::rh_push_decimal_i64(done, resolved[i.usize()])
        Base::rh_push_text(done, "/")
        Base::rh_push_decimal_i64(done, declared[i.usize()])
        Base::rh_push_text(done, " unresolved=")
        Base::rh_push_decimal_i64(done, unresolved_n[i.usize()])
        Base::rh_push_text(done, " unsupported=")
        Base::rh_push_decimal_i64(done, unsupported_n[i.usize()])
        i <- i + 1
    done.push(10)
    Base::rh_write_stdout(done)
    0

module OsvQueryCli:
    private:
        def rh_osv_page_name(page: i64, kind: i64, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if page < 1 or page > OsvQuery::RH_OSV_QUERY_MAX_PAGES or kind < 0 or kind > 3
            if page == 1:
                Base::rh_push_text(out, "osv-query-request.json") if kind == 0
                Base::rh_push_text(out, "osv-query-response.raw.json") if kind == 1
                Base::rh_push_text(out, "osv-query-http-status.txt") if kind == 2
                Base::rh_push_text(out, "osv-query.err") if kind == 3
                return true
            Base::rh_push_text(out, "osv-query-page-")
            Base::rh_push_decimal_i64(out, page)
            if kind == 0:
                Base::rh_push_text(out, "-request.json")
            elif kind == 1:
                Base::rh_push_text(out, "-response.raw.json")
            elif kind == 2:
                Base::rh_push_text(out, "-http-status.txt")
            else:
                Base::rh_push_text(out, ".err")
            true

        def rh_osv_page_path(dir: cstr, name: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return false if Base::rh_cstr_len_c(dir) == 0 or name.count == 0
            Base::rh_push_cstr(out, dir)
            out.push(47)
            out.extend(bytes_view(name))
            out.push(0)
            true
        def rh_osv_output_path(dir: cstr, name: u8&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if Base::rh_cstr_len_c(dir) == 0
            Base::rh_push_cstr(out, dir)
            out.push(47)
            Base::rh_push_text(out, name)
            out.push(0)
            true

        def rh_osv_batch_page_name(page: i64, kind: i64, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if page < 1 or page > OsvQuery::RH_OSV_QUERY_MAX_PAGES or kind < 0 or kind > 3
            if page == 1:
                Base::rh_push_text(out, "osv-query-batch-request.json") if kind == 0
                Base::rh_push_text(out, "osv-query-batch-response.raw.json") if kind == 1
                Base::rh_push_text(out, "osv-query-batch-http-status.txt") if kind == 2
                Base::rh_push_text(out, "osv-query-batch.err") if kind == 3
                return true
            Base::rh_push_text(out, "osv-query-batch-page-")
            Base::rh_push_decimal_i64(out, page)
            Base::rh_push_text(out, "-request.json") if kind == 0
            Base::rh_push_text(out, "-response.raw.json") if kind == 1
            Base::rh_push_text(out, "-http-status.txt") if kind == 2
            Base::rh_push_text(out, ".err") if kind == 3
            true

        def rh_osv_query_append_batch_page_evidence(page: i64, page_hash: darray[u8]&, query_indices: darray[i64]&, evidence: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            request_name: mutable darray[u8] = []
            raw_name: mutable darray[u8] = []
            status_name: mutable darray[u8] = []
            error_name: mutable darray[u8] = []
            return false if not rh_osv_batch_page_name(page, 0, request_name)
            return false if not rh_osv_batch_page_name(page, 1, raw_name)
            return false if not rh_osv_batch_page_name(page, 2, status_name)
            return false if not rh_osv_batch_page_name(page, 3, error_name)
            evidence.push(44) if page > 1
            Base::rh_push_text(evidence, "{\"page\":")
            Base::rh_push_decimal_i64(evidence, page)
            Base::rh_push_text(evidence, ",\"request_file\":\"")
            evidence.extend(bytes_view(request_name))
            Base::rh_push_text(evidence, "\",\"raw_response_file\":\"")
            evidence.extend(bytes_view(raw_name))
            Base::rh_push_text(evidence, "\",\"http_status_file\":\"")
            evidence.extend(bytes_view(status_name))
            Base::rh_push_text(evidence, "\",\"stderr_file\":\"")
            evidence.extend(bytes_view(error_name))
            Base::rh_push_text(evidence, "\",\"raw_response_sha256\":\"")
            evidence.extend(bytes_view(page_hash))
            Base::rh_push_text(evidence, "\",\"query_indexes\":[")
            while i < query_indices.count.i64() |i: i64 = 0, query_indices, evidence|:
                evidence.push(44) if i > 0
                Base::rh_push_decimal_i64(evidence, query_indices[i.usize()])
                i <- i + 1
            Base::rh_push_text(evidence, "]}")
            true

        def rh_osv_advisory_name(index: i64, kind: i64, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if index < 1 or index > OsvQuery::RH_OSV_QUERY_MAX_HYDRATED_IDS or kind < 0 or kind > 3
            Base::rh_push_text(out, "osv-query-advisory-")
            Base::rh_push_decimal_i64(out, index)
            Base::rh_push_text(out, "-request.json") if kind == 0
            Base::rh_push_text(out, "-response.raw.json") if kind == 1
            Base::rh_push_text(out, "-http-status.txt") if kind == 2
            Base::rh_push_text(out, ".err") if kind == 3
            true

        def rh_osv_hydration_time_remaining(started_at: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            now: i64 = Base::rh_now()
            return false if started_at < 0 or now < started_at
            now - started_at < OsvQuery::RH_OSV_QUERY_MAX_HYDRATED_SECS

        # Hydrate distinct IDs returned by the retained batch pages. The page
        # responses remain the source evidence; full records are independently
        # fetched, ID-checked, byte-bounded, and assembled only from successes.
        def rh_osv_query_hydrate_batch_pages(out: cstr, page_count: i64, matcher_response_out: mutable darray[u8]&, evidence_out: mutable darray[u8]&, hydrated_count_out: mutable i64&, invalid_count_out: mutable i64&, omitted_count_out: mutable i64&, failure_count_out: mutable i64&, state_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            hydrated_count_out[0] <- 0
            invalid_count_out[0] <- 0
            omitted_count_out[0] <- 0
            failure_count_out[0] <- 0
            state_out[0] <- 0
            id_bytes: mutable darray[u8] = []
            id_starts: mutable darray[i64] = []
            id_lengths: mutable darray[i64] = []
            while page <= page_count |page: i64 = 1, page_count, out, id_bytes, id_starts, id_lengths, invalid_count_out, omitted_count_out|:
                raw_name: mutable darray[u8] = []
                return 4 if not rh_osv_batch_page_name(page, 1, raw_name)
                raw_path: mutable darray[u8] = []
                return 4 if not rh_osv_page_path(out, raw_name, raw_path)
                raw_ptr: cstr = (&raw_path[0]).cast[cstr] can Unsafe.PointerCast
                raw_size: i64 = Base::rh_file_size(raw_ptr)
                if raw_size <= 0 or raw_size > Git::RH_FETCH_MAX_BYTES:
                    rh_osv_query_err("osv-query: retained batch page is missing or exceeds its read bound during hydration")
                    return 4
                raw_response: mutable darray[u8] = []
                return 4 if Base::rh_io_read(raw_ptr, raw_response) != raw_size
                invalid_page: mutable i64 = 0
                omitted_page: mutable i64 = 0
                if OsvQuery::rh_osv_query_collect_batch_ids(raw_response, id_bytes, id_starts, id_lengths, &invalid_page, &omitted_page) != 0:
                    rh_osv_query_err("osv-query: cannot collect bounded IDs from retained batch response")
                    return 4
                invalid_count_out[0] <- invalid_count_out[0] + invalid_page
                omitted_count_out[0] <- omitted_count_out[0] + omitted_page
                page <- page + 1
            Base::rh_push_text(matcher_response_out, "{\"vulns\":[")
            evidence_out.push(91)
            attempted: mutable i64 = 0
            processed: mutable i64 = 0
            body_bytes: mutable i64 = 0
            stopped: mutable bool = false
            hydration_started_at: i64 = Base::rh_now()
            while id_index < id_starts.count.i64() and not stopped and rh_osv_hydration_time_remaining(hydration_started_at) |id_index: i64 = 0, id_starts, id_lengths, id_bytes, out, matcher_response_out, evidence_out, attempted, processed, body_bytes, hydrated_count_out, invalid_count_out, omitted_count_out, failure_count_out, stopped|:
                request_name: mutable darray[u8] = []
                response_name: mutable darray[u8] = []
                status_name: mutable darray[u8] = []
                error_name: mutable darray[u8] = []
                return 4 if not rh_osv_advisory_name((id_index + 1), 0, request_name)
                return 4 if not rh_osv_advisory_name((id_index + 1), 1, response_name)
                return 4 if not rh_osv_advisory_name((id_index + 1), 2, status_name)
                return 4 if not rh_osv_advisory_name((id_index + 1), 3, error_name)
                request_path: mutable darray[u8] = []
                response_path: mutable darray[u8] = []
                status_path: mutable darray[u8] = []
                error_path: mutable darray[u8] = []
                return 4 if not rh_osv_page_path(out, request_name, request_path)
                return 4 if not rh_osv_page_path(out, response_name, response_path)
                return 4 if not rh_osv_page_path(out, status_name, status_path)
                return 4 if not rh_osv_page_path(out, error_name, error_path)
                request_ptr: cstr = (&request_path[0]).cast[cstr] can Unsafe.PointerCast
                response_ptr: cstr = (&response_path[0]).cast[cstr] can Unsafe.PointerCast
                status_ptr: cstr = (&status_path[0]).cast[cstr] can Unsafe.PointerCast
                error_ptr: cstr = (&error_path[0]).cast[cstr] can Unsafe.PointerCast
                advisory_id: mutable darray[u8] = []
                id_start: i64 = id_starts[id_index.usize()]
                id_length: i64 = id_lengths[id_index.usize()]
                id_end: i64 = id_start + id_length
                while copy_id < id_end |copy_id: i64 = id_start, id_end, id_bytes, advisory_id|:
                    advisory_id.push(id_bytes[copy_id.usize()])
                    copy_id <- copy_id + 1
                request: mutable darray[u8] = []
                Base::rh_push_text(request, "{\"id\":\"")
                request.extend(bytes_view(advisory_id))
                Base::rh_push_text(request, "\",\"endpoint\":\"https://api.osv.dev/v1/vulns/")
                request.extend(bytes_view(advisory_id))
                Base::rh_push_text(request, "\"}\n")
                if not Base::rh_io_write(request_ptr, request):
                    rh_osv_query_err("osv-query: cannot retain advisory hydration request")
                    return 4
                transport: i64 = Git::rh_run_osv_vulnerability_get(advisory_id, response_ptr, status_ptr, error_ptr)
                item_state: mutable i64 = 0
                response_hash: mutable darray[u8] = []
                raw_record: mutable darray[u8] = []
                status: mutable darray[u8] = []
                status_read: mutable i64 = -1
                status_read <- Base::rh_io_read(status_ptr, status) if transport == 0
                if transport != 0:
                    item_state <- 1
                    failure_count_out[0] <- failure_count_out[0] + 1
                    stopped <- true
                elif status_read != 3 or status[0] != 50 or status[1] != 48 or status[2] != 48:
                    item_state <- 2
                    failure_count_out[0] <- failure_count_out[0] + 1
                    stopped <- true
                else:
                    response_size: i64 = Base::rh_file_size(response_ptr)
                    if response_size <= 0 or response_size > Git::RH_FETCH_MAX_BYTES:
                        item_state <- 3
                        failure_count_out[0] <- failure_count_out[0] + 1
                        stopped <- true
                    elif Base::rh_io_read(response_ptr, raw_record) != response_size:
                        item_state <- 4
                        failure_count_out[0] <- failure_count_out[0] + 1
                        stopped <- true
                    else:
                        Sha256::rh_sha256(raw_record, response_hash)
                        if body_bytes + response_size > OsvQuery::RH_OSV_QUERY_MAX_HYDRATED_BYTES:
                            item_state <- 5
                            omitted_count_out[0] <- omitted_count_out[0] + 1
                            stopped <- true
                        elif OsvQuery::rh_osv_query_validate_vulnerability(raw_record, id_bytes, id_start, id_length) != 0:
                            item_state <- 6
                            failure_count_out[0] <- failure_count_out[0] + 1
                            stopped <- true
                        else:
                            matcher_response_out.push(44) if hydrated_count_out[0] > 0
                            matcher_response_out.extend(bytes_view(raw_record))
                            body_bytes <- body_bytes + response_size
                            hydrated_count_out[0] <- hydrated_count_out[0] + 1
                evidence_out.push(44) if attempted > 0
                Base::rh_push_text(evidence_out, "{\"id\":\"")
                evidence_out.extend(bytes_view(advisory_id))
                Base::rh_push_text(evidence_out, "\",\"state\":\"")
                Base::rh_push_text(evidence_out, "collected") if item_state == 0
                Base::rh_push_text(evidence_out, "transport_failed") if item_state == 1
                Base::rh_push_text(evidence_out, "http_failed") if item_state == 2
                Base::rh_push_text(evidence_out, "response_size_failed") if item_state == 3
                Base::rh_push_text(evidence_out, "response_read_failed") if item_state == 4
                Base::rh_push_text(evidence_out, "byte_cap") if item_state == 5
                Base::rh_push_text(evidence_out, "record_id_mismatch") if item_state == 6
                Base::rh_push_text(evidence_out, "\",\"request_file\":\"")
                evidence_out.extend(bytes_view(request_name))
                Base::rh_push_text(evidence_out, "\",\"raw_response_file\":\"")
                evidence_out.extend(bytes_view(response_name))
                Base::rh_push_text(evidence_out, "\",\"http_status_file\":\"")
                evidence_out.extend(bytes_view(status_name))
                Base::rh_push_text(evidence_out, "\",\"stderr_file\":\"")
                evidence_out.extend(bytes_view(error_name))
                Base::rh_push_text(evidence_out, "\",\"raw_response_sha256\":")
                if response_hash.count == 64:
                    evidence_out.push(34)
                    evidence_out.extend(bytes_view(response_hash))
                    evidence_out.push(34)
                else:
                    Base::rh_push_text(evidence_out, "null")
                evidence_out.push(125)
                attempted <- attempted + 1
                processed <- id_index + 1
                id_index <- id_index + 1
            if processed < id_starts.count.i64():
                omitted_count_out[0] <- omitted_count_out[0] + (id_starts.count.i64() - processed)
            matcher_response_out.push(93)
            matcher_response_out.push(125)
            evidence_out.push(93)
            state_out[0] <- 2 if invalid_count_out[0] > 0 or omitted_count_out[0] > 0 or failure_count_out[0] > 0
            state_out[0] <- 0 if id_starts.count == 0 and invalid_count_out[0] == 0 and omitted_count_out[0] == 0 and failure_count_out[0] == 0
            state_out[0] <- 1 if id_starts.count > 0 and hydrated_count_out[0] == id_starts.count and invalid_count_out[0] == 0 and omitted_count_out[0] == 0 and failure_count_out[0] == 0
            0

        def rh_osv_query_err(message: u8&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
            buffer: mutable darray[u8] =
                buffer: mutable darray[u8] = []
                Base::rh_push_text(buffer, "rh_cli: ")
                Base::rh_push_text(buffer, message)
                buffer.push(10)
                buffer
            Base::rh_write_stderr(buffer)

        def rh_osv_query_out(message: u8&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
            buffer: mutable darray[u8] =
                buffer: mutable darray[u8] = []
                Base::rh_push_text(buffer, message)
                buffer.push(10)
                buffer
            Base::rh_write_stdout(buffer)

        # Query at most 64 versioned registry coordinates from a canonical
        # graph. Full-record hydration is separately opt-in and remains bounded.
        def rh_do_osv_graph_query_inner(graph_path: cstr, out: cstr, continue_pages: bool, hydrate_advisories: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            if not Git::rh_arg_safe(graph_path) or not Git::rh_arg_safe(out):
                rh_osv_query_err("osv-query: rejected path argument (allowlist)")
                return 3
            if Git::rh_ensure_dir(out) != 0:
                rh_osv_query_err("osv-query: cannot create output directory")
                return 4

            result_path: mutable darray[u8] = []
            return 4 if not rh_osv_output_path(out, "osv-query-batch-result.json", result_path)
            next_request_path: mutable darray[u8] = []
            return 4 if not rh_osv_output_path(out, "osv-query-batch-next-request.json", next_request_path)
            matcher_response_path: mutable darray[u8] = []
            return 4 if not rh_osv_output_path(out, "osv-query-hydrated-response.json", matcher_response_path)
            result_path.push(0)
            next_request_path.push(0)
            matcher_response_path.push(0)
            result_ptr: cstr = (&result_path[0]).cast[cstr] can Unsafe.PointerCast
            next_request_ptr: cstr = (&next_request_path[0]).cast[cstr] can Unsafe.PointerCast
            matcher_response_ptr: cstr = (&matcher_response_path[0]).cast[cstr] can Unsafe.PointerCast
            _ = remove_file(result_ptr)
            _ = remove_file(next_request_ptr)
            _ = remove_file(matcher_response_ptr)
            stale_page: mutable i64 = 1
            while stale_page <= OsvQuery::RH_OSV_QUERY_MAX_PAGES |stale_page|:
                stale_kind: mutable i64 = 0
                while stale_kind < 4 |stale_kind, stale_page|:
                    stale_name: mutable darray[u8] = []
                    return 4 if not rh_osv_batch_page_name(stale_page, stale_kind, stale_name)
                    stale_path: mutable darray[u8] = []
                    return 4 if not rh_osv_page_path(out, stale_name, stale_path)
                    stale_ptr: cstr = (&stale_path[0]).cast[cstr] can Unsafe.PointerCast
                    _ = remove_file(stale_ptr)
                    stale_kind <- stale_kind + 1
                stale_page <- stale_page + 1
            stale_advisory: mutable i64 = 1
            while stale_advisory <= OsvQuery::RH_OSV_QUERY_MAX_HYDRATED_IDS |stale_advisory|:
                stale_kind: mutable i64 = 0
                while stale_kind < 4 |stale_kind, stale_advisory|:
                    stale_name: mutable darray[u8] = []
                    return 4 if not rh_osv_advisory_name(stale_advisory, stale_kind, stale_name)
                    stale_path: mutable darray[u8] = []
                    return 4 if not rh_osv_page_path(out, stale_name, stale_path)
                    stale_ptr: cstr = (&stale_path[0]).cast[cstr] can Unsafe.PointerCast
                    _ = remove_file(stale_ptr)
                    stale_kind <- stale_kind + 1
                stale_advisory <- stale_advisory + 1

            input_size: i64 = Base::rh_file_size(graph_path)
            if input_size <= 0 or input_size > OsvQuery::RH_OSV_QUERY_BATCH_MAX_INPUT:
                rh_osv_query_err("osv-query: graph is empty or exceeds the 4 MiB batch-input bound")
                return 3
            graph_raw: mutable darray[u8] = []
            if Base::rh_io_read(graph_path, graph_raw) != input_size:
                rh_osv_query_err("osv-query: cannot read bounded dependency graph")
                return 4
            request: mutable darray[u8] = []
            query_nodes: mutable darray[u8] = []
            query_count: mutable i64 = 0
            skipped_count: mutable i64 = 0
            omitted_count: mutable i64 = 0
            if OsvQuery::rh_osv_query_build_graph_batch(graph_raw, request, query_nodes, &query_count, &skipped_count, &omitted_count) != 0:
                rh_osv_query_err("osv-query: malformed or unsupported rh-dep-graph/1 input")
                return 3
            current_request: mutable darray[u8] = []
            current_request.extend(bytes_view(request))
            current_indices: mutable darray[i64] = []
            while query_index < query_count |query_index: i64 = 0, query_count, current_indices|:
                current_indices.push(query_index)
                query_index <- query_index + 1
            if query_count == 0:
                empty_request_name: mutable darray[u8] = []
                empty_request_path: mutable darray[u8] = []
                return 4 if not rh_osv_batch_page_name(1, 0, empty_request_name)
                return 4 if not rh_osv_page_path(out, empty_request_name, empty_request_path)
                empty_request_ptr: cstr = (&empty_request_path[0]).cast[cstr] can Unsafe.PointerCast
                empty_request: mutable darray[u8] = []
                empty_request.extend(bytes_view(current_request))
                empty_request.push(10)
                if not Base::rh_io_write(empty_request_ptr, empty_request):
                    rh_osv_query_err("osv-query: cannot retain empty graph batch request")
                    return 4
            page_evidence: mutable darray[u8] = []
            page_evidence.push(91)
            first_response_hash: mutable darray[u8] = []
            total_page_tokens: mutable i64 = 0
            total_advisory_ids: mutable i64 = 0
            page_count: mutable i64 = 0
            more_available: mutable bool = false
            done: mutable bool = query_count == 0
            page_limit: i64 = OsvQuery::RH_OSV_QUERY_MAX_PAGES if continue_pages else 1
            pending_request: mutable darray[u8] = []
            while not done |page_number: i64 = 1, page_count, page_limit, query_count, continue_pages, out, current_request, current_indices, page_evidence, first_response_hash, total_page_tokens, total_advisory_ids, more_available, done, pending_request|:
                request_name: mutable darray[u8] = []
                raw_name: mutable darray[u8] = []
                status_name: mutable darray[u8] = []
                error_name: mutable darray[u8] = []
                return 4 if not rh_osv_batch_page_name(page_number, 0, request_name)
                return 4 if not rh_osv_batch_page_name(page_number, 1, raw_name)
                return 4 if not rh_osv_batch_page_name(page_number, 2, status_name)
                return 4 if not rh_osv_batch_page_name(page_number, 3, error_name)
                request_page_path: mutable darray[u8] = []
                raw_page_path: mutable darray[u8] = []
                status_page_path: mutable darray[u8] = []
                error_page_path: mutable darray[u8] = []
                return 4 if not rh_osv_page_path(out, request_name, request_page_path)
                return 4 if not rh_osv_page_path(out, raw_name, raw_page_path)
                return 4 if not rh_osv_page_path(out, status_name, status_page_path)
                return 4 if not rh_osv_page_path(out, error_name, error_page_path)
                request_page_ptr: cstr = (&request_page_path[0]).cast[cstr] can Unsafe.PointerCast
                raw_page_ptr: cstr = (&raw_page_path[0]).cast[cstr] can Unsafe.PointerCast
                status_page_ptr: cstr = (&status_page_path[0]).cast[cstr] can Unsafe.PointerCast
                error_page_ptr: cstr = (&error_page_path[0]).cast[cstr] can Unsafe.PointerCast
                page_request: mutable darray[u8] = []
                page_request.extend(bytes_view(current_request))
                page_request.push(10)
                if not Base::rh_io_write(request_page_ptr, page_request):
                    rh_osv_query_err("osv-query: cannot retain graph batch page request")
                    return 4
                if Git::rh_run_osv_query_batch(request_page_ptr, raw_page_ptr, status_page_ptr, error_page_ptr) != 0:
                    rh_osv_query_err("osv-query: bounded batch transport failed; inspect retained page evidence")
                    return 4
                status: mutable darray[u8] = []
                if Base::rh_io_read(status_page_ptr, status) < 0 or status.count != 3:
                    rh_osv_query_err("osv-query: batch HTTP status is missing or malformed")
                    return 4
                if status[0] != 50 or status[1] != 48 or status[2] != 48:
                    rh_osv_query_err("osv-query: OSV batch returned non-200; inspect retained page evidence")
                    return 4
                raw_response: mutable darray[u8] = []
                if Base::rh_io_read(raw_page_ptr, raw_response) < 0 or raw_response.count.i64() > Git::RH_FETCH_MAX_BYTES:
                    rh_osv_query_err("osv-query: cannot read bounded batch response")
                    return 4
                page_hash: mutable darray[u8] = []
                Sha256::rh_sha256(raw_response, page_hash)
                if page_hash.count != 64:
                    rh_osv_query_err("osv-query: could not digest raw batch page")
                    return 4
                page_tokens: mutable i64 = 0
                page_ids: mutable i64 = 0
                if OsvQuery::rh_osv_query_validate_batch_response(raw_response, current_indices.count.i64(), &page_tokens, &page_ids) != 0:
                    rh_osv_query_err("osv-query: malformed or positionally incomplete batch response; raw response retained")
                    return 4
                total_page_tokens <- total_page_tokens + page_tokens
                total_advisory_ids <- total_advisory_ids + page_ids
                first_response_hash.extend(bytes_view(page_hash)) if page_number == 1
                if (continue_pages or hydrate_advisories) and not rh_osv_query_append_batch_page_evidence(page_number, page_hash, current_indices, page_evidence):
                    rh_osv_query_err("osv-query: cannot retain batch page index evidence")
