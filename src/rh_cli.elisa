        rh_cli_err("store lease: cannot read --input")
        return 4
    body: mutable darray[u8] = []
    if rh_lease_report(raw, root, job, body) != 0:
        rh_cli_err("store lease: not a valid rh-store-lease-input/1 document or lease dir (fail closed)")
        return 4
    body.push(10)
