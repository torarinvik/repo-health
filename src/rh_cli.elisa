# --- M08 release-only source execution path. ---
# Reads an rh-release-feed-input/1 document ({"first_seen":N,"releases":[...]})
# and writes rh-release-feed-result/1. No history/identity is derived; valid
# time (published) and known time (first-seen) are kept separate. URL input
# retains bounded source/status/error evidence before parsing.
def rh_do_release_feed(input_path: cstr, out_path: cstr, source_url: cstr, has_url: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected release-feed argument (allowlist)")
        return 3
    raw: mutable darray[u8] = []
    if has_url:
        return 3 if not Git::rh_fetch_arg_safe(source_url)
        source_path: mutable darray[u8] =
            source_path: mutable darray[u8] = []
            rh_push_cstr(source_path, out_path)
            rh_push_text(source_path, ".source")
            source_path.push(0)
            source_path
        status_path: mutable darray[u8] =
            status_path: mutable darray[u8] = []
            rh_push_cstr(status_path, out_path)
            rh_push_text(status_path, ".source.status")
            status_path.push(0)
            status_path
        error_path: mutable darray[u8] =
            error_path: mutable darray[u8] = []
            rh_push_cstr(error_path, out_path)
            rh_push_text(error_path, ".source.err")
            error_path.push(0)
            error_path
        source_ptr: cstr = (&source_path[0]).cast[cstr] can Unsafe.PointerCast
        status_ptr: cstr = (&status_path[0]).cast[cstr] can Unsafe.PointerCast
        error_ptr: cstr = (&error_path[0]).cast[cstr] can Unsafe.PointerCast
        if Git::rh_run_https_get(source_url, source_ptr, status_ptr, error_ptr) != 0:
            rh_cli_err("release-feed: fetch failed; source and stderr evidence retained")
            return 4
        status_raw: mutable darray[u8] = []
        if rh_io_read(status_ptr, status_raw) < 0 or status_raw.count == 0:
            rh_cli_err("release-feed: fetch did not produce a status")
            return 4
        ok_status: bool = status_raw[0] == 50
        file_transport: bool = status_raw.count >= 3 and status_raw[0] == 48 and status_raw[1] == 48 and status_raw[2] == 48 and rh_cstr_starts_with(source_url, "file://")
        if not ok_status and not file_transport:
            rh_cli_err("release-feed: fetch returned non-2xx; no result published")
            return 4
        if rh_io_read(source_ptr, raw) < 0:
            rh_cli_err("release-feed: cannot read fetched source evidence")
            return 4
    else:
        return 3 if not Git::rh_arg_safe(input_path)
        ip: mutable darray[u8] =
            ip: mutable darray[u8] = []
            rh_push_cstr(ip, input_path)
            ip.push(0)
            ip
        ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
        if rh_io_read(ipp, raw) < 0:
            rh_cli_err("release-feed: cannot read --input")
            return 4
    nodes: mutable darray[Json::RhJsonNode] = []
    fs_idx: i64 = |raw, nodes|
        texts: mutable darray[u8] = []
        root: i64 = Json::rh_json_parse(raw, nodes, texts)
        if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ:
            rh_cli_err("release-feed: --input must be a JSON object (fail closed)")
            return 4
        block_result: i64 = Json::rh_json_obj_get(nodes, texts, root, "first_seen")
        block_result
    if fs_idx < 0:
        rh_cli_err("release-feed: missing first_seen (fail closed)")
        return 4
    fs_ok: mutable i64 = 0
    first_seen: i64 = Json::rh_json_int(nodes, raw, fs_idx, &fs_ok)
    if fs_ok == 0:
        rh_cli_err("release-feed: first_seen must be an integer (fail closed)")
        return 4
    body: mutable darray[u8] = []
    if rh_rfr_report(raw, first_seen, body) != 0:
        rh_cli_err("release-feed: input is not a valid release feed (fail closed)")
        return 4
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(opp, body):
        rh_cli_err("release-feed: cannot write --out")
        return 4
    rh_cli_out("release-feed: ok")
    0

# --- M03-05 registry enrichment execution path. ---
# Reads an rh-registry-meta/1 document and writes rh-registry-meta-result/1.
# Yanked versions are retained; absent yank/date fields stay null (unknown);
# repository links are assertions, not identity; declared deps are counts.
def rh_do_registry_meta(input_path: cstr, out_path: cstr, source_url: cstr, has_url: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
