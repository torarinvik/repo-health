                arg7: u8& = slots[dc].cast[u8&] can Unsafe.PointerCast
                if Base::rh_streq(arg7, "--repo"):
                    if dc + 1 < argc:
                        dc <- dc + 1
                        dr_idx <- dc
                    else:
                        return rh_cli_usage(2)
                elif Base::rh_streq(arg7, "--out"):
                    if dc + 1 < argc:
                        dc <- dc + 1
                        do_idx <- dc
                    else:
                        return rh_cli_usage(2)
                elif Base::rh_streq(arg7, "--osv"):
                    if dc + 1 < argc:
                        dc <- dc + 1
                        dov_idx <- dc
                    else:
                        return rh_cli_usage(2)
                elif Base::rh_streq(arg7, "--osv-url"):
                    if dc + 1 < argc:
                        dc <- dc + 1
                        dou_idx <- dc
