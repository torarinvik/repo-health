# --- M04-03 reversible identity-link execution path. ---
# Reads an rh-identity-input/1 link ledger and writes rh-identity-result/1:
# identity revision, clusters over ACCEPTED links only, and a per-actor
# cluster map. Rejected/revoked links change nothing; malformed input fails
# closed.
def rh_do_identity(input_path: cstr, out_path: cstr, evidence_root: cstr, has_evidence_root: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected identity argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        Base::rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if Base::rh_io_read(ipp, raw) < 0:
        rh_cli_err("identity: cannot read --input")
        return 4
    verified_reference_count: mutable i64 = 0
    reviewed_link_count: mutable i64 = 0
    reviewed_cross_source_link_count: mutable i64 = 0
    if has_evidence_root:
        if not Git::rh_arg_safe(evidence_root) or IdentityEvidence::rh_identity_evidence_verify(raw, evidence_root, &verified_reference_count, &reviewed_link_count, &reviewed_cross_source_link_count) != 0:
            rh_cli_err("identity: evidence reference is malformed, missing, or corrupt")
            return 4
    body: mutable darray[u8] = []
    if IdentityReport::rh_identity_report(raw, body) != 0:
        rh_cli_err("identity: not a valid rh-identity-input/1 document (fail closed)")
        return 4
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        Base::rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(opp, body):
        rh_cli_err("identity: cannot write --out")
        return 4
    if has_evidence_root:
        verification: mutable darray[u8] = []
        Base::rh_push_text(verification, "{\"schema\":\"rh-identity-evidence-verification/1\",\"state\":\"verified\",\"verified_reference_count\":")
        Base::rh_push_decimal_i64(verification, verified_reference_count)
        Base::rh_push_text(verification, ",\"reviewed_link_count\":")
        Base::rh_push_decimal_i64(verification, reviewed_link_count)
        Base::rh_push_text(verification, ",\"reviewed_cross_source_link_count\":")
        Base::rh_push_decimal_i64(verification, reviewed_cross_source_link_count)
        Base::rh_push_text(verification, ",\"source_input_sha256\":\"")
        Sha256::rh_sha256(raw, verification)
        Base::rh_push_text(verification, "\",\"identity_output_sha256\":\"")
        Sha256::rh_sha256(body, verification)
        Base::rh_push_text(verification, "\"}")
        verification.push(10)
        verification_path: mutable darray[u8] = []
        Base::rh_push_cstr(verification_path, out_path)
        Base::rh_push_text(verification_path, ".evidence-verification.json")
        verification_path.push(0)
        verification_ptr: cstr = (&verification_path[0]).cast[cstr] can Unsafe.PointerCast
        if not Base::rh_io_write(verification_ptr, verification):
            rh_cli_err("identity: cannot write evidence verification report")
            return 4
    rh_cli_out("identity: ok")
    0

