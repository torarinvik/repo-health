# --- M02-03 job-lease execution path. ---
# Applies a lease op sequence (claim/heartbeat/release/status) to a real
# filesystem lease under <root>/leases/<job>.lease, enforcing fencing.
def rh_do_store_lease(root: cstr, job: cstr, input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(root) or not Git::rh_arg_safe(job) or not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected store lease argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        Base::rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if Base::rh_io_read(ipp, raw) < 0:
        rh_cli_err("store lease: cannot read --input")
        return 4
    body: mutable darray[u8] = []
    if LeaseReport::rh_lease_report(raw, root, job, body) != 0:
        rh_cli_err("store lease: not a valid rh-store-lease-input/1 document or lease dir (fail closed)")
        return 4
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        Base::rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(opp, body):
        rh_cli_err("store lease: cannot write --out")
        return 4
    rh_cli_out("store lease: ok")
    0
