def rh_cli_err(text: u8&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    buffer: mutable darray[u8] =
        buffer: mutable darray[u8] = []
        Base::rh_push_text(buffer, "rh_cli: ")
        Base::rh_push_text(buffer, text)
        buffer.push(10)
        buffer
    Base::rh_write_stderr(buffer)

def rh_cli_out(text: u8&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    buffer: mutable darray[u8] =
        buffer: mutable darray[u8] = []
        Base::rh_push_text(buffer, text)
        buffer.push(10)
        buffer
    Base::rh_write_stdout(buffer)

