        return rh_do_index(slots[xi_idx], slots[xo_idx])
    if rh_streq(cmd, "adoption"):
        ai2_idx, ao2_idx =
            while abq < argc |ai2_idx: i64 = -1, ao2_idx: i64 = -1, abq: i64 = 2, slots| -> ai2_idx, ao2_idx:
                a35: u8& = slots[abq].cast[u8&] can Unsafe.PointerCast
                if rh_streq(a35, "--input"):
                    if abq + 1 < argc:
                        abq <- abq + 1
                        ai2_idx <- abq
                    else:
                        return rh_cli_usage(2)
                elif rh_streq(a35, "--out"):
                    if abq + 1 < argc:
                        abq <- abq + 1
                        ao2_idx <- abq
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                abq <- abq + 1
        return rh_cli_usage(2) if ai2_idx < 0 or ao2_idx < 0
        return rh_do_adoption(slots[ai2_idx], slots[ao2_idx])
    if rh_streq(cmd, "lineage"):
        li_idx, lo_idx =
            while llq < argc |li_idx: i64 = -1, lo_idx: i64 = -1, llq: i64 = 2, slots| -> li_idx, lo_idx:
                a36: u8& = slots[llq].cast[u8&] can Unsafe.PointerCast
                if rh_streq(a36, "--input"):
                    if llq + 1 < argc:
                        llq <- llq + 1
                        li_idx <- llq
                    else:
                        return rh_cli_usage(2)
                elif rh_streq(a36, "--out"):
                    if llq + 1 < argc:
                        llq <- llq + 1
                        lo_idx <- llq
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                llq <- llq + 1
        return rh_cli_usage(2) if li_idx < 0 or lo_idx < 0
        return rh_do_lineage(slots[li_idx], slots[lo_idx])
    if rh_streq(cmd, "population"):
        pi_idx, po_idx =
            while ppq < argc |pi_idx: i64 = -1, po_idx: i64 = -1, ppq: i64 = 2, slots| -> pi_idx, po_idx:
                a37: u8& = slots[ppq].cast[u8&] can Unsafe.PointerCast
                if rh_streq(a37, "--input"):
                    if ppq + 1 < argc:
                        ppq <- ppq + 1
                        pi_idx <- ppq
                    else:
                        return rh_cli_usage(2)
                elif rh_streq(a37, "--out"):
                    if ppq + 1 < argc:
                        ppq <- ppq + 1
                        po_idx <- ppq
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                ppq <- ppq + 1
        return rh_cli_usage(2) if pi_idx < 0 or po_idx < 0
        return rh_do_population(slots[pi_idx], slots[po_idx])
    if rh_streq(cmd, "ingest"):
        ir_idx, ii_idx, io_idx =
            while iiq < argc |ir_idx: i64 = -1, ii_idx: i64 = -1, io_idx: i64 = -1, iiq: i64 = 2, slots| -> ir_idx, ii_idx, io_idx:
                a38: u8& = slots[iiq].cast[u8&] can Unsafe.PointerCast
                if rh_streq(a38, "--root"):
                    if iiq + 1 < argc:
                        iiq <- iiq + 1
                        ir_idx <- iiq
                    else:
                        return rh_cli_usage(2)
                elif rh_streq(a38, "--input"):
                    if iiq + 1 < argc:
                        iiq <- iiq + 1
                        ii_idx <- iiq
                    else:
                        return rh_cli_usage(2)
                elif rh_streq(a38, "--out"):
                    if iiq + 1 < argc:
                        iiq <- iiq + 1
                        io_idx <- iiq
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                iiq <- iiq + 1
        return rh_cli_usage(2) if ir_idx < 0 or ii_idx < 0 or io_idx < 0
        return rh_do_ingest(slots[ir_idx], slots[ii_idx], slots[io_idx])
    if rh_streq(cmd, "drilldown"):
        di_idx, do_idx =
            while ddq < argc |di_idx: i64 = -1, do_idx: i64 = -1, ddq: i64 = 2, slots| -> di_idx, do_idx:
                a39: u8& = slots[ddq].cast[u8&] can Unsafe.PointerCast
                if rh_streq(a39, "--input"):
                    if ddq + 1 < argc:
                        ddq <- ddq + 1
                        di_idx <- ddq
                    else:
                        return rh_cli_usage(2)
                elif rh_streq(a39, "--out"):
                    if ddq + 1 < argc:
                        ddq <- ddq + 1
                        do_idx <- ddq
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                ddq <- ddq + 1
        return rh_cli_usage(2) if di_idx < 0 or do_idx < 0
        return rh_do_drilldown(slots[di_idx], slots[do_idx])
    if rh_streq(cmd, "role-grain"):
        rgi_idx, rgo_idx =
            while rgq < argc |rgi_idx: i64 = -1, rgo_idx: i64 = -1, rgq: i64 = 2, slots| -> rgi_idx, rgo_idx:
                a40: u8& = slots[rgq].cast[u8&] can Unsafe.PointerCast
                if rh_streq(a40, "--input"):
                    if rgq + 1 < argc:
                        rgq <- rgq + 1
                        rgi_idx <- rgq
                    else:
                        return rh_cli_usage(2)
                elif rh_streq(a40, "--out"):
                    if rgq + 1 < argc:
                        rgq <- rgq + 1
                        rgo_idx <- rgq
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                rgq <- rgq + 1
        return rh_cli_usage(2) if rgi_idx < 0 or rgo_idx < 0
        return rh_do_role_grain(slots[rgi_idx], slots[rgo_idx])
    if rh_streq(cmd, "sign") or rh_streq(cmd, "verify"):
        key_idx, sub_idx, sig_idx =
            while m < argc |key_idx: i64 = -1, sub_idx: i64 = -1, sig_idx: i64 = -1, m: i64 = 2, slots| -> key_idx, sub_idx, sig_idx:
                arg4: u8& = slots[m].cast[u8&] can Unsafe.PointerCast
                if rh_streq(arg4, "--key"):
                    if m + 1 < argc:
                        m <- m + 1
                        key_idx <- m
                    else:
                        return rh_cli_usage(2)
                elif rh_streq(arg4, "--subject"):
                    if m + 1 < argc:
                        m <- m + 1
                        sub_idx <- m
                    else:
                        return rh_cli_usage(2)
                elif rh_streq(arg4, "--sig"):
                    if m + 1 < argc:
                        m <- m + 1
                        sig_idx <- m
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                m <- m + 1
        if key_idx < 0 or sub_idx < 0 or sig_idx < 0:
            return rh_cli_usage(2)
        # sign/verify read local files directly and never build a shell
        # command, so the shell-arg allowlist does not apply. Reject only
        # empty and control-character paths.
        if not rh_path_arg_ok(slots[key_idx]) or not rh_path_arg_ok(slots[sub_idx]) or not rh_path_arg_ok(slots[sig_idx]):
            rh_cli_err("rejected sign/verify argument (path)")
            return 3
        return rh_do_sign(slots[key_idx], slots[sub_idx], slots[sig_idx]) if rh_streq(cmd, "sign")
        return rh_do_verify(slots[key_idx], slots[sub_idx], slots[sig_idx])
    if rh_streq(cmd, "serve"):
        root_idx, port, maxc =
            while k < argc |root_idx: i64 = -1, port: i64 = 8080, maxc: i64 = 100, k: i64 = 2, slots| -> root_idx, port, maxc:
                arg3: u8& = slots[k].cast[u8&] can Unsafe.PointerCast
                if rh_streq(arg3, "--root"):
                    if k + 1 < argc:
                        k <- k + 1
                        root_idx <- k
                    else:
                        return rh_cli_usage(2)
                elif rh_streq(arg3, "--port"):
                    if k + 1 < argc:
                        k <- k + 1
                        okp: mutable i64 = 0
                        pv: i64 = rh_parse_cstr_int(slots[k], &okp)
                        return rh_cli_usage(2) if okp == 0 or pv <= 0 or pv > 65535
                        port <- pv
                    else:
                        return rh_cli_usage(2)
                elif rh_streq(arg3, "--max"):
                    if k + 1 < argc:
                        k <- k + 1
                        okm: mutable i64 = 0
                        mv: i64 = rh_parse_cstr_int(slots[k], &okm)
                        return rh_cli_usage(2) if okm == 0 or mv <= 0 or mv > 100000
                        maxc <- mv
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                k <- k + 1
        return rh_cli_usage(2) if root_idx < 0
        if not Git::rh_arg_safe(slots[root_idx]):
            rh_cli_err("rejected root argument (allowlist)")
            return 3
        return rh_do_serve(slots[root_idx], port, maxc)
    rh_cli_usage(2)

def rh_do_serve(root: cstr, port: i64, maxc: i64) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    notice: mutable darray[u8] =
        notice: mutable darray[u8] = []
        rh_push_text(notice, "serve: loopback 127.0.0.1 port ")
        rh_push_decimal_i64(notice, port)
        rh_push_text(notice, " root ")
        rh_push_cstr(notice, root)
        notice.push(10)
        notice
    rh_write_stdout(notice)
    n: i64 = Http::rh_http_serve(root, port.i32(), maxc)
    done: mutable darray[u8] = []
    if n < 0:
        rh_push_text(done, "serve: could not bind loopback port")
    else:
        rh_push_text(done, "serve: served ")
        rh_push_decimal_i64(done, n)
        rh_push_text(done, " connection(s)")
    done.push(10)
    rh_write_stdout(done)
    return 4 if n < 0
    0

# --- M07-04 publication integrity: sign/verify a release artifact. ---
# A signature file is a small JSON object:
#   {"algorithm":"hmac-sha256","subject_sha256":"<hex>","signature":"<hex>"}
# The key is a raw byte file held separately from workers. Verification
# proves integrity of the subject bytes and possession of the shared key;
# it is NOT a claim that the subject is correct, safe, or trustworthy (S011).

# --- M03 dependency graph execution path. ---
# Reads a local project's Cargo.lock, package.json + package-lock.json,
# requirements.txt, bounded PEP 621 pyproject.toml, go.mod, Gemfile.lock,
# composer.lock, packages.config, or the bounded pom.xml subset,
# resolves the version-aware graph, and writes one rh-dep-graph/1 report per
# ecosystem plus rh-deps-metrics/1. Requirements that do not resolve stay
# explicit unresolved nodes with reasons (never guessed edges, R009); a
# malformed lockfile fails closed with no partial graph (M07-03). An
# optional offline OSV JSON supplies advisories; without it, advisories are
# simply not collected (never fabricated). `--osv-url` is an explicit,
# bounded fetch path: the response and a source-status envelope are retained
# in the output directory before parsing, and non-2xx responses fail closed.
def rh_do_deps(repo: cstr, out: cstr, osv_path: cstr, has_osv: bool, osv_url: cstr, has_osv_url: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(repo) or not Git::rh_arg_safe(out):
        rh_cli_err("rejected deps argument (allowlist)")
        return 3
    if has_osv and not Git::rh_arg_safe(osv_path):
        rh_cli_err("rejected osv argument (allowlist)")
        return 3
    if has_osv and has_osv_url:
        rh_cli_err("deps: --osv and --osv-url are mutually exclusive")
        return 2
    if has_osv_url and not Git::rh_fetch_arg_safe(osv_url):
        rh_cli_err("deps: rejected --osv-url (transport/shell policy)")
        return 3
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("deps: cannot create output directory")
        return 4
    resolved_osv_path: mutable cstr = osv_path
    resolved_has_osv: mutable bool = has_osv
    if has_osv_url:
        body_path: mutable darray[u8] = []
        code_path: mutable darray[u8] = []
        err_path: mutable darray[u8] = []
        if not rh_out_path(out, "osv-fetch-body.json", body_path) or not rh_out_path(out, "osv-fetch-status.txt", code_path) or not rh_out_path(out, "osv-fetch.err", err_path):
            rh_cli_err("deps: cannot stage OSV fetch evidence")
            return 4
        body_path.push(0)
        code_path.push(0)
        err_path.push(0)
        body_ptr: cstr = (&body_path[0]).cast[cstr] can Unsafe.PointerCast
        code_ptr: cstr = (&code_path[0]).cast[cstr] can Unsafe.PointerCast
        fetch_rc: i64 = |err_path|
            err_ptr: cstr = (&err_path[0]).cast[cstr] can Unsafe.PointerCast
            block_result: i64 = Git::rh_run_https_get(osv_url, body_ptr, code_ptr, err_ptr)
            block_result
        if fetch_rc != 0:
            rh_cli_err("deps: OSV fetch failed; no advisory result published")
            return 4
        code_raw: mutable darray[u8] = []
        if rh_io_read(code_ptr, code_raw) < 0 or code_raw.count == 0:
            rh_cli_err("deps: OSV fetch did not produce a status")
            return 4
        ok_status: bool = code_raw[0] == 50
        file_transport: bool = code_raw.count >= 3 and code_raw[0] == 48 and code_raw[1] == 48 and code_raw[2] == 48 and rh_cstr_starts_with(osv_url, "file://")
        if not ok_status and not file_transport:
            rh_cli_err("deps: OSV fetch returned non-2xx; no advisory result published")
            return 4
        status: mutable darray[u8] =
            status: mutable darray[u8] = []
            rh_push_text(status, "{\"schema\":\"rh-osv-fetch/1\",\"source_url\":\"")
            rh_push_cstr(status, osv_url)
            rh_push_text(status, "\",\"status\":\"")
            status
        code_data: u8& = (&code_raw[0]).cast[u8&] can Unsafe.PointerCast
        rh_push_raw(status, code_data, code_raw.count)
        rh_push_text(status, "\",\"body_file\":\"osv-fetch-body.json\",\"state\":\"collected\",\"note\":\"bounded transport capture retained before offline OSV matching\"}\n")
        if not rh_io_write(code_ptr, status):
            rh_cli_err("deps: cannot write OSV fetch status")
            return 4
        resolved_osv_path <- body_ptr
        resolved_has_osv <- true
    osv_nodes: mutable darray[Json::RhJsonNode] = []
    osv_texts: mutable darray[u8] = []
    osv_root: mutable i64 = -1
    if resolved_has_osv:
        parsed_osv: i64 = |resolved_osv_path, osv_nodes, osv_texts|
            op: mutable darray[u8] =
                op: mutable darray[u8] = []
                rh_push_cstr(op, resolved_osv_path)
                op.push(0)
                op
            oreadp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
            oraw: mutable darray[u8] = []
            if rh_io_read(oreadp, oraw) < 0:
                rh_cli_err("deps: cannot read --osv file")
                return 4
            block_result: i64 = Json::rh_json_parse(oraw, osv_nodes, osv_texts)
            block_result
        if parsed_osv < 0:
            rh_cli_err("deps: --osv file is not valid JSON")
            return 4
        osv_root <- parsed_osv
    eco_codes: mutable darray[i64] = []
    declared: mutable darray[i64] = []
    resolved: mutable darray[i64] = []
    unresolved_n: mutable darray[i64] = []
    unsupported_n: mutable darray[i64] = []
    found: mutable i64 = 0

    # --- Cargo.lock ---
    cl: mutable darray[u8] = []
    if not rh_out_path(repo, "Cargo.lock", cl):
        rh_cli_err("deps: bad repo path")
        return 3
    clp: cstr = (&cl[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(clp):
        lockb: mutable darray[u8] = []
        if rh_io_read(clp, lockb) < 0:
            rh_cli_err("deps: cannot read Cargo.lock")
            return 4
        cpkgs: mutable darray[RhPkgNode] = []
        cpool: mutable darray[u8] = []
        creqs: mutable darray[RhRequire] = []
        cn: i64 = |lockb, cpkgs, cpool, creqs|
            cunk: mutable i64 = 0
            block_result: i64 = rh_cargo_parse(lockb, cpkgs, cpool, creqs, &cunk)
            block_result
        if cn < 0:
            rh_cli_err("deps: malformed Cargo.lock (structured failure, no partial graph)")
            return 4
        cedges: mutable darray[RhDepEdge] = []
        cunres: mutable darray[RhUnresolved] = []
        _ = rh_cargo_resolve(cpkgs, cpool, creqs, cedges, cunres)
        cunsup: i64 = rh_unsupported_range_count(creqs, cpool)
        cfind: mutable darray[RhAdvisory] = []
        cwd: mutable i64 = 0
        csk: mutable i64 = 0
        if resolved_has_osv:
            _ = rh_osv_match(cpkgs, cpool, osv_nodes, osv_texts, osv_root, cfind, &cwd, &csk)
        croot: i64 = rh_deps_cargo_root(cpkgs, cedges)
        gb: mutable darray[u8] = []
        rh_graph_write_json(gb, 0, cpkgs, cpool, cedges, cunres, cfind, osv_texts, croot)
        gb.push(10)
        gf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-cargo-graph.json", gf):
            rh_cli_err("deps: cannot stage cargo graph path")
            return 4
        gfp: cstr = (&gf[0]).cast[cstr] can Unsafe.PointerCast
        if not rh_io_write(gfp, gb):
            rh_cli_err("deps: cannot write cargo graph")
            return 4
        eco_codes.push(0)
        declared.push(creqs.count.i64())
        resolved.push(cedges.count.i64())
        unresolved_n.push(cunres.count.i64())
        unsupported_n.push(cunsup)
        found <- found + 1

    # --- package.json + package-lock.json ---
    pl: mutable darray[u8] = []
    if not rh_out_path(repo, "package-lock.json", pl):
        rh_cli_err("deps: bad repo path")
        return 3
    plp: cstr = (&pl[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(plp):
        nlock: mutable darray[u8] = []
        if rh_io_read(plp, nlock) < 0:
            rh_cli_err("deps: cannot read package-lock.json")
            return 4
        pj: mutable darray[u8] = []
        if not rh_out_path(repo, "package.json", pj):
            rh_cli_err("deps: bad repo path")
            return 3
        pjp: cstr = (&pj[0]).cast[cstr] can Unsafe.PointerCast
        npkg: mutable darray[u8] = []
        if file_exists(pjp):
            if rh_io_read(pjp, npkg) < 0:
                rh_cli_err("deps: cannot read package.json")
                return 4
        npkgs: mutable darray[RhPkgNode] = []
        npool: mutable darray[u8] = []
        npaths: mutable darray[i64] = []
        nreqs: mutable darray[RhRequire] = []
        nroot: i64 = rh_npm_lock_parse(nlock, npkg, npkgs, npool, npaths, nreqs)
        if nroot < 0:
            rh_cli_err("deps: malformed package-lock.json (structured failure, no partial graph)")
            return 4
        nedges: mutable darray[RhDepEdge] = []
        nunres: mutable darray[RhUnresolved] = []
        _ = rh_npm_resolve(npkgs, npaths, npool, nreqs, nedges, nunres)
        nunsup: i64 = rh_unsupported_range_count(nreqs, npool)
        nfind: mutable darray[RhAdvisory] = []
        nwd: mutable i64 = 0
        nsk: mutable i64 = 0
        if resolved_has_osv:
            _ = rh_osv_match(npkgs, npool, osv_nodes, osv_texts, osv_root, nfind, &nwd, &nsk)
        ng: mutable darray[u8] = []
        rh_graph_write_json(ng, 1, npkgs, npool, nedges, nunres, nfind, osv_texts, nroot)
        ng.push(10)
        nf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-npm-graph.json", nf):
            rh_cli_err("deps: cannot stage npm graph path")
            return 4
        nfp: cstr = (&nf[0]).cast[cstr] can Unsafe.PointerCast
        if not rh_io_write(nfp, ng):
            rh_cli_err("deps: cannot write npm graph")
            return 4
        eco_codes.push(1)
        declared.push(nreqs.count.i64())
        resolved.push(nedges.count.i64())
        unresolved_n.push(nunres.count.i64())
        unsupported_n.push(nunsup)
        found <- found + 1

    # --- requirements.txt (PyPI) ---
    rq: mutable darray[u8] = []
    if not rh_out_path(repo, "requirements.txt", rq):
        rh_cli_err("deps: bad repo path")
        return 3
    rqp: cstr = (&rq[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(rqp):
        rb: mutable darray[u8] = []
        if rh_io_read(rqp, rb) < 0:
            rh_cli_err("deps: cannot read requirements.txt")
            return 4
        ppkgs: mutable darray[RhPkgNode] = []
        ppool: mutable darray[u8] = []
        preqs: mutable darray[RhRequire] = []
        pedges: mutable darray[RhDepEdge] = []
        punres: mutable darray[RhUnresolved] = []
        proot: i64 = |rb, ppkgs, ppool, preqs, pedges, punres|
            punk: mutable i64 = 0
            block_result: i64 = rh_pypi_parse(rb, ppkgs, ppool, preqs, pedges, punres, &punk)
            block_result
        if proot < 0:
            rh_cli_err("deps: malformed requirements.txt (structured failure, no partial graph)")
            return 4
        punsup: i64 = rh_unsupported_range_count(preqs, ppool)
        pfind: mutable darray[RhAdvisory] = []
        pwd: mutable i64 = 0
        psk: mutable i64 = 0
        if resolved_has_osv:
            _ = rh_osv_match(ppkgs, ppool, osv_nodes, osv_texts, osv_root, pfind, &pwd, &psk)
        pg: mutable darray[u8] = []
        rh_graph_write_json(pg, 2, ppkgs, ppool, pedges, punres, pfind, osv_texts, proot)
        pg.push(10)
        pf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-pypi-graph.json", pf):
            rh_cli_err("deps: cannot stage pypi graph path")
            return 4
        pfp: cstr = (&pf[0]).cast[cstr] can Unsafe.PointerCast
        if not rh_io_write(pfp, pg):
            rh_cli_err("deps: cannot write pypi graph")
            return 4
        eco_codes.push(2)
        declared.push(preqs.count.i64())
        resolved.push(pedges.count.i64())
        unresolved_n.push(punres.count.i64())
        unsupported_n.push(punsup)
        found <- found + 1

    # --- pyproject.toml (PEP 621 declared dependencies) ---
    py: mutable darray[u8] = []
    if not rh_out_path(repo, "pyproject.toml", py):
        rh_cli_err("deps: bad repo path")
        return 3
    pyp: cstr = (&py[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(pyp):
        if file_exists(rqp):
            rh_cli_err("deps: requirements.txt and pyproject.toml are both present; choose one declared PyPI source")
            return 4
        pyb: mutable darray[u8] = []
        if rh_io_read(pyp, pyb) < 0:
            rh_cli_err("deps: cannot read pyproject.toml")
            return 4
        ypkgs: mutable darray[RhPkgNode] = []
        ypool: mutable darray[u8] = []
        yreqs: mutable darray[RhRequire] = []
        yedges: mutable darray[RhDepEdge] = []
        yunres: mutable darray[RhUnresolved] = []
        yroot: i64 = |pyb, ypkgs, ypool, yreqs, yedges, yunres|
            yunk: mutable i64 = 0
            block_result: i64 = rh_pypi_parse_pep621(pyb, ypkgs, ypool, yreqs, yedges, yunres, &yunk)
            block_result
        if yroot < 0:
            rh_cli_err("deps: malformed pyproject.toml PEP 621 subset (structured failure, no partial graph)")
            return 4
        yunsup: i64 = rh_unsupported_range_count(yreqs, ypool)
        yfind: mutable darray[RhAdvisory] = []
        ywd: mutable i64 = 0
        ysk: mutable i64 = 0
        if resolved_has_osv:
            _ = rh_osv_match(ypkgs, ypool, osv_nodes, osv_texts, osv_root, yfind, &ywd, &ysk)
        yg: mutable darray[u8] = []
        rh_graph_write_json(yg, 2, ypkgs, ypool, yedges, yunres, yfind, osv_texts, yroot)
        yg.push(10)
        yf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-pypi-graph.json", yf):
            rh_cli_err("deps: cannot stage pypi graph path")
            return 4
        yfp: cstr = (&yf[0]).cast[cstr] can Unsafe.PointerCast
        if not rh_io_write(yfp, yg):
            rh_cli_err("deps: cannot write pypi graph")
            return 4
        eco_codes.push(2)
        declared.push(yreqs.count.i64())
        resolved.push(yedges.count.i64())
        unresolved_n.push(yunres.count.i64())
        unsupported_n.push(yunsup)
        found <- found + 1

    # --- go.mod (Go modules) ---
    gm: mutable darray[u8] = []
    if not rh_out_path(repo, "go.mod", gm):
        rh_cli_err("deps: bad repo path")
        return 3
    gmp: cstr = (&gm[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(gmp):
        gb: mutable darray[u8] = []
        if rh_io_read(gmp, gb) < 0:
            rh_cli_err("deps: cannot read go.mod")
            return 4
        gpkgs: mutable darray[RhPkgNode] = []
        gpool: mutable darray[u8] = []
        greqs: mutable darray[RhRequire] = []
        gedges: mutable darray[RhDepEdge] = []
        gunres: mutable darray[RhUnresolved] = []
        groot: i64 = |gb, gpkgs, gpool, greqs, gedges, gunres|
            gunk: mutable i64 = 0
            block_result: i64 = rh_go_parse(gb, gpkgs, gpool, greqs, gedges, gunres, &gunk)
            block_result
        if groot < 0:
            rh_cli_err("deps: malformed go.mod (structured failure, no partial graph)")
            return 4
        # go.sum is optional for a module-only capture, but when present every
        # non-empty line must be a valid checksum record. Matching h1: module
        # checksums become node evidence; /go.mod records stay metadata.
        gs: mutable darray[u8] = []
        if not rh_out_path(repo, "go.sum", gs):
            rh_cli_err("deps: bad repo path")
            return 3
        gsp: cstr = (&gs[0]).cast[cstr] can Unsafe.PointerCast
        if file_exists(gsp):
            gsb: mutable darray[u8] = []
            if rh_io_read(gsp, gsb) < 0:
                rh_cli_err("deps: cannot read go.sum")
                return 4
            if rh_go_sum_parse(gsb, gpkgs, gpool) != 0:
                rh_cli_err("deps: malformed go.sum (structured failure, no partial graph)")
                return 4
        gunsup: i64 = rh_unsupported_range_count(greqs, gpool)
        gfind: mutable darray[RhAdvisory] = []
        gwd: mutable i64 = 0
        gsk: mutable i64 = 0
        if resolved_has_osv:
            _ = rh_osv_match(gpkgs, gpool, osv_nodes, osv_texts, osv_root, gfind, &gwd, &gsk)
        gg: mutable darray[u8] = []
        rh_graph_write_json(gg, 3, gpkgs, gpool, gedges, gunres, gfind, osv_texts, groot)
        gg.push(10)
        gf2: mutable darray[u8] = []
        if not rh_out_path(out, "deps-go-graph.json", gf2):
            rh_cli_err("deps: cannot stage go graph path")
            return 4
        gf2p: cstr = (&gf2[0]).cast[cstr] can Unsafe.PointerCast
        if not rh_io_write(gf2p, gg):
            rh_cli_err("deps: cannot write go graph")
            return 4
        eco_codes.push(3)
        declared.push(greqs.count.i64())
        resolved.push(gedges.count.i64())
        unresolved_n.push(gunres.count.i64())
        unsupported_n.push(gunsup)
        found <- found + 1

    # --- Gemfile.lock (RubyGems) ---
    gl: mutable darray[u8] = []
    if not rh_out_path(repo, "Gemfile.lock", gl):
        rh_cli_err("deps: bad repo path")
        return 3
    glp: cstr = (&gl[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(glp):
        gemb: mutable darray[u8] = []
        if rh_io_read(glp, gemb) < 0:
            rh_cli_err("deps: cannot read Gemfile.lock")
            return 4
        gempkgs: mutable darray[RhPkgNode] = []
        gempool: mutable darray[u8] = []
        gemreqs: mutable darray[RhRequire] = []
        gemedges: mutable darray[RhDepEdge] = []
        gemunres: mutable darray[RhUnresolved] = []
        gemroot: i64 = |gemb, gempkgs, gempool, gemreqs, gemedges, gemunres|
            gemunk: mutable i64 = 0
            block_result: i64 = rh_gemfile_parse(gemb, gempkgs, gempool, gemreqs, gemedges, gemunres, &gemunk)
            block_result
        if gemroot < 0:
            rh_cli_err("deps: malformed Gemfile.lock (structured failure, no partial graph)")
            return 4
        gemunsup: i64 = rh_unsupported_range_count(gemreqs, gempool)
        gemfind: mutable darray[RhAdvisory] = []
        gemwd: mutable i64 = 0
        gemsk: mutable i64 = 0
        if resolved_has_osv:
            _ = rh_osv_match(gempkgs, gempool, osv_nodes, osv_texts, osv_root, gemfind, &gemwd, &gemsk)
        geg: mutable darray[u8] = []
        rh_graph_write_json(geg, 4, gempkgs, gempool, gemedges, gemunres, gemfind, osv_texts, gemroot)
        geg.push(10)
        gef: mutable darray[u8] = []
        if not rh_out_path(out, "deps-rubygems-graph.json", gef):
            rh_cli_err("deps: cannot stage rubygems graph path")
            return 4
        gefp: cstr = (&gef[0]).cast[cstr] can Unsafe.PointerCast
        if not rh_io_write(gefp, geg):
            rh_cli_err("deps: cannot write rubygems graph")
            return 4
        eco_codes.push(4)
        declared.push(gemreqs.count.i64())
        resolved.push(gemedges.count.i64())
        unresolved_n.push(gemunres.count.i64())
        unsupported_n.push(gemunsup)
        found <- found + 1

    # --- composer.lock (Composer/Packagist) ---
    cl2: mutable darray[u8] = []
    if not rh_out_path(repo, "composer.lock", cl2):
        rh_cli_err("deps: bad repo path")
        return 3
    cl2p: cstr = (&cl2[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(cl2p):
        cpb: mutable darray[u8] = []
        if rh_io_read(cl2p, cpb) < 0:
            rh_cli_err("deps: cannot read composer.lock")
            return 4
        cjnodes: mutable darray[Json::RhJsonNode] = []
        cjtexts: mutable darray[u8] = []
        cproot2: i64 = Json::rh_json_parse(cpb, cjnodes, cjtexts)
        if cproot2 < 0:
            rh_cli_err("deps: malformed composer.lock (structured failure, no partial graph)")
            return 4
        cppkgs: mutable darray[RhPkgNode] = []
        cppool: mutable darray[u8] = []
        cpreqs: mutable darray[RhRequire] = []
        cpedges: mutable darray[RhDepEdge] = []
        cpunres: mutable darray[RhUnresolved] = []
        cproot3: i64 = |cpb, cjnodes, cjtexts, cppkgs, cppool, cpreqs, cpedges, cpunres|
            cpunk: mutable i64 = 0
            block_result: i64 = rh_composer_parse(cpb, cjnodes, cjtexts, cppkgs, cppool, cpreqs, cpedges, cpunres, &cpunk)
            block_result
        if cproot3 < 0:
            rh_cli_err("deps: malformed composer.lock (structured failure, no partial graph)")
            return 4
        cpunsup: i64 = rh_unsupported_range_count(cpreqs, cppool)
        cpfind: mutable darray[RhAdvisory] = []
        cpwd: mutable i64 = 0
        cpsk: mutable i64 = 0
        if resolved_has_osv:
            _ = rh_osv_match(cppkgs, cppool, osv_nodes, osv_texts, osv_root, cpfind, &cpwd, &cpsk)
        cpg: mutable darray[u8] = []
        rh_graph_write_json(cpg, 5, cppkgs, cppool, cpedges, cpunres, cpfind, osv_texts, cproot3)
        cpg.push(10)
        cpf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-composer-graph.json", cpf):
            rh_cli_err("deps: cannot stage composer graph path")
            return 4
        cpfp: cstr = (&cpf[0]).cast[cstr] can Unsafe.PointerCast
        if not rh_io_write(cpfp, cpg):
            rh_cli_err("deps: cannot write composer graph")
            return 4
        eco_codes.push(5)
        declared.push(cpreqs.count.i64())
        resolved.push(cpedges.count.i64())
        unresolved_n.push(cpunres.count.i64())
        unsupported_n.push(cpunsup)
        found <- found + 1

    # --- packages.config (NuGet) ---
    ncfg: mutable darray[u8] = []
    if not rh_out_path(repo, "packages.config", ncfg):
        rh_cli_err("deps: bad repo path")
        return 3
    ncfgp: cstr = (&ncfg[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(ncfgp):
        nb: mutable darray[u8] = []
        if rh_io_read(ncfgp, nb) < 0:
            rh_cli_err("deps: cannot read packages.config")
            return 4
        nupkgs: mutable darray[RhPkgNode] = []
        nupool: mutable darray[u8] = []
        nureqs: mutable darray[RhRequire] = []
        nuedges: mutable darray[RhDepEdge] = []
        nuunres: mutable darray[RhUnresolved] = []
        nuroot: i64 = |nb, nupkgs, nupool, nureqs, nuedges, nuunres|
            nunk: mutable i64 = 0
            block_result: i64 = rh_nuget_parse(nb, nupkgs, nupool, nureqs, nuedges, nuunres, &nunk)
            block_result
        if nuroot < 0:
            rh_cli_err("deps: malformed packages.config (structured failure, no partial graph)")
            return 4
        nuunsup: i64 = rh_unsupported_range_count(nureqs, nupool)
        nufind: mutable darray[RhAdvisory] = []
        nuwd: mutable i64 = 0
        nusk: mutable i64 = 0
        if resolved_has_osv:
            _ = rh_osv_match(nupkgs, nupool, osv_nodes, osv_texts, osv_root, nufind, &nuwd, &nusk)
        nug: mutable darray[u8] = []
        rh_graph_write_json(nug, 6, nupkgs, nupool, nuedges, nuunres, nufind, osv_texts, nuroot)
        nug.push(10)
        nuf: mutable darray[u8] = []
        if not rh_out_path(out, "deps-nuget-graph.json", nuf):
            rh_cli_err("deps: cannot stage nuget graph path")
            return 4
        nufp: cstr = (&nuf[0]).cast[cstr] can Unsafe.PointerCast
        if not rh_io_write(nufp, nug):
            rh_cli_err("deps: cannot write nuget graph")
            return 4
        eco_codes.push(6)
        declared.push(nureqs.count.i64())
        resolved.push(nuedges.count.i64())
        unresolved_n.push(nuunres.count.i64())
        unsupported_n.push(nuunsup)
        found <- found + 1

    # --- pom.xml (Maven) ---
    pom: mutable darray[u8] = []
    if not rh_out_path(repo, "pom.xml", pom):
        rh_cli_err("deps: bad repo path")
        return 3
    pomp: cstr = (&pom[0]).cast[cstr] can Unsafe.PointerCast
    if file_exists(pomp):
        pomb: mutable darray[u8] = []
        if rh_io_read(pomp, pomb) < 0:
            rh_cli_err("deps: cannot read pom.xml")
            return 4
        mpkgs: mutable darray[RhPkgNode] = []
        mpool: mutable darray[u8] = []
        mreqs: mutable darray[RhRequire] = []
        medges: mutable darray[RhDepEdge] = []
        munres: mutable darray[RhUnresolved] = []
        mroot: i64 = |pomb, mpkgs, mpool, mreqs, medges, munres|
            munk: mutable i64 = 0
            block_result: i64 = rh_maven_parse(pomb, mpkgs, mpool, mreqs, medges, munres, &munk)
            block_result
        if mroot < 0:
            rh_cli_err("deps: malformed pom.xml bounded Maven subset (structured failure, no partial graph)")
            return 4
        munsup: i64 = rh_unsupported_range_count(mreqs, mpool)
        mfind: mutable darray[RhAdvisory] = []
        mwd: mutable i64 = 0
        msk: mutable i64 = 0
        if resolved_has_osv:
            _ = rh_osv_match(mpkgs, mpool, osv_nodes, osv_texts, osv_root, mfind, &mwd, &msk)
        mg: mutable darray[u8] = []
        rh_graph_write_json(mg, 7, mpkgs, mpool, medges, munres, mfind, osv_texts, mroot)
        mg.push(10)
        mf2: mutable darray[u8] = []
        if not rh_out_path(out, "deps-maven-graph.json", mf2):
            rh_cli_err("deps: cannot stage maven graph path")
            return 4
        mf2p: cstr = (&mf2[0]).cast[cstr] can Unsafe.PointerCast
        if not rh_io_write(mf2p, mg):
            rh_cli_err("deps: cannot write maven graph")
            return 4
        eco_codes.push(7)
        declared.push(mreqs.count.i64())
        resolved.push(medges.count.i64())
        unresolved_n.push(munres.count.i64())
        unsupported_n.push(munsup)
        found <- found + 1

    if found == 0:
        rh_cli_err("deps: no supported dependency manifest found in repo")
        return 4
    mf: mutable darray[u8] = []
    if not rh_out_path(out, "deps-metrics.json", mf):
        rh_cli_err("deps: cannot stage metrics path")
        return 4
    mb: mutable darray[u8] = []
    rh_deps_metrics_emit(mb, eco_codes, declared, resolved, unresolved_n, unsupported_n)
    mb.push(10)
    mfp: cstr = (&mf[0]).cast[cstr] can Unsafe.PointerCast
    if not rh_io_write(mfp, mb):
        rh_cli_err("deps: cannot write deps-metrics.json")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        rh_push_text(done, "deps: ecosystems=")
        rh_push_decimal_i64(done, found)
        done
    while i < eco_codes.count.i64() |i: i64 = 0, eco_codes, declared, resolved, unresolved_n, unsupported_n, done|:
        rh_push_text(done, " ")
        rh_push_text(done, rh_deps_eco(eco_codes[i.usize()]))
        rh_push_text(done, "=")
        rh_push_decimal_i64(done, resolved[i.usize()])
        rh_push_text(done, "/")
        rh_push_decimal_i64(done, declared[i.usize()])
        rh_push_text(done, " unresolved=")
        rh_push_decimal_i64(done, unresolved_n[i.usize()])
        rh_push_text(done, " unsupported=")
        rh_push_decimal_i64(done, unsupported_n[i.usize()])
        i <- i + 1
    done.push(10)
    rh_write_stdout(done)
    0

# --- M03-09 deps.dev enrichment adapter. ---
# Captures one provider version response with bounded transport evidence and
# emits a provenance/coverage record. This sidecar never changes the local
# dependency graph and therefore remains optional when the provider is down.
def rh_do_depsdev(input_path: cstr, out_path: cstr, source_url: cstr, has_url: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected depsdev output argument (allowlist)")
        return 3
    raw: mutable darray[u8] = []
    status_value: mutable darray[u8] = []
    status_ptr: mutable cstr = ""
    if has_url:
        return 3 if not Git::rh_fetch_arg_safe(source_url)
        fetch_dir: mutable darray[u8] = []
        if not rh_dirname(out_path, fetch_dir):
            rh_push_text(fetch_dir, ".")
        fetch_dir.push(0)
        fetch_dir_ptr: cstr = (&fetch_dir[0]).cast[cstr] can Unsafe.PointerCast
        body_path: mutable darray[u8] = []
        code_path: mutable darray[u8] = []
        err_path: mutable darray[u8] = []
        if not rh_out_path(fetch_dir_ptr, "depsdev-fetch-body.json", body_path) or not rh_out_path(fetch_dir_ptr, "depsdev-fetch-status.txt", code_path) or not rh_out_path(fetch_dir_ptr, "depsdev-fetch.err", err_path):
            rh_cli_err("depsdev: cannot stage fetch evidence")
            return 4
        body_path.push(0)
        code_path.push(0)
        err_path.push(0)
        body_ptr: cstr = (&body_path[0]).cast[cstr] can Unsafe.PointerCast
        code_ptr: cstr = (&code_path[0]).cast[cstr] can Unsafe.PointerCast
        err_ptr: cstr = (&err_path[0]).cast[cstr] can Unsafe.PointerCast
        return 4 if Git::rh_run_https_get(source_url, body_ptr, code_ptr, err_ptr) != 0
        code_raw: mutable darray[u8] = []
        if rh_io_read(code_ptr, code_raw) < 0 or code_raw.count == 0:
            rh_cli_err("depsdev: fetch did not produce a status")
            return 4
        ok_status: bool = code_raw[0] == 50
        file_transport: bool = code_raw.count >= 3 and code_raw[0] == 48 and code_raw[1] == 48 and code_raw[2] == 48 and rh_cstr_starts_with(source_url, "file://")
        if not ok_status and not file_transport:
            rh_cli_err("depsdev: fetch returned non-2xx; enrichment unavailable")
            return 4
        status_value.extend(bytes_view(code_raw))
        status_value.push(0)
        status_ptr <- (&status_value[0]).cast[cstr] can Unsafe.PointerCast
        url_data: mutable darray[u8] = []
        rh_push_cstr(url_data, source_url)
        status_doc: mutable darray[u8] = []
        rh_push_text(status_doc, "{\"schema\":\"rh-depsdev-fetch/1\",\"source_url\":\"")
        rh_json_escape(status_doc, url_data, 0, url_data.count)
        rh_push_text(status_doc, "\",\"status\":\"")
        code_data: u8& = (&code_raw[0]).cast[u8&] can Unsafe.PointerCast
        rh_push_raw(status_doc, code_data, code_raw.count)
        rh_push_text(status_doc, "\",\"body_file\":\"depsdev-fetch-body.json\",\"state\":\"collected\",\"note\":\"optional provider capture retained before adapter parsing\"}\n")
        return 4 if not rh_io_write(code_ptr, status_doc)
        return 4 if rh_io_read(body_ptr, raw) < 0
    else:
        return 3 if not Git::rh_arg_safe(input_path)
        if rh_io_read(input_path, raw) < 0:
            rh_cli_err("depsdev: cannot read --input")
            return 4
    body: mutable darray[u8] = []
    if DepsDev::rh_depsdev_report(raw, body, source_url, status_ptr, has_url) != 0:
        rh_cli_err("depsdev: unsupported or malformed provider response (fail closed)")
        return 4
    body.push(10)
    return 4 if not rh_io_write(out_path, body)
    rh_cli_out("depsdev: enrichment observed")
    0

# --- M03-10 bounded ecosyste.ms package lookup capture. ---
