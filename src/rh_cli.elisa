def rh_ecosystem_lookup_write_transformation(input: darray[u8]&, output: darray[u8]&, out_path: cstr) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    configuration: mutable darray[u8] = []
    Base::rh_push_text(configuration, "repo-health/ecosyste.ms-package-lookup/1")
    configuration_sha: mutable darray[u8] = []
    input_sha: mutable darray[u8] = []
    output_sha: mutable darray[u8] = []
    Sha256::rh_sha256(configuration, configuration_sha)
    Sha256::rh_sha256(input, input_sha)
    Sha256::rh_sha256(output, output_sha)
    report: mutable darray[u8] = []
    EcosystemLookupTransformation::rh_ecosystem_lookup_transformation_report(configuration_sha, input_sha, output_sha, report)
    report.push(10)
    report_path: mutable darray[u8] = []
    Base::rh_push_cstr(report_path, out_path)
    Base::rh_push_text(report_path, ".transformations.json")
    report_path.push(0)
    report_ptr: cstr = (&report_path[0]).cast[cstr] can Unsafe.PointerCast
    Base::rh_io_write(report_ptr, report)

def rh_do_ecosystem_lookup(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected ecosystem lookup argument (allowlist)")
        return 3
    raw: mutable darray[u8] = []
    if Base::rh_io_read(input_path, raw) < 0:
        rh_cli_err("ecosystem lookup: cannot read --input")
        return 4
    body: mutable darray[u8] = []
    if EcosystemLookup::rh_ecosystem_lookup_report(raw, body) != 0:
        rh_cli_err("ecosystem lookup: unsupported or malformed capture (fail closed)")
        return 4
    body.push(10)
    return 4 if not Base::rh_io_write(out_path, body)
    if not rh_ecosystem_lookup_write_transformation(raw, body, out_path):
        rh_cli_err("ecosystem lookup: cannot write transformation report")
        return 4
    rh_cli_out("ecosystem lookup: captured enrichment observed")
    0

def rh_do_ecosystem_lookup_live(ecosystem: cstr, name: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    return 3 if not Git::rh_arg_safe(out_path)
    source_url: mutable darray[u8] = []
    if not EcosystemLookup::rh_ecosystem_lookup_request_url(ecosystem, name, source_url):
        rh_cli_err("ecosystem lookup: rejected package coordinate")
        return 3
    source_url_ptr: cstr = (&source_url[0]).cast[cstr] can Unsafe.PointerCast
    return 3 if not Git::rh_fetch_arg_safe(source_url_ptr) or not Git::rh_fetch_guard(source_url_ptr)

    fetch_dir: mutable darray[u8] = []
    if not rh_dirname(out_path, fetch_dir):
        Base::rh_push_text(fetch_dir, ".")
    fetch_dir.push(0)
    fetch_dir_ptr: cstr = (&fetch_dir[0]).cast[cstr] can Unsafe.PointerCast
    body_path: mutable darray[u8] = []
    code_path: mutable darray[u8] = []
    err_path: mutable darray[u8] = []
    if not rh_out_path(fetch_dir_ptr, "ecosystem-lookup-fetch-body.json", body_path) or not rh_out_path(fetch_dir_ptr, "ecosystem-lookup-fetch-status.txt", code_path) or not rh_out_path(fetch_dir_ptr, "ecosystem-lookup-fetch.err", err_path):
        rh_cli_err("ecosystem lookup: cannot stage fetch evidence")
        return 4
    body_path.push(0)
    code_path.push(0)
    err_path.push(0)
    body_ptr: cstr = (&body_path[0]).cast[cstr] can Unsafe.PointerCast
    code_ptr: cstr = (&code_path[0]).cast[cstr] can Unsafe.PointerCast
    err_ptr: cstr = (&err_path[0]).cast[cstr] can Unsafe.PointerCast
    if Git::rh_run_https_get(source_url_ptr, body_ptr, code_ptr, err_ptr) != 0:
        rh_cli_err("ecosystem lookup: guarded transport failed; evidence retained where available")
        return 4

    code_raw: mutable darray[u8] = []
    if Base::rh_io_read(code_ptr, code_raw) < 0 or not Base::rh_bytes_equal_literal(code_raw, 0, code_raw.count.i64(), "200"):
        rh_cli_err("ecosystem lookup: provider did not return HTTP 200; enrichment unavailable")
        return 4
    raw: mutable darray[u8] = []
    if Base::rh_io_read(body_ptr, raw) < 0 or raw.count.i64() > 4194304:
        rh_cli_err("ecosystem lookup: response exceeds the 4 MiB parser bound")
        return 4

    status_value: mutable darray[u8] = []
    Base::rh_absorb_bytes(code_raw, status_value)
    status_value.push(0)
    status_ptr: cstr = (&status_value[0]).cast[cstr] can Unsafe.PointerCast
    body: mutable darray[u8] = []
    if EcosystemLookup::rh_ecosystem_lookup_live_report(raw, ecosystem, name, source_url_ptr, status_ptr, body) != 0:
        rh_cli_err("ecosystem lookup: unsupported or malformed provider response (fail closed)")
        return 4
    body.push(10)
    if not Base::rh_io_write(out_path, body):
        rh_cli_err("ecosystem lookup: cannot write result")
        return 4
    if not rh_ecosystem_lookup_write_transformation(raw, body, out_path):
        rh_cli_err("ecosystem lookup: cannot write transformation report")
        return 4
    rh_cli_out("ecosystem lookup: one attributed package result captured")
    0

