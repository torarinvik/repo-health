# Integer argv value: copy to scratch, then parse (argv is cstr).
def rh_parse_cstr_int(s: cstr, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    scratch: mutable darray[u8] = []
    Base::rh_push_cstr(scratch, s)
    Base::rh_parse_i64(scratch, 0, scratch.count, ok_out)

# Directory part of a path (bytes before the last '/'). False when none.
def rh_dirname(path: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: usize = Base::rh_cstr_len_c(path)
    return false if n == 0
    last: i64 =
        while i < n |last: i64 = -1, i: usize = 0| -> last:
            if path[i] == 47:
                last <- i.i64()
            i <- i + 1
    return false if last < 0
    while j < last.usize() |j: usize = 0, path, out|:
        out.push(path[j])
        j <- j + 1
    true

def rh_cli_version() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    rh_cli_out("rh_cli 0.1.0 (M01 slice; Elisa reference implementation)")
    0

def rh_cli_registry() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    summary: mutable darray[u8] =
        line: mutable darray[u8] = []
        Base::rh_push_text(line, "registry: ")
        Base::rh_push_decimal_i64(line, Registry::rh_reg_implemented_count())
        Base::rh_push_text(line, " implemented, 2 prototype of 360 architecture candidates (remainder planned)\n")
        line
    Base::rh_write_stdout(summary)
    while i < Registry::rh_reg_count() |i: i64 = 0|:
        line: mutable darray[u8] =
            line: mutable darray[u8] = []
            Base::rh_push_text(line, Registry::rh_reg_key(i))
            Base::rh_push_text(line, " ")
            Base::rh_push_text(line, Registry::rh_reg_version(i))
            Base::rh_push_text(line, " ")
            Base::rh_push_text(line, Registry::rh_reg_unit(i))
            Base::rh_push_text(line, " ")
            Base::rh_push_text(line, Registry::rh_reg_status(i))
            line.push(10)
            line
        Base::rh_write_stdout(line)
        i <- i + 1
    0

# Join dir + "/" + name as a NUL-terminated cstr buffer. False on empty dir.
def rh_out_path(dir: cstr, name: u8&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if Base::rh_cstr_len_c(dir) == 0
    Base::rh_push_cstr(out, dir)
    out.push(47)
    Base::rh_push_text(out, name)
    out.push(0)
    true

def rh_do_scan(repo: cstr, out: cstr, full: bool, window_days: i64) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    kind: u8 = Git::rh_url_kind(repo)
    if kind == Git::RH_URL_UNSUPPORTED:
        rh_cli_err("unsupported repository (want local path or public https URL)")
        return 3
    if not Git::rh_arg_safe(repo):
        rh_cli_err("rejected repository argument (allowlist)")
        return 3
    if not Git::rh_arg_safe(out):
        rh_cli_err("rejected output argument (allowlist)")
        return 3
    cutoff: i64 = Base::rh_now()
    if cutoff < 0:
        rh_cli_err("no clock available; refusing windowed scan")
        return 4
    window_start: i64 = cutoff - window_days * 86400 if not full else 0
    evdir: mutable darray[u8] = []
    if not rh_out_path(out, "evidence", evdir):
        rh_cli_err("bad output directory")
        return 3
    evc: cstr = (&evdir[0]).cast[cstr] can Unsafe.PointerCast
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("cannot create output directory")
        return 4
    if Git::rh_ensure_dir(evc) != 0:
        rh_cli_err("cannot create evidence directory")
        return 4
    scan_repo: mutable cstr = repo
    clone_here: mutable darray[u8] = []
    if kind == Git::RH_URL_HTTPS:
        if not rh_out_path(evc, "remote.git", clone_here):
            rh_cli_err("cannot stage clone path")
            return 4
        dest: cstr = (&clone_here[0]).cast[cstr] can Unsafe.PointerCast
        clerr: mutable darray[u8] = []
        if not rh_out_path(evc, "git-clone.err", clerr):
            rh_cli_err("cannot stage clone log")
            return 4
        clerrp: cstr = (&clerr[0]).cast[cstr] can Unsafe.PointerCast
        if Git::rh_run_git_clone(repo, dest, clerrp, full) != 0:
            rh_cli_err("clone failed; see evidence/git-clone.err (no partial report)")
            return 4
        scan_repo <- dest
    is_local: bool = kind == Git::RH_URL_LOCAL
    logf: mutable darray[u8] = []
    defaultf: mutable darray[u8] = []
    shaf: mutable darray[u8] = []
    filesf: mutable darray[u8] = []
    verf: mutable darray[u8] = []
    loge: mutable darray[u8] = []
    defaulte: mutable darray[u8] = []
    shae: mutable darray[u8] = []
    fileserr: mutable darray[u8] = []
    vere: mutable darray[u8] = []
    if not rh_out_path(evc, "git-log.bin", logf):
        rh_cli_err("cannot stage log path")
        return 4
    if not rh_out_path(evc, "git-default-count.txt", defaultf):
        rh_cli_err("cannot stage default count path")
        return 4
    if not rh_out_path(evc, "git-shallow.txt", shaf):
        rh_cli_err("cannot stage shallow path")
        return 4
    if not rh_out_path(evc, "git-files.txt", filesf):
        rh_cli_err("cannot stage file-list path")
        return 4
    if not rh_out_path(evc, "git-version.txt", verf):
        rh_cli_err("cannot stage version path")
        return 4
    partf: mutable darray[u8] = []
    parte: mutable darray[u8] = []
    if not rh_out_path(evc, "git-partial.txt", partf):
        rh_cli_err("cannot stage partial path")
        return 4
    if not rh_out_path(evc, "git-partial.err", parte):
        rh_cli_err("cannot stage partial error path")
        return 4
    if not rh_out_path(evc, "git-log.err", loge):
        rh_cli_err("cannot stage log error path")
        return 4
    if not rh_out_path(evc, "git-default-count.err", defaulte):
        rh_cli_err("cannot stage default count error path")
        return 4
    if not rh_out_path(evc, "git-shallow.err", shae):
        rh_cli_err("cannot stage shallow error path")
        return 4
    if not rh_out_path(evc, "git-files.err", fileserr):
        rh_cli_err("cannot stage file-list error path")
        return 4
    if not rh_out_path(evc, "git-version.err", vere):
        rh_cli_err("cannot stage version error path")
        return 4
    logp: cstr = (&logf[0]).cast[cstr] can Unsafe.PointerCast
    defaultp: cstr = (&defaultf[0]).cast[cstr] can Unsafe.PointerCast
    shap: cstr = (&shaf[0]).cast[cstr] can Unsafe.PointerCast
    filesp: cstr = (&filesf[0]).cast[cstr] can Unsafe.PointerCast
    verp: cstr = (&verf[0]).cast[cstr] can Unsafe.PointerCast
    verep: cstr = (&vere[0]).cast[cstr] can Unsafe.PointerCast
    fileserrp: cstr = (&fileserr[0]).cast[cstr] can Unsafe.PointerCast
    if Git::rh_run_git_version(verp, verep) != 0:
        rh_cli_err("git --version failed")
        return 4
    partp: cstr = (&partf[0]).cast[cstr] can Unsafe.PointerCast
    partep: cstr = (&parte[0]).cast[cstr] can Unsafe.PointerCast
    _ = Git::rh_run_git_partial(scan_repo, partp, partep)
    shaep: cstr = (&shae[0]).cast[cstr] can Unsafe.PointerCast
    if Git::rh_run_git_shallow(scan_repo, shap, shaep) != 0:
        rh_cli_err("rev-parse failed (not a repository?)")
        return 4
    _ = Git::rh_run_git_files(scan_repo, filesp, fileserrp)
    logep: cstr = (&loge[0]).cast[cstr] can Unsafe.PointerCast
    if Git::rh_run_git_log(scan_repo, logp, logep, full) != 0:
        headerr: mutable darray[u8] = []
        if not rh_out_path(evc, "git-head.err", headerr):
            rh_cli_err("cannot stage head error path")
            return 4
        if Git::rh_run_git_head(scan_repo, (&headerr[0]).cast[cstr] can Unsafe.PointerCast) != 0:
            rh_cli_err("note: repository has no commits yet; reporting observed-empty history")
            empty_log: mutable darray[u8] = []
            if not Base::rh_io_write(logp, empty_log):
                rh_cli_err("cannot write empty log evidence")
                return 4
        else:
            rh_cli_err("git log failed; see evidence/git-log.err (no partial report)")
            return 4
    defaultep: cstr = (&defaulte[0]).cast[cstr] can Unsafe.PointerCast
    _ = Git::rh_run_git_default_count(scan_repo, defaultp, defaultep)
    shab: mutable darray[u8] = []
    if Base::rh_io_read(shap, shab) < 0:
        rh_cli_err("cannot read shallow evidence")
        return 4
    shallow: mutable i64 = 1
    if shab.count >= 5:
        if shab[0] == 102 and shab[1] == 97 and shab[2] == 108 and shab[3] == 115 and shab[4] == 101:
            shallow <- 0
    logb: mutable darray[u8] = []
    if Base::rh_io_read(logp, logb) < 0:
        rh_cli_err("cannot read log evidence (over size cap?)")
        return 4
    snap: mutable Scan::RhSnapshot = Scan::RhSnapshot{commits_all: 0, commits: 0, rejected: 0, merges: 0, future: 0, skew: 0, has_commits: 0, min_at: 0, max_at: 0, min_ct: 0, max_ct: 0, oldest_at: 0, email_lines: 0, shallow: 0, truncated: 0, manifest: 0, digest: 0}
    Scan::rh_snapshot_init(&snap)
    months: mutable darray[i64] = []
    emails: mutable darray[u8] = []
    activity: mutable GitMetrics::RhActivity = GitMetrics::RhActivity{author_times: [], committer_times: [], actor_keys: [], parent_counts: [], bot_flags: []}
    GitMetrics::rh_activity_init(&activity)
    _ = Scan::rh_parse_log(logb, window_start, cutoff, &snap, months, emails, &activity)
    defaultb: mutable darray[u8] = []
    default_revisions: mutable i64 = -1
    if Base::rh_io_read(defaultp, defaultb) >= 0:
        default_end: i64 = Base::rh_find_byte(defaultb, 0, 10)
        default_stop: usize = default_end.usize() if default_end >= 0 else defaultb.count
        default_ok: mutable i64 = 0
        default_revisions <- Base::rh_parse_i64(defaultb, 0, default_stop, &default_ok)
        default_revisions <- -1 if default_ok == 0
    if default_revisions < 0 and snap.commits_all == 0:
        empty_default: mutable darray[u8] = []
        empty_default.push(48)
        empty_default.push(10)
        _ = Base::rh_io_write(defaultp, empty_default)
        default_revisions <- 0
    snap.shallow <- shallow
    git_metrics: GitMetrics::RhMetrics = GitMetrics::rh_metrics(activity, window_start, cutoff, shallow, full)
    partb: mutable darray[u8] = []
    partial_clone: mutable i64 = 0
    if Base::rh_io_read(partp, partb) >= 0:
        if partb.count > 0:
            partial_clone <- 1
    bound_hit: mutable bool = false
    if not full:
        if snap.commits_all >= Git::RH_DEFAULT_MAX_COMMITS:
            bound_hit <- true
        if kind == Git::RH_URL_HTTPS and snap.commits_all >= 5000:
            bound_hit <- true
        # S012 test hook: RH_SCAN_MAX_COMMITS lets the suite exercise the
        # truncation path with a small fixture. It can only lower the bound,
        # never remove it, and the real bound is the constant above.
        env_cap: u8&? = getenv("RH_SCAN_MAX_COMMITS")
        if env_cap != null:
            scratch: mutable darray[u8] = []
            Base::rh_push_cstr(scratch, env_cap.cast[cstr] can Unsafe.PointerCast)
            ok_cap: mutable i64 = 0
            capv: i64 = Base::rh_parse_i64(scratch, 0, scratch.count, &ok_cap)
            if ok_cap == 1 and capv > 0 and capv < Git::RH_DEFAULT_MAX_COMMITS:
                if snap.commits_all >= capv:
                    bound_hit <- true
    if bound_hit:
        snap.truncated <- 1
    maill: mutable darray[u8] = []
    if not rh_out_path(evc, "emails.txt", maill):
        rh_cli_err("cannot stage emails path")
        return 4
    mailp: cstr = (&maill[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(mailp, emails):
        rh_cli_err("cannot write emails evidence")
        return 4
    uniq: mutable darray[u8] = []
    if not rh_out_path(evc, "emails.uniq", uniq):
        rh_cli_err("cannot stage uniq path")
        return 4
    uniqp: cstr = (&uniq[0]).cast[cstr] can Unsafe.PointerCast
    sorterr: mutable darray[u8] = []
    if not rh_out_path(evc, "sort.err", sorterr):
        rh_cli_err("cannot stage sort error path")
        return 4
    sorterrp: cstr = (&sorterr[0]).cast[cstr] can Unsafe.PointerCast
    if Git::rh_run_sort_uniq(mailp, uniqp, sorterrp) != 0:
        rh_cli_err("sort -u failed")
        return 4
    uniqb: mutable darray[u8] = []
    if Base::rh_io_read(uniqp, uniqb) < 0:
        rh_cli_err("cannot read uniq evidence")
        return 4
    identities: i64 = Base::rh_count_lines(uniqb)
    bots: i64 = Report::rh_count_bot_lines(uniqb)
    filesb: mutable darray[u8] = []
    files: Files::RhFileMetrics =
        if Base::rh_io_read(filesp, filesb) >= 0 and snap.commits_all > 0:
            Files::rh_file_metrics(filesb)
        else:
            Files::RhFileMetrics{readme: -1, contributing: -1, license: -1, installation: -1, api_reference: -1, governance: -1, code_ownership: -1, notice: -1, release_process: -1, succession_process: -1, license_files: -1, examples: -1, security_policy: -1, release_notes: -1, source_files: -1, ci_configuration: -1, test_files: -1, source_bytes: -1, missing_objects: -1}
    snap.manifest <- Scan::rh_manifest_probe(repo, is_local)
    cov_n: mutable i64 = 0
    cov_d: mutable i64 = 0
    cov_v2_n: mutable i64 = 0
    cov_v2_d: mutable i64 = 0
    cov_s: mutable i64 = 0
    Scan::rh_coverage(&snap, window_start, cutoff, &cov_n, &cov_d, &cov_v2_n, &cov_v2_d, &cov_s)
    fresh: mutable i64 = -1
    if snap.has_commits == 1:
        top: mutable i64 = snap.max_at
        if snap.max_ct > top:
            top <- snap.max_ct
        fresh <- (cutoff - top) / 3600
        if fresh < 0:
            fresh <- 0
    kind_num: i64 = 1 if kind == Git::RH_URL_HTTPS else 0
    full_num: i64 = 1 if full else 0
    ctx: Report::RhReportCtx = Report::rh_report_ctx_make(identities, bots, months.count.i64(), cov_n, cov_d, cov_v2_n, cov_v2_d, cov_s, fresh, window_days, full_num, kind_num, cutoff, partial_clone, default_revisions, files, git_metrics)
    repj: mutable darray[u8] = []
    repm: mutable darray[u8] = []
    manf: mutable darray[u8] = []
    if not rh_out_path(out, "report.json", repj):
        rh_cli_err("cannot stage report path")
        return 4
    if not rh_out_path(out, "report.md", repm):
        rh_cli_err("cannot stage markdown path")
        return 4
    if not rh_out_path(out, "bundle.manifest", manf):
        rh_cli_err("cannot stage manifest path")
        return 4
    repjp: cstr = (&repj[0]).cast[cstr] can Unsafe.PointerCast
    if not Report::rh_write_report_json(repjp, repo, &snap, &ctx):
        rh_cli_err("cannot write report.json")
        return 4
    repmp: cstr = (&repm[0]).cast[cstr] can Unsafe.PointerCast
    if not Report::rh_write_report_md(repmp, repo, &snap, &ctx):
        rh_cli_err("cannot write report.md")
        return 4
    manp: cstr = (&manf[0]).cast[cstr] can Unsafe.PointerCast
    if not Report::rh_write_manifest(manp, repo, &snap, &ctx):
        rh_cli_err("cannot write bundle.manifest")
        return 4
    done: mutable darray[u8] =
        done: mutable darray[u8] = []
        Base::rh_push_text(done, "scan: commits=")
        Base::rh_push_decimal_i64(done, snap.commits)
        Base::rh_push_text(done, " identities=")
        Base::rh_push_decimal_i64(done, identities)
        Base::rh_push_text(done, " months=")
        Base::rh_push_decimal_i64(done, months.count.i64())
        Base::rh_push_text(done, " digest=fnv1a64:")
        Base::rh_push_hex_u64(done, snap.digest)
        done.push(10)
        done
    Base::rh_write_stdout(done)
    0

def rh_do_replay(bundle: cstr, out: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(bundle):
        rh_cli_err("rejected bundle argument (allowlist)")
        return 3
    if not Git::rh_arg_safe(out):
        rh_cli_err("rejected output argument (allowlist)")
        return 3
    manb: mutable darray[u8] = []
    bpath: mutable darray[u8] =
        bpath: mutable darray[u8] = []
        Base::rh_push_cstr(bpath, bundle)
        bpath.push(0)
        bpath
    bp: cstr = (&bpath[0]).cast[cstr] can Unsafe.PointerCast
    if Base::rh_io_read(bp, manb) < 0:
        rh_cli_err("cannot read bundle manifest")
        return 4
    pinned: mutable u64 = 0
    if not Report::rh_manifest_digest(manb, &pinned):
        rh_cli_err("manifest has no parseable digest (fails closed)")
        return 4
    ok_commits: mutable i64 = 0
    want_commits: i64 = Report::rh_report_manifest_int(manb, "commits: ", &ok_commits)
    if ok_commits == 0:
        rh_cli_err("manifest has no parseable commits count")
        return 4
    ok_rej: mutable i64 = 0
    want_rejected: i64 = Report::rh_report_manifest_int(manb, "rejected: ", &ok_rej)
    if ok_rej == 0:
        rh_cli_err("manifest has no parseable rejected count")
        return 4
    ok_days: mutable i64 = 0
    days: i64 = Report::rh_report_manifest_int(manb, "window-days: ", &ok_days)
    if ok_days == 0:
        rh_cli_err("manifest has no parseable window-days")
        return 4
    full: bool = Report::rh_report_manifest_flag(manb, "full-history: ") == 1
    ok_cut: mutable i64 = 0
    cutoff: i64 = Report::rh_report_manifest_int(manb, "evidence-cutoff: ", &ok_cut)
    if ok_cut == 0 or cutoff <= 0:
        rh_cli_err("manifest has no parseable evidence-cutoff")
        return 4
    ok_default: mutable i64 = 0
    want_default: i64 = Report::rh_report_manifest_int(manb, "default-revisions: ", &ok_default)
    if ok_default == 0:
        rh_cli_err("manifest has no parseable default revision count")
        return 4
    logpath: mutable darray[u8] = []
    has_dir: bool = rh_dirname(bundle, logpath)
    if has_dir:
        logpath.push(47)
    Base::rh_push_text(logpath, "evidence/git-log.bin")
    logpath.push(0)
    lp: cstr = (&logpath[0]).cast[cstr] can Unsafe.PointerCast
    logb: mutable darray[u8] = []
    if Base::rh_io_read(lp, logb) < 0:
        rh_cli_err("cannot read retained log evidence (no live data substituted)")
        return 4
    defaultpath: mutable darray[u8] = []
    has_default_dir: bool = rh_dirname(bundle, defaultpath)
    if has_default_dir:
        defaultpath.push(47)
    Base::rh_push_text(defaultpath, "evidence/git-default-count.txt")
    defaultpath.push(0)
    defaultp: cstr = (&defaultpath[0]).cast[cstr] can Unsafe.PointerCast
    defaultb: mutable darray[u8] = []
    if Base::rh_io_read(defaultp, defaultb) < 0:
        rh_cli_err("cannot read retained default revision evidence")
        return 4
    default_end: i64 = Base::rh_find_byte(defaultb, 0, 10)
    default_stop: usize = default_end.usize() if default_end >= 0 else defaultb.count
    default_ok: mutable i64 = 0
    default_revisions: i64 = Base::rh_parse_i64(defaultb, 0, default_stop, &default_ok)
    if default_ok == 0 or default_revisions != want_default:
        rh_cli_err("default revision evidence does not match manifest")
        return 4
    filespath: mutable darray[u8] = []
    has_files_dir: bool = rh_dirname(bundle, filespath)
    if has_files_dir:
        filespath.push(47)
    Base::rh_push_text(filespath, "evidence/git-files.txt")
    filespath.push(0)
    filesp: cstr = (&filespath[0]).cast[cstr] can Unsafe.PointerCast
    retained_files: mutable darray[u8] = []
    if Base::rh_io_read(filesp, retained_files) < 0:
        rh_cli_err("cannot read retained snapshot file evidence")
        return 4
    window_start: i64 = cutoff - days * 86400 if not full else 0
    snap: mutable Scan::RhSnapshot = Scan::RhSnapshot{commits_all: 0, commits: 0, rejected: 0, merges: 0, future: 0, skew: 0, has_commits: 0, min_at: 0, max_at: 0, min_ct: 0, max_ct: 0, oldest_at: 0, email_lines: 0, shallow: 0, truncated: 0, manifest: 0, digest: 0}
    Scan::rh_snapshot_init(&snap)
    months: mutable darray[i64] = []
    emails: mutable darray[u8] = []
    activity: mutable GitMetrics::RhActivity = GitMetrics::RhActivity{author_times: [], committer_times: [], actor_keys: [], parent_counts: [], bot_flags: []}
    GitMetrics::rh_activity_init(&activity)
    _ = Scan::rh_parse_log(logb, window_start, cutoff, &snap, months, emails, &activity)
    if Git::rh_ensure_dir(out) != 0:
        rh_cli_err("cannot create output directory")
        return 4
    rep: mutable darray[u8] = []
    if not rh_out_path(out, "replay.json", rep):
        rh_cli_err("cannot stage replay path")
        return 4
    rb: mutable darray[u8] =
        rb: mutable darray[u8] = []
        Base::rh_push_text(rb, "{\"bundle\":\"")
        Base::rh_push_cstr(rb, bundle)
        Base::rh_push_text(rb, "\",\"verified\":")
        rb
    verified: bool =
        counts_match: bool = snap.commits == want_commits and snap.rejected == want_rejected
        snap.digest == pinned and counts_match
    if verified:
        Base::rh_push_text(rb, "true")
    else:
        Base::rh_push_text(rb, "false")
    Base::rh_push_text(rb, ",\"commits\":")
    Base::rh_push_decimal_i64(rb, snap.commits)
    Base::rh_push_text(rb, ",\"rejected\":")
    Base::rh_push_decimal_i64(rb, snap.rejected)
    Base::rh_push_text(rb, ",\"digest\":\"fnv1a64:")
    Base::rh_push_hex_u64(rb, snap.digest)
    Base::rh_push_text(rb, "\",\"metrics\":[{\"key\":\"coverage.replay_match_share\",\"version\":\"1.0.0\",\"status\":\"observed\",\"value\":{\"num\":")
    Base::rh_push_decimal_i64(rb, 1 if verified else 0)
    Base::rh_push_text(rb, ",\"den\":1},\"evidence\":[\"bundle.manifest\",\"evidence/git-log.bin\"]}]}\n")
    repp: cstr = (&rep[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(repp, rb):
        rh_cli_err("cannot write replay.json")
        return 4
    verdict: mutable darray[u8] = []
    if verified:
        Base::rh_push_text(verdict, "replay: verified (")
        Base::rh_push_decimal_i64(verdict, snap.commits)
        Base::rh_push_text(verdict, " commits)")
    else:
        Base::rh_push_text(verdict, "replay: MISMATCH manifest=")
        Base::rh_push_hex_u64(verdict, pinned)
        Base::rh_push_text(verdict, " recomputed=")
        Base::rh_push_hex_u64(verdict, snap.digest)
    verdict.push(10)
    Base::rh_write_stdout(verdict)
    return 0 if verified
    5

def main(argc: i64, argv: mutable void&) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    return rh_cli_usage(2) if argc < 2
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    cmd: u8& = slots[1].cast[u8&] can Unsafe.PointerCast
    return rh_cli_version() if Base::rh_streq(cmd, "version")
    return rh_cli_usage(0) if Base::rh_streq(cmd, "help")
    return rh_cli_registry() if Base::rh_streq(cmd, "registry")
    if Base::rh_streq(cmd, "scan"):
        repo_idx, out_idx, full, days =
            while i < argc |repo_idx: i64 = -1, out_idx: i64 = -1, full: bool = false, days: i64 = 365, i: i64 = 2, slots| -> repo_idx, out_idx, full, days:
                arg: u8& = slots[i].cast[u8&] can Unsafe.PointerCast
                if Base::rh_streq(arg, "--full-history"):
                    full <- true
                elif Base::rh_streq(arg, "--repo"):
                    if i + 1 < argc:
                        i <- i + 1
                        repo_idx <- i
                    else:
                        return rh_cli_usage(2)
                elif Base::rh_streq(arg, "--out"):
                    if i + 1 < argc:
                        i <- i + 1
                        out_idx <- i
                    else:
                        return rh_cli_usage(2)
                elif Base::rh_streq(arg, "--window-days"):
                    if i + 1 < argc:
                        i <- i + 1
                        ok: mutable i64 = 0
                        parsed: i64 = rh_parse_cstr_int(slots[i], &ok)
                        return rh_cli_usage(2) if ok == 0 or parsed <= 0 or parsed > 36500
                        days <- parsed
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                i <- i + 1
        return rh_cli_usage(2) if repo_idx < 0 or out_idx < 0
        return rh_do_scan(slots[repo_idx], slots[out_idx], full, days)
    if Base::rh_streq(cmd, "replay"):
        bundle_idx, out_idx =
            while j < argc |bundle_idx: i64 = -1, out_idx: i64 = -1, j: i64 = 2, slots| -> bundle_idx, out_idx:
                arg2: u8& = slots[j].cast[u8&] can Unsafe.PointerCast
                if Base::rh_streq(arg2, "--bundle"):
                    if j + 1 < argc:
                        j <- j + 1
                        bundle_idx <- j
                    else:
                        return rh_cli_usage(2)
                elif Base::rh_streq(arg2, "--out"):
                    if j + 1 < argc:
                        j <- j + 1
                        out_idx <- j
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                j <- j + 1
        return rh_cli_usage(2) if bundle_idx < 0 or out_idx < 0
        return rh_do_replay(slots[bundle_idx], slots[out_idx])
    if Base::rh_streq(cmd, "continuity"):
        cb_idx, co_idx =
            while cc < argc |cb_idx: i64 = -1, co_idx: i64 = -1, cc: i64 = 2, slots| -> cb_idx, co_idx:
                arg6: u8& = slots[cc].cast[u8&] can Unsafe.PointerCast
                if Base::rh_streq(arg6, "--bundle"):
                    if cc + 1 < argc:
                        cc <- cc + 1
                        cb_idx <- cc
                    else:
                        return rh_cli_usage(2)
                elif Base::rh_streq(arg6, "--out"):
                    if cc + 1 < argc:
                        cc <- cc + 1
                        co_idx <- cc
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                cc <- cc + 1
        return rh_cli_usage(2) if cb_idx < 0 or co_idx < 0
        return rh_do_continuity(slots[cb_idx], slots[co_idx])

    if Base::rh_streq(cmd, "succession"):
        ssi, sso =
            while ssq < argc |ssi: i64 = -1, sso: i64 = -1, ssq: i64 = 2, slots| -> ssi, sso:
                ass: u8& = slots[ssq].cast[u8&] can Unsafe.PointerCast
                if Base::rh_streq(ass, "--input"):
                    if ssq + 1 < argc:
                        ssq <- ssq + 1
                        ssi <- ssq
                    else:
                        return rh_cli_usage(2)
                elif Base::rh_streq(ass, "--out"):
                    if ssq + 1 < argc:
                        ssq <- ssq + 1
                        sso <- ssq
                    else:
                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                ssq <- ssq + 1
        return rh_cli_usage(2) if ssi < 0 or sso < 0
        return rh_do_succession(slots[ssi], slots[sso])
    if Base::rh_streq(cmd, "deps"):
