    body: mutable darray[u8] = []
    if ForgeEventsFetch::rh_forge_events_github_reviews_live(repository, pull_request, start_page, max_pages, out_path, body) != 0:
        rh_cli_err("forge events: GitHub pull-request review collection failed (see page evidence)")
        return 4
    body.push(10)
    if not Base::rh_io_write(out_path, body):
        rh_cli_err("forge events: cannot write --out")
