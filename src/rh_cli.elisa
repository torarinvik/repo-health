                ssq <- ssq + 1
        return rh_cli_usage(2) if ssi < 0 or sso < 0
        return rh_do_succession(slots[ssi], slots[sso])
    if rh_streq(cmd, "deps"):
        dr_idx, do_idx, dov_idx, dou_idx =
            while dc < argc |dr_idx: i64 = -1, do_idx: i64 = -1, dov_idx: i64 = -1, dou_idx: i64 = -1, dc: i64 = 2, slots| -> dr_idx, do_idx, dov_idx, dou_idx:
                arg7: u8& = slots[dc].cast[u8&] can Unsafe.PointerCast
                if rh_streq(arg7, "--repo"):
