                if continue_pages and page_tokens > 0:
                    next_request: mutable darray[u8] = []
                    next_indices: mutable darray[i64] = []
                    next_count: mutable i64 = 0
                    if OsvQuery::rh_osv_query_batch_next_request(current_request, raw_response, current_indices, next_request, next_indices, &next_count) != 0 or next_count != page_tokens:
                        rh_osv_query_err("osv-query: cannot construct positional batch continuation request")
                        return 4
                    if next_count == 0:
                        done <- true
                    elif page_number >= page_limit:
                        pending_request.extend(bytes_view(next_request))
                        more_available <- true
                        done <- true
                    else:
                        current_request <- next_request
                        current_indices <- next_indices
                else:
                    more_available <- page_tokens > 0
                    done <- true
                if not done:
                    page_number <- page_number + 1
            page_evidence.push(93) if continue_pages or hydrate_advisories
            if continue_pages and more_available:
                remaining: mutable darray[u8] = []
                remaining.extend(bytes_view(pending_request))
                remaining.push(10)
                if not Base::rh_io_write(next_request_ptr, remaining):
                    rh_osv_query_err("osv-query: cannot retain remaining batch request")
                    return 4

            matcher_response: mutable darray[u8] = []
            hydration_evidence: mutable darray[u8] = []
            hydrated_count: mutable i64 = 0
            invalid_hydration_count: mutable i64 = 0
            omitted_hydration_count: mutable i64 = 0
            hydration_failure_count: mutable i64 = 0
            hydration_state: mutable i64 = 0
            if hydrate_advisories:
                if rh_osv_query_hydrate_batch_pages(out, page_count, matcher_response, hydration_evidence, &hydrated_count, &invalid_hydration_count, &omitted_hydration_count, &hydration_failure_count, &hydration_state) != 0:
                    rh_osv_query_err("osv-query: full advisory hydration failed before a complete evidence result")
                    return 4
                matcher_response.push(10)
                if not Base::rh_io_write(matcher_response_ptr, matcher_response):
                    rh_osv_query_err("osv-query: cannot retain hydrated matcher response")
                    return 4
            captured_at: i64 = Base::rh_now()
            is_partial: mutable bool = skipped_count > 0 or omitted_count > 0 or more_available or (hydrate_advisories and hydration_state == 2)
            result: mutable darray[u8] =
                result: mutable darray[u8] = []
                Base::rh_push_text(result, "{\"schema\":\"rh-osv-query-batch-result/3\",\"endpoint\":\"https://api.osv.dev/v1/querybatch\",\"captured_at_epoch\":") if hydrate_advisories
                Base::rh_push_text(result, "{\"schema\":\"rh-osv-query-batch-result/2\",\"endpoint\":\"https://api.osv.dev/v1/querybatch\",\"captured_at_epoch\":") if continue_pages and not hydrate_advisories
                Base::rh_push_text(result, "{\"schema\":\"rh-osv-query-batch-result/1\",\"endpoint\":\"https://api.osv.dev/v1/querybatch\",\"captured_at_epoch\":") if not continue_pages and not hydrate_advisories
                Base::rh_push_decimal_i64(result, captured_at) if captured_at >= 0
                Base::rh_push_text(result, "null") if captured_at < 0
                Base::rh_push_text(result, ",\"http_status\":")
                Base::rh_push_text(result, "200" if query_count > 0 else "null")
                Base::rh_push_text(result, ",\"state\":\"")
                Base::rh_push_text(result, "partial" if is_partial else "empty" if query_count == 0 else "collected")
                Base::rh_push_text(result, "\",\"pagination\":\"") if continue_pages or hydrate_advisories
                Base::rh_push_text(result, "more_available" if more_available else "complete") if continue_pages or hydrate_advisories
                Base::rh_push_text(result, "\",\"response_detail\":\"advisory_ids_with_hydrated_records\"") if hydrate_advisories
                Base::rh_push_text(result, "\",\"response_detail\":\"advisory_ids_only\"") if not hydrate_advisories
                Base::rh_push_text(result, ",\"query_nodes\":")
                result.extend(bytes_view(query_nodes))
                Base::rh_push_text(result, ",\"query_count\":")
                Base::rh_push_decimal_i64(result, query_count)
                Base::rh_push_text(result, ",\"skipped_node_count\":")
                Base::rh_push_decimal_i64(result, skipped_count)
                Base::rh_push_text(result, ",\"omitted_node_count\":")
                Base::rh_push_decimal_i64(result, omitted_count)
                Base::rh_push_text(result, ",\"advisory_id_count\":")
                Base::rh_push_decimal_i64(result, total_advisory_ids)
                Base::rh_push_text(result, ",\"page_token_count\":")
                Base::rh_push_decimal_i64(result, total_page_tokens)
                Base::rh_push_text(result, ",\"request_file\":\"osv-query-batch-request.json\",\"raw_response_file\":")
                Base::rh_push_text(result, "\"osv-query-batch-response.raw.json\"" if query_count > 0 else "null")
                Base::rh_push_text(result, ",\"http_status_file\":")
                Base::rh_push_text(result, "\"osv-query-batch-http-status.txt\"" if query_count > 0 else "null")
                Base::rh_push_text(result, ",\"stderr_file\":")
                Base::rh_push_text(result, "\"osv-query-batch.err\"" if query_count > 0 else "null")
                Base::rh_push_text(result, ",\"raw_response_sha256\":")
                if query_count > 0:
                    result.push(34)
                    result.extend(bytes_view(first_response_hash))
                    result.push(34)
                else:
                    Base::rh_push_text(result, "null")
                if continue_pages or hydrate_advisories:
                    Base::rh_push_text(result, ",\"page_count\":")
                    Base::rh_push_decimal_i64(result, page_count)
                    Base::rh_push_text(result, ",\"page_limit\":")
                    Base::rh_push_decimal_i64(result, page_limit)
                    Base::rh_push_text(result, ",\"page_evidence\":")
                    result.extend(bytes_view(page_evidence))
                    Base::rh_push_text(result, ",\"next_request_file\":\"osv-query-batch-next-request.json\"") if continue_pages and more_available
                if hydrate_advisories:
                    Base::rh_push_text(result, ",\"hydration_state\":\"")
                    Base::rh_push_text(result, "empty" if hydration_state == 0 else "collected" if hydration_state == 1 else "partial")
                    Base::rh_push_text(result, "\",\"hydrated_advisory_count\":")
                    Base::rh_push_decimal_i64(result, hydrated_count)
                    Base::rh_push_text(result, ",\"unhydrated_advisory_count\":")
                    Base::rh_push_decimal_i64(result, invalid_hydration_count + omitted_hydration_count + hydration_failure_count)
                    Base::rh_push_text(result, ",\"hydration_limit\":")
                    Base::rh_push_decimal_i64(result, OsvQuery::RH_OSV_QUERY_MAX_HYDRATED_IDS)
                    Base::rh_push_text(result, ",\"hydration_byte_limit\":")
                    Base::rh_push_decimal_i64(result, OsvQuery::RH_OSV_QUERY_MAX_HYDRATED_BYTES)
                    Base::rh_push_text(result, ",\"hydration_time_limit_secs\":")
                    Base::rh_push_decimal_i64(result, OsvQuery::RH_OSV_QUERY_MAX_HYDRATED_SECS)
                    Base::rh_push_text(result, ",\"matcher_response_file\":\"osv-query-hydrated-response.json\",\"hydration_evidence\":")
                    result.extend(bytes_view(hydration_evidence))
                Base::rh_push_text(result, "}\n")
                result
            if not Base::rh_io_write(result_ptr, result):
                rh_osv_query_err("osv-query: cannot write graph batch result envelope")
                return 4
            configuration: mutable darray[u8] = []
            Base::rh_push_text(configuration, "repo-health/osv-graph-batch-query/1;continue=")
            configuration.push(49) if continue_pages else configuration.push(48)
            Base::rh_push_text(configuration, ";hydrate=")
            configuration.push(49) if hydrate_advisories else configuration.push(48)
            configuration_sha: mutable darray[u8] = []
            input_sha: mutable darray[u8] = []
            output_sha: mutable darray[u8] = []
            Sha256::rh_sha256(configuration, configuration_sha)
            Sha256::rh_sha256(graph_raw, input_sha)
            Sha256::rh_sha256(result, output_sha)
            transformations: mutable darray[u8] = []
            OsvQueryTransformation::rh_osv_graph_transformation_report(configuration_sha, input_sha, output_sha, transformations)
            transformations.push(10)
            transformation_path: mutable darray[u8] = []
            return 4 if not rh_osv_output_path(out, "osv-query-batch-transformations.json", transformation_path)
            transformation_path.push(0)
            transformation_ptr: cstr = (&transformation_path[0]).cast[cstr] can Unsafe.PointerCast
            if not Base::rh_io_write(transformation_ptr, transformations):
                rh_osv_query_err("osv-query: cannot write graph batch transformation report")
                return 4
            rh_osv_query_out("osv-query: advisory hydration remains partial at a declared bound or provider failure" if hydrate_advisories and hydration_state == 2 else "osv-query: full advisory records captured for the bounded batch" if hydrate_advisories and hydration_state != 2 else "osv-query: graph batch pagination remains partial at the four-page cap" if continue_pages and more_available else "osv-query: graph batch captured; response contains advisory IDs only" if query_count > 0 else "osv-query: graph has no eligible versioned nodes")
            0
        # --- M03-08 OSV package/version and commit query adapter. ---
        # Page continuation is opt-in, retains per-page transport evidence, and stops
        # after four pages or fails closed on repeated tokens and aggregate overflow.
        def rh_osv_query_capture_page(base_request: darray[u8]&, page_number: i64, continue_pages: bool, out: cstr, response_ptr: cstr, next_token_ptr: cstr, combined: mutable darray[u8]&, total_vulns: mutable i64&, hash_out: mutable darray[u8]&, token_out: mutable darray[u8]&, has_next_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            request_name: mutable darray[u8] = []
            raw_name: mutable darray[u8] = []
            code_name: mutable darray[u8] = []
            err_name: mutable darray[u8] = []
            return -1 if not rh_osv_page_name(page_number, 0, request_name)
            return -1 if not rh_osv_page_name(page_number, 1, raw_name)
            return -1 if not rh_osv_page_name(page_number, 2, code_name)
            return -1 if not rh_osv_page_name(page_number, 3, err_name)
            request_page_path: mutable darray[u8] = []
            raw_page_path: mutable darray[u8] = []
            code_page_path: mutable darray[u8] = []
            err_page_path: mutable darray[u8] = []
            return -1 if not rh_osv_page_path(out, request_name, request_page_path)
            return -1 if not rh_osv_page_path(out, raw_name, raw_page_path)
            return -1 if not rh_osv_page_path(out, code_name, code_page_path)
            return -1 if not rh_osv_page_path(out, err_name, err_page_path)
            request_page_ptr: cstr = (&request_page_path[0]).cast[cstr] can Unsafe.PointerCast
            raw_page_ptr: cstr = (&raw_page_path[0]).cast[cstr] can Unsafe.PointerCast
            code_page_ptr: cstr = (&code_page_path[0]).cast[cstr] can Unsafe.PointerCast
            err_page_ptr: cstr = (&err_page_path[0]).cast[cstr] can Unsafe.PointerCast
            page_request: mutable darray[u8] = []
            if page_number == 1:
                page_request.extend(bytes_view(base_request))
            else:
                page_token: mutable darray[u8] = []
                if Base::rh_io_read(next_token_ptr, page_token) <= 0:
                    rh_osv_query_err("osv-query: retained page token is missing")
                    return -1
                if OsvQuery::rh_osv_query_next_request(base_request, page_token, page_request) != 0:
                    rh_osv_query_err("osv-query: cannot construct bounded continuation request")
                    return -1
            page_request.push(10)
            if not Base::rh_io_write(request_page_ptr, page_request):
                rh_osv_query_err("osv-query: cannot retain page request evidence")
                return -1
            if Git::rh_run_osv_query(request_page_ptr, raw_page_ptr, code_page_ptr, err_page_ptr) != 0:
                rh_osv_query_err("osv-query: bounded transport failed; inspect retained page evidence")
                return -1
            code: mutable darray[u8] = []
            if Base::rh_io_read(code_page_ptr, code) < 0 or code.count != 3:
                rh_osv_query_err("osv-query: HTTP status is missing or malformed")
                return -1
            if code[0] != 50 or code[1] != 48 or code[2] != 48:
                rh_osv_query_err("osv-query: OSV returned non-200; inspect retained page evidence")
                return -1
            response_raw: mutable darray[u8] = []
            if Base::rh_io_read(raw_page_ptr, response_raw) < 0 or response_raw.count.i64() > Git::RH_FETCH_MAX_BYTES:
                rh_osv_query_err("osv-query: cannot read bounded response evidence")
                return -1
            Sha256::rh_sha256(response_raw, hash_out)
            if hash_out.count != 64:
                rh_osv_query_err("osv-query: could not digest raw page evidence")
                return -1
            if continue_pages:
                if OsvQuery::rh_osv_query_collect_page(response_raw, combined, token_out, has_next_out, total_vulns) != 0:
                    rh_osv_query_err("osv-query: malformed page or four-page aggregation bound exceeded")
                    return -1
            else:
                normalized: mutable darray[u8] = []
                page_state: mutable i64 = 0
                if OsvQuery::rh_osv_query_normalize_response(response_raw, normalized, &page_state) != 0:
                    rh_osv_query_err("osv-query: malformed OSV response; raw response retained")
                    return -1
                if not Base::rh_io_write(response_ptr, normalized):
                    rh_osv_query_err("osv-query: cannot write normalized OSV response")
                    return -1
                has_next_out[0] <- page_state
            0

        def rh_osv_query_append_page_evidence(page_number: i64, page_hash: darray[u8]&, evidence: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            request_name: mutable darray[u8] = []
            raw_name: mutable darray[u8] = []
            code_name: mutable darray[u8] = []
            err_name: mutable darray[u8] = []
            return false if not rh_osv_page_name(page_number, 0, request_name)
            return false if not rh_osv_page_name(page_number, 1, raw_name)
            return false if not rh_osv_page_name(page_number, 2, code_name)
            return false if not rh_osv_page_name(page_number, 3, err_name)
            evidence.push(44) if page_number > 1
            Base::rh_push_text(evidence, "{\"page\":")
            Base::rh_push_decimal_i64(evidence, page_number)
            Base::rh_push_text(evidence, ",\"request_file\":\"")
            evidence.extend(bytes_view(request_name))
            Base::rh_push_text(evidence, "\",\"raw_response_file\":\"")
            evidence.extend(bytes_view(raw_name))
            Base::rh_push_text(evidence, "\",\"http_status_file\":\"")
            evidence.extend(bytes_view(code_name))
            Base::rh_push_text(evidence, "\",\"stderr_file\":\"")
            evidence.extend(bytes_view(err_name))
            Base::rh_push_text(evidence, "\",\"raw_response_sha256\":\"")
            evidence.extend(bytes_view(page_hash))
            Base::rh_push_text(evidence, "\"}")
            true
    public:
        def rh_do_osv_query(input_path: cstr, out: cstr, continue_pages: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out):
                rh_osv_query_err("osv-query: rejected path argument (allowlist)")
                return 3
            if Git::rh_ensure_dir(out) != 0:
                rh_osv_query_err("osv-query: cannot create output directory")
                return 4
            response_path: mutable darray[u8] = []
            result_path: mutable darray[u8] = []
            next_token_path: mutable darray[u8] = []
            return 4 if not rh_osv_output_path(out, "osv-query-response.json", response_path)
            return 4 if not rh_osv_output_path(out, "osv-query-result.json", result_path)
            return 4 if not rh_osv_output_path(out, "osv-query-next-page-token.txt", next_token_path)
            response_path.push(0)
            result_path.push(0)
            next_token_path.push(0)
            response_ptr: cstr = (&response_path[0]).cast[cstr] can Unsafe.PointerCast
            result_ptr: cstr = (&result_path[0]).cast[cstr] can Unsafe.PointerCast
            next_token_ptr: cstr = (&next_token_path[0]).cast[cstr] can Unsafe.PointerCast
            _ = remove_file(response_ptr)
            _ = remove_file(result_ptr)
            _ = remove_file(next_token_ptr)
            stale_page: mutable i64 = 1
            while stale_page <= OsvQuery::RH_OSV_QUERY_MAX_PAGES |stale_page|:
                stale_kind: mutable i64 = 0
                while stale_kind < 4 |stale_kind, stale_page|:
                    stale_name: mutable darray[u8] = []
                    return 4 if not rh_osv_page_name(stale_page, stale_kind, stale_name)
                    stale_path: mutable darray[u8] = []
                    return 4 if not rh_osv_page_path(out, stale_name, stale_path)
                    stale_ptr: cstr = (&stale_path[0]).cast[cstr] can Unsafe.PointerCast
                    _ = remove_file(stale_ptr)
                    stale_kind <- stale_kind + 1
                stale_page <- stale_page + 1

            input_size: i64 = Base::rh_file_size(input_path)
            if input_size <= 0 or input_size > 8192:
                rh_osv_query_err("osv-query: input is empty or exceeds the 8192-byte contract bound")
                return 3
            input_raw: mutable darray[u8] = []
            if Base::rh_io_read(input_path, input_raw) != input_size:
                rh_osv_query_err("osv-query: cannot read bounded query input")
                return 4
            request: mutable darray[u8] = []
            query_kind: mutable i64 = -1
            if OsvQuery::rh_osv_query_build(input_raw, request, &query_kind) != 0:
                rh_osv_query_err("osv-query: malformed or unsupported versioned OSV query input")
                return 3

            combined: mutable darray[u8] = []
            page_evidence: mutable darray[u8] = []
            if continue_pages:
                Base::rh_push_text(combined, "{\"vulns\":[")
                Base::rh_push_text(page_evidence, "[")
            seen_tokens: mutable darray[u8] = []
            seen_starts: mutable darray[i64] = []
            seen_lengths: mutable darray[i64] = []
            first_response_hash: mutable darray[u8] = []
            total_vulns: mutable i64 = 0
            page_count: mutable i64 = 0
            more_available: mutable bool = false
            done: mutable bool = false
            page_limit: i64 = OsvQuery::RH_OSV_QUERY_MAX_PAGES if continue_pages else 1
            while not done |page_number: i64 = 1, page_count, page_limit, continue_pages, request, out, response_ptr, next_token_ptr, combined, page_evidence, seen_tokens, seen_starts, seen_lengths, first_response_hash, total_vulns, more_available, done|:
                page_hash: mutable darray[u8] = []
                token: mutable darray[u8] = []
                has_next: mutable i64 = 0
                if rh_osv_query_capture_page(request, page_number, continue_pages, out, response_ptr, next_token_ptr, combined, &total_vulns, page_hash, token, &has_next) != 0:
                    return 4
                if page_number == 1:
                    first_response_hash.extend(bytes_view(page_hash))
                if continue_pages:
                    if has_next == 1:
                        if not OsvQuery::rh_osv_query_remember_page_token(token, seen_tokens, seen_starts, seen_lengths):
                            rh_osv_query_err("osv-query: repeated pagination token; refusing a false complete result")
                            return 4
                        if not Base::rh_io_write(next_token_ptr, token):
                            rh_osv_query_err("osv-query: cannot retain continuation token")
                            return 4
                        if page_number == page_limit:
                            more_available <- true
                            done <- true
                    else:
                        _ = remove_file(next_token_ptr)
                        done <- true
                else:
                    more_available <- has_next == 1
                    done <- true
                if continue_pages:
                    return 4 if not rh_osv_query_append_page_evidence(page_number, page_hash, page_evidence)
                page_count <- page_number
                if not done:
                    page_number <- page_number + 1
            if continue_pages:
                page_evidence.push(93)

            if continue_pages:
                Base::rh_push_text(combined, "]")
                if more_available:
                    final_token: mutable darray[u8] = []
                    if Base::rh_io_read(next_token_ptr, final_token) <= 0:
                        rh_osv_query_err("osv-query: final continuation token is missing")
                        return 4
                    Base::rh_push_text(combined, ",\"next_page_token\":\"")
                    Base::rh_json_escape(combined, final_token, 0, final_token.count)
                combined.push(125)
                if combined.count.i64() > Git::RH_FETCH_MAX_BYTES:
                    rh_osv_query_err("osv-query: combined matcher response exceeds the response bound")
                    return 4
                if not Base::rh_io_write(response_ptr, combined):
                    rh_osv_query_err("osv-query: cannot write combined paginated response")
                    return 4

            response_hash_bytes: u8& = (&first_response_hash[0]).cast[u8&] can Unsafe.PointerCast
            captured_at: i64 = Base::rh_now()
            result: mutable darray[u8] =
                result: mutable darray[u8] = []
                if continue_pages:
                    Base::rh_push_text(result, "{\"schema\":\"rh-osv-query-result/2\",\"query_kind\":\"")
                else:
                    Base::rh_push_text(result, "{\"schema\":\"rh-osv-query-result/1\",\"query_kind\":\"")
                Base::rh_push_text(result, "commit" if query_kind == 1 else "package_version")
                Base::rh_push_text(result, "\",\"endpoint\":\"https://api.osv.dev/v1/query\",\"captured_at_epoch\":")
                if captured_at >= 0:
                    Base::rh_push_decimal_i64(result, captured_at)
                else:
                    Base::rh_push_text(result, "null")
                Base::rh_push_text(result, ",\"http_status\":200,\"state\":\"")
                Base::rh_push_text(result, "partial" if continue_pages and more_available else "collected")
                Base::rh_push_text(result, "\",\"pagination\":\"")
                Base::rh_push_text(result, "more_available" if more_available else "complete")
                Base::rh_push_text(result, "\",\"request_file\":\"osv-query-request.json\",\"response_file\":\"osv-query-response.json\",\"raw_response_file\":\"osv-query-response.raw.json\",\"raw_response_sha256\":\"")
                Base::rh_push_raw(result, response_hash_bytes, first_response_hash.count)
                Base::rh_push_text(result, "\"")
                if continue_pages:
                    Base::rh_push_text(result, ",\"page_count\":")
                    Base::rh_push_decimal_i64(result, page_count)
                    Base::rh_push_text(result, ",\"page_limit\":")
                    Base::rh_push_decimal_i64(result, page_limit)
                    Base::rh_push_text(result, ",\"advisory_count\":")
                    Base::rh_push_decimal_i64(result, total_vulns)
                    Base::rh_push_text(result, ",\"page_evidence\":")
                    result.extend(bytes_view(page_evidence))
                    if more_available:
                        Base::rh_push_text(result, ",\"next_page_token_file\":\"osv-query-next-page-token.txt\"")
                Base::rh_push_text(result, "}\n")
                result
            if not Base::rh_io_write(result_ptr, result):
                rh_osv_query_err("osv-query: cannot write result envelope")
                return 4
            normalized_response: mutable darray[u8] = []
            if Base::rh_io_read(response_ptr, normalized_response) < 0:
                rh_osv_query_err("osv-query: cannot read normalized response for transformation report")
                return 4
            configuration: mutable darray[u8] = []
            Base::rh_push_text(configuration, "repo-health/osv-package-version-query/1")
            configuration_sha: mutable darray[u8] = []
            input_sha: mutable darray[u8] = []
            output_sha: mutable darray[u8] = []
            Sha256::rh_sha256(configuration, configuration_sha)
            Sha256::rh_sha256(input_raw, input_sha)
            Sha256::rh_sha256(normalized_response, output_sha)
            transformations: mutable darray[u8] = []
            OsvQueryTransformation::rh_osv_query_transformation_report(configuration_sha, input_sha, output_sha, transformations)
            transformations.push(10)
            transformation_path: mutable darray[u8] = []
            return 4 if not rh_osv_output_path(out, "osv-query-transformations.json", transformation_path)
            transformation_path.push(0)
            transformation_ptr: cstr = (&transformation_path[0]).cast[cstr] can Unsafe.PointerCast
            if not Base::rh_io_write(transformation_ptr, transformations):
                rh_osv_query_err("osv-query: cannot write transformation report")
                return 4
            rh_osv_query_out("osv-query: captured bounded paginated response" if continue_pages and not more_available else "osv-query: pagination bound reached; result is partial" if more_available else "osv-query: captured response for the supplied query")
            0

        def rh_do_osv_graph_query(graph_path: cstr, out: cstr, continue_pages: bool, hydrate_advisories: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            rh_do_osv_graph_query_inner(graph_path, out, continue_pages, hydrate_advisories)

# --- M03-09 deps.dev enrichment adapter. ---
# Captures one provider version response with bounded transport evidence and
# emits a provenance/coverage record. This sidecar never changes the local
# dependency graph and therefore remains optional when the provider is down.
def rh_depsdev_write_transformation(input: darray[u8]&, output: darray[u8]&, out_path: cstr) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    configuration: mutable darray[u8] = []
    Base::rh_push_text(configuration, "repo-health/deps.dev-version/1")
    configuration_sha: mutable darray[u8] = []
    input_sha: mutable darray[u8] = []
    output_sha: mutable darray[u8] = []
    Sha256::rh_sha256(configuration, configuration_sha)
    Sha256::rh_sha256(input, input_sha)
    Sha256::rh_sha256(output, output_sha)
    report: mutable darray[u8] = []
    DepsDevTransformation::rh_depsdev_transformation_report(configuration_sha, input_sha, output_sha, report)
    report.push(10)
    report_path: mutable darray[u8] = []
    Base::rh_push_cstr(report_path, out_path)
    Base::rh_push_text(report_path, ".transformations.json")
    report_path.push(0)
    report_ptr: cstr = (&report_path[0]).cast[cstr] can Unsafe.PointerCast
    Base::rh_io_write(report_ptr, report)

def rh_do_depsdev(input_path: cstr, out_path: cstr, source_url: cstr, has_url: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected depsdev output argument (allowlist)")
        return 3
    raw: mutable darray[u8] = []
    status_value: mutable darray[u8] = []
    status_ptr: mutable cstr = ""
    if has_url:
        return 3 if not Git::rh_fetch_arg_safe(source_url)
        fetch_dir: mutable darray[u8] = []
        if not rh_dirname(out_path, fetch_dir):
            Base::rh_push_text(fetch_dir, ".")
        fetch_dir.push(0)
        fetch_dir_ptr: cstr = (&fetch_dir[0]).cast[cstr] can Unsafe.PointerCast
        body_path: mutable darray[u8] = []
        code_path: mutable darray[u8] = []
        err_path: mutable darray[u8] = []
        if not rh_out_path(fetch_dir_ptr, "depsdev-fetch-body.json", body_path) or not rh_out_path(fetch_dir_ptr, "depsdev-fetch-status.txt", code_path) or not rh_out_path(fetch_dir_ptr, "depsdev-fetch.err", err_path):
            rh_cli_err("depsdev: cannot stage fetch evidence")
            return 4
        body_path.push(0)
        code_path.push(0)
        err_path.push(0)
        body_ptr: cstr = (&body_path[0]).cast[cstr] can Unsafe.PointerCast
        code_ptr: cstr = (&code_path[0]).cast[cstr] can Unsafe.PointerCast
        err_ptr: cstr = (&err_path[0]).cast[cstr] can Unsafe.PointerCast
        return 4 if Git::rh_run_https_get(source_url, body_ptr, code_ptr, err_ptr) != 0
        code_raw: mutable darray[u8] = []
        if Base::rh_io_read(code_ptr, code_raw) < 0 or code_raw.count == 0:
            rh_cli_err("depsdev: fetch did not produce a status")
            return 4
        ok_status: bool = code_raw[0] == 50
        file_transport: bool = code_raw.count >= 3 and code_raw[0] == 48 and code_raw[1] == 48 and code_raw[2] == 48 and Base::rh_cstr_starts_with(source_url, "file://")
        if not ok_status and not file_transport:
            rh_cli_err("depsdev: fetch returned non-2xx; enrichment unavailable")
            return 4
        status_value.extend(bytes_view(code_raw))
        status_value.push(0)
        status_ptr <- (&status_value[0]).cast[cstr] can Unsafe.PointerCast
        url_data: mutable darray[u8] = []
        Base::rh_push_cstr(url_data, source_url)
        status_doc: mutable darray[u8] = []
        Base::rh_push_text(status_doc, "{\"schema\":\"rh-depsdev-fetch/1\",\"source_url\":\"")
        Base::rh_json_escape(status_doc, url_data, 0, url_data.count)
        Base::rh_push_text(status_doc, "\",\"status\":\"")
        code_data: u8& = (&code_raw[0]).cast[u8&] can Unsafe.PointerCast
        Base::rh_push_raw(status_doc, code_data, code_raw.count)
        Base::rh_push_text(status_doc, "\",\"body_file\":\"depsdev-fetch-body.json\",\"state\":\"collected\",\"note\":\"optional provider capture retained before adapter parsing\"}\n")
        return 4 if not Base::rh_io_write(code_ptr, status_doc)
        return 4 if Base::rh_io_read(body_ptr, raw) < 0
    else:
        return 3 if not Git::rh_arg_safe(input_path)
        if Base::rh_io_read(input_path, raw) < 0:
            rh_cli_err("depsdev: cannot read --input")
            return 4
    body: mutable darray[u8] = []
    if DepsDev::rh_depsdev_report(raw, body, source_url, status_ptr, has_url) != 0:
        rh_cli_err("depsdev: unsupported or malformed provider response (fail closed)")
        return 4
    body.push(10)
    return 4 if not Base::rh_io_write(out_path, body)
    if not rh_depsdev_write_transformation(raw, body, out_path):
        rh_cli_err("depsdev: cannot write transformation report")
        return 4
    rh_cli_out("depsdev: enrichment observed")
    0

