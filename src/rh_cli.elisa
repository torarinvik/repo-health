            elif rh_streq(a8, "--mirror"):
                if dd + 1 < argc:
                    dd <- dd + 1
                    v8: u8& = slots[dd].cast[u8&] can Unsafe.PointerCast
                    ma: mutable i64 = -1
                    mb: mutable i64 = -1
                    return rh_cli_usage(2) if not rh_ds_parse_pair(v8, &ma, &mb)
                    mirrors.push(Graph::RhAssertion{a: ma, b: mb, state: Graph::RH_ASSERT_ACCEPTED})
                else:
                    return rh_cli_usage(2)
            elif rh_streq(a8, "--intrinsics"):
                if dd + 1 < argc:
                    dd <- dd + 1
                    in_idx <- dd
                else:
                    return rh_cli_usage(2)
            elif rh_streq(a8, "--mapping"):
                if dd + 1 < argc:
