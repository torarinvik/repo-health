    0

def rh_do_forge_events_github_reviews_repository(repository: cstr, review_page_limit: i64, pull_limit: i64, out_path: cstr, resume_path: cstr, has_resume: bool) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(out_path) or (has_resume and not Git::rh_arg_safe(resume_path)):
        rh_cli_err("rejected repository review argument (allowlist)")
        return 3
    previous: mutable darray[u8] = []
    if has_resume:
        if Base::rh_io_read(resume_path, previous) < 0:
            rh_cli_err("forge events: cannot read repository review continuation")
            return 4
    body: mutable darray[u8] = []
    if ForgeEventsFetch::rh_forge_events_github_reviews_repository_live(repository, review_page_limit, pull_limit, out_path, previous, body) != 0:
        rh_cli_err("forge events: GitHub repository review collection failed (see page evidence or continuation scope)")
        return 4
    body.push(10)
    if not Base::rh_io_write(out_path, body):
        rh_cli_err("forge events: cannot write repository review result")
        return 4
    rh_cli_out("forge events: bounded GitHub repository review batch collected")
    0

# --- M02-04/05 connector instance execution path. ---
# Reads an rh-connector-instance/1 document and writes
# rh-connector-instance-result/1: the connector's capability table (with
# unsupported stated, never omitted), the operator-declared capabilities,
# and a usability verdict. Approval and transport are separate gates:
# an unapproved instance is `unapproved`, and an approved instance whose
# base URL fails the transport guard is `transport-rejected` regardless of
# approval (S002). Unknown connector ids, unknown capability keys, and a
# capability the connector does not declare all fail closed (exit 4).
def rh_do_connector_check(input_path: cstr, out_path: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    if not Git::rh_arg_safe(input_path) or not Git::rh_arg_safe(out_path):
        rh_cli_err("rejected connector argument (allowlist)")
        return 3
    ip: mutable darray[u8] =
        ip: mutable darray[u8] = []
        Base::rh_push_cstr(ip, input_path)
        ip.push(0)
        ip
    ipp: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
    raw: mutable darray[u8] = []
    if Base::rh_io_read(ipp, raw) < 0:
        rh_cli_err("connector: cannot read --instance")
        return 4
    inst: mutable Connector::RhConnectorInstance = Connector::RhConnectorInstance{id_start: 0, id_end: 0, url_start: 0, url_end: 0, approved: false}
    caps: mutable darray[i64] = []
    if Connector::rh_connector_instance_parse(raw, &inst, caps) != 0:
        rh_cli_err("connector: not a valid rh-connector-instance/1 document (fail closed)")
        return 4
    # Re-parse to recover the text buffer spans referenced by the instance.
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    _ = Json::rh_json_parse(raw, nodes, texts)
    verdict: i64 = Connector::rh_connector_instance_verdict(&inst, texts)
    body: mutable darray[u8] = []
    Connector::rh_connector_instance_emit(&inst, texts, caps, verdict, body)
    body.push(10)
    op: mutable darray[u8] =
        op: mutable darray[u8] = []
        Base::rh_push_cstr(op, out_path)
        op.push(0)
        op
    opp: cstr = (&op[0]).cast[cstr] can Unsafe.PointerCast
    if not Base::rh_io_write(opp, body):
        rh_cli_err("connector: cannot write --out")
        return 4
    done: mutable darray[u8] = []
    Base::rh_push_text(done, "connector: ok verdict=")
    if verdict == 0:
        Base::rh_push_text(done, "usable")
    elif verdict == 1:
        Base::rh_push_text(done, "unapproved")
    else:
        Base::rh_push_text(done, "transport-rejected")
    done.push(10)
    Base::rh_write_stdout(done)
    0

