                        return rh_cli_usage(2)
                else:
                    return rh_cli_usage(2)
                dc <- dc + 1
        return rh_cli_usage(2) if dr_idx < 0 or do_idx < 0
        return rh_cli_usage(2) if dov_idx >= 0 and dou_idx >= 0
        return rh_do_deps(slots[dr_idx], slots[do_idx], slots[dov_idx], true, slots[dr_idx], false) if dov_idx >= 0
        return rh_do_deps(slots[dr_idx], slots[do_idx], slots[dr_idx], false, slots[dou_idx], true) if dou_idx >= 0
        return rh_do_deps(slots[dr_idx], slots[do_idx], slots[dr_idx], false, slots[dr_idx], false)
    if Base::rh_streq(cmd, "pylock"):
        pylock_input, pylock_output =
            while option_index < argc |pylock_input: i64 = -1, pylock_output: i64 = -1, option_index: i64 = 2, slots| -> pylock_input, pylock_output:
                option: u8& = slots[option_index].cast[u8&] can Unsafe.PointerCast
                if Base::rh_streq(option, "--input"):
                    return rh_cli_usage(2) if pylock_input >= 0
                    return rh_cli_usage(2) if option_index + 1 >= argc
                    option_index <- option_index + 1
                    pylock_input <- option_index
                elif Base::rh_streq(option, "--out"):
                    return rh_cli_usage(2) if pylock_output >= 0
                    return rh_cli_usage(2) if option_index + 1 >= argc
                    option_index <- option_index + 1
