# rh_projection_store.elisa — persisted labeled graph projections (M05-01).
#
# A projection snapshot is an immutable, content-addressed envelope containing
# the exact graph document and the projection manifest that was used to query
# it. The digest returned by rh_store_blob is the snapshot ID. Replaying the
# same graph and manifest therefore returns the same ID; changing either one
# creates a new immutable object.

include "./rh_graph.elisa"
include "./rh_store.elisa"

module ProjectionStore:
    private:
        def rh_projection_snapshot_body(raw: darray[u8]&, projection: RhProjection&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            rh_push_text(out, "{\"schema\":\"rh-projection-snapshot/1\",\"projection\":{\"id\":")
            rh_push_decimal_i64(out, projection.id)
            rh_push_text(out, ",\"scope_filter\":")
            rh_push_decimal_i64(out, projection.scope_filter.i64())
            rh_push_text(out, ",\"platform\":")
            rh_push_decimal_i64(out, projection.platform)
            rh_push_text(out, ",\"valid_as_of\":")
            rh_push_decimal_i64(out, projection.valid_as_of)
            rh_push_text(out, ",\"known_as_of\":")
            rh_push_decimal_i64(out, projection.known_as_of)
            rh_push_text(out, ",\"identity_revision\":")
            rh_push_decimal_i64(out, projection.identity_revision)
            rh_push_text(out, ",\"mapping_revision\":")
            rh_push_decimal_i64(out, projection.mapping_revision)
            rh_push_text(out, ",\"public_only\":")
            rh_push_text(out, "true") if projection.public_only else rh_push_text(out, "false")
            rh_push_text(out, ",\"max_nodes\":")
            rh_push_decimal_i64(out, projection.max_nodes)
            rh_push_text(out, ",\"max_depth\":")
            rh_push_decimal_i64(out, projection.max_depth)
            rh_push_text(out, "},\"graph\":")
            out.extend(bytes_view(raw))
            out.push(125)

        def rh_projection_snapshot_path(root: cstr, name: u8&, out: mutable darray[u8]&) -> cstr can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            rh_push_cstr(out, root)
            out.push(47)
            rh_push_text(out, name)
            out.push(0)
            (&out[0]).cast[cstr] can Unsafe.PointerCast

    public:
        # Store a graph and its complete projection manifest as one immutable
        # object. id_out must be empty on entry and receives the snapshot ID.
        def rh_projection_snapshot_store(root: cstr, raw: darray[u8]&, projection: RhProjection&, id_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            body: mutable darray[u8] = []
            ProjectionStore::rh_projection_snapshot_body(raw, projection, body)
            rh_store_blob(root, body, id_out)

        # Load and digest-verify an immutable snapshot. A missing or tampered
        # object is indistinguishable from an unavailable snapshot.
        def rh_projection_snapshot_load(root: cstr, name: u8&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            path: mutable darray[u8] = []
            pp: cstr = ProjectionStore::rh_projection_snapshot_path(root, name, path)
            return -1 if rh_io_read(pp, out) < 0
            ok: mutable i64 = 0
            return -1 if rh_store_blob_verify(root, name, &ok) != 0 or ok != 1
            0

        def rh_projection_snapshot_verify(root: cstr, name: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            loaded: mutable darray[u8] = []
            ok_out[0] <- 0
            return -1 if ProjectionStore::rh_projection_snapshot_load(root, name, loaded) != 0
            ok_out[0] <- 1
            0
