# rh_metrics.elisa — deterministic metric formulas (M00/M04).
#
# Plan §19.1: integer event counts, rational arithmetic, deterministic
# descending order. Concentration k for threshold a/b:
#   remove zeros; empty -> not_applicable (-1); cumulative*b >= total*a -> k.
# Overflow-safe via gcd reduction: cum*b vs total*a is compared as
# (cum/g1)*(b/g1) vs (tot/g2)*(a/g2); if the reduced products still exceed
# u64, -3 (bounded error) is returned instead of a wrapped answer.
# HHI is sum(xi^2)/total^2 as a reduced exact fraction; the effective actor
# count is its reciprocal. Display rounding must never become stored state,
# so no floats appear anywhere in this file.
#
# Return codes for rh_concentration: k >= 1 on success; -1 not_applicable;
# -2 bad threshold; -3 overflow (bounded error, S012).

include "../../Elisa-compiler/elisacore_std/collections.elisa"

module Metrics:
    private:

        # private to this file (modules retried after re-seed; see CHANGELOG).
        const RH_U64MAX: u64 = 18446744073709551615

        def rh_members_key_less(left: sview, right: sview) -> bool:
            left_length: usize = sview_len(left)
            right_length: usize = sview_len(right)
            limit: usize = left_length if left_length < right_length else right_length
            while index < limit |index: usize = 0, left, right|:
                left_byte: u8 = sview_at(left, index)
                right_byte: u8 = sview_at(right, index)
                return left_byte < right_byte if left_byte != right_byte
                index <- index + 1
            left_length < right_length

        def rh_members_key_u64(key: sview, offset: usize) -> u64:
            key_loop: mutable sview = key
            offset_loop: mutable usize = offset
            for index in 0..<8 |index, value: u64 = 0, key_loop, offset_loop| -> value:
                value <- (value << 8) | sview_at(key_loop, offset_loop + index).u64()

        def rh_members_key_append(bytes: mutable darray[u8]&, value: u64) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<8 |index, bytes, value|:
                shift: u64 = ((7 - index).u64()) * 8
                bytes.push(((value >> shift) & 255).u8())

        def rh_count_desc_less(left: u64, right: u64) -> bool:
            left > right

        def rh_count_asc_less(left: u64, right: u64) -> bool:
            left < right

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_gcd(a: u64, b: u64) -> u64:
            while y != 0 |x: u64 = a, y: u64 = b| -> x:
                r: u64 = x % y
                x <- y
                y <- r

        # Descending numeric order. Equal counts are indistinguishable here;
        # actor/witness ordering belongs to the caller's separate identity data.
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_sort_desc(values: mutable darray[u64]&) -> void can[Abort.Panic]:
            sort[u64](values, rh_count_desc_less)

        # Exact overflow-checked a*b >= c*d via gcd reduction.
        # Both sides are divided by common factors (never one product alone):
        # g1 divides a and c, g2 divides b and d, preserving the comparison.
        # Returns 1 when a*b >= c*d, 0 when below, -1 on overflow (bounded error).
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_cross_ge(a: u64, b: u64, c: u64, d: u64) -> i64:
            a1, c1 =
                divisor: u64 = Metrics::rh_gcd(a, c)
                a / divisor, c / divisor
            b1, d1 =
                divisor: u64 = Metrics::rh_gcd(b, d)
                b / divisor, d / divisor
            return -1 if a1 > RH_U64MAX / b1
            return -1 if c1 > RH_U64MAX / d1
            return 1 if a1 * b1 >= c1 * d1
            0

    public:
        def rh_concentration(counts: mutable darray[u64]&, threshold_num: u64, threshold_den: u64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -2 if threshold_den == 0
            return -2 if threshold_num == 0
            return -2 if threshold_num > threshold_den
            total, positives =
                for i in 0..<counts.count |total: u64 = 0, positives: u64 = 0, counts| -> total, positives:
                    v: u64 = counts[i]
                    if v > 0:
                        return -3 if total > RH_U64MAX - v
                        total <- total + v
                        positives <- positives + 1
            return -1 if positives == 0
            Metrics::rh_sort_desc(counts)
            for i in 0..<counts.count |cumulative: u64 = 0, position: u64 = 0, counts, total, threshold_num, threshold_den|:
                v: u64 = counts[i]
                if v > 0:
                    cumulative <- cumulative + v
                    position <- position + 1
                    verdict: i64 = Metrics::rh_cross_ge(cumulative, threshold_den, total, threshold_num)
                    return -3 if verdict < 0
                    return position.i64() if verdict == 1
            -1

        # Deterministic membership explaining the smallest concentration prefix.
        # The byte-view sort key is (MAX-count, actor_id), both big-endian, so the
        # standard in-place sort gives descending counts and ascending IDs on ties.
        def rh_concentration_members(actor_ids: darray[i64]&, counts: darray[u64]&, threshold_num: u64, threshold_den: u64, members_out: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -2 if threshold_den == 0 or threshold_num == 0 or threshold_num > threshold_den
            return -4 if actor_ids.count != counts.count or members_out.count != 0
            keys_bytes: mutable darray[u8] = []
            ids_bytes: mutable darray[u8] = []
            total: mutable u64 = 0
            for index in 0..<actor_ids.count |index, keys_bytes, ids_bytes, total, actor_ids, counts|:
                actor_id: i64 = actor_ids[index]
                count: u64 = counts[index]
                return -4 if actor_id < 0
                return -3 if total > RH_U64MAX - count
                total <- total + count
                Metrics::rh_members_key_append(ids_bytes, actor_id.u64())
                if count > 0:
                    Metrics::rh_members_key_append(keys_bytes, RH_U64MAX - count)
                    Metrics::rh_members_key_append(keys_bytes, actor_id.u64())
            ids: mutable darray[sview] = []
            for index in 0..<(ids_bytes.count / 8) |index, ids, ids_bytes|:
                start: i64 = (index * 8).i64()
                ids.push(string_view_slice(bytes_view(ids_bytes), start, start + 8))
            sort[sview](ids, rh_members_key_less)
            for index in 0..<ids.count |index, ids|:
                return -4 if index > 0 and sview_eq(ids[index - 1], ids[index])
            return -1 if total == 0
            keys: mutable darray[sview] = []
            for index in 0..<(keys_bytes.count / 16) |index, keys, keys_bytes|:
                start: i64 = (index * 16).i64()
                keys.push(string_view_slice(bytes_view(keys_bytes), start, start + 16))
            sort[sview](keys, rh_members_key_less)
            threshold_num_loop: mutable u64 = threshold_num
            threshold_den_loop: mutable u64 = threshold_den
            selected: i64 =
                for index in 0..<keys.count |index, cumulative: u64 = 0, position: i64 = 0, keys, total, threshold_num_loop, threshold_den_loop| -> position:
                    cumulative <- cumulative + RH_U64MAX - Metrics::rh_members_key_u64(keys[index], 0)
                    position <- position + 1
                    verdict: i64 = Metrics::rh_cross_ge(cumulative, threshold_den_loop, total, threshold_num_loop)
                    return -3 if verdict < 0
                    break position if verdict == 1
            while index < selected.usize() |index: usize = 0, keys, members_out|:
                members_out.push(Metrics::rh_members_key_u64(keys[index], 8).i64())
                index <- index + 1
            selected

        # HHI as reduced exact fraction num/den. Returns false when the population
        # is empty (caller reports not_applicable) or on overflow (bounded error).
        def rh_hhi(counts: darray[u64]&, num_out: mutable u64&, den_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
            total: u64 =
                for i in 0..<counts.count |total: u64 = 0| -> total:
                    v: u64 = counts[i]
                    if v > 0:
                        return false if total > RH_U64MAX - v
                        total <- total + v
            return false if total == 0
            return false if total > RH_U64MAX / total
            den: u64 = total * total
            acc: u64 =
                for i in 0..<counts.count |acc: u64 = 0| -> acc:
                    v: u64 = counts[i]
                    if v > 0:
                        return false if v > RH_U64MAX / v
                        sq: u64 = v * v
                        return false if acc > RH_U64MAX - sq
                        acc <- acc + sq
            g: u64 = Metrics::rh_gcd(acc, den)
            num_out[0] <- acc / g
            den_out[0] <- den / g
            true

        # Gini coefficient as a reduced exact fraction num/den:
        #   G = sum_{j<k} |x_j - x_k| / (n * sum_i x_i)
        # Sort a positive-count copy, then sum x_i*i - prefix_sum. This is the
        # same unordered-pair numerator without the quadratic pair scan. Returns
        # false when the population is empty or on bounded overflow.
        def rh_gini(counts: darray[u64]&, num_out: mutable u64&, den_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
            total, nonzero =
                for i in 0..<counts.count |total: u64 = 0, nonzero: u64 = 0| -> total, nonzero:
                    v: u64 = counts[i]
                    if v > 0:
                        return false if total > RH_U64MAX - v
                        total <- total + v
                        nonzero <- nonzero + 1
            if total == 0 or nonzero < 2:
                return false
            return false if nonzero > RH_U64MAX / total
            den: u64 = nonzero * total
            positive_counts: mutable darray[u64] =
                for i in 0..<counts.count |positive: mutable darray[u64] = []| -> positive:
                    count: u64 = counts[i]
                    positive.push(count) if count > 0
            sort[u64](positive_counts, rh_count_asc_less)
            num: u64 =
                for i in 0..<positive_counts.count |pair: u64 = 0, prefix: u64 = 0, positive_counts| -> pair:
                    count: u64 = positive_counts[i]
                    rank: u64 = i.u64()
                    return false if rank > RH_U64MAX / count
                    weighted: u64 = rank * count
                    return false if weighted < prefix
                    contribution: u64 = weighted - prefix
                    return false if pair > RH_U64MAX - contribution
                    pair <- pair + contribution
                    return false if prefix > RH_U64MAX - count
                    prefix <- prefix + count
            g: u64 = Metrics::rh_gcd(num, den)
            num_out[0] <- num / g
            den_out[0] <- den / g
            true
