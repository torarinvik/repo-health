# rh_pep440.elisa — Python/PEP 440 version semantics (M08 ecosystems lane,
# prototype). Python is a materially different ecosystem from npm/Cargo:
# versions allow an epoch, an arbitrary number of release segments,
# pre-releases written a/b/rc (with alpha/beta/c aliases), post-releases,
# dev releases, and local versions. SemVer rules must NOT be applied here.
#
# Declared subset: epoch, release, pre, post, dev are parsed and ordered
# per PEP 440; local versions are compared by presence only (public < any
# local; two local versions of the same public version compare equal here).
# Full local-segment ordering is not implemented. Invalid versions have
# ok=0 and must not be compared.
include "./rh_base.elisa"

const RH_PEP_MAX_REL: i64 = 8
# Sentinel for "no dev segment" (dev absent sorts ABOVE any present dev).
const RH_PEP_DEV_ABSENT: i64 = 4611686018427387904
# pre ranks: -2 = none-but-dev (-inf), 0=a, 1=b, 2=rc, 3 = none-no-dev (+inf)
const RH_PEP_PRE_DEV_ONLY: i64 = -2
const RH_PEP_PRE_A: i64 = 0
const RH_PEP_PRE_B: i64 = 1
const RH_PEP_PRE_RC: i64 = 2
const RH_PEP_PRE_NONE: i64 = 3

struct RhPep440:
    ok: i64
    epoch: i64
    n: i64
    r0: i64
    r1: i64
    r2: i64
    r3: i64
    r4: i64
    r5: i64
    r6: i64
    r7: i64
    pre_rank: i64
    pre_num: i64
    post: i64
    dev: i64
    local: i64

# (private to this file)
def rh_pep_invalid() -> RhPep440:
    RhPep440{ok: 0, epoch: 0, n: 0, r0: 0, r1: 0, r2: 0, r3: 0, r4: 0, r5: 0, r6: 0, r7: 0, pre_rank: RH_PEP_PRE_NONE, pre_num: 0, post: -1, dev: RH_PEP_DEV_ABSENT, local: -1}

# ASCII digit run at pos; returns value, sets out_pos, or -1 when no digit.
# (private to this file)
def rh_pep_digits(data: darray[u8]&, pos: i64, end: i64, out_pos: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    out_pos[0] <- pos
    return -1 if pos >= end
    b: u8 = data[pos.usize()]
    return -1 if b < 48 or b > 57
    v, i =
        while i < end |v: i64 = 0, i: i64 = pos| -> v, i:
            c: u8 = data[i.usize()]
            break if c < 48 or c > 57
            v <- v * 10 + (c.i64() - 48)
            return -1 if v > 1000000000000
            i <- i + 1
    out_pos[0] <- i
    v

# (private to this file)
def rh_pep_lower(b: u8) -> u8:
    return b + 32 if b >= 65 and b <= 90
    b

# Does data[pos,pos+len) case-insensitively equal lit? Returns len or -1.
# (private to this file)
def rh_pep_word(data: darray[u8]&, pos: i64, end: i64, lit: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
    n: i64 = strlen(lit).i64()
    return -1 if pos + n > end
    while k < n |k: i64 = 0, data, pos, lit|:
        return -1 if rh_pep_lower(data[(pos + k).usize()]) != rh_pep_lower(lit[k.usize()])
        k <- k + 1
    n

def rh_pep440_valid(data: darray[u8]&, s: usize, e: usize) -> bool can[Memory.Allocate, Abort.Panic]:
    v: RhPep440 = rh_pep440_parse(data, s.i64(), e.i64())
    v.ok == 1

def rh_pep440_parse(data: darray[u8]&, s: i64, e: i64) -> RhPep440 can[Memory.Allocate, Abort.Panic]:
    return rh_pep_invalid() if s >= e
    epoch: mutable i64 = 0
    n: mutable i64 = 0
    rel: mutable darray[i64] = []
    # epoch: digits followed by '!'
    p: mutable i64 = 0
    pn: mutable i64 = 0
    first: i64 = rh_pep_digits(data, s, e, &pn)
    if first >= 0 and pn < e and data[pn.usize()] == 33:
        epoch <- first
        p <- pn + 1
    else:
        p <- s
    # release: N(.N)*
    while p < e |p, e, data, rel, n, pn|:
        pn <- 0
        seg: i64 = rh_pep_digits(data, p, e, &pn)
        return rh_pep_invalid() if seg < 0
        return rh_pep_invalid() if n >= RH_PEP_MAX_REL
        rel.push(seg)
        n <- n + 1
        p <- pn
        break if not (p < e and data[p.usize()] == 46 and p + 1 < e and data[(p + 1).usize()] >= 48 and data[(p + 1).usize()] <= 57)
        p <- p + 1
    pre_rank: mutable i64 = RH_PEP_PRE_NONE
    pre_num: mutable i64 = 0
    post: mutable i64 = -1
    dev: mutable i64 = RH_PEP_DEV_ABSENT
    local: mutable i64 = -1
    # pre-release
    if p < e:
        b: u8 = rh_pep_lower(data[p.usize()])
        rank: mutable i64 = -1
        adv: mutable i64 = 0
        if b == 97:
            rank <- RH_PEP_PRE_A
            adv <- 1
            if rh_pep_word(data, p, e, "alpha") > 0:
                adv <- 5
        elif b == 98:
            rank <- RH_PEP_PRE_B
            adv <- 1
            if rh_pep_word(data, p, e, "beta") > 0:
                adv <- 4
        elif b == 99:
            rank <- RH_PEP_PRE_RC
            adv <- 1
        elif b == 114:
            if rh_pep_word(data, p, e, "rc") > 0:
                rank <- RH_PEP_PRE_RC
                adv <- 2
        elif b == 112:
            if rh_pep_word(data, p, e, "preview") > 0:
                rank <- RH_PEP_PRE_RC
                adv <- 7
            elif rh_pep_word(data, p, e, "pre") > 0:
                rank <- RH_PEP_PRE_RC
                adv <- 3
        if rank >= 0:
            p <- p + adv
            pn <- 0
            num: mutable i64 = rh_pep_digits(data, p, e, &pn)
            if num < 0:
                num <- 0
                pn <- p
            pre_rank <- rank
            pre_num <- num
            p <- pn
    # post-release: .postN or -N (and optional 'post' word after separator)
    if p < e:
        b: u8 = data[p.usize()]
        if b == 45 or b == 46:
            num: i64 = |pn|
                q: mutable i64 = p + 1
                wlen: i64 = rh_pep_word(data, q, e, "post")
                if wlen > 0:
                    q <- q + wlen
                pn <- 0
                value: i64 = rh_pep_digits(data, q, e, &pn)
                value
            if num >= 0:
                post <- num
                p <- pn
    # dev release: .devN or devN (separator optional)
    if p < e:
        q: mutable i64 = p
        if data[q.usize()] == 46:
            q <- q + 1
        wlen: i64 = rh_pep_word(data, q, e, "dev")
        if wlen > 0:
            q <- q + wlen
            pn <- 0
            num: mutable i64 = rh_pep_digits(data, q, e, &pn)
            if num < 0:
                num <- 0
                pn <- q
            dev <- num
            p <- pn
    # local: +... consumed (presence only)
    if p < e:
        if data[p.usize()] == 43:
            return rh_pep_invalid() if p + 1 >= e
            local <- 0
            p <- e
    if p != e:
        return rh_pep_invalid()
    # dev-only versions (no pre, no post) sort below any pre-release.
    if pre_rank == RH_PEP_PRE_NONE and post == -1 and dev != RH_PEP_DEV_ABSENT:
        pre_rank <- RH_PEP_PRE_DEV_ONLY
    RhPep440{ok: 1, epoch: epoch, n: n, r0: rh_pep_seg(rel, 0), r1: rh_pep_seg(rel, 1), r2: rh_pep_seg(rel, 2), r3: rh_pep_seg(rel, 3), r4: rh_pep_seg(rel, 4), r5: rh_pep_seg(rel, 5), r6: rh_pep_seg(rel, 6), r7: rh_pep_seg(rel, 7), pre_rank: pre_rank, pre_num: pre_num, post: post, dev: dev, local: local}

# (private to this file)
def rh_pep_seg(rel: darray[i64]&, i: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    return rel[i.usize()] if i < rel.count.i64()
    0

# -1, 0, 1; 2 when either side is invalid (callers check ok first).
def rh_pep440_cmp(a: RhPep440&, b: RhPep440&) -> i64 can[Memory.Allocate, Abort.Panic]:
    return 2 if a.ok != 1 or b.ok != 1
    return rh_pep_sign(a.epoch - b.epoch) if a.epoch != b.epoch
    maxn: mutable i64 = a.n
    if b.n > maxn:
        maxn <- b.n
    while i < maxn |i: i64 = 0, a, b, maxn|:
        x: i64 = rh_pep_field(a, i)
        y: i64 = rh_pep_field(b, i)
        return rh_pep_sign(x - y) if x != y
        i <- i + 1
    return rh_pep_sign(a.pre_rank - b.pre_rank) if a.pre_rank != b.pre_rank
    return rh_pep_sign(a.pre_num - b.pre_num) if a.pre_rank >= RH_PEP_PRE_A and a.pre_rank <= RH_PEP_PRE_RC and a.pre_num != b.pre_num
    return rh_pep_sign(a.post - b.post) if a.post != b.post
    return rh_pep_sign(a.dev - b.dev) if a.dev != b.dev
    return rh_pep_sign(a.local - b.local) if a.local != b.local
    0

# (private to this file)
def rh_pep_sign(v: i64) -> i64:
    return -1 if v < 0
    return 1 if v > 0
    0

# (private to this file)
def rh_pep_field(v: RhPep440&, i: i64) -> i64:
    return v.r0 if i == 0
    return v.r1 if i == 1
    return v.r2 if i == 2
    return v.r3 if i == 3
    return v.r4 if i == 4
    return v.r5 if i == 5
    return v.r6 if i == 6
    return v.r7 if i == 7
    0
