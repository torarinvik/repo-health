# rh_temporal.elisa — temporal primitives (M00-03).
#
# UTC instants as i64 Unix seconds; half-open intervals [start, end);
# complete-calendar-month iteration via Howard Hinnant's civil algorithms in
# pure integer arithmetic; valid/system (bitemporal) pairs; time-basis tags.
#
# Supported date range: civil years >= 1 with Unix instants >= 0 (1970+).
# Earlier instants are out of scope for the M00 slice and rejected by
# rh_civil_from_days callers checking rh_instant_supported.
# Invalid interval ordering (start >= end) is rejected by rh_interval_valid,
# except where a metric intentionally preserves a meaningful signed interval
# (e.g. fix-before-disclosure, plan §8.5): use rh_signed_duration there.

module Temporal:
    public:
        const RH_TIME_BASIS_AUTHOR: u8 = 0
        const RH_TIME_BASIS_COMMITTER: u8 = 1
        const RH_TIME_BASIS_OBSERVED: u8 = 2
        const RH_TIME_BASIS_VALID: u8 = 3
        const RH_TIME_BASIS_SYSTEM: u8 = 4
        const RH_TIME_BASIS_UNKNOWN: u8 = 255

        const RH_INTERVAL_OUTSIDE: u8 = 0
        const RH_INTERVAL_WITHIN: u8 = 1
        const RH_INTERVAL_UNKNOWN: u8 = 2
        const RH_INTERVAL_INVALID: u8 = 3

        struct RhBitemporal:
            valid_start: i64
            valid_end: i64
            valid_end_known: bool
            known_start: i64
            known_end: i64
            known_end_known: bool

        # Left-censored intervals have a known end but an unknown start. The
        # unused start field is canonicalized to zero, never overloaded as an
        # epoch or unbounded-time sentinel.
        struct RhLeftCensoredInterval:
            start: i64
            end: i64
            start_known: bool

        def rh_time_basis_valid(basis: u8) -> bool:
            return true if basis == RH_TIME_BASIS_AUTHOR
            return true if basis == RH_TIME_BASIS_COMMITTER
            return true if basis == RH_TIME_BASIS_OBSERVED
            return true if basis == RH_TIME_BASIS_VALID
            return true if basis == RH_TIME_BASIS_SYSTEM
            basis == RH_TIME_BASIS_UNKNOWN

        def rh_time_basis_label(basis: u8) -> u8&:
            return "author" if basis == RH_TIME_BASIS_AUTHOR
            return "committer" if basis == RH_TIME_BASIS_COMMITTER
            return "observed" if basis == RH_TIME_BASIS_OBSERVED
            return "valid" if basis == RH_TIME_BASIS_VALID
            return "system" if basis == RH_TIME_BASIS_SYSTEM
            return "unknown" if basis == RH_TIME_BASIS_UNKNOWN
            "invalid-time-basis"

        def rh_left_censored_interval_make(start_known: bool, start: i64, end: i64) -> RhLeftCensoredInterval:
            RhLeftCensoredInterval{start: start if start_known else 0, end: end, start_known: start_known}

        def rh_left_censored_interval_valid(interval: RhLeftCensoredInterval) -> bool:
            return false if not rh_instant_supported(interval.end)
            return false if interval.start_known and not rh_instant_supported(interval.start)
            return rh_interval_valid(interval.start, interval.end) if interval.start_known
            interval.start == 0 and interval.end > 0

        # Membership is tri-state: a point before a known end could be inside
        # or outside a left-censored interval, so it is never asserted true.
        def rh_left_censored_membership(interval: RhLeftCensoredInterval, instant: i64) -> u8:
            return RH_INTERVAL_INVALID if not rh_left_censored_interval_valid(interval)
            return RH_INTERVAL_INVALID if not rh_instant_supported(instant)
            return RH_INTERVAL_OUTSIDE if instant >= interval.end
            return RH_INTERVAL_UNKNOWN if not interval.start_known
            return RH_INTERVAL_OUTSIDE if instant < interval.start
            RH_INTERVAL_WITHIN

        # Non-empty half-open interval check over supported UTC instants.
        def rh_interval_valid(start: i64, end: i64) -> bool:
            return false if not rh_instant_supported(start) or not rh_instant_supported(end)
            start < end

        # Checked duration for supported UTC instants and non-empty ranges.
        # The result is written only after all timestamp and ordering checks.
        def rh_duration_checked(start: i64, end: i64, duration_out: mutable i64&) -> bool:
            return false if not rh_instant_supported(start) or not rh_instant_supported(end)
            return false if not rh_interval_valid(start, end)
            duration_out[0] <- end - start
            true

        # Signed differences are allowed for explicitly meaningful measures,
        # but the caller output remains untouched if subtraction would overflow.
        def rh_signed_duration_checked(start: i64, end: i64, duration_out: mutable i64&) -> bool:
            return false if end > start and start < 0 and end > 9223372036854775807 + start
            return false if end < start and end < 0 and start > 9223372036854775807 + end + 1
            duration_out[0] <- end - start
            true

        def rh_interval_contains(start: i64, end: i64, t: i64) -> bool:
            return false if not rh_instant_supported(start) or not rh_instant_supported(end) or not rh_instant_supported(t)
            return false if not rh_interval_valid(start, end)
            return false if t < start
            t < end

        def rh_intervals_overlap(a_start: i64, a_end: i64, b_start: i64, b_end: i64) -> bool:
            return false if not rh_interval_valid(a_start, a_end) or not rh_interval_valid(b_start, b_end)
            return false if a_end <= b_start
            b_end > a_start

        def rh_instant_supported(t: i64) -> bool:
            t >= 0

        def rh_civil_date_valid(year: i64, month: i64, day: i64) -> bool:
            return false if year < 1 or month < 1 or month > 12 or day < 1
            days_in_month: i64 =
                if month == 2:
                    leap: bool = year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)
                    29 if leap else 28
                elif month == 4 or month == 6 or month == 9 or month == 11:
                    30
                else:
                    31
            day <= days_in_month

        def rh_unix_from_civil_checked(year: i64, month: i64, day: i64, instant_out: mutable i64&) -> bool:
            rh_unix_from_civil_time_checked(year, month, day, 0, 0, 0, 0, instant_out)

        # Convert local civil time plus a UTC offset without overflowing any
        # intermediate. POSIX Unix seconds cannot represent leap seconds, so
        # second 60 is rejected instead of silently normalized into next minute.
        # Offsets follow the ISO-8601 maximum of 23:59.
        def rh_unix_from_civil_time_checked(year: i64, month: i64, day: i64, hour: i64, minute: i64, second: i64, offset_seconds: i64, instant_out: mutable i64&) -> bool:
            return false if not rh_civil_date_valid(year, month, day)
            return false if year > 292277026597
            return false if hour < 0 or hour > 23 or minute < 0 or minute > 59 or second < 0 or second > 59
            return false if offset_seconds < -86340 or offset_seconds > 86340
            days: i64 = rh_days_from_civil(year, month, day)
            return false if days < -106751991167300 or days > 106751991167300
            day_seconds: i64 = days * 86400
            within_day: i64 = hour * 3600 + minute * 60 + second - offset_seconds
            return false if within_day < 0 and day_seconds < 0 - within_day
            return false if within_day > 0 and day_seconds > 9223372036854775807 - within_day
            instant: i64 = day_seconds + within_day
            return false if instant < 0
            instant_out[0] <- instant
            true

        def rh_days_from_civil(y: i64, m: i64, d: i64) -> i64:
            # Precondition: rh_civil_date_valid(y, m, d). Parsing boundaries
            # should validate once, then use this allocation-free conversion.
            yy: i64 = y - 1 if m <= 2 else y
            era: i64 = yy / 400
            doe: i64 =
                yoe: i64 = yy - era * 400
                doy: i64 =
                    mp: i64 = m + 9 if m <= 2 else m - 3
                    (153 * mp + 2) / 5 + d - 1
                yoe * 365 + yoe / 4 - yoe / 100 + doy
            era * 146097 + doe - 719468

        def rh_civil_from_days(z: i64, y_out: mutable i64&, m_out: mutable i64&, d_out: mutable i64&) -> void:
            zz: i64 = z + 719468
            era: i64 = zz / 146097
            doe: i64 = zz - era * 146097
            yoe: i64 = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
            y: i64 = yoe + era * 400
            doy: i64 = doe - (365 * yoe + yoe / 4 - yoe / 100)
            mp: i64 = (5 * doy + 2) / 153
            d: i64 = doy - (153 * mp + 2) / 5 + 1
            m: i64 = mp + 3 if mp < 10 else mp - 9
            y_out[0] <- y + 1 if m <= 2 else y
            m_out[0] <- m
            d_out[0] <- d

        def rh_unix_from_civil(y: i64, m: i64, d: i64) -> i64:
            rh_days_from_civil(y, m, d) * 86400

        # Complete-calendar-month index: y * 12 + (m - 1).
        def rh_month_index(y: i64, m: i64) -> i64:
            y * 12 + (m - 1)

        # Checked month index. Invalid instants leave the output untouched.
        def rh_month_of_instant(t: i64, month_out: mutable i64&) -> bool:
            return false if not rh_instant_supported(t)
            month_out[0] <-
                y: mutable i64 = 0
                m: mutable i64 = 0
                d: mutable i64 = 0
                rh_civil_from_days(t / 86400, &y, &m, &d)
                rh_month_index(y, m)
            true

        # Whole complete months in [start, end): month(end) - month(start).
        def rh_complete_months_between(start: i64, end: i64) -> i64:
            return -1 if not rh_instant_supported(start) or not rh_instant_supported(end) or end < start
            ms: i64 =
                month: mutable i64 = 0
                return -1 if not rh_month_of_instant(start, &month)
                month
            me: i64 =
                month: mutable i64 = 0
                return -1 if not rh_month_of_instant(end, &month)
                month
            me - ms

        # Bitemporal visibility: a fact is visible to a query as of `cutoff` only
        # when it was already known then. A 2024 introduction first collected in
        # 2026 is NOT visible to a 2025-cutoff query (no historical prediction
        # using later evidence, S009); a retrospective query sees it.
        def rh_visible_as_of(fact: RhBitemporal, cutoff: i64) -> bool:
            return false if not rh_bitemporal_valid(fact)
            return false if not rh_instant_supported(cutoff)
            return false if cutoff < fact.known_start
            return cutoff < fact.known_end if fact.known_end_known
            true

        def rh_bitemporal_valid(fact: RhBitemporal) -> bool:
            return false if not rh_instant_supported(fact.valid_start)
            return false if not rh_instant_supported(fact.known_start)
            return false if fact.valid_end_known and not rh_instant_supported(fact.valid_end)
            return false if fact.known_end_known and not rh_instant_supported(fact.known_end)
            return false if fact.valid_end_known and not rh_interval_valid(fact.valid_start, fact.valid_end)
            return false if fact.known_end_known and not rh_interval_valid(fact.known_start, fact.known_end)
            return false if not fact.valid_end_known and fact.valid_end != 0
            return false if not fact.known_end_known and fact.known_end != 0
            true

        def rh_bitemporal_visible_at(fact: RhBitemporal, valid_at: i64, known_at: i64) -> bool:
            return false if not rh_bitemporal_valid(fact)
            return false if not rh_instant_supported(valid_at) or not rh_instant_supported(known_at)
            return false if valid_at < fact.valid_start or known_at < fact.known_start
            return false if fact.valid_end_known and valid_at >= fact.valid_end
            known_at < fact.known_end if fact.known_end_known else true

        def rh_bitemporal_make(valid_start: i64, valid_end: i64, valid_end_known: bool, known_start: i64, known_end: i64, known_end_known: bool) -> RhBitemporal:
            RhBitemporal{
                valid_start: valid_start,
                valid_end: valid_end if valid_end_known else 0,
                valid_end_known: valid_end_known,
                known_start: known_start,
                known_end: known_end if known_end_known else 0,
                known_end_known: known_end_known
            }
