# rh_correction_report.elisa — correction workflow execution path (M06-07).
#
# Turns an `rh-corrections/1` document into an `rh-corrections-result/1`
# report. Accepted corrections advance the revision and mark only that
# subject's older derived results superseded; rejected/open corrections
# change nothing. Raw inputs are supplied for replay and are never rewritten
# by this path, so the corrected derived value is reproducible from the same
# ledger. Malformed or unknown kind/state/combine fails closed (-1).

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_correction.elisa"

# private to this file (modules retried after re-seed; see CHANGELOG).
module CorrectionReport:
    private:
        def rh_cr_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_cr_kind(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Correction::RH_CORR_IDENTITY if rh_cr_eq(texts, s, e, "identity")
            return Correction::RH_CORR_MAPPING if rh_cr_eq(texts, s, e, "mapping")
            return Correction::RH_CORR_MEASUREMENT if rh_cr_eq(texts, s, e, "measurement")
            -1

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_cr_state(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Correction::RH_CORR_OPEN if rh_cr_eq(texts, s, e, "open")
            return Correction::RH_CORR_ACCEPTED if rh_cr_eq(texts, s, e, "accepted")
            return Correction::RH_CORR_REJECTED if rh_cr_eq(texts, s, e, "rejected")
            -1

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_cr_combine(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return 0 if rh_cr_eq(texts, s, e, "add")
            return 1 if rh_cr_eq(texts, s, e, "subtract")
            return 2 if rh_cr_eq(texts, s, e, "identity")
            -1

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_cr_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return false if idx < 0
            Json::rh_json_str_span(nodes, idx, s_out, e_out)

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_cr_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            ok_out[0] <- 0
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return 0 if idx < 0
            Json::rh_json_int(nodes, raw, idx, ok_out)

        # Parse, apply, and emit. Returns 0 ok, -1 malformed.
    public:
        def rh_correction_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            empty: mutable darray[i64] = []
            fr: mutable i64 = 0
            fw: mutable i64 = -1
            rh_correction_report_state(raw, 0, 0, empty, &fr, &fw, out)

        # Stateful variant: `persisted_rev` is a revision floor carried over from a
        # prior run and `watermark` the 1-based ordinal of the last correction
        # already folded in (0 = none). Only corrections at an ordinal greater than
        # the watermark are applied, so replaying the same input is idempotent
        # across runs while multiple corrections to the same target in one document
        # still each count. `new_superseded` collects the subjects whose derived
        # results this run newly superseded.
        def rh_correction_report_state(raw: darray[u8]&, persisted_rev: i64, watermark: i64, new_superseded: mutable darray[i64]&, final_rev_out: mutable i64&, final_wm_out: mutable i64&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0
            return -1 if nodes[root.usize()].kind != Json::RH_JSON_OBJ
            rev: mutable i64 = |nodes, texts|
                ss: mutable i64 = 0
                se: mutable i64 = 0
                return -1 if not rh_cr_str(nodes, texts, root, "schema", &ss, &se)
                return -1 if not rh_cr_eq(texts, ss, se, "rh-corrections/1")
                okrev: mutable i64 = 0
                docrev: i64 = rh_cr_int(nodes, raw, texts, root, "current_revision", &okrev)
                return -1 if okrev == 0 or docrev < 0
                docrev
            wm: mutable i64 = watermark
            if persisted_rev > rev:
                rev <- persisted_rev

            # Derived results (subject, revision used, superseded).
            derived: mutable darray[Correction::RhDerived] = []
            didx: i64 = Json::rh_json_obj_get(nodes, texts, root, "derived")
            if didx >= 0:
                return -1 if nodes[didx.usize()].kind != Json::RH_JSON_ARR
                arr: Json::RhJsonNode = nodes[didx.usize()]
                while child >= 0 |child: i64 = arr.first_child, nodes, texts, raw, derived|:
                    return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                    oks: mutable i64 = 0
                    okr: mutable i64 = 0
                    sub: i64 = rh_cr_int(nodes, raw, texts, child, "subject_id", &oks)
                    used: i64 = rh_cr_int(nodes, raw, texts, child, "revision_used", &okr)
                    return -1 if oks == 0 or okr == 0
                    sup: mutable bool = false
                    sidx: i64 = Json::rh_json_obj_get(nodes, texts, child, "superseded")
                    if sidx >= 0:
                        sup <- Json::rh_json_is_true(nodes, raw, sidx)
                    derived.push(Correction::RhDerived{subject_id: sub, revision_used: used, superseded: sup})
                    child <- nodes[child.usize()].next_sibling

            # Replay inputs (subject, raw_a, raw_b, combine).
            ra: mutable darray[i64] = []
            rb: mutable darray[i64] = []
            rsub: mutable darray[i64] = []
            rcomb: mutable darray[i64] = []
            ridx: i64 = Json::rh_json_obj_get(nodes, texts, root, "replay")
            if ridx >= 0:
                return -1 if nodes[ridx.usize()].kind != Json::RH_JSON_ARR
                rarr: Json::RhJsonNode = nodes[ridx.usize()]
                while rchild >= 0 |rchild: i64 = rarr.first_child, nodes, texts, raw, ra, rb, rsub, rcomb|:
                    return -1 if nodes[rchild.usize()].kind != Json::RH_JSON_OBJ
                    ok1: mutable i64 = 0
                    ok2: mutable i64 = 0
                    ok3: mutable i64 = 0
                    a: i64 = rh_cr_int(nodes, raw, texts, rchild, "raw_a", &ok1)
                    b: i64 = rh_cr_int(nodes, raw, texts, rchild, "raw_b", &ok2)
                    sub2: i64 = rh_cr_int(nodes, raw, texts, rchild, "subject_id", &ok3)
                    return -1 if ok1 == 0 or ok2 == 0 or ok3 == 0
                    comb: i64 = |nodes, texts|
                        cs: mutable i64 = 0
                        ce: mutable i64 = 0
                        return -1 if not rh_cr_str(nodes, texts, rchild, "combine", &cs, &ce)
                        block_result: i64 = rh_cr_combine(texts, cs, ce)
                        block_result
                    return -1 if comb < 0
                    ra.push(a)
                    rb.push(b)
                    rsub.push(sub2)
                    rcomb.push(comb)
                    rchild <- nodes[rchild.usize()].next_sibling

            # Corrections (kind, target, state) — applied in document order.
            cidx: i64 = Json::rh_json_obj_get(nodes, texts, root, "corrections")
            return -1 if cidx < 0 or nodes[cidx.usize()].kind != Json::RH_JSON_ARR
            carr: Json::RhJsonNode = nodes[cidx.usize()]
            # Emitted applied entries, collected as we go.
            app_kind: mutable darray[i64] = []
            app_target: mutable darray[i64] = []
            app_state: mutable darray[i64] = []
            app_before: mutable darray[i64] = []
            app_after: mutable darray[i64] = []
            app_super: mutable darray[i64] = []
            app_evidence_s: mutable darray[i64] = []
            app_evidence_e: mutable darray[i64] = []
            app_reviewer_s: mutable darray[i64] = []
            app_reviewer_e: mutable darray[i64] = []
            app_reviewed_at: mutable darray[i64] = []
            app_newly_applied: mutable darray[u8] = []
            while cchild >= 0 |cchild: i64 = carr.first_child, ordinal: i64 = 0, nodes, texts, raw, derived, rev, wm, app_kind, app_target, app_state, app_before, app_after, app_super, app_evidence_s, app_evidence_e, app_reviewer_s, app_reviewer_e, app_reviewed_at, app_newly_applied, new_superseded|:
                return -1 if nodes[cchild.usize()].kind != Json::RH_JSON_OBJ
                ordinal <- ordinal + 1
                ks: mutable i64 = 0
                ke: mutable i64 = 0
                sts: mutable i64 = 0
                ste: mutable i64 = 0
                return -1 if not rh_cr_str(nodes, texts, cchild, "kind", &ks, &ke)
                return -1 if not rh_cr_str(nodes, texts, cchild, "state", &sts, &ste)
                kind: i64 = rh_cr_kind(texts, ks, ke)
                state: i64 = rh_cr_state(texts, sts, ste)
                return -1 if kind < 0 or state < 0
                okt: mutable i64 = 0
                target: i64 = rh_cr_int(nodes, raw, texts, cchild, "target_id", &okt)
                return -1 if okt == 0
                evidence_s: mutable i64 = 0
                evidence_e: mutable i64 = 0
                return -1 if not rh_cr_str(nodes, texts, cchild, "evidence_ref", &evidence_s, &evidence_e) or evidence_s == evidence_e
                reviewer_s: mutable i64 = -1
                reviewer_e: mutable i64 = -1
                reviewer_idx: i64 = Json::rh_json_obj_get(nodes, texts, cchild, "reviewed_by")
                if reviewer_idx >= 0:
                    return -1 if not Json::rh_json_str_span(nodes, reviewer_idx, &reviewer_s, &reviewer_e) or reviewer_s == reviewer_e
                reviewed_at_ok: mutable i64 = 0
                reviewed_at: mutable i64 = rh_cr_int(nodes, raw, texts, cchild, "reviewed_at", &reviewed_at_ok)
                reviewed_at <- -1 if reviewed_at_ok == 0
                return -1 if state != Correction::RH_CORR_OPEN and (reviewer_idx < 0 or reviewed_at_ok == 0 or reviewed_at < 0)
                return -1 if reviewer_idx >= 0 and (reviewed_at_ok == 0 or reviewed_at < 0)
                return -1 if reviewer_idx < 0 and reviewed_at_ok != 0
                before: i64 = rev
                # Idempotent replay: a correction at or below the watermark ordinal
                # was folded in by a prior run, so it is recorded as already-applied
                # and never advances the revision again.
                already: bool = true if ordinal <= wm else false
                c: Correction::RhCorrection = Correction::RhCorrection{kind: kind.u8(), target_id: target, state: state.u8()}
                if not already:
                    rev <- Correction::rh_correction_apply(&c, rev)
                sup_ids: mutable darray[i64] = []
                scount: mutable i64 = 0
                if rev > before:
                    # Count only NEWLY superseded results (a later accepted correction
                    # must not re-count results an earlier one already superseded).
                    pre: i64 =
                        while pi < derived.count |pre: i64 = 0, pi: usize = 0, derived| -> pre:
                            dpre: Correction::RhDerived = derived[pi]
                            if dpre.subject_id == target and dpre.revision_used < rev and not dpre.superseded:
                                pre <- pre + 1
                            pi <- pi + 1
                    _ = Correction::rh_invalidate_derived(derived, &c, rev, sup_ids)
                    scount <- pre
                    new_superseded.push(target)
                if ordinal > wm:
                    wm <- ordinal
                app_kind.push(kind)
                app_target.push(target)
                app_state.push(state)
                app_before.push(before)
                app_after.push(rev)
                app_super.push(scount)
                app_evidence_s.push(evidence_s)
                app_evidence_e.push(evidence_e)
                app_reviewer_s.push(reviewer_s)
                app_reviewer_e.push(reviewer_e)
                app_reviewed_at.push(reviewed_at)
                app_newly_applied.push(1 if not already else 0)
                cchild <- nodes[cchild.usize()].next_sibling

            Base::rh_push_text(out, "{\"schema\":\"rh-corrections-result/1\",\"final_revision\":")
            Base::rh_push_decimal_i64(out, rev)
            Base::rh_push_text(out, ",\"applied\":[")
            while i < app_kind.count.i64() |i: i64 = 0, app_kind, app_target, app_state, app_before, app_after, app_super, app_evidence_s, app_evidence_e, app_reviewer_s, app_reviewer_e, app_reviewed_at, app_newly_applied, texts, out|:
                if i > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"kind\":\"")
                Base::rh_push_text(out, rh_cr_kind_label(app_kind[i.usize()]))
                Base::rh_push_text(out, "\",\"target_id\":")
                Base::rh_push_decimal_i64(out, app_target[i.usize()])
                Base::rh_push_text(out, ",\"state\":\"")
                Base::rh_push_text(out, rh_cr_state_label(app_state[i.usize()]))
                Base::rh_push_text(out, "\",\"revision_before\":")
                Base::rh_push_decimal_i64(out, app_before[i.usize()])
                Base::rh_push_text(out, ",\"revision_after\":")
                Base::rh_push_decimal_i64(out, app_after[i.usize()])
                Base::rh_push_text(out, ",\"newly_applied\":")
                Base::rh_push_text(out, "true") if app_newly_applied[i.usize()] == 1
                Base::rh_push_text(out, "false") if app_newly_applied[i.usize()] == 0
                Base::rh_push_text(out, ",\"superseded_count\":")
                Base::rh_push_decimal_i64(out, app_super[i.usize()])
                Base::rh_push_text(out, ",\"evidence_ref\":\"")
                Base::rh_json_escape(out, texts, app_evidence_s[i.usize()].usize(), app_evidence_e[i.usize()].usize())
                Base::rh_push_text(out, "\",\"reviewed_by\":")
                if app_reviewer_s[i.usize()] < 0:
                    Base::rh_push_text(out, "null")
                else:
                    Base::rh_push_text(out, "\"")
                    Base::rh_json_escape(out, texts, app_reviewer_s[i.usize()].usize(), app_reviewer_e[i.usize()].usize())
                    Base::rh_push_text(out, "\"")
                Base::rh_push_text(out, ",\"reviewed_at\":")
                if app_reviewed_at[i.usize()] < 0:
                    Base::rh_push_text(out, "null")
                else:
                    Base::rh_push_decimal_i64(out, app_reviewed_at[i.usize()])
                Base::rh_push_text(out, "}")
                i <- i + 1
            Base::rh_push_text(out, "],\"notices\":[")
            notice_first: mutable bool = true
            while ni < app_kind.count.i64() |ni: i64 = 0, app_kind, app_target, app_state, app_after, app_super, app_evidence_s, app_evidence_e, app_reviewer_s, app_reviewer_e, app_reviewed_at, app_newly_applied, texts, out, notice_first|:
                if app_state[ni.usize()] == Correction::RH_CORR_ACCEPTED and app_newly_applied[ni.usize()] == 1:
                    if not notice_first:
                        out.push(44)
                    notice_first <- false
                    Base::rh_push_text(out, "{\"subject_id\":")
                    Base::rh_push_decimal_i64(out, app_target[ni.usize()])
                    Base::rh_push_text(out, ",\"correction_revision\":")
                    Base::rh_push_decimal_i64(out, app_after[ni.usize()])
                    Base::rh_push_text(out, ",\"kind\":\"")
                    Base::rh_push_text(out, rh_cr_kind_label(app_kind[ni.usize()]))
                    Base::rh_push_text(out, "\",\"evidence_ref\":\"")
                    Base::rh_json_escape(out, texts, app_evidence_s[ni.usize()].usize(), app_evidence_e[ni.usize()].usize())
                    Base::rh_push_text(out, "\",\"reviewed_by\":\"")
                    Base::rh_json_escape(out, texts, app_reviewer_s[ni.usize()].usize(), app_reviewer_e[ni.usize()].usize())
                    Base::rh_push_text(out, "\",\"reviewed_at\":")
                    Base::rh_push_decimal_i64(out, app_reviewed_at[ni.usize()])
                    Base::rh_push_text(out, ",\"superseded_count\":")
                    Base::rh_push_decimal_i64(out, app_super[ni.usize()])
                    Base::rh_push_text(out, "}")
                ni <- ni + 1
            Base::rh_push_text(out, "],\"derived\":[")
            while d2 < derived.count.i64() |d2: i64 = 0, derived, out|:
                if d2 > 0:
                    out.push(44)
                d: Correction::RhDerived = derived[d2.usize()]
                Base::rh_push_text(out, "{\"subject_id\":")
                Base::rh_push_decimal_i64(out, d.subject_id)
                Base::rh_push_text(out, ",\"revision_used\":")
                Base::rh_push_decimal_i64(out, d.revision_used)
                Base::rh_push_text(out, ",\"superseded\":")
                if d.superseded:
                    Base::rh_push_text(out, "true")
                else:
                    Base::rh_push_text(out, "false")
                Base::rh_push_text(out, "}")
                d2 <- d2 + 1
            Base::rh_push_text(out, "],\"replay\":[")
            while r2 < ra.count.i64() |r2: i64 = 0, ra, rb, rsub, rcomb, out|:
                if r2 > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"subject_id\":")
                Base::rh_push_decimal_i64(out, rsub[r2.usize()])
                Base::rh_push_text(out, ",\"value\":")
                val: i64 = Correction::rh_replay_value(ra[r2.usize()], rb[r2.usize()], rcomb[r2.usize()].u8())
                Base::rh_push_decimal_i64(out, val)
                Base::rh_push_text(out, "}")
                r2 <- r2 + 1
            Base::rh_push_text(out, "],\"note\":\"accepted corrections advance the revision and supersede only that subject's older derived results; raw inputs are never rewritten, so replay is reproducible from the same ledger\"}")
            final_rev_out[0] <- rev
            final_wm_out[0] <- wm
            0

    private:
        def rh_cr_kind_label(k: i64) -> u8&:
            return "identity" if k == 0
            return "mapping" if k == 1
            "measurement"

        def rh_cr_state_label(s: i64) -> u8&:
            return "accepted" if s == 1
            return "rejected" if s == 2
            "open"

        # --- Durable correction ledger (M06-07). ---
        # Persist the accepted revision and the set of subjects whose derived
        # results were superseded under an `rh-corrections-state/1` document. The
        # next run folds in only corrections with `target_id` greater than the
        # persisted watermark, so a correction is counted at most once even if the
        # same input file is replayed (idempotent across runs). Raw replay inputs
        # are never stored here, so the raw ledger stays the sole source of truth.
        # An empty buffer is a fresh state; malformed state fails closed.

    public:
        def rh_correction_state_parse(raw: darray[u8]&, revision_out: mutable i64&, watermark_out: mutable i64&, superseded: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            revision_out[0] <- 0
            watermark_out[0] <- 0
            return 0 if raw.count == 0
            nodes: mutable darray[Json::RhJsonNode] = []
            sidx: i64 = |revision_out, watermark_out, nodes|
                texts: mutable darray[u8] = []
                root: i64 = Json::rh_json_parse(raw, nodes, texts)
                return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
                ss: mutable i64 = 0
                se: mutable i64 = 0
                return -1 if not rh_cr_str(nodes, texts, root, "schema", &ss, &se)
                return -1 if not rh_cr_eq(texts, ss, se, "rh-corrections-state/1")
                okrev: mutable i64 = 0
                okwm: mutable i64 = 0
                rev: i64 = rh_cr_int(nodes, raw, texts, root, "revision", &okrev)
                wm: i64 = rh_cr_int(nodes, raw, texts, root, "watermark", &okwm)
                return -1 if okrev == 0 or okwm == 0 or rev < 0 or wm < 0
                revision_out[0] <- rev
                watermark_out[0] <- wm
                block_result: i64 = Json::rh_json_obj_get(nodes, texts, root, "superseded_subjects")
                block_result
            if sidx >= 0:
                return -1 if nodes[sidx.usize()].kind != Json::RH_JSON_ARR
                arr: Json::RhJsonNode = nodes[sidx.usize()]
                while child >= 0 |child: i64 = arr.first_child, nodes, raw, superseded|:
                    oks: mutable i64 = 0
                    sub: i64 = Json::rh_json_int(nodes, raw, child, &oks)
                    return -1 if oks == 0
                    superseded.push(sub)
                    child <- nodes[child.usize()].next_sibling
            0

        def rh_correction_state_emit(revision: i64, watermark: i64, superseded: darray[i64]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-corrections-state/1\",\"revision\":")
            Base::rh_push_decimal_i64(out, revision)
            Base::rh_push_text(out, ",\"watermark\":")
            Base::rh_push_decimal_i64(out, watermark)
            Base::rh_push_text(out, ",\"superseded_subjects\":[")
            while i < superseded.count |i: usize = 0, superseded, out|:
                if i > 0:
                    out.push(44)
                Base::rh_push_decimal_i64(out, superseded[i])
                i <- i + 1
            Base::rh_push_text(out, "]}")
