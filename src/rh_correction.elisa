# rh_correction.elisa — correction workflow core (M06-07).
#
# A correction is a dispute over identity, mapping, or measurement with an
# explicit review state. Accepting one produces a NEW revision and
# invalidates derived results that were computed under the old revision
# (they are marked superseded, never silently rewritten); raw inputs are
# untouched, so replay after the correction yields the corrected derived
# value from the same ledger. Rejecting changes nothing. This is the
# machine half of the correction workflow; review UI/notices are a product
# surface on top.

const RH_CORR_IDENTITY: u8 = 0
const RH_CORR_MAPPING: u8 = 1
const RH_CORR_MEASUREMENT: u8 = 2

const RH_CORR_OPEN: u8 = 0
const RH_CORR_ACCEPTED: u8 = 1
const RH_CORR_REJECTED: u8 = 2

struct RhCorrection:
    kind: mutable u8
    target_id: mutable i64
    state: mutable u8

# Derived result produced by the metric layer: which revision it used and
# whether it is still current.
struct RhDerived:
    subject_id: mutable i64
    revision_used: mutable i64
    superseded: mutable bool

# Apply a correction: accepted advances the revision; open/rejected leave
# it. Returns the resulting revision.
def rh_correction_apply(c: RhCorrection&, current_revision: i64) -> i64:
    return current_revision + 1 if c.state == RH_CORR_ACCEPTED
    current_revision

# Invalidate derived results computed under an older revision for the
# correction's subject. Marks them superseded and returns the count; the
# caller publishes notices. Raw inputs are not reachable from here.
def rh_invalidate_derived(derived: mutable darray[RhDerived]&, c: RhCorrection&, new_revision: i64, superseded_out: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0 if c.state != RH_CORR_ACCEPTED
    while i < derived.count |count: i64 = 0, i: usize = 0, derived, superseded_out| -> count:
        d: RhDerived = derived[i]
        if d.subject_id == c.target_id and d.revision_used < new_revision:
            d.superseded <- true
            derived[i] <- d
            superseded_out.push(d.subject_id)
            count <- count + 1
        i <- i + 1

# Replayable recomputation: given the correction and the raw inputs, the
# derived value is recomputed. The test drives this with a corrected raw
# mapping to show the output changes while the raw ledger itself is
# passed unchanged.
def rh_replay_value(raw_a: i64, raw_b: i64, combine: u8) -> i64:
    return raw_a + raw_b if combine == 0
    return raw_a - raw_b if combine == 1
    raw_a
