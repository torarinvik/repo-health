# rh_ecosystem_lookup.elisa — bounded ecosyste.ms package lookup capture (M03-10).
#
# The adapter consumes a reviewed capture or one explicitly requested package
# lookup. Provider identifiers and source locators remain enrichment evidence;
# they never become canonical package or repository identity. Unknown fields
# are ignored, while malformed observed records are counted and rejected.

include "./rh_base.elisa"
include "./rh_json.elisa"

const RH_ECOSYSTEM_LOOKUP_MAX_BYTES: i64 = 4194304
const RH_ECOSYSTEM_LOOKUP_MAX_RESULTS: i64 = 1000

module EcosystemLookup:
    private:
        def rh_ecosystem_lookup_span(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, start_out: mutable i64&, end_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return false if idx < 0
            node: Json::RhJsonNode = nodes[idx.usize()]
            return false if node.kind != Json::RH_JSON_STR or node.text_end <= node.text_start
            start_out[0] <- node.text_start
            end_out[0] <- node.text_end
            true

        def rh_ecosystem_lookup_optional_span(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, start_out: mutable i64&, end_out: mutable i64&, present_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            if idx < 0:
                present_out[0] <- 0
                start_out[0] <- -1
                end_out[0] <- -1
                return true
            node: Json::RhJsonNode = nodes[idx.usize()]
            return false if node.kind != Json::RH_JSON_STR and node.kind != Json::RH_JSON_NULL
            return false if node.kind == Json::RH_JSON_STR and node.text_end <= node.text_start
            present: mutable i64 = 0
            present <- 1 if node.kind == Json::RH_JSON_STR
            present_out[0] <- present
            start_out[0] <- node.text_start
            end_out[0] <- node.text_end
            true

        def rh_ecosystem_lookup_emit_span(out: mutable darray[u8]&, texts: darray[u8]&, start: i64, end: i64) -> void can[Memory.Allocate, Abort.Panic]:
            out.push(34)
            Base::rh_json_escape(out, texts, start.usize(), end.usize())
            out.push(34)

        def rh_ecosystem_lookup_emit_optional(out: mutable darray[u8]&, texts: darray[u8]&, start: i64, end: i64, present: bool) -> void can[Memory.Allocate, Abort.Panic]:
            rh_ecosystem_lookup_emit_span(out, texts, start, end) if present
            Base::rh_push_text(out, "null") if not present

        def rh_ecosystem_lookup_valid_query(ecosystem: cstr, name: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            ecosystem_len: usize = Base::rh_cstr_len_c(ecosystem)
            name_len: usize = Base::rh_cstr_len_c(name)
            return false if ecosystem_len == 0 or ecosystem_len > 48
            return false if name_len == 0 or name_len > 256
            while i < ecosystem_len |i: usize = 0, ecosystem, ecosystem_len|:
                b: u8 = ecosystem[i]
                return false if (b < 97 or b > 122) and (b < 48 or b > 57) and b != 45
                i <- i + 1
            supported_ecosystem: bool = Base::rh_streq(ecosystem, "cargo") or Base::rh_streq(ecosystem, "pypi") or Base::rh_streq(ecosystem, "go") or Base::rh_streq(ecosystem, "rubygems") or Base::rh_streq(ecosystem, "composer") or Base::rh_streq(ecosystem, "nuget") or Base::rh_streq(ecosystem, "maven") or Base::rh_streq(ecosystem, "npm")
            return false if not supported_ecosystem
            while i < name_len |i: usize = 0, name, name_len|:
                b: u8 = name[i]
                return false if b < 32 or b == 127
                i <- i + 1
            true

        def rh_ecosystem_lookup_emit_url_value(out: mutable darray[u8]&, value: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            n: usize = Base::rh_cstr_len_c(value)
            while i < n |i: usize = 0, value, n, out|:
                b: u8 = value[i]
                unreserved: bool = (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or (b >= 48 and b <= 57) or b == 45 or b == 46 or b == 95 or b == 126
                if unreserved:
                    out.push(b)
                else:
                    out.push(37)
                    Base::rh_push_hexdigit(out, b.u64() / 16)
                    Base::rh_push_hexdigit(out, b.u64() % 16)
                i <- i + 1

        def rh_ecosystem_lookup_report_with_origin(raw: darray[u8]&, out: mutable darray[u8]&, transport: u8&, source_url: cstr, status: cstr) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if raw.count.i64() > RH_ECOSYSTEM_LOOKUP_MAX_BYTES
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ

            schema_s: mutable i64 = -1
            schema_e: mutable i64 = -1
            provider_s: mutable i64 = -1
            provider_e: mutable i64 = -1
            return -1 if not EcosystemLookup::rh_ecosystem_lookup_span(nodes, texts, root, "schema", &schema_s, &schema_e)
            schema_matches: bool = Base::rh_bytes_equal_literal(texts, schema_s, schema_e, "rh-ecosystem-lookup-input/1")
            return -1 if schema_matches == false
            return -1 if not EcosystemLookup::rh_ecosystem_lookup_span(nodes, texts, root, "provider", &provider_s, &provider_e)
            provider_matches: bool = Base::rh_bytes_equal_literal(texts, provider_s, provider_e, "ecosyste.ms")
            return -1 if provider_matches == false
            query_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "query")
            return -1 if query_idx < 0 or nodes[query_idx.usize()].kind != Json::RH_JSON_OBJ
            query_eco_s: mutable i64 = -1
            query_eco_e: mutable i64 = -1
            query_name_s: mutable i64 = -1
            query_name_e: mutable i64 = -1
            return -1 if not EcosystemLookup::rh_ecosystem_lookup_span(nodes, texts, query_idx, "ecosystem", &query_eco_s, &query_eco_e)
            return -1 if not EcosystemLookup::rh_ecosystem_lookup_span(nodes, texts, query_idx, "name", &query_name_s, &query_name_e)

            results_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "results")
            return -1 if results_idx < 0 or nodes[results_idx.usize()].kind != Json::RH_JSON_ARR
            return -1 if nodes[results_idx.usize()].child_count > RH_ECOSYSTEM_LOOKUP_MAX_RESULTS

            Base::rh_push_text(out, "{\"schema\":\"rh-ecosystem-lookup-result/1\",\"provider\":\"ecosyste.ms\",\"query\":{\"ecosystem\":")
            EcosystemLookup::rh_ecosystem_lookup_emit_span(out, texts, query_eco_s, query_eco_e)
            Base::rh_push_text(out, ",\"name\":")
            EcosystemLookup::rh_ecosystem_lookup_emit_span(out, texts, query_name_s, query_name_e)
            Base::rh_push_text(out, "},\"origin\":{\"transport\":\"")
            Base::rh_push_text(out, transport)
            Base::rh_push_text(out, "\",\"source_url\":")
            if Base::rh_cstr_len_c(source_url) > 0:
                url_bytes: mutable darray[u8] = []
                Base::rh_push_cstr(url_bytes, source_url)
                out.push(34)
                Base::rh_json_escape(out, url_bytes, 0, url_bytes.count)
                out.push(34)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, ",\"status\":")
            if Base::rh_cstr_len_c(status) > 0:
                status_bytes: mutable darray[u8] = []
                Base::rh_push_cstr(status_bytes, status)
                out.push(34)
                Base::rh_json_escape(out, status_bytes, 0, status_bytes.count)
                out.push(34)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, ",\"data_license\":\"CC-BY-SA-4.0\",\"license_url\":\"https://creativecommons.org/licenses/by-sa/4.0/\",\"attribution_required\":true,\"attribution_url\":\"https://ecosyste.ms/\",\"modifications_made\":true,\"modification_note\":\"filtered to allowlisted package fields; unselected provider fields are omitted\"},\"results\":[")

            rejected: mutable i64 = 0
            emitted: mutable i64 = 0
            while child >= 0 |child: i64 = nodes[results_idx.usize()].first_child, nodes, texts, out, rejected, emitted|:
                accepted: mutable bool = nodes[child.usize()].kind == Json::RH_JSON_OBJ
                result_id_idx: i64 = Json::rh_json_obj_get(nodes, texts, child, "id")
                id_ok: mutable i64 = 0
                provider_id: i64 = Json::rh_json_int(nodes, raw, result_id_idx, &id_ok)
                accepted <- false if id_ok == 0 or provider_id < 0
                name_s: mutable i64 = -1
                name_e: mutable i64 = -1
                ecosystem_s: mutable i64 = -1
                ecosystem_e: mutable i64 = -1
                accepted <- false if not EcosystemLookup::rh_ecosystem_lookup_span(nodes, texts, child, "name", &name_s, &name_e)
                accepted <- false if not EcosystemLookup::rh_ecosystem_lookup_span(nodes, texts, child, "ecosystem", &ecosystem_s, &ecosystem_e)
                accepted <- false if not Base::rh_bytes_equal_span(texts, name_s, name_e, texts, query_name_s, query_name_e)
                accepted <- false if not Base::rh_bytes_equal_span(texts, ecosystem_s, ecosystem_e, texts, query_eco_s, query_eco_e)

                version_s: mutable i64 = -1
                version_e: mutable i64 = -1
                published_s: mutable i64 = -1
                published_e: mutable i64 = -1
                repository_s: mutable i64 = -1
                repository_e: mutable i64 = -1
                homepage_s: mutable i64 = -1
                homepage_e: mutable i64 = -1
                manifest_s: mutable i64 = -1
                manifest_e: mutable i64 = -1
                has_version: mutable i64 = 0
                has_published: mutable i64 = 0
                has_repository: mutable i64 = 0
                has_homepage: mutable i64 = 0
                has_manifest: mutable i64 = 0
                accepted <- false if not EcosystemLookup::rh_ecosystem_lookup_optional_span(nodes, texts, child, "latest_release_number", &version_s, &version_e, &has_version)
                accepted <- false if not EcosystemLookup::rh_ecosystem_lookup_optional_span(nodes, texts, child, "latest_release_published_at", &published_s, &published_e, &has_published)
                accepted <- false if not EcosystemLookup::rh_ecosystem_lookup_optional_span(nodes, texts, child, "repository_url", &repository_s, &repository_e, &has_repository)
                accepted <- false if not EcosystemLookup::rh_ecosystem_lookup_optional_span(nodes, texts, child, "homepage", &homepage_s, &homepage_e, &has_homepage)
                accepted <- false if not EcosystemLookup::rh_ecosystem_lookup_optional_span(nodes, texts, child, "manifest_url", &manifest_s, &manifest_e, &has_manifest)
                versions_idx: i64 = Json::rh_json_obj_get(nodes, texts, child, "versions_count")
                versions_ok: mutable i64 = 0
                versions_count: mutable i64 = 0
                has_versions: mutable bool = false
                if versions_idx >= 0 and nodes[versions_idx.usize()].kind == Json::RH_JSON_NULL:
                    has_versions <- false
                elif versions_idx >= 0:
                    versions_count <- Json::rh_json_int(nodes, raw, versions_idx, &versions_ok)
                    accepted <- false if versions_ok == 0 or versions_count < 0
                    has_versions <- true if versions_ok == 1

                if not accepted:
                    rejected <- rejected + 1
                else:
                    out.push(44) if emitted > 0
                    emitted <- emitted + 1
                    Base::rh_push_text(out, "{\"provider_id\":")
                    Base::rh_push_decimal_i64(out, provider_id)
                    Base::rh_push_text(out, ",\"name\":")
                    EcosystemLookup::rh_ecosystem_lookup_emit_span(out, texts, name_s, name_e)
                    Base::rh_push_text(out, ",\"ecosystem\":")
                    EcosystemLookup::rh_ecosystem_lookup_emit_span(out, texts, ecosystem_s, ecosystem_e)
                    Base::rh_push_text(out, ",\"version\":")
                    EcosystemLookup::rh_ecosystem_lookup_emit_optional(out, texts, version_s, version_e, has_version == 1)
                    Base::rh_push_text(out, ",\"published_at\":")
                    EcosystemLookup::rh_ecosystem_lookup_emit_optional(out, texts, published_s, published_e, has_published == 1)
                    Base::rh_push_text(out, ",\"repository\":")
                    EcosystemLookup::rh_ecosystem_lookup_emit_optional(out, texts, repository_s, repository_e, has_repository == 1)
                    Base::rh_push_text(out, ",\"homepage\":")
                    EcosystemLookup::rh_ecosystem_lookup_emit_optional(out, texts, homepage_s, homepage_e, has_homepage == 1)
                    Base::rh_push_text(out, ",\"manifest\":")
                    EcosystemLookup::rh_ecosystem_lookup_emit_optional(out, texts, manifest_s, manifest_e, has_manifest == 1)
                    Base::rh_push_text(out, ",\"versions_count\":")
                    Base::rh_push_decimal_i64(out, versions_count) if has_versions
                    Base::rh_push_text(out, "null") if not has_versions
                    Base::rh_push_text(out, ",\"mapping\":{\"status\":\"candidate\",\"basis\":\"provider_package_id\"},\"coverage\":{\"status\":\"observed\",\"fields\":[\"provider_id\",\"name\",\"ecosystem\"")
                    Base::rh_push_text(out, ",\"version\"") if has_version == 1
                    Base::rh_push_text(out, ",\"published_at\"") if has_published == 1
                    Base::rh_push_text(out, ",\"repository\"") if has_repository == 1
                    Base::rh_push_text(out, ",\"homepage\"") if has_homepage == 1
                    Base::rh_push_text(out, ",\"manifest\"") if has_manifest == 1
                    Base::rh_push_text(out, ",\"versions_count\"") if has_versions
                    Base::rh_push_text(out, "]}}")
                child <- nodes[child.usize()].next_sibling
            Base::rh_push_text(out, "],\"rejected\":")
            Base::rh_push_decimal_i64(out, rejected)
            Base::rh_push_text(out, ",\"note\":\"ecosyste.ms metadata remains enrichment evidence; attribute the source, link CC-BY-SA-4.0, indicate filtering, and independently review candidate identity and provenance\"}")
            0

    public:
        # Build only the documented lookup route on the reviewed provider host.
        # Values are percent-encoded before reaching the guarded transport; no
        # caller-supplied URL or additional query parameter is accepted.
        def rh_ecosystem_lookup_request_url(ecosystem: cstr, name: cstr, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if out.count != 0 or not EcosystemLookup::rh_ecosystem_lookup_valid_query(ecosystem, name)
            Base::rh_push_text(out, "https://packages.ecosyste.ms/api/v1/packages/lookup?ecosystem=")
            EcosystemLookup::rh_ecosystem_lookup_emit_url_value(out, ecosystem)
            Base::rh_push_text(out, "&name=")
            EcosystemLookup::rh_ecosystem_lookup_emit_url_value(out, name)
            out.push(0)
            true

        def rh_ecosystem_lookup_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            EcosystemLookup::rh_ecosystem_lookup_report_with_origin(raw, out, "captured", "", "")

        # The live endpoint returns a package array directly. Wrap it in the
        # established parser envelope, then publish only fields selected by
        # rh_ecosystem_lookup_report_with_origin.
        def rh_ecosystem_lookup_live_report(raw: darray[u8]&, ecosystem: cstr, name: cstr, source_url: cstr, status: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if raw.count.i64() > RH_ECOSYSTEM_LOOKUP_MAX_BYTES
            return -1 if not EcosystemLookup::rh_ecosystem_lookup_valid_query(ecosystem, name)
            envelope: mutable darray[u8] = []
            Base::rh_push_text(envelope, "{\"schema\":\"rh-ecosystem-lookup-input/1\",\"provider\":\"ecosyste.ms\",\"query\":{\"ecosystem\":\"")
            ecosystem_bytes: mutable darray[u8] = []
            Base::rh_push_cstr(ecosystem_bytes, ecosystem)
            Base::rh_json_escape(envelope, ecosystem_bytes, 0, ecosystem_bytes.count)
            Base::rh_push_text(envelope, "\",\"name\":\"")
            name_bytes: mutable darray[u8] = []
            Base::rh_push_cstr(name_bytes, name)
            Base::rh_json_escape(envelope, name_bytes, 0, name_bytes.count)
            Base::rh_push_text(envelope, "\"},\"results\":")
            Base::rh_absorb_bytes(raw, envelope)
            envelope.push(125)
            EcosystemLookup::rh_ecosystem_lookup_report_with_origin(envelope, out, "live", source_url, status)
