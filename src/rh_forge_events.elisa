# rh_forge_events.elisa — bounded forge workflow-event import (M02-05).
#
# Provider payloads are accepted only through the captured
# rh-forge-events-input/1 envelope. GitHub/Gitea/Forgejo, GitLab, and the
# bounded Bitbucket capture shape keep provider identity at this edge. Native
# field names stay at this adapter edge; the emitted event records use one
# small canonical shape, preserve provider status, and count malformed records
# instead of dropping them silently. Missing capability arrays are unsupported,
# while an explicitly empty array is an observed empty result.

include "./rh_base.elisa"
include "./rh_forge.elisa"
include "./rh_json.elisa"

module ForgeEvents:
    private:
        const RH_FORGE_EVENTS_MAX_BYTES: usize = 4194304
        const RH_FORGE_EVENTS_MAX_RECORDS: i64 = 10000

        struct RhForgeSpan:
            valid: bool
            present: bool
            start: i64
            end: i64

        struct RhForgeEvent:
            kind: u8
            native_id: i64
            status: RhForgeSpan
            created_at: i64
            has_created_at: bool
            updated_at: i64
            has_updated_at: bool
            closed_at: i64
            has_closed_at: bool
            url: RhForgeSpan
            tag: RhForgeSpan
            pull_request: i64
            has_pull_request: bool
            staged_page_number: i64
            staged_record_ordinal: i64
            staged_evidence_start: i64
            staged_evidence_end: i64
            has_staged_origin: bool
            has_staged_evidence: bool

        struct RhForgeCapabilityCounts:
            attempted: mutable i64
            normalized: mutable i64
            duplicate_replacements: mutable i64
            rejected: mutable i64
            present: mutable bool
            not_attempted: mutable bool

        struct RhForgeReviewCursor:
            pull_number: i64
            next_review_page: i64

        struct RhForgePullBatch:
            pull_number: i64
            merged_at: i64
            has_merged_at: bool

        struct RhForgeValue:
            valid: bool
            present: bool
            value: i64

        struct RhForgeReviewRequestCursor:
            pull_number: i64
            next_review_page: i64

        def rh_fe_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> RhForgeSpan can[Memory.Allocate, Abort.Panic]:
            invalid: RhForgeSpan = RhForgeSpan{valid: false, present: false, start: -1, end: -1}
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return invalid if idx < 0
            start, end, present =
                start: mutable i64 = -1
                end: mutable i64 = -1
                present: bool = Json::rh_json_str_span(nodes, idx, &start, &end)
                start, end, present
            return invalid if not present or end <= start
            RhForgeSpan{valid: true, present: true, start: start, end: end}

        def rh_fe_optional_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> RhForgeSpan can[Memory.Allocate, Abort.Panic]:
            invalid: RhForgeSpan = RhForgeSpan{valid: false, present: false, start: -1, end: -1}
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return RhForgeSpan{valid: true, present: false, start: -1, end: -1} if idx < 0 or nodes[idx.usize()].kind == Json::RH_JSON_NULL
            start, end, present =
                start: mutable i64 = -1
                end: mutable i64 = -1
                present: bool = Json::rh_json_str_span(nodes, idx, &start, &end)
                start, end, present
            return invalid if not present or end <= start
            RhForgeSpan{valid: true, present: true, start: start, end: end}

        def rh_fe_optional_cursor(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> RhForgeSpan can[Memory.Allocate, Abort.Panic]:
            invalid: RhForgeSpan = RhForgeSpan{valid: false, present: false, start: -1, end: -1}
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return RhForgeSpan{valid: true, present: false, start: -1, end: -1} if idx < 0 or nodes[idx.usize()].kind == Json::RH_JSON_NULL
            start, end, present =
                start: mutable i64 = -1
                end: mutable i64 = -1
                present: bool = Json::rh_json_str_span(nodes, idx, &start, &end)
                start, end, present
            return invalid if not present
            RhForgeSpan{valid: true, present: true, start: start, end: end}

        def rh_fe_optional_url(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, githubish: bool, bitbucket: bool) -> RhForgeSpan can[Memory.Allocate, Abort.Panic]:
            return ForgeEvents::rh_fe_bitbucket_url(nodes, texts, obj) if bitbucket
            key: u8& = "html_url" if githubish else "web_url"
            ForgeEvents::rh_fe_optional_str(nodes, texts, obj, key)

        def rh_fe_bitbucket_url(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64) -> RhForgeSpan can[Memory.Allocate, Abort.Panic]:
            invalid: RhForgeSpan = RhForgeSpan{valid: false, present: false, start: -1, end: -1}
            absent: RhForgeSpan = RhForgeSpan{valid: true, present: false, start: -1, end: -1}
            links: i64 = Json::rh_json_obj_get(nodes, texts, obj, "links")
            return absent if links < 0 or nodes[links.usize()].kind == Json::RH_JSON_NULL
            return invalid if nodes[links.usize()].kind != Json::RH_JSON_OBJ
            html: i64 = Json::rh_json_obj_get(nodes, texts, links, "html")
            return absent if html < 0 or nodes[html.usize()].kind == Json::RH_JSON_NULL
            return invalid if nodes[html.usize()].kind != Json::RH_JSON_OBJ
            href: i64 = Json::rh_json_obj_get(nodes, texts, html, "href")
            return absent if href < 0 or nodes[href.usize()].kind == Json::RH_JSON_NULL
            start, end, present =
                start: mutable i64 = -1
                end: mutable i64 = -1
                present: bool = Json::rh_json_str_span(nodes, href, &start, &end)
                start, end, present
            return invalid if not present or end <= start
            RhForgeSpan{valid: true, present: true, start: start, end: end}

        def rh_fe_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&) -> RhForgeValue can[Memory.Allocate, Abort.Panic]:
            invalid: RhForgeValue = RhForgeValue{valid: false, present: false, value: 0}
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return RhForgeValue{valid: true, present: false, value: 0} if idx < 0 or nodes[idx.usize()].kind == Json::RH_JSON_NULL
            ok: mutable i64 = 0
            value: i64 = Json::rh_json_int(nodes, raw, idx, &ok)
            RhForgeValue{valid: ok == 1, present: ok == 1, value: value} if ok == 1 else invalid

        def rh_fe_uuid(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if end - start != 36
            while index < 36 |index: i64 = 0, texts, start|:
                byte: u8 = texts[(start + index).usize()]
                if index == 8 or index == 13 or index == 18 or index == 23:
                    return false if byte != 45
                else:
                    hex: bool = (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 70) or (byte >= 97 and byte <= 102)
                    return false if not hex
                index <- index + 1
            true

        def rh_fe_sha256(texts: darray[u8]&, start: i64, end: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if end - start != 64
            while index < 64 |index: i64 = 0, texts, start|:
                byte: u8 = texts[(start + index).usize()]
                return false if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102))
                index <- index + 1
            true

        def rh_fe_time(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&) -> RhForgeValue can[Memory.Allocate, Abort.Panic]:
            invalid: RhForgeValue = RhForgeValue{valid: false, present: false, value: 0}
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return RhForgeValue{valid: true, present: false, value: 0} if idx < 0 or nodes[idx.usize()].kind == Json::RH_JSON_NULL
            node: Json::RhJsonNode = nodes[idx.usize()]
            if node.kind == Json::RH_JSON_NUM:
                ok: mutable i64 = 0
                value: i64 = Json::rh_json_int(nodes, raw, idx, &ok)
                RhForgeValue{valid: ok == 1, present: ok == 1, value: value}
            elif node.kind == Json::RH_JSON_STR:
                start, end, has_span =
                    start: mutable i64 = 0
                    end: mutable i64 = 0
                    present: bool = Json::rh_json_str_span(nodes, idx, &start, &end)
                    start, end, present
                return invalid if not has_span
                ok: mutable i64 = 0
                value: i64 = Forge::rh_parse_iso8601(texts, start.usize(), end.usize(), &ok)
                RhForgeValue{valid: ok == 1, present: ok == 1, value: value}
            else:
                invalid

        def rh_fe_auth(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return 1 if Base::rh_bytes_equal_literal(texts, s, e, "authorized")
            return 2 if Base::rh_bytes_equal_literal(texts, s, e, "unauthorized")
            return 3 if Base::rh_bytes_equal_literal(texts, s, e, "not_requested")
            return 4 if Base::rh_bytes_equal_literal(texts, s, e, "unknown")
            -1

        def rh_fe_auth_label(state: i64) -> u8&:
            return "authorized" if state == 1
            return "unauthorized" if state == 2
            return "not_requested" if state == 3
            "unknown"

        def rh_fe_cap_label(kind: u8) -> u8&:
            return "issues" if kind == 0
            return "proposals" if kind == 1
            return "reviews" if kind == 2
            "releases"

        def rh_fe_kind_id_key(kind: u8, githubish: bool, bitbucket: bool) -> u8&:
            return "number" if (kind == 0 or kind == 1) and githubish
            return "id" if bitbucket
            return "iid" if kind == 0 or kind == 1
            "id"

        def rh_fe_kind_time_key(kind: u8) -> u8&:
            return "submitted_at" if kind == 2
            return "published_at" if kind == 3
            "created_at"

        def rh_fe_kind_status_key(kind: u8) -> u8&:
            return "state" if kind < 3
            "status"

        def rh_fe_hash_word(start_hash: u64, value: u64) -> u64:
            key: mutable u64 = value
            while byte_index < 8 |hash: mutable u64 = start_hash, byte_index: usize = 0, key| -> hash:
                hash <- (hash ^ key.u8().u64()) * 0x100000001b3
                key <- key >> 8
                byte_index <- byte_index + 1

        def rh_fe_event_hash(kind: u8, native_id: i64, pull_request: i64) -> usize:
            kind_hash: u64 = (0xcbf29ce484222325 ^ kind.u64()) * 0x100000001b3
            id_hash: u64 = ForgeEvents::rh_fe_hash_word(kind_hash, native_id.u64())
            ForgeEvents::rh_fe_hash_word(id_hash, pull_request.u64()).usize()

        def rh_fe_event_index(events: darray[RhForgeEvent]&, slots: darray[i64]&, kind: u8, native_id: i64, pull_request: i64) -> i64:
            return -1 if slots.count == 0
            slot: mutable usize = ForgeEvents::rh_fe_event_hash(kind, native_id, pull_request) % slots.count
            while probe < slots.count |probe: usize = 0, slot, events, slots, kind, native_id, pull_request|:
                index: i64 = slots[slot]
                return -1 if index == 0
                event: RhForgeEvent = events[(index - 1).usize()]
                return index - 1 if event.kind == kind and event.native_id == native_id and event.pull_request == pull_request
                slot <- (slot + 1) % slots.count
                probe <- probe + 1
            -1

        def rh_fe_event_index_grow(events: darray[RhForgeEvent]&, slots: mutable darray[i64]&, required: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if slots.count > 0 and required * 2 <= slots.count
            capacity: mutable usize = 16 if slots.count == 0 else slots.count * 2
            capacity <- required * 2 + 1 if capacity < required * 2 + 1
            grown_slots: mutable darray[i64] = []
            while i < capacity |i: usize = 0, capacity, grown_slots|:
                grown_slots.push(0)
                i <- i + 1
            while event_index < events.count |event_index: usize = 0, events, grown_slots|:
                event: RhForgeEvent = events[event_index]
                slot: mutable usize = ForgeEvents::rh_fe_event_hash(event.kind, event.native_id, event.pull_request) % grown_slots.count
                while grown_slots[slot] != 0 |slot, grown_slots|:
                    slot <- (slot + 1) % grown_slots.count
                grown_slots[slot] <- event_index.i64() + 1
                event_index <- event_index + 1
            slots <- grown_slots
            true

        def rh_fe_event_index_insert(events: darray[RhForgeEvent]&, slots: mutable darray[i64]&, event_index: usize) -> bool:
            return false if slots.count == 0 or event_index >= events.count
            event: RhForgeEvent = events[event_index]
            slot: mutable usize = ForgeEvents::rh_fe_event_hash(event.kind, event.native_id, event.pull_request) % slots.count
            while probe < slots.count |probe: usize = 0, slot, slots, event_index|:
                if slots[slot] == 0:
                    slots[slot] <- event_index.i64() + 1
                    return true
                slot <- (slot + 1) % slots.count
                probe <- probe + 1
            false

        def rh_fe_add_array(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, root: i64, key: u8&, kind: u8, githubish: bool, bitbucket: bool, pull_request: i64, events: mutable darray[RhForgeEvent]&, event_slots: mutable darray[i64]&, counts: mutable RhForgeCapabilityCounts&, total_attempts: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            arr: i64 = Json::rh_json_obj_get(nodes, texts, root, key)
            return 0 if arr < 0
            return -1 if nodes[arr.usize()].kind != Json::RH_JSON_ARR
            counts.present <- true
            array: Json::RhJsonNode = nodes[arr.usize()]
            origins: i64 = Json::rh_json_obj_get(nodes, texts, root, "staged_origins")
            return -1 if origins >= 0 and nodes[origins.usize()].kind != Json::RH_JSON_OBJ
            origin_rows: i64 = Json::rh_json_obj_get(nodes, texts, origins, key)
            return -1 if origin_rows >= 0 and nodes[origin_rows.usize()].kind != Json::RH_JSON_ARR
            return -1 if origin_rows >= 0 and nodes[origin_rows.usize()].child_count != array.child_count
            while child >= 0 |child: i64 = array.first_child, origin_node: mutable i64 = nodes[origin_rows.usize()].first_child if origin_rows >= 0 else -1, nodes, raw, texts, events, counts, total_attempts, kind, githubish, bitbucket|:
                current_origin: i64 = origin_node
                origin_node <- nodes[origin_node.usize()].next_sibling if origin_node >= 0
                staged_page_number: mutable i64 = 0
                staged_record_ordinal: mutable i64 = 0
                staged_evidence_start: mutable i64 = 0
                staged_evidence_end: mutable i64 = 0
                has_staged_origin: mutable bool = false
                has_staged_evidence: mutable bool = false
                if current_origin >= 0:
                    return -1 if nodes[current_origin.usize()].kind != Json::RH_JSON_OBJ
                    page_number: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, current_origin, "page_number")
                    return -1 if not page_number.valid or not page_number.present or page_number.value < 0
                    staged_page_number <- page_number.value
                    record_ordinal: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, current_origin, "record_ordinal")
                    return -1 if not record_ordinal.valid or not record_ordinal.present or record_ordinal.value < 0
                    staged_record_ordinal <- record_ordinal.value
                    has_staged_origin <- true
                    evidence: i64 = Json::rh_json_obj_get(nodes, texts, current_origin, "evidence_id")
                    if evidence >= 0 and nodes[evidence.usize()].kind != Json::RH_JSON_NULL:
                        return -1 if not Json::rh_json_str_span(nodes, evidence, &staged_evidence_start, &staged_evidence_end) or not ForgeEvents::rh_fe_uuid(texts, staged_evidence_start, staged_evidence_end)
                        has_staged_evidence <- true
                # GitHub's issues route also returns pull requests. The pulls
                # capability owns those rows, so exclude them before counting.
                if kind == 0 and githubish and Json::rh_json_obj_get(nodes, texts, child, "pull_request") >= 0:
                    child <- nodes[child.usize()].next_sibling
                    continue
                if kind == 3 and githubish:
                    draft: i64 = Json::rh_json_obj_get(nodes, texts, child, "draft")
                    if draft >= 0:
                        if nodes[draft.usize()].kind != Json::RH_JSON_BOOL:
                            counts.rejected <- counts.rejected + 1
                            child <- nodes[child.usize()].next_sibling
                            continue
                        if Json::rh_json_is_true(nodes, raw, draft):
                            child <- nodes[child.usize()].next_sibling
                            continue
                return -1 if total_attempts[0] >= RH_FORGE_EVENTS_MAX_RECORDS
                counts.attempted <- counts.attempted + 1
                total_attempts[0] <- total_attempts[0] + 1
                if nodes[child.usize()].kind != Json::RH_JSON_OBJ:
                    counts.rejected <- counts.rejected + 1
                    child <- nodes[child.usize()].next_sibling
                    continue
                id_key: u8& = ForgeEvents::rh_fe_kind_id_key(kind, githubish, bitbucket)
                primary_id: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, child, id_key)
                native_id_value: RhForgeValue =
                    if primary_id.valid and primary_id.present and primary_id.value >= 0:
                        primary_id
                    elif not githubish and not bitbucket and (kind == 0 or kind == 1):
                        # GitLab payloads may expose both iid and id; iid is the
                        # project-local workflow identity, with id as fallback.
                        ForgeEvents::rh_fe_int(nodes, raw, texts, child, "id")
                    else:
                        RhForgeValue{valid: false, present: false, value: 0}
                if not native_id_value.valid or not native_id_value.present or native_id_value.value < 0:
                    counts.rejected <- counts.rejected + 1
                    child <- nodes[child.usize()].next_sibling
                    continue
                native_id: i64 = native_id_value.value
                event_time_key: u8& = "released_at" if kind == 3 and not githubish and not bitbucket else ForgeEvents::rh_fe_kind_time_key(kind)
                primary_time: RhForgeValue = ForgeEvents::rh_fe_time(nodes, raw, texts, child, event_time_key)
                created: RhForgeValue =
                    if primary_time.valid and primary_time.present and primary_time.value >= 0:
                        primary_time
                    elif kind == 3:
                        ForgeEvents::rh_fe_time(nodes, raw, texts, child, "created_at")
                    else:
                        RhForgeValue{valid: false, present: false, value: 0}
                if not created.valid or not created.present or created.value < 0:
                    counts.rejected <- counts.rejected + 1
                    child <- nodes[child.usize()].next_sibling
                    continue
                status_key: u8& = ForgeEvents::rh_fe_kind_status_key(kind)
                status: RhForgeSpan = ForgeEvents::rh_fe_str(nodes, texts, child, status_key)
                if not status.valid and kind != 3:
                    counts.rejected <- counts.rejected + 1
                    child <- nodes[child.usize()].next_sibling
                    continue
                updated: RhForgeValue = ForgeEvents::rh_fe_time(nodes, raw, texts, child, "updated_at")
                if not updated.valid:
                    counts.rejected <- counts.rejected + 1
                    child <- nodes[child.usize()].next_sibling
                    continue
                if updated.present and updated.value < 0:
                    counts.rejected <- counts.rejected + 1
                    child <- nodes[child.usize()].next_sibling
                    continue
                closed: RhForgeValue =
                    ForgeEvents::rh_fe_time(nodes, raw, texts, child, "closed_at") if kind == 0 or kind == 1 else RhForgeValue{valid: true, present: false, value: 0}
                if not closed.valid or (closed.present and closed.value < 0):
                    counts.rejected <- counts.rejected + 1
                    child <- nodes[child.usize()].next_sibling
                    continue
                url: RhForgeSpan = ForgeEvents::rh_fe_optional_url(nodes, texts, child, githubish, bitbucket)
                if not url.valid:
                    counts.rejected <- counts.rejected + 1
                    child <- nodes[child.usize()].next_sibling
                    continue
                tag: RhForgeSpan =
                    if kind == 3:
                        tag_name: RhForgeSpan = ForgeEvents::rh_fe_optional_str(nodes, texts, child, "tag_name")
                        tag_name if not tag_name.valid or tag_name.present else ForgeEvents::rh_fe_optional_str(nodes, texts, child, "tag")
                    else:
                        RhForgeSpan{valid: true, present: false, start: -1, end: -1}
                if not tag.valid:
                    counts.rejected <- counts.rejected + 1
                    child <- nodes[child.usize()].next_sibling
                    continue
                normalized: RhForgeEvent = RhForgeEvent{kind: kind, native_id: native_id, status: status, created_at: created.value, has_created_at: true, updated_at: updated.value, has_updated_at: updated.present, closed_at: closed.value, has_closed_at: closed.present, url: url, tag: tag, pull_request: pull_request, has_pull_request: pull_request > 0, staged_page_number: staged_page_number, staged_record_ordinal: staged_record_ordinal, staged_evidence_start: staged_evidence_start, staged_evidence_end: staged_evidence_end, has_staged_origin: has_staged_origin, has_staged_evidence: has_staged_evidence}
                counts.normalized <- counts.normalized + 1
                existing: i64 = ForgeEvents::rh_fe_event_index(events, event_slots, kind, native_id, pull_request)
                if existing >= 0:
                    events[existing.usize()] <- normalized
                    counts.duplicate_replacements <- counts.duplicate_replacements + 1
                else:
                    return -1 if not ForgeEvents::rh_fe_event_index_grow(events, event_slots, events.count + 1)
                    events.push(normalized)
                    return -1 if not ForgeEvents::rh_fe_event_index_insert(events, event_slots, events.count - 1)
                child <- nodes[child.usize()].next_sibling
            0

        def rh_fe_emit_cap(out: mutable darray[u8]&, kind: u8, counts: RhForgeCapabilityCounts, events: darray[RhForgeEvent]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "\"")
            Base::rh_push_text(out, ForgeEvents::rh_fe_cap_label(kind))
            Base::rh_push_text(out, "\":{\"status\":\"")
            Base::rh_push_text(out, "not_attempted" if counts.not_attempted else ("observed" if counts.present else "unsupported"))
            Base::rh_push_text(out, "\",\"attempted\":")
            if counts.present:
                Base::rh_push_decimal_i64(out, counts.attempted)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, ",\"normalized\":")
            if counts.present:
                Base::rh_push_decimal_i64(out, counts.normalized)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, ",\"duplicate_replacements\":")
            if counts.present:
                Base::rh_push_decimal_i64(out, counts.duplicate_replacements)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, ",\"count\":")
            if counts.present:
                count: mutable i64 = 0
                for i in 0..<events.count |events, kind, count|:
                    count <- count + 1 if events[i].kind == kind
                Base::rh_push_decimal_i64(out, count)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, ",\"rejected\":")
            Base::rh_push_decimal_i64(out, counts.rejected)
            Base::rh_push_text(out, "}")

        def rh_fe_not_attempted(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, root: i64, key: u8&, counts: mutable RhForgeCapabilityCounts&) -> i64 can[Memory.Allocate, Abort.Panic]:
            states: i64 = Json::rh_json_obj_get(nodes, texts, root, "capability_states")
            return 0 if states < 0
            return -1 if nodes[states.usize()].kind != Json::RH_JSON_OBJ
            state: i64 = Json::rh_json_obj_get(nodes, texts, states, key)
            return 0 if state < 0
            return -1 if counts.present or nodes[state.usize()].kind != Json::RH_JSON_STR
            state_start: mutable i64 = 0
            state_end: mutable i64 = 0
            return -1 if not Json::rh_json_str_span(nodes, state, &state_start, &state_end) or not Base::rh_bytes_equal_literal(texts, state_start, state_end, "not_attempted")
            counts.not_attempted <- true
            0

        def rh_fe_emit_event(out: mutable darray[u8]&, event: RhForgeEvent, texts: darray[u8]&, provider: RhForgeSpan) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"kind\":\"")
            Base::rh_push_text(out, ForgeEvents::rh_fe_cap_label(event.kind))
            Base::rh_push_text(out, "\",\"native_id\":\"")
            Base::rh_json_escape(out, texts, provider.start.usize(), provider.end.usize())
            out.push(58)
            Base::rh_push_decimal_i64(out, event.native_id)
            Base::rh_push_text(out, "\",\"status\":")
            if event.status.present:
                out.push(34)
                Base::rh_json_escape(out, texts, event.status.start.usize(), event.status.end.usize())
                out.push(34)
            else:
                Base::rh_push_text(out, "\"published\"")
            Base::rh_push_text(out, ",\"created_at\":")
            Base::rh_push_decimal_i64(out, event.created_at)
            Base::rh_push_text(out, ",\"updated_at\":")
            Base::rh_push_decimal_i64(out, event.updated_at) if event.has_updated_at
            Base::rh_push_text(out, "null") if not event.has_updated_at
            Base::rh_push_text(out, ",\"closed_at\":")
            Base::rh_push_decimal_i64(out, event.closed_at) if event.has_closed_at
            Base::rh_push_text(out, "null") if not event.has_closed_at
            if event.tag.present:
                Base::rh_push_text(out, ",\"tag\":\"")
                Base::rh_json_escape(out, texts, event.tag.start.usize(), event.tag.end.usize())
                out.push(34)
            if event.url.present:
                Base::rh_push_text(out, ",\"url\":\"")
                Base::rh_json_escape(out, texts, event.url.start.usize(), event.url.end.usize())
                out.push(34)
            if event.has_pull_request:
                Base::rh_push_text(out, ",\"pull_request\":")
                Base::rh_push_decimal_i64(out, event.pull_request)
            if event.has_staged_origin:
                Base::rh_push_text(out, ",\"staged_origin\":{\"page_number\":")
                Base::rh_push_decimal_i64(out, event.staged_page_number)
                Base::rh_push_text(out, ",\"record_ordinal\":")
                Base::rh_push_decimal_i64(out, event.staged_record_ordinal)
                if event.has_staged_evidence:
                    Base::rh_push_text(out, ",\"evidence_id\":\"")
                    Base::rh_json_escape(out, texts, event.staged_evidence_start.usize(), event.staged_evidence_end.usize())
                    out.push(34)
                out.push(125)
            Base::rh_push_text(out, "}")

        def rh_fe_emit_page(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, raw: darray[u8]&, pagination: i64, key: u8&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            page: i64 = Json::rh_json_obj_get(nodes, texts, pagination, key)
            return -1 if page < 0 or nodes[page.usize()].kind != Json::RH_JSON_OBJ
            next: RhForgeSpan = ForgeEvents::rh_fe_optional_cursor(nodes, texts, page, "next")
            return -1 if not next.valid
            complete: i64 = Json::rh_json_obj_get(nodes, texts, page, "complete")
            return -1 if complete < 0 or nodes[complete.usize()].kind != Json::RH_JSON_BOOL
            Base::rh_push_text(out, "\"")
            Base::rh_push_text(out, key)
            Base::rh_push_text(out, "\":{\"next\":")
            if next.present:
                out.push(34)
                Base::rh_json_escape(out, texts, next.start.usize(), next.end.usize())
                out.push(34)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, ",\"complete\":")
            Base::rh_push_text(out, "true") if Json::rh_json_is_true(nodes, raw, complete)
            Base::rh_push_text(out, "false") if not Json::rh_json_is_true(nodes, raw, complete)
            Base::rh_push_text(out, "}")
            0

    public:
        def rh_forge_events_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if raw.count > RH_FORGE_EVENTS_MAX_BYTES
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema: RhForgeSpan = ForgeEvents::rh_fe_str(nodes, texts, root, "schema")
            return -1 if not schema.valid or not Base::rh_bytes_equal_literal(texts, schema.start, schema.end, "rh-forge-events-input/1")
            provider: RhForgeSpan = ForgeEvents::rh_fe_str(nodes, texts, root, "provider")
            return -1 if not provider.valid
            github: bool = Base::rh_bytes_equal_literal(texts, provider.start, provider.end, "github")
            gitea: bool = Base::rh_bytes_equal_literal(texts, provider.start, provider.end, "gitea")
            forgejo: bool = Base::rh_bytes_equal_literal(texts, provider.start, provider.end, "forgejo")
            gitlab: bool = Base::rh_bytes_equal_literal(texts, provider.start, provider.end, "gitlab")
            bitbucket: bool = Base::rh_bytes_equal_literal(texts, provider.start, provider.end, "bitbucket")
            githubish: bool = github or gitea or forgejo
            return -1 if not githubish and not gitlab and not bitbucket
            captured: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, root, "captured_at")
            return -1 if not captured.valid or not captured.present or captured.value < 0
            captured_at: i64 = captured.value
            auth_state: mutable i64 = 4
            auth: i64 = Json::rh_json_obj_get(nodes, texts, root, "authorization")
            if auth >= 0:
                return -1 if nodes[auth.usize()].kind != Json::RH_JSON_OBJ
                auth_state_span: RhForgeSpan = ForgeEvents::rh_fe_str(nodes, texts, auth, "state")
                return -1 if not auth_state_span.valid
                auth_state <- ForgeEvents::rh_fe_auth(texts, auth_state_span.start, auth_state_span.end)
                return -1 if auth_state < 0
            scope_pull: mutable i64 = 0
            scope_present: mutable bool = false
            scope_repository_s: mutable i64 = 0
            scope_repository_e: mutable i64 = 0
            scope_repository_present: mutable bool = false
            scope_project_s: mutable i64 = 0
            scope_project_e: mutable i64 = 0
            scope_project_present: mutable bool = false
            scope_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "scope")
            if scope_idx >= 0:
                return -1 if nodes[scope_idx.usize()].kind != Json::RH_JSON_OBJ
                if github:
                    scope_repository_idx: i64 = Json::rh_json_obj_get(nodes, texts, scope_idx, "repository")
                    if scope_repository_idx >= 0:
                        return -1 if not Json::rh_json_str_span(nodes, scope_repository_idx, &scope_repository_s, &scope_repository_e) or scope_repository_s == scope_repository_e
                        scope_repository_present <- true
                    scope_pull_idx: i64 = Json::rh_json_obj_get(nodes, texts, scope_idx, "pull_request")
                    if scope_pull_idx >= 0:
                        scope_ok: mutable i64 = 0
                        scope_pull <- Json::rh_json_int(nodes, raw, scope_pull_idx, &scope_ok)
                        return -1 if scope_ok == 0 or scope_pull < 1
                        scope_present <- true
                    return -1 if not scope_repository_present and not scope_present
                elif gitlab:
                    scope_project_idx: i64 = Json::rh_json_obj_get(nodes, texts, scope_idx, "project_path")
                    return -1 if scope_project_idx < 0 or not Json::rh_json_str_span(nodes, scope_project_idx, &scope_project_s, &scope_project_e) or scope_project_s == scope_project_e
                    scope_project_present <- true
                else:
                    return -1
            events: mutable darray[RhForgeEvent] = []
            event_slots: mutable darray[i64] = []
            issues_counts: mutable RhForgeCapabilityCounts = RhForgeCapabilityCounts{attempted: 0, normalized: 0, duplicate_replacements: 0, rejected: 0, present: false, not_attempted: false}
            proposals_counts: mutable RhForgeCapabilityCounts = RhForgeCapabilityCounts{attempted: 0, normalized: 0, duplicate_replacements: 0, rejected: 0, present: false, not_attempted: false}
            reviews_counts: mutable RhForgeCapabilityCounts = RhForgeCapabilityCounts{attempted: 0, normalized: 0, duplicate_replacements: 0, rejected: 0, present: false, not_attempted: false}
            releases_counts: mutable RhForgeCapabilityCounts = RhForgeCapabilityCounts{attempted: 0, normalized: 0, duplicate_replacements: 0, rejected: 0, present: false, not_attempted: false}
            total_attempts: mutable i64 = 0
            pagination: i64 = Json::rh_json_obj_get(nodes, texts, root, "pagination")
            pagination_present: bool = pagination >= 0
            if pagination_present:
                return -1 if nodes[pagination.usize()].kind != Json::RH_JSON_OBJ
            reviews_by_pull_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "reviews_by_pull")
            review_collection_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "review_collection")
            review_collection_present: bool = review_collection_idx >= 0
            review_cursors: mutable darray[RhForgeReviewCursor] = []
            pull_batch: mutable darray[RhForgePullBatch] = []
            requested_review_cursors: mutable darray[RhForgeReviewRequestCursor] = []
            requested_pull_page: mutable i64 = 0
            requested_pull_page_present: mutable bool = false
            resumed_digest_s: mutable i64 = -1
            resumed_digest_e: mutable i64 = -1
            resumed_digest_present: mutable bool = false
            next_pull_page: mutable i64 = 0
            next_pull_page_present: mutable bool = false
            pulls_complete: mutable bool = false
            if review_collection_present:
                return -1 if not github or not scope_repository_present or reviews_by_pull_idx < 0 or nodes[review_collection_idx.usize()].kind != Json::RH_JSON_OBJ
                pending_idx: i64 = Json::rh_json_obj_get(nodes, texts, review_collection_idx, "pending_pull_requests")
                return -1 if pending_idx < 0 or nodes[pending_idx.usize()].kind != Json::RH_JSON_ARR
                while pending_node >= 0 |pending_node: i64 = nodes[pending_idx.usize()].first_child, nodes, raw, review_cursors|:
                    return -1 if review_cursors.count >= 10 or nodes[pending_node.usize()].kind != Json::RH_JSON_OBJ
                    pull: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, pending_node, "number")
                    return -1 if not pull.valid or not pull.present or pull.value < 1
                    pull_number: i64 = pull.value
                    page: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, pending_node, "next_review_page")
                    return -1 if not page.valid or not page.present or page.value < 1 or page.value > 2147483640
                    next_review_page: i64 = page.value
                    while prior_cursor_idx < review_cursors.count.i64() |prior_cursor_idx: i64 = 0, review_cursors, pull_number|:
                        return -1 if review_cursors[prior_cursor_idx.usize()].pull_number == pull_number
                        prior_cursor_idx <- prior_cursor_idx + 1
                    review_cursors.push(RhForgeReviewCursor{pull_number: pull_number, next_review_page: next_review_page})
                    pending_node <- nodes[pending_node.usize()].next_sibling
                pull_batch_idx: i64 = Json::rh_json_obj_get(nodes, texts, review_collection_idx, "batch_pull_requests")
                if pull_batch_idx >= 0:
                    return -1 if nodes[pull_batch_idx.usize()].kind != Json::RH_JSON_ARR or nodes[pull_batch_idx.usize()].child_count > 10
                    while pull_node >= 0 |pull_node: i64 = nodes[pull_batch_idx.usize()].first_child, nodes, raw, texts, pull_batch|:
                        return -1 if nodes[pull_node.usize()].kind != Json::RH_JSON_OBJ
                        pull: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, pull_node, "number")
                        return -1 if not pull.valid or not pull.present or pull.value < 1
                        pull_number: i64 = pull.value
                        while prior_pull_idx < pull_batch.count.i64() |prior_pull_idx: i64 = 0, pull_batch, pull_number|:
                            return -1 if pull_batch[prior_pull_idx.usize()].pull_number == pull_number
                            prior_pull_idx <- prior_pull_idx + 1
                        merged_idx: i64 = Json::rh_json_obj_get(nodes, texts, pull_node, "merged_at")
                        return -1 if merged_idx < 0
                        merged_at: RhForgeValue =
                            ForgeEvents::rh_fe_int(nodes, raw, texts, pull_node, "merged_at") if nodes[merged_idx.usize()].kind != Json::RH_JSON_NULL else RhForgeValue{valid: true, present: false, value: 0}
                        return -1 if not merged_at.valid or (merged_at.present and merged_at.value < 0)
                        pull_batch.push(RhForgePullBatch{pull_number: pull_number, merged_at: merged_at.value, has_merged_at: merged_at.present})
                        pull_node <- nodes[pull_node.usize()].next_sibling
                batch_request_idx: i64 = Json::rh_json_obj_get(nodes, texts, review_collection_idx, "batch_request")
                if batch_request_idx >= 0:
                    return -1 if nodes[batch_request_idx.usize()].kind != Json::RH_JSON_OBJ
                    resumed_digest_idx: i64 = Json::rh_json_obj_get(nodes, texts, batch_request_idx, "resumed_from_sha256")
                    return -1 if resumed_digest_idx < 0
                    if nodes[resumed_digest_idx.usize()].kind != Json::RH_JSON_NULL:
                        return -1 if not Json::rh_json_str_span(nodes, resumed_digest_idx, &resumed_digest_s, &resumed_digest_e) or not ForgeEvents::rh_fe_sha256(texts, resumed_digest_s, resumed_digest_e)
                        resumed_digest_present <- true
                    requested_page_idx: i64 = Json::rh_json_obj_get(nodes, texts, batch_request_idx, "pull_page")
                    return -1 if requested_page_idx < 0
                    if nodes[requested_page_idx.usize()].kind != Json::RH_JSON_NULL:
                        page: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, batch_request_idx, "pull_page")
                        return -1 if not page.valid or not page.present or page.value < 1 or page.value > 2147483640
                        requested_pull_page <- page.value
                        requested_pull_page_present <- true
                    requested_reviews_idx: i64 = Json::rh_json_obj_get(nodes, texts, batch_request_idx, "review_pages")
                    return -1 if requested_reviews_idx < 0 or nodes[requested_reviews_idx.usize()].kind != Json::RH_JSON_ARR or nodes[requested_reviews_idx.usize()].child_count > 10
                    while request_node >= 0 |request_node: i64 = nodes[requested_reviews_idx.usize()].first_child, nodes, raw, texts, requested_review_cursors|:
                        return -1 if nodes[request_node.usize()].kind != Json::RH_JSON_OBJ
                        pull: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, request_node, "number")
                        return -1 if not pull.valid or not pull.present or pull.value < 1
                        pull_number: i64 = pull.value
                        page: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, request_node, "next_review_page")
                        return -1 if not page.valid or not page.present or page.value < 1 or page.value > 2147483640
                        next_review_page: i64 = page.value
                        while prior_request_idx < requested_review_cursors.count.i64() |prior_request_idx: i64 = 0, requested_review_cursors, pull_number|:
                            return -1 if requested_review_cursors[prior_request_idx.usize()].pull_number == pull_number
                            prior_request_idx <- prior_request_idx + 1
                        requested_review_cursors.push(RhForgeReviewRequestCursor{pull_number: pull_number, next_review_page: next_review_page})
                        request_node <- nodes[request_node.usize()].next_sibling
                    if resumed_digest_present:
                        return -1 if requested_pull_page_present == (requested_review_cursors.count > 0)
                    else:
                        return -1 if not requested_pull_page_present or requested_pull_page != 1 or requested_review_cursors.count > 0
                next_pull_idx: i64 = Json::rh_json_obj_get(nodes, texts, review_collection_idx, "next_pull_page")
                return -1 if next_pull_idx < 0
                if nodes[next_pull_idx.usize()].kind != Json::RH_JSON_NULL:
                    page: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, review_collection_idx, "next_pull_page")
                    return -1 if not page.valid or not page.present or page.value < 1 or page.value > 2147483640
                    next_pull_page <- page.value
                    next_pull_page_present <- true
                pulls_complete_idx: i64 = Json::rh_json_obj_get(nodes, texts, review_collection_idx, "pulls_complete")
                return -1 if pulls_complete_idx < 0 or nodes[pulls_complete_idx.usize()].kind != Json::RH_JSON_BOOL
                pulls_complete <- Json::rh_json_is_true(nodes, raw, pulls_complete_idx)
                if pulls_complete:
                    return -1 if nodes[next_pull_idx.usize()].kind != Json::RH_JSON_NULL
                else:
                    return -1 if nodes[next_pull_idx.usize()].kind == Json::RH_JSON_NULL
            return -1 if ForgeEvents::rh_fe_add_array(nodes, raw, texts, root, "issues", 0, githubish, bitbucket, 0, events, event_slots, &issues_counts, &total_attempts) != 0
            return -1 if ForgeEvents::rh_fe_add_array(nodes, raw, texts, root, "proposals", 1, githubish, bitbucket, 0, events, event_slots, &proposals_counts, &total_attempts) != 0
            reviews_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "reviews")
            if reviews_by_pull_idx >= 0:
                return -1 if not github or not scope_repository_present or reviews_idx >= 0 or nodes[reviews_by_pull_idx.usize()].kind != Json::RH_JSON_ARR
                reviews_counts.present <- true
                while review_group >= 0 |review_group: i64 = nodes[reviews_by_pull_idx.usize()].first_child, review_group_count: mutable i64 = 0, seen_pull_numbers: mutable darray[i64] = [], nodes, raw, texts, events, event_slots, reviews_counts, total_attempts|:
                    return -1 if review_group_count >= 10
                    return -1 if nodes[review_group.usize()].kind != Json::RH_JSON_OBJ
                    pull: RhForgeValue = ForgeEvents::rh_fe_int(nodes, raw, texts, review_group, "pull_number")
                    return -1 if not pull.valid or not pull.present or pull.value < 1
                    grouped_pull: i64 = pull.value
                    while prior_group_idx < seen_pull_numbers.count.i64() |prior_group_idx: i64 = 0, seen_pull_numbers, grouped_pull|:
                        return -1 if seen_pull_numbers[prior_group_idx.usize()] == grouped_pull
                        prior_group_idx <- prior_group_idx + 1
                    seen_pull_numbers.push(grouped_pull)
                    return -1 if ForgeEvents::rh_fe_add_array(nodes, raw, texts, review_group, "reviews", 2, githubish, bitbucket, grouped_pull, events, event_slots, &reviews_counts, &total_attempts) != 0
                    review_group <- nodes[review_group.usize()].next_sibling
                    review_group_count <- review_group_count + 1
            else:
                return -1 if ForgeEvents::rh_fe_add_array(nodes, raw, texts, root, "reviews", 2, githubish, bitbucket, 0, events, event_slots, &reviews_counts, &total_attempts) != 0
            return -1 if ForgeEvents::rh_fe_add_array(nodes, raw, texts, root, "releases", 3, githubish, bitbucket, 0, events, event_slots, &releases_counts, &total_attempts) != 0
            return -1 if ForgeEvents::rh_fe_not_attempted(nodes, texts, root, "issues", &issues_counts) != 0
            return -1 if ForgeEvents::rh_fe_not_attempted(nodes, texts, root, "proposals", &proposals_counts) != 0
            return -1 if ForgeEvents::rh_fe_not_attempted(nodes, texts, root, "reviews", &reviews_counts) != 0
            return -1 if ForgeEvents::rh_fe_not_attempted(nodes, texts, root, "releases", &releases_counts) != 0
            Base::rh_push_text(out, "{\"schema\":\"rh-forge-events-result/1\",\"provider\":\"")
            Base::rh_json_escape(out, texts, provider.start.usize(), provider.end.usize())
            Base::rh_push_text(out, "\",\"captured_at\":")
            Base::rh_push_decimal_i64(out, captured_at)
            Base::rh_push_text(out, ",\"authorization\":{\"state\":\"")
            Base::rh_push_text(out, ForgeEvents::rh_fe_auth_label(auth_state))
            Base::rh_push_text(out, "\"}")
            if scope_repository_present and scope_present:
                Base::rh_push_text(out, ",\"scope\":{\"repository\":\"")
                Base::rh_json_escape(out, texts, scope_repository_s.usize(), scope_repository_e.usize())
                Base::rh_push_text(out, "\",\"pull_request\":")
                Base::rh_push_decimal_i64(out, scope_pull)
                Base::rh_push_text(out, "}")
            elif scope_present:
                Base::rh_push_text(out, ",\"scope\":{\"pull_request\":")
                Base::rh_push_decimal_i64(out, scope_pull)
                Base::rh_push_text(out, "}")
            elif scope_repository_present:
                Base::rh_push_text(out, ",\"scope\":{\"repository\":\"")
                Base::rh_json_escape(out, texts, scope_repository_s.usize(), scope_repository_e.usize())
                Base::rh_push_text(out, "\"}")
            elif scope_project_present:
                Base::rh_push_text(out, ",\"scope\":{\"project_path\":\"")
                Base::rh_json_escape(out, texts, scope_project_s.usize(), scope_project_e.usize())
                Base::rh_push_text(out, "\"}")
            Base::rh_push_text(out, ",\"capabilities\":{")
            ForgeEvents::rh_fe_emit_cap(out, 0, issues_counts, events)
            out.push(44)
            ForgeEvents::rh_fe_emit_cap(out, 1, proposals_counts, events)
            out.push(44)
            ForgeEvents::rh_fe_emit_cap(out, 2, reviews_counts, events)
            out.push(44)
            ForgeEvents::rh_fe_emit_cap(out, 3, releases_counts, events)
            Base::rh_push_text(out, "}")
            if pagination_present:
                Base::rh_push_text(out, ",\"pagination\":{")
                return -1 if ForgeEvents::rh_fe_emit_page(nodes, texts, raw, pagination, "issues", out) != 0
                out.push(44)
                return -1 if ForgeEvents::rh_fe_emit_page(nodes, texts, raw, pagination, "proposals", out) != 0
                out.push(44)
                return -1 if ForgeEvents::rh_fe_emit_page(nodes, texts, raw, pagination, "reviews", out) != 0
                out.push(44)
                return -1 if ForgeEvents::rh_fe_emit_page(nodes, texts, raw, pagination, "releases", out) != 0
                out.push(125)
            if review_collection_present:
                Base::rh_push_text(out, ",\"review_collection\":{\"pending_pull_requests\":[")
                while cursor_idx < review_cursors.count.i64() |cursor_idx: i64 = 0, review_cursors, out|:
                    out.push(44) if cursor_idx > 0
                    Base::rh_push_text(out, "{\"number\":")
                    Base::rh_push_decimal_i64(out, review_cursors[cursor_idx.usize()].pull_number)
                    Base::rh_push_text(out, ",\"next_review_page\":")
                    Base::rh_push_decimal_i64(out, review_cursors[cursor_idx.usize()].next_review_page)
                    Base::rh_push_text(out, "}")
                    cursor_idx <- cursor_idx + 1
                Base::rh_push_text(out, "],\"batch_request\":{\"resumed_from_sha256\":")
                if resumed_digest_present:
                    out.push(34)
                    Base::rh_json_escape(out, texts, resumed_digest_s.usize(), resumed_digest_e.usize())
                    out.push(34)
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"pull_page\":")
                if requested_pull_page_present:
                    Base::rh_push_decimal_i64(out, requested_pull_page)
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"review_pages\":[")
                while request_idx < requested_review_cursors.count.i64() |request_idx: usize = 0, requested_review_cursors, out|:
                    out.push(44) if request_idx > 0
                    Base::rh_push_text(out, "{\"number\":")
                    Base::rh_push_decimal_i64(out, requested_review_cursors[request_idx].pull_number)
                    Base::rh_push_text(out, ",\"next_review_page\":")
                    Base::rh_push_decimal_i64(out, requested_review_cursors[request_idx].next_review_page)
                    out.push(125)
                    request_idx <- request_idx + 1
                Base::rh_push_text(out, "]},\"batch_pull_requests\":[")
                while pull_idx < pull_batch.count.i64() |pull_idx: usize = 0, pull_batch, out|:
                    out.push(44) if pull_idx > 0
                    Base::rh_push_text(out, "{\"number\":")
                    Base::rh_push_decimal_i64(out, pull_batch[pull_idx].pull_number)
                    Base::rh_push_text(out, ",\"merged_at\":")
                    if pull_batch[pull_idx].has_merged_at:
                        Base::rh_push_decimal_i64(out, pull_batch[pull_idx].merged_at)
                    else:
                        Base::rh_push_text(out, "null")
                    out.push(125)
                    pull_idx <- pull_idx + 1
                Base::rh_push_text(out, "],\"next_pull_page\":")
                if next_pull_page_present:
                    Base::rh_push_decimal_i64(out, next_pull_page)
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"pulls_complete\":")
                Base::rh_push_text(out, "true") if pulls_complete
                Base::rh_push_text(out, "false") if not pulls_complete
                complete: bool = review_cursors.count == 0 and pulls_complete
                Base::rh_push_text(out, ",\"complete\":")
                Base::rh_push_text(out, "true") if complete
                Base::rh_push_text(out, "false") if not complete
                Base::rh_push_text(out, "}")
            Base::rh_push_text(out, ",\"events\":[")
            while i < events.count.i64() |i: i64 = 0, events, out, provider, texts|:
                out.push(44) if i > 0
                ForgeEvents::rh_fe_emit_event(out, events[i], texts, provider)
                i <- i + 1
            Base::rh_push_text(out, "],\"note\":\"provider-native ids and status strings are retained at the captured evidence boundary; duplicate page observations replace by capability and native id; missing capability arrays are unsupported unless capability_states marks them not_attempted, malformed records are counted as rejected, and no role or authority is inferred from workflow participation\"}")
            0
