# rh_go_zip.elisa — bounded Go module ZIP h1 verification.

include "./rh_base.elisa"
include "./rh_sha256.elisa"

module GoZip:
    private:
        const RH_GO_ZIP_MAX_ARCHIVE_BYTES: i64 = 67108864
        const RH_GO_ZIP_MAX_EXPANDED_BYTES: i64 = 67108864
        const RH_GO_ZIP_MAX_ENTRIES: i64 = 10000
        const RH_GO_ZIP_MAX_NAME_BYTES: i64 = 8388608
        const RH_GO_ZIP_EOCD_SIGNATURE: i64 = 101010256
        const RH_GO_ZIP_CENTRAL_SIGNATURE: i64 = 33639248
        const RH_GO_ZIP_LOCAL_SIGNATURE: i64 = 67324752
        const RH_GO_ZIP_ZLIB_STREAM_SIZE: i32 = 112

        struct RhGoZipEntry:
            name: sview
            flags: i64
            method: i64
            crc32: u64
            compressed_size: i64
            uncompressed_size: i64
            data_offset: mutable i64

        # z_stream follows the 64-bit Unix zlib ABI used by the supported
        # Elisa toolchain targets. Only zlib's raw-DEFLATE and CRC primitives
        # cross the native boundary; archive parsing and h1 semantics stay here.
        struct RhGoZStream:
            next_in: mutable u8&?
            avail_in: mutable u32
            total_in: mutable u64
            next_out: mutable u8&?
            avail_out: mutable u32
            total_out: mutable u64
            msg: mutable u8&?
            state: mutable void&?
            zalloc: mutable void&?
            zfree: mutable void&?
            opaque: mutable void&?
            data_type: mutable i32
            adler: mutable u64
            reserved: mutable u64

        @link_name("zlibVersion")
        extern rh_go_zip_zlib_version() -> cstr

        @link_name("inflateInit2_")
        extern rh_go_zip_inflate_init2(stream: mutable RhGoZStream&, window_bits: i32, version: cstr, stream_size: i32) -> i32

        @link_name("inflate")
        extern rh_go_zip_inflate(stream: mutable RhGoZStream&, flush: i32) -> i32

        @link_name("inflateEnd")
        extern rh_go_zip_inflate_end(stream: mutable RhGoZStream&) -> i32

        @link_name("crc32")
        extern rh_go_zip_crc32(crc: u64, data: u8&?, length: u32) -> u64

        def rh_go_zip_u16(data: darray[u8]&, pos: i64) -> i64:
            return -1 if pos < 0 or pos + 2 > data.count.i64()
            data[pos.usize()].i64() | (data[(pos + 1).usize()].i64() << 8)

        def rh_go_zip_u32(data: darray[u8]&, pos: i64) -> i64:
            return -1 if pos < 0 or pos + 4 > data.count.i64()
            data[pos.usize()].i64() | (data[(pos + 1).usize()].i64() << 8) | (data[(pos + 2).usize()].i64() << 16) | (data[(pos + 3).usize()].i64() << 24)

        def rh_go_zip_entry_name_equal(a: sview, b: sview) -> bool:
            string_views_eq(a, b) == 1

        def rh_go_zip_entry_name_less(a: RhGoZipEntry, b: RhGoZipEntry) -> bool:
            a_name_size: i64 = string_view_len(a.name)
            b_name_size: i64 = string_view_len(b.name)
            while i < a_name_size and i < b_name_size |i: i64 = 0, a, b, a_name_size, b_name_size|:
                a_byte: i64 = string_view_index(a.name, i)
                b_byte: i64 = string_view_index(b.name, i)
                return a_byte < b_byte if a_byte != b_byte
                i <- i + 1
            a_name_size < b_name_size

        # The core sort API accepts a function value. Module-private Elisa
        # functions are intentionally not exposed as runtime function pointers,
        # so this private heapsort keeps comparison static and allocation-free.
        def rh_go_zip_entry_sift_down(entries: mutable darray[RhGoZipEntry]&, root_in: usize, end: usize) -> void:
            while true |root: mutable usize = root_in, entries, end|:
                child: usize = root * 2 + 1
                return if child >= end
                largest: mutable usize = root
                largest <- child if rh_go_zip_entry_name_less(entries[largest], entries[child])
                largest <- child + 1 if child + 1 < end and rh_go_zip_entry_name_less(entries[largest], entries[child + 1])
                return if largest == root
                tmp: RhGoZipEntry = entries[root]
                entries[root] <- entries[largest]
                entries[largest] <- tmp
                root <- largest

        def rh_go_zip_entry_sort(entries: mutable darray[RhGoZipEntry]&) -> void:
            n: usize = entries.count
            return if n < 2
            i: mutable usize = n / 2
            while i > 0 |i, entries, n|:
                i <- i - 1
                GoZip::rh_go_zip_entry_sift_down(entries, i, n)
            finish: mutable usize = n
            while finish > 1 |finish, entries|:
                finish <- finish - 1
                tmp: RhGoZipEntry = entries[0]
                entries[0] <- entries[finish]
                entries[finish] <- tmp
                GoZip::rh_go_zip_entry_sift_down(entries, 0, finish)

        def rh_go_zip_find_eocd(archive: darray[u8]&) -> i64:
            return -1 if archive.count.i64() < 22
            archive_size: i64 = archive.count.i64()
            lower_bound: mutable i64 = archive_size - 65557
            lower_bound <- 0 if lower_bound < 0
            found: mutable i64 = -1
            while pos >= lower_bound |pos: i64 = archive_size - 22, archive, archive_size, lower_bound, found|:
                if rh_go_zip_u32(archive, pos) == RH_GO_ZIP_EOCD_SIGNATURE:
                    comment_size: i64 = rh_go_zip_u16(archive, pos + 20)
                    found <- pos if comment_size >= 0 and pos + 22 + comment_size == archive_size
                pos <- pos - 1
            found

        def rh_go_zip_name_view(archive: darray[u8]&, name_start: i64, name_end: i64) -> sview:
            string_view_slice(bytes_view(archive), name_start, name_end)

        def rh_go_zip_local_data_offset(archive: darray[u8]&, entry: RhGoZipEntry, local_offset: i64, central_offset: i64) -> i64:
            return -1 if local_offset < 0 or local_offset + 30 > central_offset
            return -1 if rh_go_zip_u32(archive, local_offset) != RH_GO_ZIP_LOCAL_SIGNATURE
            local_flags: i64 = rh_go_zip_u16(archive, local_offset + 6)
            local_method: i64 = rh_go_zip_u16(archive, local_offset + 8)
            local_crc: i64 = rh_go_zip_u32(archive, local_offset + 14)
            local_compressed_size: i64 = rh_go_zip_u32(archive, local_offset + 18)
            local_uncompressed_size: i64 = rh_go_zip_u32(archive, local_offset + 22)
            local_name_size: i64 = rh_go_zip_u16(archive, local_offset + 26)
            local_extra_size: i64 = rh_go_zip_u16(archive, local_offset + 28)
            return -1 if local_flags != entry.flags or local_method != entry.method or local_name_size != string_view_len(entry.name)
            return -1 if local_crc < 0 or local_compressed_size < 0 or local_uncompressed_size < 0 or local_extra_size < 0
            descriptor_follows: bool = (entry.flags & 8) != 0
            return -1 if not descriptor_follows and (local_crc.u64() != entry.crc32 or local_compressed_size != entry.compressed_size or local_uncompressed_size != entry.uncompressed_size)
            return -1 if descriptor_follows and local_crc != 0 and local_crc.u64() != entry.crc32
            return -1 if descriptor_follows and local_compressed_size != 0 and local_compressed_size != entry.compressed_size
            return -1 if descriptor_follows and local_uncompressed_size != 0 and local_uncompressed_size != entry.uncompressed_size
            name_start: i64 = local_offset + 30
            return -1 if name_start + local_name_size + local_extra_size > central_offset
            while i < local_name_size |i: i64 = 0, archive, name_start, entry|:
                return -1 if archive[(name_start + i).usize()].i64() != string_view_index(entry.name, i)
                i <- i + 1
            data_start: i64 = name_start + local_name_size + local_extra_size
            return -1 if data_start + entry.compressed_size > central_offset
            data_start

        def rh_go_zip_parse(archive: darray[u8]&, entries: mutable darray[RhGoZipEntry]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if archive.count.i64() > RH_GO_ZIP_MAX_ARCHIVE_BYTES
            eocd: i64 = rh_go_zip_find_eocd(archive)
            return -1 if eocd < 0
            disk: i64 = rh_go_zip_u16(archive, eocd + 4)
            central_disk: i64 = rh_go_zip_u16(archive, eocd + 6)
            disk_entries: i64 = rh_go_zip_u16(archive, eocd + 8)
            total_entries: i64 = rh_go_zip_u16(archive, eocd + 10)
            central_size: i64 = rh_go_zip_u32(archive, eocd + 12)
            central_offset: i64 = rh_go_zip_u32(archive, eocd + 16)
            return -1 if disk != 0 or central_disk != 0 or disk_entries != total_entries
            return -1 if total_entries == 65535 or total_entries > RH_GO_ZIP_MAX_ENTRIES
            return -1 if central_size < 0 or central_offset < 0 or central_offset + central_size != eocd
            central_end: i64 = central_offset + central_size
            central_pos: mutable i64 = central_offset
            expanded_total: mutable i64 = 0
            name_total: mutable i64 = 0
            while i < total_entries |i: i64 = 0, total_entries, archive, central_pos, central_end, central_offset, expanded_total, name_total, entries|:
                return -1 if central_pos + 46 > central_end or rh_go_zip_u32(archive, central_pos) != RH_GO_ZIP_CENTRAL_SIGNATURE
                flags: i64 = rh_go_zip_u16(archive, central_pos + 8)
                method: i64 = rh_go_zip_u16(archive, central_pos + 10)
                checksum: i64 = rh_go_zip_u32(archive, central_pos + 16)
                compressed_size: i64 = rh_go_zip_u32(archive, central_pos + 20)
                uncompressed_size: i64 = rh_go_zip_u32(archive, central_pos + 24)
                name_size: i64 = rh_go_zip_u16(archive, central_pos + 28)
                extra_size: i64 = rh_go_zip_u16(archive, central_pos + 30)
                comment_size: i64 = rh_go_zip_u16(archive, central_pos + 32)
                start_disk: i64 = rh_go_zip_u16(archive, central_pos + 34)
                local_offset: i64 = rh_go_zip_u32(archive, central_pos + 42)
                return -1 if flags < 0 or method < 0 or checksum < 0 or compressed_size < 0 or uncompressed_size < 0 or name_size <= 0 or extra_size < 0 or comment_size < 0 or start_disk != 0 or local_offset < 0
                return -1 if (flags & 1) != 0 or (flags & 64) != 0 or (flags & 8192) != 0
                return -1 if method != 0 and method != 8
                return -1 if compressed_size == 4294967295 or uncompressed_size == 4294967295 or local_offset == 4294967295
                return -1 if method == 0 and compressed_size != uncompressed_size
                return -1 if central_pos + 46 + name_size + extra_size + comment_size > central_end
                name_start: i64 = central_pos + 46
                name_end: i64 = name_start + name_size
                entry_name: sview = rh_go_zip_name_view(archive, name_start, name_end)
                return -1 if string_view_len(entry_name) == 0
                return -1 if name_total + name_size > RH_GO_ZIP_MAX_NAME_BYTES
                return -1 if expanded_total + uncompressed_size > RH_GO_ZIP_MAX_EXPANDED_BYTES
                while name_index < string_view_len(entry_name) |name_index: i64 = 0, entry_name|:
                    return -1 if string_view_index(entry_name, name_index) == 10
                    name_index <- name_index + 1
                entry: RhGoZipEntry = RhGoZipEntry{name: entry_name, flags: flags, method: method, crc32: checksum.u64(), compressed_size: compressed_size, uncompressed_size: uncompressed_size, data_offset: -1}
                data_offset: i64 = rh_go_zip_local_data_offset(archive, entry, local_offset, central_offset)
                return -1 if data_offset < 0
                entry.data_offset <- data_offset
                entries.push(entry)
                name_total <- name_total + name_size
                expanded_total <- expanded_total + uncompressed_size
                central_pos <- central_pos + 46 + name_size + extra_size + comment_size
                i <- i + 1
            return -1 if central_pos != central_end
            0

        def rh_go_zip_entry_bytes(archive: darray[u8]&, entry: RhGoZipEntry, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.RawExtern, Unsafe.PointerCast]:
            out <- []
            while i < entry.uncompressed_size |i: i64 = 0, out, entry|:
                out.push(0)
                i <- i + 1
            if entry.method == 0:
                while i < entry.compressed_size |i: i64 = 0, archive, entry, out|:
                    out[i.usize()] <- archive[(entry.data_offset + i).usize()]
                    i <- i + 1
            elif entry.method == 8:
                empty_sink: mutable darray[u8] = [0]
                stream: mutable RhGoZStream = RhGoZStream{next_in: null, avail_in: entry.compressed_size.u32(), total_in: 0, next_out: null, avail_out: (entry.uncompressed_size.u32() if entry.uncompressed_size > 0 else 1), total_out: 0, msg: null, state: null, zalloc: null, zfree: null, opaque: null, data_type: 0, adler: 0, reserved: 0}
                if entry.compressed_size > 0:
                    stream.next_in <- (&archive[entry.data_offset.usize()]).cast[u8&?] can Unsafe.PointerCast
                if entry.uncompressed_size > 0:
                    stream.next_out <- (&out[0]).cast[u8&?] can Unsafe.PointerCast
                else:
                    stream.next_out <- (&empty_sink[0]).cast[u8&?] can Unsafe.PointerCast
                init_status: i32 = rh_go_zip_inflate_init2(&stream, -15, rh_go_zip_zlib_version(), RH_GO_ZIP_ZLIB_STREAM_SIZE)
                return -1 if init_status != 0
                inflate_status: i32 = rh_go_zip_inflate(&stream, 4)
                end_status: i32 = rh_go_zip_inflate_end(&stream)
                return -1 if inflate_status != 1 or end_status != 0 or stream.total_in != entry.compressed_size.u64() or stream.total_out != entry.uncompressed_size.u64()
            else:
                return -1
            actual_crc: u64 =
                if out.count > 0:
                    out_ptr: u8&? = (&out[0]).cast[u8&?] can Unsafe.PointerCast
                    rh_go_zip_crc32(0, out_ptr, out.count.u32())
                else:
                    rh_go_zip_crc32(0, null, 0)
            return -1 if actual_crc != entry.crc32
            0

    public:
        # Compute the Go module h1 digest over a ZIP's file names and expanded
        # contents. Parsing and total expansion are bounded; no paths are written.
        # The return value is 0 on success and -1 for unsupported or malformed ZIPs.
        def rh_go_zip_h1(archive: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.RawExtern, Unsafe.PointerCast]:
            entries: mutable darray[RhGoZipEntry] = []
            return -1 if GoZip::rh_go_zip_parse(archive, entries) != 0
            GoZip::rh_go_zip_entry_sort(entries)
            while i < entries.count |i: usize = 0, entries|:
                current: RhGoZipEntry = entries[i]
                if i > 0:
                    previous: RhGoZipEntry = entries[i - 1]
                    previous_name: sview = previous.name
                    current_name: sview = current.name
                    return -1 if GoZip::rh_go_zip_entry_name_equal(previous_name, current_name)
                i <- i + 1
            summary: mutable darray[u8] = []
            while i < entries.count |i: usize = 0, archive, entries, summary|:
                entry: RhGoZipEntry = entries[i]
                file_bytes: mutable darray[u8] = []
                return -1 if GoZip::rh_go_zip_entry_bytes(archive, entry, file_bytes) != 0
                file_digest: mutable darray[u8] = []
                Sha256::rh_sha256(file_bytes, file_digest)
                summary.extend(bytes_view(file_digest))
                Base::rh_push_text(summary, "  ")
                entry_name: sview = entry.name
                summary.extend(entry_name)
                summary.push(10)
                i <- i + 1
            Base::rh_push_text(out, "h1:")
            Sha256::rh_sha256_base64(summary, out)
            0
