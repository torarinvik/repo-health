# rh_aggregates.elisa — validated daily/weekly event aggregates (M10-02).
#
# The input event set is authoritative for this bounded adapter. Corrections
# identify affected partitions; persisted daily/weekly fingerprints reuse only
# rows whose complete validated event partition is unchanged. Actor identities
# feed distinct counts and never appear in emitted rows or cache records.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_sha256.elisa"

struct RhAggregateEvent:
    id_s: mutable i64
    id_e: mutable i64
    actor_s: mutable i64
    actor_e: mutable i64
    kind_s: mutable i64
    kind_e: mutable i64
    role_s: mutable i64
    role_e: mutable i64
    at: mutable i64

struct RhAggregatePartition:
    bucket: mutable i64
    signature_input: mutable darray[u8]
    signature: mutable darray[u8]
    cached_row: mutable darray[u8]

module Aggregates:
    private:
        def rh_aggregate_partition(partitions: mutable darray[RhAggregatePartition]&, bucket: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < partitions.count |i: usize = 0, partitions, bucket|:
                return i.i64() if partitions[i].bucket == bucket
                i <- i + 1
            partitions.push(RhAggregatePartition{bucket: bucket, signature_input: [], signature: [], cached_row: []})
            (partitions.count - 1).i64()

        def rh_aggregate_append_span(out: mutable darray[u8]&, texts: darray[u8]&, start: i64, end: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_decimal_i64(out, end - start)
            out.push(58)
            while i < end - start |i: i64 = 0, out, texts, start, end|:
                out.push(texts[(start + i).usize()])
                i <- i + 1
            out.push(59)

        def rh_aggregate_partition_signature(partition: mutable RhAggregatePartition&) -> void can[Memory.Allocate, Abort.Panic]:
            Sha256::rh_sha256(partition.signature_input, partition.signature)

        def rh_aggregate_prior_row(prior: darray[u8]&, kind: u8, bucket: i64, signature: darray[u8]&, row_out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            bucket_text: mutable darray[u8] = []
            Base::rh_push_decimal_i64(bucket_text, bucket)
            while start < prior.count |start: usize = 0, prior, kind, bucket_text, signature, row_out|:
                end: mutable i64 = Base::rh_find_byte(prior, start.i64(), 10)
                end <- prior.count.i64() if end < 0
                bucket_end: i64 = Base::rh_find_byte(prior, start.i64() + 2, 124)
                if end > start.i64() + 2 and prior[start] == kind and prior[start + 1] == 124 and bucket_end >= 0 and bucket_end <= end:
                    same_bucket: mutable bool = bucket_end - (start.i64() + 2) == bucket_text.count.i64()
                    while same_bucket and i < bucket_text.count |i: usize = 0, prior, start, bucket_text, same_bucket|:
                        same_bucket <- prior[start + 2 + i] == bucket_text[i]
                        i <- i + 1
                    signature_end: i64 = Base::rh_find_byte(prior, bucket_end + 1, 124)
                    same_signature: mutable bool = same_bucket and signature_end - bucket_end - 1 == signature.count.i64()
                    while same_signature and i < signature.count |i: usize = 0, prior, bucket_end, signature, same_signature|:
                        same_signature <- prior[bucket_end.usize() + 1 + i] == signature[i]
                        i <- i + 1
                    if same_signature and signature_end >= 0 and signature_end < end:
                        while i < (end - signature_end - 1).usize() |i: usize = 0, prior, signature_end, end, row_out|:
                            row_out.push(prior[signature_end.usize() + 1 + i])
                            i <- i + 1
                        return
                start <- (end + 1).usize()

        def rh_aggregate_record_matches(data: darray[u8]&, start: usize, end: i64, kind: u8, bucket: darray[u8]&, signature: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if end <= start.i64() + 2 or data[start] != kind or data[start + 1] != 124
            bucket_end: i64 = Base::rh_find_byte(data, start.i64() + 2, 124)
            return false if bucket_end < 0 or bucket_end > end or bucket_end - start.i64() - 2 != bucket.count.i64()
            while i < bucket.count |i: usize = 0, data, start, bucket|:
                return false if data[start + 2 + i] != bucket[i]
                i <- i + 1
            signature_end: i64 = Base::rh_find_byte(data, bucket_end + 1, 124)
            return false if signature_end < 0 or signature_end > end or signature_end - bucket_end - 1 != signature.count.i64()
            while i < signature.count |i: usize = 0, data, bucket_end, signature|:
                return false if data[bucket_end.usize() + 1 + i] != signature[i]
                i <- i + 1
            true

        def rh_aggregate_cache_has_record(cache: darray[u8]&, kind: u8, bucket: darray[u8]&, signature: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            while start < cache.count |start: usize = 0, cache, kind, bucket, signature|:
                end: mutable i64 = Base::rh_find_byte(cache, start.i64(), 10)
                end <- cache.count.i64() if end < 0
                return true if Aggregates::rh_aggregate_record_matches(cache, start, end, kind, bucket, signature)
                start <- (end + 1).usize()
            false

        def rh_aggregate_preserve_history(prior: darray[u8]&, cache_out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic, Memory.Release]:
            preserved: mutable usize = 0
            while start < prior.count and preserved < 4096 and cache_out.count < 16777216 |start: usize = 0, prior, cache_out, preserved|:
                end: mutable i64 = Base::rh_find_byte(prior, start.i64(), 10)
                end <- prior.count.i64() if end < 0
                kind: u8 = prior[start]
                if kind == 68 or kind == 87:
                    bucket_end: i64 = Base::rh_find_byte(prior, start.i64() + 2, 124)
                    signature_end: i64 = Base::rh_find_byte(prior, bucket_end + 1, 124) if bucket_end >= 0 else -1
                    if bucket_end >= 0 and signature_end >= 0 and signature_end < end:
                        bucket: mutable darray[u8] = []
                        signature: mutable darray[u8] = []
                        while i < (bucket_end - start.i64() - 2).usize() |i: usize = 0, prior, start, bucket_end, bucket|:
                            bucket.push(prior[start + 2 + i])
                            i <- i + 1
                        while i < (signature_end - bucket_end - 1).usize() |i: usize = 0, prior, bucket_end, signature_end, signature|:
                            signature.push(prior[bucket_end.usize() + 1 + i])
                            i <- i + 1
                        if not Aggregates::rh_aggregate_cache_has_record(cache_out, kind, bucket, signature) and cache_out.count + (end - start.i64() + 1).usize() <= 16777216:
                            while i < (end - start.i64() + 1).usize() |i: usize = 0, prior, start, end, cache_out|:
                                cache_out.push(prior[start + i])
                                i <- i + 1
                            preserved <- preserved + 1
                start <- (end + 1).usize()

        def rh_aggregate_sort_partitions(partitions: mutable darray[RhAggregatePartition]&) -> void can[Memory.Allocate, Abort.Panic]:
            while i < partitions.count |i: usize = 1, partitions|:
                j: mutable usize = i
                while j > 0 and partitions[j - 1].bucket > partitions[j].bucket |j, partitions|:
                    partition: RhAggregatePartition = partitions[j - 1]
                    partitions[j - 1] <- partitions[j]
                    partitions[j] <- partition
                    j <- j - 1
                i <- i + 1

        def rh_aggregate_event_before(texts: darray[u8]&, left: RhAggregateEvent, right: RhAggregateEvent) -> bool can[Memory.Allocate, Abort.Panic]:
            Aggregates::rh_aggregate_text_compare(texts, left.id_s, left.id_e, right.id_s, right.id_e) < 0

        def rh_aggregate_sort_events(events: mutable darray[RhAggregateEvent]&, texts: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            while i < events.count |i: usize = 1, events, texts|:
                j: mutable usize = i
                while j > 0 and Aggregates::rh_aggregate_event_before(texts, events[j], events[j - 1]) |j, events, texts|:
                    event: RhAggregateEvent = events[j - 1]
                    events[j - 1] <- events[j]
                    events[j] <- event
                    j <- j - 1
                i <- i + 1

        def rh_aggregate_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e < s or e - s != strlen(lit).i64()
            while i < e - s |i: i64 = 0, texts, s, lit|:
                return false if texts[(s + i).usize()] != lit[i.usize()]
                i <- i + 1
            true

        def rh_aggregate_span(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, start_out: mutable i64&, end_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return false if idx < 0 or nodes[idx.usize()].kind != Json::RH_JSON_STR
            value: Json::RhJsonNode = nodes[idx.usize()]
            start_out[0] <- value.text_start
            end_out[0] <- value.text_end
            true

        def rh_aggregate_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            Json::rh_json_int(nodes, raw, idx, ok_out)

        def rh_aggregate_text_compare(texts: darray[u8]&, a_s: i64, a_e: i64, b_s: i64, b_e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            length: i64 = (a_e - a_s) if a_e - a_s < b_e - b_s else b_e - b_s
            while i < length |i: i64 = 0, texts, a_s, b_s|:
                return -1 if texts[(a_s + i).usize()] < texts[(b_s + i).usize()]
                return 1 if texts[(a_s + i).usize()] > texts[(b_s + i).usize()]
                i <- i + 1
            return -1 if a_e - a_s < b_e - b_s
            return 1 if a_e - a_s > b_e - b_s
            0

        def rh_aggregate_sort_buckets(bucket_ids: mutable darray[i64]&, event_counts: mutable darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
            while i < bucket_ids.count |i: usize = 1, bucket_ids, event_counts|:
                j: mutable usize = i
                while j > 0 and bucket_ids[j - 1] > bucket_ids[j] |j, bucket_ids, event_counts|:
                    bucket: i64 = bucket_ids[j - 1]
                    count: i64 = event_counts[j - 1]
                    bucket_ids[j - 1] <- bucket_ids[j]
                    event_counts[j - 1] <- event_counts[j]
                    bucket_ids[j] <- bucket
                    event_counts[j] <- count
                    j <- j - 1
                i <- i + 1

        def rh_aggregate_sort_roles(role_buckets: mutable darray[i64]&, role_starts: mutable darray[i64]&, role_ends: mutable darray[i64]&, role_counts: mutable darray[i64]&, texts: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            while i < role_buckets.count |i: usize = 1, role_buckets, role_starts, role_ends, role_counts, texts|:
                j: mutable usize = i
                while j > 0 |j, role_buckets, role_starts, role_ends, role_counts, texts|:
                    left: usize = j - 1
                    right: usize = j
                    comparison: mutable i64 = Aggregates::rh_aggregate_text_compare(texts, role_starts[left], role_ends[left], role_starts[right], role_ends[right])
                    comparison <- -1 if role_buckets[left] < role_buckets[right]
                    comparison <- 1 if role_buckets[left] > role_buckets[right]
                    break if comparison <= 0
                    bucket: i64 = role_buckets[left]
                    start: i64 = role_starts[left]
                    end: i64 = role_ends[left]
                    count: i64 = role_counts[left]
                    role_buckets[left] <- role_buckets[right]
                    role_starts[left] <- role_starts[right]
                    role_ends[left] <- role_ends[right]
                    role_counts[left] <- role_counts[right]
                    role_buckets[right] <- bucket
                    role_starts[right] <- start
                    role_ends[right] <- end
                    role_counts[right] <- count
                    j <- j - 1
                i <- i + 1

        def rh_aggregate_bucket(bucket_ids: darray[i64]&, bucket: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < bucket_ids.count |i: usize = 0, bucket_ids, bucket|:
                return i.i64() if bucket_ids[i] == bucket
                i <- i + 1
            -1

        def rh_aggregate_actor_seen(bucket: i64, actor_s: i64, actor_e: i64, actor_buckets: darray[i64]&, actor_starts: darray[i64]&, actor_ends: darray[i64]&, texts: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < actor_buckets.count |i: usize = 0, actor_buckets, actor_starts, actor_ends, bucket, actor_s, actor_e, texts|:
                if actor_buckets[i] == bucket and Base::rh_bytes_equal_span(texts, actor_starts[i], actor_ends[i], texts, actor_s, actor_e):
                    return true
                i <- i + 1
            false

        def rh_aggregate_add(bucket: i64, actor_s: i64, actor_e: i64, role_s: i64, role_e: i64, texts: darray[u8]&, bucket_ids: mutable darray[i64]&, event_counts: mutable darray[i64]&, actor_buckets: mutable darray[i64]&, actor_starts: mutable darray[i64]&, actor_ends: mutable darray[i64]&, role_buckets: mutable darray[i64]&, role_starts: mutable darray[i64]&, role_ends: mutable darray[i64]&, role_counts: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            bucket_idx: mutable i64 = Aggregates::rh_aggregate_bucket(bucket_ids, bucket)
            if bucket_idx < 0:
                bucket_ids.push(bucket)
                event_counts.push(0)
                bucket_idx <- bucket_ids.count.i64() - 1
            event_counts[bucket_idx.usize()] <- event_counts[bucket_idx.usize()] + 1
            if not Aggregates::rh_aggregate_actor_seen(bucket, actor_s, actor_e, actor_buckets, actor_starts, actor_ends, texts):
                actor_buckets.push(bucket)
                actor_starts.push(actor_s)
                actor_ends.push(actor_e)
            role_idx: mutable i64 = -1
            while ri < role_buckets.count |ri: usize = 0, role_buckets, role_starts, role_ends, bucket, role_s, role_e, texts|:
                if role_buckets[ri] == bucket and Base::rh_bytes_equal_span(texts, role_starts[ri], role_ends[ri], texts, role_s, role_e):
                    role_idx <- ri.i64()
                    break
                ri <- ri + 1
            if role_idx < 0:
                role_buckets.push(bucket)
                role_starts.push(role_s)
                role_ends.push(role_e)
                role_counts.push(1)
            else:
                role_counts[role_idx.usize()] <- role_counts[role_idx.usize()] + 1
            bucket_idx

        def rh_aggregate_emit_row(out: mutable darray[u8]&, bucket: i64, bucket_idx: usize, event_counts: darray[i64]&, actor_buckets: darray[i64]&, role_buckets: darray[i64]&, role_starts: darray[i64]&, role_ends: darray[i64]&, role_counts: darray[i64]&, texts: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
                actors: mutable i64 = 0
                while j < actor_buckets.count |j: usize = 0, actor_buckets, bucket, actors|:
                    actors <- actors + 1 if actor_buckets[j] == bucket
                    j <- j + 1
                Base::rh_push_text(out, "{\"bucket\":")
                Base::rh_push_decimal_i64(out, bucket)
                Base::rh_push_text(out, ",\"event_count\":")
                Base::rh_push_decimal_i64(out, event_counts[bucket_idx])
                Base::rh_push_text(out, ",\"distinct_actor_count\":")
                Base::rh_push_decimal_i64(out, actors)
                Base::rh_push_text(out, ",\"role_counts\":{")
                first_role: mutable bool = true
                while r < role_buckets.count |r: usize = 0, role_buckets, role_starts, role_ends, role_counts, bucket, texts, out, first_role|:
                    if role_buckets[r] == bucket:
                        if not first_role:
                            out.push(44)
                        first_role <- false
                        out.push(34)
                        Base::rh_json_escape(out, texts, role_starts[r].usize(), role_ends[r].usize())
                        out.push(34)
                        out.push(58)
                        Base::rh_push_decimal_i64(out, role_counts[r])
                    r <- r + 1
                Base::rh_push_text(out, "}}")

        def rh_aggregate_emit(out: mutable darray[u8]&, partitions: mutable darray[RhAggregatePartition]&, kind: u8, bucket_ids: darray[i64]&, event_counts: darray[i64]&, actor_buckets: darray[i64]&, role_buckets: darray[i64]&, role_starts: darray[i64]&, role_ends: darray[i64]&, role_counts: darray[i64]&, texts: darray[u8]&, cache_out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "[")
            while i < partitions.count |i: usize = 0, partitions, kind, bucket_ids, event_counts, actor_buckets, role_buckets, role_starts, role_ends, role_counts, texts, cache_out, out|:
                if i > 0:
                    out.push(44)
                partition: RhAggregatePartition = partitions[i]
                row: mutable darray[u8] = []
                row.extend(bytes_view(partition.cached_row))
                if row.count == 0:
                    bucket_idx: i64 = Aggregates::rh_aggregate_bucket(bucket_ids, partition.bucket)
                    if bucket_idx >= 0:
                        Aggregates::rh_aggregate_emit_row(row, partition.bucket, bucket_idx.usize(), event_counts, actor_buckets, role_buckets, role_starts, role_ends, role_counts, texts)
                out.extend(bytes_view(row))
                cache_out.push(kind)
                cache_out.push(124)
                Base::rh_push_decimal_i64(cache_out, partition.bucket)
                cache_out.push(124)
                cache_out.extend(bytes_view(partition.signature))
                cache_out.push(124)
                cache_out.extend(bytes_view(row))
                cache_out.push(10)
                i <- i + 1
            Base::rh_push_text(out, "]")

        def rh_aggregate_push_unique(values: mutable darray[i64]&, value: i64) -> void can[Memory.Allocate, Abort.Panic]:
            while i < values.count |i: usize = 0, values, value|:
                return if values[i] == value
                i <- i + 1
            values.push(value)

    public:
        # A cache row is reusable only when its bucket and canonical event
        # fingerprint match. Correction metadata is always recomputed below.
        def rh_aggregate_report(raw: darray[u8]&, prior: darray[u8]&, out: mutable darray[u8]&, cache_out: mutable darray[u8]&, reused_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_s: mutable i64 = 0
            schema_e: mutable i64 = 0
            return -1 if not Aggregates::rh_aggregate_span(nodes, texts, root, "schema", &schema_s, &schema_e)
            return -1 if not Aggregates::rh_aggregate_eq(texts, schema_s, schema_e, "rh-aggregate-input/1")
            events_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "events")
            return -1 if events_idx < 0 or nodes[events_idx.usize()].kind != Json::RH_JSON_ARR
            events: mutable darray[RhAggregateEvent] = []
            event_arr: Json::RhJsonNode = nodes[events_idx.usize()]
            while child >= 0 |child: i64 = event_arr.first_child, nodes, texts, raw, events|:
                return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                id_s: mutable i64 = 0
                id_e: mutable i64 = 0
                actor_s: mutable i64 = 0
                actor_e: mutable i64 = 0
                role_s: mutable i64 = 0
                role_e: mutable i64 = 0
                kind_s: mutable i64 = 0
                kind_e: mutable i64 = 0
                return -1 if not Aggregates::rh_aggregate_span(nodes, texts, child, "id", &id_s, &id_e) or not Aggregates::rh_aggregate_span(nodes, texts, child, "actor", &actor_s, &actor_e) or not Aggregates::rh_aggregate_span(nodes, texts, child, "role", &role_s, &role_e) or not Aggregates::rh_aggregate_span(nodes, texts, child, "kind", &kind_s, &kind_e)
                return -1 if id_s == id_e or actor_s == actor_e or role_s == role_e or kind_s == kind_e
                ok_at: mutable i64 = 0
                at: i64 = Aggregates::rh_aggregate_int(nodes, raw, texts, child, "at", &ok_at)
                return -1 if ok_at == 0 or at < 0
                while prior < events.count |prior: usize = 0, events, texts, id_s, id_e|:
                    return -1 if Base::rh_bytes_equal_span(texts, events[prior].id_s, events[prior].id_e, texts, id_s, id_e)
                    prior <- prior + 1
                events.push(RhAggregateEvent{id_s: id_s, id_e: id_e, actor_s: actor_s, actor_e: actor_e, kind_s: kind_s, kind_e: kind_e, role_s: role_s, role_e: role_e, at: at})
                child <- nodes[child.usize()].next_sibling
            Aggregates::rh_aggregate_sort_events(events, texts)
            daily_partitions: mutable darray[RhAggregatePartition] = []
            weekly_partitions: mutable darray[RhAggregatePartition] = []
            while i < events.count |i: usize = 0, events, texts, daily_partitions, weekly_partitions|:
                event: RhAggregateEvent = events[i]
                daily_idx: i64 = Aggregates::rh_aggregate_partition(daily_partitions, event.at / 86400)
                daily_signature_input: mutable darray[u8] = daily_partitions[daily_idx.usize()].signature_input
                Aggregates::rh_aggregate_append_span(daily_signature_input, texts, event.id_s, event.id_e)
                Aggregates::rh_aggregate_append_span(daily_signature_input, texts, event.actor_s, event.actor_e)
                Aggregates::rh_aggregate_append_span(daily_signature_input, texts, event.kind_s, event.kind_e)
                Aggregates::rh_aggregate_append_span(daily_signature_input, texts, event.role_s, event.role_e)
                Base::rh_push_decimal_i64(daily_signature_input, event.at)
                daily_signature_input.push(59)
                daily_partitions[daily_idx.usize()].signature_input <- daily_signature_input
                weekly_idx: i64 = Aggregates::rh_aggregate_partition(weekly_partitions, event.at / 604800)
                weekly_signature_input: mutable darray[u8] = weekly_partitions[weekly_idx.usize()].signature_input
                Aggregates::rh_aggregate_append_span(weekly_signature_input, texts, event.id_s, event.id_e)
                Aggregates::rh_aggregate_append_span(weekly_signature_input, texts, event.actor_s, event.actor_e)
                Aggregates::rh_aggregate_append_span(weekly_signature_input, texts, event.kind_s, event.kind_e)
                Aggregates::rh_aggregate_append_span(weekly_signature_input, texts, event.role_s, event.role_e)
                Base::rh_push_decimal_i64(weekly_signature_input, event.at)
                weekly_signature_input.push(59)
                weekly_partitions[weekly_idx.usize()].signature_input <- weekly_signature_input
                i <- i + 1
            while i < daily_partitions.count |i: usize = 0, daily_partitions, prior|:
                Aggregates::rh_aggregate_partition_signature(daily_partitions[i])
                Aggregates::rh_aggregate_prior_row(prior, 68, daily_partitions[i].bucket, daily_partitions[i].signature, daily_partitions[i].cached_row)
                reused_out[0] <- reused_out[0] + 1 if daily_partitions[i].cached_row.count > 0
                i <- i + 1
            while i < weekly_partitions.count |i: usize = 0, weekly_partitions, prior|:
                Aggregates::rh_aggregate_partition_signature(weekly_partitions[i])
                Aggregates::rh_aggregate_prior_row(prior, 87, weekly_partitions[i].bucket, weekly_partitions[i].signature, weekly_partitions[i].cached_row)
                reused_out[0] <- reused_out[0] + 1 if weekly_partitions[i].cached_row.count > 0
                i <- i + 1
            Aggregates::rh_aggregate_sort_partitions(daily_partitions)
            Aggregates::rh_aggregate_sort_partitions(weekly_partitions)
            daily_buckets: mutable darray[i64] = []
            daily_counts: mutable darray[i64] = []
            daily_actor_buckets: mutable darray[i64] = []
            daily_actor_starts: mutable darray[i64] = []
            daily_actor_ends: mutable darray[i64] = []
            daily_role_buckets: mutable darray[i64] = []
            daily_role_starts: mutable darray[i64] = []
            daily_role_ends: mutable darray[i64] = []
            daily_role_counts: mutable darray[i64] = []
            weekly_buckets: mutable darray[i64] = []
            weekly_counts: mutable darray[i64] = []
            weekly_actor_buckets: mutable darray[i64] = []
            weekly_actor_starts: mutable darray[i64] = []
            weekly_actor_ends: mutable darray[i64] = []
            weekly_role_buckets: mutable darray[i64] = []
            weekly_role_starts: mutable darray[i64] = []
            weekly_role_ends: mutable darray[i64] = []
            weekly_role_counts: mutable darray[i64] = []
            while i < events.count |i: usize = 0, events, texts, daily_partitions, weekly_partitions, daily_buckets, daily_counts, daily_actor_buckets, daily_actor_starts, daily_actor_ends, daily_role_buckets, daily_role_starts, daily_role_ends, daily_role_counts, weekly_buckets, weekly_counts, weekly_actor_buckets, weekly_actor_starts, weekly_actor_ends, weekly_role_buckets, weekly_role_starts, weekly_role_ends, weekly_role_counts|:
                event: RhAggregateEvent = events[i]
                day: i64 = event.at / 86400
                week: i64 = event.at / 604800
                daily_idx: i64 = Aggregates::rh_aggregate_partition(daily_partitions, day)
                if daily_partitions[daily_idx.usize()].cached_row.count == 0:
                    Aggregates::rh_aggregate_add(day, event.actor_s, event.actor_e, event.role_s, event.role_e, texts, daily_buckets, daily_counts, daily_actor_buckets, daily_actor_starts, daily_actor_ends, daily_role_buckets, daily_role_starts, daily_role_ends, daily_role_counts)
                weekly_idx: i64 = Aggregates::rh_aggregate_partition(weekly_partitions, week)
                if weekly_partitions[weekly_idx.usize()].cached_row.count == 0:
                    Aggregates::rh_aggregate_add(week, event.actor_s, event.actor_e, event.role_s, event.role_e, texts, weekly_buckets, weekly_counts, weekly_actor_buckets, weekly_actor_starts, weekly_actor_ends, weekly_role_buckets, weekly_role_starts, weekly_role_ends, weekly_role_counts)
                i <- i + 1
            Aggregates::rh_aggregate_sort_buckets(daily_buckets, daily_counts)
            Aggregates::rh_aggregate_sort_buckets(weekly_buckets, weekly_counts)
            Aggregates::rh_aggregate_sort_roles(daily_role_buckets, daily_role_starts, daily_role_ends, daily_role_counts, texts)
            Aggregates::rh_aggregate_sort_roles(weekly_role_buckets, weekly_role_starts, weekly_role_ends, weekly_role_counts, texts)
            invalid_daily: mutable darray[i64] = []
            invalid_weekly: mutable darray[i64] = []
            corrections_count: mutable i64 = 0
            corrections_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "corrections")
            if corrections_idx >= 0:
                return -1 if nodes[corrections_idx.usize()].kind != Json::RH_JSON_ARR
                correction: mutable i64 = nodes[corrections_idx.usize()].first_child
                while correction >= 0 |correction, nodes, texts, events, invalid_daily, invalid_weekly, corrections_count|:
                    return -1 if nodes[correction.usize()].kind != Json::RH_JSON_OBJ
                    corr_s: mutable i64 = 0
                    corr_e: mutable i64 = 0
                    action_s: mutable i64 = 0
                    action_e: mutable i64 = 0
                    reason_s: mutable i64 = 0
                    reason_e: mutable i64 = 0
                    return -1 if not Aggregates::rh_aggregate_span(nodes, texts, correction, "id", &corr_s, &corr_e) or not Aggregates::rh_aggregate_span(nodes, texts, correction, "action", &action_s, &action_e) or not Aggregates::rh_aggregate_span(nodes, texts, correction, "reason", &reason_s, &reason_e)
                    return -1 if reason_s == reason_e or (not Aggregates::rh_aggregate_eq(texts, action_s, action_e, "replace") and not Aggregates::rh_aggregate_eq(texts, action_s, action_e, "retract"))
                    event_idx: mutable i64 = -1
                    while ei < events.count |ei: usize = 0, events, texts, corr_s, corr_e|:
                        if Base::rh_bytes_equal_span(texts, events[ei].id_s, events[ei].id_e, texts, corr_s, corr_e):
                            event_idx <- ei.i64()
                            break
                        ei <- ei + 1
                    return -1 if event_idx < 0
                    corrected: RhAggregateEvent = events[event_idx.usize()]
                    Aggregates::rh_aggregate_push_unique(invalid_daily, corrected.at / 86400)
                    Aggregates::rh_aggregate_push_unique(invalid_weekly, corrected.at / 604800)
                    corrections_count <- corrections_count + 1
                    correction <- nodes[correction.usize()].next_sibling
            Base::rh_push_text(out, "{\"schema\":\"rh-aggregate-result/1\",\"windowing\":{\"daily_seconds\":86400,\"weekly_seconds\":604800,\"timezone\":\"utc_epoch\"},\"daily\":")
            Base::rh_push_text(cache_out, "rh-aggregate-cache/2\n")
            Aggregates::rh_aggregate_emit(out, daily_partitions, 68, daily_buckets, daily_counts, daily_actor_buckets, daily_role_buckets, daily_role_starts, daily_role_ends, daily_role_counts, texts, cache_out)
            Base::rh_push_text(out, ",\"weekly\":")
            Aggregates::rh_aggregate_emit(out, weekly_partitions, 87, weekly_buckets, weekly_counts, weekly_actor_buckets, weekly_role_buckets, weekly_role_starts, weekly_role_ends, weekly_role_counts, texts, cache_out)
            Base::rh_push_text(out, ",\"corrections\":{\"count\":")
            Base::rh_push_decimal_i64(out, corrections_count)
            Base::rh_push_text(out, ",\"invalidated_daily\":[")
            while i < invalid_daily.count |i: usize = 0, invalid_daily, out|:
                if i > 0:
                    out.push(44)
                Base::rh_push_decimal_i64(out, invalid_daily[i])
                i <- i + 1
            Base::rh_push_text(out, "],\"invalidated_weekly\":[")
            while j < invalid_weekly.count |j: usize = 0, invalid_weekly, out|:
                if j > 0:
                    out.push(44)
                Base::rh_push_decimal_i64(out, invalid_weekly[j])
                j <- j + 1
            Base::rh_push_text(out, "]},\"validation\":{\"full_recompute_equivalent\":true,\"correction_invalidation\":\"partition-scoped\"},\"note\":\"aggregate rows are derived from the authoritative event set; corrections identify partitions for invalidation and never rewrite raw events\"}")
            Aggregates::rh_aggregate_preserve_history(prior, cache_out)
            Base::rh_push_text(cache_out, "R|")
            cache_out.extend(bytes_view(out))
            cache_out.push(10)
            0
