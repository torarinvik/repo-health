# rh_identity_publication.elisa — project-focused identity publication (M04-09).
#
# This module is deliberately separate from rh_identity_report. The identity
# report is an authorized/restricted evidence view and may contain source-native
# actor metadata; this public projection only publishes aggregate project
# context. It never emits actor ids, aliases, display names, source instances,
# cluster membership, or an individual ranking. Correction requests remain
# visible as workflow counts and retain a project-owner review channel.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_identity.elisa"

struct RhPublicCorrection:
    id_s: mutable i64
    id_e: mutable i64
    state: mutable u8

module IdentityPublication:
    private:
        def rh_ip_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_obj_get(nodes, texts, obj, key)

        def rh_ip_eq(texts: darray[u8]&, s: i64, e: i64, literal: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, literal)

        def rh_ip_span(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = IdentityPublication::rh_ip_get(nodes, texts, obj, key)
            return false if idx < 0 or nodes[idx.usize()].kind != Json::RH_JSON_STR
            node: Json::RhJsonNode = nodes[idx.usize()]
            return false if node.text_end <= node.text_start
            s_out[0] <- node.text_start
            e_out[0] <- node.text_end
            true

        def rh_ip_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            idx: i64 = IdentityPublication::rh_ip_get(nodes, texts, obj, key)
            Json::rh_json_int(nodes, raw, idx, ok_out)

        def rh_ip_link_state(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Identity::RH_LINK_PROPOSED if IdentityPublication::rh_ip_eq(texts, s, e, "proposed")
            return Identity::RH_LINK_ACCEPTED if IdentityPublication::rh_ip_eq(texts, s, e, "accepted")
            return Identity::RH_LINK_REJECTED if IdentityPublication::rh_ip_eq(texts, s, e, "rejected")
            return Identity::RH_LINK_REVOKED if IdentityPublication::rh_ip_eq(texts, s, e, "revoked")
            -1

        def rh_ip_kind(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Identity::RH_ACTOR_HUMAN if IdentityPublication::rh_ip_eq(texts, s, e, "human")
            return Identity::RH_ACTOR_BOT_KNOWN if IdentityPublication::rh_ip_eq(texts, s, e, "bot_known")
            return Identity::RH_ACTOR_SERVICE_KNOWN if IdentityPublication::rh_ip_eq(texts, s, e, "service_known")
            return Identity::RH_ACTOR_UNRESOLVED if IdentityPublication::rh_ip_eq(texts, s, e, "unresolved")
            -1

        def rh_ip_kind_source(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Identity::RH_ACTOR_SOURCE_PROVIDER if IdentityPublication::rh_ip_eq(texts, s, e, "provider")
            return Identity::RH_ACTOR_SOURCE_PROJECT if IdentityPublication::rh_ip_eq(texts, s, e, "project")
            return Identity::RH_ACTOR_SOURCE_OPERATOR if IdentityPublication::rh_ip_eq(texts, s, e, "operator")
            return Identity::RH_ACTOR_SOURCE_UNKNOWN if IdentityPublication::rh_ip_eq(texts, s, e, "unknown")
            -1

        def rh_ip_correction_state(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return 0 if IdentityPublication::rh_ip_eq(texts, s, e, "open")
            return 1 if IdentityPublication::rh_ip_eq(texts, s, e, "accepted")
            return 2 if IdentityPublication::rh_ip_eq(texts, s, e, "rejected")
            return 3 if IdentityPublication::rh_ip_eq(texts, s, e, "withdrawn")
            -1

        def rh_ip_push_unique_correction(corrections: mutable darray[RhPublicCorrection]&, texts: darray[u8]&, value: RhPublicCorrection) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < corrections.count |i: usize = 0, corrections, texts, value|:
                return false if Base::rh_bytes_equal_span(texts, corrections[i].id_s, corrections[i].id_e, texts, value.id_s, value.id_e)
                i <- i + 1
            corrections.push(value)
            true

        def rh_ip_cluster_sizes(cluster_map: darray[i64]&, sizes: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            roots: mutable darray[i64] = []
            while i < cluster_map.count |i: usize = 0, cluster_map, roots, sizes|:
                root: i64 = cluster_map[i]
                size_idx: mutable i64 = -1
                while j < roots.count |j: usize = 0, roots, sizes, root, size_idx|:
                    if roots[j] == root:
                        size_idx <- j.i64()
                        break
                    j <- j + 1
                if size_idx < 0:
                    roots.push(root)
                    sizes.push(1)
                else:
                    sizes[size_idx.usize()] <- sizes[size_idx.usize()] + 1
                i <- i + 1
            roots.count.i64()

        def rh_ip_emit_histogram(out: mutable darray[u8]&, sizes: darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
            emitted_sizes: mutable darray[i64] = []
            Base::rh_push_text(out, "[")
            while i < sizes.count |i: usize = 0, sizes, emitted_sizes, out|:
                size: mutable i64 = sizes[i]
                seen: bool =
                    while j < emitted_sizes.count |seen: bool = false, j: usize = 0, emitted_sizes, size| -> seen:
                        seen <- true if emitted_sizes[j] == size
                        j <- j + 1
                if not seen:
                    out.push(44) if emitted_sizes.count > 0
                    Base::rh_push_text(out, "{\"size\":")
                    Base::rh_push_decimal_i64(out, size)
                    count: i64 =
                        while k < sizes.count |count: i64 = 0, k: usize = 0, sizes, size| -> count:
                            count <- count + 1 if sizes[k] == size
                            k <- k + 1
                    Base::rh_push_text(out, ",\"clusters\":")
                    Base::rh_push_decimal_i64(out, count)
                    Base::rh_push_text(out, "}")
                    emitted_sizes.push(size)
                i <- i + 1
            Base::rh_push_text(out, "]")

    public:
        def rh_identity_publication_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ

            schema_s: mutable i64 = 0
            schema_e: mutable i64 = 0
            return -1 if not IdentityPublication::rh_ip_span(nodes, texts, root, "schema", &schema_s, &schema_e) or not IdentityPublication::rh_ip_eq(texts, schema_s, schema_e, "rh-identity-publication-input/1")
            project_s: mutable i64 = 0
            project_e: mutable i64 = 0
            scope_s: mutable i64 = 0
            scope_e: mutable i64 = 0
            return -1 if not IdentityPublication::rh_ip_span(nodes, texts, root, "project_id", &project_s, &project_e) or not IdentityPublication::rh_ip_span(nodes, texts, root, "publication_scope", &scope_s, &scope_e)
            return -1 if not IdentityPublication::rh_ip_eq(texts, scope_s, scope_e, "public")

            actor_ok: mutable i64 = 0
            actor_count: i64 = IdentityPublication::rh_ip_int(nodes, raw, texts, root, "actor_count", &actor_ok)
            return -1 if actor_ok == 0 or actor_count < 0 or actor_count > 1000000
            links_idx: i64 = IdentityPublication::rh_ip_get(nodes, texts, root, "links")
            return -1 if links_idx < 0 or nodes[links_idx.usize()].kind != Json::RH_JSON_ARR

            links: mutable darray[Identity::RhIdentityLink] = []
            while link >= 0 |link: i64 = nodes[links_idx.usize()].first_child, nodes, texts, raw, links, actor_count|:
                return -1 if nodes[link.usize()].kind != Json::RH_JSON_OBJ
                a_ok: mutable i64 = 0
                b_ok: mutable i64 = 0
                a: i64 = IdentityPublication::rh_ip_int(nodes, raw, texts, link, "a", &a_ok)
                b: i64 = IdentityPublication::rh_ip_int(nodes, raw, texts, link, "b", &b_ok)
                return -1 if a_ok == 0 or b_ok == 0 or a < 0 or b < 0 or a >= actor_count or b >= actor_count
                state_s: mutable i64 = 0
                state_e: mutable i64 = 0
                return -1 if not IdentityPublication::rh_ip_span(nodes, texts, link, "state", &state_s, &state_e)
                state: i64 = IdentityPublication::rh_ip_link_state(texts, state_s, state_e)
                return -1 if state < 0
                revision_ok: mutable i64 = 0
                revision_added: mutable i64 = IdentityPublication::rh_ip_int(nodes, raw, texts, link, "revision_added", &revision_ok)
                revision_added <- 0 if revision_ok == 0
                return -1 if revision_added < 0
                links.push(Identity::RhIdentityLink{a: a, b: b, state: state.u8(), revision_added: revision_added})
                link <- nodes[link.usize()].next_sibling

            kinds: mutable darray[u8] = []
            kinds_idx: i64 = IdentityPublication::rh_ip_get(nodes, texts, root, "actor_kinds")
            has_kinds: mutable bool = false
            kind_time_observed: mutable i64 = 0
            kind_time_unknown: mutable i64 = 0
            if kinds_idx >= 0:
                return -1 if nodes[kinds_idx.usize()].kind != Json::RH_JSON_ARR
                has_kinds <- true
                while kind >= 0 |kind: i64 = nodes[kinds_idx.usize()].first_child, nodes, texts, kinds|:
                    kind_s: mutable i64 = 0
                    kind_e: mutable i64 = 0
                    code: mutable i64 =
                        if IdentityPublication::rh_ip_span(nodes, texts, kind, "value", &kind_s, &kind_e):
                            IdentityPublication::rh_ip_kind(texts, kind_s, kind_e)
                        else:
                            # Accept the compact string form used by identity/1.
                            return -1 if not Json::rh_json_str_span(nodes, kind, &kind_s, &kind_e)
                            IdentityPublication::rh_ip_kind(texts, kind_s, kind_e)
                    return -1 if code < 0
                    kinds.push(code.u8())
                    kind <- nodes[kind.usize()].next_sibling
                return -1 if kinds.count.i64() != actor_count
            else:
                while i < actor_count |i: i64 = 0, kinds|:
                    kinds.push(Identity::RH_ACTOR_UNRESOLVED)
                    i <- i + 1

            kind_sources: mutable darray[u8] = []
            sources_idx: i64 = IdentityPublication::rh_ip_get(nodes, texts, root, "actor_kind_sources")
            if sources_idx >= 0:
                return -1 if not has_kinds or nodes[sources_idx.usize()].kind != Json::RH_JSON_ARR
                while source_node >= 0 |source_node: i64 = nodes[sources_idx.usize()].first_child, nodes, texts, kind_sources|:
                    source_s: mutable i64 = 0
                    source_e: mutable i64 = 0
                    return -1 if not Json::rh_json_str_span(nodes, source_node, &source_s, &source_e)
                    source_code: i64 = IdentityPublication::rh_ip_kind_source(texts, source_s, source_e)
                    return -1 if source_code < 0
                    kind_sources.push(source_code.u8())
                    source_node <- nodes[source_node.usize()].next_sibling
                return -1 if kind_sources.count.i64() != actor_count
            else:
                while kind_sources.count < actor_count.usize() |kind_sources, actor_count|:
                    kind_sources.push(Identity::RH_ACTOR_SOURCE_UNKNOWN)

            observed_idx: i64 = IdentityPublication::rh_ip_get(nodes, texts, root, "actor_kind_observed_at")
            if observed_idx >= 0:
                return -1 if not has_kinds or nodes[observed_idx.usize()].kind != Json::RH_JSON_ARR
                observed_count: mutable i64 = 0
                while observed_node >= 0 |observed_node: i64 = nodes[observed_idx.usize()].first_child, nodes, raw, observed_count, kind_time_observed, kind_time_unknown|:
                    if nodes[observed_node.usize()].kind == Json::RH_JSON_NULL:
                        kind_time_unknown <- kind_time_unknown + 1
                    else:
                        time_ok: mutable i64 = 0
                        observed_at: i64 = Json::rh_json_int(nodes, raw, observed_node, &time_ok)
                        return -1 if time_ok == 0 or observed_at < 0
                        kind_time_observed <- kind_time_observed + 1
                    observed_count <- observed_count + 1
                    observed_node <- nodes[observed_node.usize()].next_sibling
                return -1 if observed_count != actor_count
            else:
                while kind_time_unknown < actor_count |kind_time_unknown, actor_count|:
                    kind_time_unknown <- kind_time_unknown + 1

            corrections: mutable darray[RhPublicCorrection] = []
            corrections_idx: i64 = IdentityPublication::rh_ip_get(nodes, texts, root, "correction_requests")
            if corrections_idx >= 0:
                return -1 if nodes[corrections_idx.usize()].kind != Json::RH_JSON_ARR
                while correction >= 0 |correction: i64 = nodes[corrections_idx.usize()].first_child, nodes, texts, corrections|:
                    return -1 if corrections.count.i64() >= 100000 or nodes[correction.usize()].kind != Json::RH_JSON_OBJ
                    id_s: mutable i64 = 0
                    id_e: mutable i64 = 0
                    state_s: mutable i64 = 0
                    state_e: mutable i64 = 0
                    return -1 if not IdentityPublication::rh_ip_span(nodes, texts, correction, "id", &id_s, &id_e) or not IdentityPublication::rh_ip_span(nodes, texts, correction, "state", &state_s, &state_e)
                    state: i64 = IdentityPublication::rh_ip_correction_state(texts, state_s, state_e)
                    return -1 if state < 0
                    return -1 if not IdentityPublication::rh_ip_push_unique_correction(corrections, texts, RhPublicCorrection{id_s: id_s, id_e: id_e, state: state.u8()})
                    correction <- nodes[correction.usize()].next_sibling

            revision: i64 = Identity::rh_identity_revision(links)
            parent: mutable darray[i64] = []
            cluster_map: mutable darray[i64] = []
            cluster_count: i64 = Identity::rh_identity_clusters(links, actor_count, parent, cluster_map)
            sizes: mutable darray[i64] = []
            IdentityPublication::rh_ip_cluster_sizes(cluster_map, sizes)
            humans: mutable i64 = 0
            bots: mutable i64 = 0
            services: mutable i64 = 0
            unresolved: mutable i64 = 0
            Identity::rh_actor_kinds(kinds, &humans, &bots, &services, &unresolved)
            source_provider: mutable i64 = 0
            source_project: mutable i64 = 0
            source_operator: mutable i64 = 0
            source_unknown: mutable i64 = 0
            Identity::rh_actor_kind_sources(kind_sources, &source_provider, &source_project, &source_operator, &source_unknown)
            correction_counts: mutable darray[i64] = [0, 0, 0, 0]
            while i < corrections.count |i: usize = 0, corrections, correction_counts|:
                correction_counts[corrections[i].state.usize()] <- correction_counts[corrections[i].state.usize()] + 1
                i <- i + 1

            Base::rh_push_text(out, "{\"schema\":\"rh-identity-publication-result/1\",\"project_id\":\"")
            Base::rh_json_escape(out, texts, project_s.usize(), project_e.usize())
            Base::rh_push_text(out, "\",\"publication_scope\":\"project\",\"raw_identity\":\"restricted\",\"actor_count\":")
            Base::rh_push_decimal_i64(out, actor_count)
            Base::rh_push_text(out, ",\"identity_revision\":")
            Base::rh_push_decimal_i64(out, revision)
            Base::rh_push_text(out, ",\"cluster_count\":")
            Base::rh_push_decimal_i64(out, cluster_count)
            Base::rh_push_text(out, ",\"actor_kinds\":{\"human\":")
            Base::rh_push_decimal_i64(out, humans)
            Base::rh_push_text(out, ",\"bot_known\":")
            Base::rh_push_decimal_i64(out, bots)
            Base::rh_push_text(out, ",\"service_known\":")
            Base::rh_push_decimal_i64(out, services)
            Base::rh_push_text(out, ",\"unresolved\":")
            Base::rh_push_decimal_i64(out, unresolved)
            Base::rh_push_text(out, "},\"actor_kind_source_counts\":{\"provider\":")
            Base::rh_push_decimal_i64(out, source_provider)
            Base::rh_push_text(out, ",\"project\":")
            Base::rh_push_decimal_i64(out, source_project)
            Base::rh_push_text(out, ",\"operator\":")
            Base::rh_push_decimal_i64(out, source_operator)
            Base::rh_push_text(out, ",\"unknown\":")
            Base::rh_push_decimal_i64(out, source_unknown)
            Base::rh_push_text(out, "},\"actor_kind_observation_times\":{\"observed\":")
            Base::rh_push_decimal_i64(out, kind_time_observed)
            Base::rh_push_text(out, ",\"unknown\":")
            Base::rh_push_decimal_i64(out, kind_time_unknown)
            Base::rh_push_text(out, "},\"cluster_size_histogram\":")
            IdentityPublication::rh_ip_emit_histogram(out, sizes)
            Base::rh_push_text(out, ",\"corrections\":{\"open\":")
            Base::rh_push_decimal_i64(out, correction_counts[0])
            Base::rh_push_text(out, ",\"accepted\":")
            Base::rh_push_decimal_i64(out, correction_counts[1])
            Base::rh_push_text(out, ",\"rejected\":")
            Base::rh_push_decimal_i64(out, correction_counts[2])
            Base::rh_push_text(out, ",\"withdrawn\":")
            Base::rh_push_decimal_i64(out, correction_counts[3])
            Base::rh_push_text(out, "},\"correction_channel\":\"project-owner-review\",\"personal_leaderboard\":false,\"note\":\"project-scoped aggregates only; raw actor identities, aliases, display names, source-native ids, and cluster membership are restricted; correction requests remain reviewable\"}")
            0
