# rh_lease_report.elisa — M02-03 job-lease execution path.
#
# Applies an `rh-store-lease-input/1` op sequence to a real filesystem lease
# under `<root>/leases/<job>.lease` (+ `.log` attempt history). Fencing is
# enforced by the store: a stale worker (wrong token) cannot heartbeat or
# release/publish, an expired lease is reclaimable, and a terminal phase
# refuses further claims. Malformed input fails closed.

include "./rh_base.elisa"
include "./rh_store.elisa"

module LeaseReport:
    private:
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_lr_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_lr_phase(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return 0 if rh_lr_eq(texts, s, e, "queued")
            return 1 if rh_lr_eq(texts, s, e, "leased")
            return 2 if rh_lr_eq(texts, s, e, "running")
            return 3 if rh_lr_eq(texts, s, e, "succeeded")
            return 4 if rh_lr_eq(texts, s, e, "failed_terminal")
            return 5 if rh_lr_eq(texts, s, e, "canceled")
            -1

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_lr_phase_label(p: i64) -> u8&:
            return "queued" if p == 0
            return "leased" if p == 1
            return "running" if p == 2
            return "succeeded" if p == 3
            return "failed_terminal" if p == 4
            "canceled"

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_lr_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return false if idx < 0
            Json::rh_json_str_span(nodes, idx, s_out, e_out)

    public:
        def rh_lease_report(raw: darray[u8]&, root: cstr, job: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            rooti: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if rooti < 0 or nodes[rooti.usize()].kind != Json::RH_JSON_OBJ
            sspan: mutable i64 = 0
            espan: mutable i64 = 0
            sc: i64 = Json::rh_json_obj_get(nodes, texts, rooti, "schema")
            return -1 if sc < 0 or not Json::rh_json_str_span(nodes, sc, &sspan, &espan)
            return -1 if not rh_lr_eq(texts, sspan, espan, "rh-store-lease-input/1")
            os: mutable i64 = 0
            oe: mutable i64 = 0
            return -1 if not rh_lr_str(nodes, texts, rooti, "owner", &os, &oe)
            owner_buf: mutable darray[u8] = []
            while k < oe |k: i64 = os, texts, owner_buf, oe|:
                owner_buf.push(texts[k.usize()])
                k <- k + 1
            owner_buf.push(0)
            owner: cstr = (&owner_buf[0]).cast[cstr] can Unsafe.PointerCast
            # leases dir + paths
            ldir: mutable darray[u8] =
                ldir: mutable darray[u8] = []
                Base::rh_push_cstr(ldir, root)
                Base::rh_push_text(ldir, "/leases")
                ldir.push(0)
                ldir
            return -1 if Git::rh_ensure_dir((&ldir[0]).cast[cstr] can Unsafe.PointerCast) != 0
            lpath: mutable darray[u8] = []
            logpath: mutable darray[u8] = []
            Base::rh_push_cstr(lpath, root)
            Base::rh_push_text(lpath, "/leases/")
            Base::rh_push_cstr(lpath, job)
            Base::rh_push_text(lpath, ".lease")
            lpath.push(0)
            Base::rh_push_cstr(logpath, root)
            Base::rh_push_text(logpath, "/leases/")
            Base::rh_push_cstr(logpath, job)
            Base::rh_push_text(logpath, ".log")
            logpath.push(0)
            lp: cstr = (&lpath[0]).cast[cstr] can Unsafe.PointerCast
            lgp: cstr = (&logpath[0]).cast[cstr] can Unsafe.PointerCast
            ops_idx: i64 = Json::rh_json_obj_get(nodes, texts, rooti, "ops")
            return -1 if ops_idx < 0 or nodes[ops_idx.usize()].kind != Json::RH_JSON_ARR
            Base::rh_push_text(out, "{\"schema\":\"rh-store-lease-result/1\",\"job\":\"")
            Base::rh_push_cstr(out, job)
            Base::rh_push_text(out, "\",\"owner\":\"")
            Base::rh_push_cstr(out, owner)
            Base::rh_push_text(out, "\",\"ops\":[")
            arr: Json::RhJsonNode = nodes[ops_idx.usize()]
            while child >= 0 |child: i64 = arr.first_child, first: bool = true, token: i64 = 0, nodes, texts, raw, out, lp, lgp, owner|:
                return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                os2: mutable i64 = 0
                oe2: mutable i64 = 0
                return -1 if not rh_lr_str(nodes, texts, child, "op", &os2, &oe2)
                if not first:
                    out.push(44)
                first <- false
                now: mutable i64 = 0
                nok: mutable i64 = 0
                now <- Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, child, "now"), &nok)
                if nok == 0:
                    now <- 0
                if rh_lr_eq(texts, os2, oe2, "claim"):
                    got: i64 = |nodes, texts, now|
                        ttl: mutable i64 = 0
                        tok: mutable i64 = 0
                        ttl <- Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, child, "ttl"), &tok)
                        block_result: i64 = Store::rh_lease_acquire(lp, lgp, owner, now, ttl)
                        block_result
                    Base::rh_push_text(out, "{\"op\":\"claim\",\"outcome\":")
                    if got > 0:
                        token <- got
                        Base::rh_push_text(out, "\"claimed\",\"token\":")
                        Base::rh_push_decimal_i64(out, got)
                        Base::rh_push_text(out, ",\"phase\":\"leased\"")
                    elif got == -1:
                        Base::rh_push_text(out, "\"held\"")
                    else:
                        Base::rh_push_text(out, "\"terminal\"")
                    Base::rh_push_text(out, "}")
                elif rh_lr_eq(texts, os2, oe2, "heartbeat"):
                    ok: bool = Store::rh_lease_heartbeat(lp, token, owner, now)
                    Base::rh_push_text(out, "{\"op\":\"heartbeat\",\"applied\":")
                    if ok:
                        Base::rh_push_text(out, "true")
                    else:
                        Base::rh_push_text(out, "false")
                    Base::rh_push_text(out, ",\"token\":")
                    Base::rh_push_decimal_i64(out, token)
                    Base::rh_push_text(out, "}")
                elif rh_lr_eq(texts, os2, oe2, "release"):
                    phase: i64 = |nodes, texts|
                        ps: mutable i64 = 0
                        pe: mutable i64 = 0
                        return -1 if not rh_lr_str(nodes, texts, child, "phase", &ps, &pe)
                        block_result: i64 = rh_lr_phase(texts, ps, pe)
                        block_result
                    return -1 if phase < 0
                    ok2: bool = Store::rh_lease_release(lp, lgp, token, owner, now, phase)
                    Base::rh_push_text(out, "{\"op\":\"release\",\"applied\":")
                    if ok2:
                        Base::rh_push_text(out, "true")
                    else:
                        Base::rh_push_text(out, "false")
                    Base::rh_push_text(out, ",\"phase\":\"")
                    Base::rh_push_text(out, rh_lr_phase_label(phase))
                    Base::rh_push_text(out, "\"}")
                elif rh_lr_eq(texts, os2, oe2, "status"):
                    tk: mutable i64 = 0
                    ob: mutable darray[u8] = []
                    hb: mutable i64 = 0
                    kept: mutable i64 = 0
                    ph: mutable i64 = 0
                    have: bool = Store::rh_lease_read(lp, &tk, ob, &hb, &kept, &ph)
                    Base::rh_push_text(out, "{\"op\":\"status\",\"have\":")
                    if have:
                        Base::rh_push_text(out, "true")
                    else:
                        Base::rh_push_text(out, "false")
                    if have:
                        Base::rh_push_text(out, ",\"token\":")
                        Base::rh_push_decimal_i64(out, tk)
                        Base::rh_push_text(out, ",\"heartbeat\":")
                        Base::rh_push_decimal_i64(out, hb)
                        Base::rh_push_text(out, ",\"ttl\":")
                        Base::rh_push_decimal_i64(out, kept)
                        Base::rh_push_text(out, ",\"phase\":\"")
                        Base::rh_push_text(out, rh_lr_phase_label(ph))
                        Base::rh_push_text(out, "\"")
                    Base::rh_push_text(out, "}")
                else:
                    return -1
                child <- nodes[child.usize()].next_sibling
            # final status
            fmtk: mutable i64 = 0
            fob: mutable darray[u8] = []
            fhb: mutable i64 = 0
            fttl: mutable i64 = 0
            fph: mutable i64 = 0
            havef: bool = Store::rh_lease_read(lp, &fmtk, fob, &fhb, &fttl, &fph)
            Base::rh_push_text(out, "],\"final\":{\"have\":")
            if havef:
                Base::rh_push_text(out, "true")
            else:
                Base::rh_push_text(out, "false")
            if havef:
                Base::rh_push_text(out, ",\"token\":")
                Base::rh_push_decimal_i64(out, fmtk)
                Base::rh_push_text(out, ",\"heartbeat\":")
                Base::rh_push_decimal_i64(out, fhb)
                Base::rh_push_text(out, ",\"ttl\":")
                Base::rh_push_decimal_i64(out, fttl)
                Base::rh_push_text(out, ",\"phase\":\"")
                Base::rh_push_text(out, rh_lr_phase_label(fph))
                Base::rh_push_text(out, "\"")
            Base::rh_push_text(out, "},\"note\":\"a stale worker (wrong fencing token) cannot heartbeat or release; an expired lease is reclaimable; a terminal phase refuses further claims\"}")
            0
