# rh_sha256.elisa — SHA-256 and HMAC-SHA256 (M07-04 publication integrity).
#
# The store's FNV-1a digest detects accidental corruption; it is NOT a
# cryptographic hash and must never be used to claim authenticity. This
# module implements SHA-256 (FIPS 180-4) and HMAC-SHA256 (RFC 2104) so a
# release can be signed with a key that is held separately from the worker
# and verified by anyone with the key. Verification establishes integrity
# and key possession, NOT that the content is correct or safe (S011).
#
# Correctness is pinned to published test vectors in test_m07_sha.elisa.
include "./rh_base.elisa"

# Right rotation of a 32-bit word.
def rh_rotr(x: u32, n: u32) -> u32:
    (x >> n) | (x << (32 - n))

# (private to this file)
def rh_be32(b0: u8, b1: u8, b2: u8, b3: u8) -> u32:
    (b0.u32() << 24) | (b1.u32() << 16) | (b2.u32() << 8) | b3.u32()

# (private to this file)
def rh_h0(i: i64) -> u32:
    return 0x6a09e667 if i == 0
    return 0xbb67ae85 if i == 1
    return 0x3c6ef372 if i == 2
    return 0xa54ff53a if i == 3
    return 0x510e527f if i == 4
    return 0x9b05688c if i == 5
    return 0x1f83d9ab if i == 6
    0x5be0cd19

# (private to this file)
def rh_k(i: i64) -> u32:
    return 0x428a2f98 if i == 0
    return 0x71374491 if i == 1
    return 0xb5c0fbcf if i == 2
    return 0xe9b5dba5 if i == 3
    return 0x3956c25b if i == 4
    return 0x59f111f1 if i == 5
    return 0x923f82a4 if i == 6
    return 0xab1c5ed5 if i == 7
    return 0xd807aa98 if i == 8
    return 0x12835b01 if i == 9
    return 0x243185be if i == 10
    return 0x550c7dc3 if i == 11
    return 0x72be5d74 if i == 12
    return 0x80deb1fe if i == 13
    return 0x9bdc06a7 if i == 14
    return 0xc19bf174 if i == 15
    return 0xe49b69c1 if i == 16
    return 0xefbe4786 if i == 17
    return 0x0fc19dc6 if i == 18
    return 0x240ca1cc if i == 19
    return 0x2de92c6f if i == 20
    return 0x4a7484aa if i == 21
    return 0x5cb0a9dc if i == 22
    return 0x76f988da if i == 23
    return 0x983e5152 if i == 24
    return 0xa831c66d if i == 25
    return 0xb00327c8 if i == 26
    return 0xbf597fc7 if i == 27
    return 0xc6e00bf3 if i == 28
    return 0xd5a79147 if i == 29
    return 0x06ca6351 if i == 30
    return 0x14292967 if i == 31
    return 0x27b70a85 if i == 32
    return 0x2e1b2138 if i == 33
    return 0x4d2c6dfc if i == 34
    return 0x53380d13 if i == 35
    return 0x650a7354 if i == 36
    return 0x766a0abb if i == 37
    return 0x81c2c92e if i == 38
    return 0x92722c85 if i == 39
    return 0xa2bfe8a1 if i == 40
    return 0xa81a664b if i == 41
    return 0xc24b8b70 if i == 42
    return 0xc76c51a3 if i == 43
    return 0xd192e819 if i == 44
    return 0xd6990624 if i == 45
    return 0xf40e3585 if i == 46
    return 0x106aa070 if i == 47
    return 0x19a4c116 if i == 48
    return 0x1e376c08 if i == 49
    return 0x2748774c if i == 50
    return 0x34b0bcb5 if i == 51
    return 0x391c0cb3 if i == 52
    return 0x4ed8aa4a if i == 53
    return 0x5b9cca4f if i == 54
    return 0x682e6ff3 if i == 55
    return 0x748f82ee if i == 56
    return 0x78a5636f if i == 57
    return 0x84c87814 if i == 58
    return 0x8cc70208 if i == 59
    return 0x90befffa if i == 60
    return 0xa4506ceb if i == 61
    return 0xbef9a3f7 if i == 62
    0xc67178f2

# Compress one 64-byte block into the 8-word state h (8 u32 entries).
def rh_sha256_block(block: darray[u8]&, start: usize, h: mutable darray[u32]&) -> void can[Memory.Allocate, Abort.Panic]:
    w: mutable darray[u32] = []
    while t < 64 |t: i64 = 0, w, block, start|:
        if t < 16:
            b0: u8 = block[start + (t * 4).usize()]
            b1: u8 = block[start + (t * 4 + 1).usize()]
            b2: u8 = block[start + (t * 4 + 2).usize()]
            b3: u8 = block[start + (t * 4 + 3).usize()]
            w.push(rh_be32(b0, b1, b2, b3))
        else:
            x: u32 = w[(t - 15).usize()]
            y: u32 = w[(t - 2).usize()]
            s0: u32 = rh_rotr(x, 7) ^ rh_rotr(x, 18) ^ (x >> 3)
            s1: u32 = rh_rotr(y, 17) ^ rh_rotr(y, 19) ^ (y >> 10)
            w16: u32 = w[(t - 16).usize()]
            w7: u32 = w[(t - 7).usize()]
            w.push(w16 + s0 + w7 + s1)
        t <- t + 1
    a, b, c, d, e, f, g, hh =
        while t2 < 64 |a: u32 = h[0], b: u32 = h[1], c: u32 = h[2], d: u32 = h[3], e: u32 = h[4], f: u32 = h[5], g: u32 = h[6], hh: u32 = h[7], t2: i64 = 0, w| -> a, b, c, d, e, f, g, hh:
            s1: u32 = rh_rotr(e, 6) ^ rh_rotr(e, 11) ^ rh_rotr(e, 25)
            ch: u32 =
                ne: u32 = e ^ 4294967295
                (e & f) ^ (ne & g)
            ki: u32 = rh_k(t2)
            temp1: u32 =
                wt: u32 = w[t2.usize()]
                hh + s1 + ch + ki + wt
            s0: u32 = rh_rotr(a, 2) ^ rh_rotr(a, 13) ^ rh_rotr(a, 22)
            temp2: u32 =
                maj: u32 = (a & b) ^ (a & c) ^ (b & c)
                s0 + maj
            hh <- g
            g <- f
            f <- e
            e <- d + temp1
            d <- c
            c <- b
            b <- a
            a <- temp1 + temp2
            t2 <- t2 + 1
    h[0] <- h[0] + a
    h[1] <- h[1] + b
    h[2] <- h[2] + c
    h[3] <- h[3] + d
    h[4] <- h[4] + e
    h[5] <- h[5] + f
    h[6] <- h[6] + g
    h[7] <- h[7] + hh
    return

# Append a big-endian u32 word as four bytes.
# (private to this file)
def rh_push_be32(out: mutable darray[u8]&, v: u32) -> void:
    out.push(((v >> 24) & 255).u8())
    out.push(((v >> 16) & 255).u8())
    out.push(((v >> 8) & 255).u8())
    out.push((v & 255).u8())

# SHA-256 of data; 64 lowercase hex characters appended to out_hex.
def rh_sha256(data: darray[u8]&, out_hex: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    # padded copy: data || 0x80 || 0x00.. || 64-bit bit length
    buf: mutable darray[u8] =
        buf: mutable darray[u8] = []
        buf.extend(bytes_view(data))
        buf.push(128)
        buf
    while buf.count % 64 != 56 |buf|:
        buf.push(0)
    bits: u64 = data.count.u64() * 8
    while k >= 0 |k: i64 = 7, buf, bits|:
        sh: u64 = (k * 8).u64()
        buf.push(((bits >> sh) & 255).u8())
        k <- k - 1
    h: mutable darray[u32] = []
    while j < 8 |j: i64 = 0, h|:
        h.push(rh_h0(j))
        j <- j + 1
    while off < buf.count |off: usize = 0, buf, h|:
        rh_sha256_block(buf, off, h)
        off <- off + 64
    while z < 8 |z: i64 = 0, h, out_hex|:
        v: u32 = h[z.usize()]
        rh_push_hex_u32(out_hex, v)
        z <- z + 1
    return

# (private to this file)
def rh_push_hex_u32(out: mutable darray[u8]&, v: u32) -> void:
    while nibbles >= 0 |nibbles: i64 = 7, out, v|:
        n: u32 =
            sh: u32 = (nibbles * 4).u32()
            (v >> sh) & 15
        if n < 10:
            out.push((48 + n).u8())
        else:
            out.push((87 + n).u8())
        nibbles <- nibbles - 1

# HMAC-SHA256 (RFC 2104). key and msg are byte strings; out_hex gets 64 hex.
def rh_hmac_sha256(key: darray[u8]&, msg: darray[u8]&, out_hex: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    blk: i64 = 64
    kpad: mutable darray[u8] = []
    if key.count.i64() > blk:
        kh: mutable darray[u8] = []
        rh_sha256(key, kh)
        # hex key must be reduced to its 32 raw bytes: decode
        raw: mutable darray[u8] = []
        rh_hex_decode(kh, raw)
        kpad.extend(bytes_view(raw))
    else:
        kpad.extend(bytes_view(key))
    while kpad.count.i64() < blk |kpad|:
        kpad.push(0)
    inner: mutable darray[u8] = []
    while o < blk |o: usize = 0, kpad, inner|:
        v: u8 = kpad[o]
        inner.push(v ^ 54)
        o <- o + 1
    inner.extend(bytes_view(msg))
    inner_hash: mutable darray[u8] = []
    rh_sha256(inner, inner_hash)
    ih: mutable darray[u8] = []
    rh_hex_decode(inner_hash, ih)
    outer: mutable darray[u8] = []
    while p < blk |p: usize = 0, kpad, outer|:
        v2: u8 = kpad[p]
        outer.push(v2 ^ 92)
        p <- p + 1
    outer.extend(bytes_view(ih))
    rh_sha256(outer, out_hex)
    return

# Decode a lowercase-hex string to bytes, appended to out.
# (private to this file)
def rh_hex_decode(hex: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    while i + 1 < hex.count |i: usize = 0, hex, out|:
        hi: u8 = hex[i]
        v: u8 =
            lo: u8 = hex[i + 1]
            (rh_hex_nibble(hi) << 4) | rh_hex_nibble(lo)
        out.push(v)
        i <- i + 2
    return

# (private to this file)
def rh_hex_nibble(c: u8) -> u8:
    return c - 48 if c >= 48 and c <= 57
    return c - 87 if c >= 97 and c <= 102
    return c - 55 if c >= 65 and c <= 70
    0

# Constant-time-ish comparison of two hex strings of equal length. Length
# mismatch is false. Not a timing-attack guarantee in a scripting runtime,
# but does not early-exit on the first differing byte.
def rh_hex_eq(a: darray[u8]&, b: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if a.count != b.count or a.count == 0
    diff: u8 =
        while i < a.count |diff: u8 = 0, i: usize = 0| -> diff:
            diff <- diff | (a[i] ^ b[i])
            i <- i + 1
    diff == 0

# Verify `sig_hex` is HMAC-SHA256(key, msg).
def rh_hmac_verify(key: darray[u8]&, msg: darray[u8]&, sig_hex: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    want: mutable darray[u8] = []
    rh_hmac_sha256(key, msg, want)
    rh_hex_eq(want, sig_hex)
