# rh_resolution.elisa — package identity vs resolution-instance adapter
# (M03-11). A package/version label is stable within an ecosystem, while a
# provider node ID is meaningful only inside one graph snapshot and context.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_store.elisa"

const RH_RESOLUTION_MAX_NODES: i64 = 10000

module Resolution:
    private:
        def rh_resolution_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if obj < 0 or nodes[obj.usize()].kind != Json::RH_JSON_OBJ
            want: usize = strlen(key)
            while child >= 0 |child: i64 = nodes[obj.usize()].first_child|:
                kn: Json::RhJsonNode = nodes[child.usize()]
                value: i64 = kn.next_sibling
                if kn.kind == Json::RH_JSON_STR and value >= 0 and kn.text_end - kn.text_start == want.i64():
                    texts_loop: mutable darray[u8]& = texts
                    kn_loop: mutable Json::RhJsonNode = kn
                    key_loop: mutable u8& = key
                    want_loop: mutable usize = want
                    same: bool =
                        while k < want_loop |same: bool = true, k: usize = 0, texts_loop, kn_loop, key_loop, want_loop| -> same:
                            if texts_loop[(kn_loop.text_start + k.i64()).usize()] != key_loop[k]:
                                same <- false
                            k <- k + 1
                    return value if same
                child <- nodes[value.usize()].next_sibling if value >= 0 else -1
            -1

        def rh_resolution_span_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e < s or e - s != strlen(lit).i64()
            while i < e - s |i: i64 = 0, texts, s, lit|:
                return false if texts[(s + i).usize()] != lit[i.usize()]
                i <- i + 1
            true

        def rh_resolution_emit_span(out: mutable darray[u8]&, texts: darray[u8]&, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_json_escape(out, texts, s.usize(), e.usize())

        def rh_resolution_required_span(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Resolution::rh_resolution_get(nodes, texts, obj, key)
            return false if idx < 0
            n: Json::RhJsonNode = nodes[idx.usize()]
            return false if n.kind != Json::RH_JSON_STR or n.text_end <= n.text_start
            s_out[0] <- n.text_start
            e_out[0] <- n.text_end
            true

        def rh_resolution_optional_span(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&, present_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            present_out[0] <- 0
            idx: i64 = Resolution::rh_resolution_get(nodes, texts, obj, key)
            return true if idx < 0 or nodes[idx.usize()].kind == Json::RH_JSON_NULL
            return false if not Json::rh_json_str_span(nodes, idx, &s_out[0], &e_out[0])
            present_out[0] <- 1
            true

        def rh_resolution_bool(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, raw: darray[u8]&, obj: i64, key: u8&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Resolution::rh_resolution_get(nodes, texts, obj, key)
            return false if idx < 0 or nodes[idx.usize()].kind != Json::RH_JSON_BOOL
            Base::rh_push_text(out, "true") if Json::rh_json_is_true(nodes, raw, idx)
            Base::rh_push_text(out, "false") if not Json::rh_json_is_true(nodes, raw, idx)
            true

    public:
        # Convert one rh-dep-graph/1 document into explicit resolution
        # instances. The input bytes themselves identify the graph snapshot;
        # no lexical key order or resolver guess is introduced.
        def rh_resolution_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_s: mutable i64 = -1
            schema_e: mutable i64 = -1
            return -1 if not Resolution::rh_resolution_required_span(nodes, texts, root, "schema", &schema_s, &schema_e)
            return -1 if not Resolution::rh_resolution_span_eq(texts, schema_s, schema_e, "rh-dep-graph/1")
            eco_s: mutable i64 = -1
            eco_e: mutable i64 = -1
            return -1 if not Resolution::rh_resolution_required_span(nodes, texts, root, "ecosystem", &eco_s, &eco_e)
            node_idx: i64 = Resolution::rh_resolution_get(nodes, texts, root, "nodes")
            return -1 if node_idx < 0 or nodes[node_idx.usize()].kind != Json::RH_JSON_ARR
            node_count: i64 = nodes[node_idx.usize()].child_count
            return -1 if node_count < 0 or node_count > RH_RESOLUTION_MAX_NODES
            edges_idx: i64 = Resolution::rh_resolution_get(nodes, texts, root, "edges")
            return -1 if edges_idx < 0 or nodes[edges_idx.usize()].kind != Json::RH_JSON_ARR
            edge_count: i64 = nodes[edges_idx.usize()].child_count
            return -1 if edge_count < 0 or edge_count > RH_RESOLUTION_MAX_NODES
            unresolved_idx: i64 = Resolution::rh_resolution_get(nodes, texts, root, "unresolved")
            unresolved_count: mutable i64 = 0
            if unresolved_idx >= 0:
                return -1 if nodes[unresolved_idx.usize()].kind != Json::RH_JSON_ARR
                unresolved_count <- nodes[unresolved_idx.usize()].child_count
            provider_context_idx: i64 = Resolution::rh_resolution_get(nodes, texts, root, "provider_graph_context")
            provider_context_present: bool = provider_context_idx >= 0
            provider_env_s: mutable i64 = 0
            provider_env_e: mutable i64 = 0
            provider_reason_s: mutable i64 = 0
            provider_reason_e: mutable i64 = 0
            provider_nodes: mutable i64 = 0
            provider_unresolved: mutable i64 = 0
            if provider_context_present:
                return -1 if nodes[provider_context_idx.usize()].kind != Json::RH_JSON_OBJ
                return -1 if not Resolution::rh_resolution_required_span(nodes, texts, provider_context_idx, "environment", &provider_env_s, &provider_env_e) or not Resolution::rh_resolution_required_span(nodes, texts, provider_context_idx, "difference_reason", &provider_reason_s, &provider_reason_e)
                return -1 if provider_env_s == provider_env_e or provider_reason_s == provider_reason_e
                provider_nodes_ok: mutable i64 = 0
                provider_nodes <- Json::rh_json_int(nodes, raw, Resolution::rh_resolution_get(nodes, texts, provider_context_idx, "node_count"), &provider_nodes_ok)
                provider_unresolved_ok: mutable i64 = 0
                provider_unresolved <- Json::rh_json_int(nodes, raw, Resolution::rh_resolution_get(nodes, texts, provider_context_idx, "unresolved_count"), &provider_unresolved_ok)
                return -1 if provider_nodes_ok == 0 or provider_unresolved_ok == 0 or provider_nodes < 0 or provider_unresolved < 0
            digest: mutable darray[u8] = []
            Store::rh_digest_hex(raw, digest)
            Base::rh_push_text(out, "{\"schema\":\"rh-resolution-instance/1\",\"graph_snapshot\":{\"digest\":\"")
            out.extend(bytes_view(digest))
            Base::rh_push_text(out, "\",\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"")
            Resolution::rh_resolution_emit_span(out, texts, eco_s, eco_e)
            Base::rh_push_text(out, "\"},\"unresolved_count\":")
            Base::rh_push_decimal_i64(out, unresolved_count)
            Base::rh_push_text(out, ",\"instances\":[")
            while child >= 0 |child: i64 = nodes[node_idx.usize()].first_child, nodes, texts, raw, out|:
                return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                ok_id: mutable i64 = 0
                provider_id: i64 = Json::rh_json_int(nodes, raw, Resolution::rh_resolution_get(nodes, texts, child, "id"), &ok_id)
                return -1 if ok_id == 0 or provider_id < 0
                name_s: mutable i64 = -1
                name_e: mutable i64 = -1
                return -1 if not Resolution::rh_resolution_required_span(nodes, texts, child, "name", &name_s, &name_e)
                version_idx: i64 = Resolution::rh_resolution_get(nodes, texts, child, "version")
                version_s: mutable i64 = -1
                version_e: mutable i64 = -1
                has_version: bool = version_idx >= 0 and Json::rh_json_str_span(nodes, version_idx, &version_s, &version_e)
                if version_idx >= 0 and not has_version and nodes[version_idx.usize()].kind != Json::RH_JSON_NULL:
                    return -1
                source_s: mutable i64 = -1
                source_e: mutable i64 = -1
                return -1 if not Resolution::rh_resolution_required_span(nodes, texts, child, "source", &source_s, &source_e)
                if child != nodes[node_idx.usize()].first_child:
                    out.push(44)
                Base::rh_push_text(out, "{\"package_identity\":{\"ecosystem\":\"")
                Resolution::rh_resolution_emit_span(out, texts, eco_s, eco_e)
                Base::rh_push_text(out, "\",\"name\":\"")
                Resolution::rh_resolution_emit_span(out, texts, name_s, name_e)
                Base::rh_push_text(out, "\",\"version\":")
                if has_version:
                    out.push(34)
                    Resolution::rh_resolution_emit_span(out, texts, version_s, version_e)
                    out.push(34)
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, "},\"resolution_instance\":{\"graph_digest\":\"")
                out.extend(bytes_view(digest))
                Base::rh_push_text(out, "\",\"provider_node_id\":")
                Base::rh_push_decimal_i64(out, provider_id)
                Base::rh_push_text(out, ",\"context\":\"lockfile\",\"status\":\"resolved\"},\"source\":\"")
                Resolution::rh_resolution_emit_span(out, texts, source_s, source_e)
                Base::rh_push_text(out, "\",\"source_attestation\":{\"state\":\"observed\",\"value\":\"")
                Resolution::rh_resolution_emit_span(out, texts, source_s, source_e)
                Base::rh_push_text(out, "\"},\"dev\":")
                return -1 if not Resolution::rh_resolution_bool(nodes, texts, raw, child, "dev", out)
                Base::rh_push_text(out, ",\"optional\":")
                return -1 if not Resolution::rh_resolution_bool(nodes, texts, raw, child, "optional", out)
                Base::rh_push_text(out, "}")
                child <- nodes[child.usize()].next_sibling
            Base::rh_push_text(out, "]")
            if provider_context_present:
                Base::rh_push_text(out, ",\"provider_graph_context\":{\"environment\":\"")
                Resolution::rh_resolution_emit_span(out, texts, provider_env_s, provider_env_e)
                Base::rh_push_text(out, "\",\"node_count\":")
                Base::rh_push_decimal_i64(out, provider_nodes)
                Base::rh_push_text(out, ",\"unresolved_count\":")
                Base::rh_push_decimal_i64(out, provider_unresolved)
                Base::rh_push_text(out, ",\"difference_reason\":\"")
                Resolution::rh_resolution_emit_span(out, texts, provider_reason_s, provider_reason_e)
                Base::rh_push_text(out, "\"}")
            Base::rh_push_text(out, ",\"unresolved\":[")
            while unresolved >= 0 |unresolved: i64 = nodes[unresolved_idx.usize()].first_child if unresolved_idx >= 0 else -1, nodes, texts, raw, out|:
                return -1 if nodes[unresolved.usize()].kind != Json::RH_JSON_OBJ
                unresolved_ok: mutable i64 = 0
                unresolved_from: i64 = Json::rh_json_int(nodes, raw, Resolution::rh_resolution_get(nodes, texts, unresolved, "from"), &unresolved_ok)
                return -1 if unresolved_ok == 0 or unresolved_from < 0 or unresolved_from >= node_count
                unresolved_name_s: mutable i64 = -1
                unresolved_name_e: mutable i64 = -1
                return -1 if not Resolution::rh_resolution_required_span(nodes, texts, unresolved, "name", &unresolved_name_s, &unresolved_name_e)
                unresolved_req_s: mutable i64 = -1
                unresolved_req_e: mutable i64 = -1
                unresolved_req_present: mutable i64 = 0
                return -1 if not Resolution::rh_resolution_optional_span(nodes, texts, unresolved, "requirement", &unresolved_req_s, &unresolved_req_e, &unresolved_req_present)
                unresolved_reason_s: mutable i64 = -1
                unresolved_reason_e: mutable i64 = -1
                return -1 if not Resolution::rh_resolution_required_span(nodes, texts, unresolved, "reason", &unresolved_reason_s, &unresolved_reason_e)
                if unresolved != nodes[unresolved_idx.usize()].first_child:
                    out.push(44)
                Base::rh_push_text(out, "{\"from\":")
                Base::rh_push_decimal_i64(out, unresolved_from)
                Base::rh_push_text(out, ",\"name\":\"")
                Resolution::rh_resolution_emit_span(out, texts, unresolved_name_s, unresolved_name_e)
                Base::rh_push_text(out, "\",\"requirement\":")
                if unresolved_req_present == 1:
                    out.push(34)
                    Resolution::rh_resolution_emit_span(out, texts, unresolved_req_s, unresolved_req_e)
                    out.push(34)
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"reason\":\"")
                Resolution::rh_resolution_emit_span(out, texts, unresolved_reason_s, unresolved_reason_e)
                Base::rh_push_text(out, "\"}")
                unresolved <- nodes[unresolved.usize()].next_sibling
            Base::rh_push_text(out, "],\"edges\":[")
            while edge >= 0 |edge: i64 = nodes[edges_idx.usize()].first_child, nodes, texts, raw, out|:
                return -1 if nodes[edge.usize()].kind != Json::RH_JSON_OBJ
                from_ok: mutable i64 = 0
                to_ok: mutable i64 = 0
                from_id: i64 = Json::rh_json_int(nodes, raw, Resolution::rh_resolution_get(nodes, texts, edge, "from"), &from_ok)
                to_id: i64 = Json::rh_json_int(nodes, raw, Resolution::rh_resolution_get(nodes, texts, edge, "to"), &to_ok)
                return -1 if from_ok == 0 or to_ok == 0 or from_id < 0 or to_id < 0 or from_id >= node_count or to_id >= node_count
                scope_s: mutable i64 = -1
                scope_e: mutable i64 = -1
                return -1 if not Resolution::rh_resolution_required_span(nodes, texts, edge, "scope", &scope_s, &scope_e)
                if edge != nodes[edges_idx.usize()].first_child:
                    out.push(44)
                Base::rh_push_text(out, "{\"from\":")
                Base::rh_push_decimal_i64(out, from_id)
                Base::rh_push_text(out, ",\"to\":")
                Base::rh_push_decimal_i64(out, to_id)
                Base::rh_push_text(out, ",\"relation\":\"")
                Resolution::rh_resolution_emit_span(out, texts, scope_s, scope_e)
                Base::rh_push_text(out, "\"}")
                edge <- nodes[edge.usize()].next_sibling
            Base::rh_push_text(out, "],\"note\":\"package identity is separate from graph-local resolution instance; provider node ids are meaningful only within this snapshot and context; provider graph differences retain their environment and explanation; source attestations and relation scopes are preserved; unresolved requirements remain outside instances\"}")
            0
