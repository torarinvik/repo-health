# rh_registry.elisa — metric registry + lint (M00-05).
#
# The M01 foundational subset plus one deliberately distinct second
# version and the M04/M09 dependency-facing metrics: identity is
# (key, version), never key alone (R023). Entries 0-9 and 11-15 are
# `implemented`; entry 10 is the same key at 2.0.0 with a *different*
# denominator rule and status `prototype`, proving a denominator change is
# a new definition rather than a silent redefinition of the old one.
# metrics/definitions/*.json mirror this table and the harness diffs them.
# Lint rejects duplicate key/version pairs, unknown entity kinds, and empty
# versions.


include "./rh_base.elisa"

const RH_ENT_PROJECT: u8 = 0
const RH_ENT_REPOSITORY: u8 = 1
const RH_ENT_PACKAGE: u8 = 2
const RH_ENT_ARTIFACT: u8 = 3

def rh_reg_count() -> i64:
    19

# Implemented (published) entry count; the rest are prototype/experimental.
def rh_reg_implemented_count() -> i64:
    18

def rh_reg_key(index: i64) -> u8&:
    return "history.commit_count" if index == 0
    return "history.reachable_revisions" if index == 1
    return "history.coverage_state" if index == 2
    return "activity.commit_event_count" if index == 3
    return "activity.active_complete_months" if index == 4
    return "contributors.raw_identity_count" if index == 5
    return "contributors.automation_known" if index == 6
    return "coverage.window_completeness" if index == 7
    return "freshness.evidence_max_age_hours" if index == 8
    return "source.manifest_presence" if index == 9
    return "coverage.window_completeness" if index == 10
    return "persistence.retained_90d" if index == 11
    return "dependencies.unsupported_range_count" if index == 12
    return "concentration.change_hhi" if index == 13
    return "concentration.change_effective_actor_count" if index == 14
    return "concentration.change_absence_factor_50" if index == 15
    return "concentration.change_top1_share" if index == 16
    return "concentration.change_gini" if index == 17
    return "succession.handover_overlap_months" if index == 18
    "unknown-metric"

def rh_reg_version(index: i64) -> u8&:
    return "2.0.0" if index == 10
    return "1.0.0" if index >= 0 and index < 10
    return "1.0.0" if index >= 11 and index <= 18
    ""

# Lifecycle status per entry (M00-05). Honest: entries 0-9 and 11-15 are
# published; entry 10 is a prototype and must not be presented as done.
def rh_reg_status(index: i64) -> u8&:
    return "implemented" if index >= 0 and index < 10
    return "prototype" if index == 10
    return "implemented" if index >= 11 and index <= 18
    ""

def rh_reg_unit(index: i64) -> u8&:
    return "enum" if index == 2
    return "ratio" if index == 7 or index == 10
    return "ratio" if index >= 11 and index <= 14
    return "ratio" if index == 16 or index == 17
    return "hours" if index == 8
    return "enum" if index == 9
    return "count" if (index >= 0 and index < 10) or index == 10 or index == 12 or index == 15 or index == 18
    ""

def rh_reg_entity(index: i64) -> u8:
    return RH_ENT_PROJECT if (index >= 0 and index < 10) or index == 10 or index == 11 or index == 12 or (index >= 13 and index <= 18)
    255

# Denominator rule: 0 = none (count/enum), 1 = ratio with explicit
# denominator (v1: eligible complete months observed), 2 = ratio against
# the full eligible window including not-observed months (v2), 3 = ratio
# over an eligible-actor population with a complete retention window,
# 4 = exact rational over a population denominator (actor event counts).
# A rule change is a new version: a v2 result must never be compared with or
# overwrite a v1 result (F038).
def rh_reg_denom_rule(index: i64) -> u8:
    return 1 if index == 7
    return 2 if index == 10
    return 3 if index == 11
    return 4 if index == 13 or index == 14 or index == 16 or index == 17
    0

# Linear find by key; -1 when absent.
def rh_reg_find(key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
    while i < rh_reg_count() |i: i64 = 0, key|:
        return i if rh_streq(rh_reg_key(i), key) and rh_streq(rh_reg_status(i), "implemented")
        i <- i + 1
    -1

# Identity is (key, version). Returns the entry index or -1. This is how a
# caller must resolve a definition before trusting its denominator rule.
def rh_reg_find_versioned(key: u8&, version: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
    while i < rh_reg_count() |i: i64 = 0, key, version|:
        return i if rh_streq(rh_reg_key(i), key) and rh_streq(rh_reg_version(i), version)
        i <- i + 1
    -1

# Denominator rule for an exact (key, version); -1 when the pair is absent
# so a caller cannot silently fall back to a different version's rule
# (an unknown version has no fallback to a default).
def rh_reg_denom_rule_for(key: u8&, version: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
    idx: i64 = rh_reg_find_versioned(key, version)
    return -1 if idx < 0
    rh_reg_denom_rule(idx).i64()

# Lint: 0 = clean. Otherwise the count of violations found
# (duplicate key/version, unknown entity, empty version/unit).
def rh_reg_lint() -> i64 can[Memory.Allocate, Abort.Panic]:
    while i < rh_reg_count() |violations: i64 = 0, i: i64 = 0| -> violations:
        if rh_streq(rh_reg_version(i), ""):
            violations <- violations + 1
        if rh_streq(rh_reg_unit(i), ""):
            violations <- violations + 1
        if rh_reg_entity(i) > RH_ENT_ARTIFACT:
            violations <- violations + 1
        while j < rh_reg_count() |j: i64 = i + 1, i, violations|:
            if rh_streq(rh_reg_key(i), rh_reg_key(j)):
                same_version: bool = rh_streq(rh_reg_version(i), rh_reg_version(j))
                violations <- violations + 1 if same_version
            j <- j + 1
        i <- i + 1
