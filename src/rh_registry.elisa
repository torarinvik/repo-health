        def rh_reg_version(index: i64) -> u8&:
            return "2.0.0" if index == 10
            return "1.0.0" if index >= 0 and index < 10
            return "1.0.0" if index >= 11 and index <= 135
            ""

        # Lifecycle status per entry (M00-05). Every registered definition has a
        # real execution path; experimental definitions remain outside this table.
        def rh_reg_status(index: i64) -> u8&:
            return "implemented" if index >= 0 and index < 10
            return "implemented" if index == 10
            return "implemented" if index >= 11 and index <= 135
            ""

        def rh_reg_unit(index: i64) -> u8&:
            return "enum" if index == 2
            return "ratio" if index == 7 or index == 10
            return "ratio" if index >= 11 and index <= 14
            return "ratio" if index == 16 or index == 17
            return "hours" if index == 8
            return "enum" if index == 9
            return "timestamp" if index == 23
            return "days" if index == 24 or index == 29 or index == 30
            return "hours" if index == 31
            return "ratio" if index == 32 or index == 41
            return "actors" if index == 42 or index == 43
            return "actors" if index == 44 or index == 45 or index == 46
            return "ratio" if index == 47
            return "days" if index == 48
            return "declarations" if index >= 49 and index <= 56
            return "adoptions" if index >= 57 and index <= 60
            return "nodes" if index == 61 or index == 62 or index == 64
            return "components" if index == 63
            return "projects" if index == 65
            return "families" if index == 66
            return "mappings" if index == 67
            return "capabilities" if index >= 68 and index <= 74
            return "components" if index >= 75 and index <= 79
            return "fields" if index == 80
            return "releases" if index == 81 or index == 82 or index == 85
            return "assets" if index == 83 or index == 84
            return "releases" if index == 90 or index == 91
            return "advisories" if index == 92 or index == 94
            return "nodes" if index == 93
            return "requirements" if index == 95 or index == 97
            return "versions" if index == 96
            return "versions" if index == 98
            return "records" if index == 99
            return "requirements" if index >= 100 and index <= 104
            return "edges" if index >= 105 and index <= 109
            return "nodes" if index >= 110 and index <= 112
            return "requirements" if index >= 113 and index <= 117
            return "ratio" if index == 118
            return "edges" if index == 119
            return "boolean" if index == 120
            return "nodes" if index == 121
            return "edges" if index == 122
            return "nodes" if index == 123
            return "boolean" if index == 124
            return "ratio" if index == 125
            return "boolean" if index == 126
            return "days" if index == 127 or index == 128
            return "days_squared" if index == 129
            return "ratio" if index == 130
            return "components" if index == 131
            return "nodes" if index == 132
            return "capabilities" if index == 133 or index == 135
            return "ratio" if index == 134
            return "ecosystems" if index == 86
            return "requirements" if index == 87 or index == 89
            return "edges" if index == 88
            return "boundaries" if index == 25
            return "commits" if index == 26 or index == 27 or index == 28
            return "identities" if index == 33
            return "accounts" if index == 34 or index == 35
            return "actors" if index == 36 or index == 37 or index == 38 or index == 39 or index == 40
            return "count" if (index >= 0 and index < 10) or index == 10 or index == 12 or index == 15 or index == 18 or index == 19 or index == 20 or index == 21 or index == 22
            ""

        def rh_reg_entity(index: i64) -> u8:
            return RH_ENT_PACKAGE if index >= 61 and index <= 64
            return RH_ENT_PROJECT if (index >= 0 and index < 10) or index == 10 or index == 11 or index == 12 or (index >= 13 and index <= 135)
            255

        # Denominator rule: 0 = none (count/enum), 1 = ratio with explicit
        # denominator (v1: eligible complete months observed), 2 = ratio against
        # the full eligible window including not-observed months (v2), 3 = ratio
        # over an eligible-actor population with a complete retention window,
        # 4 = exact rational over a population denominator (actor event counts).
        # A rule change is a new version: a v2 result must never be compared with or
        # overwrite a v1 result (F038).
        def rh_reg_denom_rule(index: i64) -> u8:
            return 1 if index == 7
            return 2 if index == 10
            return 3 if index == 11
            return 4 if index == 13 or index == 14 or index == 16 or index == 17
            return 4 if index == 32 or index == 41
            return 4 if index == 47
            0

        # Linear find by key; -1 when absent.
        def rh_reg_find(key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < rh_reg_count() |i: i64 = 0, key|:
                return i if Base::rh_streq(rh_reg_key(i), key) and Base::rh_streq(rh_reg_status(i), "implemented")
                i <- i + 1
            -1

        # Identity is (key, version). Returns the entry index or -1. This is how a
        # caller must resolve a definition before trusting its denominator rule.
        def rh_reg_find_versioned(key: u8&, version: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < rh_reg_count() |i: i64 = 0, key, version|:
                return i if Base::rh_streq(rh_reg_key(i), key) and Base::rh_streq(rh_reg_version(i), version)
                i <- i + 1
            -1

        # Denominator rule for an exact (key, version); -1 when the pair is absent
        # so a caller cannot silently fall back to a different version's rule
        # (an unknown version has no fallback to a default).
        def rh_reg_denom_rule_for(key: u8&, version: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            idx: i64 = rh_reg_find_versioned(key, version)
            return -1 if idx < 0
            rh_reg_denom_rule(idx).i64()

        # Lint: 0 = clean. Otherwise the count of violations found
        # (duplicate key/version, unknown entity, empty version/unit).
        def rh_reg_lint() -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < rh_reg_count() |violations: i64 = 0, i: i64 = 0| -> violations:
                if Base::rh_streq(rh_reg_version(i), ""):
                    violations <- violations + 1
                if Base::rh_streq(rh_reg_unit(i), ""):
                    violations <- violations + 1
                if rh_reg_entity(i) > RH_ENT_ARTIFACT:
                    violations <- violations + 1
                while j < rh_reg_count() |j: i64 = i + 1, i, violations|:
                    if Base::rh_streq(rh_reg_key(i), rh_reg_key(j)):
                        same_version: bool = Base::rh_streq(rh_reg_version(i), rh_reg_version(j))
                        violations <- violations + 1 if same_version
                    j <- j + 1
                i <- i + 1
