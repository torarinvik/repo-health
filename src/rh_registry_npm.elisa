# rh_registry_npm.elisa — bounded npm registry metadata adapter (M03-05).
#
# npm exposes versions as an object keyed by version rather than the canonical
# array. This adapter keeps provider shape at the boundary, retains publish
# times and repository assertions, and counts declared dependency scopes
# without resolving or executing a package manager. npm has no equivalent
# yanked flag in this payload, so every version remains explicitly unknown.

include "./rh_base.elisa"
include "./rh_json.elisa"

const RH_REGMETA_NPM_MAX_VERSIONS: i64 = 10000

module RegistryNpm:
    private:
        def rh_npm_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, obj, key), &s_out[0], &e_out[0])

        def rh_npm_emit_deps(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, dep_obj: i64, optional: bool, kind: u8&, out: mutable darray[u8]&, emitted: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if dep_obj < 0
            return -1 if nodes[dep_obj.usize()].kind != Json::RH_JSON_OBJ
            while key >= 0 |key: i64 = nodes[dep_obj.usize()].first_child, nodes, texts, out, emitted, optional, kind|:
                value: i64 = nodes[key.usize()].next_sibling
                return -1 if value < 0
                out.push(44) if emitted[0] > 0
                Base::rh_push_text(out, "{\"optional\":")
                Base::rh_push_text(out, "true" if optional else "false")
                Base::rh_push_text(out, ",\"kind\":\"")
                Base::rh_push_text(out, kind)
                Base::rh_push_text(out, "\"}")
                emitted[0] <- emitted[0] + 1
                key <- nodes[value.usize()].next_sibling
            0

        def rh_npm_time(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, time_obj: i64, version_s: i64, version_e: i64, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if time_obj < 0
            return -1 if nodes[time_obj.usize()].kind != Json::RH_JSON_OBJ
            while key >= 0 |key: i64 = nodes[time_obj.usize()].first_child, nodes, texts, version_s, version_e, out|:
                value: i64 = nodes[key.usize()].next_sibling
                return -1 if value < 0
                if nodes[key.usize()].kind == Json::RH_JSON_STR and Base::rh_bytes_equal_span(texts, nodes[key.usize()].text_start, nodes[key.usize()].text_end, texts, version_s, version_e):
                    if nodes[value.usize()].kind == Json::RH_JSON_STR:
                        out.push(34)
                        Base::rh_json_escape(out, texts, nodes[value.usize()].text_start.usize(), nodes[value.usize()].text_end.usize())
                        out.push(34)
                    else:
                        Base::rh_push_text(out, "null")
                    return 1
                key <- nodes[value.usize()].next_sibling
            Base::rh_push_text(out, "null")
            0

        def rh_npm_repository(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, version_obj: i64, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            repo: i64 = Json::rh_json_obj_get(nodes, texts, version_obj, "repository")
            if repo >= 0 and nodes[repo.usize()].kind == Json::RH_JSON_STR:
                out.push(34)
                Base::rh_json_escape(out, texts, nodes[repo.usize()].text_start.usize(), nodes[repo.usize()].text_end.usize())
                out.push(34)
                return 1
            if repo >= 0 and nodes[repo.usize()].kind == Json::RH_JSON_OBJ:
                url_s: mutable i64 = 0
                url_e: mutable i64 = 0
                if RegistryNpm::rh_npm_str(nodes, texts, repo, "url", &url_s, &url_e):
                    out.push(34)
                    Base::rh_json_escape(out, texts, url_s.usize(), url_e.usize())
                    out.push(34)
                    return 1
            home_s: mutable i64 = 0
            home_e: mutable i64 = 0
            if RegistryNpm::rh_npm_str(nodes, texts, version_obj, "homepage", &home_s, &home_e):
                out.push(34)
                Base::rh_json_escape(out, texts, home_s.usize(), home_e.usize())
                out.push(34)
                return 1
            Base::rh_push_text(out, "null")
            0

    public:
        def rh_regmeta_npm_normalize(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if raw.count > 4194304
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            versions: i64 = Json::rh_json_obj_get(nodes, texts, root, "versions")
            return -1 if versions < 0 or nodes[versions.usize()].kind != Json::RH_JSON_OBJ
            time_obj: i64 = Json::rh_json_obj_get(nodes, texts, root, "time")
            if time_obj >= 0:
                return -1 if nodes[time_obj.usize()].kind != Json::RH_JSON_OBJ
            Base::rh_push_text(out, "{\"versions\":[")
            emitted_versions: mutable i64 = 0
            while version_key >= 0 |version_key: i64 = nodes[versions.usize()].first_child, nodes, texts, raw, out, emitted_versions, time_obj|:
                version_obj: i64 = nodes[version_key.usize()].next_sibling
                return -1 if nodes[version_key.usize()].kind != Json::RH_JSON_STR or version_obj < 0 or nodes[version_obj.usize()].kind != Json::RH_JSON_OBJ
                return -1 if emitted_versions >= RH_REGMETA_NPM_MAX_VERSIONS
                if emitted_versions > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"num\":\"")
                Base::rh_json_escape(out, texts, nodes[version_key.usize()].text_start.usize(), nodes[version_key.usize()].text_end.usize())
                Base::rh_push_text(out, "\",\"yanked\":null,\"published_at\":")
                RegistryNpm::rh_npm_time(nodes, texts, time_obj, nodes[version_key.usize()].text_start, nodes[version_key.usize()].text_end, out)
                Base::rh_push_text(out, ",\"repository\":")
                RegistryNpm::rh_npm_repository(nodes, texts, version_obj, out)
                Base::rh_push_text(out, ",\"deps\":[")
                emitted_deps: mutable i64 = 0
                return -1 if RegistryNpm::rh_npm_emit_deps(nodes, texts, Json::rh_json_obj_get(nodes, texts, version_obj, "dependencies"), false, "runtime", out, &emitted_deps) != 0
                return -1 if RegistryNpm::rh_npm_emit_deps(nodes, texts, Json::rh_json_obj_get(nodes, texts, version_obj, "optionalDependencies"), true, "runtime", out, &emitted_deps) != 0
                return -1 if RegistryNpm::rh_npm_emit_deps(nodes, texts, Json::rh_json_obj_get(nodes, texts, version_obj, "devDependencies"), false, "dev", out, &emitted_deps) != 0
                Base::rh_push_text(out, "]}")
                emitted_versions <- emitted_versions + 1
                version_key <- nodes[version_obj.usize()].next_sibling
            Base::rh_push_text(out, "]}")
            0
