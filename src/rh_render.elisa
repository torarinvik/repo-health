# rh_render.elisa — accessible server-rendered report page (M06-03).
#
# Renders an M01 `report.json` into a self-contained, keyboard/screen-reader
# friendly HTML page: a metric TABLE (the text alternative to any visual),
# a capabilities table, and the mandatory caveats. It computes nothing and
# adds no verdict — it only reformats retained report bytes. Every dynamic
# string is HTML-escaped, so a hostile repository name cannot inject markup.
# Malformed/unexpected JSON returns -1 (the caller serves a plain error).

include "./rh_base.elisa"
include "./rh_json.elisa"

module RenderReport:
    private:
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_hr_escape(out: mutable darray[u8]&, data: darray[u8]&, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
            return if s < 0 or e < s or e > data.count.i64()
            while i < e |i: i64 = s, data, out|:
                b: u8 = data[i.usize()]
                if b == 38:
                    Base::rh_push_text(out, "&amp;")
                elif b == 60:
                    Base::rh_push_text(out, "&lt;")
                elif b == 62:
                    Base::rh_push_text(out, "&gt;")
                elif b == 34:
                    Base::rh_push_text(out, "&quot;")
                elif b == 39:
                    Base::rh_push_text(out, "&#39;")
                else:
                    out.push(b)
                i <- i + 1

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_hr_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return false if idx < 0
            Json::rh_json_str_span(nodes, idx, s_out, e_out)

        # Emit one metric's value as accessible text into out.
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_hr_value(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, raw: darray[u8]&, mobj: i64, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            v: i64 = Json::rh_json_obj_get(nodes, texts, mobj, "value")
            if v < 0:
                Base::rh_push_text(out, "&mdash;")
                return
            kind: u8 = nodes[v.usize()].kind
            if kind == Json::RH_JSON_NUM:
                ok: mutable i64 = 0
                n: i64 = Json::rh_json_int(nodes, raw, v, &ok)
                if ok == 1:
                    Base::rh_push_decimal_i64(out, n)
                else:
                    Base::rh_push_text(out, "number")
            elif kind == Json::RH_JSON_STR:
                vs: mutable i64 = 0
                ve: mutable i64 = 0
                if Json::rh_json_str_span(nodes, v, &vs, &ve):
                    rh_hr_escape(out, texts, vs, ve)
            elif kind == Json::RH_JSON_OBJ:
                num_idx: i64 = Json::rh_json_obj_get(nodes, texts, v, "num")
                den_idx: i64 = Json::rh_json_obj_get(nodes, texts, v, "den")
                okn: mutable i64 = 0
                okd: mutable i64 = 0
                num: i64 = Json::rh_json_int(nodes, raw, num_idx, &okn)
                den: i64 = Json::rh_json_int(nodes, raw, den_idx, &okd)
                if okn == 1 and okd == 1:
                    Base::rh_push_decimal_i64(out, num)
                    Base::rh_push_text(out, " / ")
                    Base::rh_push_decimal_i64(out, den)
                else:
                    ls: mutable i64 = 0
                    le: mutable i64 = 0
                    if rh_hr_str(nodes, texts, v, "label", &ls, &le):
                        rh_hr_escape(out, texts, ls, le)
                    else:
                        Base::rh_push_text(out, "object")
            else:
                Base::rh_push_text(out, "&mdash;")

        # Emit a scalar report field as escaped accessible text. Missing fields remain
        # an explicit em dash so optional timeline/neighborhood rows never invent data.
        def rh_hr_field(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, raw: darray[u8]&, obj: i64, key: u8&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            if idx < 0:
                Base::rh_push_text(out, "&mdash;")
                return
            n: Json::RhJsonNode = nodes[idx.usize()]
            if n.kind == Json::RH_JSON_STR:
                rh_hr_escape(out, texts, n.text_start, n.text_end)
            elif n.kind == Json::RH_JSON_NUM:
                ok: mutable i64 = 0
                value: i64 = Json::rh_json_int(nodes, raw, idx, &ok)
                Base::rh_push_decimal_i64(out, value) if ok == 1
                Base::rh_push_text(out, "number") if ok == 0
            elif n.kind == Json::RH_JSON_BOOL:
                Base::rh_push_text(out, "true") if Json::rh_json_is_true(nodes, raw, idx)
                Base::rh_push_text(out, "false") if not Json::rh_json_is_true(nodes, raw, idx)
            elif n.kind == Json::RH_JSON_NULL:
                Base::rh_push_text(out, "&mdash;")
            else:
                Base::rh_push_text(out, "object")

        # Emit one continuity row whose value is a scalar field on obj. Missing
        # optional fields stay an explicit em dash, matching the report renderer.
        def rh_hr_cont_scalar(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, raw: darray[u8]&, obj: i64, key: u8&, label: u8&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "<tr><th scope=\"row\">")
            Base::rh_push_text(out, label)
            Base::rh_push_text(out, "</th><td>")
            rh_hr_field(nodes, texts, raw, obj, key, out)
            Base::rh_push_text(out, "</td></tr>\n")

        # Render the two retained continuity artifacts as accessible tables. This
        # consumes only already-written JSON and never computes a new metric.
        def rh_hr_continuity(continuity: darray[u8]&, metric_bytes: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(continuity, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_s: mutable i64 = 0
            schema_e: mutable i64 = 0
            return -1 if not rh_hr_str(nodes, texts, root, "schema", &schema_s, &schema_e)
            return -1 if not Base::rh_bytes_equal_literal(texts, schema_s, schema_e, "rh-continuity/1")

            Base::rh_push_text(out, "<h2>Continuity</h2>\n<table>\n<caption>Observed continuity context; unknown and unsupported states remain explicit.</caption>\n")
            Base::rh_push_text(out, "<thead><tr><th scope=\"col\">Field</th><th scope=\"col\">Value</th></tr></thead>\n<tbody>\n")
            coverage: i64 = Json::rh_json_obj_get(nodes, texts, root, "coverage")
            if coverage >= 0 and nodes[coverage.usize()].kind == Json::RH_JSON_OBJ:
                rh_hr_cont_scalar(nodes, texts, continuity, coverage, "basis", "coverage basis", out)
                rh_hr_cont_scalar(nodes, texts, continuity, coverage, "activity_change_claims_supported", "activity-change claims supported", out)
            rh_hr_cont_scalar(nodes, texts, continuity, root, "first_observation_basis", "first-observation basis", out)
            rh_hr_cont_scalar(nodes, texts, continuity, root, "actors_total", "actors total", out)
            rh_hr_cont_scalar(nodes, texts, continuity, root, "persistent", "persistent actors", out)
            events: i64 = Json::rh_json_obj_get(nodes, texts, root, "event_totals")
            if events >= 0 and nodes[events.usize()].kind == Json::RH_JSON_OBJ:
                event_obj: Json::RhJsonNode = nodes[events.usize()]
                while event_key >= 0 |event_key: i64 = event_obj.first_child, nodes, texts, continuity, out|:
                    event_value: i64 = nodes[event_key.usize()].next_sibling
                    return -1 if event_value < 0
                    Base::rh_push_text(out, "<tr><th scope=\"row\">event total: ")
                    rh_hr_escape(out, texts, nodes[event_key.usize()].text_start, nodes[event_key.usize()].text_end)
                    Base::rh_push_text(out, "</th><td>")
                    event_ok: mutable i64 = 0
                    event_total: i64 = Json::rh_json_int(nodes, continuity, event_value, &event_ok)
                    if event_ok == 1:
                        Base::rh_push_decimal_i64(out, event_total)
                    else:
                        Base::rh_push_text(out, "&mdash;")
                    Base::rh_push_text(out, "</td></tr>\n")
                    event_key <- nodes[event_value.usize()].next_sibling
            Base::rh_push_text(out, "</tbody></table>\n")

            metric_nodes: mutable darray[Json::RhJsonNode] = []
            metric_texts: mutable darray[u8] = []
            metric_root: i64 = Json::rh_json_parse(metric_bytes, metric_nodes, metric_texts)
            return -1 if metric_root < 0 or metric_nodes[metric_root.usize()].kind != Json::RH_JSON_OBJ
            metric_schema_s: mutable i64 = 0
            metric_schema_e: mutable i64 = 0
            return -1 if not rh_hr_str(metric_nodes, metric_texts, metric_root, "schema", &metric_schema_s, &metric_schema_e)
            return -1 if not Base::rh_bytes_equal_literal(metric_texts, metric_schema_s, metric_schema_e, "rh-continuity-metrics/1")
            metrics: i64 = Json::rh_json_obj_get(metric_nodes, metric_texts, metric_root, "metrics")
            if metrics >= 0 and metric_nodes[metrics.usize()].kind == Json::RH_JSON_ARR:
                Base::rh_push_text(out, "<h2>Continuity metrics</h2>\n<table>\n<caption>Typed continuity observations and their coverage state.</caption>\n<thead><tr><th scope=\"col\">Metric</th><th scope=\"col\">Version</th><th scope=\"col\">Status</th><th scope=\"col\">Value</th></tr></thead>\n<tbody>\n")
                metric_arr: Json::RhJsonNode = metric_nodes[metrics.usize()]
                while metric >= 0 |metric: i64 = metric_arr.first_child, metric_nodes, metric_texts, metric_bytes, out|:
                    return -1 if metric_nodes[metric.usize()].kind != Json::RH_JSON_OBJ
                    Base::rh_push_text(out, "<tr><th scope=\"row\">")
                    ks: mutable i64 = 0
                    ke: mutable i64 = 0
                    if rh_hr_str(metric_nodes, metric_texts, metric, "key", &ks, &ke):
                        rh_hr_escape(out, metric_texts, ks, ke)
                    Base::rh_push_text(out, "</th><td>")
                    vs: mutable i64 = 0
                    ve: mutable i64 = 0
                    if rh_hr_str(metric_nodes, metric_texts, metric, "version", &vs, &ve):
                        rh_hr_escape(out, metric_texts, vs, ve)
                    Base::rh_push_text(out, "</td><td>")
                    sts: mutable i64 = 0
                    ste: mutable i64 = 0
                    if rh_hr_str(metric_nodes, metric_texts, metric, "status", &sts, &ste):
                        rh_hr_escape(out, metric_texts, sts, ste)
                    reason_s: mutable i64 = 0
                    reason_e: mutable i64 = 0
                    if rh_hr_str(metric_nodes, metric_texts, metric, "reason", &reason_s, &reason_e):
                        Base::rh_push_text(out, " (")
                        rh_hr_escape(out, metric_texts, reason_s, reason_e)
                        Base::rh_push_text(out, ")")
                    Base::rh_push_text(out, "</td><td>")
                    rh_hr_value(metric_nodes, metric_texts, metric_bytes, metric, out)
                    Base::rh_push_text(out, "</td></tr>\n")
                    metric <- metric_nodes[metric.usize()].next_sibling
                Base::rh_push_text(out, "</tbody></table>\n")
            0

        # Add optional sibling continuity artifacts while preserving the exact base
        # report document when either artifact is absent.
    public:
        def rh_render_report_html(j: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(j, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            metrics_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "metrics")
            return -1 if metrics_idx < 0 or nodes[metrics_idx.usize()].kind != Json::RH_JSON_ARR
            Base::rh_push_text(out, "<!DOCTYPE html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">")
            Base::rh_push_text(out, "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">")
            Base::rh_push_text(out, "<meta name=\"generator\" content=\"repo-health-report-html/1\">")
            Base::rh_push_text(out, "<title>repo-health report</title></head><body>\n")
            Base::rh_push_text(out, "<h1>repo-health report</h1>\n")
            Base::rh_push_text(out, "<p>Source: <code>")
            ss: mutable i64 = 0
            se: mutable i64 = 0
            if rh_hr_str(nodes, texts, root, "source", &ss, &se):
                rh_hr_escape(out, texts, ss, se)
            Base::rh_push_text(out, "</code>")
            sk: mutable i64 = 0
            ske: mutable i64 = 0
            if rh_hr_str(nodes, texts, root, "source_kind", &sk, &ske):
                Base::rh_push_text(out, " (")
                rh_hr_escape(out, texts, sk, ske)
                Base::rh_push_text(out, ")")
            Base::rh_push_text(out, "</p>\n")
            Base::rh_push_text(out, "<h2>Important limitations</h2>\n<ul>\n")
            Base::rh_push_text(out, "<li>Raw commit authors are not maintainers; this report makes no person-level claim.</li>\n")
            Base::rh_push_text(out, "<li>Unknown is not zero, and &ldquo;not_applicable&rdquo; is not false.</li>\n")
            Base::rh_push_text(out, "<li>There is no universal health, trust, or safety score here.</li>\n")
            Base::rh_push_text(out, "<li>Review events, maintainer permissions, clone traffic, and known downstream dependents are not collected from generic Git in this report.</li>\n")
            Base::rh_push_text(out, "</ul>\n")
            Base::rh_push_text(out, "<h2>Metrics</h2>\n<table>\n<caption>Metric observations; each row is the text alternative to a chart.</caption>\n")
            Base::rh_push_text(out, "<thead><tr><th scope=\"col\">Metric</th><th scope=\"col\">Version</th><th scope=\"col\">Status</th><th scope=\"col\">Value</th><th scope=\"col\">Evidence</th></tr></thead>\n<tbody>\n")
            arr: Json::RhJsonNode = nodes[metrics_idx.usize()]
            while child >= 0 |child: i64 = arr.first_child, nodes, texts, j, out|:
                return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                Base::rh_push_text(out, "<tr><th scope=\"row\">")
                ks: mutable i64 = 0
                ke: mutable i64 = 0
                if rh_hr_str(nodes, texts, child, "key", &ks, &ke):
                    rh_hr_escape(out, texts, ks, ke)
                Base::rh_push_text(out, "</th><td>")
                vs: mutable i64 = 0
                ve: mutable i64 = 0
                if rh_hr_str(nodes, texts, child, "version", &vs, &ve):
                    rh_hr_escape(out, texts, vs, ve)
                Base::rh_push_text(out, "</td><td>")
                sts: mutable i64 = 0
                ste: mutable i64 = 0
                if rh_hr_str(nodes, texts, child, "status", &sts, &ste):
                    rh_hr_escape(out, texts, sts, ste)
                rs: mutable i64 = 0
                re: mutable i64 = 0
                if rh_hr_str(nodes, texts, child, "reason", &rs, &re):
                    Base::rh_push_text(out, " (")
                    rh_hr_escape(out, texts, rs, re)
                    Base::rh_push_text(out, ")")
                Base::rh_push_text(out, "</td><td>")
                rh_hr_value(nodes, texts, j, child, out)
                Base::rh_push_text(out, "</td><td>")
                ev: i64 = Json::rh_json_obj_get(nodes, texts, child, "evidence")
                evn: mutable i64 = 0
                if ev >= 0 and nodes[ev.usize()].kind == Json::RH_JSON_ARR:
                    ea: Json::RhJsonNode = nodes[ev.usize()]
                    while ec >= 0 |ec: i64 = ea.first_child, nodes, evn|:
                        evn <- evn + 1
                        ec <- nodes[ec.usize()].next_sibling
                Base::rh_push_decimal_i64(out, evn)
                Base::rh_push_text(out, " file(s)</td></tr>\n")
                child <- nodes[child.usize()].next_sibling
            Base::rh_push_text(out, "</tbody></table>\n")
            caps_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "capabilities")
            if caps_idx >= 0 and nodes[caps_idx.usize()].kind == Json::RH_JSON_OBJ:
                Base::rh_push_text(out, "<h2>Capabilities</h2>\n<table>\n<caption>What this source could and could not observe.</caption>\n")
                Base::rh_push_text(out, "<thead><tr><th scope=\"col\">Capability</th><th scope=\"col\">State</th></tr></thead>\n<tbody>\n")
                co: Json::RhJsonNode = nodes[caps_idx.usize()]
                while cc >= 0 |cc: i64 = co.first_child, nodes, texts, out|:
                    kn: Json::RhJsonNode = nodes[cc.usize()]
                    vn: i64 = kn.next_sibling
                    return -1 if vn < 0
                    Base::rh_push_text(out, "<tr><th scope=\"row\">")
                    rh_hr_escape(out, texts, kn.text_start, kn.text_end)
                    Base::rh_push_text(out, "</th><td>")
                    vv: Json::RhJsonNode = nodes[vn.usize()]
                    rh_hr_escape(out, texts, vv.text_start, vv.text_end)
                    Base::rh_push_text(out, "</td></tr>\n")
                    cc <- nodes[vn.usize()].next_sibling
                Base::rh_push_text(out, "</tbody></table>\n")
            timeline_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "timeline")
            if timeline_idx >= 0:
                return -1 if nodes[timeline_idx.usize()].kind != Json::RH_JSON_ARR
                Base::rh_push_text(out, "<h2>Timeline</h2>\n<table>\n<caption>Observed timeline entries; the table is the accessible alternative to a visual timeline.</caption>\n<thead><tr><th scope=\"col\">Time</th><th scope=\"col\">Label</th><th scope=\"col\">Status</th></tr></thead>\n<tbody>\n")
                ta: Json::RhJsonNode = nodes[timeline_idx.usize()]
                while tc >= 0 |tc: i64 = ta.first_child, nodes, texts, j, out|:
                    return -1 if nodes[tc.usize()].kind != Json::RH_JSON_OBJ
                    Base::rh_push_text(out, "<tr><th scope=\"row\">")
                    rh_hr_field(nodes, texts, j, tc, "at", out)
                    Base::rh_push_text(out, "</th><td>")
                    rh_hr_field(nodes, texts, j, tc, "label", out)
                    Base::rh_push_text(out, "</td><td>")
                    rh_hr_field(nodes, texts, j, tc, "status", out)
                    Base::rh_push_text(out, "</td></tr>\n")
                    tc <- nodes[tc.usize()].next_sibling
                Base::rh_push_text(out, "</tbody></table>\n")
            neighborhood_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "neighborhood")
            if neighborhood_idx >= 0:
                return -1 if nodes[neighborhood_idx.usize()].kind != Json::RH_JSON_ARR
                Base::rh_push_text(out, "<h2>Graph neighborhood</h2>\n<table>\n<caption>Bounded observed graph neighborhood; counts and rows use the selected projection.</caption>\n<thead><tr><th scope=\"col\">Node</th><th scope=\"col\">Kind</th><th scope=\"col\">Depth</th><th scope=\"col\">Scope</th></tr></thead>\n<tbody>\n")
                na: Json::RhJsonNode = nodes[neighborhood_idx.usize()]
                while nc >= 0 |nc: i64 = na.first_child, nodes, texts, j, out|:
                    return -1 if nodes[nc.usize()].kind != Json::RH_JSON_OBJ
                    Base::rh_push_text(out, "<tr><th scope=\"row\">")
                    rh_hr_field(nodes, texts, j, nc, "id", out)
                    Base::rh_push_text(out, "</th><td>")
                    rh_hr_field(nodes, texts, j, nc, "kind", out)
                    Base::rh_push_text(out, "</td><td>")
                    rh_hr_field(nodes, texts, j, nc, "depth", out)
                    Base::rh_push_text(out, "</td><td>")
                    rh_hr_field(nodes, texts, j, nc, "scope", out)
                    Base::rh_push_text(out, "</td></tr>\n")
                    nc <- nodes[nc.usize()].next_sibling
                Base::rh_push_text(out, "</tbody></table>\n")
            Base::rh_push_text(out, "<p>Rendered from <code>report.json</code> at request time; it computes nothing and adds no verdict. Replay the retained bundle for reproducibility.</p>\n")
            Base::rh_push_text(out, "</body></html>\n")
            0

        def rh_render_report_html_with_continuity(j: darray[u8]&, continuity: darray[u8]&, metric_bytes: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            base: mutable darray[u8] = []
            return -1 if rh_render_report_html(j, base) != 0
            close: darray[u8] = "</body></html>\n"
            return -1 if base.count < close.count
            prefix_end: i64 = base.count.i64() - close.count.i64()
            while i < prefix_end |i: i64 = 0, base, out|:
                out.push(base[i.usize()])
                i <- i + 1
            return -1 if rh_hr_continuity(continuity, metric_bytes, out) != 0
            Base::rh_push_text(out, "</body></html>\n")
            0
