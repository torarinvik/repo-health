# rh_roles.elisa — declared roles vs observed actions (M04-01, R013).
#
# A forge can DECLARE who has a role (owner, maintainer, triager, member)
# and what permissions they hold. That declaration is not the same as an
# observed action, and it may be stale or wrong. This module keeps the two
# strictly separate: declarations are recorded as claims with their source
# and time; observed actions are counted independently. Neither implies the
# other, and no role is ever inferred from a person's name, email domain,
# or activity volume.
#
# Honest scope: importing live permission inventories requires owner
# authorization the M02 slice does not carry, so the parser here operates
# on captured documents. It never promotes a declaration to an observed
# fact.
include "./rh_base.elisa"

const RH_ROLE_OWNER: u8 = 1
const RH_ROLE_MAINTAINER: u8 = 2
const RH_ROLE_TRIAGER: u8 = 3
const RH_ROLE_MEMBER: u8 = 4
const RH_ROLE_UNKNOWN: u8 = 0

# A declaration source, so a stale document is distinguishable from a
# live one. 1 = captured provider permission document; 2 = project
# declaration file (e.g. a governance file); 3 = operator-entered.
const RH_DECL_SOURCE_PROVIDER: u8 = 1
const RH_DECL_SOURCE_FILE: u8 = 2
const RH_DECL_SOURCE_OPERATOR: u8 = 3

struct RhRoleDecl:
    actor_id: i64
    role: u8
    permission: u8
    source: u8
    declared_at: i64
    revoked_at: i64

def rh_role_label(role: u8) -> u8&:
    if role == RH_ROLE_OWNER:
        return "owner"
    if role == RH_ROLE_MAINTAINER:
        return "maintainer"
    if role == RH_ROLE_TRIAGER:
        return "triager"
    if role == RH_ROLE_MEMBER:
        return "member"
    return "unknown"

# Role from a provider "role" string. Unknown strings stay unknown; they are
# never guessed into maintainer (a provider adding a role must not silently
# upgrade anyone).
def rh_role_parse_role(texts: darray[u8]&, s: i64, e: i64) -> u8 can[Memory.Allocate, Abort.Panic]:
    if rh_role_eq(texts, s, e, "owner", 5):
        return RH_ROLE_OWNER
    if rh_role_eq(texts, s, e, "maintainer", 10):
        return RH_ROLE_MAINTAINER
    if rh_role_eq(texts, s, e, "triager", 7):
        return RH_ROLE_TRIAGER
    if rh_role_eq(texts, s, e, "member", 6):
        return RH_ROLE_MEMBER
    return RH_ROLE_UNKNOWN

# (private to this file)
def rh_role_eq(data: darray[u8]&, s: i64, e: i64, lit: u8&, n: i64) -> bool can[Memory.Allocate, Abort.Panic]:
    if s < 0 or e - s != n:
        return false
    k: mutable i64 = 0
    while k < n |k, data, s, lit|:
        a: mutable u8 = data[(s + k).usize()]
        b: mutable u8 = lit[k.usize()]
        if a >= 65 and a <= 90:
            a <- a + 32
        if b >= 65 and b <= 90:
            b <- b + 32
        if a != b:
            return false
        k <- k + 1
    return true

# Declared role for an actor at a known time. A declaration with no
# revoked_at is active; a revoked one is not. Returns RH_ROLE_UNKNOWN when
# there is no active declaration. Declarations do NOT become observed facts.
def rh_role_declared(decls: darray[RhRoleDecl]&, actor: i64, as_of: i64) -> u8 can[Memory.Allocate, Abort.Panic]:
    best: mutable u8 = RH_ROLE_UNKNOWN
    i: mutable usize = 0
    while i < decls.count |i, decls, actor, as_of, best|:
        d: RhRoleDecl = decls[i]
        if d.actor_id == actor and d.declared_at <= as_of:
            if d.revoked_at == 0 or d.revoked_at > as_of:
                best <- d.role
        i <- i + 1
    return best

# Declared permission bit for an actor (0/1), same active rules.
def rh_role_permission_declared(decls: darray[RhRoleDecl]&, actor: i64, perm_bit: u8, as_of: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    i: mutable usize = 0
    while i < decls.count |i, decls, actor, perm_bit, as_of|:
        d: RhRoleDecl = decls[i]
        if d.actor_id == actor and d.declared_at <= as_of and (d.revoked_at == 0 or d.revoked_at > as_of):
            if (d.permission & perm_bit) != 0:
                return 1
        i <- i + 1
    return 0

# Stratify a declaration set: how many declarations are provider/file/
# operator-sourced. Callers use this to weight or caveat a claim; a claim
# from a captured document is not the same as one from a project file.
def rh_role_source_tally(decls: darray[RhRoleDecl]&, prov_out: mutable i64&, file_out: mutable i64&, op_out: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
    prov_out[0] <- 0
    file_out[0] <- 0
    op_out[0] <- 0
    i: mutable usize = 0
    while i < decls.count |i, decls, prov_out, file_out, op_out|:
        d: RhRoleDecl = decls[i]
        if d.source == RH_DECL_SOURCE_PROVIDER:
            prov_out[0] <- prov_out[0] + 1
        elif d.source == RH_DECL_SOURCE_FILE:
            file_out[0] <- file_out[0] + 1
        else:
            op_out[0] <- op_out[0] + 1
        i <- i + 1
    return
