include "./rh_base.elisa"

module Roles:
    public:
        # rh_roles.elisa — declared roles vs observed actions (M04-01, R013).
        #
        # A forge can DECLARE who has a role (owner, maintainer, triager, member)
        # and what permissions they hold. That declaration is not the same as an
        # observed action, and it may be stale or wrong. This module keeps the two
        # strictly separate: declarations are recorded as claims with their source
        # and time; observed actions are counted independently. Neither implies the
        # other, and no role is ever inferred from a person's name, email domain,
        # or activity volume.
        #
        # This module consumes captured permission evidence. The provider fetch
        # adapter owns authentication and transport; declarations remain claims
        # and are never promoted to observed actions.


        const RH_ROLE_OWNER: u8 = 1
        const RH_ROLE_MAINTAINER: u8 = 2
        const RH_ROLE_TRIAGER: u8 = 3
        const RH_ROLE_MEMBER: u8 = 4
        const RH_ROLE_UNKNOWN: u8 = 0

        # A declaration source, so a stale document is distinguishable from a
        # live one. 1 = captured provider permission document; 2 = project
        # declaration file (e.g. a governance file); 3 = operator-entered.
        const RH_DECL_SOURCE_PROVIDER: u8 = 1
        const RH_DECL_SOURCE_FILE: u8 = 2
        const RH_DECL_SOURCE_OPERATOR: u8 = 3

        struct RhRoleDecl:
            actor_id: i64
            role: u8
            permission: u8
            source: u8
            declared_at: i64
            revoked_at: i64

        struct RhRoleSummary:
            provider_sources: i64
            file_sources: i64
            operator_sources: i64
            owner: i64
            maintainer: i64
            triager: i64
            member: i64
            unknown_role: i64

        # Provider-native actions normalized at the same boundary as role
        # declarations. An action is evidence of participation, never a role.
        struct RhObservedAction:
            actor_id: i64
            identity_actor_id: i64
            kind: u8
            actor_kind: u8
            observed_at: i64
            change_id_start: i64
            change_id_end: i64

        struct RhActionActorTypeCounts:
            human: i64
            bot: i64
            service: i64
            unknown: i64

        struct RhObservedActionTypeCounts:
            release: RhActionActorTypeCounts
            merge: RhActionActorTypeCounts
            review: RhActionActorTypeCounts

        struct RhObservedActionTallies:
            actor_types: RhObservedActionTypeCounts
            observed_release_actors: i64
            observed_merge_actors: i64
            observed_review_actors: i64
            release_actor_count_80: i64
            review_actor_count_80: i64
            unattributed_release_count: i64
            automated_release_actions: i64
            attributed_release_actions: i64
            review_focus_actions: i64
            attributed_review_actions: i64

        struct RhLinkedChange:
            mutable id_start: i64
            mutable id_end: i64
            mutable has_merge: bool
            mutable has_review: bool

        const RH_ACTION_RELEASE: u8 = 1
        const RH_ACTION_MERGE: u8 = 2
        const RH_ACTION_REVIEW: u8 = 3
        const RH_ACTOR_KIND_UNKNOWN: u8 = 0
        const RH_ACTOR_KIND_HUMAN: u8 = 1
        const RH_ACTOR_KIND_BOT: u8 = 2
        const RH_ACTOR_KIND_SERVICE: u8 = 3

        def rh_role_label(role: u8) -> u8&:
            return "owner" if role == RH_ROLE_OWNER
            return "maintainer" if role == RH_ROLE_MAINTAINER
            return "triager" if role == RH_ROLE_TRIAGER
            return "member" if role == RH_ROLE_MEMBER
            "unknown"

        # Role from a provider "role" string. Unknown strings stay unknown; they are
        # never guessed into maintainer (a provider adding a role must not silently
        # upgrade anyone).
        def rh_role_parse_role(texts: darray[u8]&, s: i64, e: i64) -> u8 can[Memory.Allocate, Abort.Panic]:
            return RH_ROLE_OWNER if rh_role_eq(texts, s, e, "owner", 5)
            return RH_ROLE_MAINTAINER if rh_role_eq(texts, s, e, "maintainer", 10)
            return RH_ROLE_TRIAGER if rh_role_eq(texts, s, e, "triager", 7)
            return RH_ROLE_MEMBER if rh_role_eq(texts, s, e, "member", 6)
            RH_ROLE_UNKNOWN

        # (private to this file)
        def rh_role_eq(data: darray[u8]&, s: i64, e: i64, lit: u8&, n: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e - s != n
            while k < n |k: i64 = 0, data, s, lit|:
                a: mutable u8 = data[(s + k).usize()]
                b: mutable u8 = lit[k.usize()]
                if a >= 65 and a <= 90:
                    a <- a + 32
                if b >= 65 and b <= 90:
                    b <- b + 32
                return false if a != b
                k <- k + 1
            true

        # Declared role for an actor at a known time. A declaration with no
        # revoked_at is active; a revoked one is not. Returns RH_ROLE_UNKNOWN when
        # there is no active declaration. Declarations do NOT become observed facts.
        def rh_role_declared(decls: darray[RhRoleDecl]&, actor: i64, as_of: i64) -> u8 can[Memory.Allocate, Abort.Panic]:
            while i < decls.count |best: u8 = RH_ROLE_UNKNOWN, i: usize = 0| -> best:
                d: RhRoleDecl = decls[i]
                if d.actor_id == actor and d.declared_at <= as_of:
                    if d.revoked_at == 0 or d.revoked_at > as_of:
                        best <- d.role
                i <- i + 1

        # Declared permission bit for an actor (0/1), same active rules.
        def rh_role_permission_declared(decls: darray[RhRoleDecl]&, actor: i64, perm_bit: u8, as_of: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while i < decls.count |i: usize = 0, decls, actor, perm_bit, as_of|:
                d: RhRoleDecl = decls[i]
                if d.actor_id == actor and d.declared_at <= as_of and (d.revoked_at == 0 or d.revoked_at > as_of):
                    return 1 if (d.permission & perm_bit) != 0
                i <- i + 1
            0

    private:
        struct RhRoleSummaryAccumulator:
            provider_sources: mutable i64
            file_sources: mutable i64
            operator_sources: mutable i64
            owner: mutable i64
            maintainer: mutable i64
            triager: mutable i64
            member: mutable i64
            unknown_role: mutable i64

        def rh_role_summary_accumulator_empty() -> RhRoleSummaryAccumulator:
            RhRoleSummaryAccumulator{
                provider_sources: 0,
                file_sources: 0,
                operator_sources: 0,
                owner: 0,
                maintainer: 0,
                triager: 0,
                member: 0,
                unknown_role: 0
            }

        def rh_role_summary_add(accumulator: mutable RhRoleSummaryAccumulator&, role: u8, source: u8) -> void:
            accumulator.provider_sources <- accumulator.provider_sources + 1 if source == RH_DECL_SOURCE_PROVIDER
            accumulator.file_sources <- accumulator.file_sources + 1 if source == RH_DECL_SOURCE_FILE
            accumulator.operator_sources <- accumulator.operator_sources + 1 if source != RH_DECL_SOURCE_PROVIDER and source != RH_DECL_SOURCE_FILE
            accumulator.owner <- accumulator.owner + 1 if role == RH_ROLE_OWNER
            accumulator.maintainer <- accumulator.maintainer + 1 if role == RH_ROLE_MAINTAINER
            accumulator.triager <- accumulator.triager + 1 if role == RH_ROLE_TRIAGER
            accumulator.member <- accumulator.member + 1 if role == RH_ROLE_MEMBER
            accumulator.unknown_role <- accumulator.unknown_role + 1 if role != RH_ROLE_OWNER and role != RH_ROLE_MAINTAINER and role != RH_ROLE_TRIAGER and role != RH_ROLE_MEMBER

        struct RhActionActorTypeCountAccumulator:
            human: mutable i64
            bot: mutable i64
            service: mutable i64
            unknown: mutable i64

        struct RhObservedActionTypeCountAccumulator:
            release: mutable RhActionActorTypeCountAccumulator
            merge: mutable RhActionActorTypeCountAccumulator
            review: mutable RhActionActorTypeCountAccumulator

        struct RhObservedActionTallyAccumulator:
            actor_types: mutable RhObservedActionTypeCountAccumulator
            unattributed_release_count: mutable i64
            automated_release_actions: mutable i64
            attributed_release_actions: mutable i64
            review_focus_actions: mutable i64
            attributed_review_actions: mutable i64

        struct RhActorContribution:
            actor_id: i64
            kind: u8
            first_seen: i64
            count: mutable i64

        def rh_action_actor_type_count_accumulator_empty() -> RhActionActorTypeCountAccumulator:
            RhActionActorTypeCountAccumulator{human: 0, bot: 0, service: 0, unknown: 0}

        def rh_observed_action_type_count_accumulator_empty() -> RhObservedActionTypeCountAccumulator:
            RhObservedActionTypeCountAccumulator{
                release: rh_action_actor_type_count_accumulator_empty(),
                merge: rh_action_actor_type_count_accumulator_empty(),
                review: rh_action_actor_type_count_accumulator_empty()
            }

        def rh_observed_action_tally_accumulator_empty() -> RhObservedActionTallyAccumulator:
            RhObservedActionTallyAccumulator{
                actor_types: rh_observed_action_type_count_accumulator_empty(),
                unattributed_release_count: 0,
                automated_release_actions: 0,
                attributed_release_actions: 0,
                review_focus_actions: 0,
                attributed_review_actions: 0
            }

        def rh_action_actor_type_count_add(counts: mutable RhActionActorTypeCountAccumulator&, actor_kind: u8) -> void:
            counts.human <- counts.human + 1 if actor_kind == RH_ACTOR_KIND_HUMAN
            counts.bot <- counts.bot + 1 if actor_kind == RH_ACTOR_KIND_BOT
            counts.service <- counts.service + 1 if actor_kind == RH_ACTOR_KIND_SERVICE
            counts.unknown <- counts.unknown + 1 if actor_kind == RH_ACTOR_KIND_UNKNOWN

        def rh_action_actor_type_counts_make(counts: RhActionActorTypeCountAccumulator&) -> RhActionActorTypeCounts:
            RhActionActorTypeCounts{human: counts.human, bot: counts.bot, service: counts.service, unknown: counts.unknown}

        def rh_actor_contribution_hash(actor_id: i64, kind: u8) -> usize:
            key: u64 = actor_id.u64()
            hash: mutable u64 = 0xcbf29ce484222325
            while byte_index < 8 |hash, key, byte_index: mutable usize = 0|:
                shift: u64 = byte_index.u64() * 8
                hash <- (hash ^ ((key >> shift).u8().u64())) * 0x100000001b3
                byte_index <- byte_index + 1
            hash <- (hash ^ kind.u64()) * 0x100000001b3
            hash.usize()

        def rh_actor_contribution_increment(actor_id: i64, kind: u8, slots: mutable darray[i64]&, contributions: mutable darray[RhActorContribution]&) -> void can[Memory.Allocate, Abort.Panic]:
            slot: mutable usize = Roles::rh_actor_contribution_hash(actor_id, kind) % slots.count
            while slots[slot] != 0 |slot, slots, contributions, actor_id, kind|:
                contribution_index: usize = (slots[slot] - 1).usize()
                contribution: RhActorContribution = contributions[contribution_index]
                if contribution.actor_id == actor_id and contribution.kind == kind:
                    contributions[contribution_index].count <- contributions[contribution_index].count + 1
                    return
                slot <- (slot + 1) % slots.count
            contributions.push(RhActorContribution{actor_id: actor_id, kind: kind, first_seen: contributions.count.i64(), count: 1})
            slots[slot] <- contributions.count.i64()

        def rh_actor_contribution_less(left: RhActorContribution, right: RhActorContribution) -> bool:
            return left.kind < right.kind if left.kind != right.kind
            return left.count > right.count if left.count != right.count
            left.first_seen < right.first_seen

    public:
        def rh_role_summary(decls: darray[RhRoleDecl]&) -> RhRoleSummary:
            decls_loop: mutable darray[RhRoleDecl]& = decls
            accumulated: RhRoleSummaryAccumulator =
                while i < decls_loop.count |counts: mutable RhRoleSummaryAccumulator = rh_role_summary_accumulator_empty(), i: usize = 0, decls_loop| -> counts:
                    rh_role_summary_add(&counts, decls_loop[i].role, decls_loop[i].source)
                    i <- i + 1
            RhRoleSummary{
                provider_sources: accumulated.provider_sources,
                file_sources: accumulated.file_sources,
                operator_sources: accumulated.operator_sources,
                owner: accumulated.owner,
                maintainer: accumulated.maintainer,
                triager: accumulated.triager,
                member: accumulated.member,
                unknown_role: accumulated.unknown_role
            }

        def rh_observed_action_tallies(actions: darray[RhObservedAction]&, review_focus_actor: i64) -> RhObservedActionTallies can[Memory.Allocate, Abort.Panic]:
            actions_loop: mutable darray[RhObservedAction]& = actions
            review_focus_actor_loop: mutable i64 = review_focus_actor
            capacity: usize = actions.count * 2 + 1
            slots: mutable darray[i64] = []
            while i < capacity |i: usize = 0, capacity, slots|:
                slots.push(0)
                i <- i + 1
            contributions: mutable darray[RhActorContribution] = []
            accumulated: RhObservedActionTallyAccumulator =
                while i < actions_loop.count |counts: mutable RhObservedActionTallyAccumulator = rh_observed_action_tally_accumulator_empty(), i: usize = 0, actions_loop, review_focus_actor_loop, slots, contributions| -> counts:
                    action: RhObservedAction = actions_loop[i]
                    if action.identity_actor_id >= 0:
                        rh_actor_contribution_increment(action.identity_actor_id, action.kind, slots, contributions)
                    if action.kind == RH_ACTION_RELEASE:
                        rh_action_actor_type_count_add(&counts.actor_types.release, action.actor_kind)
                        if action.actor_id < 0:
                            counts.unattributed_release_count <- counts.unattributed_release_count + 1
                        else:
                            counts.attributed_release_actions <- counts.attributed_release_actions + 1
                            counts.automated_release_actions <- counts.automated_release_actions + 1 if action.actor_kind == RH_ACTOR_KIND_BOT or action.actor_kind == RH_ACTOR_KIND_SERVICE
                    elif action.kind == RH_ACTION_MERGE:
                        rh_action_actor_type_count_add(&counts.actor_types.merge, action.actor_kind)
                    elif action.kind == RH_ACTION_REVIEW:
                        rh_action_actor_type_count_add(&counts.actor_types.review, action.actor_kind)
                        if action.actor_id >= 0:
                            counts.attributed_review_actions <- counts.attributed_review_actions + 1
                            counts.review_focus_actions <- counts.review_focus_actions + 1 if action.actor_id == review_focus_actor_loop
                    i <- i + 1
            sort[RhActorContribution](contributions, rh_actor_contribution_less)
            observed_release_actors: mutable i64 = 0
            observed_merge_actors: mutable i64 = 0
            observed_review_actors: mutable i64 = 0
            release_action_total: mutable i64 = 0
            review_action_total: mutable i64 = 0
            while i < contributions.count |i: usize = 0, contributions, observed_release_actors, observed_merge_actors, observed_review_actors, release_action_total, review_action_total|:
                contribution: RhActorContribution = contributions[i]
                if contribution.kind == RH_ACTION_RELEASE:
                    observed_release_actors <- observed_release_actors + 1
                    release_action_total <- release_action_total + contribution.count
                elif contribution.kind == RH_ACTION_MERGE:
                    observed_merge_actors <- observed_merge_actors + 1
                elif contribution.kind == RH_ACTION_REVIEW:
                    observed_review_actors <- observed_review_actors + 1
                    review_action_total <- review_action_total + contribution.count
                i <- i + 1
            release_target: i64 = (release_action_total * 4 + 4) / 5
            review_target: i64 = (review_action_total * 4 + 4) / 5
            release_actor_count_80: mutable i64 = 0
            review_actor_count_80: mutable i64 = 0
            release_covered: mutable i64 = 0
            review_covered: mutable i64 = 0
            while i < contributions.count |i: usize = 0, contributions, release_target, review_target, release_actor_count_80, review_actor_count_80, release_covered, review_covered|:
                contribution: RhActorContribution = contributions[i]
                if contribution.kind == RH_ACTION_RELEASE and release_covered < release_target:
                    release_covered <- release_covered + contribution.count
                    release_actor_count_80 <- release_actor_count_80 + 1
                elif contribution.kind == RH_ACTION_REVIEW and review_covered < review_target:
                    review_covered <- review_covered + contribution.count
                    review_actor_count_80 <- review_actor_count_80 + 1
                i <- i + 1
            RhObservedActionTallies{
                actor_types: RhObservedActionTypeCounts{
                    release: rh_action_actor_type_counts_make(&accumulated.actor_types.release),
                    merge: rh_action_actor_type_counts_make(&accumulated.actor_types.merge),
                    review: rh_action_actor_type_counts_make(&accumulated.actor_types.review)
                },
                observed_release_actors: observed_release_actors,
                observed_merge_actors: observed_merge_actors,
                observed_review_actors: observed_review_actors,
                release_actor_count_80: release_actor_count_80,
                review_actor_count_80: review_actor_count_80,
                unattributed_release_count: accumulated.unattributed_release_count,
                automated_release_actions: accumulated.automated_release_actions,
                attributed_release_actions: accumulated.attributed_release_actions,
                review_focus_actions: accumulated.review_focus_actions,
                attributed_review_actions: accumulated.attributed_review_actions
            }

        def rh_observed_linked_merge_review_counts(actions: darray[RhObservedAction]&, texts: darray[u8]&, reviewed_out: mutable i64&, linked_merges_out: mutable i64&, unlinked_merges_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            reviewed_out[0] <- 0
            linked_merges_out[0] <- 0
            unlinked_merges_out[0] <- 0
            capacity: usize = actions.count * 2 + 1
            return false if capacity < actions.count
            slots: mutable darray[i64] = []
            while i < capacity |i: usize = 0, slots, capacity|:
                slots.push(-1)
                i <- i + 1
            changes: mutable darray[RhLinkedChange] = []
            while i < actions.count |i: usize = 0, actions, texts, slots, changes, capacity, unlinked_merges_out|:
                action: RhObservedAction = actions[i]
                if action.kind == RH_ACTION_MERGE:
                    if action.change_id_start == action.change_id_end:
                        unlinked_merges_out[0] <- unlinked_merges_out[0] + 1
                    else:
                        hash: usize = hash_sview(string_view_slice(bytes_view(texts), action.change_id_start.usize(), action.change_id_end.usize())).usize() % capacity
                        slot: mutable usize = hash
                        while slots[slot] >= 0 |slot, slots, changes, texts, action|:
                            change_index: usize = slots[slot].usize()
                            if Base::rh_bytes_equal_span(texts, changes[change_index].id_start, changes[change_index].id_end, texts, action.change_id_start, action.change_id_end):
                                changes[change_index].has_merge <- true
                                break
                            slot <- (slot + 1) % capacity
                        if slots[slot] < 0:
                            changes.push(RhLinkedChange{id_start: action.change_id_start, id_end: action.change_id_end, has_merge: true, has_review: false})
                            slots[slot] <- changes.count.i64() - 1
                elif action.kind == RH_ACTION_REVIEW and action.change_id_start != action.change_id_end:
                    hash: usize = hash_sview(string_view_slice(bytes_view(texts), action.change_id_start.usize(), action.change_id_end.usize())).usize() % capacity
                    slot: mutable usize = hash
                    while slots[slot] >= 0 |slot, slots, changes, texts, action|:
                        change_index: usize = slots[slot].usize()
                        if Base::rh_bytes_equal_span(texts, changes[change_index].id_start, changes[change_index].id_end, texts, action.change_id_start, action.change_id_end):
                            changes[change_index].has_review <- true
                            break
                        slot <- (slot + 1) % capacity
                    if slots[slot] < 0:
                        changes.push(RhLinkedChange{id_start: action.change_id_start, id_end: action.change_id_end, has_merge: false, has_review: true})
                        slots[slot] <- changes.count.i64() - 1
                i <- i + 1
            while i < changes.count |i: usize = 0, changes, reviewed_out, linked_merges_out|:
                change: RhLinkedChange = changes[i]
                if change.has_merge:
                    linked_merges_out[0] <- linked_merges_out[0] + 1
                    reviewed_out[0] <- reviewed_out[0] + 1 if change.has_review
                i <- i + 1
            true
