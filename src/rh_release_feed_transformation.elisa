# Digest-bound field transformation report for release-only feeds.
include "./rh_base.elisa"

module ReleaseFeedTransformation:
    public:
        def rh_release_feed_transformation_report(configuration_sha: darray[u8]&, input_sha: darray[u8]&, output_sha: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"release-feed\",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-release-feed-result/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"release tags, publication times, targets, assets, and support metadata\",\"target\":\"releases\",\"state\":\"preserved\"},{\"source\":\"release counts, digest coverage, and cadence\",\"target\":\"metrics\",\"state\":\"transformed\"},{\"source\":\"missing publication and support times\",\"target\":\"release fields\",\"state\":\"unknown\"},{\"source\":\"release history and author identity\",\"target\":\"release-feed result\",\"state\":\"unsupported\"},{\"source\":\"unrecognized source fields and asset locators\",\"target\":\"public result\",\"state\":\"discarded\"}]}")
