# rh_experimental_report.elisa — M11 experimental isolation execution path
# (R024).
#
# Turns an `rh-experimental-input/1` document (specs + observations) into
# `rh-experimental-result/1`. A spec is admissible only when it is opt-in,
# in wave G, costed, and carries at least one explicit limit; the one sample
# metric `discontinuity.no_qualifying_release_in_horizon` reports an
# OBSERVABLE horizon outcome among subjects with complete follow-up. It is
# never called abandonment/reliability/unhealthy, it is labelled
# experimental, and it is excluded from the default policy path. Zero
# observable subjects is `not_applicable`/`null`, never a 0 rate. Malformed
# input fails closed.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_experimental.elisa"

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: i64 = e - s
    k: mutable i64 = 0
    while k < n |k, texts, lit, s|:
        if lit[k.usize()] == 0:
            return false
        if texts[(s + k).usize()] != lit[k.usize()]:
            return false
        k <- k + 1
    return lit[n.usize()] == 0

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_cost(texts: darray[u8]&, s: i64, e: i64) -> i64:
    if rh_xr_eq(texts, s, e, "low"):
        return 1
    if rh_xr_eq(texts, s, e, "medium"):
        return 2
    if rh_xr_eq(texts, s, e, "high"):
        return 3
    return -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_cost_label(c: i64) -> u8&:
    if c == 1:
        return "low"
    if c == 2:
        return "medium"
    return "high"

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_str(nodes: darray[RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    idx: i64 = rh_json_obj_get(nodes, texts, obj, key)
    if idx < 0:
        return false
    return rh_json_str_span(nodes, idx, s_out, e_out)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_int(nodes: darray[RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, default_v: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    ok: mutable i64 = 0
    v: i64 = rh_json_int(nodes, raw, rh_json_obj_get(nodes, texts, obj, key), &ok)
    if ok == 0:
        return default_v
    return v

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_bool(nodes: darray[RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, default_v: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    idx: i64 = rh_json_obj_get(nodes, texts, obj, key)
    if idx < 0:
        return default_v
    return rh_json_is_true(nodes, raw, idx)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_reason(spec: RhExperimentalSpec&) -> u8&:
    if spec.opt_in != 1:
        return "not-opt-in"
    if spec.wave != RH_EXP_WAVE_G:
        return "wrong-wave"
    if spec.cost < 1 or spec.cost > 3:
        return "no-cost"
    return "no-limits"

def rh_experimental_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = rh_json_parse(raw, nodes, texts)
    if root < 0 or nodes[root.usize()].kind != RH_JSON_OBJ:
        return -1
    sspan: mutable i64 = 0
    espan: mutable i64 = 0
    sc: i64 = rh_json_obj_get(nodes, texts, root, "schema")
    if sc < 0 or not rh_json_str_span(nodes, sc, &sspan, &espan):
        return -1
    if not rh_xr_eq(texts, sspan, espan, "rh-experimental-input/1"):
        return -1
    disc_key: u8& = "discontinuity.no_qualifying_release_in_horizon"
    admissible_disc: mutable bool = false
    pool: mutable darray[u8] = []
    k_starts: mutable darray[i64] = []
    k_ends: mutable darray[i64] = []
    waves: mutable darray[i64] = []
    costs: mutable darray[i64] = []
    limits: mutable darray[i64] = []
    optins: mutable darray[i64] = []
    adm: mutable darray[i64] = []
    sp_idx: i64 = rh_json_obj_get(nodes, texts, root, "specs")
    if sp_idx < 0 or nodes[sp_idx.usize()].kind != RH_JSON_ARR:
        return -1
    sparr: RhJsonNode = nodes[sp_idx.usize()]
    spc: mutable i64 = sparr.first_child
    while spc >= 0 |spc, nodes, texts, raw, pool, k_starts, k_ends, waves, costs, limits, optins, adm, admissible_disc, disc_key|:
        if nodes[spc.usize()].kind != RH_JSON_OBJ:
            return -1
        ks: mutable i64 = 0
        ke: mutable i64 = 0
        if not rh_xr_str(nodes, texts, spc, "key", &ks, &ke):
            return -1
        cs: mutable i64 = 0
        ce: mutable i64 = 0
        cost: mutable i64 = -1
        if rh_xr_str(nodes, texts, spc, "cost", &cs, &ce):
            cost <- rh_xr_cost(texts, cs, ce)
            if cost < 0:
                return -1
        wave: i64 = rh_xr_int(nodes, raw, texts, spc, "wave", 0)
        lim: mutable i64 = 0
        li: i64 = rh_json_obj_get(nodes, texts, spc, "limits")
        if li >= 0 and nodes[li.usize()].kind == RH_JSON_ARR:
            la: RhJsonNode = nodes[li.usize()]
            lc: mutable i64 = la.first_child
            while lc >= 0 |lc, nodes, lim|:
                lim <- lim + 1
                lc <- nodes[lc.usize()].next_sibling
        opt: mutable i64 = 0
        if rh_xr_bool(nodes, raw, texts, spc, "opt_in", false):
            opt <- 1
        start: i64 = pool.count.i64()
        k: mutable i64 = ks
        while k < ke |k, texts, pool, ke|:
            pool.push(texts[k.usize()])
            k <- k + 1
        k_starts.push(start)
        k_ends.push(pool.count.i64())
        waves.push(wave)
        costs.push(cost)
        limits.push(lim)
        optins.push(opt)
        spec: RhExperimentalSpec = RhExperimentalSpec{key_s: start, key_e: pool.count.i64(), wave: wave.u8(), cost: cost.u8(), limit_count: lim, opt_in: opt}
        a: i64 = rh_exp_admissible(&spec)
        adm.push(a)
        if a == 1 and rh_xr_eq(pool, start, pool.count.i64(), disc_key):
            admissible_disc <- true
        spc <- nodes[spc.usize()].next_sibling

    obs_idx: i64 = rh_json_obj_get(nodes, texts, root, "observations")
    outcomes: mutable darray[i64] = []
    if obs_idx >= 0:
        if nodes[obs_idx.usize()].kind != RH_JSON_ARR:
            return -1
        oarr: RhJsonNode = nodes[obs_idx.usize()]
        oc: mutable i64 = oarr.first_child
        while oc >= 0 |oc, nodes, raw, texts, outcomes|:
            if nodes[oc.usize()].kind != RH_JSON_OBJ:
                return -1
            fu: mutable i64 = 0
            qr: mutable i64 = 0
            if rh_xr_bool(nodes, raw, texts, oc, "follow_up_complete", false):
                fu <- 1
            if rh_xr_bool(nodes, raw, texts, oc, "qualifying_release_in_horizon", false):
                qr <- 1
            outcomes.push(rh_exp_discontinuity_outcome(fu, qr))
            oc <- nodes[oc.usize()].next_sibling
    wr: mutable i64 = 0
    wo: mutable i64 = 0
    cen: mutable i64 = 0
    den: mutable i64 = 0
    rh_exp_discontinuity_aggregate(outcomes, &wr, &wo, &cen, &den)

    rh_push_text(out, "{\"schema\":\"rh-experimental-result/1\",\"specs\":[")
    i: mutable i64 = 0
    while i < k_starts.count.i64() |i, k_starts, k_ends, waves, costs, limits, optins, adm, pool, out|:
        if i > 0:
            out.push(44)
        rh_push_text(out, "{\"key\":\"")
        rh_json_escape(out, pool, k_starts[i.usize()].usize(), k_ends[i.usize()].usize())
        rh_push_text(out, "\",\"wave\":")
        rh_push_decimal_i64(out, waves[i.usize()])
        rh_push_text(out, ",\"cost\":\"")
        rh_push_text(out, rh_xr_cost_label(costs[i.usize()]))
        rh_push_text(out, "\",\"limit_count\":")
        rh_push_decimal_i64(out, limits[i.usize()])
        rh_push_text(out, ",\"opt_in\":")
        if optins[i.usize()] == 1:
            rh_push_text(out, "true")
        else:
            rh_push_text(out, "false")
        rh_push_text(out, ",\"admissible\":")
        if adm[i.usize()] == 1:
            rh_push_text(out, "true")
        else:
            rh_push_text(out, "false")
        if adm[i.usize()] != 1:
            spec2: RhExperimentalSpec = RhExperimentalSpec{key_s: k_starts[i.usize()], key_e: k_ends[i.usize()], wave: waves[i.usize()].u8(), cost: costs[i.usize()].u8(), limit_count: limits[i.usize()], opt_in: optins[i.usize()]}
            rh_push_text(out, ",\"reason\":\"")
            rh_push_text(out, rh_xr_reason(&spec2))
            rh_push_text(out, "\"")
        rh_push_text(out, "}")
        i <- i + 1
    rh_push_text(out, "],\"metric\":{\"key\":\"")
    rh_push_text(out, disc_key)
    rh_push_text(out, "\",\"status\":\"")
    if not admissible_disc:
        rh_push_text(out, "unsupported\",\"reason\":\"no-admissible-experimental-spec\",\"value\":null")
    elif den == 0:
        rh_push_text(out, "not_applicable\",\"reason\":\"no-observable-subject\",\"value\":null")
    else:
        rh_push_text(out, "observed\",\"value\":{\"with_release\":")
        rh_push_decimal_i64(out, wr)
        rh_push_text(out, ",\"without_release\":")
        rh_push_decimal_i64(out, wo)
        rh_push_text(out, ",\"censored\":")
        rh_push_decimal_i64(out, cen)
        rh_push_text(out, ",\"denominator\":")
        rh_push_decimal_i64(out, den)
        rh_push_text(out, ",\"rate\":{\"num\":")
        rh_push_decimal_i64(out, wo)
        rh_push_text(out, ",\"den\":")
        rh_push_decimal_i64(out, den)
        rh_push_text(out, "}}")
    rh_push_text(out, "},\"label\":\"")
    rh_push_text(out, rh_exp_label())
    rh_push_text(out, "\",\"note\":\"experimental metrics are opt-in, costed, explicitly limited, and excluded from the default policy path; none-observed is a fact about the observation window, not a claim about the project; a censored subject is excluded from the denominator\"}")
    return 0
