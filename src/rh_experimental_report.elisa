# rh_experimental_report.elisa — M11 experimental isolation execution path
# (R024).
#
# Turns an `rh-experimental-input/1` document (specs + observations) into
# `rh-experimental-result/1`. A spec is admissible only when it is opt-in,
# in wave G, costed, and carries at least one explicit limit; the one sample
# metric `discontinuity.no_qualifying_release_in_horizon` reports an
# OBSERVABLE horizon outcome among subjects with complete follow-up. It is
# never called abandonment/reliability/unhealthy, it is labelled
# experimental, and it is excluded from the default policy path. Zero
# observable subjects is `not_applicable`/`null`, never a 0 rate. Malformed
# input fails closed.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_experimental.elisa"

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    rh_bytes_equal_literal(texts, s, e, lit)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_cost(texts: darray[u8]&, s: i64, e: i64) -> i64:
    return 1 if rh_xr_eq(texts, s, e, "low")
    return 2 if rh_xr_eq(texts, s, e, "medium")
    return 3 if rh_xr_eq(texts, s, e, "high")
    -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_cost_label(c: i64) -> u8&:
    return "low" if c == 1
    return "medium" if c == 2
    "high"

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
    return false if idx < 0
    Json::rh_json_str_span(nodes, idx, s_out, e_out)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, default_v: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
    ok: mutable i64 = 0
    v: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, obj, key), &ok)
    return default_v if ok == 0
    v

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_bool(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, default_v: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
    return default_v if idx < 0
    Json::rh_json_is_true(nodes, raw, idx)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_xr_reason(spec: Experimental::RhExperimentalSpec&) -> u8&:
    return "not-opt-in" if spec.opt_in != 1
    return "wrong-wave" if spec.wave != Experimental::RH_EXP_WAVE_G
    return "no-cost" if spec.cost < 1 or spec.cost > 3
    "no-limits"

def rh_experimental_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
    sspan: mutable i64 = 0
    espan: mutable i64 = 0
    sc: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
    return -1 if sc < 0 or not Json::rh_json_str_span(nodes, sc, &sspan, &espan)
    return -1 if not rh_xr_eq(texts, sspan, espan, "rh-experimental-input/1")
    disc_key: u8& = "discontinuity.no_qualifying_release_in_horizon"
    admissible_disc: mutable bool = false
    pool: mutable darray[u8] = []
    k_starts: mutable darray[i64] = []
    k_ends: mutable darray[i64] = []
    waves: mutable darray[i64] = []
    costs: mutable darray[i64] = []
    limits: mutable darray[i64] = []
    optins: mutable darray[i64] = []
    adm: mutable darray[i64] = []
    sp_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "specs")
    return -1 if sp_idx < 0 or nodes[sp_idx.usize()].kind != Json::RH_JSON_ARR
    sparr: Json::RhJsonNode = nodes[sp_idx.usize()]
    while spc >= 0 |spc: i64 = sparr.first_child, nodes, texts, raw, pool, k_starts, k_ends, waves, costs, limits, optins, adm, admissible_disc, disc_key|:
        return -1 if nodes[spc.usize()].kind != Json::RH_JSON_OBJ
        ks: mutable i64 = 0
        ke: mutable i64 = 0
        return -1 if not rh_xr_str(nodes, texts, spc, "key", &ks, &ke)
        cs: mutable i64 = 0
        ce: mutable i64 = 0
        cost: mutable i64 = -1
        if rh_xr_str(nodes, texts, spc, "cost", &cs, &ce):
            cost <- rh_xr_cost(texts, cs, ce)
            return -1 if cost < 0
        wave: i64 = rh_xr_int(nodes, raw, texts, spc, "wave", 0)
        lim: mutable i64 = 0
        li: i64 = Json::rh_json_obj_get(nodes, texts, spc, "limits")
        if li >= 0 and nodes[li.usize()].kind == Json::RH_JSON_ARR:
            la: Json::RhJsonNode = nodes[li.usize()]
            while lc >= 0 |lc: i64 = la.first_child, nodes, lim|:
                lim <- lim + 1
                lc <- nodes[lc.usize()].next_sibling
        opt: mutable i64 = 0
        if rh_xr_bool(nodes, raw, texts, spc, "opt_in", false):
            opt <- 1
        start: i64 = pool.count.i64()
        while k < ke |k: i64 = ks, texts, pool, ke|:
            pool.push(texts[k.usize()])
            k <- k + 1
        k_starts.push(start)
        k_ends.push(pool.count.i64())
        waves.push(wave)
        costs.push(cost)
        limits.push(lim)
        optins.push(opt)
        a: i64 = |pool, cost, lim, opt|
            spec: Experimental::RhExperimentalSpec = Experimental::RhExperimentalSpec{key_s: start, key_e: pool.count.i64(), wave: wave.u8(), cost: cost.u8(), limit_count: lim, opt_in: opt}
            block_result: i64 = Experimental::rh_exp_admissible(&spec)
            block_result
        adm.push(a)
        if a == 1 and rh_xr_eq(pool, start, pool.count.i64(), disc_key):
            admissible_disc <- true
        spc <- nodes[spc.usize()].next_sibling

    obs_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "observations")
    outcomes: mutable darray[i64] = []
    if obs_idx >= 0:
        return -1 if nodes[obs_idx.usize()].kind != Json::RH_JSON_ARR
        oarr: Json::RhJsonNode = nodes[obs_idx.usize()]
        while oc >= 0 |oc: i64 = oarr.first_child, nodes, raw, texts, outcomes|:
            return -1 if nodes[oc.usize()].kind != Json::RH_JSON_OBJ
            fu: mutable i64 = 0
            qr: mutable i64 = 0
            if rh_xr_bool(nodes, raw, texts, oc, "follow_up_complete", false):
                fu <- 1
            if rh_xr_bool(nodes, raw, texts, oc, "qualifying_release_in_horizon", false):
                qr <- 1
            outcomes.push(Experimental::rh_exp_discontinuity_outcome(fu, qr))
            oc <- nodes[oc.usize()].next_sibling
    wr: mutable i64 = 0
    wo: mutable i64 = 0
    cen: mutable i64 = 0
    den: mutable i64 = 0
    Experimental::rh_exp_discontinuity_aggregate(outcomes, &wr, &wo, &cen, &den)

    rh_push_text(out, "{\"schema\":\"rh-experimental-result/1\",\"specs\":[")
    while i < k_starts.count.i64() |i: i64 = 0, k_starts, k_ends, waves, costs, limits, optins, adm, pool, out|:
        if i > 0:
            out.push(44)
        rh_push_text(out, "{\"key\":\"")
        rh_json_escape(out, pool, k_starts[i.usize()].usize(), k_ends[i.usize()].usize())
        rh_push_text(out, "\",\"wave\":")
        rh_push_decimal_i64(out, waves[i.usize()])
        rh_push_text(out, ",\"cost\":\"")
        rh_push_text(out, rh_xr_cost_label(costs[i.usize()]))
        rh_push_text(out, "\",\"limit_count\":")
        rh_push_decimal_i64(out, limits[i.usize()])
        rh_push_text(out, ",\"opt_in\":")
        if optins[i.usize()] == 1:
            rh_push_text(out, "true")
        else:
            rh_push_text(out, "false")
        rh_push_text(out, ",\"admissible\":")
        if adm[i.usize()] == 1:
            rh_push_text(out, "true")
        else:
            rh_push_text(out, "false")
        if adm[i.usize()] != 1:
            spec2: Experimental::RhExperimentalSpec = Experimental::RhExperimentalSpec{key_s: k_starts[i.usize()], key_e: k_ends[i.usize()], wave: waves[i.usize()].u8(), cost: costs[i.usize()].u8(), limit_count: limits[i.usize()], opt_in: optins[i.usize()]}
            rh_push_text(out, ",\"reason\":\"")
            rh_push_text(out, rh_xr_reason(&spec2))
            rh_push_text(out, "\"")
        rh_push_text(out, "}")
        i <- i + 1
    rh_push_text(out, "],\"metric\":{\"key\":\"")
    rh_push_text(out, disc_key)
    rh_push_text(out, "\",\"status\":\"")
    if not admissible_disc:
        rh_push_text(out, "unsupported\",\"reason\":\"no-admissible-experimental-spec\",\"value\":null")
    elif den == 0:
        rh_push_text(out, "not_applicable\",\"reason\":\"no-observable-subject\",\"value\":null")
    else:
        rh_push_text(out, "observed\",\"value\":{\"with_release\":")
        rh_push_decimal_i64(out, wr)
        rh_push_text(out, ",\"without_release\":")
        rh_push_decimal_i64(out, wo)
        rh_push_text(out, ",\"censored\":")
        rh_push_decimal_i64(out, cen)
        rh_push_text(out, ",\"denominator\":")
        rh_push_decimal_i64(out, den)
        rh_push_text(out, ",\"rate\":{\"num\":")
        rh_push_decimal_i64(out, wo)
        rh_push_text(out, ",\"den\":")
        rh_push_decimal_i64(out, den)
        rh_push_text(out, "}}")
    rh_push_text(out, "},\"label\":\"")
    rh_push_text(out, Experimental::rh_exp_label())
    rh_push_text(out, "\",\"note\":\"experimental metrics are opt-in, costed, explicitly limited, and excluded from the default policy path; none-observed is a fact about the observation window, not a claim about the project; a censored subject is excluded from the denominator\"}")
    0
