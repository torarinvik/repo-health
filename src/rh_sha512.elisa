# rh_sha512.elisa — SHA-512 and SRI-compatible Base64 digests (FIPS 180-4).

include "./rh_base.elisa"

module Sha512:
    private:
        def rh_sha512_rotr(value: u64, amount: u32) -> u64:
            (value >> amount) | (value << (64 - amount))

        def rh_sha512_h(index: i64) -> u64:
            return 0x6a09e667f3bcc908 if index == 0
            return 0xbb67ae8584caa73b if index == 1
            return 0x3c6ef372fe94f82b if index == 2
            return 0xa54ff53a5f1d36f1 if index == 3
            return 0x510e527fade682d1 if index == 4
            return 0x9b05688c2b3e6c1f if index == 5
            return 0x1f83d9abfb41bd6b if index == 6
            0x5be0cd19137e2179

        def rh_sha512_k(index: i64) -> u64:
            return 0x428a2f98d728ae22 if index == 0
            return 0x7137449123ef65cd if index == 1
            return 0xb5c0fbcfec4d3b2f if index == 2
            return 0xe9b5dba58189dbbc if index == 3
            return 0x3956c25bf348b538 if index == 4
            return 0x59f111f1b605d019 if index == 5
            return 0x923f82a4af194f9b if index == 6
            return 0xab1c5ed5da6d8118 if index == 7
            return 0xd807aa98a3030242 if index == 8
            return 0x12835b0145706fbe if index == 9
            return 0x243185be4ee4b28c if index == 10
            return 0x550c7dc3d5ffb4e2 if index == 11
            return 0x72be5d74f27b896f if index == 12
            return 0x80deb1fe3b1696b1 if index == 13
            return 0x9bdc06a725c71235 if index == 14
            return 0xc19bf174cf692694 if index == 15
            return 0xe49b69c19ef14ad2 if index == 16
            return 0xefbe4786384f25e3 if index == 17
            return 0x0fc19dc68b8cd5b5 if index == 18
            return 0x240ca1cc77ac9c65 if index == 19
            return 0x2de92c6f592b0275 if index == 20
            return 0x4a7484aa6ea6e483 if index == 21
            return 0x5cb0a9dcbd41fbd4 if index == 22
            return 0x76f988da831153b5 if index == 23
            return 0x983e5152ee66dfab if index == 24
            return 0xa831c66d2db43210 if index == 25
            return 0xb00327c898fb213f if index == 26
            return 0xbf597fc7beef0ee4 if index == 27
            return 0xc6e00bf33da88fc2 if index == 28
            return 0xd5a79147930aa725 if index == 29
            return 0x06ca6351e003826f if index == 30
            return 0x142929670a0e6e70 if index == 31
            return 0x27b70a8546d22ffc if index == 32
            return 0x2e1b21385c26c926 if index == 33
            return 0x4d2c6dfc5ac42aed if index == 34
            return 0x53380d139d95b3df if index == 35
            return 0x650a73548baf63de if index == 36
            return 0x766a0abb3c77b2a8 if index == 37
            return 0x81c2c92e47edaee6 if index == 38
            return 0x92722c851482353b if index == 39
            return 0xa2bfe8a14cf10364 if index == 40
            return 0xa81a664bbc423001 if index == 41
            return 0xc24b8b70d0f89791 if index == 42
            return 0xc76c51a30654be30 if index == 43
            return 0xd192e819d6ef5218 if index == 44
            return 0xd69906245565a910 if index == 45
            return 0xf40e35855771202a if index == 46
            return 0x106aa07032bbd1b8 if index == 47
            return 0x19a4c116b8d2d0c8 if index == 48
            return 0x1e376c085141ab53 if index == 49
            return 0x2748774cdf8eeb99 if index == 50
            return 0x34b0bcb5e19b48a8 if index == 51
            return 0x391c0cb3c5c95a63 if index == 52
            return 0x4ed8aa4ae3418acb if index == 53
            return 0x5b9cca4f7763e373 if index == 54
            return 0x682e6ff3d6b2b8a3 if index == 55
            return 0x748f82ee5defb2fc if index == 56
            return 0x78a5636f43172f60 if index == 57
            return 0x84c87814a1f0ab72 if index == 58
            return 0x8cc702081a6439ec if index == 59
            return 0x90befffa23631e28 if index == 60
            return 0xa4506cebde82bde9 if index == 61
            return 0xbef9a3f7b2c67915 if index == 62
            return 0xc67178f2e372532b if index == 63
            return 0xca273eceea26619c if index == 64
            return 0xd186b8c721c0c207 if index == 65
            return 0xeada7dd6cde0eb1e if index == 66
            return 0xf57d4f7fee6ed178 if index == 67
            return 0x06f067aa72176fba if index == 68
            return 0x0a637dc5a2c898a6 if index == 69
            return 0x113f9804bef90dae if index == 70
            return 0x1b710b35131c471b if index == 71
            return 0x28db77f523047d84 if index == 72
            return 0x32caab7b40c72493 if index == 73
            return 0x3c9ebe0a15c9bebc if index == 74
            return 0x431d67c49c100d4c if index == 75
            return 0x4cc5d4becb3e42b6 if index == 76
            return 0x597f299cfc657e2a if index == 77
            return 0x5fcb6fab3ad6faec if index == 78
            0x6c44198c4a475817

        def rh_sha512_be64(block: darray[u8]&, start: usize) -> u64:
            (block[start].u64() << 56) | (block[start + 1].u64() << 48) | (block[start + 2].u64() << 40) | (block[start + 3].u64() << 32) | (block[start + 4].u64() << 24) | (block[start + 5].u64() << 16) | (block[start + 6].u64() << 8) | block[start + 7].u64()

        def rh_sha512_push_be64(out: mutable darray[u8]&, value: u64) -> void:
            while byte_index >= 0 |byte_index: i64 = 7, out, value|:
                shift: u64 = (byte_index * 8).u64()
                out.push(((value >> shift) & 255).u8())
                byte_index <- byte_index - 1

        def rh_sha512_block(block: darray[u8]&, start: usize, state: mutable darray[u64]&) -> void can[Memory.Allocate, Abort.Panic]:
            words: mutable darray[u64] = []
            while index < 80 |index: i64 = 0, words, block, start|:
                if index < 16:
                    words.push(rh_sha512_be64(block, start + (index * 8).usize()))
                else:
                    x: u64 = words[(index - 15).usize()]
                    y: u64 = words[(index - 2).usize()]
                    sigma0: u64 = rh_sha512_rotr(x, 1) ^ rh_sha512_rotr(x, 8) ^ (x >> 7)
                    sigma1: u64 = rh_sha512_rotr(y, 19) ^ rh_sha512_rotr(y, 61) ^ (y >> 6)
                    words.push(words[(index - 16).usize()] + sigma0 + words[(index - 7).usize()] + sigma1)
                index <- index + 1
            a, b, c, d, e, f, g, h =
                while round < 80 |a: u64 = state[0], b: u64 = state[1], c: u64 = state[2], d: u64 = state[3], e: u64 = state[4], f: u64 = state[5], g: u64 = state[6], h: u64 = state[7], round: i64 = 0, words| -> a, b, c, d, e, f, g, h:
                    big_sigma1: u64 = rh_sha512_rotr(e, 14) ^ rh_sha512_rotr(e, 18) ^ rh_sha512_rotr(e, 41)
                    not_e: u64 = e ^ 0xffffffffffffffff
                    choose: u64 = (e & f) ^ (not_e & g)
                    temp1: u64 = h + big_sigma1 + choose + rh_sha512_k(round) + words[round.usize()]
                    big_sigma0: u64 = rh_sha512_rotr(a, 28) ^ rh_sha512_rotr(a, 34) ^ rh_sha512_rotr(a, 39)
                    majority: u64 = (a & b) ^ (a & c) ^ (b & c)
                    temp2: u64 = big_sigma0 + majority
                    h <- g
                    g <- f
                    f <- e
                    e <- d + temp1
                    d <- c
                    c <- b
                    b <- a
                    a <- temp1 + temp2
                    round <- round + 1
            state[0] <- state[0] + a
            state[1] <- state[1] + b
            state[2] <- state[2] + c
            state[3] <- state[3] + d
            state[4] <- state[4] + e
            state[5] <- state[5] + f
            state[6] <- state[6] + g
            state[7] <- state[7] + h

        def rh_sha512_digest(data: darray[u8]&, digest: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            padded: mutable darray[u8] =
                padded: mutable darray[u8] = []
                padded.extend(bytes_view(data))
                padded.push(128)
                padded
            while padded.count % 128 != 112 |padded|:
                padded.push(0)
            while high_length_bytes < 8 |high_length_bytes: i64 = 0, padded|:
                padded.push(0)
                high_length_bytes <- high_length_bytes + 1
            bit_length: u64 = data.count.u64() * 8
            while byte_index >= 0 |byte_index: i64 = 7, padded, bit_length|:
                shift: u64 = (byte_index * 8).u64()
                padded.push(((bit_length >> shift) & 255).u8())
                byte_index <- byte_index - 1
            state: mutable darray[u64] = []
            while index < 8 |index: i64 = 0, state|:
                state.push(rh_sha512_h(index))
                index <- index + 1
            while offset < padded.count |offset: usize = 0, padded, state|:
                rh_sha512_block(padded, offset, state)
                offset <- offset + 128
            while index < 8 |index: i64 = 0, state, digest|:
                rh_sha512_push_be64(digest, state[index.usize()])
                index <- index + 1

    public:
        def rh_sha512(data: darray[u8]&, out_hex: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            digest: mutable darray[u8] = []
            Sha512::rh_sha512_digest(data, digest)
            while index < digest.count |index: usize = 0, digest, out_hex|:
                byte: u8 = digest[index]
                hi: u64 = (byte >> 4).u64()
                lo: u64 = (byte & 15).u64()
                out_hex.push((48 + hi).u8()) if hi < 10
                out_hex.push((87 + hi).u8()) if hi >= 10
                out_hex.push((48 + lo).u8()) if lo < 10
                out_hex.push((87 + lo).u8()) if lo >= 10
                index <- index + 1

        def rh_sha512_base64(data: darray[u8]&, out_base64: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            digest: mutable darray[u8] = []
            Sha512::rh_sha512_digest(data, digest)
            alphabet: u8& = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            while index < digest.count |index: usize = 0, digest, out_base64, alphabet|:
                a: u32 = digest[index].u32()
                has_b: bool = index + 1 < digest.count
                has_c: bool = index + 2 < digest.count
                b: mutable u32 = 0
                c: mutable u32 = 0
                b <- digest[index + 1].u32() if has_b
                c <- digest[index + 2].u32() if has_c
                triplet: u32 = (a << 16) | (b << 8) | c
                out_base64.push(alphabet[((triplet >> 18) & 63).usize()])
                out_base64.push(alphabet[((triplet >> 12) & 63).usize()])
                out_base64.push(alphabet[((triplet >> 6) & 63).usize()]) if has_b
                out_base64.push(61) if not has_b
                out_base64.push(alphabet[(triplet & 63).usize()]) if has_c
                out_base64.push(61) if not has_c
                index <- index + 3
