# Narrow POSIX process bridge; argv/env are NUL-delimited, never shell text.
include "./rh_base.elisa"
extern rh_process_run(executable: cstr, argv_flat: cstr, env_flat: cstr, input_data: cstr, input_length: usize, stdout_path: cstr, stderr_path: cstr, max_output_bytes: usize, timeout_ms: i32, code_out: mutable i32&) -> i32

module Process:
    public:
        const RH_PROCESS_TIMEOUT_MS: i32 = 120000
        const RH_PROCESS_MAX_OUTPUT_BYTES: usize = 67108864

        enum RhProcessKind:
            Exit
            Timeout
            OutputLimit
            SetupError
            Signal
            IoError
            CapacityLimit

        struct RhProcessResult:
            kind: RhProcessKind
            code: i32

        def rh_append_arg(buffer: mutable darray[u8]&, value: u8&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(buffer, value)
            buffer.push(0)

        def rh_append_arg_bytes(buffer: mutable darray[u8]&, value: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            for index in 0..<value.count |buffer, value|:
                buffer.push(value[index])
            buffer.push(0)

        def rh_succeeded(result: RhProcessResult) -> bool:
            result.kind == RhProcessKind.Exit and result.code == 0

        def rh_setup_error(code: i32) -> RhProcessResult:
            RhProcessResult{kind: RhProcessKind.SetupError, code: code}

    public:
        def rh_run_with_timeout(executable: cstr, argv: darray[u8]&, env: darray[u8]&, stdout_path: cstr, stderr_path: cstr, timeout_ms: i32) -> RhProcessResult can[Unsafe.PointerCast]:
            input: mutable darray[u8] = []
            Process::rh_run_with_input_timeout(executable, argv, env, input, stdout_path, stderr_path, timeout_ms)

        def rh_run_with_output_limit(executable: cstr, argv: darray[u8]&, env: darray[u8]&, stdout_path: cstr, stderr_path: cstr, max_output_bytes: usize, timeout_ms: i32) -> RhProcessResult can[Unsafe.PointerCast]:
            input: mutable darray[u8] = []
            Process::rh_run_with_input_limits(executable, argv, env, input, stdout_path, stderr_path, max_output_bytes, timeout_ms)

        def rh_run_with_input_timeout(executable: cstr, argv: darray[u8]&, env: darray[u8]&, input: darray[u8]&, stdout_path: cstr, stderr_path: cstr, timeout_ms: i32) -> RhProcessResult can[Unsafe.PointerCast]:
            Process::rh_run_with_input_limits(executable, argv, env, input, stdout_path, stderr_path, RH_PROCESS_MAX_OUTPUT_BYTES, timeout_ms)

    private:
        def rh_run_with_input_limits(executable: cstr, argv: darray[u8]&, env: darray[u8]&, input: darray[u8]&, stdout_path: cstr, stderr_path: cstr, max_output_bytes: usize, timeout_ms: i32) -> RhProcessResult can[Unsafe.PointerCast]:
            return Process::rh_setup_error(22) if argv.count == 0 or argv[argv.count - 1] != 0 or env.count == 0 or env[env.count - 1] != 0
            argv_ptr: cstr = (&argv[0]).cast[cstr] can Unsafe.PointerCast
            env_ptr: cstr = (&env[0]).cast[cstr] can Unsafe.PointerCast
            input_ptr: mutable cstr = (&input[0]).cast[cstr] can Unsafe.PointerCast if input.count > 0 else ""
            code: mutable i32 = 0
            kind_code: i32 = rh_process_run(executable, argv_ptr, env_ptr, input_ptr, input.count, stdout_path, stderr_path, max_output_bytes, timeout_ms, &code)
            kind: RhProcessKind =
                if kind_code == 0: RhProcessKind.Exit
                elif kind_code == 1: RhProcessKind.Timeout
                elif kind_code == 2: RhProcessKind.OutputLimit
                elif kind_code == 3: RhProcessKind.SetupError
                elif kind_code == 4: RhProcessKind.Signal
                elif kind_code == 5: RhProcessKind.IoError
                else: RhProcessKind.CapacityLimit
            RhProcessResult{kind: kind, code: code}

    public:
        def rh_run(executable: cstr, argv: darray[u8]&, env: darray[u8]&, stdout_path: cstr, stderr_path: cstr) -> RhProcessResult can[Unsafe.PointerCast]:
            Process::rh_run_with_timeout(executable, argv, env, stdout_path, stderr_path, RH_PROCESS_TIMEOUT_MS)
