# Narrow POSIX process bridge; argv/env are NUL-delimited, never shell text.
include "./rh_base.elisa"
extern rh_process_run(executable: cstr, argv_flat: cstr, env_flat: cstr, stdout_path: cstr, stderr_path: cstr, timeout_ms: i32) -> i32

module Process:
    public:
        const RH_PROCESS_TIMEOUT_MS: i32 = 120000

        def rh_append_arg(buffer: mutable darray[u8]&, value: u8&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(buffer, value)
            buffer.push(0)

        def rh_run_with_timeout(executable: cstr, argv: darray[u8]&, env: darray[u8]&, stdout_path: cstr, stderr_path: cstr, timeout_ms: i32) -> i32 can[Unsafe.PointerCast]:
            return -1 if argv.count == 0 or argv[argv.count - 1] != 0 or env.count == 0 or env[env.count - 1] != 0
            argv_ptr: cstr = (&argv[0]).cast[cstr] can Unsafe.PointerCast
            env_ptr: cstr = (&env[0]).cast[cstr] can Unsafe.PointerCast
            rh_process_run(executable, argv_ptr, env_ptr, stdout_path, stderr_path, timeout_ms)

        def rh_run(executable: cstr, argv: darray[u8]&, env: darray[u8]&, stdout_path: cstr, stderr_path: cstr) -> i32 can[Unsafe.PointerCast]:
            Process::rh_run_with_timeout(executable, argv, env, stdout_path, stderr_path, RH_PROCESS_TIMEOUT_MS)
