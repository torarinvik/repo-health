# rh_domain.elisa — opaque identity types (M00-02).
#
# Plan §5.2/M00-02: opaque IDs for projects, repositories, accounts,
# revisions, packages, package versions, artifacts, evidence, graph
# snapshots, and metric definitions. Source-native IDs are preserved
# separately (RhNativeRef). A raw string is never reused as an identity in
# application code: constructors take typed components, and equality is
# kind-aware (a project id never equals an account id even if the low bits
# match — account != person, contributor != maintainer by construction).

# Identity kinds. Numeric order is stable and serialized; append-only.

module Domain:
    public:
        const RH_KIND_PROJECT: u8 = 0
        const RH_KIND_REPOSITORY: u8 = 1
        const RH_KIND_ACCOUNT: u8 = 2
        const RH_KIND_PERSON: u8 = 3
        const RH_KIND_REVISION: u8 = 4
        const RH_KIND_PACKAGE: u8 = 5
        const RH_KIND_PACKAGE_VERSION: u8 = 6
        const RH_KIND_ARTIFACT: u8 = 7
        const RH_KIND_EVIDENCE: u8 = 8
        const RH_KIND_GRAPH_SNAPSHOT: u8 = 9
        const RH_KIND_METRIC_DEF: u8 = 10
        const RH_KIND_HOST_INSTANCE: u8 = 11

        # Revision reference kinds: tag != release != branch != commit, always.
        const RH_REF_COMMIT: u8 = 0
        const RH_REF_TAG: u8 = 1
        const RH_REF_BRANCH: u8 = 2
        const RH_REF_RELEASE: u8 = 3

        # Dependency edge kinds: requirement != resolved edge, always.
        const RH_EDGE_REQUIREMENT: u8 = 0
        const RH_EDGE_RESOLVED: u8 = 1

        # Finding kinds: reachability != exploitability; signature != safety.
        const RH_FIND_REACHABLE: u8 = 0
        const RH_FIND_EXPLOITABLE: u8 = 1
        const RH_FIND_SIG_VERIFIED: u8 = 2
        const RH_FIND_CODE_SAFE: u8 = 3

        # Source families for native references.
        const RH_SRC_GIT: u8 = 0
        const RH_SRC_GITHUB: u8 = 1
        const RH_SRC_GITLAB: u8 = 2
        const RH_SRC_FORGEJO: u8 = 3
        const RH_SRC_GITEA: u8 = 4
        const RH_SRC_OTHER: u8 = 255

        struct RhId:
            kind: u8
            high: u64
            low: u64

        # Nominal wrappers keep otherwise identical 128-bit identifiers from
        # crossing domain boundaries accidentally. The tagged RhId remains the
        # compact shared representation at serialization and index boundaries.
        struct RhProjectId:
            id: RhId

        struct RhRepositoryId:
            id: RhId

        struct RhAccountId:
            id: RhId

        struct RhPersonId:
            id: RhId

        struct RhRevisionId:
            id: RhId

        struct RhPackageId:
            id: RhId

        struct RhPackageVersionId:
            id: RhId

        struct RhArtifactId:
            id: RhId

        struct RhEvidenceId:
            id: RhId

        struct RhGraphSnapshotId:
            id: RhId

        struct RhMetricDefinitionId:
            id: RhId

        struct RhHostInstanceId:
            id: RhId

        struct RhNativeRef:
            source_kind: u8
            object_kind: u8
            host_instance: RhHostInstanceId
            high: u64
            low: u64

        struct RhRevisionRef:
            ref_kind: u8
            revision: RhRevisionId

        struct RhArtifact:
            id: RhArtifactId
            digest_algo: u8
            digest_high: u64
            digest_low: u64

        const RH_DIGEST_FNV1A64: u8 = 1
        const RH_DIGEST_SHA256_TRUNC: u8 = 2

        def rh_id_make(kind: u8, high: u64, low: u64) -> RhId:
            RhId{kind: kind, high: high, low: low}

        def rh_id_valid(id: RhId) -> bool:
            id.kind <= RH_KIND_HOST_INSTANCE

        def rh_project_id_make(high: u64, low: u64) -> RhProjectId:
            RhProjectId{id: rh_id_make(RH_KIND_PROJECT, high, low)}

        def rh_repository_id_make(high: u64, low: u64) -> RhRepositoryId:
            RhRepositoryId{id: rh_id_make(RH_KIND_REPOSITORY, high, low)}

        def rh_account_id_make(high: u64, low: u64) -> RhAccountId:
            RhAccountId{id: rh_id_make(RH_KIND_ACCOUNT, high, low)}

        def rh_person_id_make(high: u64, low: u64) -> RhPersonId:
            RhPersonId{id: rh_id_make(RH_KIND_PERSON, high, low)}

        def rh_revision_id_make(high: u64, low: u64) -> RhRevisionId:
            RhRevisionId{id: rh_id_make(RH_KIND_REVISION, high, low)}

        def rh_package_id_make(high: u64, low: u64) -> RhPackageId:
            RhPackageId{id: rh_id_make(RH_KIND_PACKAGE, high, low)}

        def rh_package_version_id_make(high: u64, low: u64) -> RhPackageVersionId:
            RhPackageVersionId{id: rh_id_make(RH_KIND_PACKAGE_VERSION, high, low)}

        def rh_artifact_id_make(high: u64, low: u64) -> RhArtifactId:
            RhArtifactId{id: rh_id_make(RH_KIND_ARTIFACT, high, low)}

        def rh_evidence_id_make(high: u64, low: u64) -> RhEvidenceId:
            RhEvidenceId{id: rh_id_make(RH_KIND_EVIDENCE, high, low)}

        def rh_graph_snapshot_id_make(high: u64, low: u64) -> RhGraphSnapshotId:
            RhGraphSnapshotId{id: rh_id_make(RH_KIND_GRAPH_SNAPSHOT, high, low)}

        def rh_metric_definition_id_make(high: u64, low: u64) -> RhMetricDefinitionId:
            RhMetricDefinitionId{id: rh_id_make(RH_KIND_METRIC_DEF, high, low)}

        def rh_host_instance_id_make(high: u64, low: u64) -> RhHostInstanceId:
            RhHostInstanceId{id: rh_id_make(RH_KIND_HOST_INSTANCE, high, low)}

        def rh_id_kind(id: RhId) -> u8:
            id.kind

        # Kind-aware equality: different kinds are never equal.
        def rh_id_equal(a: RhId, b: RhId) -> bool:
            return false if not rh_id_valid(a) or not rh_id_valid(b)
            return false if a.kind != b.kind
            return false if a.high != b.high
            a.low == b.low

        def rh_native_make(source_kind: u8, object_kind: u8, host_instance: RhHostInstanceId, high: u64, low: u64) -> RhNativeRef:
            RhNativeRef{source_kind: source_kind, object_kind: object_kind, host_instance: host_instance, high: high, low: low}

        def rh_native_valid(ref: RhNativeRef) -> bool:
            return false if not rh_id_valid(ref.host_instance.id) or ref.host_instance.id.kind != RH_KIND_HOST_INSTANCE
            ref.source_kind == RH_SRC_GIT or ref.source_kind == RH_SRC_GITHUB or ref.source_kind == RH_SRC_GITLAB or ref.source_kind == RH_SRC_FORGEJO or ref.source_kind == RH_SRC_GITEA or ref.source_kind == RH_SRC_OTHER

        def rh_native_equal(a: RhNativeRef, b: RhNativeRef) -> bool:
            return false if not rh_native_valid(a) or not rh_native_valid(b)
            return false if a.source_kind != b.source_kind or a.object_kind != b.object_kind or a.high != b.high or a.low != b.low
            rh_id_equal(a.host_instance.id, b.host_instance.id)

        def rh_revision_make(ref_kind: u8, revision: RhRevisionId) -> RhRevisionRef:
            RhRevisionRef{ref_kind: ref_kind, revision: revision}

        def rh_revision_valid(ref: RhRevisionRef) -> bool:
            return false if ref.ref_kind > RH_REF_RELEASE or not rh_id_valid(ref.revision.id)
            ref.revision.id.kind == RH_KIND_REVISION

        def rh_artifact_make(id: RhArtifactId, algo: u8, digest_high: u64, digest_low: u64) -> RhArtifact:
            RhArtifact{id: id, digest_algo: algo, digest_high: digest_high, digest_low: digest_low}

        def rh_artifact_valid(artifact: RhArtifact) -> bool:
            return false if not rh_id_valid(artifact.id.id) or artifact.id.id.kind != RH_KIND_ARTIFACT
            artifact.digest_algo == RH_DIGEST_FNV1A64 or artifact.digest_algo == RH_DIGEST_SHA256_TRUNC
