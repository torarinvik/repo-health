include "./rh_base.elisa"
include "./rh_process.elisa"

module Git:
    public:
        # rh_git.elisa — safe Git acquisition (M01-01/02/03).
        #
        # M01-01: rh_url_kind classifies local paths, public https remotes, and
        # everything else (unsupported). All Git, VCS, resolver, and transport
        # subprocesses use the bounded argv process bridge.
        # M01-03: acquisition uses plumbing only
        # (`log --format`, `rev-parse`); never checkout/clone-with-hooks/archive,
        # so no source-provided command ever runs (S001). Bounded by default
        # (RH_DEFAULT_MAX_COMMITS) with an explicit full-history mode.




        const RH_URL_LOCAL: u8 = 0
        const RH_URL_HTTPS: u8 = 1
        const RH_URL_UNSUPPORTED: u8 = 2

        const RH_DEFAULT_MAX_COMMITS: i64 = 20000

        def rh_append_parent_env(env: mutable darray[u8]&, key: u8&, name: cstr) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            value: u8&? = getenv(name)
            return if value == null
            path: cstr = value.cast[cstr] can Unsafe.PointerCast
            return if Base::rh_cstr_len_c(path) > 4096
            Base::rh_push_text(env, key)
            env.push(61)
            Base::rh_push_cstr(env, path)
            env.push(0)

        def rh_process_env() -> mutable darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            env: mutable darray[u8] = []
            path: u8&? = getenv("PATH")
            use_parent_path: mutable bool = false
            if path != null:
                path_ptr: cstr = path.cast[cstr] can Unsafe.PointerCast
                use_parent_path <- Base::rh_cstr_len_c(path_ptr) <= 4096
            if use_parent_path:
                Git::rh_append_parent_env(env, "PATH", "PATH")
            else:
                Process::rh_append_arg(env, "PATH=/usr/bin:/bin:/usr/local/bin:/opt/homebrew/bin")
            Process::rh_append_arg(env, "LC_ALL=C")
            Process::rh_append_arg(env, "GIT_CONFIG_NOSYSTEM=1")
            Process::rh_append_arg(env, "GIT_CONFIG_GLOBAL=/dev/null")
            Process::rh_append_arg(env, "GIT_TERMINAL_PROMPT=0")
            Git::rh_append_parent_env(env, "RH_HG_FIXTURE", "RH_HG_FIXTURE")
            Git::rh_append_parent_env(env, "RH_SVN_FIXTURE", "RH_SVN_FIXTURE")
            Git::rh_append_parent_env(env, "RH_FOSSIL_FIXTURE", "RH_FOSSIL_FIXTURE")
            Git::rh_append_parent_env(env, "RH_TEST_SYSTEM_PYTHON", "RH_TEST_SYSTEM_PYTHON")
            Git::rh_append_parent_env(env, "RH_TEST_DNS_ADDRESSES", "RH_TEST_DNS_ADDRESSES")
            env.push(0)
            env

        def rh_transport_env() -> mutable darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            base_env: mutable darray[u8] = Git::rh_process_env()
            env: mutable darray[u8] = []
            for index in 0..<(base_env.count - 1) |index: usize = 0, base_env, env|:
                env.push(base_env[index])
            Git::rh_append_parent_env(env, "RH_CURL_BODY", "RH_CURL_BODY")
            Git::rh_append_parent_env(env, "RH_CURL_COLLABORATORS_PAGE1", "RH_CURL_COLLABORATORS_PAGE1")
            Git::rh_append_parent_env(env, "RH_CURL_COLLABORATORS_PAGE2", "RH_CURL_COLLABORATORS_PAGE2")
            Git::rh_append_parent_env(env, "RH_CURL_COLLABORATORS_PAGE3", "RH_CURL_COLLABORATORS_PAGE3")
            Git::rh_append_parent_env(env, "RH_CURL_CONFIG_LOG", "RH_CURL_CONFIG_LOG")
            Git::rh_append_parent_env(env, "RH_CURL_GITLAB_ISSUES", "RH_CURL_GITLAB_ISSUES")
            Git::rh_append_parent_env(env, "RH_CURL_GITLAB_ISSUES_PAGE2", "RH_CURL_GITLAB_ISSUES_PAGE2")
            Git::rh_append_parent_env(env, "RH_CURL_GITLAB_MERGE_REQUESTS", "RH_CURL_GITLAB_MERGE_REQUESTS")
            Git::rh_append_parent_env(env, "RH_CURL_GITLAB_MERGE_REQUESTS_PAGE2", "RH_CURL_GITLAB_MERGE_REQUESTS_PAGE2")
            Git::rh_append_parent_env(env, "RH_CURL_GITLAB_PAGE1", "RH_CURL_GITLAB_PAGE1")
            Git::rh_append_parent_env(env, "RH_CURL_GITLAB_PAGE2", "RH_CURL_GITLAB_PAGE2")
            Git::rh_append_parent_env(env, "RH_CURL_GITLAB_RELEASES", "RH_CURL_GITLAB_RELEASES")
            Git::rh_append_parent_env(env, "RH_CURL_GITLAB_RELEASES_PAGE2", "RH_CURL_GITLAB_RELEASES_PAGE2")
            Git::rh_append_parent_env(env, "RH_CURL_HTTP_STATUS", "RH_CURL_HTTP_STATUS")
            Git::rh_append_parent_env(env, "RH_CURL_ISSUES_PAGE1", "RH_CURL_ISSUES_PAGE1")
            Git::rh_append_parent_env(env, "RH_CURL_LOG", "RH_CURL_LOG")
            Git::rh_append_parent_env(env, "RH_CURL_PAGE2", "RH_CURL_PAGE2")
            Git::rh_append_parent_env(env, "RH_CURL_PAGE3", "RH_CURL_PAGE3")
            Git::rh_append_parent_env(env, "RH_CURL_PULLS_PAGE1", "RH_CURL_PULLS_PAGE1")
            Git::rh_append_parent_env(env, "RH_CURL_RELEASES_PAGE1", "RH_CURL_RELEASES_PAGE1")
            Git::rh_append_parent_env(env, "RH_CURL_REPO_PULLS_PAGE1", "RH_CURL_REPO_PULLS_PAGE1")
            Git::rh_append_parent_env(env, "RH_CURL_REPO_PULLS_PAGE2", "RH_CURL_REPO_PULLS_PAGE2")
            Git::rh_append_parent_env(env, "RH_CURL_REPO_REVIEW_7_PAGE1", "RH_CURL_REPO_REVIEW_7_PAGE1")
            Git::rh_append_parent_env(env, "RH_CURL_REPO_REVIEW_7_PAGE2", "RH_CURL_REPO_REVIEW_7_PAGE2")
            Git::rh_append_parent_env(env, "RH_CURL_REPO_REVIEW_8_PAGE1", "RH_CURL_REPO_REVIEW_8_PAGE1")
            Git::rh_append_parent_env(env, "RH_CURL_REPO_REVIEW_9_PAGE1", "RH_CURL_REPO_REVIEW_9_PAGE1")
            Git::rh_append_parent_env(env, "RH_CURL_REVIEWS_PAGE1", "RH_CURL_REVIEWS_PAGE1")
            Git::rh_append_parent_env(env, "RH_CURL_STATUS", "RH_CURL_STATUS")
            Git::rh_append_parent_env(env, "RH_GLP_ISSUES_BODY", "RH_GLP_ISSUES_BODY")
            Git::rh_append_parent_env(env, "RH_GLP_ISSUES_HTTP", "RH_GLP_ISSUES_HTTP")
            Git::rh_append_parent_env(env, "RH_GLP_MERGE_REQUESTS_BODY", "RH_GLP_MERGE_REQUESTS_BODY")
            Git::rh_append_parent_env(env, "RH_GLP_MERGE_REQUESTS_HTTP", "RH_GLP_MERGE_REQUESTS_HTTP")
            Git::rh_append_parent_env(env, "RH_GLP_RELEASES_BODY", "RH_GLP_RELEASES_BODY")
            Git::rh_append_parent_env(env, "RH_GLP_RELEASES_HTTP", "RH_GLP_RELEASES_HTTP")
            Git::rh_append_parent_env(env, "RH_BITBUCKET_BODY", "RH_BITBUCKET_BODY")
            Git::rh_append_parent_env(env, "RH_TEST_CURL_LOG", "RH_TEST_CURL_LOG")
            Git::rh_append_parent_env(env, "RH_PROBE_ARRAY_BODY", "RH_PROBE_ARRAY_BODY")
            Git::rh_append_parent_env(env, "RH_PROBE_BODY", "RH_PROBE_BODY")
            Git::rh_append_parent_env(env, "RH_PROBE_COLLABORATORS_BODY", "RH_PROBE_COLLABORATORS_BODY")
            Git::rh_append_parent_env(env, "RH_PROBE_CURL_ARGS", "RH_PROBE_CURL_ARGS")
            Git::rh_append_parent_env(env, "RH_PROBE_CURL_CONFIG", "RH_PROBE_CURL_CONFIG")
            Git::rh_append_parent_env(env, "RH_PROBE_HTTP", "RH_PROBE_HTTP")
            Git::rh_append_parent_env(env, "RH_PROBE_ISSUES_BODY", "RH_PROBE_ISSUES_BODY")
            Git::rh_append_parent_env(env, "RH_PROBE_ISSUES_HTTP", "RH_PROBE_ISSUES_HTTP")
            Git::rh_append_parent_env(env, "RH_PROBE_PULLS_BODY", "RH_PROBE_PULLS_BODY")
            Git::rh_append_parent_env(env, "RH_PROBE_PULLS_HTTP", "RH_PROBE_PULLS_HTTP")
            Git::rh_append_parent_env(env, "RH_PROBE_RELEASES_BODY", "RH_PROBE_RELEASES_BODY")
            Git::rh_append_parent_env(env, "RH_PROBE_RELEASES_HTTP", "RH_PROBE_RELEASES_HTTP")
            Git::rh_append_parent_env(env, "RH_PROBE_REVIEW_BODY", "RH_PROBE_REVIEW_BODY")
            Git::rh_append_parent_env(env, "RH_PROBE_REVIEW_HTTP", "RH_PROBE_REVIEW_HTTP")
            Git::rh_append_parent_env(env, "RH_PROBE_TRAFFIC_HTTP", "RH_PROBE_TRAFFIC_HTTP")
            Git::rh_append_parent_env(env, "RH_PROBE_COLLABORATORS_HTTP", "RH_PROBE_COLLABORATORS_HTTP")
            Git::rh_append_parent_env(env, "RH_BITBUCKET_HTTP", "RH_BITBUCKET_HTTP")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_HTTP", "OSV_QUERY_FAKE_HTTP")
            Git::rh_append_parent_env(env, "OSV_QUERY_CAPTURE", "OSV_QUERY_CAPTURE")
            Git::rh_append_parent_env(env, "OSV_QUERY_REQUEST_CAPTURE", "OSV_QUERY_REQUEST_CAPTURE")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_RESPONSE", "OSV_QUERY_FAKE_RESPONSE")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_ENDPOINT", "OSV_QUERY_FAKE_ENDPOINT")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_VULN_RESPONSE", "OSV_QUERY_FAKE_VULN_RESPONSE")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_VULN_HTTP", "OSV_QUERY_FAKE_VULN_HTTP")
            Git::rh_append_parent_env(env, "OSV_QUERY_PAGE1", "OSV_QUERY_PAGE1")
            Git::rh_append_parent_env(env, "OSV_QUERY_PAGE2", "OSV_QUERY_PAGE2")
            Git::rh_append_parent_env(env, "OSV_QUERY_PAGE3", "OSV_QUERY_PAGE3")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_PAGE2_RESPONSE", "OSV_QUERY_FAKE_PAGE2_RESPONSE")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_PAGE2_HTTP", "OSV_QUERY_FAKE_PAGE2_HTTP")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_PAGE3_RESPONSE", "OSV_QUERY_FAKE_PAGE3_RESPONSE")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_PAGE3_HTTP", "OSV_QUERY_FAKE_PAGE3_HTTP")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_PAGE4_RESPONSE", "OSV_QUERY_FAKE_PAGE4_RESPONSE")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_PAGE4_HTTP", "OSV_QUERY_FAKE_PAGE4_HTTP")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_BATCH_PAGE2_RESPONSE", "OSV_QUERY_FAKE_BATCH_PAGE2_RESPONSE")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_BATCH_PAGE3_RESPONSE", "OSV_QUERY_FAKE_BATCH_PAGE3_RESPONSE")
            Git::rh_append_parent_env(env, "OSV_QUERY_FAKE_BATCH_PAGE4_RESPONSE", "OSV_QUERY_FAKE_BATCH_PAGE4_RESPONSE")
            Git::rh_append_parent_env(env, "ECOSYSTEM_LOOKUP_CURL_CAPTURE", "ECOSYSTEM_LOOKUP_CURL_CAPTURE")
            Git::rh_append_parent_env(env, "ECOSYSTEM_LOOKUP_FAKE_BODY", "ECOSYSTEM_LOOKUP_FAKE_BODY")
            Git::rh_append_parent_env(env, "ECOSYSTEM_LOOKUP_FAKE_HTTP", "ECOSYSTEM_LOOKUP_FAKE_HTTP")
            env.push(0)
            env

        def rh_url_kind(url: cstr) -> u8 can[Memory.Allocate, Abort.Panic]:
            return RH_URL_UNSUPPORTED if Base::rh_cstr_len_c(url) == 0
            return RH_URL_HTTPS if Base::rh_cstr_starts_with(url, "https://")
            return RH_URL_UNSUPPORTED if Base::rh_cstr_has_scheme(url)
            return RH_URL_UNSUPPORTED if Base::rh_cstr_starts_with(url, "git@")
            RH_URL_LOCAL

        # Restrict repository and evidence paths to a portable byte alphabet;
        # transport URLs have their own semantic policy below.
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_byte_allowed(b: u8) -> bool:
            return true if b >= 48 and b <= 57
            return true if b >= 65 and b <= 90
            return true if b >= 97 and b <= 122
            return true if b == 47
            return true if b == 46
            return true if b == 58
            return true if b == 95
            return true if b == 45
            return true if b == 43
            false

        def rh_arg_safe(s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if Base::rh_cstr_len_c(s) == 0
            while true |i: usize = 0, s|:
                b: u8 = s[i]
                break if b == 0
                return false if not rh_byte_allowed(b)
                i <- i + 1
            true

        # Join dir + "/" + name into out (NUL-terminated). False on empty dir.
        def rh_join_path(dir: cstr, name: u8&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if Base::rh_cstr_len_c(dir) == 0
            Base::rh_push_cstr(out, dir)
            out.push(47)
            Base::rh_push_text(out, name)
            out.push(0)
            true

        # Retain raw author fields and Git's project-local .mailmap result in one
        # pinned log record. Global/system mailmap configuration and configured
        # external mailmap paths are excluded; the tracked/worktree .mailmap is
        # the only identity correction applied here.
        def rh_run_git_log(repo: cstr, out_file: cstr, err_file: cstr, full_history: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "git")
            Process::rh_append_arg(args, "-c")
            Process::rh_append_arg(args, "core.pager=cat")
            Process::rh_append_arg(args, "-c")
            Process::rh_append_arg(args, "core.quotepath=false")
            Process::rh_append_arg(args, "-c")
            Process::rh_append_arg(args, "mailmap.file=/dev/null")
            Process::rh_append_arg(args, "-c")
            Process::rh_append_arg(args, "mailmap.blob=")
            Process::rh_append_arg(args, "-C")
            Process::rh_append_arg(args, repo.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "log")
            Process::rh_append_arg(args, "--all")
            Process::rh_append_arg(args, "--no-decorate")
            Process::rh_append_arg(args, "--mailmap")
            Process::rh_append_arg(args, "--format=%H%x01%an%x01%ae%x01%at%x01%ct%x01%P%x01%aN%x01%aE%x00")
            if not full_history:
                limit: mutable darray[u8] = []
                Base::rh_push_text(limit, "--max-count=")
                Base::rh_push_decimal_i64(limit, RH_DEFAULT_MAX_COMMITS)
                limit.push(0)
                for i in 0..<limit.count |i, limit, args|:
                    args.push(limit[i])
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            Process::rh_run("/usr/bin/git", args, env, out_file, err_file).i64()

        # Run: git -C '<repo>' rev-list --count HEAD > '<out>' 2> '<err>'.
        # The retained count is the default-branch reachability projection;
        # `rh_run_git_log` above deliberately covers all recorded refs.
        def rh_run_git_default_count(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "git")
            Process::rh_append_arg(args, "-C")
            Process::rh_append_arg(args, repo.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "rev-list")
            Process::rh_append_arg(args, "--count")
            Process::rh_append_arg(args, "HEAD")
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            Process::rh_run("/usr/bin/git", args, env, out_file, err_file).i64()

        # Run: git -C '<repo>' -c core.quotepath=false ls-tree -r -l -z HEAD.
        # NUL-delimited long records retain blob sizes alongside paths so source
        # byte metrics can be replayed from the snapshot without reading a worktree.
        def rh_run_git_files(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "git")
            Process::rh_append_arg(args, "-c")
            Process::rh_append_arg(args, "core.quotepath=false")
            Process::rh_append_arg(args, "-C")
            Process::rh_append_arg(args, repo.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "ls-tree")
            Process::rh_append_arg(args, "-r")
            Process::rh_append_arg(args, "-l")
            Process::rh_append_arg(args, "-z")
            Process::rh_append_arg(args, "HEAD")
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            Process::rh_run("/usr/bin/git", args, env, out_file, err_file).i64()

        # Run: git -C '<repo>' rev-parse --is-shallow-repository > '<out>' 2> '<err>'
        def rh_run_git_shallow(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "git")
            Process::rh_append_arg(args, "-C")
            Process::rh_append_arg(args, repo.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "rev-parse")
            Process::rh_append_arg(args, "--is-shallow-repository")
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            Process::rh_run("/usr/bin/git", args, env, out_file, err_file).i64()

        # Run: git -C '<repo>' config --get extensions.partialClone > '<out>'
        # 2> '<err>'. A configured partial clone may be missing blobs, so
        # blob-derived metrics must be reported partial rather than complete
        # (F004). Exit is nonzero when the extension is absent (not a partial
        # clone); the caller reads the file, not the exit code.
        def rh_run_git_partial(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "git")
            Process::rh_append_arg(args, "-C")
            Process::rh_append_arg(args, repo.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "config")
            Process::rh_append_arg(args, "--get")
            Process::rh_append_arg(args, "extensions.partialClone")
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            Process::rh_run("/usr/bin/git", args, env, out_file, err_file).i64()

        # Run: git -C '<repo>' rev-parse --verify --quiet HEAD (0 iff the repo has
        # at least one commit). Distinguishes observed-empty history (F001) from a
        # genuine collection failure: empty is reported, never errored.
        def rh_run_git_head(repo: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "git")
            Process::rh_append_arg(args, "-C")
            Process::rh_append_arg(args, repo.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "rev-parse")
            Process::rh_append_arg(args, "--verify")
            Process::rh_append_arg(args, "--quiet")
            Process::rh_append_arg(args, "HEAD")
            Process::rh_append_arg(args, "--")
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            Process::rh_run("/usr/bin/git", args, env, "/dev/null", err_file).i64()

        # Run: git --version > '<out>' 2> '<err>' (evidence capture, M01-05).
        def rh_run_git_version(out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "git")
            Process::rh_append_arg(args, "--version")
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            Process::rh_run("/usr/bin/git", args, env, out_file, err_file).i64()

        # Run: mkdir -p '<dir>' (evidence/report tree setup; path pre-validated).
        def rh_ensure_dir(dir: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(dir)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "mkdir")
            Process::rh_append_arg(args, "-p")
            Process::rh_append_arg(args, dir.cast[u8&] can Unsafe.PointerCast)
            args.push(0)
            env: mutable darray[u8] = []
            Process::rh_append_arg(env, "PATH=/usr/bin:/bin")
            Process::rh_append_arg(env, "LC_ALL=C")
            env.push(0)
            Process::rh_run("/bin/mkdir", args, env, "/dev/null", "/dev/null")

        # Run: sort -u '<src>' -o '<dst>' (identity dedup; POSIX sort, no hashing
        # of personhood implied — raw strings in, unique raw strings out).
        def rh_run_sort_uniq(src_file: cstr, dst_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(src_file)
            return -1 if not rh_arg_safe(dst_file)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "sort")
            Process::rh_append_arg(args, "-u")
            Process::rh_append_arg(args, src_file.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "-o")
            Process::rh_append_arg(args, dst_file.cast[u8&] can Unsafe.PointerCast)
            args.push(0)
            env: mutable darray[u8] = []
            Process::rh_append_arg(env, "PATH=/usr/bin:/bin")
            Process::rh_append_arg(env, "LC_ALL=C")
            env.push(0)
            Process::rh_run("/usr/bin/sort", args, env, "/dev/null", err_file)

        # Native M08 history adapters use fixed machine-oriented output formats and
        # the same path allowlist as the Git runner. Each command writes raw source
        # evidence and a separate stderr capture; callers parse the retained bytes
        # only after the command exits successfully.
        def rh_run_hg_log(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "hg")
            Process::rh_append_arg(args, "--cwd")
            Process::rh_append_arg(args, repo.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "log")
            Process::rh_append_arg(args, "-Tjson")
            Process::rh_append_arg(args, "--limit=20000")
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            Process::rh_run("hg", args, env, out_file, err_file).i64()

        def rh_run_svn_log(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "svn")
            Process::rh_append_arg(args, "log")
            Process::rh_append_arg(args, "--xml")
            Process::rh_append_arg(args, "-v")
            Process::rh_append_arg(args, "--limit")
            Process::rh_append_arg(args, "20000")
            Process::rh_append_arg(args, repo.cast[u8&] can Unsafe.PointerCast)
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            Process::rh_run("svn", args, env, out_file, err_file).i64()

        def rh_run_fossil_timeline(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "fossil")
            Process::rh_append_arg(args, "timeline")
            Process::rh_append_arg(args, "-R")
            Process::rh_append_arg(args, repo.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "-F")
            Process::rh_append_arg(args, "%H|%a|%d|%b|%p|%t|%c")
            Process::rh_append_arg(args, "-n")
            Process::rh_append_arg(args, "20000")
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            Process::rh_run("fossil", args, env, out_file, err_file).i64()

        # --- Fetch policy (S002/S003). Two layers, both must pass before any
        # network/file access:
        # (1) rh_fetch_guard: semantic policy. https or file scheme only (file =
        # recorded fixtures / controlled local inputs, never a confused deputy:
        # the caller names the fixture). No userinfo ('@'), no percent-escapes in
        # the host, no ports, no IPv6 brackets, no bare "localhost", no IPv4
        # loopback/private/link-local literals. Public IPv4 literals pass.
        # DNS is checked by rh_prepare_https_pin before an HTTPS request: the
        # complete resolver answer set is vetted and passed to curl --resolve.
        # This URL-only guard remains side-effect free.
        # (2) rh_fetch_arg_safe rejects controls and shell-like delimiter bytes
        # from transport URLs, preserving a small, auditable public URL surface.
        def rh_fetch_arg_safe(s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = Base::rh_cstr_len_c(s)
            return false if n == 0
            while true |i: usize = 0, s|:
                b: u8 = s[i]
                break if b == 0
                return false if b < 32 or b == 127
                return false if b == 39 or b == 96 or b == 36 or b == 92
                i <- i + 1
            true

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_host_is_v4_literal(host_start: usize, host_end: usize, s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < host_end |i: usize = host_start, s, host_end|:
                b: u8 = s[i]
                return false if (b < 48 or b > 57) and b != 46
                i <- i + 1
            true

        # Parse dotted quad at [start,end) into o0..o3. ok_out 1/0.
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_parse_v4(s: cstr, start: usize, end: usize, o0: mutable i64&, o1: mutable i64&, o2: mutable i64&, o3: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            parts, cur, digits, lz =
                while i < end |parts: i64 = 0, cur: i64 = 0, digits: i64 = 0, lz: i64 = 0, i: usize = start, o0, o1, o2, o3| -> parts, cur, digits, lz:
                    b: u8 = s[i]
                    if b >= 48 and b <= 57:
                        if digits == 0 and b == 48:
                            lz <- 1
                        cur <- cur * 10 + (b - 48).i64()
                        return false if cur > 255
                        digits <- digits + 1
                    elif b == 46:
                        if digits == 0:
                            return false
                        # Leading zeros make some resolvers read the octet as octal
                        # (0177.0.0.1 -> 127.0.0.1); reject rather than guess (S002).
                        return false if lz == 1 and digits > 1
                        if parts == 0:
                            o0[0] <- cur
                        elif parts == 1:
                            o1[0] <- cur
                        elif parts == 2:
                            o2[0] <- cur
                        else:
                            return false
                        parts <- parts + 1
                        cur <- 0
                        digits <- 0
                        lz <- 0
                    else:
                        return false
                    i <- i + 1
            return false if parts != 3 or digits == 0
            return false if lz == 1 and digits > 1
            o3[0] <- cur
            true

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_v4_blocked(a: i64, b: i64, c: i64) -> bool:
            return true if a == 127
            return true if a == 10
            return true if a == 172 and b >= 16 and b <= 31
            return true if a == 192 and b == 168
            return true if a == 169 and b == 254
            if a == 0:
                return true
            # Shared/CGNAT (100.64/10), benchmark (198.18/15), IETF protocol
            # assignments and documentation/retired special-purpose blocks.
            # A public crawler has no business reaching these (S002).
            return true if a == 100 and b >= 64 and b <= 127
            if a == 198 and (b == 18 or b == 19):
                return true
            # Conservative: block the enclosing 192.0.0.0/16 rather than rely
            # on the special-purpose exceptions within the IETF assignment.
            return true if a == 192 and b == 0
            return true if a == 192 and b == 88 and c == 99
            return true if a == 198 and b == 51 and c == 100
            return true if a == 203 and b == 0 and c == 113
            return true if a >= 224
            false

        # Hostname charset: letters, digits, hyphen, dot only; no empty label and
        # no leading/trailing hyphen. Rejects underscores and stray punctuation so
        # resolver-specific extensions cannot expand the attack surface.
        # (private to this file)
        def rh_host_chars_ok(start: usize, end: usize, s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            label_start: usize =
                while i < end |label_start: usize = start, i: usize = start| -> label_start:
                    b: u8 = s[i]
                    ok: bool = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 45
                    return false if not ok and b != 46
                    if b == 46:
                        return false if i == label_start
                        prev: u8 = s[i - 1]
                        return false if prev == 45
                        label_start <- i + 1
                    i <- i + 1
            return false if label_start == end
            last: u8 = s[end - 1]
            return false if last == 45
            true

        # Numeric-obfuscated hosts some resolvers accept but this policy must not:
        # "0x..." hex labels and zero-padded decimal labels. Fail closed (S002).
        # (private to this file)
        def rh_host_obfuscated(start: usize, end: usize, s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < end |i: usize = start, at_label: bool = true, s, end|:
                b: u8 = s[i]
                if b == 46:
                    at_label <- true
                else:
                    if at_label and b == 48 and i + 1 < end:
                        nxt: u8 = s[i + 1]
                        return true if nxt == 120 or nxt == 88
                        return true if nxt >= 48 and nxt <= 57
                    at_label <- false
                i <- i + 1
            false

        def rh_fetch_guard(url: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            is_https: bool = Base::rh_cstr_starts_with(url, "https://")
            is_file: bool = Base::rh_cstr_starts_with(url, "file://")
            return false if not is_https and not is_file
            n: usize = Base::rh_cstr_len_c(url)
            if is_file:
                return false if n < 9
                return false if url[7] != 47
                return true
            base: mutable usize = 8
            return false if base >= n
            hend: mutable usize =
                while hend < n |hend: usize = base| -> hend:
                    c: u8 = url[hend]
                    break if c == 47 or c == 63 or c == 35
                    hend <- hend + 1
            return false if hend == base
            while hi < hend |hi: usize = base, url, hend|:
                h: u8 = url[hi]
                return false if h == 64 or h == 37 or h == 91 or h == 93 or h == 58
                hi <- hi + 1
            if rh_host_is_v4_literal(base, hend, url):
                a0: mutable i64 = 0
                a1: mutable i64 = 0
                a2: mutable i64 = 0
                a3: mutable i64 = 0
                return false if not rh_parse_v4(url, base, hend, &a0, &a1, &a2, &a3)
                return false if rh_v4_blocked(a0, a1, a2)
                return true
            return false if not rh_host_chars_ok(base, hend, url)
            return false if rh_host_obfuscated(base, hend, url)
            while dj < hend |dotted: bool = false, dj: usize = base, hend| -> dotted:
                if url[dj] == 46:
                    dotted <- true
                dj <- dj + 1

    private:
        const RH_GITHUB_REST_API_VERSION: u8& = "2026-03-10"

        # Parse colon-delimited IPv6 hextets into a bounded word list. Empty
        # parts, non-hex bytes, overlong hextets, and more than eight words fail.
        def rh_v6_parse_groups(ip: cstr, start: usize, end: usize, words: mutable InlineVec[i64, 8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if start == end
            value: mutable i64 = 0
            digits: mutable i64 = 0
            while i < end |i: usize = start, ip, end, words, value, digits|:
                b: u8 = ip[i]
                if b == 58:
                    return false if digits == 0 or words.len >= 8
                    inline_vec_push[i64, 8](words, value)
                    value <- 0
                    digits <- 0
                else:
                    if b >= 48 and b <= 57:
                        value <- value * 16 + (b - 48).i64()
                    elif b >= 65 and b <= 70:
                        value <- value * 16 + (b - 55).i64()
                    elif b >= 97 and b <= 102:
                        value <- value * 16 + (b - 87).i64()
                    else:
                        return false
                    digits <- digits + 1
                    return false if digits > 4
                i <- i + 1
            return false if digits == 0 or words.len >= 8
            inline_vec_push[i64, 8](words, value)
            true

        # Validate both compressed and full IPv6 forms. The input bound and
        # eight-word output cap keep parsing constant-sized for attacker input.
        def rh_v6_parse(ip: cstr, length: usize, words: mutable InlineVec[i64, 8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if length < 2 or length > 39
            compression: mutable i64 = -1
            while i + 1 < length |i: usize = 0, ip, length, compression|:
                if ip[i] == 58 and ip[i + 1] == 58:
                    return false if compression >= 0
                    compression <- i.i64()
                    i <- i + 2
                else:
                    i <- i + 1
            if compression < 0:
                return false if not rh_v6_parse_groups(ip, 0, length, words)
                return words.len == 8
            left: mutable InlineVec[i64, 8] = inline_vec[i64, 8](&perm_arena)
            right: mutable InlineVec[i64, 8] = inline_vec[i64, 8](&perm_arena)
            left_end: usize = compression.usize()
            right_start: usize = left_end + 2
            return false if not rh_v6_parse_groups(ip, 0, left_end, left)
            return false if not rh_v6_parse_groups(ip, right_start, length, right)
            return false if left.len + right.len >= 8
            while i < left.len |i: usize = 0, left, words|:
                inline_vec_push[i64, 8](words, inline_vec_get[i64, 8](left, i))
                i <- i + 1
            zero_count: usize = 8 - left.len - right.len
            while i < zero_count |i: usize = 0, words|:
                inline_vec_push[i64, 8](words, 0)
                i <- i + 1
            while i < right.len |i: usize = 0, right, words|:
                inline_vec_push[i64, 8](words, inline_vec_get[i64, 8](right, i))
                i <- i + 1
            true

    public:
        # Second phase of transport policy (M07-02): a resolved address, checked
        # before connecting. It rejects private, scoped,
        # mapped, malformed, documentation, and other non-global address forms.
        def rh_addr_guard(ip: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = Base::rh_cstr_len_c(ip)
            return false if n == 0
            has_colon: bool =
                while i < n |has_colon: bool = false, i: usize = 0| -> has_colon:
                    if ip[i] == 58:
                        has_colon <- true
                    i <- i + 1
            if not has_colon:
                a0: mutable i64 = 0
                a1: mutable i64 = 0
                a2: mutable i64 = 0
                a3: mutable i64 = 0
                return false if not rh_parse_v4(ip, 0, n, &a0, &a1, &a2, &a3)
                return false if rh_v4_blocked(a0, a1, a2)
                return true
            words: mutable InlineVec[i64, 8] = inline_vec[i64, 8](&perm_arena)
            return false if not rh_v6_parse(ip, n, words)
            w0: i64 = inline_vec_get[i64, 8](words, 0)
            w1: i64 = inline_vec_get[i64, 8](words, 1)
            w5: i64 = inline_vec_get[i64, 8](words, 5)
            w7: i64 = inline_vec_get[i64, 8](words, 7)
            zero_prefix: bool =
                while i < 7 |zero: bool = true, i: usize = 0, words| -> zero:
                    if inline_vec_get[i64, 8](words, i) != 0:
                        zero <- false
                    i <- i + 1
            return false if zero_prefix and (w7 == 0 or w7 == 1)
            mapped_prefix: bool =
                while i < 5 |mapped: bool = true, i: usize = 0, words| -> mapped:
                    if inline_vec_get[i64, 8](words, i) != 0:
                        mapped <- false
                    i <- i + 1
            return false if mapped_prefix and w5 == 0xffff
            return false if w0 >= 0xfe80 and w0 <= 0xfebf
            return false if w0 >= 0xfec0 and w0 <= 0xfeff
            return false if w0 >= 0xfc00 and w0 <= 0xfdff
            return false if w0 >= 0xff00
            return false if (w0 & 0xe000) != 0x2000
            # IANA's 2001::/23 protocol-assignment block contains individual
            # exceptions; reject the enclosing range conservatively for SSRF.
            return false if w0 == 0x2001 and w1 < 0x0200
            return false if w0 == 0x2001 and w1 == 0x0db8
            return false if w0 == 0x3fff and (w1 & 0xf000) == 0
            return false if w0 == 0x2002
            true

    private:
        # Read and validate one bounded resolver result, then render the
        # address set in cURL's host:port:address-list form.
        def rh_append_resolved_addresses(resolved_file: cstr, host: cstr, pin: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            file_size: i64 = Base::rh_file_size(resolved_file)
            return false if file_size <= 0 or file_size > 2048
            addresses: mutable darray[u8] = []
            return false if Base::rh_io_read(resolved_file, addresses) != file_size
            Base::rh_push_cstr(pin, host)
            Base::rh_push_text(pin, ":443:")
            address_count: mutable i64 = 0
            while start < addresses.count |start: usize = 0, addresses, pin, address_count|:
                newline: i64 = Base::rh_find_byte(addresses, start, 10)
                line_end: mutable usize = newline.usize() if newline >= 0 else addresses.count
                return false if line_end <= start or address_count >= 32
                ip: mutable darray[u8] = []
                has_colon: mutable bool = false
                while i < line_end |i: usize = start, addresses, line_end, ip, has_colon|:
                    b: u8 = addresses[i]
                    return false if b == 0
                    has_colon <- true if b == 58
                    ip.push(b)
                    i <- i + 1
                ip.push(0)
                ip_ptr: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
                return false if not rh_addr_guard(ip_ptr)
                pin.push(44) if address_count > 0
                pin.push(91) if has_colon
                Base::rh_push_cstr(pin, ip_ptr)
                pin.push(93) if has_colon
                address_count <- address_count + 1
                if newline < 0:
                    start <- addresses.count
                else:
                    start <- newline.usize() + 1
            return false if address_count == 0
            pin.push(0)
            true

        # Build a bounded cURL --resolve value from the resolver's complete
        # address set. Rejecting the whole set prevents a public answer from
        # hiding a private answer that cURL might otherwise select.
        def rh_prepare_https_pin(url: cstr, err_file: cstr, pin: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            n: usize = Base::rh_cstr_len_c(url)
            host_end: mutable usize = 8
            while host_end < n |host_end, url, n|:
                c: u8 = url[host_end]
                break if c == 47 or c == 63 or c == 35
                host_end <- host_end + 1
            return false if host_end <= 8
            host: mutable darray[u8] =
                host: mutable darray[u8] = []
                while i < host_end |i: usize = 8, host, url, host_end|:
                    host.push(url[i])
                    i <- i + 1
                host.push(0)
                host
            host_ptr: cstr = (&host[0]).cast[cstr] can Unsafe.PointerCast
            resolved_file: mutable darray[u8] =
                resolved_file: mutable darray[u8] = []
                Base::rh_push_cstr(resolved_file, err_file)
                Base::rh_push_text(resolved_file, ".resolved")
                resolved_file.push(0)
                resolved_file
            resolved_ptr: cstr = (&resolved_file[0]).cast[cstr] can Unsafe.PointerCast
            _ = remove_file(resolved_ptr)

            script: mutable darray[u8] = []
            Base::rh_push_text(script, "import socket, sys, threading\n")
            Base::rh_push_text(script, "answers = []; failures = []\n")
            Base::rh_push_text(script, "def resolve():\n")
            Base::rh_push_text(script, "    try: answers.extend(socket.getaddrinfo(sys.argv[1], 443, type=socket.SOCK_STREAM, proto=socket.IPPROTO_TCP))\n")
            Base::rh_push_text(script, "    except Exception as error: failures.append(error)\n")
            Base::rh_push_text(script, "worker = threading.Thread(target=resolve, daemon=True)\n")
            Base::rh_push_text(script, "worker.start(); worker.join(10)\n")
            Base::rh_push_text(script, "if worker.is_alive() or failures: raise SystemExit(1)\n")
            Base::rh_push_text(script, "addresses = list(dict.fromkeys(answer[4][0] for answer in answers))\n")
            Base::rh_push_text(script, "if not addresses or len(addresses) > 32: raise SystemExit(1)\n")
            Base::rh_push_text(script, "sys.stdout.write(\"\\n\".join(addresses) + \"\\n\")\n")
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "python3")
            Process::rh_append_arg(args, "-I")
            Process::rh_append_arg(args, "-S")
            Process::rh_append_arg(args, "-c")
            Process::rh_append_arg_bytes(args, script)
            Process::rh_append_arg(args, host_ptr.cast[u8&] can Unsafe.PointerCast)
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            resolve_status: i32 = Process::rh_run("python3", args, env, resolved_ptr, err_file)
            if resolve_status != 0:
                _ = remove_file(resolved_ptr)
                return false

            pin_valid: bool = rh_append_resolved_addresses(resolved_ptr, host_ptr, pin)
            _ = remove_file(resolved_ptr)
            pin_valid

        # GitHub credentials are used only for its exact public API host. The
        # restricted token alphabet keeps curl's config syntax unambiguous.
        def rh_github_api_auth_state(url: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return 0 if not Base::rh_cstr_starts_with(url, "https://api.github.com/")
            token: u8&? = getenv("RH_GITHUB_TOKEN")
            return 0 if token == null
            token_ptr: cstr = token.cast[cstr] can Unsafe.PointerCast
            length: usize = Base::rh_cstr_len_c(token_ptr)
            return -1 if length == 0 or length > 512
            while index < length |index: usize = 0, token_ptr|:
                byte: u8 = token_ptr[index]
                return -1 if not ((byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 45 or byte == 95)
                index <- index + 1
            1

        # GitLab credentials are scoped to its exact public REST API host.
        def rh_gitlab_api_auth_state(url: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return 0 if not Base::rh_cstr_starts_with(url, "https://gitlab.com/api/v4/")
            token: u8&? = getenv("RH_GITLAB_TOKEN")
            return 0 if token == null
            token_ptr: cstr = token.cast[cstr] can Unsafe.PointerCast
            length: usize = Base::rh_cstr_len_c(token_ptr)
            return -1 if length == 0 or length > 512
            while index < length |index: usize = 0, token_ptr|:
                byte: u8 = token_ptr[index]
                return -1 if not ((byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 45 or byte == 95)
                index <- index + 1
            1

        # Assemble the fixed transport policy in one private helper so the
        # public operation only validates, prepares the pin, and runs it.
        def rh_https_get_args(args: mutable darray[u8]&, input: mutable darray[u8]&, url: cstr, body_file: cstr, pin: darray[u8]&, max_secs: i64, api_kind: i64, api_auth: bool) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            Process::rh_append_arg(args, "curl")
            Process::rh_append_arg(args, "--disable")
            if api_auth:
                Process::rh_append_arg(args, "--config")
                Process::rh_append_arg(args, "-")
                if api_kind == 1:
                    token: u8&? = getenv("RH_GITHUB_TOKEN")
                    return if token == null
                    Base::rh_push_text(input, "header = \"Authorization: Bearer ")
                    Base::rh_push_cstr(input, token.cast[cstr] can Unsafe.PointerCast)
                    Base::rh_push_text(input, "\"\n")
                elif api_kind == 2:
                    token: u8&? = getenv("RH_GITLAB_TOKEN")
                    return if token == null
                    Base::rh_push_text(input, "header = \"PRIVATE-TOKEN: ")
                    Base::rh_push_cstr(input, token.cast[cstr] can Unsafe.PointerCast)
                    Base::rh_push_text(input, "\"\n")
            Process::rh_append_arg(args, "-sS")
            Process::rh_append_arg(args, "--noproxy")
            Process::rh_append_arg(args, "*")
            Process::rh_append_arg(args, "--proto")
            Process::rh_append_arg(args, "=https,file")
            Process::rh_append_arg(args, "--max-redirs")
            Process::rh_append_arg(args, "0")
            if pin.count > 0:
                Process::rh_append_arg(args, "--resolve")
                Process::rh_append_arg(args, (&pin[0]).cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "--max-time")
            seconds: mutable darray[u8] = []
            Base::rh_push_decimal_i64(seconds, max_secs)
            Process::rh_append_arg_bytes(args, seconds)
            Process::rh_append_arg(args, "--max-filesize")
            size: mutable darray[u8] = []
            Base::rh_push_decimal_i64(size, RH_FETCH_MAX_BYTES)
            Process::rh_append_arg_bytes(args, size)
            Process::rh_append_arg(args, "-H")
            Process::rh_append_arg(args, "User-Agent: repo-health/0.2.0 (+https://github.com/torarinvik/repo-health/issues)")
            Process::rh_append_arg(args, "-H")
            Process::rh_append_arg(args, "Accept: application/json")
            if api_kind == 1:
                header: mutable darray[u8] = []
                Base::rh_push_text(header, "X-GitHub-Api-Version: ")
                Base::rh_push_text(header, RH_GITHUB_REST_API_VERSION)
                Process::rh_append_arg(args, "-H")
                Process::rh_append_arg_bytes(args, header)
            Process::rh_append_arg(args, "-o")
            Process::rh_append_arg(args, body_file.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "-w")
            Process::rh_append_arg(args, "%{http_code}")
            Process::rh_append_arg(args, url.cast[u8&] can Unsafe.PointerCast)

        def rh_run_https_get_with_timeout(url: cstr, body_file: cstr, code_file: cstr, err_file: cstr, max_secs: i64, api_kind: i64) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if max_secs <= 0 or max_secs > RH_FETCH_MAX_SECS
            return -1 if not rh_fetch_guard(url)
            return -1 if not rh_fetch_arg_safe(url)
            return -1 if not rh_arg_safe(body_file)
            return -1 if not rh_arg_safe(code_file)
            return -1 if not rh_arg_safe(err_file)
            api_auth_state: i64 = rh_github_api_auth_state(url) if api_kind == 1 else (rh_gitlab_api_auth_state(url) if api_kind == 2 else 0)
            return -1 if api_auth_state < 0
            api_auth: bool = api_auth_state == 1
            pin: mutable darray[u8] = []
            if Base::rh_cstr_starts_with(url, "https://"):
                return -1 if not rh_prepare_https_pin(url, err_file, pin)
            args: mutable darray[u8] = []
            input: mutable darray[u8] = []
            rh_https_get_args(args, input, url, body_file, pin, max_secs, api_kind, api_auth)
            args.push(0)
            env: mutable darray[u8] = Git::rh_transport_env()
            Process::rh_run_with_input_timeout("curl", args, env, input, code_file, err_file, ((max_secs + 2) * 1000).i32()).i64()

        # Build the one permitted JSON POST request. The URL is not a caller
        # argument: the public wrapper below fixes it to OSV's query endpoint.
        def rh_osv_post_args(args: mutable darray[u8]&, url: cstr, request_file: cstr, body_file: cstr, pin: darray[u8]&) -> void can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            Process::rh_append_arg(args, "curl")
            Process::rh_append_arg(args, "--disable")
            Process::rh_append_arg(args, "-sS")
            Process::rh_append_arg(args, "--noproxy")
            Process::rh_append_arg(args, "*")
            Process::rh_append_arg(args, "--proto")
            Process::rh_append_arg(args, "=https")
            Process::rh_append_arg(args, "--max-redirs")
            Process::rh_append_arg(args, "0")
            Process::rh_append_arg(args, "--resolve")
            Process::rh_append_arg(args, (&pin[0]).cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "--max-time")
            seconds: mutable darray[u8] = []
            Base::rh_push_decimal_i64(seconds, RH_FETCH_MAX_SECS)
            Process::rh_append_arg_bytes(args, seconds)
            Process::rh_append_arg(args, "--max-filesize")
            size: mutable darray[u8] = []
            Base::rh_push_decimal_i64(size, RH_FETCH_MAX_BYTES)
            Process::rh_append_arg_bytes(args, size)
            Process::rh_append_arg(args, "-H")
            Process::rh_append_arg(args, "User-Agent: repo-health/0.2.0 (+https://github.com/torarinvik/repo-health/issues)")
            Process::rh_append_arg(args, "-H")
            Process::rh_append_arg(args, "Content-Type: application/json")
            Process::rh_append_arg(args, "--data-binary")
            request_arg: mutable darray[u8] = []
            request_arg.push(64)
            Base::rh_push_cstr(request_arg, request_file)
            Process::rh_append_arg_bytes(args, request_arg)
            Process::rh_append_arg(args, "-o")
            Process::rh_append_arg(args, body_file.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, "-w")
            Process::rh_append_arg(args, "%{http_code}")
            Process::rh_append_arg(args, url.cast[u8&] can Unsafe.PointerCast)

        def rh_run_osv_post(url: cstr, request_file: cstr, body_file: cstr, code_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(request_file)
            return -1 if not rh_arg_safe(body_file)
            return -1 if not rh_arg_safe(code_file)
            return -1 if not rh_arg_safe(err_file)
            return -1 if not rh_fetch_guard(url)
            pin: mutable darray[u8] = []
            return -1 if not rh_prepare_https_pin(url, err_file, pin)
            args: mutable darray[u8] = []
            rh_osv_post_args(args, url, request_file, body_file, pin)
            args.push(0)
            env: mutable darray[u8] = Git::rh_transport_env()
            Process::rh_run_with_timeout("curl", args, env, code_file, err_file, ((RH_FETCH_MAX_SECS + 2) * 1000).i32()).i64()

    public:
        # Run a bounded HTTPS/file fetch for forge APIs (M02-05 transport).
        # Policy, all enforced before and during the call (S002/S003/S012):
        # rh_fetch_guard (scheme/host/credential rules) + rh_fetch_arg_safe
        # (shell quoting safety); HTTPS DNS answers are validated as a complete
        # set and pinned with curl --resolve, proxy and user config are disabled,
        # redirects disabled (fail closed, no credential re-send surface), and
        # wall-clock and byte caps bound the transfer. Optional GitHub bearer
        # auth is read from RH_GITHUB_TOKEN and sent only to api.github.com;
        # curl reads the header config from stdin, so the token is absent from
        # argv and retained files.
        # Returns the curl process status (0 = transfer ran; the caller MUST read
        # the code file: 200 = body usable, 000 = file-fixture transport with no
        # HTTP status, anything else = upstream answer preserved as evidence).
        # -1 on validation failure (nothing executed).
        const RH_FETCH_MAX_BYTES: i64 = 8388608
        const RH_FETCH_MAX_SECS: i64 = 60
        const RH_OSV_VULNERABILITY_GET_MAX_SECS: i64 = 10

        def rh_run_https_get(url: cstr, body_file: cstr, code_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            rh_run_https_get_with_timeout(url, body_file, code_file, err_file, RH_FETCH_MAX_SECS, 0)

        # GitHub's REST API requires an explicit supported-version header for
        # stable interpretation. The endpoint remains caller-supplied under the
        # same HTTPS/DNS/redirect/size policy; optional bearer auth is scoped to
        # the exact api.github.com host.
        def rh_run_github_api_get(url: cstr, body_file: cstr, code_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            rh_run_https_get_with_timeout(url, body_file, code_file, err_file, RH_FETCH_MAX_SECS, 1)

        # GitLab API authentication uses a distinct header and exact host.
        def rh_run_gitlab_api_get(url: cstr, body_file: cstr, code_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if not Base::rh_cstr_starts_with(url, "https://gitlab.com/api/v4/")
            rh_run_https_get_with_timeout(url, body_file, code_file, err_file, RH_FETCH_MAX_SECS, 2)

        # Run a single bounded JSON package/version query to OSV. The endpoint
        # is fixed here, so this POST cannot be redirected to a caller URL. DNS
        # answers are validated as a complete public set and pinned; curl config,
        # proxies, redirects, oversized bodies, and long hangs are rejected.
        # Returns curl's process status; callers must separately require HTTP 200.
        def rh_run_osv_query(request_file: cstr, body_file: cstr, code_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            rh_run_osv_post("https://api.osv.dev/v1/query", request_file, body_file, code_file, err_file)

        # Run a bounded ordered graph batch. Callers cannot choose the endpoint;
        # querybatch is kept separate because its response contains IDs only.
        def rh_run_osv_query_batch(request_file: cstr, body_file: cstr, code_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            rh_run_osv_post("https://api.osv.dev/v1/querybatch", request_file, body_file, code_file, err_file)

        # Fetch one full OSV vulnerability by a validated ID from a prior
        # query/querybatch response. The endpoint host and route are fixed here;
        # the ID alphabet is restricted before it can enter the URL path.
        def rh_run_osv_vulnerability_get(advisory_id: darray[u8]&, body_file: cstr, code_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if advisory_id.count == 0 or advisory_id.count > 128
            while i < advisory_id.count |i: usize = 0, advisory_id|:
                b: u8 = advisory_id[i]
                valid: bool = (b >= 48 and b <= 57) or (b >= 65 and b <= 90) or (b >= 97 and b <= 122) or b == 45 or b == 46 or b == 95
                return -1 if not valid
                i <- i + 1
            url: mutable darray[u8] = []
            Base::rh_push_text(url, "https://api.osv.dev/v1/vulns/")
            url.extend(bytes_view(advisory_id))
            url.push(0)
            url_ptr: cstr = (&url[0]).cast[cstr] can Unsafe.PointerCast
            rh_run_https_get_with_timeout(url_ptr, body_file, code_file, err_file, RH_OSV_VULNERABILITY_GET_MAX_SECS, 0)

        # Run a bounded bare clone for https remotes (M01-03): no worktree, no
        # checkout (so no smudge/clean filters, no hooks execute), blob-less and
        # depth-bounded by default. Protocol guards forbid ext/file helpers.
        # Full-history mode drops the depth bound (filter stays: blobs are never
        # needed by the M01 metric set).
        def rh_run_git_clone(url: cstr, dest: cstr, err_file: cstr, full_history: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(url)
            return -1 if not rh_arg_safe(dest)
            return -1 if not rh_arg_safe(err_file)
            args: mutable darray[u8] = []
            Process::rh_append_arg(args, "git")
            Process::rh_append_arg(args, "-c")
            Process::rh_append_arg(args, "protocol.ext.allow=never")
            Process::rh_append_arg(args, "-c")
            Process::rh_append_arg(args, "protocol.file.allow=never")
            Process::rh_append_arg(args, "clone")
            Process::rh_append_arg(args, "--bare")
            Process::rh_append_arg(args, "--no-checkout")
            Process::rh_append_arg(args, "--filter=blob:none")
            if not full_history:
                Process::rh_append_arg(args, "--depth=5000")
            Process::rh_append_arg(args, url.cast[u8&] can Unsafe.PointerCast)
            Process::rh_append_arg(args, dest.cast[u8&] can Unsafe.PointerCast)
            args.push(0)
            env: mutable darray[u8] = Git::rh_process_env()
            Process::rh_run("/usr/bin/git", args, env, "/dev/null", err_file).i64()
