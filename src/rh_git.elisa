include "./rh_base.elisa"

module Git:
    public:
        # rh_git.elisa — safe Git acquisition (M01-01/02/03).
        #
        # M01-01: rh_url_kind classifies local paths, public https remotes, and
        # everything else (unsupported). M01-02: rh_arg_safe enforces the strict
        # allowlist before ANY system() call (see docs/THREAT_MODEL.md for the
        # documented shell deviation). M01-03: acquisition uses plumbing only
        # (`log --format`, `rev-parse`); never checkout/clone-with-hooks/archive,
        # so no source-provided command ever runs (S001). Bounded by default
        # (RH_DEFAULT_MAX_COMMITS) with an explicit full-history mode.




        const RH_URL_LOCAL: u8 = 0
        const RH_URL_HTTPS: u8 = 1
        const RH_URL_UNSUPPORTED: u8 = 2

        const RH_DEFAULT_MAX_COMMITS: i64 = 20000

        def rh_url_kind(url: cstr) -> u8 can[Memory.Allocate, Abort.Panic]:
            return RH_URL_UNSUPPORTED if Base::rh_cstr_len_c(url) == 0
            return RH_URL_HTTPS if Base::rh_cstr_starts_with(url, "https://")
            return RH_URL_UNSUPPORTED if Base::rh_cstr_has_scheme(url)
            return RH_URL_UNSUPPORTED if Base::rh_cstr_starts_with(url, "git@")
            RH_URL_LOCAL

        # Strict allowlist for anything interpolated into a system() command:
        # [A-Za-z0-9] / . : _ - + only. Everything else (quotes, whitespace,
        # shell metacharacters, '@', non-ASCII) is rejected. Notably '@' is
        # rejected everywhere: forge https URLs never need it, and it closes the
        # userinfo-smuggling class (S003).
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_byte_allowed(b: u8) -> bool:
            return true if b >= 48 and b <= 57
            return true if b >= 65 and b <= 90
            return true if b >= 97 and b <= 122
            return true if b == 47
            return true if b == 46
            return true if b == 58
            return true if b == 95
            return true if b == 45
            return true if b == 43
            false

        def rh_arg_safe(s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if Base::rh_cstr_len_c(s) == 0
            while true |i: usize = 0, s|:
                b: u8 = s[i]
                break if b == 0
                return false if not rh_byte_allowed(b)
                i <- i + 1
            true

        # Join dir + "/" + name into out (NUL-terminated). False on empty dir.
        def rh_join_path(dir: cstr, name: u8&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if Base::rh_cstr_len_c(dir) == 0
            Base::rh_push_cstr(out, dir)
            out.push(47)
            Base::rh_push_text(out, name)
            out.push(0)
            true

        # Append a single-quoted shell arg (content pre-validated by rh_arg_safe;
        # quoting is belt-and-braces since the charset cannot break out).
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_push_quoted(cmd: mutable darray[u8]&, arg: cstr) -> void can[Memory.Allocate, Abort.Panic]:
            cmd.push(39)
            Base::rh_push_cstr(cmd, arg)
            cmd.push(39)

        # Run: git -c core.pager=cat -c core.quotepath=false -C '<repo>' log --all
        #   --no-decorate --format=<plumbing> [--max-count=N] > '<out>' 2> '<err>'
        # Plumbing format per record (NUL-terminated): H %x01 an %x01 ae %x01 at
        # %x01 ct %x01 parents. Returns the system() status, or -1 when any input
        # fails validation (nothing executed in that case).
        def rh_run_git_log(repo: cstr, out_file: cstr, err_file: cstr, full_history: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            cmd: mutable darray[u8] =
                cmd: mutable darray[u8] = []
                Base::rh_push_text(cmd, "git -c core.pager=cat -c core.quotepath=false -C ")
                rh_push_quoted(cmd, repo)
                Base::rh_push_text(cmd, " log --all --no-decorate --format=%H%x01%an%x01%ae%x01%at%x01%ct%x01%P%x00")
                cmd
            if not full_history:
                Base::rh_push_text(cmd, " --max-count=")
                Base::rh_push_decimal_i64(cmd, RH_DEFAULT_MAX_COMMITS)
            Base::rh_push_text(cmd, " > ")
            rh_push_quoted(cmd, out_file)
            Base::rh_push_text(cmd, " 2> ")
            rh_push_quoted(cmd, err_file)
            cmd.push(0)
            system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()

        # Run: git -C '<repo>' rev-list --count HEAD > '<out>' 2> '<err>'.
        # The retained count is the default-branch reachability projection;
        # `rh_run_git_log` above deliberately covers all recorded refs.
        def rh_run_git_default_count(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            cmd: mutable darray[u8] =
                cmd: mutable darray[u8] = []
                Base::rh_push_text(cmd, "git -C ")
                rh_push_quoted(cmd, repo)
                Base::rh_push_text(cmd, " rev-list --count HEAD > ")
                rh_push_quoted(cmd, out_file)
                Base::rh_push_text(cmd, " 2> ")
                rh_push_quoted(cmd, err_file)
                cmd.push(0)
                cmd
            system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()

        # Run: git -C '<repo>' -c core.quotepath=false ls-tree -r -l -z HEAD.
        # NUL-delimited long records retain blob sizes alongside paths so source
        # byte metrics can be replayed from the snapshot without reading a worktree.
        def rh_run_git_files(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            cmd: mutable darray[u8] =
                cmd: mutable darray[u8] = []
                Base::rh_push_text(cmd, "git -c core.quotepath=false -C ")
                rh_push_quoted(cmd, repo)
                Base::rh_push_text(cmd, " ls-tree -r -l -z HEAD > ")
                rh_push_quoted(cmd, out_file)
                Base::rh_push_text(cmd, " 2> ")
                rh_push_quoted(cmd, err_file)
                cmd.push(0)
                cmd
            system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()

        # Run: git -C '<repo>' rev-parse --is-shallow-repository > '<out>' 2> '<err>'
        def rh_run_git_shallow(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            cmd: mutable darray[u8] =
                cmd: mutable darray[u8] = []
                Base::rh_push_text(cmd, "git -C ")
                rh_push_quoted(cmd, repo)
                Base::rh_push_text(cmd, " rev-parse --is-shallow-repository > ")
                rh_push_quoted(cmd, out_file)
                Base::rh_push_text(cmd, " 2> ")
                rh_push_quoted(cmd, err_file)
                cmd.push(0)
                cmd
            system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()

        # Run: git -C '<repo>' config --get extensions.partialClone > '<out>'
        # 2> '<err>'. A configured partial clone may be missing blobs, so
        # blob-derived metrics must be reported partial rather than complete
        # (F004). Exit is nonzero when the extension is absent (not a partial
        # clone); the caller reads the file, not the exit code.
        def rh_run_git_partial(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            cmd: mutable darray[u8] =
                cmd: mutable darray[u8] = []
                Base::rh_push_text(cmd, "git -C ")
                rh_push_quoted(cmd, repo)
                Base::rh_push_text(cmd, " config --get extensions.partialClone > ")
                rh_push_quoted(cmd, out_file)
                Base::rh_push_text(cmd, " 2> ")
                rh_push_quoted(cmd, err_file)
                cmd.push(0)
                cmd
            system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()

        # Run: git -C '<repo>' rev-parse --verify --quiet HEAD (0 iff the repo has
        # at least one commit). Distinguishes observed-empty history (F001) from a
        # genuine collection failure: empty is reported, never errored.
        def rh_run_git_head(repo: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(err_file)
            headrc: i64 =
                cmd: mutable darray[u8] =
                    cmd: mutable darray[u8] = []
                    Base::rh_push_text(cmd, "git -C ")
                    rh_push_quoted(cmd, repo)
                    Base::rh_push_text(cmd, " rev-parse --verify --quiet HEAD -- > /dev/null 2> ")
                    rh_push_quoted(cmd, err_file)
                    cmd.push(0)
                    cmd
                block_result: i64 = system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()
                block_result
            headrc

        # Run: git --version > '<out>' 2> '<err>' (evidence capture, M01-05).
        def rh_run_git_version(out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            bound: i64 =
                cmd: mutable darray[u8] =
                    cmd: mutable darray[u8] = []
                    Base::rh_push_text(cmd, "git --version > ")
                    rh_push_quoted(cmd, out_file)
                    Base::rh_push_text(cmd, " 2> ")
                    rh_push_quoted(cmd, err_file)
                    cmd.push(0)
                    cmd
                block_result: i64 = system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()
                block_result
            bound

        # Run: mkdir -p '<dir>' (evidence/report tree setup; path pre-validated).
        def rh_ensure_dir(dir: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(dir)
            made: i64 =
                cmd: mutable darray[u8] =
                    cmd: mutable darray[u8] = []
                    Base::rh_push_text(cmd, "mkdir -p ")
                    rh_push_quoted(cmd, dir)
                    cmd.push(0)
                    cmd
                block_result: i64 = system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()
                block_result
            made

        # Run: sort -u '<src>' -o '<dst>' (identity dedup; POSIX sort, no hashing
        # of personhood implied — raw strings in, unique raw strings out).
        def rh_run_sort_uniq(src_file: cstr, dst_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(src_file)
            return -1 if not rh_arg_safe(dst_file)
            return -1 if not rh_arg_safe(err_file)
            sorted: i64 =
                cmd: mutable darray[u8] =
                    cmd: mutable darray[u8] = []
                    Base::rh_push_text(cmd, "sort -u ")
                    rh_push_quoted(cmd, src_file)
                    Base::rh_push_text(cmd, " -o ")
                    rh_push_quoted(cmd, dst_file)
                    Base::rh_push_text(cmd, " 2> ")
                    rh_push_quoted(cmd, err_file)
                    cmd.push(0)
                    cmd
                block_result: i64 = system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()
                block_result
            sorted

        # Native M08 history adapters use fixed machine-oriented output formats and
        # the same path allowlist as the Git runner. Each command writes raw source
        # evidence and a separate stderr capture; callers parse the retained bytes
        # only after the command exits successfully.
        def rh_run_hg_log(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            cmd: mutable darray[u8] =
                cmd: mutable darray[u8] = []
                Base::rh_push_text(cmd, "hg --cwd ")
                rh_push_quoted(cmd, repo)
                Base::rh_push_text(cmd, " log -Tjson --limit=20000 > ")
                rh_push_quoted(cmd, out_file)
                Base::rh_push_text(cmd, " 2> ")
                rh_push_quoted(cmd, err_file)
                cmd.push(0)
                cmd
            system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()

        def rh_run_svn_log(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            cmd: mutable darray[u8] =
                cmd: mutable darray[u8] = []
                Base::rh_push_text(cmd, "svn log --xml -v --limit 20000 ")
                rh_push_quoted(cmd, repo)
                Base::rh_push_text(cmd, " > ")
                rh_push_quoted(cmd, out_file)
                Base::rh_push_text(cmd, " 2> ")
                rh_push_quoted(cmd, err_file)
                cmd.push(0)
                cmd
            system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()

        def rh_run_fossil_timeline(repo: cstr, out_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(repo)
            return -1 if not rh_arg_safe(out_file)
            return -1 if not rh_arg_safe(err_file)
            cmd: mutable darray[u8] =
                cmd: mutable darray[u8] = []
                Base::rh_push_text(cmd, "fossil timeline -R ")
                rh_push_quoted(cmd, repo)
                Base::rh_push_text(cmd, " -F '%H|%a|%d|%b|%p|%t|%c' -n 20000 > ")
                rh_push_quoted(cmd, out_file)
                Base::rh_push_text(cmd, " 2> ")
                rh_push_quoted(cmd, err_file)
                cmd.push(0)
                cmd
            system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()

        # --- Fetch policy (S002/S003). Two layers, both must pass before any
        # network/file access:
        # (1) rh_fetch_guard: semantic policy. https or file scheme only (file =
        # recorded fixtures / controlled local inputs, never a confused deputy:
        # the caller names the fixture). No userinfo ('@'), no percent-escapes in
        # the host, no ports, no IPv6 brackets, no bare "localhost", no IPv4
        # loopback/private/link-local literals. Public IPv4 literals pass.
        # DNS is checked by rh_prepare_https_pin before an HTTPS request: the
        # complete resolver answer set is vetted and passed to curl --resolve.
        # This URL-only guard remains side-effect free.
        # (2) rh_fetch_arg_safe: shell safety for the system() runner. Single
        # quotes wrap the URL, so only the quote itself plus backtick, dollar,
        # backslash, controls, and DEL can break out — all rejected.
        def rh_fetch_arg_safe(s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = Base::rh_cstr_len_c(s)
            return false if n == 0
            while true |i: usize = 0, s|:
                b: u8 = s[i]
                break if b == 0
                return false if b < 32 or b == 127
                return false if b == 39 or b == 96 or b == 36 or b == 92
                i <- i + 1
            true

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_host_is_v4_literal(host_start: usize, host_end: usize, s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < host_end |i: usize = host_start, s, host_end|:
                b: u8 = s[i]
                return false if (b < 48 or b > 57) and b != 46
                i <- i + 1
            true

        # Parse dotted quad at [start,end) into o0..o3. ok_out 1/0.
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_parse_v4(s: cstr, start: usize, end: usize, o0: mutable i64&, o1: mutable i64&, o2: mutable i64&, o3: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            parts, cur, digits, lz =
                while i < end |parts: i64 = 0, cur: i64 = 0, digits: i64 = 0, lz: i64 = 0, i: usize = start, o0, o1, o2, o3| -> parts, cur, digits, lz:
                    b: u8 = s[i]
                    if b >= 48 and b <= 57:
                        if digits == 0 and b == 48:
                            lz <- 1
                        cur <- cur * 10 + (b - 48).i64()
                        return false if cur > 255
                        digits <- digits + 1
                    elif b == 46:
                        if digits == 0:
                            return false
                        # Leading zeros make some resolvers read the octet as octal
                        # (0177.0.0.1 -> 127.0.0.1); reject rather than guess (S002).
                        return false if lz == 1 and digits > 1
                        if parts == 0:
                            o0[0] <- cur
                        elif parts == 1:
                            o1[0] <- cur
                        elif parts == 2:
                            o2[0] <- cur
                        else:
                            return false
                        parts <- parts + 1
                        cur <- 0
                        digits <- 0
                        lz <- 0
                    else:
                        return false
                    i <- i + 1
            return false if parts != 3 or digits == 0
            return false if lz == 1 and digits > 1
            o3[0] <- cur
            true

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_v4_blocked(a: i64, b: i64, c: i64) -> bool:
            return true if a == 127
            return true if a == 10
            return true if a == 172 and b >= 16 and b <= 31
            return true if a == 192 and b == 168
            return true if a == 169 and b == 254
            if a == 0:
                return true
            # Shared/CGNAT (100.64/10), benchmark (198.18/15), IETF protocol
            # assignments and documentation/retired special-purpose blocks.
            # A public crawler has no business reaching these (S002).
            return true if a == 100 and b >= 64 and b <= 127
            if a == 198 and (b == 18 or b == 19):
                return true
            # Conservative: block the enclosing 192.0.0.0/16 rather than rely
            # on the special-purpose exceptions within the IETF assignment.
            return true if a == 192 and b == 0
            return true if a == 192 and b == 88 and c == 99
            return true if a == 198 and b == 51 and c == 100
            return true if a == 203 and b == 0 and c == 113
            return true if a >= 224
            false

        # Hostname charset: letters, digits, hyphen, dot only; no empty label and
        # no leading/trailing hyphen. Rejects underscores and stray punctuation so
        # resolver-specific extensions cannot expand the attack surface.
        # (private to this file)
        def rh_host_chars_ok(start: usize, end: usize, s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            label_start: usize =
                while i < end |label_start: usize = start, i: usize = start| -> label_start:
                    b: u8 = s[i]
                    ok: bool = (b >= 97 and b <= 122) or (b >= 65 and b <= 90) or (b >= 48 and b <= 57) or b == 45
                    return false if not ok and b != 46
                    if b == 46:
                        return false if i == label_start
                        prev: u8 = s[i - 1]
                        return false if prev == 45
                        label_start <- i + 1
                    i <- i + 1
            return false if label_start == end
            last: u8 = s[end - 1]
            return false if last == 45
            true

        # Numeric-obfuscated hosts some resolvers accept but this policy must not:
        # "0x..." hex labels and zero-padded decimal labels. Fail closed (S002).
        # (private to this file)
        def rh_host_obfuscated(start: usize, end: usize, s: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < end |i: usize = start, at_label: bool = true, s, end|:
                b: u8 = s[i]
                if b == 46:
                    at_label <- true
                else:
                    if at_label and b == 48 and i + 1 < end:
                        nxt: u8 = s[i + 1]
                        return true if nxt == 120 or nxt == 88
                        return true if nxt >= 48 and nxt <= 57
                    at_label <- false
                i <- i + 1
            false

        def rh_fetch_guard(url: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            is_https: bool = Base::rh_cstr_starts_with(url, "https://")
            is_file: bool = Base::rh_cstr_starts_with(url, "file://")
            return false if not is_https and not is_file
            n: usize = Base::rh_cstr_len_c(url)
            if is_file:
                return false if n < 9
                return false if url[7] != 47
                return true
            base: mutable usize = 8
            return false if base >= n
            hend: mutable usize =
                while hend < n |hend: usize = base| -> hend:
                    c: u8 = url[hend]
                    break if c == 47 or c == 63 or c == 35
                    hend <- hend + 1
            return false if hend == base
            while hi < hend |hi: usize = base, url, hend|:
                h: u8 = url[hi]
                return false if h == 64 or h == 37 or h == 91 or h == 93 or h == 58
                hi <- hi + 1
            if rh_host_is_v4_literal(base, hend, url):
                a0: mutable i64 = 0
                a1: mutable i64 = 0
                a2: mutable i64 = 0
                a3: mutable i64 = 0
                return false if not rh_parse_v4(url, base, hend, &a0, &a1, &a2, &a3)
                return false if rh_v4_blocked(a0, a1, a2)
                return true
            return false if not rh_host_chars_ok(base, hend, url)
            return false if rh_host_obfuscated(base, hend, url)
            while dj < hend |dotted: bool = false, dj: usize = base, hend| -> dotted:
                if url[dj] == 46:
                    dotted <- true
                dj <- dj + 1

    private:
        # Parse colon-delimited IPv6 hextets into a bounded word list. Empty
        # parts, non-hex bytes, overlong hextets, and more than eight words fail.
        def rh_v6_parse_groups(ip: cstr, start: usize, end: usize, words: mutable InlineVec[i64, 8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if start == end
            value: mutable i64 = 0
            digits: mutable i64 = 0
            while i < end |i: usize = start, ip, end, words, value, digits|:
                b: u8 = ip[i]
                if b == 58:
                    return false if digits == 0 or words.len >= 8
                    inline_vec_push[i64, 8](words, value)
                    value <- 0
                    digits <- 0
                else:
                    if b >= 48 and b <= 57:
                        value <- value * 16 + (b - 48).i64()
                    elif b >= 65 and b <= 70:
                        value <- value * 16 + (b - 55).i64()
                    elif b >= 97 and b <= 102:
                        value <- value * 16 + (b - 87).i64()
                    else:
                        return false
                    digits <- digits + 1
                    return false if digits > 4
                i <- i + 1
            return false if digits == 0 or words.len >= 8
            inline_vec_push[i64, 8](words, value)
            true

        # Validate both compressed and full IPv6 forms. The input bound and
        # eight-word output cap keep parsing constant-sized for attacker input.
        def rh_v6_parse(ip: cstr, length: usize, words: mutable InlineVec[i64, 8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if length < 2 or length > 39
            compression: mutable i64 = -1
            while i + 1 < length |i: usize = 0, ip, length, compression|:
                if ip[i] == 58 and ip[i + 1] == 58:
                    return false if compression >= 0
                    compression <- i.i64()
                    i <- i + 2
                else:
                    i <- i + 1
            if compression < 0:
                return false if not rh_v6_parse_groups(ip, 0, length, words)
                return words.len == 8
            left: mutable InlineVec[i64, 8] = inline_vec[i64, 8](&perm_arena)
            right: mutable InlineVec[i64, 8] = inline_vec[i64, 8](&perm_arena)
            left_end: usize = compression.usize()
            right_start: usize = left_end + 2
            return false if not rh_v6_parse_groups(ip, 0, left_end, left)
            return false if not rh_v6_parse_groups(ip, right_start, length, right)
            return false if left.len + right.len >= 8
            while i < left.len |i: usize = 0, left, words|:
                inline_vec_push[i64, 8](words, inline_vec_get[i64, 8](left, i))
                i <- i + 1
            zero_count: usize = 8 - left.len - right.len
            while i < zero_count |i: usize = 0, words|:
                inline_vec_push[i64, 8](words, 0)
                i <- i + 1
            while i < right.len |i: usize = 0, right, words|:
                inline_vec_push[i64, 8](words, inline_vec_get[i64, 8](right, i))
                i <- i + 1
            true

    public:
        # Second phase of transport policy (M07-02): a resolved address, checked
        # before connecting. It rejects private, scoped,
        # mapped, malformed, documentation, and other non-global address forms.
        def rh_addr_guard(ip: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            n: usize = Base::rh_cstr_len_c(ip)
            return false if n == 0
            has_colon: bool =
                while i < n |has_colon: bool = false, i: usize = 0| -> has_colon:
                    if ip[i] == 58:
                        has_colon <- true
                    i <- i + 1
            if not has_colon:
                a0: mutable i64 = 0
                a1: mutable i64 = 0
                a2: mutable i64 = 0
                a3: mutable i64 = 0
                return false if not rh_parse_v4(ip, 0, n, &a0, &a1, &a2, &a3)
                return false if rh_v4_blocked(a0, a1, a2)
                return true
            words: mutable InlineVec[i64, 8] = inline_vec[i64, 8](&perm_arena)
            return false if not rh_v6_parse(ip, n, words)
            w0: i64 = inline_vec_get[i64, 8](words, 0)
            w1: i64 = inline_vec_get[i64, 8](words, 1)
            w5: i64 = inline_vec_get[i64, 8](words, 5)
            w7: i64 = inline_vec_get[i64, 8](words, 7)
            zero_prefix: bool =
                while i < 7 |zero: bool = true, i: usize = 0, words| -> zero:
                    if inline_vec_get[i64, 8](words, i) != 0:
                        zero <- false
                    i <- i + 1
            return false if zero_prefix and (w7 == 0 or w7 == 1)
            mapped_prefix: bool =
                while i < 5 |mapped: bool = true, i: usize = 0, words| -> mapped:
                    if inline_vec_get[i64, 8](words, i) != 0:
                        mapped <- false
                    i <- i + 1
            return false if mapped_prefix and w5 == 0xffff
            return false if w0 >= 0xfe80 and w0 <= 0xfebf
            return false if w0 >= 0xfec0 and w0 <= 0xfeff
            return false if w0 >= 0xfc00 and w0 <= 0xfdff
            return false if w0 >= 0xff00
            return false if (w0 & 0xe000) != 0x2000
            # IANA's 2001::/23 protocol-assignment block contains individual
            # exceptions; reject the enclosing range conservatively for SSRF.
            return false if w0 == 0x2001 and w1 < 0x0200
            return false if w0 == 0x2001 and w1 == 0x0db8
            return false if w0 == 0x3fff and (w1 & 0xf000) == 0
            return false if w0 == 0x2002
            true

    private:
        # Read and validate one bounded resolver result, then render the
        # address set in cURL's host:port:address-list form.
        def rh_append_resolved_addresses(resolved_file: cstr, host: cstr, pin: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            file_size: i64 = Base::rh_file_size(resolved_file)
            return false if file_size <= 0 or file_size > 2048
            addresses: mutable darray[u8] = []
            return false if Base::rh_io_read(resolved_file, addresses) != file_size
            Base::rh_push_cstr(pin, host)
            Base::rh_push_text(pin, ":443:")
            address_count: mutable i64 = 0
            while start < addresses.count |start: usize = 0, addresses, pin, address_count|:
                newline: i64 = Base::rh_find_byte(addresses, start, 10)
                line_end: mutable usize = newline.usize() if newline >= 0 else addresses.count
                return false if line_end <= start or address_count >= 32
                ip: mutable darray[u8] = []
                has_colon: mutable bool = false
                while i < line_end |i: usize = start, addresses, line_end, ip, has_colon|:
                    b: u8 = addresses[i]
                    return false if b == 0
                    has_colon <- true if b == 58
                    ip.push(b)
                    i <- i + 1
                ip.push(0)
                ip_ptr: cstr = (&ip[0]).cast[cstr] can Unsafe.PointerCast
                return false if not rh_addr_guard(ip_ptr)
                pin.push(44) if address_count > 0
                pin.push(91) if has_colon
                Base::rh_push_cstr(pin, ip_ptr)
                pin.push(93) if has_colon
                address_count <- address_count + 1
                if newline < 0:
                    start <- addresses.count
                else:
                    start <- newline.usize() + 1
            return false if address_count == 0
            pin.push(0)
            true

        # Build a bounded cURL --resolve value from the resolver's complete
        # address set. Rejecting the whole set prevents a public answer from
        # hiding a private answer that cURL might otherwise select.
        def rh_prepare_https_pin(url: cstr, err_file: cstr, pin: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            n: usize = Base::rh_cstr_len_c(url)
            host_end: mutable usize = 8
            while host_end < n |host_end, url, n|:
                c: u8 = url[host_end]
                break if c == 47 or c == 63 or c == 35
                host_end <- host_end + 1
            return false if host_end <= 8
            host: mutable darray[u8] =
                host: mutable darray[u8] = []
                while i < host_end |i: usize = 8, host, url, host_end|:
                    host.push(url[i])
                    i <- i + 1
                host.push(0)
                host
            host_ptr: cstr = (&host[0]).cast[cstr] can Unsafe.PointerCast
            resolved_file: mutable darray[u8] =
                resolved_file: mutable darray[u8] = []
                Base::rh_push_cstr(resolved_file, err_file)
                Base::rh_push_text(resolved_file, ".resolved")
                resolved_file.push(0)
                resolved_file
            resolved_ptr: cstr = (&resolved_file[0]).cast[cstr] can Unsafe.PointerCast
            _ = remove_file(resolved_ptr)

            resolve_status: i64 =
                cmd: mutable darray[u8] =
                    cmd: mutable darray[u8] = []
                    Base::rh_push_text(cmd, "python3 -I -c '")
                    Base::rh_push_text(cmd, "import socket, sys, threading\n")
                    Base::rh_push_text(cmd, "answers = []; failures = []\n")
                    Base::rh_push_text(cmd, "def resolve():\n")
                    Base::rh_push_text(cmd, "    try: answers.extend(socket.getaddrinfo(sys.argv[1], 443, type=socket.SOCK_STREAM, proto=socket.IPPROTO_TCP))\n")
                    Base::rh_push_text(cmd, "    except Exception as error: failures.append(error)\n")
                    Base::rh_push_text(cmd, "worker = threading.Thread(target=resolve, daemon=True)\n")
                    Base::rh_push_text(cmd, "worker.start(); worker.join(10)\n")
                    Base::rh_push_text(cmd, "if worker.is_alive() or failures: raise SystemExit(1)\n")
                    Base::rh_push_text(cmd, "addresses = list(dict.fromkeys(answer[4][0] for answer in answers))\n")
                    Base::rh_push_text(cmd, "if not addresses or len(addresses) > 32: raise SystemExit(1)\n")
                    Base::rh_push_text(cmd, "sys.stdout.write(\"\\n\".join(addresses) + \"\\n\")\n")
                    Base::rh_push_text(cmd, "' ")
                    rh_push_quoted(cmd, host_ptr)
                    Base::rh_push_text(cmd, " > ")
                    rh_push_quoted(cmd, resolved_ptr)
                    Base::rh_push_text(cmd, " 2> ")
                    rh_push_quoted(cmd, err_file)
                    cmd.push(0)
                    cmd
                block_result: i64 = system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()
                block_result
            if resolve_status != 0:
                _ = remove_file(resolved_ptr)
                return false

            pin_valid: bool = rh_append_resolved_addresses(resolved_ptr, host_ptr, pin)
            _ = remove_file(resolved_ptr)
            pin_valid

        # Assemble the fixed transport policy in one private helper so the
        # public operation only validates, prepares the pin, and runs it.
        def rh_https_get_command(url: cstr, body_file: cstr, code_file: cstr, err_file: cstr, pin: darray[u8]&) -> mutable darray[u8] can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            cmd: mutable darray[u8] = []
            Base::rh_push_text(cmd, "curl --disable -sS --noproxy '*' --proto '=https,file' --max-redirs 0")
            if pin.count > 0:
                Base::rh_push_text(cmd, " --resolve ")
                rh_push_quoted(cmd, (&pin[0]).cast[cstr] can Unsafe.PointerCast)
            Base::rh_push_text(cmd, " --max-time ")
            Base::rh_push_decimal_i64(cmd, RH_FETCH_MAX_SECS)
            Base::rh_push_text(cmd, " --max-filesize ")
            Base::rh_push_decimal_i64(cmd, RH_FETCH_MAX_BYTES)
            Base::rh_push_text(cmd, " -H 'User-Agent: repo-health-m02' -o ")
            rh_push_quoted(cmd, body_file)
            Base::rh_push_text(cmd, " -w '%{http_code}' > ")
            rh_push_quoted(cmd, code_file)
            Base::rh_push_text(cmd, " 2> ")
            rh_push_quoted(cmd, err_file)
            Base::rh_push_text(cmd, " ")
            rh_push_quoted(cmd, url)
            cmd.push(0)
            cmd

    public:
        # Run a bounded HTTPS/file fetch for forge APIs (M02-05 transport).
        # Policy, all enforced before and during the call (S002/S003/S012):
        # rh_fetch_guard (scheme/host/credential rules) + rh_fetch_arg_safe
        # (shell quoting safety); HTTPS DNS answers are validated as a complete
        # set and pinned with curl --resolve, proxy and user config are disabled,
        # redirects disabled (fail closed, no credential re-send surface), and
        # wall-clock and byte caps bound the transfer. No Authorization header is ever sent in
        # the M02 slice: authed endpoints report unauthorized honestly instead.
        # Returns the curl process status (0 = transfer ran; the caller MUST read
        # the code file: 200 = body usable, 000 = file-fixture transport with no
        # HTTP status, anything else = upstream answer preserved as evidence).
        # -1 on validation failure (nothing executed).
        const RH_FETCH_MAX_BYTES: i64 = 8388608
        const RH_FETCH_MAX_SECS: i64 = 60

        def rh_run_https_get(url: cstr, body_file: cstr, code_file: cstr, err_file: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if not rh_fetch_guard(url)
            return -1 if not rh_fetch_arg_safe(url)
            return -1 if not rh_arg_safe(body_file)
            return -1 if not rh_arg_safe(code_file)
            return -1 if not rh_arg_safe(err_file)
            pin: mutable darray[u8] = []
            if Base::rh_cstr_starts_with(url, "https://"):
                return -1 if not rh_prepare_https_pin(url, err_file, pin)
            transport: i64 =
                cmd: mutable darray[u8] = rh_https_get_command(url, body_file, code_file, err_file, pin)
                block_result: i64 = system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()
                block_result
            transport

        # Run a bounded bare clone for https remotes (M01-03): no worktree, no
        # checkout (so no smudge/clean filters, no hooks execute), blob-less and
        # depth-bounded by default. Protocol guards forbid ext/file helpers.
        # Full-history mode drops the depth bound (filter stays: blobs are never
        # needed by the M01 metric set).
        def rh_run_git_clone(url: cstr, dest: cstr, err_file: cstr, full_history: bool) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return -1 if not rh_arg_safe(url)
            return -1 if not rh_arg_safe(dest)
            return -1 if not rh_arg_safe(err_file)
            cloned: i64 =
                cmd: mutable darray[u8] = []
                Base::rh_push_text(cmd, "git -c protocol.ext.allow=never -c protocol.file.allow=never clone --bare --no-checkout --filter=blob:none")
                if not full_history:
                    Base::rh_push_text(cmd, " --depth=5000")
                Base::rh_push_text(cmd, " ")
                rh_push_quoted(cmd, url)
                Base::rh_push_text(cmd, " ")
                rh_push_quoted(cmd, dest)
                Base::rh_push_text(cmd, " 2> ")
                rh_push_quoted(cmd, err_file)
                cmd.push(0)
                block_result: i64 = system((&cmd[0]).cast[cstr] can Unsafe.PointerCast).i64()
                block_result
            cloned
