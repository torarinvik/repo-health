# rh_roles_report.elisa — R013 declared-roles execution path.
#
# Turns an `rh-roles-input/1` document of time-scoped role/permission
# declarations plus queries into `rh-roles-result/1`. Declared roles are
# evidence, separate from observed actions (the report says so); an
# unrecognized role string is `unknown`, never guessed at maintainer; a
# revoked or not-yet-effective declaration is not active at that time; and
# the declaration source (provider/file/operator) is tallied. Malformed
# input fails closed.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_roles.elisa"
include "./rh_observation.elisa"

module RolesReport:
    private:
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_rr_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_rr_source(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Roles::RH_DECL_SOURCE_PROVIDER if rh_rr_eq(texts, s, e, "provider")
            return Roles::RH_DECL_SOURCE_FILE if rh_rr_eq(texts, s, e, "file")
            return Roles::RH_DECL_SOURCE_OPERATOR if rh_rr_eq(texts, s, e, "operator")
            -1

        # Authorization is evidence about how a provider declaration was obtained;
        # it never changes the declaration's role semantics. Keep the state closed
        # so an adapter cannot silently turn an unrecognized value into authorization.
        def rh_rr_authorization(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return 1 if rh_rr_eq(texts, s, e, "authorized")
            return 2 if rh_rr_eq(texts, s, e, "unauthorized")
            return 3 if rh_rr_eq(texts, s, e, "not_requested")
            return 4 if rh_rr_eq(texts, s, e, "unknown")
            -1

        def rh_rr_authorization_label(state: i64) -> u8&:
            return "authorized" if state == 1
            return "unauthorized" if state == 2
            return "not_requested" if state == 3
            "unknown"

        def rh_rr_action_kind(texts: darray[u8]&, s: i64, e: i64) -> u8:
            return Roles::RH_ACTION_RELEASE if rh_rr_eq(texts, s, e, "release")
            return Roles::RH_ACTION_MERGE if rh_rr_eq(texts, s, e, "merge")
            return Roles::RH_ACTION_REVIEW if rh_rr_eq(texts, s, e, "review")
            0

        def rh_rr_actor_kind(texts: darray[u8]&, s: i64, e: i64) -> u8:
            return Roles::RH_ACTOR_KIND_HUMAN if rh_rr_eq(texts, s, e, "human")
            return Roles::RH_ACTOR_KIND_BOT if rh_rr_eq(texts, s, e, "bot")
            return Roles::RH_ACTOR_KIND_SERVICE if rh_rr_eq(texts, s, e, "service")
            return Roles::RH_ACTOR_KIND_UNKNOWN if rh_rr_eq(texts, s, e, "unknown")
            255

        def rh_rr_emit_actor_type_counts(out: mutable darray[u8]&, counts: darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"human\":")
            Base::rh_push_decimal_i64(out, counts[Roles::RH_ACTOR_KIND_HUMAN.usize()])
            Base::rh_push_text(out, ",\"bot\":")
            Base::rh_push_decimal_i64(out, counts[Roles::RH_ACTOR_KIND_BOT.usize()])
            Base::rh_push_text(out, ",\"service\":")
            Base::rh_push_decimal_i64(out, counts[Roles::RH_ACTOR_KIND_SERVICE.usize()])
            Base::rh_push_text(out, ",\"unknown\":")
            Base::rh_push_decimal_i64(out, counts[Roles::RH_ACTOR_KIND_UNKNOWN.usize()])
            Base::rh_push_text(out, "}")

        def rh_rr_observation(value: Observation::RhMetricValue, status: u8) -> Observation::RhObservation can[Memory.Allocate, Abort.Panic]:
            quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{
                completeness: Observation::RhCompleteness.Complete if status == Observation::RH_ST_OBSERVED else Observation::RhCompleteness.Unknown,
                freshness: Observation::RhFreshness.Unknown,
                validity: Observation::RhValidity.Valid if status == Observation::RH_ST_OBSERVED else Observation::RhValidity.Unknown,
                provenance: Observation::RhProvenanceQuality.EvidenceBacked
            }
            evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
            Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.RolesInput)
            Observation::rh_observation_make_with_evidence(
                status,
                value,
                false,
                quality,
                evidence
            )

        def rh_rr_emit_typed_metric(out: mutable darray[u8]&, key: cstr, value: Observation::RhMetricValue, status: u8, reason: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            observation: Observation::RhObservation = RolesReport::rh_rr_observation(value, status)
            Observation::rh_observation_emit_metric(out, key, "1.0.0", reason, observation)

        def rh_rr_emit_metric_with_as_of(out: mutable darray[u8]&, key: cstr, value: Observation::RhMetricValue, status: u8, reason: cstr, has_as_of: bool, as_of: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            observation: Observation::RhObservation = RolesReport::rh_rr_observation(value, status)
            Observation::rh_observation_emit_metric_with_optional_as_of(out, key, "1.0.0", reason, has_as_of, as_of, observation)

        def rh_rr_emit_count_metric(out: mutable darray[u8]&, key: cstr, count: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_rr_emit_typed_metric(out, key, Observation::RhMetricValue.Count(count), Observation::RH_ST_OBSERVED, "")

        def rh_rr_emit_ratio_metric(out: mutable darray[u8]&, key: cstr, numerator: i64, denominator: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not Observation::rh_ratio_valid(numerator, denominator)
            rh_rr_emit_typed_metric(out, key, Observation::RhMetricValue.Ratio(numerator, denominator), Observation::RH_ST_OBSERVED, "")

        def rh_rr_emit_change_review_metrics(out: mutable darray[u8]&, has_actions: bool, reviewed_changes: i64, linked_changes: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            out.push(91)
            return false if not rh_rr_emit_typed_metric(out, "maintainer.reviewed_merge_change_count", Observation::RhMetricValue.Count(reviewed_changes) if has_actions else Observation::RhMetricValue.Absent, Observation::RH_ST_OBSERVED if has_actions else Observation::RH_ST_UNSUPPORTED, "observed-actions-not-supplied")
            out.push(44)
            return false if not rh_rr_emit_typed_metric(out, "maintainer.linked_merge_change_count", Observation::RhMetricValue.Count(linked_changes) if has_actions else Observation::RhMetricValue.Absent, Observation::RH_ST_OBSERVED if has_actions else Observation::RH_ST_UNSUPPORTED, "observed-actions-not-supplied")
            out.push(93)
            true

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_rr_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return false if idx < 0
            Json::rh_json_str_span(nodes, idx, s_out, e_out)

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_rr_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, default_v: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            ok: mutable i64 = 0
            v: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, obj, key), &ok)
            return default_v if ok == 0
            v

    public:
        def rh_roles_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            sspan: mutable i64 = 0
            espan: mutable i64 = 0
            sc: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
            return -1 if sc < 0 or not Json::rh_json_str_span(nodes, sc, &sspan, &espan)
            return -1 if not rh_rr_eq(texts, sspan, espan, "rh-roles-input/1")
            provider_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "provider")
            provider_s: mutable i64 = 0
            provider_e: mutable i64 = 0
            provider_is_gitlab: bool = provider_idx >= 0 and Json::rh_json_str_span(nodes, provider_idx, &provider_s, &provider_e) and rh_rr_eq(texts, provider_s, provider_e, "gitlab")
            identity_revision_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "identity_revision")
            has_identity_revision: mutable bool = identity_revision_idx >= 0
            identity_revision: mutable i64 = -1
            if has_identity_revision:
                identity_revision_ok: mutable i64 = 0
                identity_revision <- Json::rh_json_int(nodes, raw, identity_revision_idx, &identity_revision_ok)
                return -1 if identity_revision_ok == 0 or identity_revision < 0
            identity_clusters: mutable darray[i64] = []
            identity_snapshot_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "identity_snapshot")
            has_identity_snapshot: bool = identity_snapshot_idx >= 0
            if has_identity_snapshot:
                return -1 if nodes[identity_snapshot_idx.usize()].kind != Json::RH_JSON_OBJ
                snapshot_revision_idx: i64 = Json::rh_json_obj_get(nodes, texts, identity_snapshot_idx, "identity_revision")
                snapshot_revision_ok: mutable i64 = 0
                snapshot_revision: i64 = Json::rh_json_int(nodes, raw, snapshot_revision_idx, &snapshot_revision_ok)
                return -1 if snapshot_revision_ok == 0 or snapshot_revision < 0
                return -1 if has_identity_revision and identity_revision != snapshot_revision
                identity_revision <- snapshot_revision
                has_identity_revision <- true
                identity_clusters_idx: i64 = Json::rh_json_obj_get(nodes, texts, identity_snapshot_idx, "cluster_id_by_actor")
                return -1 if identity_clusters_idx < 0 or nodes[identity_clusters_idx.usize()].kind != Json::RH_JSON_ARR
                clusters_array: Json::RhJsonNode = nodes[identity_clusters_idx.usize()]
                while ic >= 0 |ic: i64 = clusters_array.first_child, nodes, raw, identity_clusters|:
                    cluster_ok: mutable i64 = 0
                    cluster_id: i64 = Json::rh_json_int(nodes, raw, ic, &cluster_ok)
                    return -1 if cluster_ok == 0 or cluster_id < 0
                    identity_clusters.push(cluster_id)
                    ic <- nodes[ic.usize()].next_sibling
                while icheck < identity_clusters.count |icheck: usize = 0, identity_clusters|:
                    return -1 if identity_clusters[icheck] >= identity_clusters.count.i64()
                    icheck <- icheck + 1
            decls: mutable darray[Roles::RhRoleDecl] = []
            actions: mutable darray[Roles::RhObservedAction] = []
            identity_override_count: mutable i64 = 0
            d_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "declarations")
            return -1 if d_idx < 0 or nodes[d_idx.usize()].kind != Json::RH_JSON_ARR
            auth_state: mutable i64 = 4
            auth_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "authorization")
            if auth_idx >= 0:
                return -1 if nodes[auth_idx.usize()].kind != Json::RH_JSON_OBJ
                auth_value: i64 = Json::rh_json_obj_get(nodes, texts, auth_idx, "state")
                auth_s: mutable i64 = 0
                auth_e: mutable i64 = 0
                return -1 if auth_value < 0 or not Json::rh_json_str_span(nodes, auth_value, &auth_s, &auth_e)
                auth_state <- rh_rr_authorization(texts, auth_s, auth_e)
                return -1 if auth_state < 0
            scope_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "scope")
            scope_present: bool = scope_idx >= 0
            scope_repository_s: mutable i64 = 0
            scope_repository_e: mutable i64 = 0
            if scope_present:
                return -1 if nodes[scope_idx.usize()].kind != Json::RH_JSON_OBJ
                scope_key: u8& = "project_path" if provider_is_gitlab else "repository"
                scope_repository: i64 = Json::rh_json_obj_get(nodes, texts, scope_idx, scope_key)
                return -1 if scope_repository < 0 or not Json::rh_json_str_span(nodes, scope_repository, &scope_repository_s, &scope_repository_e)
            darr: Json::RhJsonNode = nodes[d_idx.usize()]
            while dc >= 0 |dc: i64 = darr.first_child, nodes, texts, raw, decls|:
                return -1 if nodes[dc.usize()].kind != Json::RH_JSON_OBJ
                rs: mutable i64 = 0
                re: mutable i64 = 0
                ss: mutable i64 = 0
                se: mutable i64 = 0
                return -1 if not rh_rr_str(nodes, texts, dc, "role", &rs, &re)
                return -1 if not rh_rr_str(nodes, texts, dc, "source", &ss, &se)
                role: u8 = Roles::rh_role_parse_role(texts, rs, re)
                source: i64 = rh_rr_source(texts, ss, se)
                return -1 if source < 0
                actor: i64 = rh_rr_int(nodes, raw, texts, dc, "actor_id", -1)
                return -1 if actor < 0
                decls.push(Roles::RhRoleDecl{actor_id: actor, role: role, permission: rh_rr_int(nodes, raw, texts, dc, "permission", 0).u8(), source: source.u8(), declared_at: rh_rr_int(nodes, raw, texts, dc, "declared_at", 0), revoked_at: rh_rr_int(nodes, raw, texts, dc, "revoked_at", 0)})
                dc <- nodes[dc.usize()].next_sibling
            actions_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "observed_actions")
            has_actions: bool = actions_idx >= 0
            action_window_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "observed_actions_window")
            has_action_window: bool = action_window_idx >= 0
            action_window_start: mutable i64 = 0
            action_window_end: mutable i64 = 0
            if has_action_window:
                return -1 if nodes[action_window_idx.usize()].kind != Json::RH_JSON_OBJ
                start_ok: mutable i64 = 0
                end_ok: mutable i64 = 0
                action_window_start <- Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, action_window_idx, "start"), &start_ok)
                action_window_end <- Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, action_window_idx, "end"), &end_ok)
                return -1 if start_ok == 0 or end_ok == 0 or action_window_start < 0 or action_window_end <= action_window_start
            if has_actions:
                return -1 if nodes[actions_idx.usize()].kind != Json::RH_JSON_ARR
                action_array: Json::RhJsonNode = nodes[actions_idx.usize()]
                while ac >= 0 |ac: i64 = action_array.first_child, nodes, texts, raw, actions|:
                    return -1 if nodes[ac.usize()].kind != Json::RH_JSON_OBJ
                    actor_idx: i64 = Json::rh_json_obj_get(nodes, texts, ac, "actor_id")
                    actor_action: mutable i64 = -1
                    if actor_idx >= 0:
                        if nodes[actor_idx.usize()].kind == Json::RH_JSON_NULL:
                            actor_action <- -1
                        else:
                            actor_ok: mutable i64 = 0
                            actor_action <- Json::rh_json_int(nodes, raw, actor_idx, &actor_ok)
                            return -1 if actor_ok == 0 or actor_action < 0
                    identity_actor_action: mutable i64 = actor_action
                    identity_actor_idx: i64 = Json::rh_json_obj_get(nodes, texts, ac, "identity_actor_id")
                    identity_actor_index_idx: i64 = Json::rh_json_obj_get(nodes, texts, ac, "identity_actor_index")
                    return -1 if identity_actor_idx >= 0 and identity_actor_index_idx >= 0
                    if identity_actor_idx >= 0:
                        identity_actor_ok: mutable i64 = 0
                        identity_actor_action <- Json::rh_json_int(nodes, raw, identity_actor_idx, &identity_actor_ok)
                        return -1 if identity_actor_ok == 0 or identity_actor_action < 0 or actor_action < 0
                        identity_override_count <- identity_override_count + 1
                    if identity_actor_index_idx >= 0:
                        identity_actor_index_ok: mutable i64 = 0
                        identity_actor_index: i64 = Json::rh_json_int(nodes, raw, identity_actor_index_idx, &identity_actor_index_ok)
                        return -1 if not has_identity_snapshot or identity_actor_index_ok == 0 or identity_actor_index < 0 or identity_actor_index >= identity_clusters.count.i64() or actor_action < 0
                        identity_actor_action <- identity_clusters[identity_actor_index.usize()]
                        identity_override_count <- identity_override_count + 1
                    at_action: i64 = rh_rr_int(nodes, raw, texts, ac, "at", -1)
                    kind_s: mutable i64 = 0
                    kind_e: mutable i64 = 0
                    return -1 if at_action < 0 or not rh_rr_str(nodes, texts, ac, "kind", &kind_s, &kind_e)
                    kind_action: u8 = rh_rr_action_kind(texts, kind_s, kind_e)
                    return -1 if kind_action == 0
                    change_id_start: mutable i64 = 0
                    change_id_end: mutable i64 = 0
                    change_id_idx: i64 = Json::rh_json_obj_get(nodes, texts, ac, "change_id")
                    if change_id_idx >= 0:
                        return -1 if not Json::rh_json_str_span(nodes, change_id_idx, &change_id_start, &change_id_end) or change_id_start == change_id_end
                        return -1 if kind_action != Roles::RH_ACTION_MERGE and kind_action != Roles::RH_ACTION_REVIEW
                    if has_action_window and (at_action < action_window_start or at_action >= action_window_end):
                        ac <- nodes[ac.usize()].next_sibling
                        continue
                    actor_kind_idx: i64 = Json::rh_json_obj_get(nodes, texts, ac, "actor_type")
                    actor_kind: mutable u8 = Roles::RH_ACTOR_KIND_UNKNOWN
                    if actor_kind_idx >= 0:
                        actor_kind_s: mutable i64 = 0
                        actor_kind_e: mutable i64 = 0
                        return -1 if not Json::rh_json_str_span(nodes, actor_kind_idx, &actor_kind_s, &actor_kind_e)
                        actor_kind <- rh_rr_actor_kind(texts, actor_kind_s, actor_kind_e)
                        return -1 if actor_kind == 255
                    actions.push(Roles::RhObservedAction{actor_id: actor_action, identity_actor_id: identity_actor_action, kind: kind_action, actor_kind: actor_kind, observed_at: at_action, change_id_start: change_id_start, change_id_end: change_id_end})
                    ac <- nodes[ac.usize()].next_sibling
            return -1 if identity_override_count > 0 and not has_identity_revision
            persistent_actors: mutable darray[i64] = []
            persistent_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "persistent_actors")
            has_persistent_profile: bool = persistent_idx >= 0
            if has_persistent_profile:
                return -1 if nodes[persistent_idx.usize()].kind != Json::RH_JSON_ARR
                persistent_array: Json::RhJsonNode = nodes[persistent_idx.usize()]
                while pa >= 0 |pa: i64 = persistent_array.first_child, nodes, raw, persistent_actors|:
                    actor_ok: mutable i64 = 0
                    actor_persistent: i64 = Json::rh_json_int(nodes, raw, pa, &actor_ok)
                    return -1 if actor_ok == 0 or actor_persistent < 0
                    persistent_actors.push(actor_persistent)
                    pa <- nodes[pa.usize()].next_sibling
            permission_complete_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "permission_inventory_complete")
            has_permission_complete: bool = permission_complete_idx >= 0
            permission_complete: mutable bool = false
            if has_permission_complete:
                return -1 if nodes[permission_complete_idx.usize()].kind != Json::RH_JSON_BOOL
                permission_complete <- Json::rh_json_is_true(nodes, raw, permission_complete_idx)
            review_focus_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "review_actor_id")
            has_review_focus: bool = review_focus_idx >= 0
            review_focus_actor: mutable i64 = -1
            if has_review_focus:
                review_focus_ok: mutable i64 = 0
                review_focus_actor <- Json::rh_json_int(nodes, raw, review_focus_idx, &review_focus_ok)
                return -1 if review_focus_ok == 0 or review_focus_actor < 0
            Base::rh_push_text(out, "{\"schema\":\"rh-roles-result/1\",\"declaration_count\":")
            Base::rh_push_decimal_i64(out, decls.count.i64())
            Base::rh_push_text(out, ",\"authorization_state\":\"")
            Base::rh_push_text(out, rh_rr_authorization_label(auth_state))
            Base::rh_push_text(out, "\"")
            Base::rh_push_text(out, ",\"observed_actions_window\":{\"start\":") if has_action_window
            Base::rh_push_decimal_i64(out, action_window_start) if has_action_window
            Base::rh_push_text(out, ",\"end\":") if has_action_window
            Base::rh_push_decimal_i64(out, action_window_end) if has_action_window
            Base::rh_push_text(out, "}") if has_action_window
            if has_identity_revision:
                Base::rh_push_text(out, ",\"identity_revision\":")
                Base::rh_push_decimal_i64(out, identity_revision)
            if scope_present:
                Base::rh_push_text(out, ",\"scope\":{\"")
                Base::rh_push_text(out, "project_path" if provider_is_gitlab else "repository")
                Base::rh_push_text(out, "\":\"")
                Base::rh_json_escape(out, texts, scope_repository_s.usize(), scope_repository_e.usize())
                Base::rh_push_text(out, "\"}")
            Base::rh_push_text(out, ",\"source_tally\":{\"provider\":")
            p: mutable i64 = 0
            f: mutable i64 = 0
            o: mutable i64 = 0
            Roles::rh_role_source_tally(decls, &p, &f, &o)
            owner_count: mutable i64 = 0
            maintainer_count: mutable i64 = 0
            triager_count: mutable i64 = 0
            member_count: mutable i64 = 0
            unknown_count: mutable i64 = 0
            Roles::rh_role_tally(decls, &owner_count, &maintainer_count, &triager_count, &member_count, &unknown_count)
            q_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "queries")
            has_as_of: mutable bool = false
            current_as_of: mutable i64 = 0
            explicit_as_of: i64 = Json::rh_json_obj_get(nodes, texts, root, "as_of")
            if explicit_as_of >= 0:
                as_of_ok: mutable i64 = 0
                current_as_of <- rh_rr_int(nodes, raw, texts, root, "as_of", 0)
                has_as_of <- Json::rh_json_int(nodes, raw, explicit_as_of, &as_of_ok) >= 0 and as_of_ok == 1
            if not has_as_of and q_idx >= 0:
                return -1 if nodes[q_idx.usize()].kind != Json::RH_JSON_ARR
                qtime: Json::RhJsonNode = nodes[q_idx.usize()]
                while qt >= 0 |qt: i64 = qtime.first_child, nodes, texts, raw, current_as_of, has_as_of|:
                    return -1 if nodes[qt.usize()].kind != Json::RH_JSON_OBJ
                    qas: i64 = rh_rr_int(nodes, raw, texts, qt, "as_of", 0)
                    if not has_as_of or qas > current_as_of:
                        current_as_of <- qas
                        has_as_of <- true
                    qt <- nodes[qt.usize()].next_sibling
            ended_count: mutable i64 = 0
            while i < decls.count |i: usize = 0, decls, ended_count|:
                ended_count <- ended_count + 1 if decls[i].revoked_at > 0
                i <- i + 1
            declared_current: mutable i64 = 0
            if has_as_of:
                while i < decls.count |i: usize = 0, decls, current_as_of, declared_current|:
                    d: Roles::RhRoleDecl = decls[i]
                    relevant: bool = d.role == Roles::RH_ROLE_OWNER or d.role == Roles::RH_ROLE_MAINTAINER
                    active: bool = relevant and d.declared_at <= current_as_of and (d.revoked_at == 0 or d.revoked_at > current_as_of)
                    seen: mutable bool = false
                    if active:
                        while j < i |j: usize = 0, i, decls, current_as_of, d, seen|:
                            prior: Roles::RhRoleDecl = decls[j]
                            prior_active: bool = prior.actor_id == d.actor_id and (prior.role == Roles::RH_ROLE_OWNER or prior.role == Roles::RH_ROLE_MAINTAINER) and prior.declared_at <= current_as_of and (prior.revoked_at == 0 or prior.revoked_at > current_as_of)
                            seen <- true if prior_active
                            j <- j + 1
                    declared_current <- declared_current + 1 if active and not seen
                    i <- i + 1
            permission_current: mutable i64 = 0
            if has_as_of and auth_state == 1:
                while i < decls.count |i: usize = 0, decls, current_as_of, permission_current|:
                    d: Roles::RhRoleDecl = decls[i]
                    active_permission: bool = d.source == Roles::RH_DECL_SOURCE_PROVIDER and d.permission != 0 and d.declared_at <= current_as_of and (d.revoked_at == 0 or d.revoked_at > current_as_of)
                    seen_permission: mutable bool = false
                    if active_permission:
                        while j < i |j: usize = 0, i, decls, current_as_of, d, seen_permission|:
                            prior: Roles::RhRoleDecl = decls[j]
                            prior_active: bool = prior.actor_id == d.actor_id and prior.source == Roles::RH_DECL_SOURCE_PROVIDER and prior.permission != 0 and prior.declared_at <= current_as_of and (prior.revoked_at == 0 or prior.revoked_at > current_as_of)
                            seen_permission <- true if prior_active
                            j <- j + 1
                    permission_current <- permission_current + 1 if active_permission and not seen_permission
                    i <- i + 1
            permission_inventory_den: mutable i64 = 0
            if has_as_of and auth_state == 1:
                while i < decls.count |i: usize = 0, decls, current_as_of, permission_inventory_den|:
                    d: Roles::RhRoleDecl = decls[i]
                    active_provider: bool = d.source == Roles::RH_DECL_SOURCE_PROVIDER and d.declared_at <= current_as_of and (d.revoked_at == 0 or d.revoked_at > current_as_of)
                    seen_provider: mutable bool = false
                    if active_provider:
                        while j < i |j: usize = 0, i, decls, current_as_of, d, seen_provider|:
                            prior: Roles::RhRoleDecl = decls[j]
                            prior_provider: bool = prior.actor_id == d.actor_id and prior.source == Roles::RH_DECL_SOURCE_PROVIDER and prior.declared_at <= current_as_of and (prior.revoked_at == 0 or prior.revoked_at > current_as_of)
                            seen_provider <- true if prior_provider
                            j <- j + 1
                    permission_inventory_den <- permission_inventory_den + 1 if active_provider and not seen_provider
                    i <- i + 1
            active_declared_12m: mutable i64 = -1
            if has_as_of and has_persistent_profile:
                active_declared_12m <- 0
                while i < decls.count |i: usize = 0, decls, current_as_of, persistent_actors, active_declared_12m|:
                    d: Roles::RhRoleDecl = decls[i]
                    persistent_actor: mutable bool = false
                    while k < persistent_actors.count |k: usize = 0, persistent_actors, d, persistent_actor|:
                        persistent_actor <- true if persistent_actors[k] == d.actor_id
                        k <- k + 1
                    eligible: bool = persistent_actor and (d.role == Roles::RH_ROLE_OWNER or d.role == Roles::RH_ROLE_MAINTAINER) and d.declared_at <= current_as_of and (d.revoked_at == 0 or d.revoked_at > current_as_of)
                    seen_12m: mutable bool = false
                    if eligible:
                        while j < i |j: usize = 0, i, decls, current_as_of, d, seen_12m|:
                            prior: Roles::RhRoleDecl = decls[j]
                            prior_eligible: bool = prior.actor_id == d.actor_id and (prior.role == Roles::RH_ROLE_OWNER or prior.role == Roles::RH_ROLE_MAINTAINER) and prior.declared_at <= current_as_of and (prior.revoked_at == 0 or prior.revoked_at > current_as_of)
                            seen_12m <- true if prior_eligible
                            j <- j + 1
                    active_declared_12m <- active_declared_12m + 1 if eligible and not seen_12m
                    i <- i + 1
            observed_release_actors: i64 = Roles::rh_observed_actor_count(actions, Roles::RH_ACTION_RELEASE)
