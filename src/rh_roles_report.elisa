# rh_roles_report.elisa — R013 declared-roles execution path.
#
# Turns an `rh-roles-input/1` document of time-scoped role/permission
# declarations plus queries into `rh-roles-result/1`. Declared roles are
# evidence, separate from observed actions (the report says so); an
# unrecognized role string is `unknown`, never guessed at maintainer; a
# revoked or not-yet-effective declaration is not active at that time; and
# the declaration source (provider/file/operator) is tallied. Malformed
# input fails closed.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_roles.elisa"
include "./rh_observation.elisa"

module RolesReport:
    private:
        struct RhRoleActorState:
            actor_id: i64
            persistent: mutable bool
            active_declared: mutable bool
            active_provider: mutable bool
            active_provider_permission: mutable bool

        struct RhRoleActorTallies:
            declared_current: i64
            active_declared_12m: i64
            permission_current: i64
            permission_inventory_denominator: i64

        struct RhRoleChangeSource:
            status: i64
            collection_complete: bool
            atomic_snapshot: bool
            repository_start: i64
            repository_end: i64
            as_of: i64
            source_sha_start: i64
            source_sha_end: i64
            reason_start: i64
            reason_end: i64

        const RH_RR_CHANGE_SOURCE_UNKNOWN: i64 = 0
        const RH_RR_CHANGE_SOURCE_COMPLETE: i64 = 1
        const RH_RR_CHANGE_SOURCE_PARTIAL: i64 = 2

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_rr_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_rr_source(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Roles::RH_DECL_SOURCE_PROVIDER if rh_rr_eq(texts, s, e, "provider")
            return Roles::RH_DECL_SOURCE_FILE if rh_rr_eq(texts, s, e, "file")
            return Roles::RH_DECL_SOURCE_OPERATOR if rh_rr_eq(texts, s, e, "operator")
            -1

        # Authorization is evidence about how a provider declaration was obtained;
        # it never changes the declaration's role semantics. Keep the state closed
        # so an adapter cannot silently turn an unrecognized value into authorization.
        def rh_rr_authorization(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return 1 if rh_rr_eq(texts, s, e, "authorized")
            return 2 if rh_rr_eq(texts, s, e, "unauthorized")
            return 3 if rh_rr_eq(texts, s, e, "not_requested")
            return 4 if rh_rr_eq(texts, s, e, "unknown")
            -1

        def rh_rr_authorization_label(state: i64) -> u8&:
            return "authorized" if state == 1
            return "unauthorized" if state == 2
            return "not_requested" if state == 3
            "unknown"

        def rh_rr_action_kind(texts: darray[u8]&, s: i64, e: i64) -> u8:
            return Roles::RH_ACTION_RELEASE if rh_rr_eq(texts, s, e, "release")
            return Roles::RH_ACTION_MERGE if rh_rr_eq(texts, s, e, "merge")
            return Roles::RH_ACTION_REVIEW if rh_rr_eq(texts, s, e, "review")
            0

        def rh_rr_actor_kind(texts: darray[u8]&, s: i64, e: i64) -> u8:
            return Roles::RH_ACTOR_KIND_HUMAN if rh_rr_eq(texts, s, e, "human")
            return Roles::RH_ACTOR_KIND_BOT if rh_rr_eq(texts, s, e, "bot")
            return Roles::RH_ACTOR_KIND_SERVICE if rh_rr_eq(texts, s, e, "service")
            return Roles::RH_ACTOR_KIND_UNKNOWN if rh_rr_eq(texts, s, e, "unknown")
            255

        def rh_rr_actor_hash(actor_id: i64) -> usize:
            key: mutable u64 = actor_id.u64()
            hash: u64 =
                while byte_index < 8 |hash: mutable u64 = 0xcbf29ce484222325, byte_index: usize = 0, key| -> hash:
                    shift: u64 = byte_index.u64() * 8
                    hash <- (hash ^ ((key >> shift).u8().u64())) * 0x100000001b3
                    byte_index <- byte_index + 1
            hash.usize()

        def rh_rr_role_actor_state_index(actor_id: i64, slots: mutable darray[i64]&, actors: mutable darray[RhRoleActorState]&) -> usize can[Memory.Allocate, Abort.Panic]:
            slot: mutable usize = RolesReport::rh_rr_actor_hash(actor_id) % slots.count
            while slots[slot] != 0 |slot, slots, actors, actor_id|:
                actor_index: usize = (slots[slot] - 1).usize()
                return actor_index if actors[actor_index].actor_id == actor_id
                slot <- (slot + 1) % slots.count
            actors.push(RhRoleActorState{
                actor_id: actor_id,
                persistent: false,
                active_declared: false,
                active_provider: false,
                active_provider_permission: false
            })
            slots[slot] <- actors.count.i64()
            actors.count - 1

        def rh_rr_role_actor_tallies(decls: darray[Roles::RhRoleDecl]&, persistent_actors: darray[i64]&, as_of: i64, has_as_of: bool, has_persistent_profile: bool, authorized: bool) -> RhRoleActorTallies can[Memory.Allocate, Abort.Panic]:
            if not has_as_of:
                return RhRoleActorTallies{declared_current: 0, active_declared_12m: -1, permission_current: 0, permission_inventory_denominator: 0}
            max_actor_keys: usize = decls.count + persistent_actors.count if has_persistent_profile else decls.count
            capacity: usize = max_actor_keys * 2 + 1
            slots: mutable darray[i64] = []
            while i < capacity |i: usize = 0, capacity, slots|:
                slots.push(0)
                i <- i + 1
            actors: mutable darray[RhRoleActorState] = []
            if has_persistent_profile:
                while i < persistent_actors.count |i: usize = 0, persistent_actors, slots, actors|:
                    actor_index: usize = RolesReport::rh_rr_role_actor_state_index(persistent_actors[i], slots, actors)
                    actors[actor_index].persistent <- true
                    i <- i + 1
            declared_current: mutable i64 = 0
            active_declared_12m: mutable i64 = 0 if has_persistent_profile else -1
            permission_current: mutable i64 = 0
            permission_inventory_denominator: mutable i64 = 0
            while i < decls.count |i: usize = 0, decls, as_of, authorized, has_persistent_profile, slots, actors, declared_current, active_declared_12m, permission_current, permission_inventory_denominator|:
                declaration: Roles::RhRoleDecl = decls[i]
                active: bool = declaration.declared_at <= as_of and (declaration.revoked_at == 0 or declaration.revoked_at > as_of)
                active_role: bool = active and (declaration.role == Roles::RH_ROLE_OWNER or declaration.role == Roles::RH_ROLE_MAINTAINER)
                active_provider: bool = authorized and active and declaration.source == Roles::RH_DECL_SOURCE_PROVIDER
                if active_role or active_provider:
                    actor_index: usize = RolesReport::rh_rr_role_actor_state_index(declaration.actor_id, slots, actors)
                    actor: RhRoleActorState = actors[actor_index]
                    if active_role and not actor.active_declared:
                        actors[actor_index].active_declared <- true
                        declared_current <- declared_current + 1
                        active_declared_12m <- active_declared_12m + 1 if has_persistent_profile and actor.persistent
                    if active_provider and not actor.active_provider:
                        actors[actor_index].active_provider <- true
                        permission_inventory_denominator <- permission_inventory_denominator + 1
                    if active_provider and declaration.permission != 0 and not actor.active_provider_permission:
                        actors[actor_index].active_provider_permission <- true
                        permission_current <- permission_current + 1
                i <- i + 1
            RhRoleActorTallies{
                declared_current: declared_current,
                active_declared_12m: active_declared_12m,
                permission_current: permission_current,
                permission_inventory_denominator: permission_inventory_denominator
            }

        def rh_rr_emit_actor_type_counts(out: mutable darray[u8]&, counts: Roles::RhActionActorTypeCounts&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"human\":")
            Base::rh_push_decimal_i64(out, counts.human)
            Base::rh_push_text(out, ",\"bot\":")
            Base::rh_push_decimal_i64(out, counts.bot)
            Base::rh_push_text(out, ",\"service\":")
            Base::rh_push_decimal_i64(out, counts.service)
            Base::rh_push_text(out, ",\"unknown\":")
            Base::rh_push_decimal_i64(out, counts.unknown)
            Base::rh_push_text(out, "}")

        def rh_rr_observation(value: Observation::RhMetricValue, status: u8) -> Observation::RhObservation can[Memory.Allocate, Abort.Panic]:
            quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{
                completeness: Observation::RhCompleteness.Complete if status == Observation::RH_ST_OBSERVED else Observation::RhCompleteness.Unknown,
                freshness: Observation::RhFreshness.Unknown,
                validity: Observation::RhValidity.Valid if status == Observation::RH_ST_OBSERVED else Observation::RhValidity.Unknown,
                provenance: Observation::RhProvenanceQuality.EvidenceBacked
            }
            evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
            Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.RolesInput)
            Observation::rh_observation_make_with_evidence(
                status,
                value,
                false,
                quality,
                evidence
            )

        def rh_rr_emit_typed_metric(out: mutable darray[u8]&, key: cstr, value: Observation::RhMetricValue, status: u8, reason: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            observation: Observation::RhObservation = RolesReport::rh_rr_observation(value, status)
            Observation::rh_observation_emit_metric(out, key, "1.0.0", reason, observation)

        def rh_rr_emit_metric_with_as_of(out: mutable darray[u8]&, key: cstr, value: Observation::RhMetricValue, status: u8, reason: cstr, has_as_of: bool, as_of: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            observation: Observation::RhObservation = RolesReport::rh_rr_observation(value, status)
            Observation::rh_observation_emit_metric_with_optional_as_of(out, key, "1.0.0", reason, has_as_of, as_of, observation)

        def rh_rr_emit_count_metric(out: mutable darray[u8]&, key: cstr, count: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_rr_emit_typed_metric(out, key, Observation::RhMetricValue.Count(count), Observation::RH_ST_OBSERVED, "")

        def rh_rr_emit_ratio_metric(out: mutable darray[u8]&, key: cstr, numerator: i64, denominator: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not Observation::rh_ratio_valid(numerator, denominator)
            rh_rr_emit_typed_metric(out, key, Observation::RhMetricValue.Ratio(numerator, denominator), Observation::RH_ST_OBSERVED, "")

        def rh_rr_emit_partial_count_metric(out: mutable darray[u8]&, key: cstr, count: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{
                completeness: Observation::RhCompleteness.Partial,
                freshness: Observation::RhFreshness.Unknown,
                validity: Observation::RhValidity.Valid,
                provenance: Observation::RhProvenanceQuality.EvidenceBacked
            }
            evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
            Observation::rh_evidence_links_push(&evidence, Observation::RhEvidenceObject.RolesInput)
            observation: Observation::RhObservation = Observation::rh_observation_make_with_evidence(
                Observation::RH_ST_PARTIAL,
                Observation::RhMetricValue.Count(count),
                true,
                quality,
                evidence
            )
            Observation::rh_observation_emit_metric(out, key, "1.0.0", "change-population-source-incomplete", observation)

        def rh_rr_emit_change_review_metrics(out: mutable darray[u8]&, source_status: i64, has_actions: bool, reviewed_changes: i64, linked_changes: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            if source_status == RH_RR_CHANGE_SOURCE_COMPLETE and has_actions:
                return false if not rh_rr_emit_count_metric(out, "maintainer.reviewed_merge_change_count", reviewed_changes)
                out.push(44)
                return false if not rh_rr_emit_count_metric(out, "maintainer.linked_merge_change_count", linked_changes)
                true
            elif source_status == RH_RR_CHANGE_SOURCE_PARTIAL and has_actions:
                return false if not rh_rr_emit_partial_count_metric(out, "maintainer.reviewed_merge_change_count", reviewed_changes)
                out.push(44)
                return false if not rh_rr_emit_partial_count_metric(out, "maintainer.linked_merge_change_count", linked_changes)
                true
            else:
                reason: cstr = "change-population-completeness-not-supplied" if has_actions else "observed-actions-not-supplied"
                return false if not rh_rr_emit_typed_metric(out, "maintainer.reviewed_merge_change_count", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, reason)
                out.push(44)
                return false if not rh_rr_emit_typed_metric(out, "maintainer.linked_merge_change_count", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, reason)
                true

        def rh_rr_sha256_hex(texts: darray[u8]&, start: i64, end: i64) -> bool:
            return false if start < 0 or end - start != 64
            while offset < 64 |offset: i64 = 0, texts, start|:
                byte: u8 = texts[(start + offset).usize()]
                return false if not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102))
                offset <- offset + 1
            true

        def rh_rr_read_change_source(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, root: i64, provider_is_github: bool, scope_present: bool, scope_repository_start: i64, scope_repository_end: i64, has_actions: bool, source_out: mutable RhRoleChangeSource&) -> bool can[Memory.Allocate, Abort.Panic]:
            source_out[0] <- RhRoleChangeSource{
                status: RH_RR_CHANGE_SOURCE_UNKNOWN,
                collection_complete: false,
                atomic_snapshot: false,
                repository_start: 0,
                repository_end: 0,
                as_of: 0,
                source_sha_start: 0,
                source_sha_end: 0,
                reason_start: 0,
                reason_end: 0
            }
            source_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "linked_change_population")
            return true if source_idx < 0
            return false if not provider_is_github or not scope_present or not has_actions or nodes[source_idx.usize()].kind != Json::RH_JSON_OBJ or nodes[source_idx.usize()].child_count != 16
            source_start: mutable i64 = 0
            source_end: mutable i64 = 0
            return false if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, source_idx, "source"), &source_start, &source_end) or not rh_rr_eq(texts, source_start, source_end, "github-review-chain")
            repository_start: mutable i64 = 0
            repository_end: mutable i64 = 0
            return false if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, source_idx, "repository"), &repository_start, &repository_end) or not Base::rh_bytes_equal_span(texts, repository_start, repository_end, texts, scope_repository_start, scope_repository_end)
            source_as_of_ok: mutable i64 = 0
            source_as_of: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, source_idx, "as_of"), &source_as_of_ok)
            root_as_of_ok: mutable i64 = 0
            root_as_of: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, root, "as_of"), &root_as_of_ok)
            return false if source_as_of_ok == 0 or root_as_of_ok == 0 or source_as_of < 0 or source_as_of != root_as_of
            collection_status_start: mutable i64 = 0
            collection_status_end: mutable i64 = 0
            return false if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, source_idx, "collection_status"), &collection_status_start, &collection_status_end)
            collection_complete: bool = rh_rr_eq(texts, collection_status_start, collection_status_end, "complete")
            return false if not collection_complete and not rh_rr_eq(texts, collection_status_start, collection_status_end, "partial")
            population_status_start: mutable i64 = 0
            population_status_end: mutable i64 = 0
            return false if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, source_idx, "status"), &population_status_start, &population_status_end)
            population_complete: bool = rh_rr_eq(texts, population_status_start, population_status_end, "complete")
            return false if not population_complete and not rh_rr_eq(texts, population_status_start, population_status_end, "partial")
            atomic_idx: i64 = Json::rh_json_obj_get(nodes, texts, source_idx, "atomic_snapshot")
            return false if atomic_idx < 0 or nodes[atomic_idx.usize()].kind != Json::RH_JSON_BOOL
            atomic_snapshot: bool = Json::rh_json_is_true(nodes, raw, atomic_idx)
            sha_start: mutable i64 = 0
            sha_end: mutable i64 = 0
            return false if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, source_idx, "source_sha256"), &sha_start, &sha_end) or not rh_rr_sha256_hex(texts, sha_start, sha_end)
            reason_start: mutable i64 = 0
            reason_end: mutable i64 = 0
            return false if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, source_idx, "reason"), &reason_start, &reason_end)
            complete: bool = collection_complete and atomic_snapshot and population_complete
            return false if population_complete != complete
            return false if complete and reason_end != reason_start
            return false if not complete and reason_end == reason_start
            source_out[0] <- RhRoleChangeSource{
                status: RH_RR_CHANGE_SOURCE_COMPLETE if complete else RH_RR_CHANGE_SOURCE_PARTIAL,
                collection_complete: collection_complete,
                atomic_snapshot: atomic_snapshot,
                repository_start: repository_start,
                repository_end: repository_end,
                as_of: source_as_of,
                source_sha_start: sha_start,
                source_sha_end: sha_end,
                reason_start: reason_start,
                reason_end: reason_end
            }
            true

        def rh_rr_emit_change_source(out: mutable darray[u8]&, texts: darray[u8]&, source: RhRoleChangeSource) -> void can[Memory.Allocate, Abort.Panic]:
            return if source.status == RH_RR_CHANGE_SOURCE_UNKNOWN
            Base::rh_push_text(out, "\"change_review_source\":{\"source\":\"github-review-chain\",\"repository\":\"")
            Base::rh_json_escape(out, texts, source.repository_start.usize(), source.repository_end.usize())
            Base::rh_push_text(out, "\",\"as_of\":")
            Base::rh_push_decimal_i64(out, source.as_of)
            Base::rh_push_text(out, ",\"collection_status\":\"")
            Base::rh_push_text(out, "complete" if source.collection_complete else "partial")
            Base::rh_push_text(out, "\",\"status\":\"")
            Base::rh_push_text(out, "complete" if source.status == RH_RR_CHANGE_SOURCE_COMPLETE else "partial")
            Base::rh_push_text(out, "\",\"atomic_snapshot\":")
            Base::rh_push_text(out, "true" if source.atomic_snapshot else "false")
            Base::rh_push_text(out, ",\"source_sha256\":\"")
            Base::rh_json_escape(out, texts, source.source_sha_start.usize(), source.source_sha_end.usize())
            Base::rh_push_text(out, "\",\"reason\":\"")
            Base::rh_json_escape(out, texts, source.reason_start.usize(), source.reason_end.usize())
            Base::rh_push_text(out, "\"}")

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_rr_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return false if idx < 0
            Json::rh_json_str_span(nodes, idx, s_out, e_out)

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_rr_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, default_v: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            ok: mutable i64 = 0
            v: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, obj, key), &ok)
            return default_v if ok == 0
            v

    public:
        def rh_roles_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            sspan: mutable i64 = 0
            espan: mutable i64 = 0
            sc: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
            return -1 if sc < 0 or not Json::rh_json_str_span(nodes, sc, &sspan, &espan)
            return -1 if not rh_rr_eq(texts, sspan, espan, "rh-roles-input/1")
            provider_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "provider")
            provider_s: mutable i64 = 0
            provider_e: mutable i64 = 0
            provider_is_gitlab: bool = provider_idx >= 0 and Json::rh_json_str_span(nodes, provider_idx, &provider_s, &provider_e) and rh_rr_eq(texts, provider_s, provider_e, "gitlab")
            provider_is_github: bool = provider_idx >= 0 and Json::rh_json_str_span(nodes, provider_idx, &provider_s, &provider_e) and rh_rr_eq(texts, provider_s, provider_e, "github")
            identity_revision_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "identity_revision")
            has_identity_revision: mutable bool = identity_revision_idx >= 0
            identity_revision: mutable i64 = -1
            if has_identity_revision:
                identity_revision_ok: mutable i64 = 0
                identity_revision <- Json::rh_json_int(nodes, raw, identity_revision_idx, &identity_revision_ok)
                return -1 if identity_revision_ok == 0 or identity_revision < 0
            identity_clusters: mutable darray[i64] = []
            identity_snapshot_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "identity_snapshot")
            has_identity_snapshot: bool = identity_snapshot_idx >= 0
            if has_identity_snapshot:
                return -1 if nodes[identity_snapshot_idx.usize()].kind != Json::RH_JSON_OBJ
                snapshot_revision_idx: i64 = Json::rh_json_obj_get(nodes, texts, identity_snapshot_idx, "identity_revision")
                snapshot_revision_ok: mutable i64 = 0
                snapshot_revision: i64 = Json::rh_json_int(nodes, raw, snapshot_revision_idx, &snapshot_revision_ok)
                return -1 if snapshot_revision_ok == 0 or snapshot_revision < 0
                return -1 if has_identity_revision and identity_revision != snapshot_revision
                identity_revision <- snapshot_revision
                has_identity_revision <- true
                identity_clusters_idx: i64 = Json::rh_json_obj_get(nodes, texts, identity_snapshot_idx, "cluster_id_by_actor")
                return -1 if identity_clusters_idx < 0 or nodes[identity_clusters_idx.usize()].kind != Json::RH_JSON_ARR
                clusters_array: Json::RhJsonNode = nodes[identity_clusters_idx.usize()]
                while ic >= 0 |ic: i64 = clusters_array.first_child, nodes, raw, identity_clusters|:
                    cluster_ok: mutable i64 = 0
                    cluster_id: i64 = Json::rh_json_int(nodes, raw, ic, &cluster_ok)
                    return -1 if cluster_ok == 0 or cluster_id < 0
                    identity_clusters.push(cluster_id)
                    ic <- nodes[ic.usize()].next_sibling
                while icheck < identity_clusters.count |icheck: usize = 0, identity_clusters|:
                    return -1 if identity_clusters[icheck] >= identity_clusters.count.i64()
                    icheck <- icheck + 1
            decls: mutable darray[Roles::RhRoleDecl] = []
            actions: mutable darray[Roles::RhObservedAction] = []
            identity_override_count: mutable i64 = 0
            d_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "declarations")
            return -1 if d_idx < 0 or nodes[d_idx.usize()].kind != Json::RH_JSON_ARR
            auth_state: mutable i64 = 4
            auth_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "authorization")
            if auth_idx >= 0:
                return -1 if nodes[auth_idx.usize()].kind != Json::RH_JSON_OBJ
                auth_value: i64 = Json::rh_json_obj_get(nodes, texts, auth_idx, "state")
                auth_s: mutable i64 = 0
                auth_e: mutable i64 = 0
                return -1 if auth_value < 0 or not Json::rh_json_str_span(nodes, auth_value, &auth_s, &auth_e)
                auth_state <- rh_rr_authorization(texts, auth_s, auth_e)
                return -1 if auth_state < 0
            scope_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "scope")
            scope_present: bool = scope_idx >= 0
            scope_repository_s: mutable i64 = 0
            scope_repository_e: mutable i64 = 0
            if scope_present:
                return -1 if nodes[scope_idx.usize()].kind != Json::RH_JSON_OBJ
                scope_key: u8& = "project_path" if provider_is_gitlab else "repository"
                scope_repository: i64 = Json::rh_json_obj_get(nodes, texts, scope_idx, scope_key)
                return -1 if scope_repository < 0 or not Json::rh_json_str_span(nodes, scope_repository, &scope_repository_s, &scope_repository_e)
            darr: Json::RhJsonNode = nodes[d_idx.usize()]
            while dc >= 0 |dc: i64 = darr.first_child, nodes, texts, raw, decls|:
                return -1 if nodes[dc.usize()].kind != Json::RH_JSON_OBJ
                rs: mutable i64 = 0
                re: mutable i64 = 0
                ss: mutable i64 = 0
                se: mutable i64 = 0
                return -1 if not rh_rr_str(nodes, texts, dc, "role", &rs, &re)
                return -1 if not rh_rr_str(nodes, texts, dc, "source", &ss, &se)
                role: u8 = Roles::rh_role_parse_role(texts, rs, re)
                source: i64 = rh_rr_source(texts, ss, se)
                return -1 if source < 0
                actor: i64 = rh_rr_int(nodes, raw, texts, dc, "actor_id", -1)
                return -1 if actor < 0
                decls.push(Roles::RhRoleDecl{actor_id: actor, role: role, permission: rh_rr_int(nodes, raw, texts, dc, "permission", 0).u8(), source: source.u8(), declared_at: rh_rr_int(nodes, raw, texts, dc, "declared_at", 0), revoked_at: rh_rr_int(nodes, raw, texts, dc, "revoked_at", 0)})
                dc <- nodes[dc.usize()].next_sibling
            actions_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "observed_actions")
            has_actions: bool = actions_idx >= 0
            action_window_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "observed_actions_window")
            has_action_window: bool = action_window_idx >= 0
            action_window_start: mutable i64 = 0
            action_window_end: mutable i64 = 0
            if has_action_window:
                return -1 if nodes[action_window_idx.usize()].kind != Json::RH_JSON_OBJ
                start_ok: mutable i64 = 0
                end_ok: mutable i64 = 0
                action_window_start <- Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, action_window_idx, "start"), &start_ok)
                action_window_end <- Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, action_window_idx, "end"), &end_ok)
                return -1 if start_ok == 0 or end_ok == 0 or action_window_start < 0 or action_window_end <= action_window_start
            if has_actions:
                return -1 if nodes[actions_idx.usize()].kind != Json::RH_JSON_ARR
                action_array: Json::RhJsonNode = nodes[actions_idx.usize()]
                while ac >= 0 |ac: i64 = action_array.first_child, nodes, texts, raw, actions|:
                    return -1 if nodes[ac.usize()].kind != Json::RH_JSON_OBJ
                    actor_idx: i64 = Json::rh_json_obj_get(nodes, texts, ac, "actor_id")
                    actor_action: mutable i64 = -1
                    if actor_idx >= 0:
                        if nodes[actor_idx.usize()].kind == Json::RH_JSON_NULL:
                            actor_action <- -1
                        else:
                            actor_ok: mutable i64 = 0
                            actor_action <- Json::rh_json_int(nodes, raw, actor_idx, &actor_ok)
                            return -1 if actor_ok == 0 or actor_action < 0
                    identity_actor_action: mutable i64 = actor_action
                    identity_actor_idx: i64 = Json::rh_json_obj_get(nodes, texts, ac, "identity_actor_id")
                    identity_actor_index_idx: i64 = Json::rh_json_obj_get(nodes, texts, ac, "identity_actor_index")
                    return -1 if identity_actor_idx >= 0 and identity_actor_index_idx >= 0
                    if identity_actor_idx >= 0:
                        identity_actor_ok: mutable i64 = 0
                        identity_actor_action <- Json::rh_json_int(nodes, raw, identity_actor_idx, &identity_actor_ok)
                        return -1 if identity_actor_ok == 0 or identity_actor_action < 0 or actor_action < 0
                        identity_override_count <- identity_override_count + 1
                    if identity_actor_index_idx >= 0:
                        identity_actor_index_ok: mutable i64 = 0
                        identity_actor_index: i64 = Json::rh_json_int(nodes, raw, identity_actor_index_idx, &identity_actor_index_ok)
                        return -1 if not has_identity_snapshot or identity_actor_index_ok == 0 or identity_actor_index < 0 or identity_actor_index >= identity_clusters.count.i64() or actor_action < 0
                        identity_actor_action <- identity_clusters[identity_actor_index.usize()]
                        identity_override_count <- identity_override_count + 1
                    at_action: i64 = rh_rr_int(nodes, raw, texts, ac, "at", -1)
                    kind_s: mutable i64 = 0
                    kind_e: mutable i64 = 0
                    return -1 if at_action < 0 or not rh_rr_str(nodes, texts, ac, "kind", &kind_s, &kind_e)
                    kind_action: u8 = rh_rr_action_kind(texts, kind_s, kind_e)
                    return -1 if kind_action == 0
                    change_id_start: mutable i64 = 0
                    change_id_end: mutable i64 = 0
                    change_id_idx: i64 = Json::rh_json_obj_get(nodes, texts, ac, "change_id")
                    if change_id_idx >= 0:
                        return -1 if not Json::rh_json_str_span(nodes, change_id_idx, &change_id_start, &change_id_end) or change_id_start == change_id_end
                        return -1 if kind_action != Roles::RH_ACTION_MERGE and kind_action != Roles::RH_ACTION_REVIEW
                    if has_action_window and (at_action < action_window_start or at_action >= action_window_end):
                        ac <- nodes[ac.usize()].next_sibling
                        continue
                    actor_kind_idx: i64 = Json::rh_json_obj_get(nodes, texts, ac, "actor_type")
                    actor_kind: mutable u8 = Roles::RH_ACTOR_KIND_UNKNOWN
                    if actor_kind_idx >= 0:
                        actor_kind_s: mutable i64 = 0
                        actor_kind_e: mutable i64 = 0
                        return -1 if not Json::rh_json_str_span(nodes, actor_kind_idx, &actor_kind_s, &actor_kind_e)
                        actor_kind <- rh_rr_actor_kind(texts, actor_kind_s, actor_kind_e)
                        return -1 if actor_kind == 255
                    actions.push(Roles::RhObservedAction{actor_id: actor_action, identity_actor_id: identity_actor_action, kind: kind_action, actor_kind: actor_kind, observed_at: at_action, change_id_start: change_id_start, change_id_end: change_id_end})
                    ac <- nodes[ac.usize()].next_sibling
            return -1 if identity_override_count > 0 and not has_identity_revision
            change_source: mutable RhRoleChangeSource = RhRoleChangeSource{
                status: RH_RR_CHANGE_SOURCE_UNKNOWN,
                collection_complete: false,
                atomic_snapshot: false,
                repository_start: 0,
                repository_end: 0,
                as_of: 0,
                source_sha_start: 0,
                source_sha_end: 0,
                reason_start: 0,
                reason_end: 0
            }
            return -1 if not RolesReport::rh_rr_read_change_source(nodes, raw, texts, root, provider_is_github, scope_present, scope_repository_s, scope_repository_e, has_actions, &change_source)
            persistent_actors: mutable darray[i64] = []
            persistent_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "persistent_actors")
            has_persistent_profile: bool = persistent_idx >= 0
            if has_persistent_profile:
                return -1 if nodes[persistent_idx.usize()].kind != Json::RH_JSON_ARR
                persistent_array: Json::RhJsonNode = nodes[persistent_idx.usize()]
                while pa >= 0 |pa: i64 = persistent_array.first_child, nodes, raw, persistent_actors|:
                    actor_ok: mutable i64 = 0
                    actor_persistent: i64 = Json::rh_json_int(nodes, raw, pa, &actor_ok)
                    return -1 if actor_ok == 0 or actor_persistent < 0
                    persistent_actors.push(actor_persistent)
                    pa <- nodes[pa.usize()].next_sibling
            permission_complete_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "permission_inventory_complete")
            has_permission_complete: bool = permission_complete_idx >= 0
            permission_complete: mutable bool = false
            if has_permission_complete:
                return -1 if nodes[permission_complete_idx.usize()].kind != Json::RH_JSON_BOOL
                permission_complete <- Json::rh_json_is_true(nodes, raw, permission_complete_idx)
            review_focus_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "review_actor_id")
            has_review_focus: bool = review_focus_idx >= 0
            review_focus_actor: mutable i64 = -1
            if has_review_focus:
                review_focus_ok: mutable i64 = 0
                review_focus_actor <- Json::rh_json_int(nodes, raw, review_focus_idx, &review_focus_ok)
                return -1 if review_focus_ok == 0 or review_focus_actor < 0
            Base::rh_push_text(out, "{\"schema\":\"rh-roles-result/1\",\"declaration_count\":")
            Base::rh_push_decimal_i64(out, decls.count.i64())
            Base::rh_push_text(out, ",\"authorization_state\":\"")
            Base::rh_push_text(out, rh_rr_authorization_label(auth_state))
            Base::rh_push_text(out, "\"")
            Base::rh_push_text(out, ",\"observed_actions_window\":{\"start\":") if has_action_window
            Base::rh_push_decimal_i64(out, action_window_start) if has_action_window
            Base::rh_push_text(out, ",\"end\":") if has_action_window
            Base::rh_push_decimal_i64(out, action_window_end) if has_action_window
            Base::rh_push_text(out, "}") if has_action_window
            if has_identity_revision:
                Base::rh_push_text(out, ",\"identity_revision\":")
                Base::rh_push_decimal_i64(out, identity_revision)
            if scope_present:
                Base::rh_push_text(out, ",\"scope\":{\"")
                Base::rh_push_text(out, "project_path" if provider_is_gitlab else "repository")
                Base::rh_push_text(out, "\":\"")
                Base::rh_json_escape(out, texts, scope_repository_s.usize(), scope_repository_e.usize())
                Base::rh_push_text(out, "\"}")
            role_summary: Roles::RhRoleSummary = Roles::rh_role_summary(decls)
            Base::rh_push_text(out, ",\"source_tally\":{\"provider\":")
            q_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "queries")
            has_as_of: mutable bool = false
            current_as_of: mutable i64 = 0
            explicit_as_of: i64 = Json::rh_json_obj_get(nodes, texts, root, "as_of")
            if explicit_as_of >= 0:
                as_of_ok: mutable i64 = 0
                current_as_of <- rh_rr_int(nodes, raw, texts, root, "as_of", 0)
                has_as_of <- Json::rh_json_int(nodes, raw, explicit_as_of, &as_of_ok) >= 0 and as_of_ok == 1
            if not has_as_of and q_idx >= 0:
                return -1 if nodes[q_idx.usize()].kind != Json::RH_JSON_ARR
                qtime: Json::RhJsonNode = nodes[q_idx.usize()]
                while qt >= 0 |qt: i64 = qtime.first_child, nodes, texts, raw, current_as_of, has_as_of|:
                    return -1 if nodes[qt.usize()].kind != Json::RH_JSON_OBJ
                    qas: i64 = rh_rr_int(nodes, raw, texts, qt, "as_of", 0)
                    if not has_as_of or qas > current_as_of:
                        current_as_of <- qas
                        has_as_of <- true
                    qt <- nodes[qt.usize()].next_sibling
            role_actor_tallies: RhRoleActorTallies = RolesReport::rh_rr_role_actor_tallies(decls, persistent_actors, current_as_of, has_as_of, has_persistent_profile, auth_state == 1)
            linked_reviewed_changes: mutable i64 = 0
            linked_merged_changes: mutable i64 = 0
            unlinked_merge_actions: mutable i64 = 0
            return -1 if has_actions and not Roles::rh_observed_linked_merge_review_counts(actions, texts, &linked_reviewed_changes, &linked_merged_changes, &unlinked_merge_actions)
            action_tallies: Roles::RhObservedActionTallies = Roles::rh_observed_action_tallies(actions, review_focus_actor)
            Base::rh_push_decimal_i64(out, role_summary.provider_sources)
            Base::rh_push_text(out, ",\"file\":")
            Base::rh_push_decimal_i64(out, role_summary.file_sources)
            Base::rh_push_text(out, ",\"operator\":")
            Base::rh_push_decimal_i64(out, role_summary.operator_sources)
            Base::rh_push_text(out, "},\"role_tally\":{\"owner\":")
            Base::rh_push_decimal_i64(out, role_summary.owner)
            Base::rh_push_text(out, ",\"maintainer\":")
            Base::rh_push_decimal_i64(out, role_summary.maintainer)
            Base::rh_push_text(out, ",\"triager\":")
            Base::rh_push_decimal_i64(out, role_summary.triager)
            Base::rh_push_text(out, ",\"member\":")
            Base::rh_push_decimal_i64(out, role_summary.member)
            Base::rh_push_text(out, ",\"unknown\":")
            Base::rh_push_decimal_i64(out, role_summary.unknown_role)
            Base::rh_push_text(out, "},\"action_events_by_actor_type\":{\"status\":\"")
            Base::rh_push_text(out, "observed") if has_actions
            Base::rh_push_text(out, "unsupported") if not has_actions
            Base::rh_push_text(out, "\",\"release\":")
            RolesReport::rh_rr_emit_actor_type_counts(out, action_tallies.actor_types.release)
            Base::rh_push_text(out, ",\"merge\":")
            RolesReport::rh_rr_emit_actor_type_counts(out, action_tallies.actor_types.merge)
            Base::rh_push_text(out, ",\"review\":")
            RolesReport::rh_rr_emit_actor_type_counts(out, action_tallies.actor_types.review)
            Base::rh_push_text(out, "},\"metrics\":[")
            return -1 if not RolesReport::rh_rr_emit_count_metric(out, "roles.owner_declaration_count", role_summary.owner)
            out.push(44)
            return -1 if not RolesReport::rh_rr_emit_count_metric(out, "roles.maintainer_declaration_count", role_summary.maintainer)
            out.push(44)
            return -1 if not RolesReport::rh_rr_emit_count_metric(out, "roles.triager_declaration_count", role_summary.triager)
            out.push(44)
            return -1 if not RolesReport::rh_rr_emit_count_metric(out, "roles.member_declaration_count", role_summary.member)
            out.push(44)
            return -1 if not RolesReport::rh_rr_emit_count_metric(out, "roles.unknown_declaration_count", role_summary.unknown_role)
            out.push(44)
            return -1 if not RolesReport::rh_rr_emit_count_metric(out, "roles.provider_declaration_count", role_summary.provider_sources)
            out.push(44)
            return -1 if not RolesReport::rh_rr_emit_count_metric(out, "roles.file_declaration_count", role_summary.file_sources)
            out.push(44)
            return -1 if not RolesReport::rh_rr_emit_count_metric(out, "roles.operator_declaration_count", role_summary.operator_sources)
            out.push(44)
            return -1 if not RolesReport::rh_rr_emit_count_metric(out, "maintainer.role_assignments_with_end_dates", role_summary.ended_declarations)
            out.push(44)
            if has_as_of:
                return -1 if not RolesReport::rh_rr_emit_metric_with_as_of(out, "maintainer.declared_current", Observation::RhMetricValue.Count(role_actor_tallies.declared_current), Observation::RH_ST_OBSERVED, "", true, current_as_of)
            else:
                return -1 if not RolesReport::rh_rr_emit_metric_with_as_of(out, "maintainer.declared_current", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "no-declaration-as-of-time", false, 0)
            out.push(44)
            if has_as_of and has_persistent_profile:
                return -1 if not RolesReport::rh_rr_emit_metric_with_as_of(out, "maintainer.active_declared_12m", Observation::RhMetricValue.Count(role_actor_tallies.active_declared_12m), Observation::RH_ST_OBSERVED, "", true, current_as_of)
            elif not has_as_of:
                return -1 if not RolesReport::rh_rr_emit_metric_with_as_of(out, "maintainer.active_declared_12m", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "no-declaration-as-of-time", false, 0)
            else:
                return -1 if not RolesReport::rh_rr_emit_metric_with_as_of(out, "maintainer.active_declared_12m", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "persistent-activity-profile-not-supplied", true, current_as_of)
            out.push(44)
            if has_actions:
                return -1 if not RolesReport::rh_rr_emit_count_metric(out, "maintainer.observed_release_actors", action_tallies.observed_release_actors)
            else:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.observed_release_actors", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "observed-actions-not-supplied")
            out.push(44)
            if has_actions:
                return -1 if not RolesReport::rh_rr_emit_count_metric(out, "maintainer.observed_merge_actors", action_tallies.observed_merge_actors)
            else:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.observed_merge_actors", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "observed-actions-not-supplied")
            out.push(44)
            if has_actions:
                return -1 if not RolesReport::rh_rr_emit_count_metric(out, "maintainer.observed_review_actors", action_tallies.observed_review_actors)
            else:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.observed_review_actors", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "observed-actions-not-supplied")
            out.push(44)
            if has_actions:
                return -1 if not RolesReport::rh_rr_emit_count_metric(out, "maintainer.unattributed_release_count", action_tallies.unattributed_release_count)
            else:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.unattributed_release_count", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "observed-actions-not-supplied")
            out.push(44)
            return -1 if not RolesReport::rh_rr_emit_change_review_metrics(out, change_source.status, has_actions, linked_reviewed_changes, linked_merged_changes)
            out.push(44)
            if not has_actions:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.review_share", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "observed-actions-not-supplied")
            elif not has_review_focus:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.review_share", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "review-actor-not-supplied")
            elif action_tallies.attributed_review_actions == 0:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.review_share", Observation::RhMetricValue.Absent, Observation::RH_ST_NOT_APPLICABLE, "no-attributed-review-actions")
            else:
                return -1 if not RolesReport::rh_rr_emit_ratio_metric(out, "maintainer.review_share", action_tallies.review_focus_actions, action_tallies.attributed_review_actions)
            out.push(44)
            if not has_actions:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.release_role_automation_share", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "observed-actions-not-supplied")
            elif action_tallies.attributed_release_actions == 0:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.release_role_automation_share", Observation::RhMetricValue.Absent, Observation::RH_ST_NOT_APPLICABLE, "no-attributed-release-actions")
            else:
                return -1 if not RolesReport::rh_rr_emit_ratio_metric(out, "maintainer.release_role_automation_share", action_tallies.automated_release_actions, action_tallies.attributed_release_actions)
            out.push(44)
            if not has_actions:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "concentration.release_actor_count_80", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "observed-actions-not-supplied")
            elif action_tallies.release_actor_count_80 == 0:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "concentration.release_actor_count_80", Observation::RhMetricValue.Absent, Observation::RH_ST_NOT_APPLICABLE, "no-release-actions")
            else:
                return -1 if not RolesReport::rh_rr_emit_count_metric(out, "concentration.release_actor_count_80", action_tallies.release_actor_count_80)
            out.push(44)
            if not has_actions:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "concentration.review_actor_count_80", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "observed-actions-not-supplied")
            elif action_tallies.review_actor_count_80 == 0:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "concentration.review_actor_count_80", Observation::RhMetricValue.Absent, Observation::RH_ST_NOT_APPLICABLE, "no-review-actions")
            else:
                return -1 if not RolesReport::rh_rr_emit_count_metric(out, "concentration.review_actor_count_80", action_tallies.review_actor_count_80)
            out.push(44)
            if auth_state == 2:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.permission_observed_current", Observation::RhMetricValue.Absent, Observation::RH_ST_UNAUTHORIZED, "provider-permission-enumeration-unauthorized")
            elif auth_state != 1:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.permission_observed_current", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "authorized-provider-permission-enumeration-not-available")
            elif not has_as_of:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.permission_observed_current", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "no-declaration-as-of-time")
            else:
                return -1 if not RolesReport::rh_rr_emit_count_metric(out, "maintainer.permission_observed_current", role_actor_tallies.permission_current)
            out.push(44)
            if auth_state == 2:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.permission_inventory_coverage", Observation::RhMetricValue.Absent, Observation::RH_ST_UNAUTHORIZED, "provider-permission-enumeration-unauthorized")
            elif auth_state != 1:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.permission_inventory_coverage", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "authorized-provider-permission-enumeration-not-available")
            elif not has_as_of:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.permission_inventory_coverage", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "no-declaration-as-of-time")
            elif not has_permission_complete or not permission_complete:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.permission_inventory_coverage", Observation::RhMetricValue.Absent, Observation::RH_ST_UNSUPPORTED, "permission-inventory-completeness-not-supplied")
            elif role_actor_tallies.permission_inventory_denominator == 0:
                return -1 if not RolesReport::rh_rr_emit_typed_metric(out, "maintainer.permission_inventory_coverage", Observation::RhMetricValue.Absent, Observation::RH_ST_NOT_APPLICABLE, "no-active-provider-permission-actors")
            else:
                return -1 if not RolesReport::rh_rr_emit_ratio_metric(out, "maintainer.permission_inventory_coverage", role_actor_tallies.permission_inventory_denominator, role_actor_tallies.permission_inventory_denominator)
            Base::rh_push_text(out, "],\"queries\":[")
            first: mutable bool = true
            if q_idx >= 0:
                return -1 if nodes[q_idx.usize()].kind != Json::RH_JSON_ARR
                qarr: Json::RhJsonNode = nodes[q_idx.usize()]
                while qc >= 0 |qc: i64 = qarr.first_child, nodes, texts, raw, decls, out, first|:
                    return -1 if nodes[qc.usize()].kind != Json::RH_JSON_OBJ
                    actor: i64 = rh_rr_int(nodes, raw, texts, qc, "actor_id", -1)
                    return -1 if actor < 0
                    as_of: i64 = rh_rr_int(nodes, raw, texts, qc, "as_of", 0)
                    role: u8 = Roles::rh_role_declared(decls, actor, as_of)
                    if not first:
                        out.push(44)
                    first <- false
                    Base::rh_push_text(out, "{\"actor_id\":")
                    Base::rh_push_decimal_i64(out, actor)
                    Base::rh_push_text(out, ",\"as_of\":")
                    Base::rh_push_decimal_i64(out, as_of)
                    Base::rh_push_text(out, ",\"declared_role\":\"")
                    Base::rh_push_text(out, Roles::rh_role_label(role))
                    Base::rh_push_text(out, "\"}")
                    qc <- nodes[qc.usize()].next_sibling
            Base::rh_push_text(out, "],\"permission_queries\":[")
            pfirst: mutable bool = true
            p_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "permission_queries")
            if p_idx >= 0:
                return -1 if nodes[p_idx.usize()].kind != Json::RH_JSON_ARR
                parr: Json::RhJsonNode = nodes[p_idx.usize()]
                while pc >= 0 |pc: i64 = parr.first_child, nodes, texts, raw, decls, out, pfirst|:
                    return -1 if nodes[pc.usize()].kind != Json::RH_JSON_OBJ
                    actor2: i64 = rh_rr_int(nodes, raw, texts, pc, "actor_id", -1)
                    return -1 if actor2 < 0
                    as_of2: i64 = rh_rr_int(nodes, raw, texts, pc, "as_of", 0)
                    bit: i64 = rh_rr_int(nodes, raw, texts, pc, "perm_bit", -1)
                    return -1 if bit < 0 or bit > 255
                    granted: i64 = Roles::rh_role_permission_declared(decls, actor2, bit.u8(), as_of2)
                    if not pfirst:
                        out.push(44)
                    pfirst <- false
                    Base::rh_push_text(out, "{\"actor_id\":")
                    Base::rh_push_decimal_i64(out, actor2)
                    Base::rh_push_text(out, ",\"perm_bit\":")
                    Base::rh_push_decimal_i64(out, bit)
                    Base::rh_push_text(out, ",\"as_of\":")
                    Base::rh_push_decimal_i64(out, as_of2)
                    Base::rh_push_text(out, ",\"declared\":")
                    if granted == 1:
                        Base::rh_push_text(out, "true")
                    else:
                        Base::rh_push_text(out, "false")
                    Base::rh_push_text(out, "}")
                    pc <- nodes[pc.usize()].next_sibling
            Base::rh_push_text(out, "],")
            RolesReport::rh_rr_emit_change_source(out, texts, change_source)
            Base::rh_push_text(out, ",") if change_source.status != RH_RR_CHANGE_SOURCE_UNKNOWN
            Base::rh_push_text(out, "\"change_review\":")
            if change_source.status == RH_RR_CHANGE_SOURCE_PARTIAL:
                Base::rh_push_text(out, "{\"status\":\"partial\",\"numerator\":null,\"denominator\":null,\"basis\":\"unique-linked-merge-change-identifiers\",\"excluded_unlinked_merge_actions\":")
                Base::rh_push_decimal_i64(out, unlinked_merge_actions)
                Base::rh_push_text(out, ",\"observed_lower_bound\":{\"numerator\":")
                Base::rh_push_decimal_i64(out, linked_reviewed_changes)
                Base::rh_push_text(out, ",\"denominator\":")
                Base::rh_push_decimal_i64(out, linked_merged_changes)
                Base::rh_push_text(out, "},\"reason\":\"change-population-source-incomplete\"}")
            elif change_source.status == RH_RR_CHANGE_SOURCE_COMPLETE and has_actions and linked_merged_changes > 0:
                Base::rh_push_text(out, "{\"status\":\"observed\",\"numerator\":")
                Base::rh_push_decimal_i64(out, linked_reviewed_changes)
                Base::rh_push_text(out, ",\"denominator\":")
                Base::rh_push_decimal_i64(out, linked_merged_changes)
                Base::rh_push_text(out, ",\"basis\":\"unique-linked-merge-change-identifiers\",\"excluded_unlinked_merge_actions\":")
                Base::rh_push_decimal_i64(out, unlinked_merge_actions)
                Base::rh_push_text(out, "}")
            elif change_source.status == RH_RR_CHANGE_SOURCE_COMPLETE and has_actions and unlinked_merge_actions == 0:
                Base::rh_push_text(out, "{\"status\":\"not_applicable\",\"numerator\":null,\"denominator\":0,\"basis\":\"unique-linked-merge-change-identifiers\",\"excluded_unlinked_merge_actions\":0}")
            elif not has_actions:
                Base::rh_push_text(out, "{\"status\":\"unknown\",\"numerator\":null,\"denominator\":null,\"basis\":\"unique-linked-merge-change-identifiers\",\"excluded_unlinked_merge_actions\":null,\"reason\":\"observed-actions-not-supplied\"}")
            elif unlinked_merge_actions > 0:
                Base::rh_push_text(out, "{\"status\":\"unknown\",\"numerator\":null,\"denominator\":null,\"basis\":\"unique-linked-merge-change-identifiers\",\"excluded_unlinked_merge_actions\":")
                Base::rh_push_decimal_i64(out, unlinked_merge_actions)
                Base::rh_push_text(out, ",\"reason\":\"merge-change-identifiers-not-supplied\"}")
            else:
                Base::rh_push_text(out, "{\"status\":\"unknown\",\"numerator\":null,\"denominator\":null,\"basis\":\"unique-linked-merge-change-identifiers\",\"excluded_unlinked_merge_actions\":0,\"reason\":\"change-population-completeness-not-supplied\"}")
            Base::rh_push_text(out, ",\"note\":\"declared roles are time-scoped evidence, separate from observed actions; an unrecognized role string is unknown, never guessed; a revoked or not-yet-effective declaration is not active at that time\"}")
            0
