# test_worker.elisa — unattended scheduling pass: full-reconcile priority,
# incremental fallback, bounded queue, host quota, and reconcile debt that
# stays visible even when a source is skipped.
include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_job.elisa"
include "./rh_reconcile.elisa"
include "./rh_worker.elisa"

def wcheck(cond: bool, label: u8&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    return if cond
    fails[0] <- fails[0] + 1
    b: mutable darray[u8] =
        b: mutable darray[u8] = []
        Base::rh_push_text(b, "WORKER-FAIL ")
        Base::rh_push_text(b, label)
        b.push(10)
        b
    Base::rh_write_stdout(b)

def check_pass(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    # Two sources: A due for full reconcile, B on-schedule incremental.
    srcs: mutable darray[RhSourceJob] =
        srcs: mutable darray[RhSourceJob] = []
        srcs.push(rh_worker_source(1, 1000, 1000, 1900, 100))
        srcs.push(rh_worker_source(2, 1000, 2000, 2900, 100))
        srcs
    h: mutable Job::RhHost = Job::rh_sched_host(10, 1, 1, 100)
    slots: mutable darray[Job::RhSlot] = Job::rh_sched_slots(4)
    dec: mutable darray[RhWorkerDecision] = []
    enq: i64 = rh_worker_pass(srcs, &h, slots, 2500, dec)
    wcheck(enq == 2, "pass-enqueued-two", fails)
    wcheck(dec[0].source_id == 1 and dec[0].mode == 1, "pass-src1-full", fails)
    wcheck(dec[0].horizon_secs == 1500, "pass-src1-horizon", fails)
    wcheck(dec[0].debt == 1, "pass-src1-debt", fails)
    wcheck(dec[1].source_id == 2 and dec[1].mode == 2, "pass-src2-incremental", fails)
    wcheck(dec[1].debt == 0, "pass-src2-no-debt", fails)
    wcheck(dec[1].overlap_start == 2800, "pass-src2-overlap", fails)
    return

def check_bounded(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    # Queue capacity 1, three sources: only one enqueued, the rest skipped
    # but their debt is still reported.
    srcs: mutable darray[RhSourceJob] =
        srcs: mutable darray[RhSourceJob] = []
        srcs.push(rh_worker_source(1, 1000, 0, 0, 0))
        srcs.push(rh_worker_source(2, 1000, 0, 0, 0))
        srcs.push(rh_worker_source(3, 1000, 0, 0, 0))
        srcs
    h: mutable Job::RhHost = Job::rh_sched_host(100, 1, 1, 100)
    slots: mutable darray[Job::RhSlot] = Job::rh_sched_slots(1)
    dec: mutable darray[RhWorkerDecision] = []
    enq: i64 = rh_worker_pass(srcs, &h, slots, 5000, dec)
    wcheck(enq == 1, "bounded-enq-one", fails)
    wcheck(dec[0].mode == 1, "bounded-first-full", fails)
    wcheck(dec[1].mode == 0 and dec[2].mode == 0, "bounded-rest-skipped", fails)
    wcheck(dec[1].debt == 5 and dec[2].debt == 5, "bounded-skipped-debt-visible", fails)
    hl: RhWorkerHealth = rh_worker_health(dec, enq)
    wcheck(hl.skipped == 2 and hl.overdue == 3 and hl.enqueued == 1, "bounded-health", fails)
    wcheck(hl.max_debt == 5, "bounded-max-debt", fails)
    return

def check_quota(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    # A stopped/backed-off host refuses every enqueue; all sources skipped.
    srcs: mutable darray[RhSourceJob] = []
    srcs.push(rh_worker_source(1, 1000, 0, 0, 0))
    h: mutable Job::RhHost = Job::rh_sched_host(0, 0, 1, 100)
    slots: mutable darray[Job::RhSlot] = Job::rh_sched_slots(4)
    dec: mutable darray[RhWorkerDecision] = []
    enq: i64 = rh_worker_pass(srcs, &h, slots, 5000, dec)
    wcheck(enq == 0, "quota-none-enq", fails)
    wcheck(dec[0].mode == 0 and dec[0].debt == 5, "quota-skipped-visible", fails)
    return

def check_determinism(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    srcs: mutable darray[RhSourceJob] = []
    srcs.push(rh_worker_source(7, 500, 100, 400, 50))
    h1: mutable Job::RhHost = Job::rh_sched_host(10, 1, 1, 100)
    slots1: mutable darray[Job::RhSlot] = Job::rh_sched_slots(4)
    d1: mutable darray[RhWorkerDecision] = []
    _ = rh_worker_pass(srcs, &h1, slots1, 700, d1)
    h2: mutable Job::RhHost = Job::rh_sched_host(10, 1, 1, 100)
    slots2: mutable darray[Job::RhSlot] = Job::rh_sched_slots(4)
    d2: mutable darray[RhWorkerDecision] = []
    _ = rh_worker_pass(srcs, &h2, slots2, 700, d2)
    same: mutable bool = d1.count == d2.count
    if same:
        while k < d1.count |k: usize = 0, d1, d2, same|:
            if d1[k].source_id != d2[k].source_id or d1[k].mode != d2[k].mode or d1[k].slot != d2[k].slot or d1[k].horizon_secs != d2[k].horizon_secs:
                same <- false
            k <- k + 1
    wcheck(same, "worker-deterministic", fails)
    return

def main() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    fails: mutable i64 = 0
    check_pass(&fails)
    check_bounded(&fails)
    check_quota(&fails)
    check_determinism(&fails)
    if fails == 0:
        b: mutable darray[u8] =
            b: mutable darray[u8] = []
            Base::rh_push_text(b, "WORKER OK")
            b.push(10)
            b
        Base::rh_write_stdout(b)
        return 0
    1
