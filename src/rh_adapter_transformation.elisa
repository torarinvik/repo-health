# Shared digest-bound transformation envelope for bounded metadata adapters.
include "./rh_base.elisa"
include "./rh_sha256.elisa"

module AdapterTransformation:
    public:
        def rh_adapter_transformation_report(adapter: cstr, output_schema: cstr, configuration: darray[u8]&, input: darray[u8]&, output: darray[u8]&, fields_json: cstr, report: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            configuration_sha: mutable darray[u8] = []
            input_sha: mutable darray[u8] = []
            output_sha: mutable darray[u8] = []
            Sha256::rh_sha256(configuration, configuration_sha)
            Sha256::rh_sha256(input, input_sha)
            Sha256::rh_sha256(output, output_sha)
            Base::rh_push_text(report, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"")
            Base::rh_push_cstr(report, adapter)
            Base::rh_push_text(report, "\",\"output_schema\":\"")
            Base::rh_push_cstr(report, output_schema)
            Base::rh_push_text(report, "\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            report.extend(bytes_view(configuration_sha))
            Base::rh_push_text(report, "\",\"source_input_sha256\":\"")
            report.extend(bytes_view(input_sha))
            Base::rh_push_text(report, "\",\"normalized_output_sha256\":\"")
            report.extend(bytes_view(output_sha))
            Base::rh_push_text(report, "\",\"fields\":")
            Base::rh_push_cstr(report, fields_json)
            report.push(125)
