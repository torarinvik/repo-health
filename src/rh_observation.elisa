# rh_observation.elisa — typed observations (M00-04).
#
# Measurement status distinguishes the eleven states in plan §2.3.
# Zero is a value only inside a sufficiently defined population; the
# consistency rule below encodes the SQL CHECK from plan §18.2:
#   observed      -> value present
#   partial/stale -> value optional, but incompleteness recorded alongside
#   all others    -> NO value (unknown is not zero, S006)

module Observation:
    public:
    const RH_ST_OBSERVED: u8 = 0
    const RH_ST_NOT_OBSERVED: u8 = 1
    const RH_ST_UNAVAILABLE: u8 = 2
    const RH_ST_UNAUTHORIZED: u8 = 3
    const RH_ST_PARTIAL: u8 = 4
    const RH_ST_STALE: u8 = 5
    const RH_ST_NOT_APPLICABLE: u8 = 6
    const RH_ST_ERROR: u8 = 7
    const RH_ST_CONFLICTED: u8 = 8
    const RH_ST_SUPPRESSED: u8 = 9
    const RH_ST_UNSUPPORTED: u8 = 10
    const RH_ST_COUNT: u8 = 11

    struct RhRatio:
        num: i64
        den: i64

    # Inline tagged values keep the published metric's value shape explicit
    # without allocating a boxed payload or erasing its scalar type.
    enum RhMetricValue:
        Absent
        Count(value: i64)
        CountPair(first: i64, second: i64)
        Timestamp(unix_seconds: i64)
        Ratio(num: i64, den: i64)
        Boolean(value: bool)
        Enumeration(code: i64)

    enum RhCompleteness:
        Complete
        Partial
        Unknown

    enum RhFreshness:
        Fresh
        Stale
        Unknown

    enum RhValidity:
        Valid
        Invalid
        Unknown

    enum RhProvenanceQuality:
        EvidenceBacked
        Derived
        Unverified
        Unknown

    # Evidence identity is a closed domain value; report paths and source
    # locators stay in the adapter that owns their serialization.
    enum RhEvidenceObject:
        GitLog
        GitShallow
        GitFiles
        GitDefaultCount
        BundleManifest
        External

    struct RhEvidenceLink:
        object: RhEvidenceObject
        locator: sview

    # Current report observations need at most two source objects. Inline
    # capacity keeps current reports allocation-free; larger lineage lists
    # spill through the standard library's arena-backed vector.
    const RH_MAX_EVIDENCE_LINKS: usize = 1024

    struct RhEvidenceLinks:
        items: mutable InlineVec[RhEvidenceStoredLink, 2]
        locators: mutable darray[u8]

    struct RhEvidenceStoredLink:
        code: u8
        start: usize
        length: usize

    def rh_evidence_links_empty() -> RhEvidenceLinks:
        RhEvidenceLinks{items: inline_vec[RhEvidenceStoredLink, 2](&perm_arena), locators: []}

    def rh_evidence_object_code(object: RhEvidenceObject) -> u8:
        match object:
            RhEvidenceObject.GitLog:
                0
            RhEvidenceObject.GitShallow:
                1
            RhEvidenceObject.GitFiles:
                2
            RhEvidenceObject.GitDefaultCount:
                3
            RhEvidenceObject.BundleManifest:
                4
            RhEvidenceObject.External:
                5

    def rh_evidence_object_from_code(code: u8) -> RhEvidenceObject:
        return RhEvidenceObject.GitShallow if code == 1
        return RhEvidenceObject.GitFiles if code == 2
        return RhEvidenceObject.GitDefaultCount if code == 3
        return RhEvidenceObject.BundleManifest if code == 4
        return RhEvidenceObject.External if code == 5
        RhEvidenceObject.GitLog

    def rh_evidence_links_push(links: mutable RhEvidenceLinks&, object: RhEvidenceObject) -> void can[Memory.Allocate, Abort.Panic]:
        inline_vec_push[RhEvidenceStoredLink, 2](links.items, RhEvidenceStoredLink{code: rh_evidence_object_code(object), start: 0, length: 0})

    def rh_evidence_links_push_external(links: mutable RhEvidenceLinks&, locator: sview) -> void can[Memory.Allocate, Abort.Panic]:
        start: usize = links.locators.count
        for index in 0..<sview_len(locator).usize() |index, links|:
            links.locators.push(locator[index])
        inline_vec_push[RhEvidenceStoredLink, 2](links.items, RhEvidenceStoredLink{code: 5, start: start, length: sview_len(locator).usize()})

    def rh_evidence_links_count(links: RhEvidenceLinks) -> usize:
        inline_vec_count[RhEvidenceStoredLink, 2](links.items)

    def rh_evidence_links_get(links: RhEvidenceLinks, index: usize) -> RhEvidenceObject:
        rh_evidence_object_from_code(inline_vec_get[RhEvidenceStoredLink, 2](links.items, index).code)

    def rh_evidence_links_get_link(links: RhEvidenceLinks, index: usize) -> RhEvidenceLink:
        stored: RhEvidenceStoredLink = inline_vec_get[RhEvidenceStoredLink, 2](links.items, index)
        locator: sview = string_view_slice(bytes_view(links.locators), stored.start, stored.start + stored.length) if stored.code == 5 else string_view_slice(bytes_view(links.locators), 0, 0)
        RhEvidenceLink{object: rh_evidence_object_from_code(stored.code), locator: locator}

    def rh_evidence_links_valid(links: RhEvidenceLinks) -> bool:
        count: usize = rh_evidence_links_count(links)
        return false if count > RH_MAX_EVIDENCE_LINKS
        for index in 0..<count |index, links|:
            item: RhEvidenceStoredLink = inline_vec_get[RhEvidenceStoredLink, 2](links.items, index)
            code: u8 = item.code
            return false if code > 5
            return false if code == 5 and (item.length == 0 or item.start + item.length > links.locators.count)
            return false if code != 5 and item.length != 0
            for prior in 0..<index |prior, index, links|:
                previous: RhEvidenceStoredLink = inline_vec_get[RhEvidenceStoredLink, 2](links.items, prior)
                return false if code == previous.code and code != 5
                return false if code == 5 and item.length == previous.length and string_views_eq(string_view_slice(bytes_view(links.locators), item.start, item.start + item.length), string_view_slice(bytes_view(links.locators), previous.start, previous.start + previous.length)) == 1
        true

    def rh_evidence_object_label(object: RhEvidenceObject) -> u8&:
        match object:
            RhEvidenceObject.GitLog:
                "git_log"
            RhEvidenceObject.GitShallow:
                "git_shallow"
            RhEvidenceObject.GitFiles:
                "git_files"
            RhEvidenceObject.GitDefaultCount:
                "git_default_count"
            RhEvidenceObject.BundleManifest:
                "bundle_manifest"
            RhEvidenceObject.External:
                "external"

    struct RhQualityDimensions:
        completeness: RhCompleteness
        freshness: RhFreshness
        validity: RhValidity
        provenance: RhProvenanceQuality

    # Quality metadata travels with the status/value pair. Evidence references
    # remain owned by the serialization envelope because their paths are source
    # and report specific.
    struct RhObservation:
        status: u8
        value: RhMetricValue
        has_incompleteness: bool
        quality: RhQualityDimensions
        evidence: RhEvidenceLinks

    def rh_status_valid(status: u8) -> bool:
        status < RH_ST_COUNT

    def rh_status_label(status: u8) -> u8&:
        return "observed" if status == RH_ST_OBSERVED
        return "not_observed" if status == RH_ST_NOT_OBSERVED
        return "unavailable" if status == RH_ST_UNAVAILABLE
        return "unauthorized" if status == RH_ST_UNAUTHORIZED
        return "partial" if status == RH_ST_PARTIAL
        return "stale" if status == RH_ST_STALE
        return "not_applicable" if status == RH_ST_NOT_APPLICABLE
        return "error" if status == RH_ST_ERROR
        return "conflicted" if status == RH_ST_CONFLICTED
        return "suppressed" if status == RH_ST_SUPPRESSED
        return "unsupported" if status == RH_ST_UNSUPPORTED
        "unknown-status"

    # Exact ratio validity: positive denominator, numerator within [0, den].
    # A zero denominator never validates as observed (rejects unknown->zero).
    def rh_ratio_valid(num: i64, den: i64) -> bool:
        return false if den <= 0
        return false if num < 0
        num <= den

    # Ratios such as slopes and variances are not shares, but still need a
    # defined positive denominator before they can be serialized as observed.
    def rh_ratio_defined(ratio: RhRatio) -> bool:
        ratio.den > 0

    def rh_metric_value_present(value: RhMetricValue) -> bool:
        match value:
            RhMetricValue.Absent:
                false
            RhMetricValue.Count(count):
                true
            RhMetricValue.CountPair(first, second):
                true
            RhMetricValue.Timestamp(unix_seconds):
                true
            RhMetricValue.Ratio(num, den):
                true
            RhMetricValue.Boolean(flag):
                true
            RhMetricValue.Enumeration(code):
                true

    def rh_metric_value_valid(value: RhMetricValue) -> bool:
        match value:
            RhMetricValue.Absent:
                true
            RhMetricValue.Count(count):
                count >= 0
            RhMetricValue.CountPair(first, second):
                first >= 0 and first <= second
            RhMetricValue.Timestamp(unix_seconds):
                unix_seconds >= 0
            RhMetricValue.Ratio(num, den):
                den > 0
            RhMetricValue.Boolean(flag):
                flag or not flag
            RhMetricValue.Enumeration(code):
                code >= 0

    def rh_observation_make(status: u8, value: RhMetricValue, has_incompleteness: bool) -> RhObservation:
        completeness: RhCompleteness = RhCompleteness.Partial if status == RH_ST_PARTIAL else RhCompleteness.Unknown
        freshness: RhFreshness = RhFreshness.Stale if status == RH_ST_STALE else RhFreshness.Unknown
        quality: RhQualityDimensions = RhQualityDimensions{completeness: completeness, freshness: freshness, validity: RhValidity.Unknown, provenance: RhProvenanceQuality.Unknown}
        RhObservation{status: status, value: value, has_incompleteness: has_incompleteness, quality: quality, evidence: rh_evidence_links_empty()}

    def rh_observation_make_with_quality(status: u8, value: RhMetricValue, has_incompleteness: bool, quality: RhQualityDimensions) -> RhObservation:
        RhObservation{status: status, value: value, has_incompleteness: has_incompleteness, quality: quality, evidence: rh_evidence_links_empty()}

    def rh_observation_make_with_evidence(status: u8, value: RhMetricValue, has_incompleteness: bool, quality: RhQualityDimensions, evidence: RhEvidenceLinks) -> RhObservation:
        RhObservation{status: status, value: value, has_incompleteness: has_incompleteness, quality: quality, evidence: evidence}

    def rh_quality_dimensions_valid(status: u8, quality: RhQualityDimensions) -> bool:
        return false if quality.completeness != RhCompleteness.Complete and quality.completeness != RhCompleteness.Partial and quality.completeness != RhCompleteness.Unknown
        return false if quality.freshness != RhFreshness.Fresh and quality.freshness != RhFreshness.Stale and quality.freshness != RhFreshness.Unknown
        return false if quality.validity != RhValidity.Valid and quality.validity != RhValidity.Invalid and quality.validity != RhValidity.Unknown
        return false if quality.provenance != RhProvenanceQuality.EvidenceBacked and quality.provenance != RhProvenanceQuality.Derived and quality.provenance != RhProvenanceQuality.Unverified and quality.provenance != RhProvenanceQuality.Unknown
        return false if status == RH_ST_PARTIAL and quality.completeness != RhCompleteness.Partial
        return false if quality.completeness == RhCompleteness.Partial and status != RH_ST_PARTIAL and status != RH_ST_STALE
        return false if status == RH_ST_STALE and quality.freshness != RhFreshness.Stale
        return false if quality.freshness == RhFreshness.Stale and status != RH_ST_STALE
        return false if quality.validity == RhValidity.Invalid and status == RH_ST_OBSERVED
        true

    def rh_completeness_label(value: RhCompleteness) -> u8&:
        return "complete" if value == RhCompleteness.Complete
        return "partial" if value == RhCompleteness.Partial
        "unknown"

    def rh_freshness_label(value: RhFreshness) -> u8&:
        return "fresh" if value == RhFreshness.Fresh
        return "stale" if value == RhFreshness.Stale
        "unknown"

    def rh_validity_label(value: RhValidity) -> u8&:
        return "valid" if value == RhValidity.Valid
        return "invalid" if value == RhValidity.Invalid
        "unknown"

    def rh_provenance_quality_label(value: RhProvenanceQuality) -> u8&:
        return "evidence_backed" if value == RhProvenanceQuality.EvidenceBacked
        return "derived" if value == RhProvenanceQuality.Derived
        return "unverified" if value == RhProvenanceQuality.Unverified
        "unknown"

    # Full in-memory contract used before a value is handed to a serializer.
    def rh_observation_valid(observation: RhObservation) -> bool:
        has_value: bool = rh_metric_value_present(observation.value)
        return false if not rh_metric_value_valid(observation.value)
        return false if not rh_observation_consistent(observation.status, has_value)
        return false if (observation.status == RH_ST_PARTIAL or observation.status == RH_ST_STALE) and not observation.has_incompleteness
        return false if observation.status != RH_ST_PARTIAL and observation.status != RH_ST_STALE and observation.has_incompleteness
        return false if not rh_evidence_links_valid(observation.evidence)
        return false if observation.quality.provenance == RhProvenanceQuality.EvidenceBacked and rh_evidence_links_count(observation.evidence) == 0
        return false if not rh_quality_dimensions_valid(observation.status, observation.quality)
        true

    # Status/value consistency (§18.2 CHECK logic). has_value = whether a value
    # is attached. partial/stale accept either, but the report layer must still
    # attach explicit incompleteness metadata (enforced in rh_report).
    def rh_observation_consistent(status: u8, has_value: bool) -> bool:
        return false if not rh_status_valid(status)
        return has_value if status == RH_ST_OBSERVED
        return true if status == RH_ST_PARTIAL
        return true if status == RH_ST_STALE
        not has_value

    def rh_ratio_make(num: i64, den: i64) -> RhRatio:
        RhRatio{num: num, den: den}
