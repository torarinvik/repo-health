# test_store.elisa — M02-01/02/03/06 service-side tests.
#
# Usage: test_store <workdir> selftest
#        test_store <workdir> hold <job> <ttl>
#        test_store <workdir> acquire <job> <owner> <ttl> <now>
#        test_store <workdir> release <job> <token> <phase> <owner> <now>
# selftest runs the deterministic suite (fixed clocks, no sleeping).
# hold/acquire/release drive the shell crash-injection sequence: hold
# acquires then sleeps (kill -9 simulates the crash; the lease goes stale
# because heartbeats stop, not because of any cleanup).

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_git.elisa"
include "./rh_store.elisa"

def sfail(text: u8&) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    buffer: mutable darray[u8] =
        buffer: mutable darray[u8] = []
        rh_push_text(buffer, "STORE-FAIL ")
        rh_push_text(buffer, text)
        buffer.push(10)
        buffer
    rh_write_stdout(buffer)
    1

def spath(base: cstr, name: u8&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if rh_cstr_len_c(base) == 0
    rh_push_cstr(out, base)
    out.push(47)
    rh_push_text(out, name)
    out.push(0)
    true

def sparg_int(s: cstr, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    scratch: mutable darray[u8] = []
    rh_push_cstr(scratch, s)
    rh_parse_i64(scratch, 0, scratch.count, ok_out)

def scstr(d: mutable darray[u8]&) -> cstr can[Unsafe.PointerCast]:
    resolved: cstr = (&d[0]).cast[cstr] can Unsafe.PointerCast
    resolved

def sselftest(workdir: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    root: mutable darray[u8] = []
    return sfail("root-path") if not spath(workdir, "store", root)
    ev: mutable darray[u8] = []
    return sfail("ev-path") if not spath(scstr(root), "evidence", ev)
    return sfail("mkdir-root") if Git::rh_ensure_dir(scstr(root)) != 0
    return sfail("mkdir-evidence") if Git::rh_ensure_dir(scstr(ev)) != 0
    sdir: mutable darray[u8] = []
    return sfail("sdir-path") if not spath(scstr(root), "sources", sdir)
    return sfail("mkdir-sources") if Git::rh_ensure_dir(scstr(sdir)) != 0
    s1: mutable darray[u8] = []
    return sfail("s1-path") if not spath(scstr(sdir), "s1", s1)
    return sfail("mkdir-s1") if Git::rh_ensure_dir(scstr(s1)) != 0
    evd: mutable darray[u8] = []
    return sfail("evd-path") if not spath(scstr(s1), "events", evd)
    return sfail("mkdir-events") if Git::rh_ensure_dir(scstr(evd)) != 0
    curd: mutable darray[u8] = []
    return sfail("curd-path") if not spath(scstr(s1), "cursors", curd)
    return sfail("mkdir-cursors") if Git::rh_ensure_dir(scstr(curd)) != 0
    covd: mutable darray[u8] = []
    return sfail("covd-path") if not spath(scstr(s1), "coverage", covd)
    return sfail("mkdir-coverage") if Git::rh_ensure_dir(scstr(covd)) != 0
    ldir: mutable darray[u8] = []
    return sfail("ldir-path") if not spath(scstr(root), "leases", ldir)
    if Git::rh_ensure_dir(scstr(ldir)) != 0:
        return sfail("mkdir-leases")

    # --- blobs: store, verify, tamper blocks, idempotent rewrite ---
    blob: mutable darray[u8] = []
    rh_push_text(blob, "hello-blob")
    hex: mutable darray[u8] = []
    return sfail("blob-store") if Store::rh_store_blob(scstr(ev), blob, hex) != 0
    return sfail("blob-hexlen") if hex.count != 16
    hexname: mutable darray[u8] =
        hexname: mutable darray[u8] = []
        hexname.extend(bytes_view(hex))
        hexname.push(0)
        hexname
    hexp: u8& = (&hexname[0]).cast[u8&] can Unsafe.PointerCast
    vok: mutable i64 = 0
    return sfail("blob-verify-rc") if Store::rh_store_blob_verify(scstr(ev), hexp, &vok) != 0
    return sfail("blob-verify-ok") if vok != 1
    evil: mutable darray[u8] = []
    rh_push_text(evil, "tampered-blob-bytes!!")
    tampath: mutable darray[u8] = []
    shexpath(ev, hex, tampath)
    return sfail("tamper-write") if not rh_io_write(scstr(tampath), evil)
    vok2: mutable i64 = 0
    return sfail("tamper-undetected") if Store::rh_store_blob_verify(scstr(ev), hexp, &vok2) == 0
    hex2: mutable darray[u8] = []
    return sfail("rewrite-after-tamper-allowed") if Store::rh_store_blob(scstr(ev), blob, hex2) == 0
    return sfail("rewrite-digest-length") if hex2.count != hex.count
    same_hex: bool =
        while hx < hex.count |same_hex: bool = true, hx: usize = 0, hex, hex2| -> same_hex:
            if hex[hx] != hex2[hx]:
                same_hex <- false
            hx <- hx + 1
    return sfail("rewrite-digest-value") if not same_hex
    return sfail("operator-remove") if unlink((&tampath[0]).cast[u8&] can Unsafe.PointerCast) != 0
    missing: mutable darray[u8] =
        missing: mutable darray[u8] = []
        rh_push_text(missing, "0123456789abcdef")
        missing.push(0)
        missing
    missp: u8& = (&missing[0]).cast[u8&] can Unsafe.PointerCast
    vok3: mutable i64 = 0
    return sfail("missing-blob") if Store::rh_store_blob_verify(scstr(ev), missp, &vok3) != -1
    hex3: mutable darray[u8] = []
    return sfail("blob-restore") if Store::rh_store_blob(scstr(ev), blob, hex3) != 0
    vok4: mutable i64 = 0
    if Store::rh_store_blob_verify(scstr(ev), hexp, &vok4) != 0 or vok4 != 1:
        return sfail("blob-restored-verify")

    # --- events: append, duplicate-skip, reorder convergence ---
    evf: mutable darray[u8] = []
    return sfail("evf-path") if not spath(scstr(evd), "issues.jsonl", evf)
    evfp: cstr = scstr(evf)
    idx: mutable darray[u8] = []
    return sfail("idx-path") if not spath(scstr(evd), "issues.index", idx)
    idxp: cstr = scstr(idx)
    la: mutable darray[u8] = []
    rh_push_text(la, "{\"id\":\"a:1\",\"v\":1}")
    lb: mutable darray[u8] = []
    rh_push_text(lb, "{\"id\":\"b:2\",\"v\":2}")
    lines_ok: i64 = |la, lb|
        lc: mutable darray[u8] = []
        rh_push_text(lc, "{\"id\":\"c:3\",\"v\":3}")
        return sfail("event-a") if Store::rh_store_event(evfp, idxp, "a:1", la) != 1
        return sfail("event-b") if Store::rh_store_event(evfp, idxp, "b:2", lb) != 1
        return sfail("event-dupe") if Store::rh_store_event(evfp, idxp, "a:1", la) != 0
        return sfail("event-dupe2") if Store::rh_store_event(evfp, idxp, "b:2", lb) != 0
        return sfail("event-c") if Store::rh_store_event(evfp, idxp, "c:3", lc) != 1
        return sfail("event-lines") if Store::rh_count_file_lines(evfp) != 3
        raw: mutable darray[u8] = []
        return sfail("event-reread") if rh_io_read(evfp, raw) < 0
        block_result: i64 = sjson_lines_ok(raw)
        block_result
    if lines_ok != 3:
        return sfail("event-json")

    # --- S005: 3x webhook + reordered updates -> exactly one copy ---
    # The same logical delivery arrives three times, interleaved with an
    # out-of-order delivery of an earlier event. Every id must appear
    # exactly once: no duplicate rows, no inflated counts.
    whf: mutable darray[u8] = []
    return sfail("wh-path") if not spath(scstr(evd), "webhooks.jsonl", whf)
    whfp: cstr = scstr(whf)
    whi: mutable darray[u8] = []
    return sfail("wh-idx-path") if not spath(scstr(evd), "webhooks.index", whi)
    whip: cstr = scstr(whi)
    w1: mutable darray[u8] = []
    rh_push_text(w1, "{\"id\":\"x:1\",\"state\":\"open\"}")
    w2: mutable darray[u8] = []
    rh_push_text(w2, "{\"id\":\"y:2\",\"state\":\"closed\"}")
    # out-of-order: y before x; then x again; then x a third time; then y again
    return sfail("wh-y-first") if Store::rh_store_event(whfp, whip, "y:2", w2) != 1
    return sfail("wh-x") if Store::rh_store_event(whfp, whip, "x:1", w1) != 1
    return sfail("wh-x-dupe-2") if Store::rh_store_event(whfp, whip, "x:1", w1) != 0
    return sfail("wh-x-dupe-3") if Store::rh_store_event(whfp, whip, "x:1", w1) != 0
    return sfail("wh-y-dupe") if Store::rh_store_event(whfp, whip, "y:2", w2) != 0
    return sfail("wh-exactly-one-each") if Store::rh_count_file_lines(whfp) != 2
    return sfail("wh-x-indexed-once") if Store::rh_index_has(whip, "x:1") != 1
    if Store::rh_index_has(whip, "y:2") != 1:
        return sfail("wh-y-indexed-once")

    # --- F007: force-push redelivery must not drop stored history ---
    # A rewritten ref re-delivers revisions a and b (already stored) and no
    # longer references c. Redelivery dedups to one copy each; c's immutable
    # event is retained (append-only), never deleted by a later scan.
    return sfail("force-push-dedup-a") if Store::rh_store_event(evfp, idxp, "a:1", la) != 0
    return sfail("force-push-dedup-b") if Store::rh_store_event(evfp, idxp, "b:2", lb) != 0
    return sfail("force-push-history-retained") if Store::rh_count_file_lines(evfp) != 3
    if Store::rh_index_has(idxp, "c:3") != 1:
        return sfail("force-push-unreachable-kept")

    # --- F033: orphan cleanup removes unreferenced blobs, keeps referenced ---
    orph: mutable darray[u8] = []
    rh_push_text(orph, "orphan-bytes")
    horph: mutable darray[u8] = []
    return sfail("gc-orphan-store") if Store::rh_store_blob(scstr(ev), orph, horph) != 0
    keep: mutable darray[u8] = []
    rh_push_text(keep, "referenced-bytes")
    hkeep: mutable darray[u8] = []
    return sfail("gc-keep-store") if Store::rh_store_blob(scstr(ev), keep, hkeep) != 0
    cands: mutable darray[u8] = []
    kx: mutable usize =
        while kx < horph.count |kx: usize = 0, horph, cands| -> kx:
            cands.push(horph[kx])
            kx <- kx + 1
    cands.push(10)
    kx <- 0
    while kx < hkeep.count |kx, hkeep, cands|:
        cands.push(hkeep[kx])
        kx <- kx + 1
    cands.push(10)
    refs: mutable darray[u8] = []
    kx <- 0
    while kx < hkeep.count |kx, hkeep, refs|:
        refs.push(hkeep[kx])
        kx <- kx + 1
    refs.push(10)
    deleted: mutable i64 = 0
    return sfail("gc-return") if Store::rh_store_gc(scstr(ev), cands, refs, &deleted) != 0
    return sfail("gc-orphan-removed") if deleted != 1
    ov: mutable i64 = 0
    orphn: mutable darray[u8] = []
    kx <- 0
    while kx < horph.count |kx, horph, orphn|:
        orphn.push(horph[kx])
        kx <- kx + 1
    orphn.push(0)
    orphnp: u8& = (&orphn[0]).cast[u8&] can Unsafe.PointerCast
    return sfail("gc-orphan-gone") if Store::rh_store_blob_verify(scstr(ev), orphnp, &ov) != -1
    kv: mutable i64 = 0
    keepn: mutable darray[u8] = []
    kx <- 0
    while kx < hkeep.count |kx, hkeep, keepn|:
        keepn.push(hkeep[kx])
        kx <- kx + 1
    keepn.push(0)
    keepnp: u8& = (&keepn[0]).cast[u8&] can Unsafe.PointerCast
    if Store::rh_store_blob_verify(scstr(ev), keepnp, &kv) != 0 or kv != 1:
        return sfail("gc-referenced-kept")

    # --- cursor: missing, commit, crash-before-commit replay, advance ---
    cur: mutable darray[u8] = []
    return sfail("cur-path") if not spath(scstr(curd), "issues.cursor", cur)
    curp: cstr = scstr(cur)
    pg: mutable i64 = 0
    ct: mutable i64 = 0
    return sfail("cursor-missing-false-positive") if Store::rh_cursor_read(curp, &pg, &ct)
    return sfail("cursor-commit") if not Store::rh_cursor_commit(curp, 3, 150)
    return sfail("cursor-reread") if not Store::rh_cursor_read(curp, &pg, &ct)
    return sfail("cursor-values") if pg != 3 or ct != 150
    return sfail("retry-not-absorbed") if Store::rh_store_event(evfp, idxp, "a:1", la) != 0
    return sfail("retry-inflated") if Store::rh_count_file_lines(evfp) != 3
    return sfail("cursor-recommit") if not Store::rh_cursor_commit(curp, 3, 150)
    ld: mutable darray[u8] = []
    rh_push_text(ld, "{\"id\":\"d:4\",\"v\":4}")
    return sfail("event-d") if Store::rh_store_event(evfp, idxp, "d:4", ld) != 1
    return sfail("cursor-advance") if not Store::rh_cursor_commit(curp, 4, 151)
    if Store::rh_count_file_lines(evfp) != 4:
        return sfail("event-lines-4")

    # --- leases: fencing, expiry, terminal (fixed clock) ---
    job: mutable darray[u8] = []
    return sfail("job-path") if not spath(scstr(ldir), "job1.lease", job)
    jobp: cstr = scstr(job)
    jlog: mutable darray[u8] = []
    return sfail("jlog-path") if not spath(scstr(ldir), "job1.log", jlog)
    jlogp: cstr = scstr(jlog)
    return sfail("lease-acquire") if Store::rh_lease_acquire(jobp, jlogp, "w1", 1000000, 100) != 1
    return sfail("lease-held") if Store::rh_lease_acquire(jobp, jlogp, "w2", 1000050, 100) != -1
    return sfail("heartbeat-stale") if Store::rh_lease_heartbeat(jobp, 2, "w2", 1000050)
    return sfail("heartbeat-ok") if not Store::rh_lease_heartbeat(jobp, 1, "w1", 1000050)
    return sfail("release-stale") if Store::rh_lease_release(jobp, jlogp, 2, "w2", 1000050, 3)
    return sfail("release-ok") if not Store::rh_lease_release(jobp, jlogp, 1, "w1", 1000060, 3)
    return sfail("terminal-closed") if Store::rh_lease_acquire(jobp, jlogp, "w3", 1000070, 100) != -2
    return sfail("terminal-closed2") if Store::rh_lease_acquire(jobp, jlogp, "w1", 1000000, 100) != -2
    job2: mutable darray[u8] = []
    return sfail("job2-path") if not spath(scstr(ldir), "job2.lease", job2)
    job2p: cstr = scstr(job2)
    jlog2: mutable darray[u8] = []
    return sfail("jlog2-path") if not spath(scstr(ldir), "job2.log", jlog2)
    return sfail("lease2-acquire") if Store::rh_lease_acquire(job2p, scstr(jlog2), "w1", 100, 10) != 1
    return sfail("lease2-expiry-fencing") if Store::rh_lease_acquire(job2p, scstr(jlog2), "w2", 200, 10) != 2
    return sfail("lease2-stale-release") if Store::rh_lease_release(job2p, scstr(jlog2), 1, "w1", 200, 3)
    return sfail("lease2-stale-heartbeat") if Store::rh_lease_heartbeat(job2p, 1, "w1", 200)
    if not Store::rh_lease_release(job2p, scstr(jlog2), 2, "w2", 200, 3):
        return sfail("lease2-release")

    # --- coverage intervals ---
    cov: mutable darray[u8] = []
    return sfail("cov-path") if not spath(scstr(covd), "issues.interval", cov)
    covp: cstr = scstr(cov)
    return sfail("cov-mark1") if not Store::rh_coverage_mark(covp, 100, 200, 4)
    return sfail("cov-mark2") if not Store::rh_coverage_mark(covp, 200, 300, 0)
    if Store::rh_count_file_lines(covp) != 2:
        return sfail("cov-lines")

    okbuf: mutable darray[u8] =
        okbuf: mutable darray[u8] = []
        rh_push_text(okbuf, "STORE OK")
        okbuf.push(10)
        okbuf
    rh_write_stdout(okbuf)
    0

# Every non-empty line must parse as JSON. Returns the valid count.
def sjson_lines_ok(raw: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    while start < raw.count |total: i64 = 0, start: usize = 0, raw| -> total:
        stop: i64 = rh_find_byte(raw, start, 10)
        line_end: usize = stop.usize() if stop >= 0 else raw.count
        if line_end > start:
            chunk: mutable darray[u8] = []
            while q < line_end |q: usize = start, raw, chunk|:
                chunk.push(raw[q])
                q <- q + 1
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            return -1 if Json::rh_json_parse(chunk, nodes, texts) < 0
            total <- total + 1
        if stop < 0:
            start <- raw.count
        else:
            start <- stop.usize() + 1

# Resolve a darray path buffer to cstr (must be NUL-terminated already).
def shexpath(ev: mutable darray[u8]&, hex: mutable darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    rh_push_cstr(out, (&ev[0]).cast[cstr] can Unsafe.PointerCast)
    out.push(47)
    out.extend(bytes_view(hex))
    out.push(0)

def sjob_path(workdir: cstr, job: cstr, suffix: u8&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if rh_cstr_len_c(workdir) == 0 or rh_cstr_len_c(job) == 0
    rh_push_cstr(out, workdir)
    rh_push_text(out, "/store/leases/")
    rh_push_cstr(out, job)
    rh_push_text(out, suffix)
    out.push(0)
    true

def sprint_result(tag: u8&, value: i64) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    buffer: mutable darray[u8] =
        buffer: mutable darray[u8] = []
        rh_push_text(buffer, tag)
        buffer.push(32)
        rh_push_decimal_i64(buffer, value)
        buffer.push(10)
        buffer
    rh_write_stdout(buffer)

def shold(workdir: cstr, job: cstr, ttls: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    tok: i64 =
        ok: mutable i64 = 0
        ttl: i64 = sparg_int(ttls, &ok)
        return sfail("bad ttl") if ok == 0 or ttl <= 0
        lp: mutable darray[u8] = []
        lg: mutable darray[u8] = []
        return sfail("hold-lease-path") if not sjob_path(workdir, job, ".lease", lp)
        return sfail("hold-log-path") if not sjob_path(workdir, job, ".log", lg)
        now: i64 = rh_now()
        return sfail("no clock") if now < 0
        block_result: i64 = Store::rh_lease_acquire(scstr(lp), scstr(lg), "holder", now, ttl)
        block_result
    return sfail("hold-acquire") if tok <= 0
    sprint_result("TOKEN", tok)
    _ = system("sleep 30")
    0

def sacquire(workdir: cstr, job: cstr, owner_s: cstr, ttls: cstr, nows: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    tok: i64 =
        ok1: mutable i64 = 0
        ttl: i64 = sparg_int(ttls, &ok1)
        ok2: mutable i64 = 0
        now: i64 = sparg_int(nows, &ok2)
        return sfail("bad acquire args") if ok1 == 0 or ok2 == 0 or ttl <= 0 or now < 0
        lp: mutable darray[u8] = []
        lg: mutable darray[u8] = []
        return sfail("acq-lease-path") if not sjob_path(workdir, job, ".lease", lp)
        return sfail("acq-log-path") if not sjob_path(workdir, job, ".log", lg)
        owner: u8& = owner_s.cast[u8&] can Unsafe.PointerCast
        block_result: i64 = Store::rh_lease_acquire(scstr(lp), scstr(lg), owner, now, ttl)
        block_result
    sprint_result("RESULT", tok)
    0

def srelease(workdir: cstr, job: cstr, toks: cstr, phases: cstr, owner_s: cstr, nows: cstr) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    done: bool =
        ok1: mutable i64 = 0
        tok: i64 = sparg_int(toks, &ok1)
        ok2: mutable i64 = 0
        phase: i64 = sparg_int(phases, &ok2)
        ok3: mutable i64 = 0
        now: i64 = sparg_int(nows, &ok3)
        return sfail("bad release args") if ok1 == 0 or ok2 == 0 or ok3 == 0 or now < 0
        lp: mutable darray[u8] = []
        lg: mutable darray[u8] = []
        return sfail("rel-lease-path") if not sjob_path(workdir, job, ".lease", lp)
        return sfail("rel-log-path") if not sjob_path(workdir, job, ".log", lg)
        owner: u8& = owner_s.cast[u8&] can Unsafe.PointerCast
        block_result: bool = Store::rh_lease_release(scstr(lp), scstr(lg), tok, owner, now, phase)
        block_result
    if done:
        sprint_result("RESULT", 1)
    else:
        sprint_result("RESULT", 0)
    0

def main(argc: i64, argv: mutable void&) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    return sfail("usage: test_store <workdir> selftest|hold|acquire|release ...") if argc < 3
    slots: mutable cstr&& = argv.cast[mutable cstr&&]
    workdir: cstr = slots[1]
    mode: u8& = slots[2].cast[u8&] can Unsafe.PointerCast
    return sselftest(workdir) if rh_streq(mode, "selftest")
    if rh_streq(mode, "hold"):
        return sfail("usage: test_store <workdir> hold <job> <ttl>") if argc < 5
        tok: i64 = shold(workdir, slots[3], slots[4])
        return tok
    if rh_streq(mode, "acquire"):
        return sfail("usage: test_store <workdir> acquire <job> <owner> <ttl> <now>") if argc < 7
        return sacquire(workdir, slots[3], slots[4], slots[5], slots[6])
    if rh_streq(mode, "release"):
        return sfail("usage: test_store <workdir> release <job> <token> <phase> <owner> <now>") if argc < 8
        return srelease(workdir, slots[3], slots[4], slots[5], slots[6], slots[7])
    sfail("unknown mode")
