# Field transformation contract for local PEP 751 artifact observations.
include "./rh_base.elisa"

module PylockObservationTransformation:
    public:
        def rh_pylock_observation_transformation_report(configuration_sha: darray[u8]&, audit_sha: darray[u8]&, artifact_sha: darray[u8]&, output_sha: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"pep751-local-artifact-observation\",\"source_input_sha256\":\"")
            out.extend(bytes_view(audit_sha))
            Base::rh_push_text(out, "\",\"source_artifact_sha256\":\"")
            out.extend(bytes_view(artifact_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-pylock-artifact-observation-result/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"PEP 751 artifact id and package identity\",\"target\":\"observation.artifact_id|package_id|package_name|package_version\",\"state\":\"preserved\"},{\"source\":\"declared artifact size and supported expected hashes\",\"target\":\"observation.expected_size_bytes|hashes\",\"state\":\"preserved\"},{\"source\":\"caller-supplied local artifact bytes\",\"target\":\"observation.file_size_bytes|observed_file_sha256|hashes.observed\",\"state\":\"transformed\"},{\"source\":\"declared and observed size and digest comparisons\",\"target\":\"observation.size_state|hashes.state|state\",\"state\":\"transformed\"},{\"source\":\"local filesystem path and archive contents\",\"target\":\"published observation\",\"state\":\"discarded\"},{\"source\":\"hash algorithms outside SHA-256/SHA-384/SHA-512\",\"target\":\"observation.hashes\",\"state\":\"unsupported\"}]}")
