# Digest-bound field transformation report for forge repository normalization.
include "./rh_base.elisa"

module ForgeTransformation:
    public:
        def rh_forge_transformation_report(provider: cstr, configuration_sha: darray[u8]&, input_sha: darray[u8]&, output_sha: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-forge-transformation-report/1\",\"provider\":\"")
            Base::rh_push_cstr(out, provider)
            Base::rh_push_text(out, "\",\"normalized_schema\":\"rh-canonical-repo/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"normalized_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"name\",\"target\":\"name\",\"state\":\"preserved\"},")
            if Base::rh_streq(provider, "gitlab"):
                Base::rh_push_text(out, "{\"source\":\"id\",\"target\":\"native_id\",\"state\":\"transformed\"},{\"source\":\"path_with_namespace\",\"target\":\"full_name\",\"state\":\"preserved\"},{\"source\":\"web_url\",\"target\":\"url\",\"state\":\"preserved\"},{\"source\":\"created_at|last_activity_at\",\"target\":\"created_at|updated_at\",\"state\":\"transformed\"},")
            elif Base::rh_streq(provider, "bitbucket"):
                Base::rh_push_text(out, "{\"source\":\"uuid\",\"target\":\"native_id\",\"state\":\"transformed\"},{\"source\":\"full_name\",\"target\":\"full_name\",\"state\":\"preserved\"},{\"source\":\"links.html.href\",\"target\":\"url\",\"state\":\"transformed\"},{\"source\":\"created_on|updated_on\",\"target\":\"created_at|updated_at\",\"state\":\"transformed\"},")
            else:
                Base::rh_push_text(out, "{\"source\":\"id\",\"target\":\"native_id\",\"state\":\"transformed\"},{\"source\":\"full_name\",\"target\":\"full_name\",\"state\":\"preserved\"},{\"source\":\"html_url\",\"target\":\"url\",\"state\":\"preserved\"},{\"source\":\"created_at|updated_at\",\"target\":\"created_at|updated_at\",\"state\":\"transformed\"},")
            if Base::rh_streq(provider, "github"):
                Base::rh_push_text(out, "{\"source\":\"pushed_at\",\"target\":\"pushed_at\",\"state\":\"transformed\"},")
            else:
                Base::rh_push_text(out, "{\"source\":\"not provided by this provider\",\"target\":\"pushed_at\",\"state\":\"unknown\"},")
            Base::rh_push_text(out, "{\"source\":\"collector clock or explicit fetched_at\",\"target\":\"fetched_at\",\"state\":\"inferred\"},{\"source\":\"all other provider fields\",\"target\":\"canonical repository record\",\"state\":\"discarded\"}]}")
