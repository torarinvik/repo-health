# rh_postgres.elisa — bounded PostgreSQL application adapter (M02-01).

include "./rh_base.elisa"

module Postgres:
    private:
        const RH_PG_TUPLES_OK: i32 = 2
        const RH_PG_RTLD_NOW: i32 = 2

        struct RhPgApi:
            library: void&?
            connectdb_params: uintptr
            exec: uintptr
            status: uintptr
            exec_params: uintptr
            result_status: uintptr
            tuples: uintptr
            fields: uintptr
            is_null: uintptr
            value: uintptr
            length: uintptr
            clear: uintptr
            finish: uintptr

        @link_name("dlopen")
        extern rh_pg_dlopen(path: cstr, flags: i32) -> void&?

        @link_name("dlsym")
        extern rh_pg_dlsym(library: void&, name: cstr) -> void&?

        @link_name("dlclose")
        extern rh_pg_dlclose(library: void&) -> i32

        def rh_pg_empty_api() -> RhPgApi:
            RhPgApi{library: null, connectdb_params: 0, exec: 0, status: 0, exec_params: 0, result_status: 0, tuples: 0, fields: 0, is_null: 0, value: 0, length: 0, clear: 0, finish: 0}

        def rh_pg_load_symbol(library: void&, name: cstr) -> uintptr can[Unsafe.PointerCast]:
            symbol: void&? = rh_pg_dlsym(library, name)
            return 0 if symbol == null
            symbol.cast[uintptr] can Unsafe.PointerCast

        static if ELISA_TARGET_OS_MACOS:
            def rh_pg_default_library() -> void&? can[Blocking.IO]:
                first: void&? = rh_pg_dlopen("/opt/homebrew/opt/libpq/lib/libpq.5.dylib", RH_PG_RTLD_NOW)
                return first if first != null
                second: void&? = rh_pg_dlopen("/usr/local/opt/libpq/lib/libpq.5.dylib", RH_PG_RTLD_NOW)
                return second if second != null
                rh_pg_dlopen("libpq.5.dylib", RH_PG_RTLD_NOW)

        static elif ELISA_TARGET_OS_LINUX:
            def rh_pg_default_library() -> void&? can[Blocking.IO]:
                rh_pg_dlopen("libpq.so.5", RH_PG_RTLD_NOW)

        static else:
            def rh_pg_default_library() -> void&?:
                null

        def rh_pg_load_api() -> RhPgApi can[Blocking.IO, Unsafe.PointerCast]:
            library: void&? =
                configured: u8&? = getenv("RH_LIBPQ_PATH")
                if configured != null:
                    configured_path: cstr = configured.cast[cstr] can Unsafe.PointerCast
                    rh_pg_dlopen(configured_path, RH_PG_RTLD_NOW)
                else:
                    Postgres::rh_pg_default_library()
            return rh_pg_empty_api() if library == null
            handle: void& = library
            api: RhPgApi = RhPgApi{
                library: library,
                connectdb_params: rh_pg_load_symbol(handle, "PQconnectdbParams"),
                exec: rh_pg_load_symbol(handle, "PQexec"),
                status: rh_pg_load_symbol(handle, "PQstatus"),
                exec_params: rh_pg_load_symbol(handle, "PQexecParams"),
                result_status: rh_pg_load_symbol(handle, "PQresultStatus"),
                tuples: rh_pg_load_symbol(handle, "PQntuples"),
                fields: rh_pg_load_symbol(handle, "PQnfields"),
                is_null: rh_pg_load_symbol(handle, "PQgetisnull"),
                value: rh_pg_load_symbol(handle, "PQgetvalue"),
                length: rh_pg_load_symbol(handle, "PQgetlength"),
                clear: rh_pg_load_symbol(handle, "PQclear"),
                finish: rh_pg_load_symbol(handle, "PQfinish")
            }
            ready: bool = api.connectdb_params != 0 and api.exec != 0 and api.status != 0 and api.exec_params != 0 and api.result_status != 0 and api.tuples != 0 and api.fields != 0 and api.is_null != 0 and api.value != 0 and api.length != 0 and api.clear != 0 and api.finish != 0
            if not ready:
                _ = rh_pg_dlclose(handle)
                return rh_pg_empty_api()
            api

        def rh_pg_decimal(value: i64) -> mutable darray[u8] can[Memory.Allocate, Abort.Panic]:
            bytes: mutable darray[u8] = []
            Base::rh_push_decimal_i64(bytes, value)
            bytes.push(0)
            bytes

        # Every public repository operation is one parameterized PostgreSQL
        # function call, so the database owns the short transaction boundary.
        def rh_pg_boolean_query(conninfo: cstr, statement: cstr, params: darray[cstr]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if params.count == 0 or params.count > 64
            api: RhPgApi = Postgres::rh_pg_load_api()
            return -1 if api.library == null
            library: void& = api.library
            connectdb_params: fn(void&, void&, i32) -> void&? = api.connectdb_params.cast[fn(void&, void&, i32) -> void&?] can Unsafe.PointerCast
            status: fn(void&) -> i32 = api.status.cast[fn(void&) -> i32] can Unsafe.PointerCast
            exec_params: fn(void&, cstr, i32, void&?, void&, void&?, void&?, i32) -> void&? = api.exec_params.cast[fn(void&, cstr, i32, void&?, void&, void&?, void&?, i32) -> void&?] can Unsafe.PointerCast
            result_status: fn(void&) -> i32 = api.result_status.cast[fn(void&) -> i32] can Unsafe.PointerCast
            tuples: fn(void&) -> i32 = api.tuples.cast[fn(void&) -> i32] can Unsafe.PointerCast
            fields: fn(void&) -> i32 = api.fields.cast[fn(void&) -> i32] can Unsafe.PointerCast
            is_null: fn(void&, i32, i32) -> i32 = api.is_null.cast[fn(void&, i32, i32) -> i32] can Unsafe.PointerCast
            value: fn(void&, i32, i32) -> cstr = api.value.cast[fn(void&, i32, i32) -> cstr] can Unsafe.PointerCast
            clear: fn(void&) -> void = api.clear.cast[fn(void&) -> void] can Unsafe.PointerCast
            finish: fn(void&) -> void = api.finish.cast[fn(void&) -> void] can Unsafe.PointerCast
            keywords: mutable darray[cstr?] = []
            values: mutable darray[cstr?] = []
            keywords.push("dbname")
            values.push(conninfo)
            keywords.push("connect_timeout")
            values.push("5")
            keywords.push(null)
            values.push(null)
            keyword_ptr: void& = (&keywords[0]).cast[void&] can Unsafe.PointerCast
            value_ptr: void& = (&values[0]).cast[void&] can Unsafe.PointerCast
            connection: void&? = connectdb_params(keyword_ptr, value_ptr, 1)
            if connection == null:
                _ = rh_pg_dlclose(library)
                return -1
            conn: void& = connection
            outcome: i64 =
                if status(conn) != 0:
                    -1
                else:
                    param_values: void& = (&params[0]).cast[void&] can Unsafe.PointerCast
                    query_result: void&? = exec_params(conn, statement, params.count.i32(), null, param_values, null, null, 0)
                    if query_result == null:
                        -1
                    else:
                        result: void& = query_result
                        parsed: i64 =
                            if result_status(result) != RH_PG_TUPLES_OK or tuples(result) != 1 or fields(result) != 1 or is_null(result, 0, 0) != 0:
                                -1
                            else:
                                cell: cstr = value(result, 0, 0)
                                1 if Base::rh_streq(cell, "t") else 0 if Base::rh_streq(cell, "f") else -1
                        clear(result)
                        parsed
            finish(conn)
            _ = rh_pg_dlclose(library)
            outcome

        # The only caller supplies a fixed read-only statement. Keep this
        # parameterless libpq path private so arbitrary SQL never reaches PQexec.
        def rh_pg_text_query(conninfo: cstr, statement: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if out.count != 0 or Base::rh_cstr_len_c(conninfo) == 0 or Base::rh_cstr_len_c(conninfo) > 4096
            api: RhPgApi = Postgres::rh_pg_load_api()
            return -1 if api.library == null
            library: void& = api.library
            connectdb_params: fn(void&, void&, i32) -> void&? = api.connectdb_params.cast[fn(void&, void&, i32) -> void&?] can Unsafe.PointerCast
            exec: fn(void&, cstr) -> void&? = api.exec.cast[fn(void&, cstr) -> void&?] can Unsafe.PointerCast
            status: fn(void&) -> i32 = api.status.cast[fn(void&) -> i32] can Unsafe.PointerCast
            result_status: fn(void&) -> i32 = api.result_status.cast[fn(void&) -> i32] can Unsafe.PointerCast
            tuples: fn(void&) -> i32 = api.tuples.cast[fn(void&) -> i32] can Unsafe.PointerCast
            fields: fn(void&) -> i32 = api.fields.cast[fn(void&) -> i32] can Unsafe.PointerCast
            is_null: fn(void&, i32, i32) -> i32 = api.is_null.cast[fn(void&, i32, i32) -> i32] can Unsafe.PointerCast
            value: fn(void&, i32, i32) -> cstr = api.value.cast[fn(void&, i32, i32) -> cstr] can Unsafe.PointerCast
            length: fn(void&, i32, i32) -> i32 = api.length.cast[fn(void&, i32, i32) -> i32] can Unsafe.PointerCast
            clear: fn(void&) -> void = api.clear.cast[fn(void&) -> void] can Unsafe.PointerCast
            finish: fn(void&) -> void = api.finish.cast[fn(void&) -> void] can Unsafe.PointerCast
            keywords: mutable darray[cstr?] = []
            values: mutable darray[cstr?] = []
            keywords.push("dbname")
            values.push(conninfo)
            keywords.push("connect_timeout")
            values.push("5")
            keywords.push(null)
            values.push(null)
            keyword_ptr: void& = (&keywords[0]).cast[void&] can Unsafe.PointerCast
            value_ptr: void& = (&values[0]).cast[void&] can Unsafe.PointerCast
            connection: void&? = connectdb_params(keyword_ptr, value_ptr, 1)
            if connection == null:
                _ = rh_pg_dlclose(library)
                return -1
            conn: void& = connection
            outcome: i64 =
                if status(conn) != 0:
                    -1
                else:
                    query_result: void&? = exec(conn, statement)
                    if query_result == null:
                        -1
                    else:
                        result: void& = query_result
                        copied: i64 =
                            if result_status(result) != RH_PG_TUPLES_OK or tuples(result) != 1 or fields(result) != 1 or is_null(result, 0, 0) != 0:
                                -1
                            else:
                                text_length: i32 = length(result, 0, 0)
                                if text_length <= 0 or text_length > 4194304:
                                    -1
                                else:
                                    text_value: cstr = value(result, 0, 0)
                                    while i < text_length.i64() |i: i64 = 0, text_length, text_value, out|:
                                        out.push(text_value[i.usize()].u8())
                                        i <- i + 1
                                    text_length.i64()
                        clear(result)
                        copied
            finish(conn)
            _ = rh_pg_dlclose(library)
            outcome

        # Parameter-bound read counterpart for fixed, read-only repository
        # queries. Callers own the statement; caller data is never SQL text.
        def rh_pg_text_params(conninfo: cstr, statement: cstr, params: darray[cstr]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if out.count != 0 or params.count == 0 or params.count > 64 or Base::rh_cstr_len_c(conninfo) == 0 or Base::rh_cstr_len_c(conninfo) > 4096
            api: RhPgApi = Postgres::rh_pg_load_api()
            return -1 if api.library == null
            library: void& = api.library
            connectdb_params: fn(void&, void&, i32) -> void&? = api.connectdb_params.cast[fn(void&, void&, i32) -> void&?] can Unsafe.PointerCast
            exec_params: fn(void&, cstr, i32, void&?, void&, void&?, void&?, i32) -> void&? = api.exec_params.cast[fn(void&, cstr, i32, void&?, void&, void&?, void&?, i32) -> void&?] can Unsafe.PointerCast
            status: fn(void&) -> i32 = api.status.cast[fn(void&) -> i32] can Unsafe.PointerCast
            result_status: fn(void&) -> i32 = api.result_status.cast[fn(void&) -> i32] can Unsafe.PointerCast
            tuples: fn(void&) -> i32 = api.tuples.cast[fn(void&) -> i32] can Unsafe.PointerCast
            fields: fn(void&) -> i32 = api.fields.cast[fn(void&) -> i32] can Unsafe.PointerCast
            is_null: fn(void&, i32, i32) -> i32 = api.is_null.cast[fn(void&, i32, i32) -> i32] can Unsafe.PointerCast
            value: fn(void&, i32, i32) -> cstr = api.value.cast[fn(void&, i32, i32) -> cstr] can Unsafe.PointerCast
            length: fn(void&, i32, i32) -> i32 = api.length.cast[fn(void&, i32, i32) -> i32] can Unsafe.PointerCast
            clear: fn(void&) -> void = api.clear.cast[fn(void&) -> void] can Unsafe.PointerCast
            finish: fn(void&) -> void = api.finish.cast[fn(void&) -> void] can Unsafe.PointerCast
            keywords: mutable darray[cstr?] = []
            values: mutable darray[cstr?] = []
            keywords.push("dbname")
            values.push(conninfo)
            keywords.push("connect_timeout")
            values.push("5")
            keywords.push(null)
            values.push(null)
            keyword_ptr: void& = (&keywords[0]).cast[void&] can Unsafe.PointerCast
            value_ptr: void& = (&values[0]).cast[void&] can Unsafe.PointerCast
            connection: void&? = connectdb_params(keyword_ptr, value_ptr, 1)
            if connection == null:
                _ = rh_pg_dlclose(library)
                return -1
            conn: void& = connection
            outcome: i64 =
                if status(conn) != 0:
                    -1
                else:
                    parameter_values: void& = (&params[0]).cast[void&] can Unsafe.PointerCast
                    result_pointer: void&? = exec_params(conn, statement, params.count.i32(), null, parameter_values, null, null, 0)
                    if result_pointer == null:
                        -1
                    else:
                        result: void& = result_pointer
                        copied: i64 =
                            if result_status(result) != RH_PG_TUPLES_OK or tuples(result) != 1 or fields(result) != 1 or is_null(result, 0, 0) != 0:
                                -1
                            else:
                                text_length: i32 = length(result, 0, 0)
                                if text_length <= 0 or text_length > 4194304:
                                    -1
                                else:
                                    text_value: cstr = value(result, 0, 0)
                                    while i < text_length.i64() |i: i64 = 0, text_length, text_value, out|:
                                        out.push(text_value[i.usize()].u8())
                                        i <- i + 1
                                    text_length.i64()
                        clear(result)
                        copied
            finish(conn)
            _ = rh_pg_dlclose(library)
            outcome

    public:
        # Return bounded run-window coverage for one source and capability.
        # Missing request bounds are omitted because they cannot establish a
        # measurable interval; non-successful runs remain explicit gaps.
        def rh_pg_adoption_history(conninfo: cstr, source_id: cstr, capability: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if Base::rh_cstr_len_c(source_id) != 36 or Base::rh_cstr_len_c(capability) == 0 or Base::rh_cstr_len_c(capability) > 128
            params: mutable darray[cstr] = []
            params.push(source_id)
            params.push(capability)
            Postgres::rh_pg_text_params(conninfo, "SELECT COALESCE(json_agg(json_build_object('from', extract(epoch FROM requested_start)::bigint, 'through', extract(epoch FROM requested_end)::bigint, 'complete', (status = 'succeeded' AND completeness IN ('complete', 'empty'))) ORDER BY requested_start, started_at, id), '[]'::json)::text FROM (SELECT id, requested_start, requested_end, started_at, status, completeness FROM public.collection_run WHERE source_instance_id = $1::uuid AND capability = $2::text AND requested_start IS NOT NULL AND requested_end IS NOT NULL ORDER BY requested_start, started_at, id LIMIT 4097) AS bounded_runs HAVING count(*) <= 4096 AND count(*) FILTER (WHERE date_trunc('second', requested_start) <> requested_start OR date_trunc('second', requested_end) <> requested_end) = 0", params, out)

        # Create or verify the immutable source configuration and its running
        # collection run in one database transaction. Returns 1 when started,
        # 0 for an exact retry, or -1 on a transport or metadata conflict.
        def rh_pg_begin_collection_run(conninfo: cstr, source_id: cstr, source_kind: cstr, source_base_url: cstr, source_visibility_scope: cstr, configuration_revision: i64, source_created_at: cstr, run_id: cstr, capability: cstr, connector_name: cstr, connector_version: cstr, requested_start: cstr, requested_end: cstr, started_at: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if configuration_revision <= 0
            return -1 if Base::rh_cstr_len_c(source_kind) == 0 or Base::rh_cstr_len_c(source_kind) > 128
            return -1 if Base::rh_cstr_len_c(source_base_url) == 0 or Base::rh_cstr_len_c(source_base_url) > 2048
            return -1 if Base::rh_cstr_len_c(capability) == 0 or Base::rh_cstr_len_c(capability) > 128
            return -1 if Base::rh_cstr_len_c(connector_name) == 0 or Base::rh_cstr_len_c(connector_name) > 128
            return -1 if Base::rh_cstr_len_c(connector_version) == 0 or Base::rh_cstr_len_c(connector_version) > 128
            revision_text: mutable darray[u8] = Postgres::rh_pg_decimal(configuration_revision)
            revision_ptr: cstr = (&revision_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(source_id)
            params.push(source_kind)
            params.push(source_base_url)
            params.push(source_visibility_scope)
            params.push(revision_ptr)
            params.push(source_created_at)
            params.push(run_id)
            params.push(capability)
            params.push(connector_name)
            params.push(connector_version)
            params.push(requested_start)
            params.push(requested_end)
            params.push(started_at)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_begin_collection_run($1::uuid, $2::text, $3::text, $4::rh_visibility_scope, $5::bigint, $6::timestamptz, $7::uuid, $8::text, $9::text, $10::text, NULLIF($11, '')::timestamptz, NULLIF($12, '')::timestamptz, $13::timestamptz)", params)

        # Queue or replay the immutable binding between one collection run and
        # its scheduled job. Returns 1 when enqueued, 0 for an exact retry.
        def rh_pg_enqueue_collection_job(conninfo: cstr, run_id: cstr, job_id: cstr, priority: i64, next_attempt_at: cstr, created_at: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if priority < -2147483648 or priority > 2147483647
            priority_text: mutable darray[u8] = Postgres::rh_pg_decimal(priority)
            priority_ptr: cstr = (&priority_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(run_id)
            params.push(job_id)
            params.push(priority_ptr)
            params.push(next_attempt_at)
            params.push(created_at)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_enqueue_collection_job($1::uuid, $2::uuid, $3::integer, $4::timestamptz, $5::timestamptz)", params)

        # Persist a bounded graph query request. JSON remains a bound parameter,
        # and exact job-ID replays are checked by PostgreSQL against the request.
        def rh_pg_enqueue_graph_query_job(conninfo: cstr, job_id: cstr, visibility_scope: cstr, request_json: cstr, priority: i64, next_attempt_at: cstr, created_at: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if Base::rh_cstr_len_c(job_id) == 0 or Base::rh_cstr_len_c(job_id) > 64
            return -1 if Base::rh_cstr_len_c(request_json) == 0 or Base::rh_cstr_len_c(request_json) > 1048576
            return -1 if priority < -2147483648 or priority > 2147483647
            priority_text: mutable darray[u8] = Postgres::rh_pg_decimal(priority)
            priority_ptr: cstr = (&priority_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(job_id)
            params.push(visibility_scope)
            params.push(request_json)
            params.push(priority_ptr)
            params.push(next_attempt_at)
            params.push(created_at)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_enqueue_graph_query_job($1::uuid, $2::rh_visibility_scope, $3::jsonb, $4::integer, $5::timestamptz, $6::timestamptz)", params)

        # Publish the result and complete the graph job in one fenced database
        # transaction. A stale or expired worker receives false and cannot
        # replace the current attempt's output.
        def rh_pg_publish_graph_query_result(conninfo: cstr, job_id: cstr, fencing_token: i64, now: cstr, result_json: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if fencing_token <= 0 or Base::rh_cstr_len_c(job_id) == 0 or Base::rh_cstr_len_c(job_id) > 64
            return -1 if Base::rh_cstr_len_c(result_json) == 0 or Base::rh_cstr_len_c(result_json) > 1048576
            token_text: mutable darray[u8] = Postgres::rh_pg_decimal(fencing_token)
            token_ptr: cstr = (&token_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(job_id)
            params.push(token_ptr)
            params.push(now)
            params.push(result_json)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_publish_graph_query_result($1::uuid, $2::bigint, $3::timestamptz, $4::jsonb)", params)

        # Commit one complete collection page through the migration's fenced,
        # idempotent transaction. Parameters use libpq's extended query protocol;
        # none are interpolated into SQL or passed through a shell. Empty optional
        # JSON/evidence strings map to SQL NULL. Returns 1 when committed, 0 when
        # this page was already committed, or -1 on invalid input or query failure.
        def rh_pg_commit_collection_page(conninfo: cstr, run_id: cstr, job_id: cstr, fencing_token: i64, page_number: i64, scope_hash: cstr, cursor_before: cstr, cursor_after: cstr, completeness: cstr, record_count: i64, evidence_id: cstr, now: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if fencing_token <= 0 or page_number < 0 or record_count < 0
            return -1 if not Base::rh_streq(completeness, "complete") and not Base::rh_streq(completeness, "empty")
            token_text: mutable darray[u8] = Postgres::rh_pg_decimal(fencing_token)
            page_text: mutable darray[u8] = Postgres::rh_pg_decimal(page_number)
            count_text: mutable darray[u8] = Postgres::rh_pg_decimal(record_count)
            token_ptr: cstr = (&token_text[0]).cast[cstr] can Unsafe.PointerCast
            page_ptr: cstr = (&page_text[0]).cast[cstr] can Unsafe.PointerCast
            count_ptr: cstr = (&count_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(run_id)
            params.push(job_id)
            params.push(token_ptr)
            params.push(page_ptr)
            params.push(scope_hash)
            params.push(cursor_before)
            params.push(cursor_after)
            params.push(completeness)
            params.push(count_ptr)
            params.push(evidence_id)
            params.push(now)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_commit_collection_page($1::uuid, $2::uuid, $3::bigint, $4::integer, $5::text, NULLIF($6, '')::jsonb, $7::jsonb, $8::text, $9::integer, NULLIF($10, '')::uuid, $11::timestamptz)", params)

        # Commit a complete page with typed subjects, actors, and canonical
        # event rows as one database transaction. PostgreSQL validates the event
        # envelope, deduplicates source-native identities, and advances the
        # cursor only after every row has inserted successfully.
        def rh_pg_commit_collection_page_events(conninfo: cstr, run_id: cstr, job_id: cstr, fencing_token: i64, page_number: i64, scope_hash: cstr, cursor_before: cstr, cursor_after: cstr, completeness: cstr, record_count: i64, evidence_id: cstr, events_json: cstr, subjects_json: cstr, actors_json: cstr, now: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if fencing_token <= 0 or page_number < 0 or record_count < 0 or Base::rh_cstr_len_c(events_json) == 0 or Base::rh_cstr_len_c(events_json) > 1048576 or Base::rh_cstr_len_c(subjects_json) > 1048576 or Base::rh_cstr_len_c(actors_json) > 1048576
            return -1 if not Base::rh_streq(completeness, "complete") and not Base::rh_streq(completeness, "empty")
            token_text: mutable darray[u8] = Postgres::rh_pg_decimal(fencing_token)
            page_text: mutable darray[u8] = Postgres::rh_pg_decimal(page_number)
            count_text: mutable darray[u8] = Postgres::rh_pg_decimal(record_count)
            token_ptr: cstr = (&token_text[0]).cast[cstr] can Unsafe.PointerCast
            page_ptr: cstr = (&page_text[0]).cast[cstr] can Unsafe.PointerCast
            count_ptr: cstr = (&count_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(run_id)
            params.push(job_id)
            params.push(token_ptr)
            params.push(page_ptr)
            params.push(scope_hash)
            params.push(cursor_before)
            params.push(cursor_after)
            params.push(completeness)
            params.push(count_ptr)
            params.push(evidence_id)
            params.push(events_json)
            params.push(subjects_json)
            params.push(actors_json)
            params.push(now)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_commit_collection_page_events($1::uuid, $2::uuid, $3::bigint, $4::integer, $5::text, NULLIF($6, '')::jsonb, $7::jsonb, $8::text, $9::integer, NULLIF($10, '')::uuid, $11::jsonb, COALESCE(NULLIF($12, '')::jsonb, '[]'::jsonb), COALESCE(NULLIF($13, '')::jsonb, '[]'::jsonb), $14::timestamptz)", params)

        # Stage one raw provider page without assigning source-native event
        # identity. PostgreSQL preserves each bounded JSON object and advances
        # the page cursor in the same fenced transaction.
        def rh_pg_commit_staged_collection_page(conninfo: cstr, run_id: cstr, job_id: cstr, fencing_token: i64, page_number: i64, scope_hash: cstr, cursor_before: cstr, cursor_after: cstr, completeness: cstr, evidence_id: cstr, records_json: cstr, now: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if fencing_token <= 0 or page_number < 0 or Base::rh_cstr_len_c(records_json) == 0 or Base::rh_cstr_len_c(records_json) > 8388608
            return -1 if not Base::rh_streq(completeness, "complete") and not Base::rh_streq(completeness, "empty")
            token_text: mutable darray[u8] = Postgres::rh_pg_decimal(fencing_token)
            page_text: mutable darray[u8] = Postgres::rh_pg_decimal(page_number)
            token_ptr: cstr = (&token_text[0]).cast[cstr] can Unsafe.PointerCast
            page_ptr: cstr = (&page_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(run_id)
            params.push(job_id)
            params.push(token_ptr)
            params.push(page_ptr)
            params.push(scope_hash)
            params.push(cursor_before)
            params.push(cursor_after)
            params.push(completeness)
            params.push(evidence_id)
            params.push(records_json)
            params.push(now)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_commit_staged_collection_page($1::uuid, $2::uuid, $3::bigint, $4::integer, $5::text, NULLIF($6, '')::jsonb, $7::jsonb, $8::text, NULLIF($9, '')::uuid, $10::jsonb, $11::timestamptz)", params)

        # Write a completed staged normalization as canonical observations.
        # PostgreSQL independently checks the run, page, ordinal, and evidence
        # lineage before its transaction records the replay manifest.
        def rh_pg_commit_staged_normalization(conninfo: cstr, source_id: cstr, run_id: cstr, input_sha256: cstr, configuration_sha256: cstr, output_sha256: cstr, normalizer_version: cstr, captured_at: i64, events_json: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if captured_at < 0 or captured_at > 253402300799 or Base::rh_cstr_len_c(events_json) == 0 or Base::rh_cstr_len_c(events_json) > 16777216
            captured_text: mutable darray[u8] = Postgres::rh_pg_decimal(captured_at)
            captured_ptr: cstr = (&captured_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(source_id)
            params.push(run_id)
            params.push(input_sha256)
            params.push(configuration_sha256)
            params.push(output_sha256)
            params.push(normalizer_version)
            params.push(captured_ptr)
            params.push(events_json)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_commit_staged_normalization($1::uuid, $2::uuid, $3::text, $4::text, $5::text, $6::text, $7::bigint, $8::jsonb)", params)

        # Register SHA-256 evidence metadata after the caller has verified its
        # immutable blob. Returns 1 for a new identity, 0 for an exact replay,
        # and -1 for a database error or conflicting metadata.
        def rh_pg_register_evidence_object(conninfo: cstr, evidence_id: cstr, visibility_scope: cstr, digest_value: cstr, byte_length: i64, media_type: cstr, storage_key: cstr, retention_class: cstr, transformation_kind: cstr, created_at: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if byte_length < 0 or byte_length > 67108864
            byte_length_text: mutable darray[u8] = Postgres::rh_pg_decimal(byte_length)
            byte_length_ptr: cstr = (&byte_length_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(evidence_id)
            params.push(visibility_scope)
            params.push(digest_value)
            params.push(byte_length_ptr)
            params.push(media_type)
            params.push(storage_key)
            params.push(retention_class)
            params.push(transformation_kind)
            params.push(created_at)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_register_evidence_object($1::uuid, $2::rh_visibility_scope, $3::text, $4::bigint, $5::text, $6::text, $7::text, $8::text, $9::timestamptz)", params)

        # Read the bounded set of local content-addressed evidence keys. Invalid
        # keys and truncation are reported to the caller, which must fail closed.
        def rh_pg_evidence_references(conninfo: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            Postgres::rh_pg_text_query(conninfo, "SELECT json_build_object('storage_keys', COALESCE(json_agg(storage_key ORDER BY storage_key) FILTER (WHERE storage_key ~ '^fnv1a64:[0-9a-f]{16}$'), '[]'::json), 'invalid_count', count(*) FILTER (WHERE storage_key !~ '^fnv1a64:[0-9a-f]{16}$'), 'truncated', count(*) > 100000, 'count', count(*) FILTER (WHERE storage_key ~ '^fnv1a64:[0-9a-f]{16}$'))::text FROM (SELECT storage_key FROM public.evidence_object ORDER BY storage_key LIMIT 100001) AS evidence_reference_window", out)

        # A stale worker token receives a normal false result from PostgreSQL;
        # transport or query failures remain distinguishable as -1.
        def rh_pg_heartbeat_job(conninfo: cstr, job_id: cstr, fencing_token: i64, now: cstr, lease_seconds: i64) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if fencing_token <= 0 or lease_seconds <= 0 or lease_seconds > 86400
            token_text: mutable darray[u8] = Postgres::rh_pg_decimal(fencing_token)
            lease_text: mutable darray[u8] = Postgres::rh_pg_decimal(lease_seconds)
            token_ptr: cstr = (&token_text[0]).cast[cstr] can Unsafe.PointerCast
            lease_ptr: cstr = (&lease_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(job_id)
            params.push(token_ptr)
            params.push(now)
            params.push(lease_ptr)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_heartbeat_job($1::uuid, $2::bigint, $3::timestamptz, $4::integer)", params)

        # Finish only a recognized terminal state; the migration function
        # performs the fencing check and closes the matching attempt atomically.
        def rh_pg_finish_job(conninfo: cstr, job_id: cstr, fencing_token: i64, state: cstr, now: cstr, outcome: cstr, error_kind: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if fencing_token <= 0
            return -1 if not Base::rh_streq(state, "succeeded") and not Base::rh_streq(state, "failed") and not Base::rh_streq(state, "dead_letter") and not Base::rh_streq(state, "canceled")
            token_text: mutable darray[u8] = Postgres::rh_pg_decimal(fencing_token)
            token_ptr: cstr = (&token_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(job_id)
            params.push(token_ptr)
            params.push(state)
            params.push(now)
            params.push(outcome)
            params.push(error_kind)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_finish_job($1::uuid, $2::bigint, $3::text, $4::timestamptz, NULLIF($5, '')::text, NULLIF($6, '')::text)", params)

        # Finish a collection run and its collection job under one current,
        # unexpired lease. PostgreSQL commits both terminal states together.
        def rh_pg_finish_collection_job(conninfo: cstr, run_id: cstr, job_id: cstr, fencing_token: i64, job_state: cstr, run_status: cstr, completeness: cstr, coverage_details: cstr, now: cstr, outcome: cstr, error_kind: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if fencing_token <= 0 or Base::rh_cstr_len_c(coverage_details) > 1048576
            return -1 if not Base::rh_streq(job_state, "succeeded") and not Base::rh_streq(job_state, "failed") and not Base::rh_streq(job_state, "dead_letter") and not Base::rh_streq(job_state, "canceled")
            return -1 if not Base::rh_streq(run_status, "succeeded") and not Base::rh_streq(run_status, "partial") and not Base::rh_streq(run_status, "failed") and not Base::rh_streq(run_status, "canceled")
            return -1 if not Base::rh_streq(completeness, "complete") and not Base::rh_streq(completeness, "partial") and not Base::rh_streq(completeness, "empty") and not Base::rh_streq(completeness, "unknown")
            token_text: mutable darray[u8] = Postgres::rh_pg_decimal(fencing_token)
            token_ptr: cstr = (&token_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(run_id)
            params.push(job_id)
            params.push(token_ptr)
            params.push(job_state)
            params.push(run_status)
            params.push(completeness)
            params.push(coverage_details)
            params.push(outcome)
            params.push(error_kind)
            params.push(now)
            Postgres::rh_pg_boolean_query(conninfo, "SELECT public.rh_finish_collection_job($1::uuid, $2::uuid, $3::bigint, $4::text, $5::text, $6::text, $7::jsonb, NULLIF($8, '')::text, NULLIF($9, '')::text, $10::timestamptz)", params)

    private:
        # Claim through SKIP LOCKED, optionally binding the claim to one
        # collection job. Returns 1 with its lease, 0 when no job is runnable.
        def rh_pg_claim_job(conninfo: cstr, worker_id: cstr, now: cstr, lease_seconds: i64, target_job_id: cstr, target_job_kind: cstr, job_id_out: mutable darray[u8]&, fencing_token_out: mutable i64&, lease_expires_at_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            job_id_out <- []
            fencing_token_out[0] <- 0
            lease_expires_at_out <- []
            return -1 if Base::rh_cstr_len_c(worker_id) == 0 or Base::rh_cstr_len_c(worker_id) > 256
            return -1 if lease_seconds <= 0 or lease_seconds > 86400
            api: RhPgApi = Postgres::rh_pg_load_api()
            return -1 if api.library == null
            library: void& = api.library
            connectdb_params: fn(void&, void&, i32) -> void&? = api.connectdb_params.cast[fn(void&, void&, i32) -> void&?] can Unsafe.PointerCast
            status: fn(void&) -> i32 = api.status.cast[fn(void&) -> i32] can Unsafe.PointerCast
            exec_params: fn(void&, cstr, i32, void&?, void&, void&?, void&?, i32) -> void&? = api.exec_params.cast[fn(void&, cstr, i32, void&?, void&, void&?, void&?, i32) -> void&?] can Unsafe.PointerCast
            result_status: fn(void&) -> i32 = api.result_status.cast[fn(void&) -> i32] can Unsafe.PointerCast
            tuples: fn(void&) -> i32 = api.tuples.cast[fn(void&) -> i32] can Unsafe.PointerCast
            fields: fn(void&) -> i32 = api.fields.cast[fn(void&) -> i32] can Unsafe.PointerCast
            is_null: fn(void&, i32, i32) -> i32 = api.is_null.cast[fn(void&, i32, i32) -> i32] can Unsafe.PointerCast
            value: fn(void&, i32, i32) -> cstr = api.value.cast[fn(void&, i32, i32) -> cstr] can Unsafe.PointerCast
            length: fn(void&, i32, i32) -> i32 = api.length.cast[fn(void&, i32, i32) -> i32] can Unsafe.PointerCast
            clear: fn(void&) -> void = api.clear.cast[fn(void&) -> void] can Unsafe.PointerCast
            finish: fn(void&) -> void = api.finish.cast[fn(void&) -> void] can Unsafe.PointerCast
            keywords: mutable darray[cstr?] = []
            values: mutable darray[cstr?] = []
            keywords.push("dbname")
            values.push(conninfo)
            keywords.push("connect_timeout")
            values.push("5")
            keywords.push(null)
            values.push(null)
            keyword_ptr: void& = (&keywords[0]).cast[void&] can Unsafe.PointerCast
            value_ptr: void& = (&values[0]).cast[void&] can Unsafe.PointerCast
            connection: void&? = connectdb_params(keyword_ptr, value_ptr, 1)
            if connection == null:
                _ = rh_pg_dlclose(library)
                return -1
            conn: void& = connection
            if status(conn) != 0:
                finish(conn)
                _ = rh_pg_dlclose(library)
                return -1
            lease_text: mutable darray[u8] = Postgres::rh_pg_decimal(lease_seconds)
            lease_ptr: cstr = (&lease_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(worker_id)
            params.push(now)
            params.push(lease_ptr)
            params.push(target_job_id)
            params.push(target_job_kind)
            param_values: void& = (&params[0]).cast[void&] can Unsafe.PointerCast
            query_result: void&? = exec_params(conn, "SELECT job_id::text, fencing_token::text, lease_expires_at::text FROM public.rh_claim_next_job($1::text, $2::timestamptz, $3::integer, NULLIF($4, '')::uuid, NULLIF($5, '')::text)", 5, null, param_values, null, null, 0)
            result_code: mutable i64 = -1
            if query_result != null:
                result: void& = query_result
                if result_status(result) == RH_PG_TUPLES_OK and fields(result) == 3:
                    row_count: i32 = tuples(result)
                    if row_count == 0:
                        result_code <- 0
                    elif row_count == 1 and is_null(result, 0, 0) == 0 and is_null(result, 0, 1) == 0 and is_null(result, 0, 2) == 0:
                        id_length: i32 = length(result, 0, 0)
                        token_length: i32 = length(result, 0, 1)
                        expiry_length: i32 = length(result, 0, 2)
                        if id_length > 0 and id_length <= 64 and token_length > 0 and token_length <= 20 and expiry_length > 0 and expiry_length <= 128:
                            token_value: cstr = value(result, 0, 1)
                            token_bytes: mutable darray[u8] = []
                            while i < token_length.usize() |i: usize = 0, token_bytes, token_value, token_length|:
                                token_bytes.push(token_value[i])
                                i <- i + 1
                            token_ok: mutable i64 = 0
                            token: i64 = Base::rh_parse_i64(token_bytes, 0, token_bytes.count, &token_ok)
                            if token_ok != 0 and token > 0:
                                id_value: cstr = value(result, 0, 0)
                                while i < id_length.usize() |i: usize = 0, job_id_out, id_value, id_length|:
                                    job_id_out.push(id_value[i])
                                    i <- i + 1
                                job_id_out.push(0)
                                expiry_value: cstr = value(result, 0, 2)
                                while i < expiry_length.usize() |i: usize = 0, lease_expires_at_out, expiry_value, expiry_length|:
                                    lease_expires_at_out.push(expiry_value[i])
                                    i <- i + 1
                                lease_expires_at_out.push(0)
                                fencing_token_out[0] <- token
                                result_code <- 1
                clear(result)
            finish(conn)
            _ = rh_pg_dlclose(library)
            result_code

    public:
        # Claim the highest-priority runnable job in the queue.
        def rh_pg_claim_next_job(conninfo: cstr, worker_id: cstr, now: cstr, lease_seconds: i64, job_id_out: mutable darray[u8]&, fencing_token_out: mutable i64&, lease_expires_at_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            Postgres::rh_pg_claim_job(conninfo, worker_id, now, lease_seconds, "", "", job_id_out, fencing_token_out, lease_expires_at_out)

        # Claim only the named queued/expired collection job. Other queued jobs
        # remain untouched when the requested job is not runnable.
        def rh_pg_claim_collection_job(conninfo: cstr, job_id: cstr, worker_id: cstr, now: cstr, lease_seconds: i64, job_id_out: mutable darray[u8]&, fencing_token_out: mutable i64&, lease_expires_at_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if Base::rh_cstr_len_c(job_id) == 0 or Base::rh_cstr_len_c(job_id) > 64
            Postgres::rh_pg_claim_job(conninfo, worker_id, now, lease_seconds, job_id, "collection", job_id_out, fencing_token_out, lease_expires_at_out)

        # Claim only graph-query work and return its immutable request in the
        # same database function result as the lease token.
        def rh_pg_claim_graph_query_job(conninfo: cstr, worker_id: cstr, now: cstr, lease_seconds: i64, job_id: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if Base::rh_cstr_len_c(worker_id) == 0 or Base::rh_cstr_len_c(worker_id) > 256
            return -1 if lease_seconds <= 0 or lease_seconds > 86400
            return -1 if Base::rh_cstr_len_c(job_id) > 64
            lease_text: mutable darray[u8] = Postgres::rh_pg_decimal(lease_seconds)
            lease_ptr: cstr = (&lease_text[0]).cast[cstr] can Unsafe.PointerCast
            params: mutable darray[cstr] = []
            params.push(worker_id)
            params.push(now)
            params.push(lease_ptr)
            params.push(job_id)
            Postgres::rh_pg_text_params(conninfo, "SELECT public.rh_claim_graph_query_job($1::text, $2::timestamptz, $3::integer, NULLIF($4, '')::uuid)::text", params, out)

        # Read one graph job only inside its declared visibility partition.
        # Missing IDs and mismatched scopes produce the same not_found result.
        def rh_pg_get_graph_query_job(conninfo: cstr, job_id: cstr, visibility_scope: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if Base::rh_cstr_len_c(job_id) != 36
            params: mutable darray[cstr] = []
            params.push(job_id)
            params.push(visibility_scope)
            Postgres::rh_pg_text_params(conninfo, "SELECT public.rh_get_graph_query_job($1::uuid, $2::rh_visibility_scope)::text", params, out)
