# rh_worker.elisa — unattended scheduling pass (M02-03 + M02-06).
#
# The daemon loop is deliberately NOT an infinite loop in this module: an
# unbounded loop is untestable and would violate S012 (bounded work). Instead
# this is the daemon's *decision core* — one deterministic scheduling pass
# that, for a set of configured sources and the current time, decides which
# sources need a full reconcile, which can fetch incrementally, and enqueues
# at most `free_slots` jobs into a bounded queue while respecting the host
# quota (token bucket) and each source's reconcile cadence.
#
# Because the pass is pure over its inputs, replaying it at the same `now`
# with the same source table and queue yields the identical plan. The process
# wrapper only has to call it on a timer.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_job.elisa"
include "./rh_reconcile.elisa"

module Worker:
    public:
        # One configured source: its reconcile cadence and last-known state.
        struct RhSourceJob:
            source_id: mutable i64
            interval_secs: mutable i64
            last_full: mutable i64
            cursor_time: mutable i64
            overlap_secs: mutable i64

        # What the pass decided for one source.
        #   mode 0 = skipped (queue full / quota exhausted)
        #   mode 1 = full reconcile enqueued
        #   mode 2 = incremental enqueued
        struct RhWorkerDecision:
            source_id: mutable i64
            mode: mutable u8
            slot: mutable i64
            horizon_secs: mutable i64
            overlap_start: mutable i64
            debt: mutable i64

        def rh_worker_source(source_id: i64, interval: i64, last_full: i64, cursor_time: i64, overlap: i64) -> RhSourceJob:
            RhSourceJob{source_id: source_id, interval_secs: interval, last_full: last_full, cursor_time: cursor_time, overlap_secs: overlap}

        # Run one scheduling pass. Due full reconciles are considered before any
        # incremental work. Within each priority class, the starting source rotates
        # with `now`, so a bounded queue does not permanently favor the first input
        # row. Jobs are enqueued into `slots` (bounded by its capacity) via the
        # scheduler; skipped sources retain visible reconcile debt for the next tick.
        #
        # This pass only decides *what to enqueue*; it does not claim/lease jobs.
        def rh_worker_pass(sources: darray[RhSourceJob]&, h: mutable Job::RhHost&, slots: mutable darray[Job::RhSlot]&, now: i64, decisions: mutable darray[RhWorkerDecision]&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            return 0 if sources.count == 0
            enqueued: i64 =
                start: usize =
                    remainder: mutable i64 = now % sources.count.i64()
                    if remainder < 0:
                        remainder <- remainder + sources.count.i64()
                    remainder.usize()
                enqueued: mutable i64 = 0
                while offset < sources.count |offset: usize = 0, enqueued, start, now, sources, h, slots, decisions|:
                    i: mutable usize = start + offset
                    if i >= sources.count:
                        i <- i - sources.count
                    s: RhSourceJob = sources[i]
                    if Reconcile::rh_reconcile_due(s.last_full, s.interval_secs, now):
                        horizon: i64 = Reconcile::rh_reconcile_horizon(s.last_full, now)
                        debt: i64 = Reconcile::rh_reconcile_debt(s.last_full, s.interval_secs, now)
                        ovl: i64 = Reconcile::rh_cursor_overlap_start(s.cursor_time, s.overlap_secs)
                        if not Job::rh_sched_host_allow(h, now):
                            decisions.push(RhWorkerDecision{source_id: s.source_id, mode: 0, slot: -1, horizon_secs: horizon, overlap_start: ovl, debt: debt})
                        else:
                            idx: i64 = Job::rh_sched_enqueue(slots, now)
                            if idx < 0:
                                decisions.push(RhWorkerDecision{source_id: s.source_id, mode: 0, slot: -1, horizon_secs: horizon, overlap_start: ovl, debt: debt})
                            else:
                                h.tokens <- h.tokens - 1
                                decisions.push(RhWorkerDecision{source_id: s.source_id, mode: 1, slot: idx, horizon_secs: horizon, overlap_start: ovl, debt: debt})
                                enqueued <- enqueued + 1
                    offset <- offset + 1
                while offset < sources.count |offset: usize = 0, enqueued, start, now, sources, h, slots, decisions|:
                    i: mutable usize = start + offset
                    if i >= sources.count:
                        i <- i - sources.count
                    s: RhSourceJob = sources[i]
                    if not Reconcile::rh_reconcile_due(s.last_full, s.interval_secs, now):
                        horizon: i64 = Reconcile::rh_reconcile_horizon(s.last_full, now)
                        debt: i64 = Reconcile::rh_reconcile_debt(s.last_full, s.interval_secs, now)
                        ovl: i64 = Reconcile::rh_cursor_overlap_start(s.cursor_time, s.overlap_secs)
                        if not Job::rh_sched_host_allow(h, now):
                            decisions.push(RhWorkerDecision{source_id: s.source_id, mode: 0, slot: -1, horizon_secs: horizon, overlap_start: ovl, debt: debt})
                        else:
                            idx: i64 = Job::rh_sched_enqueue(slots, now)
                            if idx < 0:
                                decisions.push(RhWorkerDecision{source_id: s.source_id, mode: 0, slot: -1, horizon_secs: horizon, overlap_start: ovl, debt: debt})
                            else:
                                h.tokens <- h.tokens - 1
                                decisions.push(RhWorkerDecision{source_id: s.source_id, mode: 2, slot: idx, horizon_secs: horizon, overlap_start: ovl, debt: debt})
                                enqueued <- enqueued + 1
                    offset <- offset + 1
                enqueued
            enqueued

        # Aggregate service-health signal: the maximum schedule debt across all
        # sources, and how many sources are overdue. Used by monitoring (M07-11); a
        # nonzero overdue count must surface even when every source was skipped for
        # queue/quota reasons.
        struct RhWorkerHealth:
            max_debt: mutable i64
            overdue: mutable i64
            enqueued: mutable i64
            skipped: mutable i64

        def rh_worker_health(decisions: darray[RhWorkerDecision]&, enqueued: i64) -> RhWorkerHealth:
            maxd, over, skip =
                while i < decisions.count |maxd: i64 = 0, over: i64 = 0, skip: i64 = 0, i: usize = 0| -> maxd, over, skip:
                    d: RhWorkerDecision = decisions[i]
                    if d.debt > maxd:
                        maxd <- d.debt
                    if d.debt > 0:
                        over <- over + 1
                    if d.mode == 0:
                        skip <- skip + 1
                    i <- i + 1
            RhWorkerHealth{max_debt: maxd, overdue: over, enqueued: enqueued, skipped: skip}
