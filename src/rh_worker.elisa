# rh_worker.elisa — unattended scheduling pass (M02-03 + M02-06).
#
# The daemon loop is deliberately NOT an infinite loop in this module: an
# unbounded loop is untestable and would violate S012 (bounded work). Instead
# this is the daemon's *decision core* — one deterministic scheduling pass
# that, for a set of configured sources and the current time, decides which
# sources need a full reconcile, which can fetch incrementally, and enqueues
# at most `free_slots` jobs into a bounded queue while respecting the host
# quota (token bucket) and each source's reconcile cadence.
#
# Because the pass is pure over its inputs, replaying it at the same `now`
# with the same source table and queue yields the identical plan. The process
# wrapper only has to call it on a timer.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_job.elisa"
include "./rh_reconcile.elisa"

# One configured source: its reconcile cadence and last-known state.
struct RhSourceJob:
    source_id: mutable i64
    interval_secs: mutable i64
    last_full: mutable i64
    has_cursor: mutable bool
    cursor_time: mutable i64
    overlap_secs: mutable i64

# What the pass decided for one source.
#   mode 0 = skipped (queue full / quota exhausted)
#   mode 1 = full reconcile enqueued
#   mode 2 = incremental enqueued
struct RhWorkerDecision:
    source_id: mutable i64
    mode: mutable u8
    slot: mutable i64
    horizon_secs: mutable i64
    overlap_start: mutable i64
    debt: mutable i64

def rh_worker_source(source_id: i64, interval: i64, last_full: i64, has_cursor: bool, cursor_time: i64, overlap: i64) -> RhSourceJob:
    return RhSourceJob{source_id: source_id, interval_secs: interval, last_full: last_full, has_cursor: has_cursor, cursor_time: cursor_time, overlap_secs: overlap}

# Run one scheduling pass. `sources` is scanned in the given order; a source
# whose reconcile is due takes priority over an incremental one, and within a
# source the decision is stable. Jobs are enqueued into `slots` (bounded by
# its capacity) via the scheduler; once the queue is full or the host quota
# refuses, remaining sources are recorded as skipped (never silently lost —
# their reconcile debt is still reported, so the next tick retries).
#
# `quota_owner` is the synthetic owner id used for the quota gate; this pass
# only decides *what to enqueue*, it does not claim/lease the jobs.
def rh_worker_pass(sources: darray[RhSourceJob]&, h: mutable RhHost&, slots: mutable darray[RhSlot]&, now: i64, quota_owner: i64, decisions: mutable darray[RhWorkerDecision]&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    enqueued: mutable i64 = 0
    i: mutable usize = 0
    while i < sources.count |i, sources, h, slots, now, quota_owner, decisions, enqueued|:
        s: RhSourceJob = sources[i]
        due: bool = rh_reconcile_due(s.last_full, s.interval_secs, now)
        mode: u8 = rh_reconcile_mode(s.last_full, s.interval_secs, s.has_cursor, now)
        horizon: i64 = rh_reconcile_horizon(s.last_full, now)
        debt: i64 = rh_reconcile_debt(s.last_full, s.interval_secs, now)
        ovl: i64 = rh_cursor_overlap_start(s.cursor_time, s.overlap_secs)
        # Queue full or quota exhausted -> record the source as skipped but
        # keep its debt visible so it is not forgotten.
        if not rh_sched_host_allow(h, now):
            decisions.push(RhWorkerDecision{source_id: s.source_id, mode: 0, slot: -1, horizon_secs: horizon, overlap_start: ovl, debt: debt})
            i <- i + 1
            continue
        idx: i64 = rh_sched_enqueue(slots, now)
        if idx < 0:
            decisions.push(RhWorkerDecision{source_id: s.source_id, mode: 0, slot: -1, horizon_secs: horizon, overlap_start: ovl, debt: debt})
            i <- i + 1
            continue
        # Consume a host token only when a job is actually enqueued.
        h.tokens <- h.tokens - 1
        if due:
            decisions.push(RhWorkerDecision{source_id: s.source_id, mode: 1, slot: idx, horizon_secs: horizon, overlap_start: ovl, debt: debt})
        else:
            decisions.push(RhWorkerDecision{source_id: s.source_id, mode: 2, slot: idx, horizon_secs: horizon, overlap_start: ovl, debt: debt})
        enqueued <- enqueued + 1
        i <- i + 1
    return enqueued

# Aggregate service-health signal: the maximum schedule debt across all
# sources, and how many sources are overdue. Used by monitoring (M07-11); a
# nonzero overdue count must surface even when every source was skipped for
# queue/quota reasons.
struct RhWorkerHealth:
    max_debt: mutable i64
    overdue: mutable i64
    enqueued: mutable i64
    skipped: mutable i64

def rh_worker_health(decisions: darray[RhWorkerDecision]&, enqueued: i64) -> RhWorkerHealth:
    maxd: mutable i64 = 0
    over: mutable i64 = 0
    skip: mutable i64 = 0
    i: mutable usize = 0
    while i < decisions.count |i, decisions, maxd, over, skip|:
        d: RhWorkerDecision = decisions[i]
        if d.debt > maxd:
            maxd <- d.debt
        if d.debt > 0:
            over <- over + 1
        if d.mode == 0:
            skip <- skip + 1
        i <- i + 1
    return RhWorkerHealth{max_debt: maxd, overdue: over, enqueued: enqueued, skipped: skip}
