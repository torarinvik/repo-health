# rh_archive.elisa — bounded source-archive metadata (M08).
#
# This lane records archival identifiers and publisher-declared metadata. It
# never opens, extracts, or executes an archive, and it does not invent
# development history or author identity from a filename.

include "./rh_base.elisa"
include "./rh_json.elisa"

module Archive:
    public:
        const RH_ARCHIVE_MAX_BYTES: usize = 4194304
        const RH_ARCHIVE_MAX_ITEMS: i64 = 10000

        struct RhArchiveItem:
            identifier_s: mutable i64
            identifier_e: mutable i64
            kind_s: mutable i64
            kind_e: mutable i64
            format_s: mutable i64
            format_e: mutable i64
            uri_s: mutable i64
            uri_e: mutable i64
            digest_s: mutable i64
            digest_e: mutable i64
            has_digest: mutable bool
            has_published: mutable bool
            published_at: mutable i64
            has_size: mutable bool
            size: mutable i64

    private:
        def rh_archive_eq(texts: darray[u8]&, s: i64, e: i64, literal: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_bytes_equal_literal(texts, s, e, literal)

        def rh_archive_prefix(texts: darray[u8]&, s: i64, e: i64, prefix: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: i64 = strlen(prefix).i64()
            e - s >= n and Archive::rh_archive_eq(texts, s, s + n, prefix)

        def rh_archive_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, start_out: mutable i64&, end_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return false if idx < 0
            return false if not Json::rh_json_str_span(nodes, idx, start_out, end_out)
            start_out[0] < end_out[0]

        def rh_archive_optional_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, has_out: mutable i64&, value_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            has_out[0] <- 0
            value_out[0] <- 0
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return true if idx < 0
            return true if nodes[idx.usize()].kind == Json::RH_JSON_NULL
            ok: mutable i64 = 0
            value: i64 = Json::rh_json_int(nodes, raw, idx, &ok)
            return false if ok == 0 or value < 0
            has_out[0] <- 1
            value_out[0] <- value
            true

        def rh_archive_valid_kind(texts: darray[u8]&, s: i64, e: i64) -> bool:
            Archive::rh_archive_eq(texts, s, e, "source") or Archive::rh_archive_eq(texts, s, e, "snapshot") or Archive::rh_archive_eq(texts, s, e, "binary")

        def rh_archive_valid_format(texts: darray[u8]&, s: i64, e: i64) -> bool:
            Archive::rh_archive_eq(texts, s, e, "tar") or Archive::rh_archive_eq(texts, s, e, "tar.gz") or Archive::rh_archive_eq(texts, s, e, "tar.bz2") or Archive::rh_archive_eq(texts, s, e, "tar.xz") or Archive::rh_archive_eq(texts, s, e, "zip")

        def rh_archive_valid_digest(texts: darray[u8]&, s: i64, e: i64) -> bool:
            return false if e - s != 71 or not Archive::rh_archive_prefix(texts, s, e, "sha256:")
            while i < e |i: i64 = s + 7, texts|:
                b: u8 = texts[i.usize()]
                return false if not ((b >= 48 and b <= 57) or (b >= 65 and b <= 70) or (b >= 97 and b <= 102))
                i <- i + 1
            true

        def rh_archive_duplicate(items: darray[RhArchiveItem]&, texts: darray[u8]&, s: i64, e: i64) -> bool:
            while i < items.count.i64() |i: i64 = 0, items, texts, s, e|:
                item: RhArchiveItem = items[i.usize()]
                return true if rh_bytes_equal_span(texts, s, e, texts, item.identifier_s, item.identifier_e)
                i <- i + 1
            false

        def rh_archive_parse(raw: darray[u8]&, items: mutable darray[RhArchiveItem]&, texts: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if raw.count > RH_ARCHIVE_MAX_BYTES
            nodes: mutable darray[Json::RhJsonNode] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
            schema_s: mutable i64 = 0
            schema_e: mutable i64 = 0
            return -1 if schema_idx < 0 or not Json::rh_json_str_span(nodes, schema_idx, &schema_s, &schema_e) or not Archive::rh_archive_eq(texts, schema_s, schema_e, "rh-archive-input/1")
            array_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "archives")
            return -1 if array_idx < 0 or nodes[array_idx.usize()].kind != Json::RH_JSON_ARR
            array: Json::RhJsonNode = nodes[array_idx.usize()]
            return -1 if array.child_count > RH_ARCHIVE_MAX_ITEMS
            while child >= 0 |child: i64 = array.first_child, nodes, texts, raw, items|:
                return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                identifier_s: mutable i64 = 0
                identifier_e: mutable i64 = 0
                kind_s: mutable i64 = 0
                kind_e: mutable i64 = 0
                format_s: mutable i64 = 0
                format_e: mutable i64 = 0
                uri_s: mutable i64 = 0
                uri_e: mutable i64 = 0
                return -1 if not Archive::rh_archive_str(nodes, texts, child, "identifier", &identifier_s, &identifier_e)
                return -1 if Archive::rh_archive_duplicate(items, texts, identifier_s, identifier_e)
                return -1 if not Archive::rh_archive_str(nodes, texts, child, "kind", &kind_s, &kind_e) or not Archive::rh_archive_valid_kind(texts, kind_s, kind_e)
                return -1 if not Archive::rh_archive_str(nodes, texts, child, "format", &format_s, &format_e) or not Archive::rh_archive_valid_format(texts, format_s, format_e)
                return -1 if not Archive::rh_archive_str(nodes, texts, child, "uri", &uri_s, &uri_e) or not (Archive::rh_archive_prefix(texts, uri_s, uri_e, "https://") or Archive::rh_archive_prefix(texts, uri_s, uri_e, "file://"))
                digest_s: mutable i64 = 0
                digest_e: mutable i64 = 0
                has_digest: mutable bool = false
                digest_idx: i64 = Json::rh_json_obj_get(nodes, texts, child, "digest")
                if digest_idx >= 0 and nodes[digest_idx.usize()].kind != Json::RH_JSON_NULL:
                    return -1 if not Json::rh_json_str_span(nodes, digest_idx, &digest_s, &digest_e) or not Archive::rh_archive_valid_digest(texts, digest_s, digest_e)
                    has_digest <- true
                has_published: mutable i64 = 0
                published_at: mutable i64 = 0
                return -1 if not Archive::rh_archive_optional_int(nodes, raw, texts, child, "published_at", &has_published, &published_at)
                has_size: mutable i64 = 0
                size: mutable i64 = 0
                return -1 if not Archive::rh_archive_optional_int(nodes, raw, texts, child, "size", &has_size, &size)
                items.push(RhArchiveItem{identifier_s: identifier_s, identifier_e: identifier_e, kind_s: kind_s, kind_e: kind_e, format_s: format_s, format_e: format_e, uri_s: uri_s, uri_e: uri_e, digest_s: digest_s, digest_e: digest_e, has_digest: has_digest, has_published: has_published == 1, published_at: published_at, has_size: has_size == 1, size: size})
                child <- nodes[child.usize()].next_sibling
            items.count.i64()

        def rh_archive_emit_optional_text(out: mutable darray[u8]&, texts: darray[u8]&, has_value: bool, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if has_value:
                out.push(34)
                rh_json_escape(out, texts, s.usize(), e.usize())
                out.push(34)
            else:
                rh_push_text(out, "null")

    public:
        def rh_archive_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            items: mutable darray[RhArchiveItem] = []
            texts: mutable darray[u8] = []
            return -1 if Archive::rh_archive_parse(raw, items, texts) < 0
            digest_count: mutable i64 = 0
            published_count: mutable i64 = 0
            while i < items.count.i64() |i: i64 = 0, items, digest_count, published_count|:
                item: RhArchiveItem = items[i.usize()]
                digest_count <- digest_count + 1 if item.has_digest
                published_count <- published_count + 1 if item.has_published
                i <- i + 1
            rh_push_text(out, "{\"schema\":\"rh-archive-result/1\",\"archives\":[")
            while i < items.count.i64() |i: i64 = 0, items, texts, out|:
                item: RhArchiveItem = items[i.usize()]
                out.push(44) if i > 0
                rh_push_text(out, "{\"identifier\":\"")
                rh_json_escape(out, texts, item.identifier_s.usize(), item.identifier_e.usize())
                rh_push_text(out, "\",\"kind\":\"")
                rh_json_escape(out, texts, item.kind_s.usize(), item.kind_e.usize())
                rh_push_text(out, "\",\"format\":\"")
                rh_json_escape(out, texts, item.format_s.usize(), item.format_e.usize())
                rh_push_text(out, "\",\"uri\":\"")
                rh_json_escape(out, texts, item.uri_s.usize(), item.uri_e.usize())
                rh_push_text(out, "\",\"digest\":")
                Archive::rh_archive_emit_optional_text(out, texts, item.has_digest, item.digest_s, item.digest_e)
                rh_push_text(out, ",\"published_at\":")
                rh_push_decimal_i64(out, item.published_at) if item.has_published
                rh_push_text(out, "null") if not item.has_published
                rh_push_text(out, ",\"size\":")
                rh_push_decimal_i64(out, item.size) if item.has_size
                rh_push_text(out, "null") if not item.has_size
                rh_push_text(out, "}")
                i <- i + 1
            rh_push_text(out, "],\"counts\":{\"archives\":")
            rh_push_decimal_i64(out, items.count.i64())
            rh_push_text(out, ",\"digest_known\":")
            rh_push_decimal_i64(out, digest_count)
            rh_push_text(out, ",\"published_known\":")
            rh_push_decimal_i64(out, published_count)
            rh_push_text(out, "},\"source\":{\"history_supported\":false,\"identity_supported\":false,\"extraction_supported\":false},\"note\":\"archive metadata is an observation; identifiers, links, declared digests, times, and sizes are retained; archive bytes are never extracted or executed; no development history or author identity is inferred\"}")
            0
