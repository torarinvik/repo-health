# Field transformation contract for the non-forge ecosyste.ms package adapter.
include "./rh_base.elisa"

module EcosystemLookupTransformation:
    public:
        def rh_ecosystem_lookup_transformation_report(configuration_sha: darray[u8]&, input_sha: darray[u8]&, output_sha: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"ecosyste.ms-package-lookup\",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-ecosystem-lookup-result/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"id\",\"target\":\"results[].provider_id\",\"state\":\"transformed\"},{\"source\":\"name|ecosystem\",\"target\":\"results[].name|ecosystem\",\"state\":\"preserved\"},{\"source\":\"latest_release_number|latest_release_published_at\",\"target\":\"results[].version|published_at\",\"state\":\"preserved\"},{\"source\":\"repository_url|homepage|manifest_url|versions_count\",\"target\":\"results[].repository|homepage|manifest|versions_count\",\"state\":\"preserved\"},{\"source\":\"candidate with nonmatching package coordinate\",\"target\":\"results[]\",\"state\":\"discarded\"},{\"source\":\"provider fields outside allowlist\",\"target\":\"lookup result\",\"state\":\"discarded\"}]}")
