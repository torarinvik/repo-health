# rh_forge_events_fetch.elisa — bounded GitHub workflow acquisition (M02-05).

include "./rh_base.elisa"
include "./rh_forge_events.elisa"
include "./rh_git.elisa"
include "./rh_json.elisa"
include "./rh_roles_provider.elisa"

module ForgeEventsFetch:
    private:
        const RH_FEF_PAGE_SIZE: i64 = 100
        const RH_FEF_MAX_CAPTURE_BYTES: i64 = 3145728
        const RH_FEF_MAX_PAGES: i64 = 10

        def rh_fef_component_char(byte: u8) -> bool:
            (byte >= 48 and byte <= 57) or (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122) or byte == 45 or byte == 46 or byte == 95

        def rh_fef_repository_valid(repository: cstr) -> bool can[Memory.Allocate, Abort.Panic]:
            length: usize = Base::rh_cstr_len_c(repository)
            return false if length < 3 or length > 201
            slash: mutable usize = length
            while index < length |index: usize = 0, repository, slash|:
                byte: u8 = repository[index]
                if byte == 47:
                    return false if slash != length
                    slash <- index
                else:
                    return false if not ForgeEventsFetch::rh_fef_component_char(byte)
                index <- index + 1
            return false if slash == 0 or slash + 1 >= length
            owner_dot: bool = slash == 1 and repository[0] == 46
            owner_dotdot: bool = slash == 2 and repository[0] == 46 and repository[1] == 46
            repo_dot: bool = slash + 2 == length and repository[slash + 1] == 46
            repo_dotdot: bool = slash + 3 == length and repository[slash + 1] == 46 and repository[slash + 2] == 46
            not owner_dot and not owner_dotdot and not repo_dot and not repo_dotdot

        def rh_fef_whitespace(byte: u8) -> bool:
            byte == 32 or byte == 9 or byte == 10 or byte == 13

        def rh_fef_append_page(raw: darray[u8]&, records: mutable darray[u8]&, item_total: mutable i64&, byte_total: mutable i64&, page_items_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Memory.Release, Unsafe.PointerCast]:
            return false if raw.count == 0 or byte_total[0] + raw.count.i64() > RH_FEF_MAX_CAPTURE_BYTES
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return false if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_ARR or nodes[root.usize()].child_count > RH_FEF_PAGE_SIZE
            first, last =
                first: mutable usize = 0
                last: mutable usize = raw.count
                while first < last |first, raw|:
                    break if not ForgeEventsFetch::rh_fef_whitespace(raw[first])
                    first <- first + 1
                while last > first |last, raw|:
                    break if not ForgeEventsFetch::rh_fef_whitespace(raw[last - 1])
                    last <- last - 1
                first, last
            return false if last - first < 2 or raw[first] != 91 or raw[last - 1] != 93
            page_items_out[0] <- nodes[root.usize()].child_count
            if page_items_out[0] > 0:
                inner_start: usize = first + 1
                inner_end: usize = last - 1
                inner_length: usize = inner_end - inner_start
                records.push(44) if item_total[0] > 0
                raw_ptr: u8& = (&raw[inner_start]).cast[u8&] can Unsafe.PointerCast
                Base::rh_push_raw(records, raw_ptr, inner_length)
                item_total[0] <- item_total[0] + page_items_out[0]
            byte_total[0] <- byte_total[0] + raw.count.i64()
            true

        def rh_fef_path(base: cstr, capability: cstr, page: i64, suffix: u8&) -> mutable darray[u8] can[Memory.Allocate, Abort.Panic]:
            path: mutable darray[u8] = []
            Base::rh_push_cstr(path, base)
            Base::rh_push_text(path, ".github-")
            Base::rh_push_cstr(path, capability)
            Base::rh_push_text(path, "-page-")
            Base::rh_push_decimal_i64(path, page)
            Base::rh_push_text(path, suffix)
            path.push(0)
            path

        def rh_fef_http_200(status: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            status.count == 3 and status[0] == 50 and status[1] == 48 and status[2] == 48

        def rh_fef_fetch_pages_from(repository: cstr, endpoint: cstr, capability: cstr, start_page: i64, max_pages: i64, evidence_base: cstr, records: mutable darray[u8]&, item_total: mutable i64&, byte_total: mutable i64&, complete_out: mutable i64&, next_page_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return false if start_page < 1 or max_pages < 1 or start_page > 2147483640 or max_pages > RH_FEF_MAX_PAGES
            last_page: i64 = start_page + max_pages - 1
            return false if last_page < start_page
            page_number: mutable i64 = start_page
            pages_fetched: mutable i64 = 0
            complete: mutable bool = false
            while page_number <= last_page and not complete |page_number, last_page, pages_fetched, complete, records, item_total, byte_total, repository, endpoint, capability, evidence_base|:
                url: mutable darray[u8] = []
                Base::rh_push_text(url, "https://api.github.com/repos/")
                Base::rh_push_cstr(url, repository)
                Base::rh_push_text(url, "/")
                Base::rh_push_cstr(url, endpoint)
                Base::rh_push_decimal_i64(url, page_number)
                url.push(0)
                url_ptr: cstr = (&url[0]).cast[cstr] can Unsafe.PointerCast
                page_path: mutable darray[u8] = ForgeEventsFetch::rh_fef_path(evidence_base, capability, page_number, ".json")
                status_path: mutable darray[u8] = ForgeEventsFetch::rh_fef_path(evidence_base, capability, page_number, ".status")
                error_path: mutable darray[u8] = ForgeEventsFetch::rh_fef_path(evidence_base, capability, page_number, ".err")
                url_path: mutable darray[u8] = ForgeEventsFetch::rh_fef_path(evidence_base, capability, page_number, ".url")
                page_ptr: cstr = (&page_path[0]).cast[cstr] can Unsafe.PointerCast
                status_ptr: cstr = (&status_path[0]).cast[cstr] can Unsafe.PointerCast
                error_ptr: cstr = (&error_path[0]).cast[cstr] can Unsafe.PointerCast
                url_file_ptr: cstr = (&url_path[0]).cast[cstr] can Unsafe.PointerCast
                url_evidence: mutable darray[u8] = []
                Base::rh_push_cstr(url_evidence, url_ptr)
                url_evidence.push(10)
                return false if not Base::rh_io_write(url_file_ptr, url_evidence)
                return false if Git::rh_run_github_api_get(url_ptr, page_ptr, status_ptr, error_ptr) != 0
                status: mutable darray[u8] = []
                return false if Base::rh_io_read(status_ptr, status) < 0 or not ForgeEventsFetch::rh_fef_http_200(status)
                raw: mutable darray[u8] = []
                return false if Base::rh_io_read(page_ptr, raw) < 0
                page_items: mutable i64 = 0
                return false if not ForgeEventsFetch::rh_fef_append_page(raw, records, &item_total[0], &byte_total[0], &page_items)
                pages_fetched <- pages_fetched + 1
                if page_items < RH_FEF_PAGE_SIZE:
                    complete <- true
                else:
                    page_number <- page_number + 1
            complete_out[0] <- 1 if complete else 0
            next_page_out[0] <- page_number
            pages_fetched > 0

        def rh_fef_fetch_pages(repository: cstr, endpoint: cstr, capability: cstr, max_pages: i64, evidence_base: cstr, records: mutable darray[u8]&, item_total: mutable i64&, byte_total: mutable i64&, complete_out: mutable i64&, next_page_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            ForgeEventsFetch::rh_fef_fetch_pages_from(repository, endpoint, capability, 1, max_pages, evidence_base, records, &item_total[0], &byte_total[0], &complete_out[0], &next_page_out[0])

        def rh_fef_push_pagination(out: mutable darray[u8]&, complete: bool, next_page: i64) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"next\":")
            if complete:
                Base::rh_push_text(out, "null,\"complete\":true}")
            else:
                out.push(34)
                Base::rh_push_text(out, "page=")
                Base::rh_push_decimal_i64(out, next_page)
                Base::rh_push_text(out, "\",\"complete\":false}")

    public:
        # Fetch GitHub issues, pulls, and published-release pages from fixed API routes.
        # The numeric page sequence and page cap avoid following arbitrary Link
        # URLs. Raw response, URL, status, and stderr evidence stay beside output.
        def rh_forge_events_github_live(repository: cstr, max_pages: i64, evidence_base: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if not ForgeEventsFetch::rh_fef_repository_valid(repository) or max_pages < 1 or max_pages > RH_FEF_MAX_PAGES or not Git::rh_arg_safe(evidence_base)
            issues: mutable darray[u8] = []
            proposals: mutable darray[u8] = []
            releases: mutable darray[u8] = []
            issues_total: mutable i64 = 0
            proposals_total: mutable i64 = 0
            releases_total: mutable i64 = 0
            byte_total: mutable i64 = 0
            issues_complete: mutable i64 = 0
            proposals_complete: mutable i64 = 0
            releases_complete: mutable i64 = 0
            issues_next_page: mutable i64 = 1
            proposals_next_page: mutable i64 = 1
            releases_next_page: mutable i64 = 1
            return -1 if not ForgeEventsFetch::rh_fef_fetch_pages(repository, "issues?state=all&sort=updated&direction=desc&per_page=100&page=", "issues", max_pages, evidence_base, issues, &issues_total, &byte_total, &issues_complete, &issues_next_page)
            return -1 if not ForgeEventsFetch::rh_fef_fetch_pages(repository, "pulls?state=all&sort=updated&direction=desc&per_page=100&page=", "pulls", max_pages, evidence_base, proposals, &proposals_total, &byte_total, &proposals_complete, &proposals_next_page)
            return -1 if not ForgeEventsFetch::rh_fef_fetch_pages(repository, "releases?per_page=100&page=", "releases", max_pages, evidence_base, releases, &releases_total, &byte_total, &releases_complete, &releases_next_page)
            captured_at: i64 = Base::rh_now()
            return -1 if captured_at < 0
            token: u8&? = getenv("RH_GITHUB_TOKEN")
            capture: mutable darray[u8] = []
            Base::rh_push_text(capture, "{\"schema\":\"rh-forge-events-input/1\",\"provider\":\"github\",\"captured_at\":")
            Base::rh_push_decimal_i64(capture, captured_at)
            Base::rh_push_text(capture, ",\"authorization\":{\"state\":\"")
            Base::rh_push_text(capture, "authorized" if token != null else "not_requested")
            Base::rh_push_text(capture, "\"},\"capability_states\":{\"reviews\":\"not_attempted\"},\"issues\":[")
            capture.extend(bytes_view(issues))
            Base::rh_push_text(capture, "],\"proposals\":[")
            capture.extend(bytes_view(proposals))
            Base::rh_push_text(capture, "],\"releases\":[")
            capture.extend(bytes_view(releases))
            Base::rh_push_text(capture, "],\"pagination\":{\"issues\":")
            ForgeEventsFetch::rh_fef_push_pagination(capture, issues_complete == 1, issues_next_page)
            Base::rh_push_text(capture, ",\"proposals\":")
            ForgeEventsFetch::rh_fef_push_pagination(capture, proposals_complete == 1, proposals_next_page)
            Base::rh_push_text(capture, ",\"reviews\":{\"next\":null,\"complete\":false},\"releases\":")
            ForgeEventsFetch::rh_fef_push_pagination(capture, releases_complete == 1, releases_next_page)
            Base::rh_push_text(capture, "}}")
            ForgeEvents::rh_forge_events_report(capture, out)

        # Reviews are listed under one pull request. Keep the requested scope in
        # the result instead of implying a repository-wide review snapshot.
        def rh_forge_events_github_reviews_live(repository: cstr, pull_request: i64, start_page: i64, max_pages: i64, evidence_base: cstr, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if not ForgeEventsFetch::rh_fef_repository_valid(repository) or pull_request < 1 or start_page < 1 or start_page > 2147483640 or max_pages < 1 or max_pages > RH_FEF_MAX_PAGES or not Git::rh_arg_safe(evidence_base)
            endpoint: mutable darray[u8] = []
            Base::rh_push_text(endpoint, "pulls/")
            Base::rh_push_decimal_i64(endpoint, pull_request)
            Base::rh_push_text(endpoint, "/reviews?per_page=100&page=")
            endpoint.push(0)
            endpoint_ptr: cstr = (&endpoint[0]).cast[cstr] can Unsafe.PointerCast
            capability: mutable darray[u8] = []
            Base::rh_push_text(capability, "reviews-pr-")
            Base::rh_push_decimal_i64(capability, pull_request)
            capability.push(0)
            capability_ptr: cstr = (&capability[0]).cast[cstr] can Unsafe.PointerCast
            reviews: mutable darray[u8] = []
            review_total: mutable i64 = 0
            byte_total: mutable i64 = 0
            complete: mutable i64 = 0
            next_page: mutable i64 = 1
            return -1 if not ForgeEventsFetch::rh_fef_fetch_pages_from(repository, endpoint_ptr, capability_ptr, start_page, max_pages, evidence_base, reviews, &review_total, &byte_total, &complete, &next_page)
            captured_at: i64 = Base::rh_now()
            return -1 if captured_at < 0
            token: u8&? = getenv("RH_GITHUB_TOKEN")
            capture: mutable darray[u8] = []
            Base::rh_push_text(capture, "{\"schema\":\"rh-forge-events-input/1\",\"provider\":\"github\",\"captured_at\":")
            Base::rh_push_decimal_i64(capture, captured_at)
            Base::rh_push_text(capture, ",\"authorization\":{\"state\":\"")
            Base::rh_push_text(capture, "authorized" if token != null else "not_requested")
            Base::rh_push_text(capture, "\"},\"scope\":{\"pull_request\":")
            Base::rh_push_decimal_i64(capture, pull_request)
            Base::rh_push_text(capture, "},\"capability_states\":{\"issues\":\"not_attempted\",\"proposals\":\"not_attempted\",\"releases\":\"not_attempted\"},\"reviews\":[")
            capture.extend(bytes_view(reviews))
            Base::rh_push_text(capture, "],\"pagination\":{\"issues\":{\"next\":null,\"complete\":false},\"proposals\":{\"next\":null,\"complete\":false},\"reviews\":")
            ForgeEventsFetch::rh_fef_push_pagination(capture, complete == 1, next_page)
            Base::rh_push_text(capture, ",\"releases\":{\"next\":null,\"complete\":false}}}")
            ForgeEvents::rh_forge_events_report(capture, out)

        # The collaborators route is permission-bearing and requires an
        # explicit token. Keep the returned repository scope and page completeness
        # attached to the normalized role input.
        def rh_roles_github_live(repository: cstr, max_pages: i64, evidence_base: cstr, previous: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            return -1 if not ForgeEventsFetch::rh_fef_repository_valid(repository) or max_pages < 1 or max_pages > RH_FEF_MAX_PAGES or not Git::rh_arg_safe(evidence_base)
            token: u8&? = getenv("RH_GITHUB_TOKEN")
            return -1 if token == null
            token_ptr: cstr = token.cast[cstr] can Unsafe.PointerCast
            return -1 if Base::rh_cstr_len_c(token_ptr) == 0
            start_page: mutable i64 = 1
            previous_pages: mutable i64 = 0
            if previous.count > 0:
                return -1 if RolesProvider::rh_roles_provider_next_page(previous, repository, &start_page, &previous_pages) != 0
            members: mutable darray[u8] = []
            member_total: mutable i64 = 0
            byte_total: mutable i64 = 0
            complete: mutable i64 = 0
            next_page: mutable i64 = 1
            return -1 if not ForgeEventsFetch::rh_fef_fetch_pages_from(repository, "collaborators?affiliation=all&per_page=100&page=", "collaborators", start_page, max_pages, evidence_base, members, &member_total, &byte_total, &complete, &next_page)
            captured_at: i64 = Base::rh_now()
            return -1 if captured_at < 0
            capture: mutable darray[u8] = []
            Base::rh_push_text(capture, "{\"schema\":\"rh-provider-roles-input/1\",\"provider\":\"github\",\"captured_at\":")
            Base::rh_push_decimal_i64(capture, captured_at)
            Base::rh_push_text(capture, ",\"authorization\":{\"state\":\"authorized\"},\"scope\":{\"repository\":\"")
            Base::rh_push_cstr(capture, repository)
            Base::rh_push_text(capture, "\"},\"members\":[")
            capture.extend(bytes_view(members))
            Base::rh_push_text(capture, "],\"pagination\":")
            ForgeEventsFetch::rh_fef_push_pagination(capture, complete == 1, next_page)
            segment_pages: i64 = next_page - start_page + (1 if complete == 1 else 0)
            return -1 if segment_pages < 1 or segment_pages > max_pages
            pages_fetched: i64 = previous_pages + segment_pages
            Base::rh_push_text(capture, ",\"pages_fetched\":")
            Base::rh_push_decimal_i64(capture, pages_fetched)
            capture.push(125)
            if previous.count > 0:
                latest: mutable darray[u8] = []
                return -1 if RolesProvider::rh_roles_provider_import(capture, latest) != 0
                return RolesProvider::rh_roles_provider_merge(previous, latest, repository, out)
            RolesProvider::rh_roles_provider_import(capture, out)
