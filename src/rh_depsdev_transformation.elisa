# Field transformation contract for the deps.dev version adapter.
include "./rh_base.elisa"

module DepsDevTransformation:
    public:
        def rh_depsdev_transformation_report(configuration_sha: darray[u8]&,
                                             input_sha: darray[u8]&,
                                             output_sha: darray[u8]&,
                                             out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"deps.dev-version\",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-depsdev-enrichment/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"name|version\",\"target\":\"package.name|package.version\",\"state\":\"preserved\"},{\"source\":\"system\",\"target\":\"package.system\",\"state\":\"transformed\"},{\"source\":\"publishedAt\",\"target\":\"package.published_at\",\"state\":\"transformed\"},{\"source\":\"dependencyCount\",\"target\":\"dependency_count\",\"state\":\"preserved\"},{\"source\":\"advisoryKeys[]\",\"target\":\"advisory_keys[]\",\"state\":\"preserved\"},{\"source\":\"missing optional provider fields\",\"target\":\"coverage and null values\",\"state\":\"unknown\"},{\"source\":\"provider fields outside adapter contract\",\"target\":\"enrichment result\",\"state\":\"discarded\"}]}")
