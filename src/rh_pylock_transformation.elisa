# Field transformation contract for the PEP 751 audit projection.
include "./rh_base.elisa"

module PylockTransformation:
    public:
        def rh_pylock_transformation_report(configuration_sha: darray[u8]&, input_sha: darray[u8]&,
                                            output_sha: darray[u8]&,
                                            out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"pep751-lock-audit\",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-pylock-audit/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"package names and versions\",\"target\":\"packages[].name|version\",\"state\":\"preserved\"},{\"source\":\"environment and dependency-group markers\",\"target\":\"environments|extras|dependency_groups\",\"state\":\"preserved\"},{\"source\":\"dependency declarations\",\"target\":\"packages[].dependencies[]\",\"state\":\"transformed\"},{\"source\":\"artifact paths and upload times\",\"target\":\"artifacts[]\",\"state\":\"transformed\"},{\"source\":\"root relation absent from lock\",\"target\":\"root_relationship\",\"state\":\"unknown\"},{\"source\":\"unsupported source metadata\",\"target\":\"audit projection\",\"state\":\"discarded\"}]}")
