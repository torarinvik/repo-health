# rh_vcs_hg.elisa — Mercurial adapter (M08 native-VCS lane).
#
# Input is the documented machine format of `hg log -Tjson`: a JSON array
# of objects with fields node, rev, user, date=[utc, tzoffset_seconds],
# desc, branch, tags, phase, parents. This module only PARSES and
# NORMALIZES; it never invents a Git hash and never treats a Mercurial
# node as a Git revision. Native node ids are preserved verbatim.
#
# Honest scope: integer `rev` is a local, repository-relative
# counter and is NOT a global/durable identity — only `node` is. Tags are
# tags, not releases. The author string is raw identity evidence, not an
# account and not a person. Fields the format does not support (reviews,
# proposals, traffic) stay unsupported in the capability manifest.
include "./rh_base.elisa"
include "./rh_json.elisa"

module Mercurial:
    private:
        const RH_HG_NODE_HEX: i64 = 40
        const RH_HG_MAX_CHANGES_DEFAULT: i64 = 20000

    public:
        const RH_HG_PHASE_UNKNOWN: u8 = 0
        const RH_HG_PHASE_PUBLIC: u8 = 1
        const RH_HG_PHASE_DRAFT: u8 = 2
        const RH_HG_PHASE_SECRET: u8 = 3

        # One normalized change. Spans index into the returned RhHgLog pool.
        struct RhHgChange:
            node_s: i64
            node_e: i64
            rev: i64
            author_s: i64
            author_e: i64
            desc_s: i64
            desc_e: i64
            utc: i64
            tz_offset: i64
            has_date: bool
            branch_s: i64
            branch_e: i64
            tag_count: i64
            phase: u8

    private:
        struct RhHgTimestamp:
            utc: i64
            tz_offset: i64
            present: bool

        struct RhHgRow:
            usable: bool
            change: RhHgChange

    public:
        struct RhHgLog:
            ok: bool
            changes: mutable darray[RhHgChange]
            pool: mutable darray[u8]
            rejected: i64

        def rh_hg_phase_label(phase: u8) -> u8&:
            return "public" if phase == RH_HG_PHASE_PUBLIC
            return "draft" if phase == RH_HG_PHASE_DRAFT
            return "secret" if phase == RH_HG_PHASE_SECRET
            "unknown"

        def rh_hg_is_node_hex(texts: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e < s or e - s != RH_HG_NODE_HEX
            while i < e |valid: bool = true, i: i64 = s, e, texts| -> valid:
                b: u8 = texts[i.usize()]
                break false if not ((b >= 48 and b <= 57) or (b >= 97 and b <= 102))
                i <- i + 1

        # Parse hg log -Tjson into one value. max_changes <= 0 means default.
        def rh_hg_parse(raw: darray[u8]&, max_changes: i64) -> RhHgLog can[Memory.Allocate, Abort.Panic]:
            cap: i64 = RH_HG_MAX_CHANGES_DEFAULT if max_changes <= 0 else max_changes
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            changes: mutable darray[RhHgChange] = []
            pool: mutable darray[u8] = []
            return RhHgLog{ok: false, changes: changes, pool: pool, rejected: 0} if root < 0
            rn: Json::RhJsonNode = nodes[root.usize()]
            return RhHgLog{ok: false, changes: changes, pool: pool, rejected: 0} if rn.kind != Json::RH_JSON_ARR
            over, rejected =
                while child >= 0 |over: bool = false, rejected: i64 = 0, child: i64 = rn.first_child, raw, nodes, texts, pool, changes, cap| -> over, rejected:
                    break if over
                    nxt: i64 = nodes[child.usize()].next_sibling
                    if changes.count.i64() >= cap:
                        over <- true
                    else:
                        parsed: RhHgRow = rh_hg_one(raw, nodes, texts, pool, child)
                        if parsed.usable:
                            changes.push(parsed.change)
                        else:
                            rejected <- rejected + 1
                    child <- nxt
            return RhHgLog{ok: false, changes: changes, pool: pool, rejected: rejected} if over
            RhHgLog{ok: true, changes: changes, pool: pool, rejected: rejected}

    private:
        def rh_hg_phase_of(texts: darray[u8]&, s: i64, e: i64) -> u8 can[Memory.Allocate, Abort.Panic]:
            return RH_HG_PHASE_UNKNOWN if s < 0 or e < s
            n: i64 = e - s
            return RH_HG_PHASE_PUBLIC if n == 6 and Base::rh_bytes_equal_literal(texts, s, e, "public")
            return RH_HG_PHASE_DRAFT if n == 5 and Base::rh_bytes_equal_literal(texts, s, e, "draft")
            return RH_HG_PHASE_SECRET if n == 6 and Base::rh_bytes_equal_literal(texts, s, e, "secret")
            RH_HG_PHASE_UNKNOWN

        # (private to this file)
        def rh_hg_arr_count(nodes: darray[Json::RhJsonNode]&, arr: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if arr < 0
            o: Json::RhJsonNode = nodes[arr.usize()]
            return 0 if o.kind != Json::RH_JSON_ARR
            o.child_count

        # Extract one change object. Rows with missing or malformed native nodes
        # are unusable and counted as rejected by the enclosing log parser.
        def rh_hg_one(raw: darray[u8]&, nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, pool: mutable darray[u8]&, obj: i64) -> RhHgRow can[Memory.Allocate, Abort.Panic]:
            ns, ne =
                start: mutable i64 = -1
                end: mutable i64 = -1
                _ = Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, obj, "node"), &start, &end)
                start, end
            empty: RhHgChange = RhHgChange{node_s: -1, node_e: -1, rev: -1, author_s: -1, author_e: -1, desc_s: -1, desc_e: -1, utc: -1, tz_offset: -1, has_date: false, branch_s: -1, branch_e: -1, tag_count: 0, phase: RH_HG_PHASE_UNKNOWN}
            return RhHgRow{usable: false, change: empty} if not rh_hg_is_node_hex(texts, ns, ne)
            node_s: i64 = Base::rh_absorb_span(texts, ns, ne, pool)
            node_e: i64 = node_s + (ne - ns)
            rev: i64 =
                valid: mutable i64 = 0
                value: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, obj, "rev"), &valid)
                value if valid == 1 else -1
            aus, aue =
                start: mutable i64 = -1
                end: mutable i64 = -1
                _ = Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, obj, "user"), &start, &end)
                start, end
            author_s: i64 = Base::rh_absorb_span(texts, aus, aue, pool)
            author_e: i64 = author_s + (aue - aus) if author_s >= 0 else -1
            ds, de =
                start: mutable i64 = -1
                end: mutable i64 = -1
                _ = Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, obj, "desc"), &start, &end)
                start, end
            desc_s: i64 = Base::rh_absorb_span(texts, ds, de, pool)
            desc_e: i64 = desc_s + (de - ds) if desc_s >= 0 else -1
            bs, be =
                start: mutable i64 = -1
                end: mutable i64 = -1
                _ = Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, obj, "branch"), &start, &end)
                start, end
            branch_s: i64 = Base::rh_absorb_span(texts, bs, be, pool)
            branch_e: i64 = branch_s + (be - bs) if branch_s >= 0 else -1
            timestamp: RhHgTimestamp =
                date_arr: i64 = Json::rh_json_obj_get(nodes, texts, obj, "date")
                if date_arr < 0:
                    RhHgTimestamp{utc: -1, tz_offset: -1, present: false}
                else:
                    e0: i64 = Json::rh_json_arr_get(nodes, date_arr, 0)
                    e1: i64 = Json::rh_json_arr_get(nodes, date_arr, 1)
                    utc, utc_valid =
                        valid: mutable i64 = 0
                        value: i64 = Json::rh_json_int(nodes, raw, e0, &valid)
                        value, valid == 1
                    tz, tz_valid =
                        valid: mutable i64 = 0
                        value: i64 = Json::rh_json_int(nodes, raw, e1, &valid)
                        value, valid == 1
                    RhHgTimestamp{utc: utc, tz_offset: tz, present: true} if utc_valid and tz_valid else RhHgTimestamp{utc: -1, tz_offset: -1, present: false}
            phase: u8 =
                ps: mutable i64 = -1
                pe: mutable i64 = -1
                _ = Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, obj, "phase"), &ps, &pe)
                value: u8 = rh_hg_phase_of(texts, ps, pe)
                value
            tags: i64 = rh_hg_arr_count(nodes, Json::rh_json_obj_get(nodes, texts, obj, "tags"))
            RhHgRow{usable: true, change: RhHgChange{node_s: node_s, node_e: node_e, rev: rev, author_s: author_s, author_e: author_e, desc_s: desc_s, desc_e: desc_e, utc: timestamp.utc, tz_offset: timestamp.tz_offset, has_date: timestamp.present, branch_s: branch_s, branch_e: branch_e, tag_count: tags, phase: phase}}
