# Digest-bound field transformation report for captured forge workflow events.
include "./rh_base.elisa"

module ForgeEventsTransformation:
    public:
        def rh_forge_events_transformation_report(configuration_sha: darray[u8]&, input_sha: darray[u8]&, output_sha: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"forge-workflow-events\",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-forge-events-result/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"provider-native event identifiers and status\",\"target\":\"native_id/status\",\"state\":\"transformed\"},{\"source\":\"provider timestamps and links\",\"target\":\"event timestamps/URL\",\"state\":\"preserved\"},{\"source\":\"duplicate native event identifiers\",\"target\":\"events\",\"state\":\"transformed\"},{\"source\":\"titles, bodies, and unrecognized provider fields\",\"target\":\"canonical event result\",\"state\":\"discarded\"},{\"source\":\"provider fields absent from captured payload\",\"target\":\"canonical event fields\",\"state\":\"unknown\"},{\"source\":\"live acquisition and authentication\",\"target\":\"captured-input normalizer\",\"state\":\"unsupported\"}]}")
