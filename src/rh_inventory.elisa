include "./rh_base.elisa"
include "./rh_json.elisa"

module Inventory:
    public:
        # rh_inventory.elisa — standards-based inventory interchange (M03-07, R027).
        #
        # ONE pinned format for the first release: CycloneDX JSON, with a DECLARED
        # set of supported spec versions. A document whose spec version is not in
        # that set is reported `unsupported`, never guessed at. Parsing is
        # metadata-only: it extracts component identity (type/name/version/purl)
        # and artifact hashes, and never executes anything.
        #
        # `valid != complete`: a document that validates proves it is
        # well-formed CycloneDX, not that it lists every dependency. The returned
        # counts say exactly what the document contained, nothing about the world.



        struct RhBomComponent:
            type_s: i64
            type_e: i64
            name_s: i64
            name_e: i64
            version_s: i64
            version_e: i64
            purl_s: i64
            purl_e: i64
            hash_count: i64
            valid_sha256: i64

        struct RhBomComposition:
            aggregate_s: i64
            aggregate_e: i64
            assemblies: i64
            dependencies: i64
            vulnerabilities: i64

        struct RhBom:
            ok: mutable i64
            spec_unsupported: mutable i64
            component_count: mutable i64
            invalid_components: mutable i64
            with_purl: mutable i64
            with_hash: mutable i64
            digest_known: mutable i64
            unknown_top_keys: mutable i64
            dependency_composition_count: mutable i64
            dependency_complete_count: mutable i64
            dependency_incomplete_count: mutable i64
            dependency_unknown_count: mutable i64
            dependency_not_specified_count: mutable i64

    private:
        const RH_BOM_MAX_COMPONENTS: i64 = 100000

        # (private to this file)
        def rh_bom_copy(pool: mutable darray[u8]&, texts: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if s < 0 or e < s
            start: i64 = pool.count.i64()
            while k < e |k: i64 = s, texts, pool, e|:
                pool.push(texts[k.usize()])
                k <- k + 1
            start

        # (private to this file)
        def rh_bom_eq_ci(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: i64 = strlen(lit).i64()
            return false if s < 0 or e - s != n
            while k < n |k: i64 = 0, texts, s, lit|:
                a: mutable u8 = texts[(s + k).usize()]
                b: mutable u8 = lit[k.usize()]
                if a >= 65 and a <= 90:
                    a <- a + 32
                if b >= 65 and b <= 90:
                    b <- b + 32
                return false if a != b
                k <- k + 1
            true

        # Declared supported CycloneDX spec versions for this release.
        def rh_bom_spec_supported(texts: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return true if rh_bom_eq_ci(texts, s, e, "1.4")
            return true if rh_bom_eq_ci(texts, s, e, "1.5")
            return true if rh_bom_eq_ci(texts, s, e, "1.6")
            false

        # A SHA-256 hash is 64 lowercase hex characters.
        # (private to this file)
        def rh_bom_sha256_hex(texts: darray[u8]&, s: i64, e: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if s < 0 or e - s != 64
            while i < e |i: i64 = s, e, texts|:
                b: u8 = texts[i.usize()]
                return false if not ((b >= 48 and b <= 57) or (b >= 97 and b <= 102))
                i <- i + 1
            true

        # Count hashes and how many are a valid SHA-256.
        # (private to this file)
        def rh_bom_hash_count(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, arr: i64, total_out: mutable i64&, valid_out: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
            total_out[0] <- 0
            valid_out[0] <- 0
            return if arr < 0
            o: Json::RhJsonNode = nodes[arr.usize()]
            return if o.kind != Json::RH_JSON_ARR
            while child >= 0 |child: i64 = o.first_child, nodes, texts, total_out, valid_out|:
                nxt: i64 = nodes[child.usize()].next_sibling
                total_out[0] <- total_out[0] + 1
                alg_s: mutable i64 = -1
                alg_e: mutable i64 = -1
                ok_alg: bool = Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, child, "alg"), &alg_s, &alg_e)
                cs: mutable i64 = -1
                ce: mutable i64 = -1
                ok_c: bool = Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, child, "content"), &cs, &ce)
                if ok_alg and ok_c and rh_bom_eq_ci(texts, alg_s, alg_e, "SHA-256") and rh_bom_sha256_hex(texts, cs, ce):
                    valid_out[0] <- valid_out[0] + 1
                child <- nxt

        # Count top-level CycloneDX keys this parser does not model, instead of
        # pretending it understood them (lossless/unknown-fields reporting, M08).
        # `$schema` and any future keys are counted; the reader can then tell that
        # the document carries more than the modeled fields.
        def rh_bom_unknown_keys(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, root: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            while child >= 0 |total: i64 = 0, child: i64 = nodes[root.usize()].first_child, is_key: bool = true| -> total:
                kn: Json::RhJsonNode = nodes[child.usize()]
                nxt: i64 = kn.next_sibling
                if is_key and kn.kind == Json::RH_JSON_STR:
                    ks: i64 = kn.text_start
                    ke: i64 = kn.text_end
                    known: mutable bool = false
                    if rh_bom_eq_ci(texts, ks, ke, "bomFormat"):
                        known <- true
                    if rh_bom_eq_ci(texts, ks, ke, "specVersion"):
                        known <- true
                    if rh_bom_span_eq(texts, ks, ke, "serialNumber"):
                        known <- true
                    if rh_bom_span_eq(texts, ks, ke, "version"):
                        known <- true
                    if rh_bom_span_eq(texts, ks, ke, "metadata"):
                        known <- true
                    if rh_bom_span_eq(texts, ks, ke, "components"):
                        known <- true
                    if rh_bom_span_eq(texts, ks, ke, "dependencies"):
                        known <- true
                    if rh_bom_span_eq(texts, ks, ke, "vulnerabilities"):
                        known <- true
                    if rh_bom_span_eq(texts, ks, ke, "compositions"):
                        known <- true
                    if not known:
                        total <- total + 1
                is_key <- not is_key
                child <- nxt

        # Exact byte-span equality against an ASCII literal.
        def rh_bom_span_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        # CycloneDX composition completeness values. Preserve the specific
        # aggregate in the report; these classes are only for coverage counts.
        def rh_bom_aggregate_class(texts: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 1 if rh_bom_span_eq(texts, s, e, "complete")
            return 2 if rh_bom_span_eq(texts, s, e, "incomplete")
            return 2 if rh_bom_span_eq(texts, s, e, "incomplete_first_party_only")
            return 2 if rh_bom_span_eq(texts, s, e, "incomplete_first_party_opensource_only")
            return 2 if rh_bom_span_eq(texts, s, e, "incomplete_first_party_proprietary_only")
            return 2 if rh_bom_span_eq(texts, s, e, "incomplete_third_party_only")
            return 2 if rh_bom_span_eq(texts, s, e, "incomplete_third_party_opensource_only")
            return 2 if rh_bom_span_eq(texts, s, e, "incomplete_third_party_proprietary_only")
            return 3 if rh_bom_span_eq(texts, s, e, "unknown")
            return 4 if rh_bom_span_eq(texts, s, e, "not_specified")
            -1

        # Composition targets are reference arrays. Their identifiers remain
        # in the source BOM, linked by its input digest; this importer records
        # the exact per-scope target cardinalities without promoting them to a
        # dependency graph.
        def rh_bom_ref_count(nodes: darray[Json::RhJsonNode]&, arr: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if arr < 0
            return -1 if nodes[arr.usize()].kind != Json::RH_JSON_ARR
            while child >= 0 |count: i64 = 0, child: i64 = nodes[arr.usize()].first_child| -> count:
                return -1 if count >= RH_BOM_MAX_COMPONENTS
                ref: Json::RhJsonNode = nodes[child.usize()]
                return -1 if ref.kind != Json::RH_JSON_STR or ref.text_end <= ref.text_start
                count <- count + 1
                child <- ref.next_sibling

        # Retain only composition assertions scoped to dependency references;
        # other composition scopes remain visible as rows with their counts.
        def rh_bom_compositions(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, root: i64, pool: mutable darray[u8]&, out: mutable darray[RhBomComposition]&, bom: mutable RhBom&) -> i64 can[Memory.Allocate, Abort.Panic]:
            arr: i64 = Json::rh_json_obj_get(nodes, texts, root, "compositions")
            return -1 if arr == -2
            return 0 if arr < 0
            return -1 if nodes[arr.usize()].kind != Json::RH_JSON_ARR
            while child >= 0 |child: i64 = nodes[arr.usize()].first_child, pool, out, bom|:
                return -1 if out.count.i64() >= RH_BOM_MAX_COMPONENTS or nodes[child.usize()].kind != Json::RH_JSON_OBJ
                aggregate_node: i64 = Json::rh_json_obj_get(nodes, texts, child, "aggregate")
                aggregate_s: mutable i64 = -1
                aggregate_e: mutable i64 = -1
                return -1 if not Json::rh_json_str_span(nodes, aggregate_node, &aggregate_s, &aggregate_e) or rh_bom_aggregate_class(texts, aggregate_s, aggregate_e) < 0
                assemblies_node: i64 = Json::rh_json_obj_get(nodes, texts, child, "assemblies")
                dependencies_node: i64 = Json::rh_json_obj_get(nodes, texts, child, "dependencies")
                vulnerabilities_node: i64 = Json::rh_json_obj_get(nodes, texts, child, "vulnerabilities")
                return -1 if assemblies_node == -2 or dependencies_node == -2 or vulnerabilities_node == -2
                assemblies: i64 = rh_bom_ref_count(nodes, assemblies_node)
                dependencies: i64 = rh_bom_ref_count(nodes, dependencies_node)
                vulnerabilities: i64 = rh_bom_ref_count(nodes, vulnerabilities_node)
                return -1 if assemblies < 0 or dependencies < 0 or vulnerabilities < 0
                copied_start: i64 = rh_bom_copy(pool, texts, aggregate_s, aggregate_e)
                aggregate_class: i64 = rh_bom_aggregate_class(texts, aggregate_s, aggregate_e)
                if dependencies_node >= 0:
                    bom.dependency_composition_count <- bom.dependency_composition_count + 1
                    if aggregate_class == 1:
                        bom.dependency_complete_count <- bom.dependency_complete_count + 1
                    elif aggregate_class == 2:
                        bom.dependency_incomplete_count <- bom.dependency_incomplete_count + 1
                    elif aggregate_class == 3:
                        bom.dependency_unknown_count <- bom.dependency_unknown_count + 1
                    else:
                        bom.dependency_not_specified_count <- bom.dependency_not_specified_count + 1
                out.push(RhBomComposition{aggregate_s: copied_start, aggregate_e: copied_start + aggregate_e - aggregate_s, assemblies: assemblies, dependencies: dependencies, vulnerabilities: vulnerabilities})
                child <- nodes[child.usize()].next_sibling
            0

        # Parse a CycloneDX JSON document. Returns 0 when a BOM was recognized
        # (including an unsupported spec version, which is reported in the result),
        # -1 when the payload is not JSON/not CycloneDX. Components missing a
        # non-empty name or version are counted invalid and skipped.
    public:
        def rh_bom_parse(raw: darray[u8]&, pool: mutable darray[u8]&, out: mutable darray[RhBomComponent]&, compositions: mutable darray[RhBomComposition]&, bom_out: mutable RhBom&) -> i64 can[Memory.Allocate, Abort.Panic]:
            bom_out[0] <- RhBom{ok: 0, spec_unsupported: 0, component_count: 0, invalid_components: 0, with_purl: 0, with_hash: 0, digest_known: 0, unknown_top_keys: 0, dependency_composition_count: 0, dependency_complete_count: 0, dependency_incomplete_count: 0, dependency_unknown_count: 0, dependency_not_specified_count: 0}
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0
            supported: bool = |nodes, texts|
                rn: Json::RhJsonNode = nodes[root.usize()]
                return -1 if rn.kind != Json::RH_JSON_OBJ
                fs: mutable i64 = -1
                fe: mutable i64 = -1
                return -1 if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, root, "bomFormat"), &fs, &fe)
                return -1 if not rh_bom_eq_ci(texts, fs, fe, "CycloneDX")
                vs: mutable i64 = -1
                ve: mutable i64 = -1
                return -1 if not Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, root, "specVersion"), &vs, &ve)
                block_result: bool = rh_bom_spec_supported(texts, vs, ve)
                block_result
            b: mutable RhBom = RhBom{ok: 1, spec_unsupported: 0, component_count: 0, invalid_components: 0, with_purl: 0, with_hash: 0, digest_known: 0, unknown_top_keys: rh_bom_unknown_keys(nodes, texts, root), dependency_composition_count: 0, dependency_complete_count: 0, dependency_incomplete_count: 0, dependency_unknown_count: 0, dependency_not_specified_count: 0}
            if not supported:
                b.spec_unsupported <- 1
                bom_out[0] <- b
                return 0
            arr: i64 = Json::rh_json_obj_get(nodes, texts, root, "components")
            if arr < 0:
                bom_out[0] <- b
                return 0
            an: Json::RhJsonNode = nodes[arr.usize()]
            return -1 if an.kind != Json::RH_JSON_ARR
            while child >= 0 |child: i64 = an.first_child, nodes, texts, pool, out, b|:
                nxt: i64 = nodes[child.usize()].next_sibling
                return -1 if out.count.i64() >= RH_BOM_MAX_COMPONENTS
                ns: mutable i64 = -1
                ne: mutable i64 = -1
                ws: mutable i64 = -1
                we: mutable i64 = -1
                ok_name: bool = Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, child, "name"), &ns, &ne)
                ok_ver: bool = Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, child, "version"), &ws, &we)
                if not ok_name or ne <= ns or not ok_ver or we <= ws:
                    b.invalid_components <- b.invalid_components + 1
                else:
                    b.component_count <- b.component_count + 1
                    ts: mutable i64 = -1
                    te: mutable i64 = -1
                    _ = Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, child, "type"), &ts, &te)
                    ps: mutable i64 = -1
                    pe: mutable i64 = -1
                    has_purl: bool = Json::rh_json_str_span(nodes, Json::rh_json_obj_get(nodes, texts, child, "purl"), &ps, &pe)
                    if has_purl and pe > ps:
                        b.with_purl <- b.with_purl + 1
                    hc: mutable i64 = 0
                    hv: mutable i64 = 0
                    rh_bom_hash_count(nodes, texts, Json::rh_json_obj_get(nodes, texts, child, "hashes"), &hc, &hv)
                    if hc > 0:
                        b.with_hash <- b.with_hash + 1
                    b.digest_known <- b.digest_known + hv
                    t2s: i64 = rh_bom_copy(pool, texts, ts, te)
                    t2e: i64 = rh_bom_span_end_after(pool, ts, te, t2s)
                    n2s: i64 = rh_bom_copy(pool, texts, ns, ne)
                    n2e: i64 = rh_bom_span_end_after(pool, ns, ne, n2s)
                    v2s: i64 = rh_bom_copy(pool, texts, ws, we)
                    v2e: i64 = rh_bom_span_end_after(pool, ws, we, v2s)
                    p2s: i64 = rh_bom_copy(pool, texts, ps, pe)
                    p2e: i64 = rh_bom_span_end_after(pool, ps, pe, p2s)
                    out.push(RhBomComponent{type_s: t2s, type_e: t2e, name_s: n2s, name_e: n2e, version_s: v2s, version_e: v2e, purl_s: p2s, purl_e: p2e, hash_count: hc, valid_sha256: hv})
                child <- nxt
            return -1 if rh_bom_compositions(nodes, texts, root, pool, compositions, b) != 0
            bom_out[0] <- b
            0

        # End of a copied span given its source span and copied start.
        # (private to this file)
        def rh_bom_span_end_after(pool: darray[u8]&, s: i64, e: i64, start: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if start < 0 or s < 0 or e < s
            start + (e - s)
