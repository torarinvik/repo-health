# rh_policy_parse.elisa — declarative policy + input parsing (M06-04/05/06).
#
# Gives the tested `rh_policy` engine a real execution surface: a versioned
# `rh-policy/1` document of rules and exceptions, and an `rh-policy-input/1`
# document of typed observations. Parsing is strict about anything that
# could change a decision: an unknown schema, operator, status, violation,
# or non-positive threshold denominator fails closed (returns -1) rather
# than defaulting to permission. Missing optional numeric fields default to
# zero; a missing `on_violation` defaults to `deny`.
#
# Inputs are aligned to rules by rule id (the engine matches by position,
# so the caller must not rely on file order). A rule with no supplied input
# is filled with an `unavailable` input, which the engine evaluates as
# UNKNOWN — never permission.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_policy.elisa"
include "./rh_observation.elisa"

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pp_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: i64 = e - s
    k: mutable i64 = 0
    while k < n |k, texts, lit, s|:
        if lit[k.usize()] == 0:
            return false
        if texts[(s + k).usize()] != lit[k.usize()]:
            return false
        k <- k + 1
    return lit[n.usize()] == 0

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pp_op(texts: darray[u8]&, s: i64, e: i64) -> i64:
    if rh_pp_eq(texts, s, e, "<"):
        return RH_OP_LT
    if rh_pp_eq(texts, s, e, "<="):
        return RH_OP_LE
    if rh_pp_eq(texts, s, e, ">"):
        return RH_OP_GT
    if rh_pp_eq(texts, s, e, ">="):
        return RH_OP_GE
    if rh_pp_eq(texts, s, e, "=="):
        return RH_OP_EQ
    if rh_pp_eq(texts, s, e, "!="):
        return RH_OP_NE
    return -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pp_decision(texts: darray[u8]&, s: i64, e: i64) -> i64:
    if rh_pp_eq(texts, s, e, "allow"):
        return RH_DEC_ALLOW
    if rh_pp_eq(texts, s, e, "warn"):
        return RH_DEC_WARN
    if rh_pp_eq(texts, s, e, "unknown"):
        return RH_DEC_UNKNOWN
    if rh_pp_eq(texts, s, e, "deny"):
        return RH_DEC_DENY
    return -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pp_status(texts: darray[u8]&, s: i64, e: i64) -> i64:
    if rh_pp_eq(texts, s, e, "observed"):
        return RH_ST_OBSERVED
    if rh_pp_eq(texts, s, e, "not_observed"):
        return RH_ST_NOT_OBSERVED
    if rh_pp_eq(texts, s, e, "unavailable"):
        return RH_ST_UNAVAILABLE
    if rh_pp_eq(texts, s, e, "unauthorized"):
        return RH_ST_UNAUTHORIZED
    if rh_pp_eq(texts, s, e, "partial"):
        return RH_ST_PARTIAL
    if rh_pp_eq(texts, s, e, "stale"):
        return RH_ST_STALE
    if rh_pp_eq(texts, s, e, "not_applicable"):
        return RH_ST_NOT_APPLICABLE
    if rh_pp_eq(texts, s, e, "error"):
        return RH_ST_ERROR
    if rh_pp_eq(texts, s, e, "conflicted"):
        return RH_ST_CONFLICTED
    if rh_pp_eq(texts, s, e, "suppressed"):
        return RH_ST_SUPPRESSED
    if rh_pp_eq(texts, s, e, "unsupported"):
        return RH_ST_UNSUPPORTED
    return -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pp_hex64(texts: darray[u8]&, s: i64, e: i64, ok_out: mutable i64&) -> u64 can[Memory.Allocate, Abort.Panic]:
    ok_out[0] <- 0
    if e - s != 16:
        return 0
    acc: mutable u64 = 0
    i: mutable i64 = s
    while i < e |i, texts, e, acc|:
        b: u8 = texts[i.usize()]
        d: mutable u64 = 99
        if b >= 48 and b <= 57:
            d <- (b - 48).u64()
        if b >= 97 and b <= 102:
            d <- (b - 87).u64()
        if d > 15:
            return 0
        acc <- acc * 16 + d
        i <- i + 1
    ok_out[0] <- 1
    return acc

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pp_str(nodes: darray[RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    idx: i64 = rh_json_obj_get(nodes, texts, obj, key)
    if idx < 0:
        return false
    return rh_json_str_span(nodes, idx, s_out, e_out)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_pp_int(nodes: darray[RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    ok_out[0] <- 0
    idx: i64 = rh_json_obj_get(nodes, texts, obj, key)
    if idx < 0:
        return 0
    return rh_json_int(nodes, raw, idx, ok_out)

# Parse an rh-policy/1 document. Returns 0 ok, -1 malformed/unsupported.
def rh_policy_parse(raw: darray[u8]&, rules: mutable darray[RhRule]&, excs: mutable darray[RhException]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = rh_json_parse(raw, nodes, texts)
    if root < 0:
        return -1
    if nodes[root.usize()].kind != RH_JSON_OBJ:
        return -1
    ss: mutable i64 = 0
    se: mutable i64 = 0
    if not rh_pp_str(nodes, texts, root, "schema", &ss, &se):
        return -1
    if not rh_pp_eq(texts, ss, se, "rh-policy/1"):
        return -1
    rules_idx: i64 = rh_json_obj_get(nodes, texts, root, "rules")
    if rules_idx < 0 or nodes[rules_idx.usize()].kind != RH_JSON_ARR:
        return -1
    rc: RhJsonNode = nodes[rules_idx.usize()]
    child: mutable i64 = rc.first_child
    while child >= 0 |child, nodes, texts, raw, rules|:
        if nodes[child.usize()].kind != RH_JSON_OBJ:
            return -1
        okid: mutable i64 = 0
        id: i64 = rh_pp_int(nodes, raw, texts, child, "id", &okid)
        if okid == 0:
            return -1
        ops: mutable i64 = 0
        ope: mutable i64 = 0
        if not rh_pp_str(nodes, texts, child, "op", &ops, &ope):
            return -1
        op: i64 = rh_pp_op(texts, ops, ope)
        if op < 0:
            return -1
        num: mutable i64 = 0
        den: mutable i64 = 1
        thr: i64 = rh_json_obj_get(nodes, texts, child, "threshold")
        if thr >= 0 and nodes[thr.usize()].kind == RH_JSON_OBJ:
            okn: mutable i64 = 0
            okd: mutable i64 = 0
            num <- rh_pp_int(nodes, raw, texts, thr, "num", &okn)
            den <- rh_pp_int(nodes, raw, texts, thr, "den", &okd)
            if okn == 0 or okd == 0 or den <= 0:
                return -1
        okf: mutable i64 = 0
        fresh_raw: i64 = rh_pp_int(nodes, raw, texts, child, "freshness_secs", &okf)
        fresh: i64 = fresh_raw if okf != 0 else 0
        oks: mutable i64 = 0
        sample_raw: i64 = rh_pp_int(nodes, raw, texts, child, "min_sample", &oks)
        sample: i64 = sample_raw if oks != 0 else 0
        vios: mutable i64 = 0
        vioe: mutable i64 = 0
        vio: mutable i64 = RH_DEC_DENY
        if rh_pp_str(nodes, texts, child, "on_violation", &vios, &vioe):
            parsed_vio: i64 = rh_pp_decision(texts, vios, vioe)
            if parsed_vio < 0:
                return -1
            vio <- parsed_vio
        comp: mutable bool = false
        cidx: i64 = rh_json_obj_get(nodes, texts, child, "requires_complete")
        if cidx >= 0:
            comp <- rh_json_is_true(nodes, raw, cidx)
        rst: mutable u8 = RH_RULE_ACTIVE
        sts: mutable i64 = 0
        ste: mutable i64 = 0
        if rh_pp_str(nodes, texts, child, "state", &sts, &ste):
            if rh_pp_eq(texts, sts, ste, "retired"):
                rst <- RH_RULE_RETIRED
            elif not rh_pp_eq(texts, sts, ste, "active"):
                return -1
        rules.push(RhRule{id: id, op: op.u8(), thr_num: num, thr_den: den, need_fresh_secs: fresh, min_sample: sample, on_violation: vio.u8(), requires_complete: comp, state: rst})
        child <- nodes[child.usize()].next_sibling
    excs_idx: i64 = rh_json_obj_get(nodes, texts, root, "exceptions")
    if excs_idx >= 0:
        if nodes[excs_idx.usize()].kind != RH_JSON_ARR:
            return -1
        ec: RhJsonNode = nodes[excs_idx.usize()]
        echild: mutable i64 = ec.first_child
        while echild >= 0 |echild, nodes, texts, raw, excs|:
            if nodes[echild.usize()].kind != RH_JSON_OBJ:
                return -1
            okr: mutable i64 = 0
            oks2: mutable i64 = 0
            oke: mutable i64 = 0
            rid: i64 = rh_pp_int(nodes, raw, texts, echild, "rule_id", &okr)
            sub: i64 = rh_pp_int(nodes, raw, texts, echild, "subject_id", &oks2)
            exp: i64 = rh_pp_int(nodes, raw, texts, echild, "expires_at", &oke)
            if okr == 0 or oks2 == 0 or oke == 0:
                return -1
            dgs: mutable i64 = 0
            dge: mutable i64 = 0
            hi: mutable u64 = 0
            if rh_pp_str(nodes, texts, echild, "digest", &dgs, &dge):
                okh: mutable i64 = 0
                hi <- rh_pp_hex64(texts, dgs, dge, &okh)
                if okh == 0:
                    return -1
            est: mutable u8 = RH_EXC_APPROVED
            ess: mutable i64 = 0
            ese: mutable i64 = 0
            if rh_pp_str(nodes, texts, echild, "state", &ess, &ese):
                if not rh_pp_eq(texts, ess, ese, "approved"):
                    est <- 1
            excs.push(RhException{rule_id: rid, subject_id: sub, digest_high: hi, digest_low: 0, expires_at: exp, state: est})
            echild <- nodes[echild.usize()].next_sibling
    return 0

# Parse an rh-policy-input/1 document. Returns 0 ok, -1 malformed/unsupported.
def rh_policy_input_parse(raw: darray[u8]&, rule_ids: mutable darray[i64]&, inputs: mutable darray[RhPolicyInput]&, subject_out: mutable i64&, artifact_out: mutable u64&, context_out: mutable u64&, now_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = rh_json_parse(raw, nodes, texts)
    if root < 0:
        return -1
    if nodes[root.usize()].kind != RH_JSON_OBJ:
        return -1
    ss: mutable i64 = 0
    se: mutable i64 = 0
    if not rh_pp_str(nodes, texts, root, "schema", &ss, &se):
        return -1
    if not rh_pp_eq(texts, ss, se, "rh-policy-input/1"):
        return -1
    oksub: mutable i64 = 0
    sub: i64 = rh_pp_int(nodes, raw, texts, root, "subject_id", &oksub)
    if oksub == 0:
        return -1
    oknow: mutable i64 = 0
    now: i64 = rh_pp_int(nodes, raw, texts, root, "now", &oknow)
    if oknow == 0:
        return -1
    subject_out[0] <- sub
    now_out[0] <- now
    artifact_out[0] <- 0
    context_out[0] <- 0
    ads: mutable i64 = 0
    ade: mutable i64 = 0
    if rh_pp_str(nodes, texts, root, "artifact_digest", &ads, &ade):
        oka: mutable i64 = 0
        artifact_out[0] <- rh_pp_hex64(texts, ads, ade, &oka)
        if oka == 0:
            return -1
    cds: mutable i64 = 0
    cde: mutable i64 = 0
    if rh_pp_str(nodes, texts, root, "context_digest", &cds, &cde):
        okc: mutable i64 = 0
        context_out[0] <- rh_pp_hex64(texts, cds, cde, &okc)
        if okc == 0:
            return -1
    ins_idx: i64 = rh_json_obj_get(nodes, texts, root, "inputs")
    if ins_idx < 0 or nodes[ins_idx.usize()].kind != RH_JSON_ARR:
        return -1
    arr: RhJsonNode = nodes[ins_idx.usize()]
    child: mutable i64 = arr.first_child
    while child >= 0 |child, nodes, texts, raw, rule_ids, inputs|:
        if nodes[child.usize()].kind != RH_JSON_OBJ:
            return -1
        okid: mutable i64 = 0
        rid: i64 = rh_pp_int(nodes, raw, texts, child, "rule_id", &okid)
        if okid == 0:
            return -1
        sts: mutable i64 = 0
        ste: mutable i64 = 0
        if not rh_pp_str(nodes, texts, child, "status", &sts, &ste):
            return -1
        status: i64 = rh_pp_status(texts, sts, ste)
        if status < 0:
            return -1
        okn: mutable i64 = 0
        okd: mutable i64 = 0
        oks: mutable i64 = 0
        oka: mutable i64 = 0
        num: i64 = rh_pp_int(nodes, raw, texts, child, "num", &okn)
        den_raw: i64 = rh_pp_int(nodes, raw, texts, child, "den", &okd)
        den: i64 = den_raw if okd != 0 else 1
        sample: i64 = rh_pp_int(nodes, raw, texts, child, "sample", &oks)
        age: i64 = rh_pp_int(nodes, raw, texts, child, "age_secs", &oka)
        comp: mutable bool = false
        cidx: i64 = rh_json_obj_get(nodes, texts, child, "complete")
        if cidx >= 0:
            comp <- rh_json_is_true(nodes, raw, cidx)
        rule_ids.push(rid)
        inputs.push(RhPolicyInput{status: status.u8(), num: num, den: den, sample: sample, age_secs: age, complete: comp})
        child <- nodes[child.usize()].next_sibling
    return 0

# Align inputs to rules by rule id. Rules without a supplied input get an
# `unavailable` input (engine -> UNKNOWN) and their id is recorded in
# missing_out. aligned is fully populated at rules.count.
def rh_policy_align(rules: darray[RhRule]&, in_ids: darray[i64]&, inputs: darray[RhPolicyInput]&, aligned: mutable darray[RhPolicyInput]&, missing_out: mutable darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
    i: mutable usize = 0
    while i < rules.count |i, rules, in_ids, inputs, aligned, missing_out|:
        rid: i64 = rules[i].id
        found: mutable i64 = -1
        j: mutable usize = 0
        while j < in_ids.count |j, in_ids, rid, found|:
            if in_ids[j] == rid:
                found <- j.i64()
            j <- j + 1
        if found >= 0:
            inp: RhPolicyInput = inputs[found.usize()]
            aligned.push(inp)
        else:
            aligned.push(RhPolicyInput{status: RH_ST_UNAVAILABLE, num: 0, den: 1, sample: 0, age_secs: 0, complete: false})
            missing_out.push(rid)
        i <- i + 1

# --- Durable exception state (M06-06). ---
# Persist approved/revoked exceptions across runs under an
# `rh-policy-state/1` document, so an approved waiver survives process
# restart and an *expired* waiver is re-evaluated (never silently renewed).
# An empty buffer is a fresh (empty) state; malformed state fails closed.

def rh_pp_exc_state(texts: darray[u8]&, s: i64, e: i64) -> i64:
    if rh_pp_eq(texts, s, e, "approved"):
        return 0
    if rh_pp_eq(texts, s, e, "revoked"):
        return 1
    return -1

def rh_policy_state_parse(raw: darray[u8]&, excs: mutable darray[RhException]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    if raw.count == 0:
        return 0
    nodes: mutable darray[RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = rh_json_parse(raw, nodes, texts)
    if root < 0 or nodes[root.usize()].kind != RH_JSON_OBJ:
        return -1
    ss: mutable i64 = 0
    se: mutable i64 = 0
    if not rh_pp_str(nodes, texts, root, "schema", &ss, &se):
        return -1
    if not rh_pp_eq(texts, ss, se, "rh-policy-state/1"):
        return -1
    rows: i64 = rh_json_obj_get(nodes, texts, root, "exceptions")
    if rows < 0 or nodes[rows.usize()].kind != RH_JSON_ARR:
        return -1
    arr: RhJsonNode = nodes[rows.usize()]
    child: mutable i64 = arr.first_child
    while child >= 0 |child, nodes, texts, raw, excs|:
        if nodes[child.usize()].kind != RH_JSON_OBJ:
            return -1
        okr: mutable i64 = 0
        oks: mutable i64 = 0
        oke: mutable i64 = 0
        rid: i64 = rh_pp_int(nodes, raw, texts, child, "rule_id", &okr)
        sub: i64 = rh_pp_int(nodes, raw, texts, child, "subject_id", &oks)
        exp: i64 = rh_pp_int(nodes, raw, texts, child, "expires_at", &oke)
        if okr == 0 or oks == 0 or oke == 0:
            return -1
        dgs: mutable i64 = 0
        dge: mutable i64 = 0
        hi: mutable u64 = 0
        if rh_pp_str(nodes, texts, child, "digest", &dgs, &dge):
            okh: mutable i64 = 0
            hi <- rh_pp_hex64(texts, dgs, dge, &okh)
            if okh == 0:
                return -1
        sts: mutable i64 = 0
        ste: mutable i64 = 0
        if not rh_pp_str(nodes, texts, child, "state", &sts, &ste):
            return -1
        st: i64 = rh_pp_exc_state(texts, sts, ste)
        if st < 0:
            return -1
        excs.push(RhException{rule_id: rid, subject_id: sub, digest_high: hi, digest_low: 0, expires_at: exp, state: st.u8()})
        child <- nodes[child.usize()].next_sibling
    return 0

def rh_pp_push_exc_state(out: mutable darray[u8]&, st: u8) -> void:
    if st == 0:
        rh_push_text(out, "approved")
    else:
        rh_push_text(out, "revoked")

def rh_policy_state_emit(excs: darray[RhException]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    rh_push_text(out, "{\"schema\":\"rh-policy-state/1\",\"exceptions\":[")
    i: mutable usize = 0
    while i < excs.count |i, excs, out|:
        x: RhException = excs[i]
        if i > 0:
            out.push(44)
        rh_push_text(out, "{\"rule_id\":")
        rh_push_decimal_i64(out, x.rule_id)
        rh_push_text(out, ",\"subject_id\":")
        rh_push_decimal_i64(out, x.subject_id)
        rh_push_text(out, ",\"digest\":\"")
        rh_push_hex_u64(out, x.digest_high)
        rh_push_text(out, "\",\"expires_at\":")
        rh_push_decimal_i64(out, x.expires_at)
        rh_push_text(out, ",\"state\":\"")
        rh_pp_push_exc_state(out, x.state)
        rh_push_text(out, "\"}")
        i <- i + 1
    rh_push_text(out, "]}")
