include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_policy.elisa"
include "./rh_observation.elisa"

module PolicyParse:
    public:
        # rh_policy_parse.elisa — declarative policy + input parsing (M06-04/05/06).
        #
        # Gives the tested `rh_policy` engine a real execution surface: a versioned
        # `rh-policy/1` document of rules and exceptions, and an `rh-policy-input/1`
        # document of typed observations. Parsing is strict about anything that
        # could change a decision: an unknown schema, operator, status, violation,
        # or non-positive threshold denominator fails closed (returns -1) rather
        # than defaulting to permission. Missing optional numeric fields default to
        # zero; a missing `on_violation` defaults to `deny`.
        #
        # Inputs are aligned to rules by rule id (the engine matches by position,
        # so the caller must not rely on file order). A rule with no supplied input
        # is filled with an `unavailable` input, which the engine evaluates as
        # UNKNOWN — never permission.






        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_pp_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_pp_op(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Policy::RH_OP_LT if rh_pp_eq(texts, s, e, "<")
            return Policy::RH_OP_LE if rh_pp_eq(texts, s, e, "<=")
            return Policy::RH_OP_GT if rh_pp_eq(texts, s, e, ">")
            return Policy::RH_OP_GE if rh_pp_eq(texts, s, e, ">=")
            return Policy::RH_OP_EQ if rh_pp_eq(texts, s, e, "==")
            return Policy::RH_OP_NE if rh_pp_eq(texts, s, e, "!=")
            -1

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_pp_decision(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Policy::RH_DEC_ALLOW if rh_pp_eq(texts, s, e, "allow")
            return Policy::RH_DEC_WARN if rh_pp_eq(texts, s, e, "warn")
            return Policy::RH_DEC_UNKNOWN if rh_pp_eq(texts, s, e, "unknown")
            return Policy::RH_DEC_DENY if rh_pp_eq(texts, s, e, "deny")
            -1

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_pp_status(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return Observation::RH_ST_OBSERVED if rh_pp_eq(texts, s, e, "observed")
            return Observation::RH_ST_NOT_OBSERVED if rh_pp_eq(texts, s, e, "not_observed")
            return Observation::RH_ST_UNAVAILABLE if rh_pp_eq(texts, s, e, "unavailable")
            return Observation::RH_ST_UNAUTHORIZED if rh_pp_eq(texts, s, e, "unauthorized")
            return Observation::RH_ST_PARTIAL if rh_pp_eq(texts, s, e, "partial")
            return Observation::RH_ST_STALE if rh_pp_eq(texts, s, e, "stale")
            return Observation::RH_ST_NOT_APPLICABLE if rh_pp_eq(texts, s, e, "not_applicable")
            return Observation::RH_ST_ERROR if rh_pp_eq(texts, s, e, "error")
            return Observation::RH_ST_CONFLICTED if rh_pp_eq(texts, s, e, "conflicted")
            return Observation::RH_ST_SUPPRESSED if rh_pp_eq(texts, s, e, "suppressed")
            return Observation::RH_ST_UNSUPPORTED if rh_pp_eq(texts, s, e, "unsupported")
            -1

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_pp_hex64(texts: darray[u8]&, s: i64, e: i64, ok_out: mutable i64&) -> u64 can[Memory.Allocate, Abort.Panic]:
            ok_out[0] <- 0
            return 0 if e - s != 16
            acc: u64 =
                while i < e |acc: u64 = 0, i: i64 = s| -> acc:
                    b: u8 = texts[i.usize()]
                    d: mutable u64 = (b - 48).u64() if b >= 48 and b <= 57 else 99
                    if b >= 97 and b <= 102:
                        d <- (b - 87).u64()
                    return 0 if d > 15
                    acc <- acc * 16 + d
                    i <- i + 1
            ok_out[0] <- 1
            acc

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_pp_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return false if idx < 0
            Json::rh_json_str_span(nodes, idx, s_out, e_out)

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_pp_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            ok_out[0] <- 0
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return 0 if idx < 0
            Json::rh_json_int(nodes, raw, idx, ok_out)

        # Parse an rh-policy/1 document. Returns 0 ok, -1 malformed/unsupported.
        def rh_policy_parse(raw: darray[u8]&, rules: mutable darray[Policy::RhRule]&, excs: mutable darray[Policy::RhException]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0
            return -1 if nodes[root.usize()].kind != Json::RH_JSON_OBJ
            ss: mutable i64 = 0
            se: mutable i64 = 0
            return -1 if not rh_pp_str(nodes, texts, root, "schema", &ss, &se)
            return -1 if not rh_pp_eq(texts, ss, se, "rh-policy/1")
            rules_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "rules")
            return -1 if rules_idx < 0 or nodes[rules_idx.usize()].kind != Json::RH_JSON_ARR
            rc: Json::RhJsonNode = nodes[rules_idx.usize()]
            while child >= 0 |child: i64 = rc.first_child, nodes, texts, raw, rules|:
                return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                okid: mutable i64 = 0
                id: mutable i64 = rh_pp_int(nodes, raw, texts, child, "id", &okid)
                return -1 if okid == 0 or id < 0
                duplicate_rule: bool =
                    while ri < rules.count |duplicate_rule: bool = false, ri: usize = 0, rules, id| -> duplicate_rule:
                        duplicate_rule <- duplicate_rule or rules[ri].id == id
                        ri <- ri + 1
                return -1 if duplicate_rule
                op: i64 = |nodes, texts|
                    ops: mutable i64 = 0
                    ope: mutable i64 = 0
                    return -1 if not rh_pp_str(nodes, texts, child, "op", &ops, &ope)
                    block_result: i64 = rh_pp_op(texts, ops, ope)
                    block_result
                return -1 if op < 0
                num: mutable i64 = 0
                den: mutable i64 = 1
                thr: i64 = Json::rh_json_obj_get(nodes, texts, child, "threshold")
                if thr >= 0 and nodes[thr.usize()].kind == Json::RH_JSON_OBJ:
                    okn: mutable i64 = 0
                    okd: mutable i64 = 0
                    num <- rh_pp_int(nodes, raw, texts, thr, "num", &okn)
                    den <- rh_pp_int(nodes, raw, texts, thr, "den", &okd)
                    return -1 if okn == 0 or okd == 0 or den <= 0
                okf: mutable i64 = 0
                fresh: i64 =
                    fresh_raw: i64 = rh_pp_int(nodes, raw, texts, child, "freshness_secs", &okf)
                    fresh_raw if okf != 0 else 0
                return -1 if fresh < 0
                oks: mutable i64 = 0
                sample: i64 =
                    sample_raw: i64 = rh_pp_int(nodes, raw, texts, child, "min_sample", &oks)
                    sample_raw if oks != 0 else 0
                return -1 if sample < 0
                vios: mutable i64 = 0
                vioe: mutable i64 = 0
                vio: mutable i64 = Policy::RH_DEC_DENY
                if rh_pp_str(nodes, texts, child, "on_violation", &vios, &vioe):
                    parsed_vio: i64 = rh_pp_decision(texts, vios, vioe)
                    return -1 if parsed_vio < 0
                    vio <- parsed_vio
                comp: mutable bool = false
                cidx: i64 = Json::rh_json_obj_get(nodes, texts, child, "requires_complete")
                if cidx >= 0:
                    comp <- Json::rh_json_is_true(nodes, raw, cidx)
                rst: mutable u8 = Policy::RH_RULE_ACTIVE
                sts: mutable i64 = 0
                ste: mutable i64 = 0
                if rh_pp_str(nodes, texts, child, "state", &sts, &ste):
                    if rh_pp_eq(texts, sts, ste, "retired"):
                        rst <- Policy::RH_RULE_RETIRED
                    elif not rh_pp_eq(texts, sts, ste, "active"):
                        return -1
                rules.push(Policy::RhRule{id: id, op: op.u8(), thr_num: num, thr_den: den, need_fresh_secs: fresh, min_sample: sample, on_violation: vio.u8(), requires_complete: comp, state: rst})
                child <- nodes[child.usize()].next_sibling
            excs_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "exceptions")
            if excs_idx >= 0:
                return -1 if nodes[excs_idx.usize()].kind != Json::RH_JSON_ARR
                ec: Json::RhJsonNode = nodes[excs_idx.usize()]
                while echild >= 0 |echild: i64 = ec.first_child, nodes, texts, raw, excs|:
                    return -1 if nodes[echild.usize()].kind != Json::RH_JSON_OBJ
                    okr: mutable i64 = 0
                    oks2: mutable i64 = 0
                    oke: mutable i64 = 0
                    rid: mutable i64 = rh_pp_int(nodes, raw, texts, echild, "rule_id", &okr)
                    sub: mutable i64 = rh_pp_int(nodes, raw, texts, echild, "subject_id", &oks2)
                    exp: i64 = rh_pp_int(nodes, raw, texts, echild, "expires_at", &oke)
                    return -1 if okr == 0 or oks2 == 0 or oke == 0
                    dgs: mutable i64 = 0
                    dge: mutable i64 = 0
                    hi: mutable u64 = 0
                    if rh_pp_str(nodes, texts, echild, "digest", &dgs, &dge):
                        okh: mutable i64 = 0
                        hi <- rh_pp_hex64(texts, dgs, dge, &okh)
                        return -1 if okh == 0
                    cds: mutable i64 = 0
                    cde: mutable i64 = 0
                    context_digest: mutable u64 = 0
                    if rh_pp_str(nodes, texts, echild, "context_digest", &cds, &cde):
                        ok_context: mutable i64 = 0
                        context_digest <- rh_pp_hex64(texts, cds, cde, &ok_context)
                        return -1 if ok_context == 0
                    duplicate_exception: bool =
                        while ei < excs.count |duplicate_exception: bool = false, ei: usize = 0, excs, rid, sub, hi, context_digest| -> duplicate_exception:
                            duplicate_exception <- duplicate_exception or (excs[ei].rule_id == rid and excs[ei].subject_id == sub and excs[ei].digest_high == hi and excs[ei].digest_low == 0 and excs[ei].context_digest == context_digest)
                            ei <- ei + 1
                    return -1 if duplicate_exception
                    est: mutable u8 = Policy::RH_EXC_APPROVED
                    ess: mutable i64 = 0
                    ese: mutable i64 = 0
                    if rh_pp_str(nodes, texts, echild, "state", &ess, &ese):
                        if not rh_pp_eq(texts, ess, ese, "approved"):
                            est <- 1
                    excs.push(Policy::RhException{rule_id: rid, subject_id: sub, digest_high: hi, digest_low: 0, context_digest: context_digest, expires_at: exp, state: est})
                    echild <- nodes[echild.usize()].next_sibling
            0

        # Parse an rh-policy-input/1 document. Returns 0 ok, -1 malformed/unsupported.
        def rh_policy_input_parse(raw: darray[u8]&, rule_ids: mutable darray[i64]&, inputs: mutable darray[Policy::RhPolicyInput]&, subject_out: mutable i64&, artifact_out: mutable u64&, context_out: mutable u64&, now_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0
            return -1 if nodes[root.usize()].kind != Json::RH_JSON_OBJ
            ss: mutable i64 = 0
            se: mutable i64 = 0
            return -1 if not rh_pp_str(nodes, texts, root, "schema", &ss, &se)
            return -1 if not rh_pp_eq(texts, ss, se, "rh-policy-input/1")
            oksub: mutable i64 = 0
            sub: i64 = rh_pp_int(nodes, raw, texts, root, "subject_id", &oksub)
            return -1 if oksub == 0 or sub < 0
            oknow: mutable i64 = 0
            now: i64 = rh_pp_int(nodes, raw, texts, root, "now", &oknow)
            return -1 if oknow == 0 or now < 0
            subject_out[0] <- sub
            now_out[0] <- now
            artifact_out[0] <- 0
            context_out[0] <- 0
            ads: mutable i64 = 0
            ade: mutable i64 = 0
            if rh_pp_str(nodes, texts, root, "artifact_digest", &ads, &ade):
                oka: mutable i64 = 0
                artifact_out[0] <- rh_pp_hex64(texts, ads, ade, &oka)
                return -1 if oka == 0
            cds: mutable i64 = 0
            cde: mutable i64 = 0
            if rh_pp_str(nodes, texts, root, "context_digest", &cds, &cde):
                okc: mutable i64 = 0
                context_out[0] <- rh_pp_hex64(texts, cds, cde, &okc)
                return -1 if okc == 0
            ins_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "inputs")
            return -1 if ins_idx < 0 or nodes[ins_idx.usize()].kind != Json::RH_JSON_ARR
            arr: Json::RhJsonNode = nodes[ins_idx.usize()]
            while child >= 0 |child: i64 = arr.first_child, nodes, texts, raw, rule_ids, inputs|:
                return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                okid: mutable i64 = 0
                rid: mutable i64 = rh_pp_int(nodes, raw, texts, child, "rule_id", &okid)
                return -1 if okid == 0 or rid < 0
                duplicate_input: bool =
                    while ri < rule_ids.count |duplicate_input: bool = false, ri: usize = 0, rule_ids, rid| -> duplicate_input:
                        duplicate_input <- duplicate_input or rule_ids[ri] == rid
                        ri <- ri + 1
                return -1 if duplicate_input
                status: i64 = |nodes, texts|
                    sts: mutable i64 = 0
                    ste: mutable i64 = 0
                    return -1 if not rh_pp_str(nodes, texts, child, "status", &sts, &ste)
                    block_result: i64 = rh_pp_status(texts, sts, ste)
                    block_result
                return -1 if status < 0
                okn: mutable i64 = 0
                okd: mutable i64 = 0
                oks: mutable i64 = 0
                oka: mutable i64 = 0
                num: i64 = rh_pp_int(nodes, raw, texts, child, "num", &okn)
                den: i64 =
                    den_raw: i64 = rh_pp_int(nodes, raw, texts, child, "den", &okd)
                    den_raw if okd != 0 else 1
                sample: i64 = rh_pp_int(nodes, raw, texts, child, "sample", &oks)
                age: i64 =
                    age_raw: i64 = rh_pp_int(nodes, raw, texts, child, "age_secs", &oka)
                    age_raw if oka != 0 else 9223372036854775807
                return -1 if status == Observation::RH_ST_OBSERVED and (okn == 0 or okd == 0 or den <= 0)
                return -1 if oks != 0 and sample < 0
                return -1 if oka != 0 and age < 0
                comp: mutable bool = false
                cidx: i64 = Json::rh_json_obj_get(nodes, texts, child, "complete")
                if cidx >= 0:
                    comp <- Json::rh_json_is_true(nodes, raw, cidx)
                rule_ids.push(rid)
                inputs.push(Policy::RhPolicyInput{status: status.u8(), num: num, den: den, sample: sample, age_secs: age, complete: comp})
                child <- nodes[child.usize()].next_sibling
            0

        # Align inputs to rules by rule id. Rules without a supplied input get an
        # `unavailable` input (engine -> UNKNOWN) and their id is recorded in
        # missing_out. aligned is fully populated at rules.count.
        def rh_policy_align(rules: darray[Policy::RhRule]&, in_ids: darray[i64]&, inputs: darray[Policy::RhPolicyInput]&, aligned: mutable darray[Policy::RhPolicyInput]&, missing_out: mutable darray[i64]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            while ii < in_ids.count |ii: usize = 0, in_ids, rules|:
                found_rule: bool =
                    while ri < rules.count |found_rule: bool = false, ri: usize = 0, rules, in_ids, ii| -> found_rule:
                        found_rule <- found_rule or rules[ri].id == in_ids[ii]
                        ri <- ri + 1
                return -1 if not found_rule
                ii <- ii + 1
            while i < rules.count |i: usize = 0, rules, in_ids, inputs, aligned, missing_out|:
                rid: i64 = rules[i].id
                found: i64 =
                    while j < in_ids.count |found: i64 = -1, j: usize = 0| -> found:
                        if in_ids[j] == rid:
                            found <- j.i64()
                        j <- j + 1
                if found >= 0:
                    inp: Policy::RhPolicyInput = inputs[found.usize()]
                    aligned.push(inp)
                else:
                    aligned.push(Policy::RhPolicyInput{status: Observation::RH_ST_UNAVAILABLE, num: 0, den: 1, sample: 0, age_secs: 0, complete: false})
                    missing_out.push(rid)
                i <- i + 1
            0

        # --- Durable exception state (M06-06). ---
        # Persist approved/revoked exceptions across runs under an
        # `rh-policy-state/1` document, so an approved waiver survives process
        # restart and an *expired* waiver is re-evaluated (never silently renewed).
        # An empty buffer is a fresh (empty) state; malformed state fails closed.

        def rh_pp_exc_state(texts: darray[u8]&, s: i64, e: i64) -> i64:
            return 0 if rh_pp_eq(texts, s, e, "approved")
            return 1 if rh_pp_eq(texts, s, e, "revoked")
            -1

        def rh_policy_state_parse(raw: darray[u8]&, excs: mutable darray[Policy::RhException]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 0 if raw.count == 0
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            rows: i64 = |nodes, texts|
                root: i64 = Json::rh_json_parse(raw, nodes, texts)
                return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
                ss: mutable i64 = 0
                se: mutable i64 = 0
                return -1 if not rh_pp_str(nodes, texts, root, "schema", &ss, &se)
                return -1 if not rh_pp_eq(texts, ss, se, "rh-policy-state/1")
                block_result: i64 = Json::rh_json_obj_get(nodes, texts, root, "exceptions")
                block_result
            return -1 if rows < 0 or nodes[rows.usize()].kind != Json::RH_JSON_ARR
            arr: Json::RhJsonNode = nodes[rows.usize()]
            while child >= 0 |child: i64 = arr.first_child, nodes, texts, raw, excs|:
                return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                okr: mutable i64 = 0
                oks: mutable i64 = 0
                oke: mutable i64 = 0
                rid: mutable i64 = rh_pp_int(nodes, raw, texts, child, "rule_id", &okr)
                sub: mutable i64 = rh_pp_int(nodes, raw, texts, child, "subject_id", &oks)
                exp: i64 = rh_pp_int(nodes, raw, texts, child, "expires_at", &oke)
                return -1 if okr == 0 or oks == 0 or oke == 0
                dgs: mutable i64 = 0
                dge: mutable i64 = 0
                hi: mutable u64 = 0
                if rh_pp_str(nodes, texts, child, "digest", &dgs, &dge):
                    okh: mutable i64 = 0
                    hi <- rh_pp_hex64(texts, dgs, dge, &okh)
                    return -1 if okh == 0
                cds: mutable i64 = 0
                cde: mutable i64 = 0
                context_digest: mutable u64 = 0
                if rh_pp_str(nodes, texts, child, "context_digest", &cds, &cde):
                    ok_context: mutable i64 = 0
                    context_digest <- rh_pp_hex64(texts, cds, cde, &ok_context)
                    return -1 if ok_context == 0
                duplicate_exception: bool =
                    while ei < excs.count |duplicate_exception: bool = false, ei: usize = 0, excs, rid, sub, hi, context_digest| -> duplicate_exception:
                        duplicate_exception <- duplicate_exception or (excs[ei].rule_id == rid and excs[ei].subject_id == sub and excs[ei].digest_high == hi and excs[ei].digest_low == 0 and excs[ei].context_digest == context_digest)
                        ei <- ei + 1
                return -1 if duplicate_exception
                st: i64 = |nodes, texts|
                    sts: mutable i64 = 0
                    ste: mutable i64 = 0
                    return -1 if not rh_pp_str(nodes, texts, child, "state", &sts, &ste)
                    block_result: i64 = rh_pp_exc_state(texts, sts, ste)
                    block_result
                return -1 if st < 0
                excs.push(Policy::RhException{rule_id: rid, subject_id: sub, digest_high: hi, digest_low: 0, context_digest: context_digest, expires_at: exp, state: st.u8()})
                child <- nodes[child.usize()].next_sibling
            0

        def rh_pp_push_exc_state(out: mutable darray[u8]&, st: u8) -> void:
            if st == 0:
                Base::rh_push_text(out, "approved")
            else:
                Base::rh_push_text(out, "revoked")

        def rh_policy_state_emit(excs: darray[Policy::RhException]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-policy-state/1\",\"exceptions\":[")
            while i < excs.count |i: usize = 0, excs, out|:
                x: Policy::RhException = excs[i]
                if i > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"rule_id\":")
                Base::rh_push_decimal_i64(out, x.rule_id)
                Base::rh_push_text(out, ",\"subject_id\":")
                Base::rh_push_decimal_i64(out, x.subject_id)
                Base::rh_push_text(out, ",\"digest\":\"")
                Base::rh_push_hex_u64(out, x.digest_high)
                Base::rh_push_text(out, "\",\"context_digest\":\"")
                Base::rh_push_hex_u64(out, x.context_digest)
                Base::rh_push_text(out, "\",\"expires_at\":")
                Base::rh_push_decimal_i64(out, x.expires_at)
                Base::rh_push_text(out, ",\"state\":\"")
                rh_pp_push_exc_state(out, x.state)
                Base::rh_push_text(out, "\"}")
                i <- i + 1
            Base::rh_push_text(out, "]}")
