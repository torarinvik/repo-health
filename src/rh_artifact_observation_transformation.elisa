# Field transformation contract for local package artifact observations.
include "./rh_base.elisa"
include "./rh_json.elisa"

module ArtifactObservationTransformation:
    public:
        def rh_artifact_observation_transformation_report(configuration_sha: darray[u8]&, graph_sha: darray[u8]&, artifact_sha: darray[u8]&, output_sha: darray[u8]&, observation: darray[u8]&, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(observation, nodes, texts)
            return false if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "schema")
            schema_start: mutable i64 = 0
            schema_end: mutable i64 = 0
            return false if not Json::rh_json_str_span(nodes, schema_idx, &schema_start, &schema_end)
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"local-artifact-byte-observation\",\"source_input_sha256\":\"")
            out.extend(bytes_view(graph_sha))
            Base::rh_push_text(out, "\",\"source_artifact_sha256\":\"")
            out.extend(bytes_view(artifact_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"")
            Base::rh_json_escape(out, texts, schema_start.usize(), schema_end.usize())
            Base::rh_push_text(out, "\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"graph-local artifact id and package node\",\"target\":\"observation.artifact_id|package_node\",\"state\":\"preserved\"},{\"source\":\"lockfile expected integrity\",\"target\":\"observation.expected_digest\",\"state\":\"preserved\"},{\"source\":\"local artifact bytes\",\"target\":\"observation.observed_digest\",\"state\":\"transformed\"},{\"source\":\"expected and observed integrity comparison\",\"target\":\"observation.identity_state\",\"state\":\"transformed\"},{\"source\":\"archive entries and local filesystem path\",\"target\":\"published observation\",\"state\":\"discarded\"},{\"source\":\"provider metadata outside the artifact record\",\"target\":\"observation result\",\"state\":\"unsupported\"}]}")
            true
