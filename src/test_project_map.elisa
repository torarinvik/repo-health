# Fast contract oracle for reviewed graph-bound project identity maps.
include "./rh_base.elisa"
include "./rh_project_map.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    graph: mutable darray[u8] = []
    Base::rh_push_text(graph, "{\"schema\":\"rh-dep-graph/1\",\"ecosystem\":\"test\",\"nodes\":[{\"id\":0,\"name\":\"focus\",\"version\":\"1\"},{\"id\":1,\"name\":\"consumer\",\"version\":\"2\"}],\"edges\":[{\"from\":1,\"to\":0,\"scope\":\"normal\"}],\"unresolved\":[],\"advisories\":[]}")
    mapping: mutable darray[u8] = []
    Base::rh_push_text(mapping, "{\"schema\":\"rh-project-node-map-input/1\",\"graph_sha256\":\"0d0d9553f3e74dd65c08dc2c4e3d2341d9e6dcd6296cc82061d493de0d87ea09\",\"revision\":12,\"mappings\":[{\"node_id\":1,\"project_id\":\"forge:acme/consumer\",\"family_id\":\"acme-consumer\",\"state\":\"accepted\",\"reviewer_id\":42,\"reviewed_at\":1700000000,\"evidence_sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"}]}")
    output: mutable darray[u8] = []
    status: i64 = ProjectMap::rh_project_map_report(graph, mapping, output)
    return 1 if status != 0
    0
