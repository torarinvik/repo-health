# rh_base64.elisa — bounded RFC 4648 Base64 encoding for byte digests.

module Base64:
    public:
        def rh_base64(data: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            alphabet: u8& = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
            while index < data.count |index: usize = 0, data, out, alphabet|:
                a: u32 = data[index].u32()
                has_b: bool = index + 1 < data.count
                has_c: bool = index + 2 < data.count
                b: mutable u32 = 0
                c: mutable u32 = 0
                b <- data[index + 1].u32() if has_b
                c <- data[index + 2].u32() if has_c
                triplet: u32 = (a << 16) | (b << 8) | c
                out.push(alphabet[((triplet >> 18) & 63).usize()])
                out.push(alphabet[((triplet >> 12) & 63).usize()])
                out.push(alphabet[((triplet >> 6) & 63).usize()]) if has_b
                out.push(61) if not has_b
                out.push(alphabet[(triplet & 63).usize()]) if has_c
                out.push(61) if not has_c
                index <- index + 3
