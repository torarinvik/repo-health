# Field transformation contract for structured external findings.
include "./rh_base.elisa"

module FindingsTransformation:
    public:
        def rh_findings_transformation_report(configuration_sha: darray[u8]&, input_sha: darray[u8]&, output_sha: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"scorecard-findings\",\"source_input_sha256\":\"")
            out.extend(bytes_view(input_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-findings-result/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"assessment identity, tool/version, subject revision, and assessment time\",\"target\":\"assessment\",\"state\":\"preserved\"},{\"source\":\"delivery paths\",\"target\":\"delivery_paths\",\"state\":\"preserved\"},{\"source\":\"typed check/probe outcomes, polarity, locations, and remediation\",\"target\":\"findings\",\"state\":\"preserved\"},{\"source\":\"outcome counts\",\"target\":\"summary\",\"state\":\"transformed\"},{\"source\":\"unrecognized provider fields\",\"target\":\"rh-findings-result/1\",\"state\":\"discarded\"},{\"source\":\"source payload and transformation metadata are local evidence references\",\"target\":\"public findings result\",\"state\":\"unsupported\"}]}")
