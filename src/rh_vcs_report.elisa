# rh_vcs_report.elisa — M08 native-VCS / non-PR execution path (R025).
#
# `hg`: parse `hg log -Tjson` into `rh-vcs/1`. The Mercurial `node` is the
# native id (40 lowercase hex; a 64-hex SHA-256 shape is rejected), the
# integer `rev` is repository-local and never identity, the author string is
# raw evidence (not an account), tags are counted but never called releases,
# and malformed entries are rejected, not guessed.
#
# `patch`: parse an mbox-like series into `rh-patch/1`. Messages are split
# at `From ` lines; each `Subject:` is parsed for `[PATCH vN i/total]` and
# trailers in the body are counted. N revisions of one patch base are ONE
# logical change (a 3x-revised series is not three changes); `Fixes:` is a
# claim, not confirmed reachability; a non-patch message is never forced
# into a series.
#
# `svn`: parse `svn log --xml -v` into `rh-vcs/1`. A Subversion revision is
# a REPOSITORY-GLOBAL counter that may touch paths in several projects, so
# it is never summed as one change per project; the author string is raw
# evidence (not an account); path actions are counted per revision.
#
# `fossil`: parse `fossil timeline -F "%H|%a|%d|%b|%p|%t|%c"` into
# `rh-vcs/1`. The check-in artifact id is a FOSSIL hash (SHA-1 40 or
# SHA-256 64 hex), never a Git hash and never converted; the author login
# is raw evidence; phase tokens and tags are counted, not interpreted.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_vcs_hg.elisa"
include "./rh_vcs_svn.elisa"
include "./rh_vcs_fossil.elisa"
include "./rh_patch.elisa"
include "./rh_gerrit.elisa"

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_vcs_emit(data: darray[u8]&, out: mutable darray[u8]&, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
    if s >= 0 and e >= s and e <= data.count.i64():
        rh_json_escape(out, data, s.usize(), e.usize())

def rh_vcs_hg_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    pool: mutable darray[u8] = []
    changes: mutable darray[RhHgChange] = []
    rej: mutable i64 = 0
    return -1 if rh_hg_parse(raw, 0, pool, changes, &rej) != 0
    rh_push_text(out, "{\"schema\":\"rh-vcs/1\",\"format\":\"hg\",\"changes\":[")
    while i < changes.count.i64() |i: i64 = 0, changes, pool, out|:
        c: RhHgChange = changes[i.usize()]
        if i > 0:
            out.push(44)
        rh_push_text(out, "{\"node\":\"")
        rh_vcs_emit(pool, out, c.node_s, c.node_e)
        rh_push_text(out, "\",\"rev\":")
        rh_push_decimal_i64(out, c.rev)
        rh_push_text(out, ",\"author\":\"")
        rh_vcs_emit(pool, out, c.author_s, c.author_e)
        rh_push_text(out, "\",\"utc\":")
        rh_push_decimal_i64(out, c.utc)
        rh_push_text(out, ",\"tz_offset\":")
        rh_push_decimal_i64(out, c.tz_offset)
        rh_push_text(out, ",\"has_date\":")
        if c.has_date == 1:
            rh_push_text(out, "true")
        else:
            rh_push_text(out, "false")
        rh_push_text(out, ",\"branch\":\"")
        rh_vcs_emit(pool, out, c.branch_s, c.branch_e)
        rh_push_text(out, "\",\"tag_count\":")
        rh_push_decimal_i64(out, c.tag_count)
        rh_push_text(out, ",\"phase\":\"")
        rh_push_text(out, rh_hg_phase_label(c.phase))
        rh_push_text(out, "\"}")
        i <- i + 1
    rh_push_text(out, "],\"rejected\":")
    rh_push_decimal_i64(out, rej)
    rh_push_text(out, ",\"note\":\"node is the native Mercurial id; rev is repository-local and not identity; author is a raw string, not an account; tags are not releases\"}")
    0

def rh_vcs_svn_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    log: RhSvnLog = rh_svn_parse(raw, 0)
    return -1 if log.ok != 1
    rh_push_text(out, "{\"schema\":\"rh-vcs/1\",\"format\":\"svn\",\"entries\":[")
    while i < log.entries.count.i64() |i: i64 = 0, log, out|:
        e: RhSvnEntry = log.entries[i.usize()]
        if i > 0:
            out.push(44)
        rh_push_text(out, "{\"revision\":")
        rh_push_decimal_i64(out, e.rev)
        rh_push_text(out, ",\"author\":\"")
        rh_vcs_emit(log.pool, out, e.author_s, e.author_e)
        rh_push_text(out, "\",\"has_author\":")
        rh_vcs_bool(out, e.has_author == 1)
        rh_push_text(out, ",\"date\":\"")
        rh_vcs_emit(log.pool, out, e.date_s, e.date_e)
        rh_push_text(out, "\",\"has_date\":")
        rh_vcs_bool(out, e.has_date == 1)
        rh_push_text(out, ",\"msg\":\"")
        rh_vcs_emit(log.pool, out, e.msg_s, e.msg_e)
        rh_push_text(out, "\",\"path_count\":")
        rh_push_decimal_i64(out, e.path_count)
        rh_push_text(out, ",\"add\":")
        rh_push_decimal_i64(out, e.add_n)
        rh_push_text(out, ",\"modify\":")
        rh_push_decimal_i64(out, e.modify_n)
        rh_push_text(out, ",\"delete\":")
        rh_push_decimal_i64(out, e.delete_n)
        rh_push_text(out, ",\"replace\":")
        rh_push_decimal_i64(out, e.replace_n)
        rh_push_text(out, ",\"other\":")
        rh_push_decimal_i64(out, e.other_n)
        rh_push_text(out, "}")
        i <- i + 1
    rh_push_text(out, "],\"rejected\":")
    rh_push_decimal_i64(out, log.rejected)
    rh_push_text(out, ",\"note\":\"revision is a repository-global counter, not a per-project change count; author is a raw string, not an account; path actions are counts, not semantics\"}")
    0

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_vcs_bool(out: mutable darray[u8]&, value: bool) -> void can[Memory.Allocate, Abort.Panic]:
    if value:
        rh_push_text(out, "true")
    else:
        rh_push_text(out, "false")

def rh_vcs_fossil_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    pool: mutable darray[u8] = []
    entries: mutable darray[RhFossilEntry] = []
    rej: mutable i64 = 0
    return -1 if rh_fossil_parse(raw, 0, pool, entries, &rej) != 0
    rh_push_text(out, "{\"schema\":\"rh-vcs/1\",\"format\":\"fossil\",\"entries\":[")
    while i < entries.count.i64() |i: i64 = 0, entries, pool, out|:
        e: RhFossilEntry = entries[i.usize()]
        if i > 0:
            out.push(44)
        rh_push_text(out, "{\"artifact\":\"")
        rh_vcs_emit(pool, out, e.hash_s, e.hash_e)
        rh_push_text(out, "\",\"author\":\"")
        rh_vcs_emit(pool, out, e.author_s, e.author_e)
        rh_push_text(out, "\",\"has_author\":")
        rh_vcs_bool(out, e.has_author == 1)
        rh_push_text(out, ",\"date\":\"")
        rh_vcs_emit(pool, out, e.date_s, e.date_e)
        rh_push_text(out, "\",\"has_date\":")
        rh_vcs_bool(out, e.has_date == 1)
        rh_push_text(out, ",\"utc\":")
        rh_push_decimal_i64(out, e.utc)
        rh_push_text(out, ",\"branch\":\"")
        rh_vcs_emit(pool, out, e.branch_s, e.branch_e)
        rh_push_text(out, "\",\"tag_count\":")
        rh_push_decimal_i64(out, e.tag_count)
        rh_push_text(out, ",\"phase_count\":")
        rh_push_decimal_i64(out, e.phase_count)
        rh_push_text(out, ",\"comment\":\"")
        rh_vcs_emit(pool, out, e.comment_s, e.comment_e)
        rh_push_text(out, "\"}")
        i <- i + 1
    rh_push_text(out, "],\"rejected\":")
    rh_push_decimal_i64(out, rej)
    rh_push_text(out, ",\"note\":\"artifact is the native Fossil check-in id (SHA-1/SHA-256), never a Git hash; author is a raw login, not an account; phase tokens and tags are counts, not semantics\"}")
    0

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_vcs_from_line(data: darray[u8]&, s: i64) -> bool can[Memory.Allocate, Abort.Panic]:
    return false if s < 0 or s + 5 > data.count.i64()
    data[s.usize()] == 70 and data[(s + 1).usize()] == 114 and data[(s + 2).usize()] == 111 and data[(s + 3).usize()] == 109 and data[(s + 4).usize()] == 32

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_vcs_line_eq_ci(data: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: i64 = strlen(lit).i64()
    return false if s < 0 or e - s != n
    while k < n |k: i64 = 0, data, lit, s|:
        a: mutable u8 = data[(s + k).usize()]
        b: mutable u8 = lit[k.usize()]
        if a >= 65 and a <= 90:
            a <- a + 32
        if b >= 65 and b <= 90:
            b <- b + 32
        return false if a != b
        k <- k + 1
    true

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_vcs_count_kind(tl: darray[RhTrailer]&, kind: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
    while i < tl.count |total: i64 = 0, i: usize = 0| -> total:
        if tl[i].kind == kind:
            total <- total + 1
        i <- i + 1

def rh_vcs_patch_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    return -1 if raw.count == 0
    starts: mutable darray[i64] = []
    if rh_vcs_from_line(raw, 0):
        starts.push(0)
    while pos < raw.count.i64() |pos: i64 = 0, raw, starts|:
        if pos > 0 and raw[pos.usize()] == 70 and raw[(pos - 1).usize()] == 10:
            if rh_vcs_from_line(raw, pos):
                starts.push(pos)
        pos <- pos + 1
    if starts.count == 0:
        starts.push(0)
    subs: mutable darray[RhPatchSubject] = []
    rev_by: mutable darray[i64] = []
    ack_by: mutable darray[i64] = []
    test_by: mutable darray[i64] = []
    fixes_n: mutable darray[i64] = []
    link_n: mutable darray[i64] = []
    other_n: mutable darray[i64] = []
    approvers: mutable darray[i64] = []
    while m < starts.count.i64() |m: i64 = 0, starts, raw, subs, rev_by, ack_by, test_by, fixes_n, link_n, other_n, approvers|:
        ms: i64 = starts[m.usize()]
        me: i64 = starts[(m + 1).usize()] if m + 1 < starts.count.i64() else raw.count.i64()
        # Subject header value span.
        ss, se, body_s =
            while l < me |ss: i64 = -1, se: i64 = -1, body_s: i64 = -1, l: i64 = ms| -> ss, se, body_s:
                le: mutable i64 =
                    while not done |le: i64 = l, done: bool = false| -> le:
                        if le >= me:
                            done <- true
                        elif raw[le.usize()] == 10:
                            done <- true
                        else:
                            le <- le + 1
                line_len: i64 = le - l
                if body_s < 0:
                    if line_len == 0:
                        body_s <- le + 1
                    elif line_len > 8:
                        if rh_vcs_line_eq_ci(raw, l, l + 8, "Subject:"):
                            vs: i64 =
                                while not vs_done |vs: i64 = l + 8, vs_done: bool = false, le| -> vs:
                                    if vs >= le:
                                        vs_done <- true
                                    elif raw[vs.usize()] != 32:
                                        vs_done <- true
                                    else:
                                        vs <- vs + 1
                            ss <- vs
                            se <- le
                l <- le + 1
        if ss >= 0:
            subs.push(rh_patch_parse(raw, ss, se))
        else:
            subs.push(RhPatchSubject{ok: 0, version: 0, index: 0, total: 0, base_s: -1, base_e: -1})
        # Trailers from the body.
        rv: mutable i64 = 0
        ak: mutable i64 = 0
        ts: mutable i64 = 0
        fx: mutable i64 = 0
        lk: mutable i64 = 0
        ot: mutable i64 = 0
        ap: mutable i64 = 0
        if body_s >= 0 and body_s < me:
            bodybuf: mutable darray[u8] = []
            while k < me |k: i64 = body_s, raw, me, bodybuf|:
                bodybuf.push(raw[k.usize()])
                k <- k + 1
            tl: mutable darray[RhTrailer] = []
            _ = rh_trailers_scan(bodybuf, 100000, tl)
            rv <- rh_vcs_count_kind(tl, RH_TRAILER_REVIEWED)
            ak <- rh_vcs_count_kind(tl, RH_TRAILER_ACKED)
            ts <- rh_vcs_count_kind(tl, RH_TRAILER_TESTED)
            fx <- rh_vcs_count_kind(tl, RH_TRAILER_FIXES)
            lk <- rh_vcs_count_kind(tl, RH_TRAILER_LINK)
            ot <- rh_vcs_count_kind(tl, RH_TRAILER_OTHER)
            ap <- rh_trailer_distinct_approvers(tl, bodybuf)
        rev_by.push(rv)
        ack_by.push(ak)
        test_by.push(ts)
        fixes_n.push(fx)
        link_n.push(lk)
        other_n.push(ot)
        approvers.push(ap)
        m <- m + 1
    logical: i64 = rh_patch_logical_count(raw, subs)
    rh_push_text(out, "{\"schema\":\"rh-patch/1\",\"messages\":[")
    while i2 < subs.count.i64() |i2: i64 = 0, subs, rev_by, ack_by, test_by, fixes_n, link_n, other_n, approvers, out|:
        s2: RhPatchSubject = subs[i2.usize()]
        if i2 > 0:
            out.push(44)
        rh_push_text(out, "{\"message_index\":")
        rh_push_decimal_i64(out, i2)
        rh_push_text(out, ",\"is_patch\":")
        if s2.ok == 1:
            rh_push_text(out, "true")
        else:
            rh_push_text(out, "false")
        rh_push_text(out, ",\"version\":")
        rh_push_decimal_i64(out, s2.version)
        rh_push_text(out, ",\"series_index\":")
        rh_push_decimal_i64(out, s2.index)
        rh_push_text(out, ",\"series_total\":")
        rh_push_decimal_i64(out, s2.total)
        rh_push_text(out, ",\"reviewed_by\":")
        rh_push_decimal_i64(out, rev_by[i2.usize()])
        rh_push_text(out, ",\"acked_by\":")
        rh_push_decimal_i64(out, ack_by[i2.usize()])
        rh_push_text(out, ",\"tested_by\":")
        rh_push_decimal_i64(out, test_by[i2.usize()])
        rh_push_text(out, ",\"fixes_claims\":")
        rh_push_decimal_i64(out, fixes_n[i2.usize()])
        rh_push_text(out, ",\"links\":")
        rh_push_decimal_i64(out, link_n[i2.usize()])
        rh_push_text(out, ",\"other_trailers\":")
        rh_push_decimal_i64(out, other_n[i2.usize()])
        rh_push_text(out, ",\"distinct_approvers\":")
        rh_push_decimal_i64(out, approvers[i2.usize()])
        rh_push_text(out, "}")
        i2 <- i2 + 1
    rh_push_text(out, "],\"logical_changes\":")
    rh_push_decimal_i64(out, logical)
    rh_push_text(out, ",\"note\":\"revisions of one patch base are ONE logical change; Fixes: is a claim, not confirmed reachability; a non-patch message is never forced into a series\"}")
    0

# format: 0 hg, 1 patch, 2 svn, 3 fossil.
def rh_vcs_report(raw: darray[u8]&, format: u8, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    return rh_vcs_hg_report(raw, out) if format == 0
    return rh_vcs_svn_report(raw, out) if format == 2
    return rh_vcs_fossil_report(raw, out) if format == 3
    return rh_gerrit_report(raw, out) if format == 4
    rh_vcs_patch_report(raw, out)
