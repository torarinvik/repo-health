# test_http.elisa — M06-01 HTTP wire protocol (parse/route/status).
# Deterministic, offline: no socket is bound here; the listener loop is
# covered by structure + a manual run. This exercises the exact functions
# the listener uses, so the request-line parser and routing cannot regress.
include "./rh_base.elisa"
include "./rh_http.elisa"

def hcheck(cond: bool, label: u8&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    if cond:
        return
    fails[0] <- fails[0] + 1
    b: mutable darray[u8] = []
    rh_push_text(b, "HTTP-FAIL ")
    rh_push_text(b, label)
    b.push(10)
    rh_write_stdout(b)

def req(text: u8&) -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    b: mutable darray[u8] = []
    rh_push_text(b, text)
    return b

def status_of(text: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
    raw: darray[u8] = req(text)
    r: RhHttpRequest = rh_http_parse_request_line(raw)
    return rh_http_status_for(r, raw)

def main() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    fails: mutable i64 = 0

    # allowed GETs
    hcheck(status_of("GET / HTTP/1.1\r\nHost: x\r\n\r\n") == RH_HTTP_OK, "get-root-ok", &fails)
    hcheck(status_of("GET /index.html HTTP/1.1\r\n\r\n") == RH_HTTP_OK, "get-index-ok", &fails)
    hcheck(status_of("GET /report.json HTTP/1.1\r\n\r\n") == RH_HTTP_OK, "get-report-ok", &fails)
    hcheck(status_of("GET /report.md HTTP/1.1\r\n\r\n") == RH_HTTP_OK, "get-md-ok", &fails)
    hcheck(status_of("GET /bundle.manifest HTTP/1.1\r\n\r\n") == RH_HTTP_OK, "get-manifest-ok", &fails)
    hcheck(status_of("GET /health HTTP/1.1\r\n\r\n") == RH_HTTP_OK, "get-health-ok", &fails)
    hcheck(status_of("HEAD /report.json HTTP/1.1\r\n\r\n") == RH_HTTP_OK, "head-ok", &fails)

    # unknown path -> 404
    hcheck(status_of("GET /etc/passwd HTTP/1.1\r\n\r\n") == RH_HTTP_NOT_FOUND, "unknown-404", &fails)
    hcheck(status_of("GET /report.json.bak HTTP/1.1\r\n\r\n") == RH_HTTP_NOT_FOUND, "suffix-404", &fails)
    hcheck(status_of("GET /secret HTTP/1.1\r\n\r\n") == RH_HTTP_NOT_FOUND, "secret-404", &fails)

    # path traversal / absolute -> 400 (rejected at parse)
    hcheck(status_of("GET /../etc/passwd HTTP/1.1\r\n\r\n") == RH_HTTP_BAD_REQUEST, "traversal-400", &fails)
    hcheck(status_of("GET /report.json/../../x HTTP/1.1\r\n\r\n") == RH_HTTP_BAD_REQUEST, "nested-traversal-400", &fails)
    hcheck(status_of("GET report.json HTTP/1.1\r\n\r\n") == RH_HTTP_BAD_REQUEST, "no-leading-slash-400", &fails)
    hcheck(status_of("") == RH_HTTP_BAD_REQUEST, "empty-400", &fails)

    # methods other than GET/HEAD -> 405 (only for an allowed path)
    hcheck(status_of("POST /report.json HTTP/1.1\r\n\r\n") == RH_HTTP_METHOD_NOT_ALLOWED, "post-405", &fails)
    hcheck(status_of("DELETE / HTTP/1.1\r\n\r\n") == RH_HTTP_METHOD_NOT_ALLOWED, "delete-405", &fails)

    # Method is validated before the path allowlist, so an unsupported
    # method is 405 regardless of path; the path table is never probed for
    # a disallowed method. (This is the implemented, stricter order.)
    hcheck(status_of("POST /secret HTTP/1.1\r\n\r\n") == RH_HTTP_METHOD_NOT_ALLOWED, "method-before-path-405", &fails)

    # request line with NUL is rejected
    nul: mutable darray[u8] = []
    rh_push_text(nul, "GET /a")
    nul.push(0)
    rh_push_text(nul, "b HTTP/1.1\r\n\r\n")
    rn: RhHttpRequest = rh_http_parse_request_line(nul)
    hcheck(rn.ok == 0, "nul-rejected", &fails)

    # response head is well-formed and never echoes the path
    head: mutable darray[u8] = []
    rh_http_head(RH_HTTP_NOT_FOUND, "text/plain; charset=utf-8", 0, head)
    head_ok: mutable bool = false
    i: mutable usize = 0
    while i < head.count |i, head|:
        if head[i] == 13 and i + 1 < head.count and head[i + 1] == 10:
            head_ok <- true
        i <- i + 1
    hcheck(head_ok, "head-crlf", &fails)
    hcheck(not rh_contains_bytes(head, "/etc/passwd"), "head-no-echo", &fails)

    if fails == 0:
        b: mutable darray[u8] = []
        rh_push_text(b, "HTTP OK")
        b.push(10)
        rh_write_stdout(b)
        return 0
    return 1
