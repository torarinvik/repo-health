# CLI publication for digest-bound adapter transformation sidecars.
include "./rh_base.elisa"
include "./rh_adapter_transformation.elisa"

module AdapterTransformationCli:
    public:
        def rh_append_evidence_file_frame(out: mutable darray[u8]&,
                                 base_path: cstr,
                                 evidence_suffix: cstr,
                                 label: cstr,
                                 maximum_bytes: i64) -> bool can[Memory.Allocate, Abort.Panic, Blocking.IO, Memory.Release, Unsafe.PointerCast]:
            path: mutable darray[u8] = []
            Base::rh_push_cstr(path, base_path)
            Base::rh_push_text(path, ".")
            Base::rh_push_cstr(path, evidence_suffix)
            path.push(0)
            path_ptr: cstr = (&path[0]).cast[cstr] can Unsafe.PointerCast
            file_size: i64 = Base::rh_file_size(path_ptr)
            return false if file_size > maximum_bytes
            bytes: mutable darray[u8] = []
            read_status: i64 = Base::rh_io_read(path_ptr, bytes)
            Base::rh_push_cstr(out, label)
            out.push(58)
            Base::rh_push_decimal_i64(out, read_status)
            out.push(58)
            Base::rh_push_decimal_i64(out, bytes.count.i64())
            out.push(58)
            out.extend(bytes_view(bytes))
            out.push(10)
            true

        def rh_write_sidecar(input: darray[u8]&,
                             output_with_newline: darray[u8]&,
                             adapter: cstr,
                             output_schema: cstr,
                             configuration_token: cstr,
                             fields_json: cstr,
                             out_path: cstr) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO]:
            report: mutable darray[u8] =
                report: mutable darray[u8] = []
                AdapterTransformation::rh_adapter_transformation_report(adapter, output_schema, configuration_token, input, output_with_newline, fields_json, report)
                report.push(10)
                report
            write_result: bool =
                transformation_path: mutable darray[u8] = []
                Base::rh_push_cstr(transformation_path, out_path)
                Base::rh_push_text(transformation_path, ".transformations.json")
                transformation_path.push(0)
                transformation_ptr: cstr = (&transformation_path[0]).cast[cstr] can Unsafe.PointerCast
                Base::rh_io_write(transformation_ptr, report)
            write_result
