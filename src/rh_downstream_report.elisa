# rh_downstream_report.elisa — M05 downstream execution path.
#
# Reads an `rh-dep-graph/1` document (as written by `rh_cli deps`) and
# produces an `rh-downstream/1` report: direct and bounded transitive
# dependents under a LABELED projection, SCC count for cycles, an optional
# simulated-unavailability scenario, and an explicit truncation flag. A
# truncated result is never a total. Dependents never feed back into
# intrinsic measurements (anti-circularity, R011/R030).
#
# Node ids in rh-dep-graph/1 are their array positions (that is how the
# graph writer emits them), so a node's visibility is looked up by id.
# Private nodes are excluded from the public projection and are never
# enqueued into the frontier (S007/F030).

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_graph.elisa"
include "./rh_downstream.elisa"
include "./rh_observation.elisa"

module DownstreamReport:
    private:
        const RH_DS_PATH_WITNESS_LIMIT: i64 = 16
        const RH_DS_EVIDENCE_NONE: i64 = 0
        const RH_DS_EVIDENCE_GRAPH: i64 = 1
        const RH_DS_EVIDENCE_GRAPH_AND_INTRINSICS: i64 = 2

        def rh_ds_observation(value: Observation::RhMetricValue, status: u8, has_incompleteness: bool, evidence_mode: i64) -> Observation::RhObservation can[Memory.Allocate, Abort.Panic]:
            quality: Observation::RhQualityDimensions = Observation::RhQualityDimensions{
                completeness: Observation::RhCompleteness.Complete if status == Observation::RH_ST_OBSERVED else Observation::RhCompleteness.Partial if status == Observation::RH_ST_PARTIAL else Observation::RhCompleteness.Unknown,
                freshness: Observation::RhFreshness.Unknown,
                validity: Observation::RhValidity.Valid if status == Observation::RH_ST_OBSERVED else Observation::RhValidity.Unknown,
                provenance: Observation::RhProvenanceQuality.EvidenceBacked if evidence_mode != RH_DS_EVIDENCE_NONE else Observation::RhProvenanceQuality.Unknown
            }
            evidence: mutable Observation::RhEvidenceLinks = Observation::rh_evidence_links_empty()
            if evidence_mode == RH_DS_EVIDENCE_GRAPH or evidence_mode == RH_DS_EVIDENCE_GRAPH_AND_INTRINSICS:
                Observation::rh_evidence_links_push_external(&evidence, string_view_slice(bytes_view("graph_source"), 0, 12))
            if evidence_mode == RH_DS_EVIDENCE_GRAPH_AND_INTRINSICS:
                Observation::rh_evidence_links_push_external(&evidence, string_view_slice(bytes_view("intrinsics"), 0, 10))
            Observation::rh_observation_make_with_evidence(status, value, has_incompleteness, quality, evidence)

        def rh_ds_emit_metric(out: mutable darray[u8]&, key: cstr, value: Observation::RhMetricValue, status: u8, has_incompleteness: bool, reason: cstr, evidence_mode: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            observation: Observation::RhObservation = DownstreamReport::rh_ds_observation(value, status, has_incompleteness, evidence_mode)
            Observation::rh_observation_emit_metric(out, key, "1.0.0", reason, observation)

        # Map the dep-graph scope label back to a caller-defined scope byte:
        # 1 runtime/normal, 2 dev, 3 optional, 4 peer. The projection here keeps
        # every scope (Graph::RH_SCOPE_ALL); the label is preserved in the report.
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_ds_scope(texts: darray[u8]&, s: i64, e: i64) -> u8:
            n: i64 = e - s
            if n == 3:
                return 2 if texts[s.usize()] == 100 and texts[(s + 1).usize()] == 101 and texts[(s + 2).usize()] == 118
            if n == 8:
                return 3 if rh_ds_lit(texts, s, e, "optional")
            if n == 4:
                return 4 if rh_ds_lit(texts, s, e, "peer")
            1

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_ds_lit(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: i64 = e - s
            while k < n |k: i64 = 0, texts, lit, s|:
                return false if lit[k.usize()] == 0
                return false if texts[(s + k).usize()] != lit[k.usize()]
                k <- k + 1
            lit[n.usize()] == 0

        def rh_ds_json_strings_equal(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, left: i64, right: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            left_start: mutable i64 = 0
            left_end: mutable i64 = 0
            right_start: mutable i64 = 0
            right_end: mutable i64 = 0
            return false if not Json::rh_json_str_span(nodes, left, &left_start, &left_end)
            return false if not Json::rh_json_str_span(nodes, right, &right_start, &right_end)
            return false if left_end - left_start != right_end - right_start
            for offset in 0..<(left_end - left_start).usize() |offset, texts, left_start, right_start|:
                return false if texts[(left_start.usize() + offset)] != texts[(right_start.usize() + offset)]
            true

        def rh_ds_emit_intrinsic_value(out: mutable darray[u8]&, nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, raw: darray[u8]&, value_node: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            value: Json::RhJsonNode = nodes[value_node.usize()]
            if value.kind == Json::RH_JSON_NUM:
                valid: mutable i64 = 0
                parsed: i64 = Json::rh_json_int(nodes, raw, value_node, &valid)
                return false if valid != 1
                Base::rh_push_decimal_i64(out, parsed)
                return true
            if value.kind == Json::RH_JSON_STR:
                start: mutable i64 = 0
                finish: mutable i64 = 0
                return false if not Json::rh_json_str_span(nodes, value_node, &start, &finish)
                out.push(34)
                Base::rh_json_escape(out, texts, start.usize(), finish.usize())
                out.push(34)
                return true
            false

        # Optional temporal edge fields default to an unbounded value. A present
        # field with the wrong JSON type is rejected rather than silently erased.
        def rh_ds_optional_i64(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, raw: darray[u8]&, object: i64, key: u8&, value: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            value[0] <- 0
            field: i64 = Json::rh_json_obj_get(nodes, texts, object, key)
            return true if field < 0
            ok: mutable i64 = 0
            parsed: i64 = Json::rh_json_int(nodes, raw, field, &ok)
            return false if ok != 1 or parsed < 0
            value[0] <- parsed
            true

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_ds_parse_pair(s: u8&, a_out: mutable i64&, b_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            a_out[0] <- -1
            b_out[0] <- -1
            seg, a, b, da, db =
                while s[i] != 0 |seg: i64 = 0, a: i64 = 0, b: i64 = 0, da: i64 = 0, db: i64 = 0, i: usize = 0| -> seg, a, b, da, db:
                    c: u8 = s[i]
                    if c == 58:
                        return false if seg != 0
                        seg <- 1
                    elif c >= 48 and c <= 57:
                        if seg == 0:
                            a <- a * 10 + (c.i64() - 48)
                            da <- da + 1
                        else:
                            b <- b * 10 + (c.i64() - 48)
                            db <- db + 1
                    else:
                        return false
                    i <- i + 1
            return false if seg != 1 or da == 0 or db == 0
            a_out[0] <- a
            b_out[0] <- b
            true

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_ds_id_in(private_ids: darray[i64]&, node: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            while i < private_ids.count |i: usize = 0, private_ids, node|:
                return true if private_ids[i] == node
                i <- i + 1
            false

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_ds_emit_node(out: mutable darray[u8]&, id: i64, nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, name_idx: darray[i64]&, ver_idx: darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"id\":")
            Base::rh_push_decimal_i64(out, id)
            nm: mutable i64 = -1
            vv: mutable i64 = -1
            if id >= 0 and id < name_idx.count.i64():
                nm <- name_idx[id.usize()]
            if id >= 0 and id < ver_idx.count.i64():
                vv <- ver_idx[id.usize()]
            Base::rh_push_text(out, ",\"name\":\"")
            if nm >= 0:
                ns: mutable i64 = 0
                ne: mutable i64 = 0
                if Json::rh_json_str_span(nodes, nm, &ns, &ne):
                    Base::rh_json_escape(out, texts, ns.usize(), ne.usize())
            Base::rh_push_text(out, "\",\"version\":\"")
            if vv >= 0:
                vs: mutable i64 = 0
                ve: mutable i64 = 0
                if Json::rh_json_str_span(nodes, vv, &vs, &ve):
                    Base::rh_json_escape(out, texts, vs.usize(), ve.usize())
            Base::rh_push_text(out, "\"}")

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_ds_emit_list(out: mutable darray[u8]&, ids: darray[i64]&, nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, name_idx: darray[i64]&, ver_idx: darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
            while i < ids.count |i: usize = 0, ids, out, nodes, texts, name_idx, ver_idx|:
                if i > 0:
                    out.push(44)
                rh_ds_emit_node(out, ids[i], nodes, texts, name_idx, ver_idx)
                i <- i + 1

        def rh_ds_emit_path_witnesses(out: mutable darray[u8]&, targets: darray[i64]&, parents: darray[i64]&, subject: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"limit\":")
            Base::rh_push_decimal_i64(out, RH_DS_PATH_WITNESS_LIMIT)
            Base::rh_push_text(out, ",\"truncated\":")
            Base::rh_push_text(out, "true" if targets.count.i64() > RH_DS_PATH_WITNESS_LIMIT else "false")
            Base::rh_push_text(out, ",\"items\":[")
            emitted: mutable i64 = 0
            while i < targets.count and emitted < RH_DS_PATH_WITNESS_LIMIT |i: usize = 0, targets, parents, out, emitted, subject|:
                target: i64 = targets[i]
                i <- i + 1
                path: mutable darray[i64] = []
                return false if not Graph::rh_path_witness(parents, subject, target, path)
                if emitted > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"target\":")
                Base::rh_push_decimal_i64(out, target)
                Base::rh_push_text(out, ",\"path\":[")
                while j < path.count |j: usize = 0, path, out|:
                    if j > 0:
                        out.push(44)
                    Base::rh_push_decimal_i64(out, path[j])
                    j <- j + 1
                Base::rh_push_text(out, "]}")
                emitted <- emitted + 1
            Base::rh_push_text(out, "]}")
            true

        # Emit reviewed identities only for selected traversal candidates. The
        # graph-local node id remains the join key; missing or future reviews
        # are represented as unknown, never inferred from package names.
        def rh_ds_emit_project_identities(out: mutable darray[u8]&, targets: darray[i64]&, project_map_raw: darray[u8]&, has_project_map: bool, known_as_of: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            map_nodes: mutable darray[Json::RhJsonNode] = []
            map_texts: mutable darray[u8] = []
            map_root: mutable i64 = -1
            revision: mutable i64 = 0
            mappings: mutable i64 = -1
            reviewed_count: mutable i64 = 0
            if has_project_map:
                map_root <- Json::rh_json_parse(project_map_raw, map_nodes, map_texts)
                return false if map_root < 0 or map_nodes[map_root.usize()].kind != Json::RH_JSON_OBJ
                schema: i64 = Json::rh_json_obj_get(map_nodes, map_texts, map_root, "schema")
                schema_s: mutable i64 = 0
                schema_e: mutable i64 = 0
                return false if schema < 0 or not Json::rh_json_str_span(map_nodes, schema, &schema_s, &schema_e)
                return false if not Base::rh_bytes_equal_literal(map_texts, schema_s, schema_e, "rh-project-node-map/1")
                revision_ok: mutable i64 = 0
                revision <- Json::rh_json_int(map_nodes, project_map_raw, Json::rh_json_obj_get(map_nodes, map_texts, map_root, "revision"), &revision_ok)
                return false if revision_ok != 1 or revision < 0
                mappings <- Json::rh_json_obj_get(map_nodes, map_texts, map_root, "mappings")
                return false if mappings < 0 or map_nodes[mappings.usize()].kind != Json::RH_JSON_ARR
            Base::rh_push_text(out, "{\"revision\":")
            if has_project_map:
                Base::rh_push_decimal_i64(out, revision)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, ",\"items\":[")
            while target_index < targets.count |target_index: usize = 0, targets, out, map_nodes, map_texts, project_map_raw, has_project_map, known_as_of, mappings, reviewed_count|:
                if target_index > 0:
                    out.push(44)
                target: i64 = targets[target_index]
                match_row: mutable i64 = -1
                if has_project_map:
                    row: mutable i64 = map_nodes[mappings.usize()].first_child
                    while row >= 0 |row, map_nodes, map_texts, project_map_raw, target, known_as_of, match_row|:
                        id_node: i64 = Json::rh_json_obj_get(map_nodes, map_texts, row, "node_id")
                        id_ok: mutable i64 = 0
                        id: i64 = Json::rh_json_int(map_nodes, project_map_raw, id_node, &id_ok)
                        if id_ok == 1 and id == target:
                            reviewed_node: i64 = Json::rh_json_obj_get(map_nodes, map_texts, row, "reviewed_at")
                            reviewed_ok: mutable i64 = 0
                            reviewed_at: i64 = Json::rh_json_int(map_nodes, project_map_raw, reviewed_node, &reviewed_ok)
                            return false if reviewed_ok != 1 or reviewed_at < 0
                            match_row <- row if known_as_of == 0 or reviewed_at <= known_as_of
                            reviewed_count <- reviewed_count + 1 if match_row >= 0
                            row <- -1
                        else:
                            row <- map_nodes[row.usize()].next_sibling
                Base::rh_push_text(out, "{\"graph_node_id\":")
                Base::rh_push_decimal_i64(out, target)
                Base::rh_push_text(out, ",\"mapping_status\":\"")
                Base::rh_push_text(out, "accepted\"") if match_row >= 0 else Base::rh_push_text(out, "unknown\"")
                if match_row >= 0:
                    project_id: i64 = Json::rh_json_obj_get(map_nodes, map_texts, match_row, "project_id")
                    project_s: mutable i64 = 0
                    project_e: mutable i64 = 0
                    return false if project_id < 0 or not Json::rh_json_str_span(map_nodes, project_id, &project_s, &project_e)
                    Base::rh_push_text(out, ",\"project_id\":\"")
                    Base::rh_json_escape(out, map_texts, project_s.usize(), project_e.usize())
                    out.push(34)
                    family_id: i64 = Json::rh_json_obj_get(map_nodes, map_texts, match_row, "family_id")
                    family_s: mutable i64 = 0
                    family_e: mutable i64 = 0
                    return false if family_id < 0 or not Json::rh_json_str_span(map_nodes, family_id, &family_s, &family_e)
                    Base::rh_push_text(out, ",\"family_id\":\"")
                    Base::rh_json_escape(out, map_texts, family_s.usize(), family_e.usize())
                    out.push(34)
                    reviewer_value: i64 = Json::rh_json_obj_get(map_nodes, map_texts, match_row, "reviewer_id")
                    reviewer_ok: mutable i64 = 0
                    reviewer_id: i64 = Json::rh_json_int(map_nodes, project_map_raw, reviewer_value, &reviewer_ok)
                    return false if reviewer_ok != 1
                    Base::rh_push_text(out, ",\"reviewer_id\":")
                    Base::rh_push_decimal_i64(out, reviewer_id)
                    reviewed_value: i64 = Json::rh_json_obj_get(map_nodes, map_texts, match_row, "reviewed_at")
                    reviewed_ok: mutable i64 = 0
                    reviewed_at: i64 = Json::rh_json_int(map_nodes, project_map_raw, reviewed_value, &reviewed_ok)
                    return false if reviewed_ok != 1
                    Base::rh_push_text(out, ",\"reviewed_at\":")
                    Base::rh_push_decimal_i64(out, reviewed_at)
                    evidence: i64 = Json::rh_json_obj_get(map_nodes, map_texts, match_row, "evidence_sha256")
                    evidence_s: mutable i64 = 0
                    evidence_e: mutable i64 = 0
                    return false if evidence < 0 or not Json::rh_json_str_span(map_nodes, evidence, &evidence_s, &evidence_e)
                    Base::rh_push_text(out, ",\"evidence_sha256\":\"")
                    Base::rh_json_escape(out, map_texts, evidence_s.usize(), evidence_e.usize())
                    out.push(34)
                else:
                    Base::rh_push_text(out, ",\"project_id\":null,\"family_id\":null,\"reviewer_id\":null,\"reviewed_at\":null,\"evidence_sha256\":null")
                out.push(125)
                target_index <- target_index + 1
            Base::rh_push_text(out, "],\"coverage\":{\"selected\":")
            Base::rh_push_decimal_i64(out, targets.count.i64())
            Base::rh_push_text(out, ",\"accepted\":")
            Base::rh_push_decimal_i64(out, reviewed_count)
            Base::rh_push_text(out, ",\"unknown\":")
            Base::rh_push_decimal_i64(out, targets.count.i64() - reviewed_count)
            Base::rh_push_text(out, "}}")
            true

        # Parse a dep graph and emit a downstream report. Returns:
        #   0 ok, -1 malformed/unsupported shape, -2 subject id not present,
        #   -3 malformed intrinsics document.
        # Explicit valid/known-time or edge filters emit the versioned
        # rh-downstream/2 projection; default callers retain rh-downstream/1.
    public:
        def rh_downstream_report(raw: darray[u8]&, graph_source: cstr, subject: i64, private_ids: darray[i64]&, asserts: darray[Graph::RhAssertion]&, identity_revision: i64, mapping_revision: i64, scope_filter: u8, platform_filter: i64, valid_as_of: i64, known_as_of: i64, schema_version: i64, intr_raw: darray[u8]&, has_intr: bool, project_map_raw: darray[u8]&, has_project_map: bool, max_nodes: i64, max_depth: i64, unavailable: i64, has_unavailable: bool, snapshot_id: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0
            rootn: Json::RhJsonNode = nodes[root.usize()]
            return -1 if rootn.kind != Json::RH_JSON_OBJ
            nodes_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "nodes")
            edges_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "edges")
            return -1 if nodes_idx < 0 or edges_idx < 0
            return -1 if nodes[nodes_idx.usize()].kind != Json::RH_JSON_ARR
            if nodes[edges_idx.usize()].kind != Json::RH_JSON_ARR:
                return -1

            # Node span tables (id == array position), plus visibility.
            name_idx: mutable darray[i64] = []
            ver_idx: mutable darray[i64] = []
            vis: mutable darray[u8] = []
            arr: Json::RhJsonNode = nodes[nodes_idx.usize()]
            while child >= 0 |child: i64 = arr.first_child, nodes, nodes_idx, name_idx, ver_idx, vis, private_ids|:
                c: Json::RhJsonNode = nodes[child.usize()]
                nid: mutable i64 = -1
                if c.kind == Json::RH_JSON_OBJ:
                    idk: i64 = Json::rh_json_obj_get(nodes, texts, child, "id")
                    ok: mutable i64 = 0
                    nid <- Json::rh_json_int(nodes, raw, idk, &ok)
                    nmk: i64 = Json::rh_json_obj_get(nodes, texts, child, "name")
                    vvk: i64 = Json::rh_json_obj_get(nodes, texts, child, "version")
                    while name_idx.count.i64() <= nid |nid, name_idx, ver_idx, vis|:
                        name_idx.push(-1)
                        ver_idx.push(-1)
                        vis.push(Graph::RH_VIS_PUBLIC)
                    if nid >= 0:
                        name_idx[nid.usize()] <- nmk
                        ver_idx[nid.usize()] <- vvk
                        if rh_ds_id_in(private_ids, nid):
                            vis[nid.usize()] <- Graph::RH_VIS_PRIVATE
                child <- nodes[child.usize()].next_sibling

            node_count: i64 = name_idx.count.i64()
            if subject < 0 or subject >= node_count:
                return -2
            while i < asserts.count |i: usize = 0, asserts, node_count|:
                assertion: Graph::RhAssertion = asserts[i]
                return -1 if assertion.a < 0 or assertion.a >= node_count or assertion.b < 0 or assertion.b >= node_count
                i <- i + 1

            # Edges.
            edges: mutable darray[Graph::RhGraphEdge] = []
            earr: Json::RhJsonNode = nodes[edges_idx.usize()]
            while echild >= 0 |echild: i64 = earr.first_child, nodes, edges, texts, raw|:
                ec: Json::RhJsonNode = nodes[echild.usize()]
                if ec.kind == Json::RH_JSON_OBJ:
                    fromk: i64 = Json::rh_json_obj_get(nodes, texts, echild, "from")
                    tok: i64 = Json::rh_json_obj_get(nodes, texts, echild, "to")
                    sc: i64 = Json::rh_json_obj_get(nodes, texts, echild, "scope")
                    okf: mutable i64 = 0
                    okt: mutable i64 = 0
                    frm: i64 = Json::rh_json_int(nodes, raw, fromk, &okf)
                    dst: i64 = Json::rh_json_int(nodes, raw, tok, &okt)
                    scb: mutable u8 = 1
                    if sc >= 0:
                        ss: mutable i64 = 0
                        se: mutable i64 = 0
                        if Json::rh_json_str_span(nodes, sc, &ss, &se):
                            scb <- rh_ds_scope(texts, ss, se)
                    if okf == 1 and okt == 1:
                        edge_platform: mutable i64 = 0
                        introduced: mutable i64 = 0
                        removed: mutable i64 = 0
                        first_seen: mutable i64 = 0
                        return -1 if not rh_ds_optional_i64(nodes, texts, raw, echild, "platform", &edge_platform)
                        return -1 if not rh_ds_optional_i64(nodes, texts, raw, echild, "introduced", &introduced)
                        return -1 if not rh_ds_optional_i64(nodes, texts, raw, echild, "removed", &removed)
                        return -1 if not rh_ds_optional_i64(nodes, texts, raw, echild, "first_seen", &first_seen)
                        return -1 if introduced > 0 and removed > 0 and removed <= introduced
                        edges.push(Graph::RhGraphEdge{from: frm, dst: dst, scope: scb, platform: edge_platform, introduced: introduced, removed: removed, first_seen: first_seen})
                echild <- nodes[echild.usize()].next_sibling

            # Apply reviewed identities before traversal. Every edge endpoint
            # and query target uses the accepted representative; private members
            # make the whole group private to avoid leaking their relationships.
            roots: mutable darray[i64] = []
            mapped_vis: mutable darray[u8] = []
            while i < node_count |i: i64 = 0, node_count, roots, mapped_vis, vis, asserts|:
                roots.push(Graph::rh_group_root(asserts, i))
                mapped_vis.push(Graph::RH_VIS_PRIVATE)
                i <- i + 1
            while i < node_count |i: i64 = 0, node_count, roots, mapped_vis, vis|:
                representative: i64 = roots[i.usize()]
                if representative < 0 or representative >= node_count:
                    return -1
                if vis[i.usize()] == Graph::RH_VIS_PRIVATE:
                    mapped_vis[representative.usize()] <- Graph::RH_VIS_PRIVATE
                elif i == representative:
                    mapped_vis[representative.usize()] <- Graph::RH_VIS_PUBLIC
                i <- i + 1
            mapped_edges: mutable darray[Graph::RhGraphEdge] = []
            while i < edges.count |i: usize = 0, edges, roots, mapped_edges|:
                edge: Graph::RhGraphEdge = edges[i]
                return -1 if edge.from < 0 or edge.from >= node_count or edge.dst < 0 or edge.dst >= node_count
                mapped_from: i64 = roots[edge.from.usize()]
                mapped_dst: i64 = roots[edge.dst.usize()]
                if mapped_from != mapped_dst:
                    mapped_edges.push(Graph::RhGraphEdge{from: mapped_from, dst: mapped_dst, scope: edge.scope, platform: edge.platform, introduced: edge.introduced, removed: edge.removed, first_seen: edge.first_seen})
                i <- i + 1
            edges <- mapped_edges
            vis <- mapped_vis
            return -1 if has_unavailable and (unavailable < 0 or unavailable >= node_count or vis[unavailable.usize()] == Graph::RH_VIS_PRIVATE)
            mapped_subject: i64 = roots[subject.usize()]
            mapped_unavailable: i64 = roots[unavailable.usize()] if has_unavailable and unavailable >= 0 and unavailable < node_count else unavailable

            p: mutable Graph::RhProjection = Graph::rh_projection_make(1, scope_filter, platform_filter, valid_as_of, known_as_of, identity_revision, mapping_revision, true, max_nodes, max_depth)
            direct: mutable darray[i64] = []
            dc: i64 = Graph::rh_direct_dependents(edges, vis, mapped_subject, &p, direct)
            trans: mutable darray[i64] = []
            path_parents: mutable darray[i64] = []
            trunc: mutable i64 = 0
            tc: i64 = Graph::rh_transitive_dependents_with_parents(edges, vis, mapped_subject, &p, trans, &trunc, path_parents)
            scc: i64 = Graph::rh_scc_count(edges, vis, node_count, &p)
            cyclic_nodes: i64 = Graph::rh_cyclic_node_count(edges, vis, node_count, &p)
            visible_nodes: i64 =
                while i < node_count |visible_nodes: i64 = 0, i: i64 = 0, vis| -> visible_nodes:
                    visible_nodes <- visible_nodes + 1 if vis.count == 0 or vis[i.usize()] != Graph::RH_VIS_PRIVATE
                    i <- i + 1
            visible_edges: i64 =
                while i < edges.count |visible_edges: i64 = 0, i: i64 = 0, edges, vis, p| -> visible_edges:
                    visible_edges <- visible_edges + 1 if Graph::rh_edge_visible(edges[i.usize()], p, vis)
                    i <- i + 1
            scen: mutable darray[i64] = []
            scenario_parents: mutable darray[i64] = []
            strunc: mutable i64 = 0
            scount: i64 = Graph::rh_scenario_unavailable_with_parents(edges, vis, mapped_subject, mapped_unavailable, &p, scen, &strunc, scenario_parents) if has_unavailable else 0

            # Mirror/family dedup: only ACCEPTED grouping assertions collapse nodes;
            # forks stay distinct. With no assertions this is an order-preserving
            # identity, so the label below records whether grouping was applied.
            direct2: mutable darray[i64] = []
            dc2: i64 = Graph::rh_family_dedup(direct, asserts, direct2)
            trans2: mutable darray[i64] = []
            tc2: i64 = Graph::rh_family_dedup(trans, asserts, trans2)
            scen2: mutable darray[i64] = []
            scount2: i64 = Graph::rh_family_dedup(scen, asserts, scen2)

            # Optional per-metric intrinsic join (R011): the caller supplies
            # independently computed intrinsic measurements (a presence bitmask per
            # dependent node) so downstream condition is never derived from
            # downstream inputs. Coverage stays per metric; a dependent missing a
            # metric is not counted for that metric.
            imetrics: mutable darray[i64] = []
            imask: mutable darray[u64] = []
            icount: mutable i64 = 0
            icounts: mutable darray[i64] = []
            itotal: mutable i64 = 0
            ijoin: mutable bool = false
            intrinsic_values: mutable bool = false
            observation_rows: mutable darray[i64] = []
            if has_intr:
                iroot: i64 = Json::rh_json_parse(intr_raw, nodes, texts)
                return -3 if iroot < 0
                inode: Json::RhJsonNode = nodes[iroot.usize()]
                return -3 if inode.kind != Json::RH_JSON_OBJ
                scheme: i64 = Json::rh_json_obj_get(nodes, texts, iroot, "schema")
                schema_ok: mutable bool = false
                if scheme >= 0:
                    ss: mutable i64 = 0
                    se: mutable i64 = 0
                    if Json::rh_json_str_span(nodes, scheme, &ss, &se):
                        if se - ss == 15:
                            schema_ok <- rh_ds_lit(texts, ss, se, "rh-intrinsics/1") or rh_ds_lit(texts, ss, se, "rh-intrinsics/2")
                            intrinsic_values <- rh_ds_lit(texts, ss, se, "rh-intrinsics/2")
                metrics_idx: i64 = Json::rh_json_obj_get(nodes, texts, iroot, "metrics")
                values_idx: i64 = Json::rh_json_obj_get(nodes, texts, iroot, "values")
                return -3 if not schema_ok or metrics_idx < 0 or values_idx < 0
                return -3 if nodes[metrics_idx.usize()].kind != Json::RH_JSON_ARR or nodes[values_idx.usize()].kind != Json::RH_JSON_ARR
                marr: Json::RhJsonNode = nodes[metrics_idx.usize()]
                while mchild >= 0 |mchild: i64 = marr.first_child, nodes, imetrics, icount|:
                    mc: Json::RhJsonNode = nodes[mchild.usize()]
                    return -3 if mc.kind != Json::RH_JSON_STR
                    metric_start: mutable i64 = 0
                    metric_end: mutable i64 = 0
                    return -3 if not Json::rh_json_str_span(nodes, mchild, &metric_start, &metric_end) or metric_start == metric_end
                    metric_duplicate: bool =
                        for prior in 0..<imetrics.count |prior, duplicate: bool = false, imetrics, nodes, texts, mchild| -> duplicate:
                            duplicate <- true if DownstreamReport::rh_ds_json_strings_equal(nodes, texts, imetrics[prior], mchild)
                    return -3 if metric_duplicate
                    imetrics.push(mchild)
                    icount <- icount + 1
                    mchild <- nodes[mchild.usize()].next_sibling
                # Presence is represented by a signed JSON integer, so only
                # bits 0..62 can be carried without changing its meaning.
                return -3 if icount > 63
                while k < node_count |k: i64 = 0, imask|:
                    imask.push(0)
                    k <- k + 1
                ipresent: mutable darray[u8] = []
                while k < node_count |k: i64 = 0, ipresent|:
                    ipresent.push(0)
                    k <- k + 1
                while k < node_count |k: i64 = 0, observation_rows|:
                    observation_rows.push(-1)
                    k <- k + 1
                varr: Json::RhJsonNode = nodes[values_idx.usize()]
                while vchild >= 0 |vchild: i64 = varr.first_child, nodes, texts, intr_raw, imask, ipresent, observation_rows, node_count, icount, intrinsic_values|:
                    vc: Json::RhJsonNode = nodes[vchild.usize()]
                    return -3 if vc.kind != Json::RH_JSON_OBJ
                    idk: i64 = Json::rh_json_obj_get(nodes, texts, vchild, "id")
                    mkk: i64 = Json::rh_json_obj_get(nodes, texts, vchild, "mask")
                    okid: mutable i64 = 0
                    vid: i64 = Json::rh_json_int(nodes, intr_raw, idk, &okid)
                    okmk: mutable i64 = 0
                    vmk: i64 = Json::rh_json_int(nodes, intr_raw, mkk, &okmk)
                    return -3 if okid != 1 or okmk != 1 or vid < 0 or vid >= node_count or vmk < 0
                    return -3 if ipresent[vid.usize()] != 0
                    return -3 if icount < 63 and vmk.u64() >> icount.usize() != 0
                    if intrinsic_values:
                        observations_idx: i64 = Json::rh_json_obj_get(nodes, texts, vchild, "observations")
                        return -3 if observations_idx < 0 or nodes[observations_idx.usize()].kind != Json::RH_JSON_ARR
                        observations: Json::RhJsonNode = nodes[observations_idx.usize()]
                        return -3 if observations.child_count != icount
                        for metric_index in 0..<icount.usize() |metric_index, nodes, intr_raw, vmk, observations_idx|:
                            observation: i64 = Json::rh_json_arr_get(nodes, observations_idx, metric_index.i64())
                            return -3 if observation < 0
                            item: Json::RhJsonNode = nodes[observation.usize()]
                            has_value: bool = ((vmk.u64() >> metric_index) & 1) != 0
                            return -3 if has_value and item.kind == Json::RH_JSON_NULL
                            return -3 if not has_value and item.kind != Json::RH_JSON_NULL
                            if has_value:
                                return -3 if item.kind != Json::RH_JSON_NUM and item.kind != Json::RH_JSON_STR
                                if item.kind == Json::RH_JSON_NUM:
                                    valid_value: mutable i64 = 0
                                    Json::rh_json_int(nodes, intr_raw, observation, &valid_value)
                                    return -3 if valid_value != 1
                        observation_rows[vid.usize()] <- observations_idx
                    imask[vid.usize()] <- vmk.u64()
                    ipresent[vid.usize()] <- 1
                    vchild <- nodes[vchild.usize()].next_sibling
                Downstream::rh_downstream_coverage(trans2, imask, icount, icounts, &itotal)
                ijoin <- true
            covered_intrinsic: i64 =
                while i < icounts.count |total: i64 = 0, i: usize = 0, icounts| -> total:
                    total <- total + icounts[i]
                    i <- i + 1

            Base::rh_push_text(out, "{\"schema\":\"rh-downstream/")
            Base::rh_push_decimal_i64(out, schema_version)
            Base::rh_push_text(out, "\",\"graph_source\":\"")
            Base::rh_push_cstr(out, graph_source)
            Base::rh_push_text(out, "\",\"subject\":")
            Base::rh_push_decimal_i64(out, mapped_subject)
            Base::rh_push_text(out, ",\"projection\":{\"edge_scope\":\"")
            if schema_version == 1:
                Base::rh_push_text(out, "all")
            elif p.scope_filter == Graph::RH_SCOPE_ALL:
                Base::rh_push_text(out, "all")
            elif p.scope_filter == 1:
                Base::rh_push_text(out, "normal")
            elif p.scope_filter == 2:
                Base::rh_push_text(out, "dev")
            elif p.scope_filter == 3:
                Base::rh_push_text(out, "optional")
            else:
                Base::rh_push_text(out, "peer")
            Base::rh_push_text(out, "\",\"public_only\":true,\"max_nodes\":")
            Base::rh_push_decimal_i64(out, max_nodes)
            Base::rh_push_text(out, ",\"max_depth\":")
            Base::rh_push_decimal_i64(out, max_depth)
            Base::rh_push_text(out, ",\"identity_revision\":")
            Base::rh_push_decimal_i64(out, p.identity_revision)
            Base::rh_push_text(out, ",\"mapping_revision\":")
            Base::rh_push_decimal_i64(out, mapping_revision)
            if schema_version >= 2:
                Base::rh_push_text(out, ",\"platform\":")
                Base::rh_push_decimal_i64(out, p.platform)
                Base::rh_push_text(out, ",\"valid_as_of\":")
                Base::rh_push_decimal_i64(out, p.valid_as_of)
                Base::rh_push_text(out, ",\"known_as_of\":")
                Base::rh_push_decimal_i64(out, p.known_as_of)
                Base::rh_push_text(out, ",\"visible_edge_count\":")
                Base::rh_push_decimal_i64(out, visible_edges)
            Base::rh_push_text(out, ",\"snapshot_id\":")
            if snapshot_id.count > 0:
                out.push(34)
                out.extend(bytes_view(snapshot_id))
                out.push(34)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, "},\"direct\":[")
            rh_ds_emit_list(out, direct2, nodes, texts, name_idx, ver_idx)
            Base::rh_push_text(out, "],\"direct_count\":")
            Base::rh_push_decimal_i64(out, dc2)
            Base::rh_push_text(out, ",\"transitive\":[")
            rh_ds_emit_list(out, trans2, nodes, texts, name_idx, ver_idx)
            Base::rh_push_text(out, "],\"transitive_count\":")
            Base::rh_push_decimal_i64(out, tc2)
            if has_project_map:
                Base::rh_push_text(out, ",\"project_identities\":")
                return -4 if not rh_ds_emit_project_identities(out, trans2, project_map_raw, has_project_map, known_as_of)
            Base::rh_push_text(out, ",\"path_witnesses\":")
            return -1 if not rh_ds_emit_path_witnesses(out, trans, path_parents, mapped_subject)
            Base::rh_push_text(out, ",\"truncated\":")
            if trunc == 1:
                Base::rh_push_text(out, "true")
            else:
                Base::rh_push_text(out, "false")
            Base::rh_push_text(out, ",\"scc_components\":")
            Base::rh_push_decimal_i64(out, scc)
            Base::rh_push_text(out, ",\"grouping\":{\"accepted_assertions\":")
            Base::rh_push_decimal_i64(out, asserts.count.i64())
            Base::rh_push_text(out, ",\"family_dedup\":")
            if asserts.count > 0:
                Base::rh_push_text(out, "true")
            else:
                Base::rh_push_text(out, "false")
            Base::rh_push_text(out, "}")
            Base::rh_push_text(out, ",\"intrinsics\":")
            if ijoin:
                Base::rh_push_text(out, "{\"metrics\":[")
                while mi < imetrics.count |mi: usize = 0, imetrics, out, nodes, texts|:
                    if mi > 0:
                        out.push(44)
                    out.push(34)
                    ms: mutable i64 = 0
                    me: mutable i64 = 0
                    if Json::rh_json_str_span(nodes, imetrics[mi], &ms, &me):
                        Base::rh_json_escape(out, texts, ms.usize(), me.usize())
                    out.push(34)
                    mi <- mi + 1
                Base::rh_push_text(out, "],\"covered\":[")
                while mj < imetrics.count |mj: usize = 0, imetrics, icounts, out, nodes, texts|:
                    if mj > 0:
                        out.push(44)
                    Base::rh_push_text(out, "{\"key\":\"")
                    ms2: mutable i64 = 0
                    me2: mutable i64 = 0
                    if Json::rh_json_str_span(nodes, imetrics[mj], &ms2, &me2):
                        Base::rh_json_escape(out, texts, ms2.usize(), me2.usize())
                    Base::rh_push_text(out, "\",\"observed\":")
                    cnt: i64 = icounts[mj] if mj < icounts.count else 0
                    Base::rh_push_decimal_i64(out, cnt)
                    Base::rh_push_text(out, ",\"distribution\":")
                    if intrinsic_values:
                        Base::rh_push_text(out, "[")
                        sample_count: mutable i64 = 0
                        for dependent_index in 0..<trans2.count |dependent_index, trans2, observation_rows, nodes, out, texts, intr_raw, mj, sample_count|:
                            dependent_id: i64 = trans2[dependent_index]
                            if dependent_id >= 0 and dependent_id < observation_rows.count.i64():
                                row: i64 = observation_rows[dependent_id.usize()]
                                if row >= 0:
                                    observation: i64 = Json::rh_json_arr_get(nodes, row, mj.i64())
                                    if observation >= 0 and nodes[observation.usize()].kind != Json::RH_JSON_NULL:
                                        if sample_count > 0:
                                            out.push(44)
                                        return -3 if not DownstreamReport::rh_ds_emit_intrinsic_value(out, nodes, texts, intr_raw, observation)
                                        sample_count <- sample_count + 1
                        Base::rh_push_text(out, "]")
                    else:
                        Base::rh_push_text(out, "null")
                    Base::rh_push_text(out, "}")
                    mj <- mj + 1
                Base::rh_push_text(out, "],\"dependent_total\":")
                Base::rh_push_decimal_i64(out, itotal)
                Base::rh_push_text(out, ",\"note\":\"per-metric covered denominators over the selected dependent set; distributions are exact scalar observations in deterministic dependent order when supplied; a dependent missing a metric is not counted for that metric; intrinsics are independent of downstream inputs (anti-circularity)\"")
                Base::rh_push_text(out, "}")
            else:
                Base::rh_push_text(out, "null")
            if has_unavailable:
                Base::rh_push_text(out, ",\"scenario\":{\"unavailable\":")
                Base::rh_push_decimal_i64(out, mapped_unavailable)
                Base::rh_push_text(out, ",\"affected\":[")
                rh_ds_emit_list(out, scen2, nodes, texts, name_idx, ver_idx)
                Base::rh_push_text(out, "],\"affected_count\":")
                if strunc == 1:
                    Base::rh_push_text(out, "null")
                else:
                    Base::rh_push_decimal_i64(out, scount2)
                Base::rh_push_text(out, ",\"path_witnesses\":")
                return -1 if not rh_ds_emit_path_witnesses(out, scen, scenario_parents, mapped_subject)
                Base::rh_push_text(out, ",\"truncated\":")
                if strunc == 1:
                    Base::rh_push_text(out, "true")
                else:
                    Base::rh_push_text(out, "false")
                Base::rh_push_text(out, "}")
            else:
                Base::rh_push_text(out, ",\"scenario\":null")
            Base::rh_push_text(out, ",\"metrics\":[")
            cyclic_status: u8 = Observation::RH_ST_OBSERVED if visible_nodes > 0 else Observation::RH_ST_NOT_APPLICABLE
            cyclic_value: Observation::RhMetricValue = Observation::RhMetricValue.Ratio(cyclic_nodes, visible_nodes) if visible_nodes > 0 else Observation::RhMetricValue.Absent
            scenario_status: u8 = Observation::RH_ST_NOT_APPLICABLE if not has_unavailable else Observation::RH_ST_PARTIAL if strunc == 1 else Observation::RH_ST_OBSERVED
            scenario_value: Observation::RhMetricValue = Observation::RhMetricValue.Count(scount2) if has_unavailable and strunc != 1 else Observation::RhMetricValue.Absent
            scenario_reason: cstr = "scenario-not-requested" if not has_unavailable else "scenario-traversal-truncated"
            intrinsic_denominator: i64 = itotal * icount if ijoin and icount > 0 and itotal > 0 else 0
            intrinsic_status: u8 = Observation::RH_ST_OBSERVED if intrinsic_denominator > 0 else Observation::RH_ST_NOT_APPLICABLE
            intrinsic_value: Observation::RhMetricValue = Observation::RhMetricValue.Ratio(covered_intrinsic, intrinsic_denominator) if intrinsic_denominator > 0 else Observation::RhMetricValue.Absent
            return -1 if visible_nodes > 0 and not Observation::rh_ratio_valid(cyclic_nodes, visible_nodes)
            return -1 if intrinsic_denominator > 0 and not Observation::rh_ratio_valid(covered_intrinsic, intrinsic_denominator)
            return -1 if not DownstreamReport::rh_ds_emit_metric(out, "graph.direct_dependents_count", Observation::RhMetricValue.Count(dc2), Observation::RH_ST_OBSERVED, false, "", RH_DS_EVIDENCE_GRAPH)
            out.push(44)
            return -1 if not DownstreamReport::rh_ds_emit_metric(out, "graph.transitive_dependents_count", Observation::RhMetricValue.Count(tc2), Observation::RH_ST_OBSERVED, false, "", RH_DS_EVIDENCE_GRAPH)
            out.push(44)
            return -1 if not DownstreamReport::rh_ds_emit_metric(out, "graph.scc_component_count", Observation::RhMetricValue.Count(scc), Observation::RH_ST_OBSERVED, false, "", RH_DS_EVIDENCE_GRAPH)
            out.push(44)
            return -1 if not DownstreamReport::rh_ds_emit_metric(out, "graph.strongly_connected_components", Observation::RhMetricValue.Count(scc), Observation::RH_ST_OBSERVED, false, "", RH_DS_EVIDENCE_GRAPH)
            out.push(44)
            return -1 if not DownstreamReport::rh_ds_emit_metric(out, "graph.reverse_reachability_count", Observation::RhMetricValue.Count(tc2), Observation::RH_ST_OBSERVED, false, "", RH_DS_EVIDENCE_GRAPH)
            out.push(44)
            return -1 if not DownstreamReport::rh_ds_emit_metric(out, "graph.cyclic_node_share", cyclic_value, cyclic_status, false, "no-visible-nodes", RH_DS_EVIDENCE_GRAPH)
            out.push(44)
            return -1 if not DownstreamReport::rh_ds_emit_metric(out, "graph.traversal_truncated", Observation::RhMetricValue.Boolean(trunc == 1 or strunc == 1), Observation::RH_ST_OBSERVED, false, "", RH_DS_EVIDENCE_GRAPH)
            out.push(44)
            return -1 if not DownstreamReport::rh_ds_emit_metric(out, "graph.scenario_affected_count", scenario_value, scenario_status, strunc == 1 and has_unavailable, scenario_reason, RH_DS_EVIDENCE_GRAPH)
            out.push(44)
            return -1 if not DownstreamReport::rh_ds_emit_metric(out, "downstream_condition.intrinsic_coverage_share", intrinsic_value, intrinsic_status, false, "intrinsic-metrics-not-supplied", RH_DS_EVIDENCE_GRAPH_AND_INTRINSICS if intrinsic_denominator > 0 else RH_DS_EVIDENCE_NONE)
            Base::rh_push_text(out, "],\"note\":\"counts are within the labeled projection; truncated=true means this is NOT a total; private nodes are excluded from the public projection; mirrors/families group only on ACCEPTED assertions and forks stay distinct; dependents do not feed back into intrinsic metrics\"}")
            0

        # Public CLI boundary for the mirror assertion syntax. The parser itself
        # remains private so its representation cannot leak into callers.
        def rh_downstream_parse_mirror_pair(s: u8&, a_out: mutable i64&, b_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_ds_parse_pair(s, a_out, b_out)
