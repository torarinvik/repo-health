include "./rh_postgres.elisa"

def main() -> i32:
    expected: i64 =
        mode: u8&? = getenv("RH_FAKE_PG_EXPECT")
        return 10 if mode == null
        0 if Base::rh_streq(mode, "duplicate") else -1 if Base::rh_streq(mode, "failure") or Base::rh_streq(mode, "connect_failure") or Base::rh_streq(mode, "missing") else 1
    operation: u8&? = getenv("RH_FAKE_PG_OPERATION")
    return 11 if operation == null
    result: i64 =
        if Base::rh_streq(operation, "begin_run"):
            Postgres::rh_pg_begin_collection_run(
                "host=fake dbname=repo_health",
                "00000000-0000-0000-0000-000000000001",
                "github",
                "https://api.github.com",
                "public",
                1,
                "2026-01-01T00:00:00Z",
                "00000000-0000-0000-0000-000000000003",
                "issues",
                "github",
                "1.0.0",
                "",
                "",
                "2026-01-01T00:00:00Z"
            )
        elif Base::rh_streq(operation, "page"):
            Postgres::rh_pg_commit_collection_page(
                "host=fake dbname=repo_health",
                "00000000-0000-0000-0000-000000000001",
                "00000000-0000-0000-0000-000000000002",
                4,
                7,
                "scope ' ; SELECT pg_sleep(60); --",
                "",
                "{\"page\":8}",
                "complete",
                2,
                "",
                "2026-01-01T00:01:00Z"
            )
        elif Base::rh_streq(operation, "page_events"):
            Postgres::rh_pg_commit_collection_page_events(
                "host=fake dbname=repo_health",
                "00000000-0000-0000-0000-000000000001",
                "00000000-0000-0000-0000-000000000002",
                4,
                7,
                "scope ' ; SELECT pg_sleep(60); --",
                "",
                "{\"page\":8}",
                "complete",
                0,
                "",
                "[]",
                "[]",
                "[]",
                "2026-01-01T00:01:00Z"
            )
        elif Base::rh_streq(operation, "evidence"):
            Postgres::rh_pg_register_evidence_object(
                "host=fake dbname=repo_health",
                "00000000-0000-0000-0000-000000000006",
                "public",
                "fe482b5e524c67728f4f2b4f430cd10d9a25659641f995ae537b282ccd181e0b",
                15,
                "text/plain",
                "fnv1a64:f5e19178d3ff184e",
                "standard",
                "captured",
                "2026-01-01T00:00:00Z"
            )
        elif Base::rh_streq(operation, "heartbeat"):
            Postgres::rh_pg_heartbeat_job(
                "host=fake dbname=repo_health",
                "00000000-0000-0000-0000-000000000002",
                4,
                "2026-01-01T00:01:00Z",
                60
            )
        elif Base::rh_streq(operation, "finish"):
            Postgres::rh_pg_finish_job(
                "host=fake dbname=repo_health",
                "00000000-0000-0000-0000-000000000002",
                4,
                "dead_letter",
                "2026-01-01T00:02:00Z",
                "retry-exhausted",
                "malformed"
            )
        elif Base::rh_streq(operation, "claim"):
            job_id: mutable darray[u8] = []
            token: mutable i64 = 0
            expires: mutable darray[u8] = []
            claim_result: i64 = Postgres::rh_pg_claim_next_job(
                "host=fake dbname=repo_health",
                "worker-a",
                "2026-01-01T00:01:00Z",
                60,
                job_id,
                &token,
                expires
            )
            if claim_result == 1:
                job_id_ptr: u8& = (&job_id[0]).cast[u8&] can Unsafe.PointerCast
                return 12 if token != 5 or not Base::rh_streq(job_id_ptr, "00000000-0000-0000-0000-000000000004") or expires.count == 0
            elif claim_result == 0:
                return 13 if token != 0 or job_id.count != 0 or expires.count != 0
            claim_result
        else:
            -2
    return 0 if result == expected
    1
