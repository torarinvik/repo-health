include "./rh_postgres.elisa"

def main() -> i32:
    expected: i64 =
        mode: u8&? = getenv("RH_FAKE_PG_EXPECT")
        return 10 if mode == null
        0 if Base::rh_streq(mode, "duplicate") else -1 if Base::rh_streq(mode, "failure") or Base::rh_streq(mode, "connect_failure") or Base::rh_streq(mode, "missing") else 1
    operation: u8&? = getenv("RH_FAKE_PG_OPERATION")
    return 11 if operation == null
    result: i64 =
        if Base::rh_streq(operation, "page"):
            Postgres::rh_pg_commit_collection_page(
                "host=fake dbname=repo_health",
                "00000000-0000-0000-0000-000000000001",
                7,
                "scope ' ; SELECT pg_sleep(60); --",
                "",
                "{\"page\":8}",
                "complete",
                2,
                "",
                "2026-01-01T00:01:00Z"
            )
        elif Base::rh_streq(operation, "heartbeat"):
            Postgres::rh_pg_heartbeat_job(
                "host=fake dbname=repo_health",
                "00000000-0000-0000-0000-000000000002",
                4,
                "2026-01-01T00:01:00Z",
                60
            )
        elif Base::rh_streq(operation, "finish"):
            Postgres::rh_pg_finish_job(
                "host=fake dbname=repo_health",
                "00000000-0000-0000-0000-000000000002",
                4,
                "dead_letter",
                "2026-01-01T00:02:00Z",
                "retry-exhausted",
                "malformed"
            )
        else:
            -2
    return 0 if result == expected
    1
