# Coverage-guided M07 parser target. The C-facing entry point is deliberately
# the only exported symbol; parser helpers and selector dispatch stay private.
include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_package.elisa"
include "./rh_archive.elisa"
include "./rh_pep440.elisa"
include "./rh_vcs_hg.elisa"
include "./rh_vcs_svn.elisa"
include "./rh_vcs_fossil.elisa"
include "./rh_patch.elisa"

module M07Fuzz:
    private:
        const RH_M07_FUZZ_MAX_INPUT: usize = 65536

        # Each first byte selects one parser family. The remainder is copied
        # once into Elisa-owned storage because parser contracts accept darray.
        # Branch-local scratch is kept inside each expression block.
        def rh_fuzz_dispatch(selector: u8, data: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            if selector == 48:
                nodes: mutable darray[Json::RhJsonNode] = []
                texts: mutable darray[u8] = []
                Json::rh_json_parse(data, nodes, texts)
            elif selector == 49:
                packages: mutable darray[Package::RhPkgNode] = []
                pool: mutable darray[u8] = []
                requirements: mutable darray[Package::RhRequire] = []
                unknown: mutable i64 = 0
                Package::rh_cargo_parse(data, packages, pool, requirements, &unknown)
            elif selector == 50:
                packages: mutable darray[Package::RhPkgNode] = []
                pool: mutable darray[u8] = []
                paths: mutable darray[i64] = []
                requirements: mutable darray[Package::RhRequire] = []
                Package::rh_npm_lock_parse(data, data, packages, pool, paths, requirements)
            elif selector == 51:
                packages: mutable darray[Package::RhPkgNode] = []
                pool: mutable darray[u8] = []
                requirements: mutable darray[Package::RhRequire] = []
                edges: mutable darray[Package::RhDepEdge] = []
                unresolved: mutable darray[Package::RhUnresolved] = []
                Package::rh_pnpm_lock_parse(data, data, packages, pool, requirements, edges, unresolved)
            elif selector == 52:
                packages: mutable darray[Package::RhPkgNode] = []
                pool: mutable darray[u8] = []
                requirements: mutable darray[Package::RhRequire] = []
                edges: mutable darray[Package::RhDepEdge] = []
                unresolved: mutable darray[Package::RhUnresolved] = []
                Package::rh_yarn_lock_parse(data, data, packages, pool, requirements, edges, unresolved)
            elif selector == 53:
                packages: mutable darray[Package::RhPkgNode] = []
                pool: mutable darray[u8] = []
                requirements: mutable darray[Package::RhRequire] = []
                edges: mutable darray[Package::RhDepEdge] = []
                unresolved: mutable darray[Package::RhUnresolved] = []
                unknown: mutable i64 = 0
                Package::rh_go_parse(data, packages, pool, requirements, edges, unresolved, &unknown)
            elif selector == 54:
                packages: mutable darray[Package::RhPkgNode] = []
                pool: mutable darray[u8] = []
                requirements: mutable darray[Package::RhRequire] = []
                edges: mutable darray[Package::RhDepEdge] = []
                unresolved: mutable darray[Package::RhUnresolved] = []
                unknown: mutable i64 = 0
                Package::rh_nuget_parse(data, packages, pool, requirements, edges, unresolved, &unknown)
            elif selector == 55:
                packages: mutable darray[Package::RhPkgNode] = []
                pool: mutable darray[u8] = []
                requirements: mutable darray[Package::RhRequire] = []
                edges: mutable darray[Package::RhDepEdge] = []
                unresolved: mutable darray[Package::RhUnresolved] = []
                unknown: mutable i64 = 0
                Package::rh_maven_parse(data, packages, pool, requirements, edges, unresolved, &unknown)
            elif selector == 56:
                packages: mutable darray[Package::RhPkgNode] = []
                pool: mutable darray[u8] = []
                requirements: mutable darray[Package::RhRequire] = []
                edges: mutable darray[Package::RhDepEdge] = []
                unresolved: mutable darray[Package::RhUnresolved] = []
                unknown: mutable i64 = 0
                Package::rh_pypi_parse(data, packages, pool, requirements, edges, unresolved, &unknown)
            elif selector == 57:
                packages: mutable darray[Package::RhPkgNode] = []
                pool: mutable darray[u8] = []
                requirements: mutable darray[Package::RhRequire] = []
                edges: mutable darray[Package::RhDepEdge] = []
                unresolved: mutable darray[Package::RhUnresolved] = []
                unknown: mutable i64 = 0
                Package::rh_pypi_parse_pep621(data, packages, pool, requirements, edges, unresolved, &unknown)
            elif selector == 97:
                packages: mutable darray[Package::RhPkgNode] = []
                pool: mutable darray[u8] = []
                requirements: mutable darray[Package::RhRequire] = []
                edges: mutable darray[Package::RhDepEdge] = []
                unresolved: mutable darray[Package::RhUnresolved] = []
                unknown: mutable i64 = 0
                Package::rh_gemfile_parse(data, packages, pool, requirements, edges, unresolved, &unknown)
            elif selector == 98:
                nodes: mutable darray[Json::RhJsonNode] = []
                texts: mutable darray[u8] = []
                parsed: i64 = Json::rh_json_parse(data, nodes, texts)
                if parsed < 0:
                    parsed
                else:
                    packages: mutable darray[Package::RhPkgNode] = []
                    pool: mutable darray[u8] = []
                    requirements: mutable darray[Package::RhRequire] = []
                    edges: mutable darray[Package::RhDepEdge] = []
                    unresolved: mutable darray[Package::RhUnresolved] = []
                    unknown: mutable i64 = 0
                    Package::rh_composer_parse(data, nodes, texts, packages, pool, requirements, edges, unresolved, &unknown)
            elif selector == 99:
                version: mutable Package::RhSemver = Package::RhSemver{0, 0, 0, -1, -1}
                _ = Package::rh_semver_parse(data, 0, data.count, &version)
                0
            elif selector == 100:
                _ = Pep440::rh_pep440_parse(data, 0, data.count.i64())
                0
            elif selector == 101:
                pool: mutable darray[u8] = []
                changes: mutable darray[Mercurial::RhHgChange] = []
                rejected: mutable i64 = 0
                Mercurial::rh_hg_parse(data, 0, pool, changes, &rejected)
            elif selector == 102:
                _ = Subversion::rh_svn_parse(data, 0)
                0
            elif selector == 103:
                pool: mutable darray[u8] = []
                entries: mutable darray[Fossil::RhFossilEntry] = []
                rejected: mutable i64 = 0
                Fossil::rh_fossil_parse(data, 0, pool, entries, &rejected)
            elif selector == 104:
                output: mutable darray[u8] = []
                Archive::rh_archive_report(data, output)
            elif selector == 105:
                _ = Patch::rh_patch_parse(data, 0, data.count.i64())
                0
            else:
                0

    public:
        def rh_fuzz_entry(input_ptr: void&, input_size: usize) -> i32 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            return 0 if input_size == 0
            bounded_size: usize = RH_M07_FUZZ_MAX_INPUT if input_size > RH_M07_FUZZ_MAX_INPUT else input_size
            raw: u8& = input_ptr.cast[u8&] can Unsafe.PointerCast
            selector: u8 = raw[0]
            data: mutable darray[u8] =
                while index < bounded_size |data: mutable darray[u8] = [], index: usize = 1| -> data:
                    data.push(raw[index])
                    index <- index + 1
            _ = rh_fuzz_dispatch(selector, data)
            0

export fn LLVMFuzzerTestOneInput(data: void&, size: usize) -> i32 = M07Fuzz::rh_fuzz_entry
