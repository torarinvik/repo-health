# rh_proof.elisa — formal-proof evidence adapter (M11-04).
#
# Proof validity, replay, and source-to-artifact correspondence are separate
# observations. This adapter only normalizes a captured proof envelope; it
# never runs a checker, infers a proposition, or turns a replay into a broad
# application-safety claim.

include "./rh_base.elisa"
include "./rh_json.elisa"

module Proof:
    private:
        const RH_PROOF_MAX_BYTES: i64 = 1048576
        const RH_PROOF_MAX_COMPONENTS: i64 = 256

        def rh_proof_get(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            Json::rh_json_obj_get(nodes, texts, obj, key)
        def rh_proof_span_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool:
            Base::rh_bytes_equal_literal(texts, s, e, lit)

        def rh_proof_sha256(texts: darray[u8]&, s: i64, e: i64) -> bool:
            return false if e - s != 71 or not Proof::rh_proof_span_eq(texts, s, s + 7, "sha256:")
            while i < e |i: i64 = s + 7, texts|:
                b: u8 = texts[i.usize()]
                return false if not ((b >= 48 and b <= 57) or (b >= 97 and b <= 102))
                i <- i + 1
            true
        def rh_proof_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Proof::rh_proof_get(nodes, texts, obj, key)
            return false if idx < 0 or nodes[idx.usize()].kind != Json::RH_JSON_STR
            n: Json::RhJsonNode = nodes[idx.usize()]
            s_out[0] <- n.text_start
            e_out[0] <- n.text_end
            true

        def rh_proof_emit_span(out: mutable darray[u8]&, texts: darray[u8]&, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
            out.push(34)
            Base::rh_json_escape(out, texts, s.usize(), e.usize())
            out.push(34)

        def rh_proof_emit_array(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, arr: i64, out: mutable darray[u8]&, count_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            count_out[0] <- 0
            return false if arr < 0 or nodes[arr.usize()].kind != Json::RH_JSON_ARR
            return false if nodes[arr.usize()].child_count < 0 or nodes[arr.usize()].child_count > RH_PROOF_MAX_COMPONENTS
            Base::rh_push_text(out, "[")
            while child >= 0 |child: i64 = nodes[arr.usize()].first_child, nodes, texts, out, count_out|:
                return false if nodes[child.usize()].kind != Json::RH_JSON_STR
                out.push(44) if count_out[0] > 0
                n: Json::RhJsonNode = nodes[child.usize()]
                return false if n.text_end <= n.text_start
                Proof::rh_proof_emit_span(out, texts, n.text_start, n.text_end)
                count_out[0] <- count_out[0] + 1
                child <- nodes[child.usize()].next_sibling
            Base::rh_push_text(out, "]")
            true

        def rh_proof_replay(texts: darray[u8]&, s: i64, e: i64) -> bool:
            Proof::rh_proof_span_eq(texts, s, e, "replayed") or Proof::rh_proof_span_eq(texts, s, e, "failed") or Proof::rh_proof_span_eq(texts, s, e, "not_replayed") or Proof::rh_proof_span_eq(texts, s, e, "unknown")

    public:
        def rh_proof_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if raw.count.i64() <= 0 or raw.count.i64() > RH_PROOF_MAX_BYTES
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
            schema: i64 = Proof::rh_proof_get(nodes, texts, root, "schema")
            return -1 if schema < 0 or nodes[schema.usize()].kind != Json::RH_JSON_STR
            schema_node: Json::RhJsonNode = nodes[schema.usize()]
            return -1 if not Proof::rh_proof_span_eq(texts, schema_node.text_start, schema_node.text_end, "rh-proof-input/1")
            ps: mutable i64 = 0
            pe: mutable i64 = 0
            rs: mutable i64 = 0
            re: mutable i64 = 0
            cs: mutable i64 = 0
            ce: mutable i64 = 0
            ds: mutable i64 = 0
            de: mutable i64 = 0
            replay_s: mutable i64 = 0
            replay_e: mutable i64 = 0
            return -1 if not Proof::rh_proof_str(nodes, texts, root, "proposition_id", &ps, &pe)
            return -1 if not Proof::rh_proof_str(nodes, texts, root, "source_revision", &rs, &re)
            return -1 if not Proof::rh_proof_str(nodes, texts, root, "checker_version", &cs, &ce)
            return -1 if not Proof::rh_proof_str(nodes, texts, root, "proof_digest", &ds, &de)
            return -1 if not Proof::rh_proof_sha256(texts, ds, de)
            return -1 if not Proof::rh_proof_str(nodes, texts, root, "replay_result", &replay_s, &replay_e)
            return -1 if not Proof::rh_proof_replay(texts, replay_s, replay_e)
            assumptions: i64 = Proof::rh_proof_get(nodes, texts, root, "assumptions")
            tcb: i64 = Proof::rh_proof_get(nodes, texts, root, "trusted_computing_base")
            return -1 if assumptions < 0 or tcb < 0
            assumption_count: mutable i64 = 0
            tcb_count: mutable i64 = 0
            assumption_json: mutable darray[u8] = []
            tcb_json: mutable darray[u8] = []
            return -1 if not Proof::rh_proof_emit_array(nodes, texts, assumptions, assumption_json, &assumption_count)
            return -1 if not Proof::rh_proof_emit_array(nodes, texts, tcb, tcb_json, &tcb_count)
            binding: i64 = Proof::rh_proof_get(nodes, texts, root, "artifact_binding")
            binding_source: mutable i64 = -1
            binding_digest: mutable i64 = -1
            if binding >= 0:
                return -1 if nodes[binding.usize()].kind != Json::RH_JSON_OBJ
                binding_source <- Proof::rh_proof_get(nodes, texts, binding, "source_revision")
                binding_digest <- Proof::rh_proof_get(nodes, texts, binding, "artifact_digest")
                return -1 if binding_source >= 0 and nodes[binding_source.usize()].kind != Json::RH_JSON_STR
                return -1 if binding_digest >= 0 and nodes[binding_digest.usize()].kind != Json::RH_JSON_STR
                if binding_digest >= 0:
                    digest_node: Json::RhJsonNode = nodes[binding_digest.usize()]
                    return -1 if not Proof::rh_proof_sha256(texts, digest_node.text_start, digest_node.text_end)
            binding_status: u8& =
                if binding_source < 0 or binding_digest < 0:
                    "unbound"
                else:
                    bn: mutable Json::RhJsonNode = nodes[binding_source.usize()]
                    if bn.text_end - bn.text_start == re - rs:
                        same: bool =
                            while i < re - rs |same: bool = true, i: i64 = 0, texts, bn, rs| -> same:
                                if texts[(bn.text_start + i).usize()] != texts[(rs + i).usize()]:
                                    same <- false
                                i <- i + 1
                        "bound" if same else "conflicted"
                    else:
                        "conflicted"
            Base::rh_push_text(out, "{\"schema\":\"rh-proof-result/1\",\"proposition_id\":")
            Proof::rh_proof_emit_span(out, texts, ps, pe)
            Base::rh_push_text(out, ",\"source_revision\":")
            Proof::rh_proof_emit_span(out, texts, rs, re)
            Base::rh_push_text(out, ",\"checker_version\":")
            Proof::rh_proof_emit_span(out, texts, cs, ce)
            Base::rh_push_text(out, ",\"proof_digest\":")
            Proof::rh_proof_emit_span(out, texts, ds, de)
            Base::rh_push_text(out, ",\"replay_result\":")
            Proof::rh_proof_emit_span(out, texts, replay_s, replay_e)
            Base::rh_push_text(out, ",\"assumptions\":")
            out.extend(bytes_view(assumption_json))
            Base::rh_push_text(out, ",\"trusted_computing_base\":")
            out.extend(bytes_view(tcb_json))
            Base::rh_push_text(out, ",\"assumption_count\":")
            Base::rh_push_decimal_i64(out, assumption_count)
            Base::rh_push_text(out, ",\"trusted_computing_base_count\":")
            Base::rh_push_decimal_i64(out, tcb_count)
            Base::rh_push_text(out, ",\"artifact_binding\":")
            if binding < 0:
                Base::rh_push_text(out, "null")
            else:
                Base::rh_push_text(out, "{\"status\":\"")
                Base::rh_push_text(out, binding_status)
                Base::rh_push_text(out, "\",\"source_revision\":")
                if binding_source >= 0:
                    bn2: Json::RhJsonNode = nodes[binding_source.usize()]
                    Proof::rh_proof_emit_span(out, texts, bn2.text_start, bn2.text_end)
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"artifact_digest\":")
                if binding_digest >= 0:
                    bd: Json::RhJsonNode = nodes[binding_digest.usize()]
                    Proof::rh_proof_emit_span(out, texts, bd.text_start, bd.text_end)
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, "}")
            Base::rh_push_text(out, ",\"note\":\"proof replay, proposition validity, and source-to-artifact correspondence are separate observations; this result is not a whole-application safety claim\"}")
            0
