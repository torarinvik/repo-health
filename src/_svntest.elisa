include "./rh_base.elisa"
include "./rh_vcs_svn.elisa"
def main() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    raw: mutable darray[u8] = []
    rh_push_text(raw, "<log><logentry revision=\"1\"><msg>fix &amp; &lt;x&gt;</msg></logentry></log>")
    log: RhSvnLog = rh_svn_parse(raw, 0)
    b: mutable darray[u8] = []
    rh_push_text(b, "ok=")
    rh_push_decimal_i64(b, log.ok)
    rh_push_text(b, " n=")
    rh_push_decimal_i64(b, log.entries.count.i64())
    if log.entries.count > 0:
        e: RhSvnEntry = log.entries[0]
        rh_push_text(b, " msg=[")
        k: mutable i64 = e.msg_s
        while k < e.msg_e |k, e, log, b|:
            b.push(log.pool[k.usize()])
            k <- k + 1
        rh_push_text(b, "]")
    b.push(10)
    rh_write_stdout(b)
    return 0
