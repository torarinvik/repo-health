include "./rh_base.elisa"
include "./rh_vcs_svn.elisa"
def main() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    raw: mutable darray[u8] = []
    Base::rh_push_text(raw, "<log><logentry revision=\"1\"><msg>fix &amp; &lt;x&gt;</msg></logentry></log>")
    log: Subversion::RhSvnLog = Subversion::rh_svn_parse(raw, 0)
    b: mutable darray[u8] =
        b: mutable darray[u8] = []
        Base::rh_push_text(b, "ok=")
        Base::rh_push_decimal_i64(b, log.ok)
        Base::rh_push_text(b, " n=")
        Base::rh_push_decimal_i64(b, log.entries.count.i64())
        b
    if log.entries.count > 0:
        e: Subversion::RhSvnEntry = log.entries[0]
        Base::rh_push_text(b, " msg=[")
        while k < e.msg_e |k: i64 = e.msg_s, e, log, b|:
            b.push(log.pool[k.usize()])
            k <- k + 1
        Base::rh_push_text(b, "]")
    b.push(10)
    Base::rh_write_stdout(b)
    0
