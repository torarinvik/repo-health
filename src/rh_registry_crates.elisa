# rh_registry_crates.elisa — bounded crates.io metadata adapter (M03-05).
#
# crates.io wraps project metadata in `crate` and exposes versions as an
# array. The adapter keeps the provider envelope at the boundary and emits
# the canonical registry shape; it does not resolve crates or infer releases.

include "./rh_base.elisa"
include "./rh_json.elisa"

const RH_REGMETA_CRATES_MAX_VERSIONS: i64 = 10000

module RegistryCrates:
    private:
        def rh_crates_find_value(nodes: darray[RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if obj < 0 or nodes[obj.usize()].kind != RH_JSON_OBJ
            while child >= 0 |child: i64 = nodes[obj.usize()].first_child, nodes, texts, key|:
                value: i64 = nodes[child.usize()].next_sibling
                return -1 if value < 0
                if nodes[child.usize()].kind == RH_JSON_STR and rh_bytes_equal_literal(texts, nodes[child.usize()].text_start, nodes[child.usize()].text_end, key):
                    return value
                child <- nodes[value.usize()].next_sibling
            -1

        def rh_crates_find_string(nodes: darray[RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            value: i64 = RegistryCrates::rh_crates_find_value(nodes, texts, obj, key)
            value if value >= 0 and nodes[value.usize()].kind == RH_JSON_STR else -1

        def rh_crates_first_string(nodes: darray[RhJsonNode]&, obj: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if obj < 0 or nodes[obj.usize()].kind != RH_JSON_OBJ
            while child >= 0 |child: i64 = nodes[obj.usize()].first_child, nodes|:
                value: i64 = nodes[child.usize()].next_sibling
                return -1 if value < 0
                return value if nodes[value.usize()].kind == RH_JSON_STR
                child <- nodes[value.usize()].next_sibling
            -1

        def rh_crates_str(nodes: darray[RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            rh_json_str_span(nodes, rh_json_obj_get(nodes, texts, obj, key), &s_out[0], &e_out[0])

        def rh_crates_yank(nodes: darray[RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64) -> i64:
            idx: i64 = RegistryCrates::rh_crates_find_value(nodes, texts, obj, "yanked")
            return -1 if idx < 0 or nodes[idx.usize()].kind != RH_JSON_BOOL
            1 if rh_json_is_true(nodes, raw, idx) else 0

        def rh_crates_repository(nodes: darray[RhJsonNode]&, texts: darray[u8]&, crate_obj: i64, out: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            repo: mutable i64 = RegistryCrates::rh_crates_find_string(nodes, texts, crate_obj, "repository")
            repo <- RegistryCrates::rh_crates_first_string(nodes, crate_obj) if repo < 0
            if repo >= 0 and nodes[repo.usize()].kind == RH_JSON_STR:
                out.push(34)
                rh_json_escape(out, texts, nodes[repo.usize()].text_start.usize(), nodes[repo.usize()].text_end.usize())
                out.push(34)
                return true
            home: i64 = RegistryCrates::rh_crates_find_string(nodes, texts, crate_obj, "homepage")
            if home >= 0 and nodes[home.usize()].kind == RH_JSON_STR:
                out.push(34)
                rh_json_escape(out, texts, nodes[home.usize()].text_start.usize(), nodes[home.usize()].text_end.usize())
                out.push(34)
                return true
            rh_push_text(out, "null")
            false

    public:
        def rh_regmeta_crates_normalize(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if raw.count > 4194304
            nodes: mutable darray[RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != RH_JSON_OBJ
            crate_obj: i64 = RegistryCrates::rh_crates_find_value(nodes, texts, root, "crate")
            return -1 if crate_obj < 0 or nodes[crate_obj.usize()].kind != RH_JSON_OBJ
            versions: i64 = RegistryCrates::rh_crates_find_value(nodes, texts, root, "versions")
            return -1 if versions < 0 or nodes[versions.usize()].kind != RH_JSON_ARR
            rh_push_text(out, "{\"versions\":[")
            emitted: mutable i64 = 0
            arr: RhJsonNode = nodes[versions.usize()]
            while version >= 0 |version: i64 = arr.first_child, nodes, raw, texts, out, emitted, crate_obj|:
                return -1 if emitted >= RH_REGMETA_CRATES_MAX_VERSIONS or nodes[version.usize()].kind != RH_JSON_OBJ
                num_idx: i64 = RegistryCrates::rh_crates_find_value(nodes, texts, version, "num")
                return -1 if num_idx < 0 or nodes[num_idx.usize()].kind != RH_JSON_STR
                num_s: i64 = nodes[num_idx.usize()].text_start
                num_e: i64 = nodes[num_idx.usize()].text_end
                return -1 if num_e <= num_s
                if emitted > 0:
                    out.push(44)
                rh_push_text(out, "{\"num\":\"")
                rh_json_escape(out, texts, num_s.usize(), num_e.usize())
                rh_push_text(out, "\",\"yanked\":")
                yank: i64 = RegistryCrates::rh_crates_yank(nodes, raw, texts, version)
                if yank < 0:
                    rh_push_text(out, "null")
                elif yank == 1:
                    rh_push_text(out, "true")
                else:
                    rh_push_text(out, "false")
                rh_push_text(out, ",\"published_at\":")
                pub_idx: i64 = RegistryCrates::rh_crates_find_string(nodes, texts, version, "created_at")
                if pub_idx >= 0:
                    out.push(34)
                    rh_json_escape(out, texts, nodes[pub_idx.usize()].text_start.usize(), nodes[pub_idx.usize()].text_end.usize())
                    out.push(34)
                else:
                    rh_push_text(out, "null")
                rh_push_text(out, ",\"repository\":")
                RegistryCrates::rh_crates_repository(nodes, texts, crate_obj, out)
                rh_push_text(out, ",\"deps\":[]}")
                emitted <- emitted + 1
                version <- nodes[version.usize()].next_sibling
            rh_push_text(out, "]}")
            0
