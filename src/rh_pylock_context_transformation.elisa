# Field and lineage contract for PEP 751 marker-context evaluation.
include "./rh_base.elisa"

module PylockContextTransformation:
    public:
        def rh_pylock_context_transformation_report(configuration_sha: darray[u8]&, audit_sha: darray[u8]&, context_sha: darray[u8]&, output_sha: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, "{\"schema\":\"rh-adapter-transformation-report/1\",\"adapter\":\"pep751-marker-context-evaluation\",\"source_input_sha256\":\"")
            out.extend(bytes_view(audit_sha))
            Base::rh_push_text(out, "\",\"source_context_sha256\":\"")
            out.extend(bytes_view(context_sha))
            Base::rh_push_text(out, "\",\"output_schema\":\"rh-pylock-marker-evaluation/1\",\"normalizer_version\":\"1.0.0\",\"configuration_sha256\":\"")
            out.extend(bytes_view(configuration_sha))
            Base::rh_push_text(out, "\",\"normalized_output_sha256\":\"")
            out.extend(bytes_view(output_sha))
            Base::rh_push_text(out, "\",\"fields\":[{\"source\":\"PEP 751 audit and caller-selected evaluation context\",\"target\":\"audit_sha256|context_sha256\",\"state\":\"preserved\"},{\"source\":\"environment alternatives and package markers\",\"target\":\"environment_state|package_markers[].marker_state\",\"state\":\"transformed\"},{\"source\":\"top-level and package requires-python constraints\",\"target\":\"top_level_requires_python_state|package_markers[].requires_python_state\",\"state\":\"transformed\"},{\"source\":\"dependency installation relationships\",\"target\":\"installation_graph\",\"state\":\"unsupported\"}]}")
