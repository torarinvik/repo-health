# test_m06b.elisa — M06 surfaces: notification policy (authorization,
# dedup, cooldown, ack/resolve, outage suppression) and query contract
# (pagination, scan-status breakdown, bounded fenced graph jobs).
# Deterministic, offline.

include "./rh_base.elisa"
include "./rh_notify.elisa"
include "./rh_query.elisa"

def n6check(cond: bool, label: u8&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    return if cond
    fails[0] <- fails[0] + 1
    b: mutable darray[u8] =
        b: mutable darray[u8] = []
        rh_push_text(b, "M06B-FAIL ")
        rh_push_text(b, label)
        b.push(10)
        b
    rh_write_stdout(b)

def key(rule: i64, subject: i64, hi: u64, lo: u64) -> RhFindingKey:
    RhFindingKey{rule_id: rule, subject_id: subject, artifact_high: hi, artifact_low: lo}

def target(kind: u8, authorized: bool) -> RhTarget:
    RhTarget{kind: kind, authorized: authorized}

def check_notify(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    states: mutable darray[RhNotifyState] = []
    k1: RhFindingKey = key(1, 100, 0, 0)
    upstream: RhTarget = target(RH_TARGET_UPSTREAM_MAINTAINER, false)
    sub: RhTarget = target(RH_TARGET_SUBSCRIBER, true)
    changed: u8 = |fails, states|
        m6b: u8 = rh_notify_decide(states, k1, upstream, 1000, 3600, false)
        n6check(m6b == RH_NOTIFY_SUPPRESSED_UNAUTHORIZED, "notify-upstream-unauthorized", fails)
        rh_notify_record(states, k1, upstream, 1000, m6b)
        n6check(states.count == 0, "notify-unauthorized-not-recorded", fails)
        first: u8 = rh_notify_decide(states, k1, sub, 1000, 3600, false)
        n6check(first == RH_NOTIFY_NEW, "notify-new", fails)
        rh_notify_record(states, k1, sub, 1000, first)
        dup: u8 = rh_notify_decide(states, k1, sub, 2000, 3600, false)
        n6check(dup == RH_NOTIFY_SUPPRESSED_COOLDOWN, "notify-cooldown", fails)
        after: u8 = rh_notify_decide(states, k1, sub, 5000, 3600, false)
        n6check(after == RH_NOTIFY_NEW, "notify-after-cooldown", fails)
        k2: RhFindingKey = key(1, 100, 1, 0)
        block_result: u8 = rh_notify_decide(states, k2, sub, 5000, 3600, false)
        block_result
    n6check(changed == RH_NOTIFY_NEW, "notify-digest-change-new-key", fails)
    outage: u8 = rh_notify_decide(states, k1, sub, 9000, 3600, true)
    n6check(outage == RH_NOTIFY_SUPPRESSED_OUTAGE, "notify-outage-suppressed", fails)
    _ = rh_notify_acknowledge(states, k1)
    acked: u8 = rh_notify_decide(states, k1, sub, 99999, 3600, false)
    n6check(acked == RH_NOTIFY_SUPPRESSED_ACKNOWLEDGED, "notify-acknowledged-quiet", fails)
    _ = rh_notify_resolve(states, k1)
    resolved: u8 = rh_notify_decide(states, k1, sub, 999999, 3600, false)
    n6check(resolved == RH_NOTIFY_SUPPRESSED_RESOLVED, "notify-resolved-quiet", fails)
    return

def check_query_page(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    ids: mutable darray[i64] = []
    while i < 8 |i: i64 = 0, ids|:
        ids.push(10 + i)
        i <- i + 1
    p1: mutable darray[i64] = []
    nc1: mutable i64 = 0
    done1: mutable i64 = 0
    n1: i64 = Query::rh_query_page(ids, -1, 3, p1, &nc1, &done1)
    n6check(n1 == 3 and done1 == 0, "page-1-size", fails)
    n6check(p1[0] == 10 and p1[2] == 12, "page-1-values", fails)
    p2: mutable darray[i64] = []
    nc2: mutable i64 = 0
    done2: mutable i64 = 0
    n2: i64 = Query::rh_query_page(ids, nc1, 3, p2, &nc2, &done2)
    n6check(n2 == 3 and p2[0] == 13 and done2 == 0, "page-2-continues", fails)
    p3: mutable darray[i64] = []
    nc3: mutable i64 = 0
    done3: mutable i64 = 0
    n3: i64 = Query::rh_query_page(ids, nc2, 3, p3, &nc3, &done3)
    n6check(n3 == 2 and done3 == 1, "page-3-complete", fails)
    # Replaying an old cursor is idempotent (no duplicates, no gaps).
    pr: mutable darray[i64] = []
    nr: i64 = |ids, nc1, pr|
        ncr: mutable i64 = 0
        doner: mutable i64 = 0
        block_result: i64 = Query::rh_query_page(ids, nc1, 3, pr, &ncr, &doner)
        block_result
    n6check(nr == 3 and pr[0] == 13, "page-replay-idempotent", fails)
    # Page size cap.
    pbig: mutable darray[i64] = []
    ncb: mutable i64 = 0
    doneb: mutable i64 = 0
    nb: i64 = Query::rh_query_page(ids, -1, 99999, pbig, &ncb, &doneb)
    n6check(nb == 8 and doneb == 1, "page-cap-complete", fails)
    n6check(Query::rh_query_kind_valid(Query::RH_Q_DOWNSTREAM), "query-kind-valid", fails)
    n6check(not Query::rh_query_kind_valid(99), "query-kind-invalid", fails)
    return

def check_scan_status(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    u: mutable u8 = |fails|
        states: mutable darray[u8] = []
        states.push(0)   # history observed
        states.push(0)   # issues observed
        states.push(0)   # reviews observed
        Query::rh_capability_failure(states, 2, true)
        r: mutable u8 = states[2]
        n6check(r == 5, "scan-review-stale-with-prior", fails)
        n6check(states[0] == 0 and states[1] == 0, "scan-others-untouched", fails)
        states2: mutable darray[u8] =
            states2: mutable darray[u8] = []
            states2.push(0)
            states2.push(0)
            states2
        Query::rh_capability_failure(states2, 1, false)
        states2[1]
    n6check(u == 2, "scan-review-unavailable-without-prior", fails)
    states3: mutable darray[u8] =
        states3: mutable darray[u8] = []
        states3.push(0)
        states3.push(3)
        states3.push(5)
        states3
    total: mutable i64 = 0
    st: mutable i64 = 0
    pa: mutable i64 = 0
    un: mutable i64 = 0
    au: mutable i64 = 0
    ot: mutable i64 = 0
    Query::rh_scan_status_tally(states3, &total, &st, &pa, &un, &au, &ot)
    n6check(total == 1 and st == 1 and au == 1 and pa == 0, "scan-tally-breakdown", fails)
    return

def check_job_lease(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    terminal: i64 = |fails|
        lease: mutable Query::RhJobLease = Query::rh_job_make(7)
        t1: i64 = Query::rh_job_claim(&lease, 1, 1000, 100)
        n6check(t1 == 1, "job-claim", fails)
        held: i64 = Query::rh_job_claim(&lease, 2, 1050, 100)
        n6check(held == -1, "job-held", fails)
        stale_renew: bool = Query::rh_job_renew(&lease, 0, 1050, 100)
        n6check(not stale_renew, "job-stale-renew-refused", fails)
        renewed: bool = Query::rh_job_renew(&lease, 1, 1050, 100)
        n6check(renewed, "job-renew", fails)
        expires: i64 = lease.expires_at
        n6check(expires == 1150, "job-recorded-ttl", fails)
        reclaimed: i64 = Query::rh_job_claim(&lease, 2, 1200, 100)
        n6check(reclaimed == 2, "job-expired-reclaim-fencing", fails)
        stale_finish: bool = Query::rh_job_finish(&lease, 1, Query::RH_JOB_SUCCEEDED)
        n6check(not stale_finish, "job-stale-finish-refused", fails)
        finish: bool = Query::rh_job_finish(&lease, 2, Query::RH_JOB_SUCCEEDED)
        n6check(finish, "job-finish", fails)
        block_result: i64 = Query::rh_job_claim(&lease, 3, 1300, 100)
        block_result
    n6check(terminal == -2, "job-terminal-closed", fails)
    n6check(Query::rh_job_within_budget(10, 5000, 2000, 100), "job-budget-ok", fails)
    n6check(not Query::rh_job_within_budget(101, 5000, 2000, 100), "job-budget-nodes", fails)
    n6check(not Query::rh_job_within_budget(10, 1500, 2000, 100), "job-budget-deadline", fails)
    return

def main() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    fails: mutable i64 = 0
    check_notify(&fails)
    check_query_page(&fails)
    check_scan_status(&fails)
    check_job_lease(&fails)
    if fails == 0:
        b2: mutable darray[u8] =
            b2: mutable darray[u8] = []
            rh_push_text(b2, "M06B OK")
            b2.push(10)
            b2
        rh_write_stdout(b2)
        return 0
    1
