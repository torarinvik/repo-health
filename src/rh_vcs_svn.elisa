# rh_vcs_svn.elisa — Subversion adapter (M08 native-VCS lane).
#
# Input is the documented machine format of `svn log --xml -v`: an <log>
# document of <logentry revision="N"> elements with <author>, <date>,
# <msg>, and <paths><path action="A|M|D|R" ...>. This module only PARSES
# and NORMALIZES; it never invents a Git hash and never treats an SVN
# revision as a Git revision. Native revision numbers are preserved
# verbatim.
#
# This is a direct linear byte parser, not a general XML DOM: it scans for
# the documented tags, decodes the five predefined entities plus numeric
# character references in text, and fails closed on a document that is not
# an <log> with well-formed <logentry> elements. Unknown tags are skipped.
#
# Honest scope: an SVN revision is a REPOSITORY-GLOBAL counter.
# A single revision can touch several paths and therefore spans multiple
# projects; it is NOT a per-project change count and must never be summed
# as one change per project (R025). The author string is raw identity
# evidence, not an account and not a person. Fields the format does not
# support (reviews, proposals, traffic, branches) stay unsupported in the
# capability manifest. Path actions are counted, not interpreted.
include "./rh_base.elisa"

module Subversion:
    private:
        const RH_SVN_MAX_ENTRIES_DEFAULT: i64 = 20000

    public:
        const RH_SVN_ACT_UNKNOWN: u8 = 0
        const RH_SVN_ACT_ADD: u8 = 1
        const RH_SVN_ACT_MODIFY: u8 = 2
        const RH_SVN_ACT_DELETE: u8 = 3
        const RH_SVN_ACT_REPLACE: u8 = 4

        # One normalized log entry. Spans index into the caller-owned log pool.
        struct RhSvnEntry:
            rev: i64
            author_s: i64
            author_e: i64
            msg_s: i64
            msg_e: i64
            date_s: i64
            date_e: i64
            has_date: mutable i64
            has_author: mutable i64
            path_count: mutable i64
            add_n: mutable i64
            modify_n: mutable i64
            delete_n: mutable i64
            replace_n: mutable i64
            other_n: mutable i64

        # Parsed log: ok, entries, the decoded text pool spans index into, and the
        # count of entries skipped for a missing/malformed revision.
        struct RhSvnLog:
            ok: mutable i64
            entries: mutable darray[RhSvnEntry]
            pool: mutable darray[u8]
            rejected: mutable i64

        def rh_svn_action_label(a: u8) -> u8&:
            return "A" if a == RH_SVN_ACT_ADD
            return "M" if a == RH_SVN_ACT_MODIFY
            return "D" if a == RH_SVN_ACT_DELETE
            return "R" if a == RH_SVN_ACT_REPLACE
            "?"

        def rh_svn_action_of(b: u8) -> u8 can[Memory.Allocate, Abort.Panic]:
            return RH_SVN_ACT_ADD if b == 65
            return RH_SVN_ACT_MODIFY if b == 77
            return RH_SVN_ACT_DELETE if b == 68
            return RH_SVN_ACT_REPLACE if b == 82
            RH_SVN_ACT_UNKNOWN

        # --- byte scanning helpers (all by-reference parameters, no nested
        # value-block mutation, which this compiler loses) -----------------------

        # Index of the first occurrence of literal `lit` at or after `from`, or -1.
        def rh_svn_parse(raw: darray[u8]&, max_entries: i64) -> RhSvnLog can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            cap: i64 = RH_SVN_MAX_ENTRIES_DEFAULT if max_entries <= 0 else max_entries
            entries: mutable darray[RhSvnEntry] = []
            pool: mutable darray[u8] = []
            return RhSvnLog{ok: 0, entries: entries, pool: pool, rejected: 0} if rh_svn_find(raw, 0, "<log") < 0
            return RhSvnLog{ok: 0, entries: entries, pool: pool, rejected: 0} if rh_svn_find(raw, 0, "</log>") < 0
            over, rej =
                while true |over: bool = false, rej: i64 = 0, pos: i64 = 0, entries, pool| -> over, rej:
                    break if over
                    le: i64 = rh_svn_find(raw, pos, "<logentry")
                    break if le < 0
                    gt: i64 = rh_svn_find_byte(raw, le, 62)
                    if gt < 0:
                        return RhSvnLog{ok: 0, entries: entries, pool: pool, rejected: rej}
                    # end of this entry = next </logentry> or <logentry
                    close: i64 = rh_svn_find(raw, gt + 1, "</logentry>")
                    nxt: i64 = rh_svn_find(raw, gt + 1, "<logentry")
                    end: mutable i64 = close
                    if end < 0:
                        end <- raw.count.i64()
                    if nxt >= 0 and nxt < end:
                        end <- nxt
                    if entries.count.i64() >= cap:
                        over <- true
                    else:
                        revision: RhSvnTextSpan = rh_svn_attr_span(raw, le, gt, "revision")
                        rev: i64 = rh_svn_parse_i64(raw, revision.start, revision.end) if revision.present else -1
                        if rev < 0:
                            rej <- rej + 1
                        else:
                            ent: RhSvnEntry = rh_svn_entry(raw, gt + 1, end, rev, pool)
                            entries.push(ent)
                    pos <- gt + 1
            return RhSvnLog{ok: 0, entries: entries, pool: pool, rejected: rej} if over
            RhSvnLog{ok: 1, entries: entries, pool: pool, rejected: rej}

    private:
        struct RhSvnPathCounts:
            path_count: mutable i64
            add_n: mutable i64
            modify_n: mutable i64
            delete_n: mutable i64
            replace_n: mutable i64
            other_n: mutable i64

        struct RhSvnTextSpan:
            present: bool
            start: i64
            end: i64

        def rh_svn_path_counts_empty() -> RhSvnPathCounts:
            RhSvnPathCounts{path_count: 0, add_n: 0, modify_n: 0, delete_n: 0, replace_n: 0, other_n: 0}

        def rh_svn_find(data: darray[u8]&, from: i64, lit: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
            n: i64 = data.count.i64()
            ln: i64 = strlen(lit).i64()
            return -1 if from < 0 or ln == 0 or ln > n
            while i + ln <= n |found: i64 = -1, i: i64 = from, n, ln, data, lit| -> found:
                hit: bool = while k < ln |hit: bool = true, k: i64 = 0, i, ln, data, lit| -> hit:
                    break false if data[(i + k).usize()] != lit[k.usize()]
                    k <- k + 1
                break i if hit
                i <- i + 1

        # Index of byte b at or after from, or -1.
        def rh_svn_find_byte(data: darray[u8]&, from: i64, b: u8) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if from < 0
            Base::rh_find_byte(data, from.usize(), b)

        # Copy raw run [s,e) into pool, decoding predefined + numeric entities.
        # Returns the pool start offset, or -1 when the span is invalid.
        def rh_svn_copy_text(data: darray[u8]&, s: i64, e: i64, pool: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if s < 0 or e < s or e > data.count.i64()
            start: i64 = pool.count.i64()
            while i < e |i: i64 = s, e, data, pool|:
                b: u8 = data[i.usize()]
                if b == 38:
                    i <- i + 1
                    ns: i64 = i
                    while i < e and data[i.usize()] != 59 and i - ns <= 12 |i, e, data, ns|:
                        i <- i + 1
                    if i < e and data[i.usize()] == 59 and i - ns <= 12:
                        if rh_svn_entity(data, ns, i, pool):
                            i <- i + 1
                        else:
                            pool.push(38)
                            _ = Base::rh_absorb_span(data, ns, i + 1, pool)
                            i <- i + 1
                    else:
                        pool.push(38)
                else:
                    pool.push(b)
                    i <- i + 1
            start

        # Resolve one entity name between & and ;. true when resolved.
        def rh_svn_entity(data: darray[u8]&, s: i64, e: i64, pool: mutable darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            n: i64 = e - s
            if n == 2:
                if Base::rh_bytes_equal_literal(data, s, e, "lt"):
                    pool.push(60)
                    return true
                if Base::rh_bytes_equal_literal(data, s, e, "gt"):
                    pool.push(62)
                    return true
            if n == 3:
                if Base::rh_bytes_equal_literal(data, s, e, "amp"):
                    pool.push(38)
                    return true
            if n == 4:
                if Base::rh_bytes_equal_literal(data, s, e, "quot"):
                    pool.push(34)
                    return true
                if Base::rh_bytes_equal_literal(data, s, e, "apos"):
                    pool.push(39)
                    return true
            if n >= 3 and data[s.usize()] == 35:
                hex: bool = s + 1 < e and (data[(s + 1).usize()] == 120 or data[(s + 1).usize()] == 88)
                start: i64 = s + 2 if hex else s + 1
                return false if start >= e
                radix: i64 = 16 if hex else 10
                code: i64 =
                    while cursor < e |code: i64 = 0, cursor: i64 = start, e, data, radix| -> code:
                        b: u8 = data[cursor.usize()]
                        d: mutable i64 = -1
                        if b >= 48 and b <= 57:
                            d <- (b - 48).i64()
                        elif radix == 16 and b >= 97 and b <= 102:
                            d <- (b - 87).i64()
                        elif radix == 16 and b >= 65 and b <= 70:
                            d <- (b - 55).i64()
                        break -1 if d < 0
                        code <- code * radix + d
                        break -1 if code > 1114111
                        cursor <- cursor + 1
                    code
                return false if code < 0
                rh_svn_push_cp(pool, code)
                return true
            false

        def rh_svn_push_cp(pool: mutable darray[u8]&, cp: i64) -> void can[Memory.Allocate, Abort.Panic]:
            v: i64 =
                normalized: mutable i64 = cp
                normalized <- 65533 if normalized < 0 or normalized > 1114111
                normalized <- 65533 if normalized >= 55296 and normalized <= 57343
                normalized
            if v < 128:
                pool.push(v.u8())
            elif v < 2048:
                pool.push((192 + v / 64).u8())
                pool.push((128 + v % 64).u8())
            elif v < 65536:
                pool.push((224 + v / 4096).u8())
                pool.push((128 + (v / 64) % 64).u8())
                pool.push((128 + v % 64).u8())
            else:
                pool.push((240 + v / 262144).u8())
                pool.push((128 + (v / 4096) % 64).u8())
                pool.push((128 + (v / 64) % 64).u8())
                pool.push((128 + v % 64).u8())

        # Strict non-negative decimal integer over a raw span; -1 when missing,
        # empty, non-digit, or above the supported revision bound.
        def rh_svn_parse_i64(data: darray[u8]&, s: i64, e: i64) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if s < 0 or e <= s or e > data.count.i64()
            while i < e |value: i64 = 0, i: i64 = s, e, data| -> value:
                b: u8 = data[i.usize()]
                break -1 if b < 48 or b > 57
                value <- value * 10 + (b.i64() - 48)
                break -1 if value > 1000000000000000
                i <- i + 1

        # Read an attribute value span in the start tag [tag_s, tag_e): looks for
        # ` name="..."` / ` name='...'`, returning an absent span when missing.
        def rh_svn_attr_span(data: darray[u8]&, tag_s: i64, tag_e: i64, name: u8&) -> RhSvnTextSpan can[Memory.Allocate, Abort.Panic]:
            while true |span: RhSvnTextSpan = RhSvnTextSpan{present: false, start: -1, end: -1}, pos: i64 = tag_s, tag_e, data, name| -> span:
                break if pos >= tag_e
                hit: i64 = rh_svn_find(data, pos, name)
                if hit < 0 or hit + strlen(name).i64() > tag_e:
                    break
                # require a non-name char before the name (space) and after it
                before_ok: bool = hit == 0 or data[(hit - 1).usize()] == 32 or data[(hit - 1).usize()] == 9 or data[(hit - 1).usize()] == 10 or data[(hit - 1).usize()] == 13 or data[(hit - 1).usize()] == 60
                if before_ok:
                    before_equals: i64 =
                        while cursor < tag_e and (data[cursor.usize()] == 32 or data[cursor.usize()] == 9) |cursor: i64 = hit + strlen(name).i64(), tag_e, data| -> cursor:
                            cursor <- cursor + 1
                    if before_equals < tag_e and data[before_equals.usize()] == 61:
                        quote_at: i64 =
                            while cursor < tag_e and (data[cursor.usize()] == 32 or data[cursor.usize()] == 9) |cursor: i64 = before_equals + 1, tag_e, data| -> cursor:
                                cursor <- cursor + 1
                        if quote_at < tag_e and (data[quote_at.usize()] == 34 or data[quote_at.usize()] == 39):
                            q: u8 = data[quote_at.usize()]
                            vs: i64 = quote_at + 1
                            ve: i64 = rh_svn_find_byte(data, vs, q)
                            if ve >= 0 and ve <= tag_e:
                                break RhSvnTextSpan{present: true, start: vs, end: ve}
                pos <- hit + 1

        # Count <path action="X"> children in the <paths>...</paths> block
        # [block_s, block_e).
        def rh_svn_count_paths(data: darray[u8]&, block_s: i64, block_e: i64) -> RhSvnPathCounts can[Memory.Allocate, Abort.Panic]:
            while true |counts: mutable RhSvnPathCounts = rh_svn_path_counts_empty(), pos: i64 = block_s, block_s, block_e, data| -> counts:
                break if pos >= block_e
                ptag: i64 = rh_svn_find(data, pos, "<path")
                break if ptag < 0 or ptag >= block_e
                gt: i64 = rh_svn_find_byte(data, ptag, 62)
                break if gt < 0 or gt > block_e
                action: RhSvnTextSpan = rh_svn_attr_span(data, ptag, gt, "action")
                act: u8 = rh_svn_action_of(data[action.start.usize()]) if action.present and action.end > action.start else RH_SVN_ACT_UNKNOWN
                counts.path_count <- counts.path_count + 1
                if act == RH_SVN_ACT_ADD:
                    counts.add_n <- counts.add_n + 1
                elif act == RH_SVN_ACT_MODIFY:
                    counts.modify_n <- counts.modify_n + 1
                elif act == RH_SVN_ACT_DELETE:
                    counts.delete_n <- counts.delete_n + 1
                elif act == RH_SVN_ACT_REPLACE:
                    counts.replace_n <- counts.replace_n + 1
                else:
                    counts.other_n <- counts.other_n + 1
                pos <- gt + 1

        # Extract the first element `name` inside [from, to_pos), copying decoded
        # text into pool and returning an absent span when the element is missing.
        # `<name/>` yields a present empty span.
        def rh_svn_elem_text(data: darray[u8]&, from: i64, to_pos: i64, name: u8&, pool: mutable darray[u8]&) -> RhSvnTextSpan can[Memory.Allocate, Abort.Panic]:
            osp: i64 =
                open_tag: mutable darray[u8] = []
                open_tag.push(60)
                # build "<name"
                while k < strlen(name).i64() |k: i64 = 0, name, open_tag|:
                    open_tag.push(name[k.usize()])
                    k <- k + 1
                block_result: i64 = rh_svn_find(data, from, (&open_tag[0]).cast[u8&] can Unsafe.PointerCast)
                block_result
            return RhSvnTextSpan{present: false, start: -1, end: -1} if osp < 0 or osp >= to_pos
            gt: i64 = rh_svn_find_byte(data, osp, 62)
            if gt < 0 or gt > to_pos:
                return RhSvnTextSpan{present: false, start: -1, end: -1}
            # self-closing "<name .../>"
            if gt > osp and data[(gt - 1).usize()] == 47:
                span: i64 = pool.count.i64()
                return RhSvnTextSpan{present: true, start: span, end: span}
            csp: i64 =
                close_tag: mutable darray[u8] =
                    close_tag: mutable darray[u8] = []
                    close_tag.push(60)
                    close_tag.push(47)
                    close_tag
                while k2 < strlen(name).i64() |k2: i64 = 0, name, close_tag|:
                    close_tag.push(name[k2.usize()])
                    k2 <- k2 + 1
                block_result: i64 = rh_svn_find(data, gt + 1, (&close_tag[0]).cast[u8&] can Unsafe.PointerCast)
                block_result
            return RhSvnTextSpan{present: false, start: -1, end: -1} if csp < 0 or csp > to_pos
            start: i64 = rh_svn_copy_text(data, gt + 1, csp, pool)
            return RhSvnTextSpan{present: false, start: -1, end: -1} if start < 0
            RhSvnTextSpan{present: true, start: start, end: pool.count.i64()}

        # Parse `svn log --xml -v` bytes. ok=0 when the payload is not a <log>
        # document or the entry cap is exceeded. Entries with a missing/malformed
        # revision are skipped and counted.
        def rh_svn_entry(raw: darray[u8]&, from: i64, to_pos: i64, rev: i64, pool: mutable darray[u8]&) -> RhSvnEntry can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
            author: RhSvnTextSpan = rh_svn_elem_text(raw, from, to_pos, "author", pool)
            date: RhSvnTextSpan = rh_svn_elem_text(raw, from, to_pos, "date", pool)
            message: RhSvnTextSpan = rh_svn_elem_text(raw, from, to_pos, "msg", pool)
            path_counts: RhSvnPathCounts =
                paths_open: i64 = rh_svn_find(raw, from, "<paths")
                pgt: i64 = rh_svn_find_byte(raw, paths_open, 62)
                pclose: i64 = rh_svn_find(raw, paths_open, "</paths>")
                rh_svn_count_paths(raw, pgt + 1, pclose) if paths_open >= 0 and paths_open < to_pos and pgt >= 0 and pclose >= 0 and pgt < pclose and pclose <= to_pos else rh_svn_path_counts_empty()
            RhSvnEntry{rev: rev, author_s: author.start, author_e: author.end, msg_s: message.start, msg_e: message.end, date_s: date.start, date_e: date.end, has_date: 1 if date.present else 0, has_author: 1 if author.present else 0, path_count: path_counts.path_count, add_n: path_counts.add_n, modify_n: path_counts.modify_n, delete_n: path_counts.delete_n, replace_n: path_counts.replace_n, other_n: path_counts.other_n}
