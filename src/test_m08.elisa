# test_m08.elisa — M08 native-VCS lane: Mercurial `hg log -Tjson` parsing.
# Deterministic, offline. Proves: native node ids preserved (never a Git
# hash), integer rev is local not identity, dates normalized with the
# recorded offset, raw author string kept, tags counted but not called
# releases, malformed entries rejected (not guessed), payload bounded.
include "./rh_base.elisa"
include "./rh_vcs_hg.elisa"
include "./rh_vcs_svn.elisa"
include "./rh_vcs_fossil.elisa"
include "./rh_patch.elisa"
include "./rh_release_feed.elisa"
include "./rh_pep440.elisa"
include "./rh_marker.elisa"

def t8check(cond: bool, label: u8&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    return if cond
    fails[0] <- fails[0] + 1
    b: mutable darray[u8] =
        b: mutable darray[u8] = []
        Base::rh_push_text(b, "M08-FAIL ")
        Base::rh_push_text(b, label)
        b.push(10)
        b
    Base::rh_write_stdout(b)

def hg_fixture() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    raw: mutable darray[u8] =
        raw: mutable darray[u8] = []
        Base::rh_push_text(raw, "[")
        Base::rh_push_text(raw, "{\"node\":\"0123456789abcdef0123456789abcdef01234567\",\"rev\":0,\"user\":\"Ada Lovelace <ada@example.org>\",\"date\":[1609459200,-3600],\"desc\":\"first change\",\"branch\":\"default\",\"tags\":[\"tip\"],\"phase\":\"draft\",\"parents\":[]},")
        Base::rh_push_text(raw, "{\"node\":\"fedcba9876543210fedcba9876543210fedcba98\",\"rev\":1,\"user\":\"Grace Hopper <grace@example.org>\",\"date\":[1612137600,7200],\"desc\":\"second change\",\"branch\":\"stable\",\"tags\":[],\"phase\":\"public\",\"parents\":[\"0123456789abcdef0123456789abcdef01234567\"]}")
        Base::rh_push_text(raw, "]")
        raw
    raw

def check_hg_parse(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    raw: darray[u8] = hg_fixture()
    pool: mutable darray[u8] = []
    out: mutable darray[Mercurial::RhHgChange] = []
    rej: mutable i64 = 0
    rc: i64 = Mercurial::rh_hg_parse(raw, 0, pool, out, &rej)
    t8check(rc == 0, "hg-parse-ok", fails)
    t8check(out.count == 2, "hg-two-changes", fails)
    t8check(rej == 0, "hg-no-rejects", fails)
    c0: Mercurial::RhHgChange = out[0]
    t8check(c0.node_e - c0.node_s == 40, "hg-node-40hex", fails)
    t8check(Base::rh_bytes_equal_literal(pool, c0.node_s, c0.node_e, "0123456789abcdef0123456789abcdef01234567"), "hg-node-preserved", fails)
    t8check(c0.rev == 0, "hg-local-rev-0", fails)
    t8check(Base::rh_bytes_equal_literal(pool, c0.author_s, c0.author_e, "Ada Lovelace <ada@example.org>"), "hg-author-raw", fails)
    t8check(c0.utc == 1609459200 and c0.tz_offset == -3600 and c0.has_date == 1, "hg-date-utc-and-offset", fails)
    t8check(Base::rh_bytes_equal_literal(pool, c0.branch_s, c0.branch_e, "default"), "hg-branch", fails)
    t8check(c0.tag_count == 1, "hg-tag-count", fails)
    t8check(c0.phase == Mercurial::RH_HG_PHASE_DRAFT, "hg-phase-draft", fails)
    c1: Mercurial::RhHgChange = out[1]
    t8check(c1.rev == 1, "hg-local-rev-1", fails)
    t8check(c1.utc == 1612137600 and c1.tz_offset == 7200, "hg-date-2", fails)
    t8check(c1.phase == Mercurial::RH_HG_PHASE_PUBLIC, "hg-phase-public", fails)
    t8check(c1.tag_count == 0, "hg-tag-count-0", fails)
    t8check(Base::rh_bytes_equal_literal(pool, c1.branch_s, c1.branch_e, "stable"), "hg-branch-2", fails)
    return

def check_hg_reject(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    raw: mutable darray[u8] = []
    Base::rh_push_text(raw, "[{\"node\":\"not-a-node\",\"rev\":0,\"user\":\"x\",\"date\":[1,0],\"desc\":\"d\",\"branch\":\"default\",\"tags\":[],\"phase\":\"draft\"}]")
    pool: mutable darray[u8] = []
    out: mutable darray[Mercurial::RhHgChange] = []
    rej: mutable i64 = 0
    rc: i64 = Mercurial::rh_hg_parse(raw, 0, pool, out, &rej)
    t8check(rc == 0, "hg-bad-node-parse-ok", fails)
    t8check(out.count == 0, "hg-bad-node-not-guessed", fails)
    t8check(rej == 1, "hg-bad-node-counted", fails)
    missing: mutable darray[u8] = []
    Base::rh_push_text(missing, "[{\"rev\":3,\"user\":\"y\"}]")
    p2: mutable darray[u8] = []
    o2: mutable darray[Mercurial::RhHgChange] = []
    r2: mutable i64 = 0
    rc2: i64 = Mercurial::rh_hg_parse(missing, 0, p2, o2, &r2)
    t8check(rc2 == 0 and o2.count == 0 and r2 == 1, "hg-missing-node-rejected", fails)
    return

def check_hg_bounds(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    rc: i64 =
        raw: darray[u8] = hg_fixture()
        pool: mutable darray[u8] = []
        out: mutable darray[Mercurial::RhHgChange] = []
        rej: mutable i64 = 0
        block_result: i64 = Mercurial::rh_hg_parse(raw, 1, pool, out, &rej)
        block_result
    t8check(rc == -1, "hg-cap-exceeded-fails", fails)
    bad: mutable darray[u8] = []
    Base::rh_push_text(bad, "{\"node\":\"x\"}")
    p2: mutable darray[u8] = []
    o2: mutable darray[Mercurial::RhHgChange] = []
    r2: mutable i64 = 0
    t8check(Mercurial::rh_hg_parse(bad, 0, p2, o2, &r2) == -1, "hg-not-array-fails", fails)
    malformed: mutable darray[u8] = []
    Base::rh_push_text(malformed, "[{\"node\":")
    p3: mutable darray[u8] = []
    o3: mutable darray[Mercurial::RhHgChange] = []
    r3: mutable i64 = 0
    t8check(Mercurial::rh_hg_parse(malformed, 0, p3, o3, &r3) == -1, "hg-malformed-json-fails", fails)
    trunc: mutable darray[u8] = []
    Base::rh_push_text(trunc, "[{\"node\":\"0123456789abcdef0123456789abcdef01234567\",\"user\":42}]")
    p4: mutable darray[u8] = []
    o4: mutable darray[Mercurial::RhHgChange] = []
    rc4: i64 = |trunc, p4, o4|
        r4: mutable i64 = 0
        block_result: i64 = Mercurial::rh_hg_parse(trunc, 0, p4, o4, &r4)
        block_result
    t8check(rc4 == 0, "hg-wrong-type-user-not-crash", fails)
    c4: Mercurial::RhHgChange = o4[0]
    t8check(c4.author_s == -1, "hg-wrong-type-author-unknown", fails)
    return

def check_hg_fuzz_case(raw: darray[u8]&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    result_valid: bool =
        pool: mutable darray[u8] = []
        changes: mutable darray[Mercurial::RhHgChange] = []
        rejected: mutable i64 = 0
        status: i64 = Mercurial::rh_hg_parse(raw, 0, pool, changes, &rejected)
        all_spans_valid: bool =
            while i < changes.count |valid: bool = true, i: usize = 0, pool, changes| -> valid:
                change: Mercurial::RhHgChange = changes[i]
                valid <- false if change.node_s < 0 or change.node_e < change.node_s or change.node_e > pool.count.i64()
                valid <- false if change.author_s >= 0 and (change.author_e < change.author_s or change.author_e > pool.count.i64())
                valid <- false if change.desc_s >= 0 and (change.desc_e < change.desc_s or change.desc_e > pool.count.i64())
                valid <- false if change.branch_s >= 0 and (change.branch_e < change.branch_s or change.branch_e > pool.count.i64())
                i <- i + 1
        block_result: bool = (status == -1 or status == 0) and changes.count <= raw.count and pool.count <= raw.count and rejected >= 0 and rejected <= raw.count.i64()
        all_spans_valid and block_result
    t8check(result_valid, "hg-fuzz-bounds-and-spans", fails)
    return

def check_hg_fuzz(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    corpus: darray[u8] = hg_fixture()
    while trial < 96 |trial: i64 = 0, rng: i64 = 271828, corpus, fails|:
        fuzzed: mutable darray[u8] = []
        while copied < corpus.count |copied: usize = 0, corpus, fuzzed|:
            fuzzed.push(corpus[copied])
            copied <- copied + 1
        rng <- (rng * 48271) % 2147483647
        edits: i64 = 1 + rng % 5
        while edit < edits |edit: i64 = 0, rng, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            pos: usize = (rng % fuzzed.count.i64()).usize()
            rng <- (rng * 48271) % 2147483647
            fuzzed[pos] <- (rng % 128).u8()
            edit <- edit + 1
        check_hg_fuzz_case(fuzzed, fails)
        trial <- trial + 1

    alphabet: mutable darray[u8] = [91, 93, 123, 125, 34, 58, 44, 45, 48, 49, 116, 114, 117, 101, 102, 97, 108, 115, 110, 32, 92, 46]
    while trial < 128 |trial: i64 = 0, rng: i64 = 1618033, alphabet, fails|:
        rng <- (rng * 48271) % 2147483647
        byte_count: usize = (1 + rng % 96).usize()
        fuzzed: mutable darray[u8] = []
        while pos < byte_count |pos: usize = 0, rng, alphabet, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            choice: usize = (rng % alphabet.count.i64()).usize()
            fuzzed.push(alphabet[choice])
            pos <- pos + 1
        check_hg_fuzz_case(fuzzed, fails)
        trial <- trial + 1
    return

def check_hg_native_form(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    pool: mutable darray[u8] = []
    Base::rh_push_text(pool, "0123456789abcdef0123456789abcdef01234567")
    t8check(Mercurial::rh_hg_is_node_hex(pool, 0, 40), "hg-node-form-valid", fails)
    t8check(not Mercurial::rh_hg_is_node_hex(pool, 0, 39), "hg-node-form-39-rejected", fails)
    sha: mutable darray[u8] = []
    Base::rh_push_text(sha, "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef")
    t8check(not Mercurial::rh_hg_is_node_hex(sha, 0, 64), "hg-sha256-shape-rejected", fails)
    upper: mutable darray[u8] = []
    Base::rh_push_text(upper, "0123456789ABCDEF0123456789abcdef01234567")
    t8check(not Mercurial::rh_hg_is_node_hex(upper, 0, 40), "hg-uppercase-not-canonical", fails)
    pl: u8& = Mercurial::rh_hg_phase_label(Mercurial::RH_HG_PHASE_PUBLIC)
    t8check(pl[0] == 112, "hg-phase-label", fails)
    return

# (private to this test)
def seg_add(buf: mutable darray[u8]&, text: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
    start: i64 = buf.count.i64()
    Base::rh_push_text(buf, text)
    start

def parse_seg(buf: darray[u8]&, s: i64, e: i64) -> Patch::RhPatchSubject can[Memory.Allocate, Abort.Panic]:
    Patch::rh_patch_parse(buf, s, e)

def patch_overflow_parse(prefix: u8&, suffix: u8&) -> i64 can[Memory.Allocate, Abort.Panic]:
    subject: Patch::RhPatchSubject =
        patch: mutable darray[u8] =
            patch: mutable darray[u8] = []
            Base::rh_push_text(patch, prefix)
            for _digit in 0..<30 |patch|:
                patch.push(57)
            Base::rh_push_text(patch, suffix)
            patch
        Patch::rh_patch_parse(patch, 0, patch.count.i64())
    subject.ok

def check_patch(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    # Three revisions of ONE patch -> one logical change, latest version 3.
    buf: mutable darray[u8] = []
    a: i64 = seg_add(buf, "[PATCH 1/1] add widget")
    a2: i64 = buf.count.i64()
    b: i64 = seg_add(buf, "[PATCH v2 1/1] add widget")
    b2: i64 = buf.count.i64()
    c: i64 = seg_add(buf, "[PATCH v3 1/1] add widget")
    c2: i64 = buf.count.i64()
    subs: mutable darray[Patch::RhPatchSubject] =
        subs: mutable darray[Patch::RhPatchSubject] = []
        subs.push(parse_seg(buf, a, a2))
        subs.push(parse_seg(buf, b, b2))
        subs.push(parse_seg(buf, c, c2))
        subs
    t8check(subs[0].ok == 1 and subs[0].index == 1 and subs[0].total == 1, "patch-parse-1of1", fails)
    t8check(subs[1].version == 2, "patch-parse-v2", fails)
    t8check(subs[2].version == 3, "patch-parse-v3", fails)
    t8check(Patch::rh_patch_logical_count(buf, subs) == 1, "patch-revisions-collapse", fails)
    base_s: i64 = subs[0].base_s
    base_e: i64 = subs[0].base_e
    t8check(Patch::rh_patch_max_version(buf, subs, base_s, base_e, 1) == 3, "patch-max-version", fails)

    # A multi-patch series (1/2, 2/2) is two changes.
    ser: mutable darray[u8] = []
    s1: i64 = seg_add(ser, "[PATCH 1/2] part one")
    s12: i64 = ser.count.i64()
    s2: i64 = seg_add(ser, "[PATCH 2/2] part two")
    s22: i64 = ser.count.i64()
    subs2: mutable darray[Patch::RhPatchSubject] =
        subs2: mutable darray[Patch::RhPatchSubject] = []
        subs2.push(parse_seg(ser, s1, s12))
        subs2.push(parse_seg(ser, s2, s22))
        subs2
    t8check(subs2[0].index == 1 and subs2[0].total == 2, "patch-series-1", fails)
    t8check(subs2[1].index == 2 and subs2[1].total == 2, "patch-series-2", fails)
    t8check(Patch::rh_patch_logical_count(ser, subs2) == 2, "patch-series-two-changes", fails)

    # v2 of patch 1 plus patch 2 -> still two changes across the series.
    mix: mutable darray[u8] = []
    m1: i64 = seg_add(mix, "[PATCH v2 1/2] part one")
    m12: i64 = mix.count.i64()
    m2: i64 = seg_add(mix, "[PATCH 2/2] part two")
    m22: i64 = mix.count.i64()
    subs3: mutable darray[Patch::RhPatchSubject] =
        subs3: mutable darray[Patch::RhPatchSubject] = []
        subs3.push(parse_seg(mix, m1, m12))
        subs3.push(parse_seg(mix, m2, m22))
        subs3
    t8check(Patch::rh_patch_logical_count(mix, subs3) == 2, "patch-mixed-series", fails)

    # Non-patch messages are never forced into a series.
    nop: mutable darray[u8] = []
    n1: i64 = seg_add(nop, "Re: status update")
    n12: i64 = nop.count.i64()
    n2: i64 = seg_add(nop, "just an email")
    n22: i64 = nop.count.i64()
    subs4: mutable darray[Patch::RhPatchSubject] =
        subs4: mutable darray[Patch::RhPatchSubject] = []
        subs4.push(parse_seg(nop, n1, n12))
        subs4.push(parse_seg(nop, n2, n22))
        subs4
    t8check(subs4[0].ok == 0, "patch-non-patch-not-ok", fails)
    t8check(Patch::rh_patch_logical_count(nop, subs4) == 2, "patch-non-patch-distinct", fails)

    # A reply prefix on a real patch still parses.
    rep: mutable darray[u8] = []
    r1: i64 = seg_add(rep, "Re: [PATCH v2 1/3] fix zero handling")
    rp: Patch::RhPatchSubject =
        r12: i64 = rep.count.i64()
        parse_seg(rep, r1, r12)
    t8check(rp.ok == 1 and rp.version == 2 and rp.index == 1 and rp.total == 3, "patch-reply-prefix", fails)
    t8check(patch_overflow_parse("[PATCH v", " 1/2] overflow") == 0, "patch-version-overflow-rejected", fails)
    t8check(patch_overflow_parse("[PATCH ", "/2] overflow") == 0, "patch-index-overflow-rejected", fails)
    t8check(patch_overflow_parse("[PATCH 1/", "] overflow") == 0, "patch-total-overflow-rejected", fails)
    return

def rel_fixture() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    raw: mutable darray[u8] =
        raw: mutable darray[u8] = []
        Base::rh_push_text(raw, "{\"releases\":[")
        Base::rh_push_text(raw, "{\"tag\":\"v1.0.0\",\"published_at\":1700000000,\"assets\":[{\"name\":\"a.tgz\",\"digest\":\"sha256:abc\"},{\"name\":\"b.tgz\"}]},")
        Base::rh_push_text(raw, "{\"tag\":\"v1.1.0\"}")
        Base::rh_push_text(raw, "]}")
        raw
    raw

def check_release_feed(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    fs: i64 = |fails|
        raw: darray[u8] = rel_fixture()
        pool: mutable darray[u8] = []
        out: mutable darray[ReleaseFeed::RhRelease] = []
        rej: mutable i64 = 0
        rc: i64 = ReleaseFeed::rh_release_feed_parse(raw, 1700000123, 0, pool, out, &rej)
        t8check(rc == 0, "rel-parse-ok", fails)
        t8check(out.count == 2 and rej == 0, "rel-two-releases", fails)
        r0: ReleaseFeed::RhRelease = out[0]
        t8check(Base::rh_bytes_equal_literal(pool, r0.tag_s, r0.tag_e, "v1.0.0"), "rel-tag-preserved", fails)
        t8check(r0.published == 1700000000 and r0.has_published == 1, "rel-published-valid-time", fails)
        t8check(r0.first_seen == 1700000123, "rel-first-seen-known-time", fails)
        t8check(r0.asset_count == 2, "rel-asset-count", fails)
        t8check(r0.digest_known_count == 1, "rel-digest-known-count", fails)
        r1: ReleaseFeed::RhRelease = out[1]
        t8check(r1.has_published == 0 and r1.published == 0, "rel-missing-published-unknown", fails)
        t8check(r1.asset_count == 0, "rel-no-assets", fails)
        # No history/identity is ever derived from a release-only source.
        t8check(ReleaseFeed::rh_release_feed_history_supported() == 0, "rel-no-history", fails)
        t8check(ReleaseFeed::rh_release_feed_identity_supported() == 0, "rel-no-identity", fails)
        block_result: i64 = ReleaseFeed::rh_release_first_seen_for(pool, out, r0.tag_s, r0.tag_e)
        block_result
    t8check(fs == 1700000123, "rel-first-seen-lookup", fails)
    # Adversarial: malformed, wrong shape, missing tag, cap.
    bad: mutable darray[u8] = []
    Base::rh_push_text(bad, "{\"releases\":[{\"tag\":")
    p2: mutable darray[u8] = []
    o2: mutable darray[ReleaseFeed::RhRelease] = []
    r2: mutable i64 = 0
    t8check(ReleaseFeed::rh_release_feed_parse(bad, 1, 0, p2, o2, &r2) == -1, "rel-malformed-fails", fails)
    nope: mutable darray[u8] = []
    Base::rh_push_text(nope, "42")
    p3: mutable darray[u8] = []
    o3: mutable darray[ReleaseFeed::RhRelease] = []
    r3: mutable i64 = 0
    t8check(ReleaseFeed::rh_release_feed_parse(nope, 1, 0, p3, o3, &r3) == -1, "rel-wrong-shape-fails", fails)
    raws: darray[u8] = rel_fixture()
    p4: mutable darray[u8] = []
    o4: mutable darray[ReleaseFeed::RhRelease] = []
    r4: mutable i64 = 0
    t8check(ReleaseFeed::rh_release_feed_parse(raws, 1, 1, p4, o4, &r4) == -1, "rel-cap-exceeded", fails)
    notag: mutable darray[u8] = []
    Base::rh_push_text(notag, "[{\"published_at\":5},{\"tag\":\"ok\"}]")
    p5: mutable darray[u8] = []
    o5: mutable darray[ReleaseFeed::RhRelease] = []
    r5: mutable i64 = 0
    rc5: i64 = ReleaseFeed::rh_release_feed_parse(notag, 1, 0, p5, o5, &r5)
    t8check(rc5 == 0 and o5.count == 1 and r5 == 1, "rel-missing-tag-rejected", fails)
    return

def pp(text: u8&) -> Pep440::RhPep440 can[Memory.Allocate, Abort.Panic]:
    b: mutable darray[u8] = []
    Base::rh_push_text(b, text)
    Pep440::rh_pep440_parse(b, 0, b.count.i64())

def pep_lt(a: u8&, b: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    x: Pep440::RhPep440 = pp(a)
    y: Pep440::RhPep440 = pp(b)
    Pep440::rh_pep440_cmp(x, y) == -1

def pep_eq(a: u8&, b: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    x: Pep440::RhPep440 = pp(a)
    y: Pep440::RhPep440 = pp(b)
    Pep440::rh_pep440_cmp(x, y) == 0

def check_pep440(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    t8check(pp("1.2.3").ok == 1, "pep-valid", fails)
    t8check(pp("1!2.0").ok == 1, "pep-epoch-valid", fails)
    t8check(pep_eq("1.0", "1.0.0"), "pep-release-zero-pad", fails)
    t8check(pep_lt("1.0.dev1", "1.0a1"), "pep-dev-below-pre", fails)
    t8check(pep_lt("1.0.dev1", "1.0"), "pep-dev-below-release", fails)
    t8check(pep_lt("1.0a1", "1.0a2"), "pep-pre-number", fails)
    t8check(pep_lt("1.0a2", "1.0b1"), "pep-a-before-b", fails)
    t8check(pep_lt("1.0b1", "1.0rc1"), "pep-b-before-rc", fails)
    t8check(pep_lt("1.0rc1", "1.0"), "pep-pre-below-release", fails)
    t8check(pep_lt("1.0", "1.0.post1"), "pep-post-above-release", fails)
    t8check(pep_lt("1.0.post1", "1.0.1"), "pep-post-below-next", fails)
    t8check(pep_lt("1.0", "1.0+local"), "pep-local-above-public", fails)
    t8check(pep_lt("2.0", "1!0.1"), "pep-epoch-dominates", fails)
    t8check(pep_lt("1.0a1.dev1", "1.0a1"), "pep-dev-of-pre", fails)
    t8check(pep_eq("1.0c1", "1.0rc1"), "pep-c-alias-rc", fails)
    t8check(pep_eq("1.0alpha1", "1.0a1"), "pep-alpha-alias", fails)
    t8check(pep_eq("1.0beta2", "1.0b2"), "pep-beta-alias", fails)
    t8check(pp("").ok == 0, "pep-empty-invalid", fails)
    t8check(pp("1..2").ok == 0, "pep-double-dot-invalid", fails)
    t8check(pp("v1.0").ok == 0, "pep-leading-v-invalid", fails)
    t8check(pp("1.2.3.4.5.6.7.8.9").ok == 0, "pep-too-many-segments", fails)
    t8check(Pep440::rh_pep440_cmp(pp("1.0"), pp("")) == 2, "pep-cmp-invalid-returns-2", fails)
    return

def check_pep440_fuzz_case(raw: darray[u8]&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    valid_output: bool =
        version: Pep440::RhPep440 = Pep440::rh_pep440_parse(raw, 0, raw.count.i64())
        version.ok == 0 or (version.ok == 1 and version.epoch >= 0 and version.n >= 1 and version.n <= Pep440::RH_PEP_MAX_REL and version.r0 >= 0 and version.r1 >= 0 and version.r2 >= 0 and version.r3 >= 0 and version.r4 >= 0 and version.r5 >= 0 and version.r6 >= 0 and version.r7 >= 0 and version.pre_num >= 0 and version.post >= -1 and version.local >= -1)
    t8check(valid_output, "pep440-fuzz-structured-result", fails)
    return

def check_pep440_fuzz(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    corpus: mutable darray[u8] = []
    Base::rh_push_text(corpus, "2!1.0rc1.post2.dev3+local.1")
    while trial < 96 |trial: i64 = 0, rng: i64 = 3162277, corpus, fails|:
        fuzzed: mutable darray[u8] = []
        while copied < corpus.count |copied: usize = 0, corpus, fuzzed|:
            fuzzed.push(corpus[copied])
            copied <- copied + 1
        rng <- (rng * 48271) % 2147483647
        edits: i64 = 1 + rng % 5
        while edit < edits |edit: i64 = 0, rng, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            pos: usize = (rng % fuzzed.count.i64()).usize()
            rng <- (rng * 48271) % 2147483647
            fuzzed[pos] <- (rng % 128).u8()
            edit <- edit + 1
        check_pep440_fuzz_case(fuzzed, fails)
        trial <- trial + 1

    alphabet: mutable darray[u8] = [33, 43, 45, 46, 95, 48, 49, 50, 51, 57, 97, 98, 99, 100, 101, 102, 105, 108, 111, 112, 114, 115, 116, 118, 122]
    while trial < 128 |trial: i64 = 0, rng: i64 = 3678794, alphabet, fails|:
        rng <- (rng * 48271) % 2147483647
        byte_count: usize = (1 + rng % 96).usize()
        fuzzed: mutable darray[u8] = []
        while pos < byte_count |pos: usize = 0, rng, alphabet, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            choice: usize = (rng % alphabet.count.i64()).usize()
            fuzzed.push(alphabet[choice])
            pos <- pos + 1
        check_pep440_fuzz_case(fuzzed, fails)
        trial <- trial + 1
    return

def marker_value(pool: mutable darray[u8]&, value: u8&) -> Marker::RhMarkerSpan can[Memory.Allocate, Abort.Panic]:
    start: i64 = pool.count.i64()
    Base::rh_push_text(pool, value)
    Marker::RhMarkerSpan{start: start, end: pool.count.i64()}

def check_pep508_markers(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    names: mutable darray[u8] = []
    values: mutable darray[u8] = []
    bindings: mutable darray[Marker::RhMarkerBinding] = []
    extras: mutable darray[Marker::RhMarkerSpan] = []
    groups: mutable darray[Marker::RhMarkerSpan] = []
    python_name: i64 = names.count.i64()
    Base::rh_push_text(names, "python_version")
    python_name_end: i64 = names.count.i64()
    python_value: Marker::RhMarkerSpan = marker_value(values, "3.12")
    bindings.push(Marker::RhMarkerBinding{name_s: python_name, name_e: python_name_end, value_s: python_value.start, value_e: python_value.end})
    platform_name: i64 = names.count.i64()
    Base::rh_push_text(names, "sys_platform")
    platform_name_end: i64 = names.count.i64()
    platform_value: Marker::RhMarkerSpan = marker_value(values, "win32")
    bindings.push(Marker::RhMarkerBinding{name_s: platform_name, name_e: platform_name_end, value_s: platform_value.start, value_e: platform_value.end})
    extra_value: Marker::RhMarkerSpan = marker_value(values, "performance")
    extras.push(extra_value)
    group_value: Marker::RhMarkerSpan = marker_value(values, "lint")
    groups.push(group_value)
    context: Marker::RhMarkerContext = Marker::RhMarkerContext{names: names, values: values, bindings: bindings, extras: extras, groups: groups, extra_s: extra_value.start, extra_e: extra_value.end}
    expression: mutable darray[u8] = []
    Base::rh_push_text(expression, "python_version >= '3.10' and (sys_platform == 'win32' or sys_platform == 'linux')")
    evaluation: Marker::RhMarkerEvaluation = Marker::rh_marker_evaluate(expression, 0, expression.count.i64(), context)
    t8check(evaluation.valid and evaluation.state == Marker::RH_MARKER_RESULT_TRUE, "marker-and-or-parentheses", fails)
    compatible: mutable darray[u8] = []
    Base::rh_push_text(compatible, "python_version ~= '3.10'")
    evaluation2: Marker::RhMarkerEvaluation = Marker::rh_marker_evaluate(compatible, 0, compatible.count.i64(), context)
    t8check(evaluation2.valid and evaluation2.state == Marker::RH_MARKER_RESULT_TRUE, "marker-compatible-release", fails)
    membership: mutable darray[u8] = []
    Base::rh_push_text(membership, "'performance' in extras and 'lint' in dependency_groups")
    evaluation3: Marker::RhMarkerEvaluation = Marker::rh_marker_evaluate(membership, 0, membership.count.i64(), context)
    t8check(evaluation3.valid and evaluation3.state == Marker::RH_MARKER_RESULT_TRUE, "marker-extra-and-group-membership", fails)
    unknown: mutable darray[u8] = []
    Base::rh_push_text(unknown, "platform_machine == 'x86_64'")
    evaluation4: Marker::RhMarkerEvaluation = Marker::rh_marker_evaluate(unknown, 0, unknown.count.i64(), context)
    t8check(evaluation4.valid and evaluation4.state == Marker::RH_MARKER_RESULT_UNKNOWN, "marker-missing-context-is-unknown", fails)
    malformed: mutable darray[u8] = []
    Base::rh_push_text(malformed, "python_version >= '3.10' and (")
    evaluation5: Marker::RhMarkerEvaluation = Marker::rh_marker_evaluate(malformed, 0, malformed.count.i64(), context)
    t8check(not evaluation5.valid, "marker-malformed-is-distinct", fails)
    unknown_and_false: mutable darray[u8] = []
    Base::rh_push_text(unknown_and_false, "platform_machine == 'x86_64' and sys_platform == 'linux'")
    evaluation6: Marker::RhMarkerEvaluation = Marker::rh_marker_evaluate(unknown_and_false, 0, unknown_and_false.count.i64(), context)
    t8check(evaluation6.valid and evaluation6.state == Marker::RH_MARKER_RESULT_FALSE, "marker-unknown-and-false", fails)
    unknown_or_true: mutable darray[u8] = []
    Base::rh_push_text(unknown_or_true, "platform_machine == 'x86_64' or sys_platform == 'win32'")
    evaluation7: Marker::RhMarkerEvaluation = Marker::rh_marker_evaluate(unknown_or_true, 0, unknown_or_true.count.i64(), context)
    t8check(evaluation7.valid and evaluation7.state == Marker::RH_MARKER_RESULT_TRUE, "marker-unknown-or-true", fails)
    not_in: mutable darray[u8] = []
    Base::rh_push_text(not_in, "'docs' not in extras")
    evaluation8: Marker::RhMarkerEvaluation = Marker::rh_marker_evaluate(not_in, 0, not_in.count.i64(), context)
    t8check(evaluation8.valid and evaluation8.state == Marker::RH_MARKER_RESULT_TRUE, "marker-not-in-set", fails)
    return

def check_trailers(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    body: mutable darray[u8] = []
    Base::rh_push_text(body, "Add zero handling\n\nSigned-off-by: Dev One\nReviewed-by: Reviewer A <a@example.org>\nAcked-by: Reviewer B <b@example.org>\nFixes: deadbeef\nLink: https://example.invalid/1\n\nnot a trailer line\n")
    tl: mutable darray[Patch::RhTrailer] = []
    n: i64 = Patch::rh_trailers_scan(body, 100, tl)
    t8check(n == 5, "trailer-count-5", fails)
    k0: Patch::RhTrailer = tl[0]
    t8check(k0.kind == Patch::RH_TRAILER_OTHER, "trailer-signed-off-other", fails)
    t8check(Base::rh_bytes_equal_literal(body, k0.value_s, k0.value_e, "Dev One"), "trailer-value-trimmed", fails)
    k1: Patch::RhTrailer = tl[1]
    t8check(k1.kind == Patch::RH_TRAILER_REVIEWED, "trailer-reviewed", fails)
    t8check(Base::rh_bytes_equal_literal(body, k1.value_s, k1.value_e, "Reviewer A <a@example.org>"), "trailer-reviewer-value", fails)
    k3: Patch::RhTrailer = tl[3]
    t8check(k3.kind == Patch::RH_TRAILER_FIXES, "trailer-fixes", fails)
    t8check(Base::rh_bytes_equal_literal(body, k3.value_s, k3.value_e, "deadbeef"), "trailer-fixes-value", fails)
    # two distinct approver values
    t8check(Patch::rh_trailer_distinct_approvers(tl, body) == 2, "trailer-distinct-approvers-2", fails)
    # a duplicate reviewer collapses to one
    dup: mutable darray[u8] = []
    Base::rh_push_text(dup, "Reviewed-by: A\nReviewed-by: A\n")
    dl: mutable darray[Patch::RhTrailer] = []
    _ = Patch::rh_trailers_scan(dup, 100, dl)
    t8check(Patch::rh_trailer_distinct_approvers(dl, dup) == 1, "trailer-approver-dedup", fails)
    # non-trailer line rejected; empty value rejected
    no: mutable darray[u8] = []
    Base::rh_push_text(no, "just prose\nFixes:\n")
    nl: mutable darray[Patch::RhTrailer] = []
    n2: i64 = Patch::rh_trailers_scan(no, 100, nl)
    t8check(n2 == 0, "trailer-non-trailer-rejected", fails)
    return

# (private to this test)
def svn_fixture() -> darray[u8] can[Memory.Allocate, Abort.Panic]:
    raw: mutable darray[u8] =
        raw: mutable darray[u8] = []
        Base::rh_push_text(raw, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<log>\n")
        Base::rh_push_text(raw, "<logentry revision=\"1042\"><author>alice</author><date>2025-06-01T08:30:00Z</date>")
        Base::rh_push_text(raw, "<paths><path action=\"M\">/trunk/a.c</path><path action=\"A\">/trunk/b.c</path><path action=\"R\">/trunk/c.c</path></paths>")
        Base::rh_push_text(raw, "<msg>fix the &amp; case &lt;x&gt;</msg></logentry>\n")
        Base::rh_push_text(raw, "<logentry revision=\"1041\"><author>bob</author><date>2025-05-31T14:00:00Z</date>")
        Base::rh_push_text(raw, "<paths><path action=\"D\">/trunk/legacy.c</path></paths><msg>remove legacy</msg></logentry>\n")
        Base::rh_push_text(raw, "<logentry revision=\"1040\"><author>bob</author><date>2025-05-30T09:15:00Z</date>")
        Base::rh_push_text(raw, "<paths><path action=\"Q\">/trunk/weird.c</path></paths><msg>weird action</msg></logentry>\n")
        Base::rh_push_text(raw, "</log>\n")
        raw
    raw

def check_svn_parse(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    raw: darray[u8] = svn_fixture()
    log: Subversion::RhSvnLog = Subversion::rh_svn_parse(raw, 0)
    t8check(log.ok == 1, "svn-parse-ok", fails)
    t8check(log.entries.count == 3 and log.rejected == 0, "svn-three-entries", fails)
    e0: Subversion::RhSvnEntry = log.entries[0]
    t8check(e0.rev == 1042, "svn-rev-preserved", fails)
    t8check(Base::rh_bytes_equal_literal(log.pool, e0.author_s, e0.author_e, "alice"), "svn-author-raw", fails)
    t8check(e0.has_date == 1, "svn-date-present", fails)
    # entities decoded in text content
    t8check(Base::rh_bytes_equal_literal(log.pool, e0.msg_s, e0.msg_e, "fix the & case <x>"), "svn-msg-entity-decoded", fails)
    t8check(e0.path_count == 3, "svn-path-count", fails)
    t8check(e0.add_n == 1 and e0.modify_n == 1 and e0.replace_n == 1 and e0.delete_n == 0, "svn-actions-by-kind", fails)
    e1: Subversion::RhSvnEntry = log.entries[1]
    t8check(e1.rev == 1041 and e1.delete_n == 1, "svn-second-delete", fails)
    e2: Subversion::RhSvnEntry = log.entries[2]
    t8check(e2.rev == 1040 and e2.other_n == 1 and e2.add_n == 0, "svn-unknown-action-other", fails)
    return

def check_svn_reject(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    raw: mutable darray[u8] = []
    Base::rh_push_text(raw, "<log><logentry><author>x</author></logentry><logentry revision=\"7\"><author>y</author></logentry></log>")
    log: Subversion::RhSvnLog = Subversion::rh_svn_parse(raw, 0)
    t8check(log.ok == 1, "svn-reject-parse-ok", fails)
    t8check(log.entries.count == 1, "svn-nonnum-rev-rejected", fails)
    t8check(log.rejected == 1, "svn-nonnum-rev-counted", fails)
    return

def check_svn_bounds(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    raw: darray[u8] = svn_fixture()
    log: Subversion::RhSvnLog = Subversion::rh_svn_parse(raw, 2)
    t8check(log.ok == 0, "svn-cap-exceeded-fails", fails)
    notlog: mutable darray[u8] = []
    Base::rh_push_text(notlog, "<repository><entry/></repository>")
    t8check(Subversion::rh_svn_parse(notlog, 0).ok == 0, "svn-wrong-root-fails", fails)
    bad: mutable darray[u8] = []
    Base::rh_push_text(bad, "<log><logentry revision=\"1\"><author>x</author>")
    t8check(Subversion::rh_svn_parse(bad, 0).ok == 0, "svn-unterminated-fails", fails)
    notxml: mutable darray[u8] = []
    Base::rh_push_text(notxml, "plain text, not xml")
    t8check(Subversion::rh_svn_parse(notxml, 0).ok == 0, "svn-not-xml-fails", fails)
    return

def check_svn_fuzz_case(raw: darray[u8]&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    log: mutable Subversion::RhSvnLog = Subversion::rh_svn_parse(raw, 0)
    spans_valid: bool =
        while i < log.entries.count |valid: bool = true, i: usize = 0, log| -> valid:
            entry: Subversion::RhSvnEntry = log.entries[i]
            valid <- false if entry.author_s >= 0 and (entry.author_e < entry.author_s or entry.author_e > log.pool.count.i64())
            valid <- false if entry.msg_s >= 0 and (entry.msg_e < entry.msg_s or entry.msg_e > log.pool.count.i64())
            valid <- false if entry.date_s >= 0 and (entry.date_e < entry.date_s or entry.date_e > log.pool.count.i64())
            i <- i + 1
    bounded_result: bool = (log.ok == 0 or log.ok == 1) and log.entries.count <= raw.count and log.pool.count.i64() <= raw.count.i64() * 8 + 512 and log.rejected >= 0 and log.rejected <= raw.count.i64()
    t8check(spans_valid and bounded_result, "svn-fuzz-bounds-and-spans", fails)
    return

def check_svn_fuzz(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    corpus: darray[u8] = svn_fixture()
    while trial < 96 |trial: i64 = 0, rng: i64 = 173205, corpus, fails|:
        fuzzed: mutable darray[u8] = []
        while copied < corpus.count |copied: usize = 0, corpus, fuzzed|:
            fuzzed.push(corpus[copied])
            copied <- copied + 1
        rng <- (rng * 48271) % 2147483647
        edits: i64 = 1 + rng % 5
        while edit < edits |edit: i64 = 0, rng, fuzzed|:
            rng <- (rng * 48271) % 2147483647
            pos: usize = (rng % fuzzed.count.i64()).usize()
            rng <- (rng * 48271) % 2147483647
            fuzzed[pos] <- (rng % 128).u8()
            edit <- edit + 1
        check_svn_fuzz_case(fuzzed, fails)
        trial <- trial + 1

    while trial < 96 |trial: i64 = 0, corpus, fails|:
        prefix: usize = (trial * corpus.count.i64() / 96).usize()
        truncated: mutable darray[u8] = []
        while copied < prefix |copied: usize = 0, corpus, truncated|:
            truncated.push(corpus[copied])
            copied <- copied + 1
        check_svn_fuzz_case(truncated, fails)
        trial <- trial + 1
    return

def check_svn_native_form(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    t8check(Subversion::rh_svn_action_label(Subversion::RH_SVN_ACT_ADD)[0] == 65, "svn-add-label", fails)
    t8check(Subversion::rh_svn_action_of(68) == Subversion::RH_SVN_ACT_DELETE, "svn-action-D", fails)
    t8check(Subversion::rh_svn_action_of(90) == Subversion::RH_SVN_ACT_UNKNOWN, "svn-action-unknown", fails)
    return

