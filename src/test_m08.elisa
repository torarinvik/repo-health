    raw: mutable darray[u8] =
        raw: mutable darray[u8] = []
        Base::rh_push_text(raw, "# fossil timeline\n")
        Base::rh_push_text(raw, "aa3f1e2d4c5b6a79887766554433221100ffee11|alice|2025-06-01T08:30:00|trunk|*CURRENT*|trunk,release-1.0|fix the parser\n")
        Base::rh_push_text(raw, "bb4e2f3c5d6a7b88997766554433221100ffe002|bob|2025-05-31T14:00:00|trunk|*LEAF*||add tests\n")
        Base::rh_push_text(raw, "cc5f304d6e7b8c99aa88776655443322110ff003|bob|2025-05-30T09:15:00|feature-x|*UNPUBLISHED*|feature|wip: initial commit\n")
        raw
    raw

def check_fossil_parse(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    raw: darray[u8] = fossil_fixture()
    pool: mutable darray[u8] = []
    out: mutable darray[Fossil::RhFossilEntry] = []
    rej: mutable i64 = 0
    rc: i64 = Fossil::rh_fossil_parse(raw, 0, pool, out, &rej)
    t8check(rc == 0, "fossil-parse-ok", fails)
    t8check(out.count == 3 and rej == 0, "fossil-three-entries", fails)
    e0: Fossil::RhFossilEntry = out[0]
    t8check(Base::rh_bytes_equal_literal(pool, e0.hash_s, e0.hash_e, "aa3f1e2d4c5b6a79887766554433221100ffee11"), "fossil-hash-preserved", fails)
    t8check(Base::rh_bytes_equal_literal(pool, e0.author_s, e0.author_e, "alice"), "fossil-author-raw", fails)
    t8check(e0.utc == 1748766600 and e0.has_date == 1, "fossil-date-utc", fails)
    t8check(Base::rh_bytes_equal_literal(pool, e0.branch_s, e0.branch_e, "trunk"), "fossil-branch", fails)
    t8check(e0.tag_count == 2, "fossil-tag-count", fails)
    t8check(e0.phase_count == 1, "fossil-phase-count", fails)
    t8check(Base::rh_bytes_equal_literal(pool, e0.comment_s, e0.comment_e, "fix the parser"), "fossil-comment", fails)
    e1: Fossil::RhFossilEntry = out[1]
    t8check(e1.tag_count == 0 and e1.phase_count == 1, "fossil-tag-phase-2", fails)
    t8check(e1.utc == 1748700000, "fossil-date-2", fails)
    e2: Fossil::RhFossilEntry = out[2]
    t8check(Base::rh_bytes_equal_literal(pool, e2.branch_s, e2.branch_e, "feature-x"), "fossil-branch-2", fails)
    t8check(e2.tag_count == 1, "fossil-tag-count-2", fails)
    return

def check_fossil_native_form(fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    h40: mutable darray[u8] = []
