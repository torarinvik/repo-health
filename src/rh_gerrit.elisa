# rh_gerrit.elisa — Gerrit review-workflow parser (M08 review lane).
#
# Gerrit is a non-PR review workflow: a *change* accumulates re-pushed
# patch-sets over its life. The plan's non-PR criterion (R025) is explicit:
# "3x-revised patch series != 3 changes". This module folds a change to
# exactly one logical change and reports its patch-set (revision) count, so
# a change reviewed three times is never inflated into three changes.
#
# Gerrit timestamps are `YYYY-MM-DD HH:MM:SS.fffffffff` (a space, not `T`,
# with nanosecond fractional seconds). They are converted to epoch seconds by
# dropping the fraction and substituting `T`, then reusing the strict ISO8601
# parser (fail closed: an unparseable time fails the change, never guessed).
# Only fields that exist are mapped; anything absent is null, never invented.

include "./rh_base.elisa"
include "./rh_json.elisa"

# Count the members of a JSON object (a Gerrit `revisions` map is keyed by
# commit SHA; each member is one patch-set). Object children alternate
# key,value,key,value..., so only value nodes (every second child) are
# counted. Returns -1 when not an object.
module Gerrit:
    private:
        def rh_gerrit_obj_count(nodes: darray[Json::RhJsonNode]&, idx: i64) -> i64:
            return -1 if idx < 0 or nodes[idx.usize()].kind != Json::RH_JSON_OBJ
            while child >= 0 |n: i64 = 0, child: i64 = nodes[idx.usize()].first_child| -> n:
                # skip the key node; the value node is next_sibling
                child <- nodes[child.usize()].next_sibling
                break if child < 0
                n <- n + 1
                child <- nodes[child.usize()].next_sibling

        # Parse a Gerrit timestamp at text span [s,e). Returns epoch seconds; ok_out
        # is set to 1 only on success. The space separator is replaced by `T` and the
        # fractional part is dropped before strict ISO parsing.
        def rh_gerrit_time(texts: darray[u8]&, s: i64, e: i64, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
            ok_out[0] <- 0
            return 0 if e <= s
            buf: mutable darray[u8] = []
            while k < e |k: i64 = s, e, texts, buf|:
                b: u8 = texts[k.usize()]
                if b == 32:
                    buf.push(84)
                elif b == 46:
                    # drop the fractional seconds; keep the timezone marker if any
                    j: i64 =
                        while j < e |j: i64 = k, buf| -> j:
                            tb: u8 = texts[j.usize()]
                            break if tb == 43 or tb == 45
                            j <- j + 1
                    k <- j
                    continue
                else:
                    buf.push(b)
                k <- k + 1
            if buf.count == 0:
                return 0
            # A Gerrit bare timestamp has no timezone; append Z so the ISO parser
            # reads it as UTC rather than failing on the missing tz marker.
            has_tz: bool =
                while m < buf.count |has_tz: bool = false, m: usize = 0, buf| -> has_tz:
                    if buf[m] == 43 or buf[m] == 45:
                        if m > 11:
                            has_tz <- true
                    m <- m + 1
            if not has_tz:
                buf.push(90)
            Forge::rh_parse_iso8601(buf, 0, buf.count, ok_out)

        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_gerrit_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
            idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
            return false if idx < 0
            Json::rh_json_str_span(nodes, idx, s_out, e_out)

        # Parse a Gerrit `QueryChanges` JSON document and write `rh-gerrit/1`. Returns
        # 0 ok, -1 malformed. An empty list is valid (zero changes). Each change
        # contributes exactly one entry with `revision_count` = the number of members
        # of its `revisions` object (1 when absent, since a change has at least its
        # initial patch-set).
    public:
        def rh_gerrit_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            nodes: mutable darray[Json::RhJsonNode] = []
            texts: mutable darray[u8] = []
            root: i64 = Json::rh_json_parse(raw, nodes, texts)
            return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_ARR
            arr: Json::RhJsonNode = nodes[root.usize()]
            total: mutable i64 = 0
            revisions_total: mutable i64 = 0
            body: mutable darray[u8] = []
            while child >= 0 |child: i64 = arr.first_child, first: bool = true, nodes, texts, raw, out, body, total, revisions_total|:
                return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
                oknum: mutable i64 = 0
                num: i64 = Json::rh_json_int(nodes, raw, Json::rh_json_obj_get(nodes, texts, child, "_number"), &oknum)
                return -1 if oknum == 0
                ps: mutable i64 = 0
                pe: mutable i64 = 0
                return -1 if not rh_gerrit_str(nodes, texts, child, "project", &ps, &pe)
                bs: mutable i64 = 0
                be: mutable i64 = 0
                return -1 if not rh_gerrit_str(nodes, texts, child, "branch", &bs, &be)
                ss: mutable i64 = 0
                se: mutable i64 = 0
                return -1 if not rh_gerrit_str(nodes, texts, child, "subject", &ss, &se)
                sts: mutable i64 = 0
                ste: mutable i64 = 0
                return -1 if not rh_gerrit_str(nodes, texts, child, "status", &sts, &ste)
                cs: mutable i64 = 0
                ce: mutable i64 = 0
                return -1 if not rh_gerrit_str(nodes, texts, child, "created", &cs, &ce)
                us: mutable i64 = 0
                ue: mutable i64 = 0
                return -1 if not rh_gerrit_str(nodes, texts, child, "updated", &us, &ue)
                cok: mutable i64 = 0
                created: i64 = rh_gerrit_time(texts, cs, ce, &cok)
                return -1 if cok == 0
                uok: mutable i64 = 0
                updated: i64 = rh_gerrit_time(texts, us, ue, &uok)
                return -1 if uok == 0
                revs: mutable i64 =
                    ridx: i64 = Json::rh_json_obj_get(nodes, texts, child, "revisions")
                    block_result: i64 = rh_gerrit_obj_count(nodes, ridx)
                    block_result
                if revs < 0:
                    revs <- 1
                if revs < 1:
                    revs <- 1
                revisions_total <- revisions_total + revs
                total <- total + 1
                if not first:
                    body.push(44)
                first <- false
                Base::rh_push_text(body, "{\"change_number\":")
                Base::rh_push_decimal_i64(body, num)
                Base::rh_push_text(body, ",\"project\":\"")
                Base::rh_json_escape(body, texts, ps.usize(), pe.usize())
                Base::rh_push_text(body, "\",\"branch\":\"")
                Base::rh_json_escape(body, texts, bs.usize(), be.usize())
                Base::rh_push_text(body, "\",\"subject\":\"")
                Base::rh_json_escape(body, texts, ss.usize(), se.usize())
                Base::rh_push_text(body, "\",\"status\":\"")
                Base::rh_json_escape(body, texts, sts.usize(), ste.usize())
                Base::rh_push_text(body, "\",\"created_at\":")
                Base::rh_push_decimal_i64(body, created)
                Base::rh_push_text(body, ",\"updated_at\":")
                Base::rh_push_decimal_i64(body, updated)
                Base::rh_push_text(body, ",\"revision_count\":")
                Base::rh_push_decimal_i64(body, revs)
                Base::rh_push_text(body, "}")
                child <- nodes[child.usize()].next_sibling
            Base::rh_push_text(out, "{\"schema\":\"rh-gerrit/1\",\"format\":\"gerrit\",\"change_count\":")
            Base::rh_push_decimal_i64(out, total)
            Base::rh_push_text(out, ",\"revision_count\":")
            Base::rh_push_decimal_i64(out, revisions_total)
            Base::rh_push_text(out, ",\"changes\":[")
            _ = Base::rh_absorb_bytes(body, out)
            Base::rh_push_text(out, "],\"note\":\"a change is one logical unit even when it is re-pushed many times; revision_count is the patch-set count, so 3x-revised is one change, not three; a Gerrit change is not a merged release\"}")
            0
