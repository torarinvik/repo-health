# test_m05.elisa — M05 acceptance: labeled projections, temporal edges,
# reverse traversal, SCC, mirrors/families, downstream joins, adoption,
# scenarios, anti-circularity. Deterministic, offline.
#
# Usage: test_m05  (no arguments)
# Exit 0 pass, 1 failure.

include "./rh_base.elisa"
include "./rh_graph.elisa"
include "./rh_downstream.elisa"

def gfail_lbl(cond: bool, label: u8&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    return 0 if cond
    b: mutable darray[u8] =
        b: mutable darray[u8] = []
        rh_push_text(b, "M05-FAIL ")
        rh_push_text(b, label)
        b.push(10)
        b
    rh_write_stdout(b)
    1

def edge(a: i64, b: i64, scope: u8, platform: i64, intro: i64, removed: i64, seen: i64) -> RhGraphEdge:
    RhGraphEdge{from: a, dst: b, scope: scope, platform: platform, introduced: intro, removed: removed, first_seen: seen}

def anyproj() -> RhProjection:
    rh_projection_make(1, RH_SCOPE_ALL, 0, 0, 0, 0, 0, false, 100000, 100)

def count_ok(edges: darray[RhGraphEdge]&, vis: darray[u8]&, subject: i64, p: RhProjection&, want_direct: i64, want_trans: i64, label: u8&, fails: mutable i64&) -> void can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast]:
    d: i64 =
        direct: mutable darray[i64] = []
        block_result: i64 = rh_direct_dependents(edges, vis, subject, p, direct)
        block_result
    tt: i64 =
        trans: mutable darray[i64] = []
        tr: mutable i64 = 0
        block_result: i64 = rh_transitive_dependents(edges, vis, subject, p, trans, &tr)
        block_result
    fails <- fails + gfail_lbl(d == want_direct, label)
    fails <- fails + gfail_lbl(tt == want_trans, label)

def main() -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    fails: mutable i64 = 0
    vis: mutable darray[u8] = []
    p: RhProjection = anyproj()

    # ---- chain: 1 -> 2 -> 3 (consumer edges point at dependencies) ----
    chain: mutable darray[RhGraphEdge] =
        chain: mutable darray[RhGraphEdge] = []
        chain.push(edge(1, 2, 0, 0, 0, 0, 100))
        chain.push(edge(2, 3, 0, 0, 0, 0, 100))
        chain
    count_ok(chain, vis, 3, &p, 1, 2, "chain-subject-3", &fails)
    count_ok(chain, vis, 2, &p, 1, 1, "chain-subject-2", &fails)
    count_ok(chain, vis, 1, &p, 0, 0, "chain-subject-1", &fails)

    # ---- diamond: 1->2, 1->3, 2->4, 3->4 (unique nodes once) ----
    dia: mutable darray[RhGraphEdge] =
        dia: mutable darray[RhGraphEdge] = []
        dia.push(edge(1, 2, 0, 0, 0, 0, 100))
        dia.push(edge(1, 3, 0, 0, 0, 0, 100))
        dia.push(edge(2, 4, 0, 0, 0, 0, 100))
        dia.push(edge(3, 4, 0, 0, 0, 0, 100))
        dia
    count_ok(dia, vis, 4, &p, 2, 3, "diamond-subject-4", &fails)
    count_ok(dia, vis, 2, &p, 1, 1, "diamond-subject-2", &fails)

    # ---- cycle: 1->2, 2->1 (terminates; subject excluded from its own) ----
    scc_disc: i64 = |fails, vis|
        scc_cyc: i64 = |fails, vis|
            cyc: mutable darray[RhGraphEdge] =
                cyc: mutable darray[RhGraphEdge] = []
                cyc.push(edge(1, 2, 0, 0, 0, 0, 100))
                cyc.push(edge(2, 1, 0, 0, 0, 0, 100))
                cyc
            count_ok(cyc, vis, 1, &p, 1, 1, "cycle-terminates-subject-excluded", &fails)
            block_result: i64 = rh_scc_count(cyc, vis, 3, &p)
            block_result
        fails <- fails + gfail_lbl(scc_cyc == 2, "scc-cycle-components")

        # ---- disconnected: 1->2, 3->4 → two components ----
        disc: mutable darray[RhGraphEdge] =
            disc: mutable darray[RhGraphEdge] = []
            disc.push(edge(1, 2, 0, 0, 0, 0, 100))
            disc.push(edge(3, 4, 0, 0, 0, 0, 100))
            disc
        count_ok(disc, vis, 2, &p, 1, 1, "disconnected-subject-2", &fails)
        block_result: i64 = rh_scc_count(disc, vis, 5, &p)
        block_result
    fails <- fails + gfail_lbl(scc_disc == 5, "scc-oneway-edges-singletons")

    # ---- multigraph: duplicate evidence dedups; version duplicates count ----
    multi: mutable darray[RhGraphEdge] =
        multi: mutable darray[RhGraphEdge] = []
        multi.push(edge(1, 5, 0, 0, 0, 0, 100))
        multi.push(edge(1, 5, 0, 0, 0, 0, 200))
        multi.push(edge(2, 5, 0, 0, 0, 0, 100))
        multi
    count_ok(multi, vis, 5, &p, 2, 2, "multigraph-dedup", &fails)
    # "two versions of one package" = two distinct nodes for the same name.
    vers: mutable darray[RhGraphEdge] =
        vers: mutable darray[RhGraphEdge] = []
        vers.push(edge(1, 5, 0, 0, 0, 0, 100))
        vers.push(edge(2, 6, 0, 0, 0, 0, 100))
        vers
    count_ok(vers, vis, 5, &p, 1, 1, "version-a", &fails)
    count_ok(vers, vis, 6, &p, 1, 1, "version-b-distinct-node", &fails)

    # ---- mirror/family dedup (accepted assertions only) ----
    asserts: mutable darray[RhAssertion] = []
    asserts.push(RhAssertion{a: 7, b: 5, state: RH_ASSERT_PROPOSED})
    mirrored: mutable darray[i64] =
        mirrored: mutable darray[i64] = []
        mirrored.push(5)
        mirrored.push(7)
        mirrored
    dm2: i64 = |fails, asserts, mirrored|
        dm: i64 = |asserts, mirrored|
            deduped: mutable darray[i64] = []
            block_result: i64 = rh_family_dedup(mirrored, asserts, deduped)
            block_result
        fails <- fails + gfail_lbl(dm == 2, "mirror-proposed-does-not-group")
        asserts[0].state <- RH_ASSERT_ACCEPTED
        deduped2: mutable darray[i64] = []
        block_result: i64 = rh_family_dedup(mirrored, asserts, deduped2)
        block_result
    fails <- fails + gfail_lbl(dm2 == 1, "mirror-accepted-groups")
    asserts[0].state <- RH_ASSERT_REVOKED
    deduped3: mutable darray[i64] = []
    dm3: i64 = rh_family_dedup(mirrored, asserts, deduped3)
    fails <- fails + gfail_lbl(dm3 == 2, "mirror-revoked-ungroups")

    # ---- truncation: budget hit reports truncation, not a total ----
    truncp: RhProjection = rh_projection_make(2, RH_SCOPE_ALL, 0, 0, 0, 0, 0, false, 1, 100)
    t2: mutable darray[i64] = []
    tr2: mutable i64 = 0
    tn: i64 = rh_transitive_dependents(chain, vis, 3, &truncp, t2, &tr2)
    fails <- fails + gfail_lbl(tn == 1 and tr2 == 1, "truncation-flagged")

    # ---- private dependent invisible to public projections ----
    privvis: mutable darray[u8] =
        privvis: mutable darray[u8] = []
        privvis.push(RH_VIS_PUBLIC)
        privvis.push(RH_VIS_PRIVATE)
        privvis.push(RH_VIS_PUBLIC)
        privvis.push(RH_VIS_PUBLIC)
        privvis
    pubp: RhProjection = rh_projection_make(3, RH_SCOPE_ALL, 0, 0, 0, 0, 0, true, 1000, 100)
    priv: mutable darray[RhGraphEdge] =
        priv: mutable darray[RhGraphEdge] = []
        priv.push(edge(1, 4, 0, 0, 0, 0, 100))
        priv.push(edge(2, 4, 0, 0, 0, 0, 100))
        priv
    nd: i64 = |privvis, priv|
        pd: mutable darray[i64] = []
        block_result: i64 = rh_direct_dependents(priv, privvis, 4, &pubp, pd)
        block_result
    fails <- fails + gfail_lbl(nd == 1, "private-dependent-excluded")
    allp: RhProjection = anyproj()
    na: i64 = |privvis, priv|
        ad: mutable darray[i64] = []
        block_result: i64 = rh_direct_dependents(priv, privvis, 4, &allp, ad)
        block_result
    fails <- fails + gfail_lbl(na == 2, "private-visible-when-scoped")

    # S007: a private INTERMEDIATE node must not let its subtree leak into
    # a public projection. chain: 5 -> 2(private) -> 4 (consumer points at
    # dependency). Public projection of 4 must NOT reach 5, and must not
    # even enqueue 2 to the frontier.
    chainvis: mutable darray[u8] =
        chainvis: mutable darray[u8] = []
        chainvis.push(RH_VIS_PUBLIC)
        chainvis.push(RH_VIS_PUBLIC)
        chainvis.push(RH_VIS_PRIVATE)
        chainvis.push(RH_VIS_PUBLIC)
        chainvis.push(RH_VIS_PUBLIC)
        chainvis.push(RH_VIS_PUBLIC)
        chainvis
    pubchain: mutable darray[RhGraphEdge] =
        pubchain: mutable darray[RhGraphEdge] = []
        pubchain.push(edge(2, 4, 0, 0, 0, 0, 100))
        pubchain.push(edge(5, 2, 0, 0, 0, 0, 100))
        pubchain
    proves_private_absent: bool = |fails, chainvis, pubchain|
        nd2: i64 = |chainvis, pubchain|
            pd2: mutable darray[i64] = []
            block_result: i64 = rh_direct_dependents(pubchain, chainvis, 4, &pubp, pd2)
            block_result
        fails <- fails + gfail_lbl(nd2 == 0, "private-intermediate-blocks-public-direct")
        pt2: mutable darray[i64] = []
        nt2: i64 = |chainvis, pubchain, pt2|
            ptr2: mutable i64 = 0
            block_result: i64 = rh_transitive_dependents(pubchain, chainvis, 4, &pubp, pt2, &ptr2)
            block_result
        fails <- fails + gfail_lbl(nt2 == 0, "private-subtree-not-in-public-frontier")
        not rh_contains(pt2, 5)
    fails <- fails + gfail_lbl(proves_private_absent, "private-5-absent-from-frontier")
    # Under the unfiltered projection the same chain is fully visible.
    at2: mutable darray[i64] = []
    atr2: mutable i64 = 0
    nat2: i64 = rh_transitive_dependents(pubchain, chainvis, 4, &allp, at2, &atr2)
    fails <- fails + gfail_lbl(nat2 == 2, "private-chain-visible-when-all")

    # ---- F021: optional edges are excluded from a runtime-context view ----
    # Scope bytes are caller-defined: 1 = runtime, 2 = optional.
    opt_edges: mutable darray[RhGraphEdge] =
        opt_edges: mutable darray[RhGraphEdge] = []
        opt_edges.push(edge(1, 9, 1, 0, 0, 0, 100))
        opt_edges.push(edge(2, 9, 2, 0, 0, 0, 100))
        opt_edges
    runtimep: RhProjection = rh_projection_make(9, 1, 0, 0, 0, 0, 0, false, 1000, 100)
    nod_all: i64 = |fails, vis, opt_edges|
        nod: i64 = |vis, opt_edges|
            od: mutable darray[i64] = []
            block_result: i64 = rh_direct_dependents(opt_edges, vis, 9, &runtimep, od)
            block_result
        fails <- fails + gfail_lbl(nod == 1, "optional-excluded-in-context")
        od_all: mutable darray[i64] = []
        block_result: i64 = rh_direct_dependents(opt_edges, vis, 9, &allp, od_all)
        block_result
    fails <- fails + gfail_lbl(nod_all == 2, "optional-included-when-all")
    oe: RhGraphEdge = opt_edges[1]
    hidden: bool = rh_edge_visible(oe, &runtimep, vis)
    fails <- fails + gfail_lbl(not hidden, "optional-edge-hidden-runtime")
    shown: bool = rh_edge_visible(oe, &allp, vis)
    fails <- fails + gfail_lbl(shown, "optional-edge-visible-all")

    # ---- temporal edges: valid time vs known time (no leakage) ----
    # introduced 2024-01, removed 2025-01, first collected 2026-01.
    t2024: i64 = 1704067200
    t2025: i64 = 1735689600
    t2026: i64 = 1767225600
    temp: mutable darray[RhGraphEdge] = []
    temp.push(edge(1, 2, 0, 0, t2024, t2025, t2026))
    known2025: RhProjection = rh_projection_make(4, RH_SCOPE_ALL, 0, 0, t2025 + 100, 0, 0, false, 1000, 100)
    known2026: RhProjection = rh_projection_make(5, RH_SCOPE_ALL, 0, 0, t2026 + 100, 0, 0, false, 1000, 100)
    n25: i64 = |vis, temp|
        d25: mutable darray[i64] = []
        block_result: i64 = rh_direct_dependents(temp, vis, 2, &known2025, d25)
        block_result
    n26: i64 = |vis, temp|
        d26: mutable darray[i64] = []
        block_result: i64 = rh_direct_dependents(temp, vis, 2, &known2026, d26)
        block_result
    fails <- fails + gfail_lbl(n25 == 0, "known-2025-cannot-see-2026-discovery")
    fails <- fails + gfail_lbl(n26 == 1, "known-2026-sees-discovery")
    valid2023: RhProjection = rh_projection_make(6, RH_SCOPE_ALL, 0, t2024 - 100, 0, 0, 0, false, 1000, 100)
    valid2024: RhProjection = rh_projection_make(7, RH_SCOPE_ALL, 0, t2024 + 100, 0, 0, 0, false, 1000, 100)
    valid2026: RhProjection = rh_projection_make(8, RH_SCOPE_ALL, 0, t2026, 0, 0, 0, false, 1000, 100)
    nv23: i64 = |vis, temp|
        vd23: mutable darray[i64] = []
        block_result: i64 = rh_direct_dependents(temp, vis, 2, &valid2023, vd23)
        block_result
    nv24: i64 = |vis, temp|
        vd24: mutable darray[i64] = []
        block_result: i64 = rh_direct_dependents(temp, vis, 2, &valid2024, vd24)
        block_result
    nv26: i64 = |vis, temp|
        vd26: mutable darray[i64] = []
        block_result: i64 = rh_direct_dependents(temp, vis, 2, &valid2026, vd26)
        block_result
    fails <- fails + gfail_lbl(nv23 == 0, "valid-2023-before-introduction")
    fails <- fails + gfail_lbl(nv24 == 1, "valid-2024-after-introduction")
    fails <- fails + gfail_lbl(nv26 == 0, "valid-2026-after-removal")

    # ---- downstream join: per-metric covered denominators ----
    deps: mutable darray[i64] =
        deps: mutable darray[i64] = []
        deps.push(1)
        deps.push(2)
        deps.push(3)
        deps
    mask: mutable darray[u64] = []
    mask.push(0)     # node0 unused
    mask.push(265)   # node1: bits 0,3,8 (history + persistence + release)
    mask.push(1)     # node2: bit 0 only
    mask.push(0)     # node3: nothing
    cov: mutable darray[i64] = []
    tot: mutable i64 = 0
    Downstream::rh_downstream_coverage(deps, mask, 10, cov, &tot)
    fails <- fails + gfail_lbl(tot == 3, "downstream-total-3")
    fails <- fails + gfail_lbl(cov[0] == 2, "coverage-metric0-2")
    fails <- fails + gfail_lbl(cov[3] == 1, "coverage-metric3-independent")
    fails <- fails + gfail_lbl(cov[8] == 1, "coverage-metric8-independent")
    fails <- fails + gfail_lbl(cov[1] == 0, "coverage-metric1-0")
    hist: mutable darray[i64] = []
    vals: mutable darray[i64] =
        vals: mutable darray[i64] = []
        vals.push(1)
        vals.push(5)
        vals.push(9)
        vals
    Downstream::rh_histogram(vals, 3, 12, hist)
    fails <- fails + gfail_lbl(hist[0] == 1 and hist[1] == 1 and hist[2] == 1, "histogram-buckets")

    # ---- anti-circularity: dependents do not change intrinsic values ----
    intrin: mutable darray[i64] =
        intrin: mutable darray[i64] = []
        intrin.push(42)
        intrin.push(7)
        intrin
    before_sum: i64 = intrin[0] + intrin[1]
    xn: i64 = |vis|
        extra: mutable darray[RhGraphEdge] = []
        while e < 500 |e: i64 = 0, extra|:
            extra.push(edge(100 + e, 7, 0, 0, 0, 0, 100))
            e <- e + 1
        xd: mutable darray[i64] = []
        block_result: i64 = rh_direct_dependents(extra, vis, 7, &p, xd)
        block_result
    after_sum: i64 = intrin[0] + intrin[1]
    fails <- fails + gfail_lbl(xn == 500, "anti-circularity-many-dependents")
    fails <- fails + gfail_lbl(before_sum == after_sum, "anti-circularity-intrinsics-unchanged")

    # ---- adoption staged evidence + censoring + supported line ----
    a1: Downstream::RhAdoption = Downstream::RhAdoption{first_seen: 100, confirmed_intro: 0, last_seen: 900, confirmed_removal: 0}
    fails <- fails + gfail_lbl(Downstream::rh_adoption_status(&a1) == Downstream::RH_ADOPT_FIRST_SEEN_ONLY, "adopt-first-seen")
    a2: Downstream::RhAdoption = Downstream::RhAdoption{first_seen: 100, confirmed_intro: 120, last_seen: 900, confirmed_removal: 0}
    fails <- fails + gfail_lbl(Downstream::rh_adoption_status(&a2) == Downstream::RH_ADOPT_CONFIRMED_INTRO, "adopt-confirmed-intro")
    a3: Downstream::RhAdoption = Downstream::RhAdoption{first_seen: 100, confirmed_intro: 120, last_seen: 900, confirmed_removal: 950}
    fails <- fails + gfail_lbl(Downstream::rh_adoption_status(&a3) == Downstream::RH_ADOPT_CONFIRMED_REMOVAL, "adopt-confirmed-removal")
    fails <- fails + gfail_lbl(Downstream::rh_censored_duration(10, 0, 100) == -1, "adopt-duration-censored")
    fails <- fails + gfail_lbl(Downstream::rh_censored_duration(10, 50, 100) == 40, "adopt-duration-measured")
    fails <- fails + gfail_lbl(Downstream::rh_observed_upgrade(1000001, 1000002), "upgrade-observed")
    fails <- fails + gfail_lbl(not Downstream::rh_observed_upgrade(0, 1000002), "upgrade-unknown-not-assumed")
    fails <- fails + gfail_lbl(Downstream::rh_on_supported_line(1000002, 1), "supported-line-1x")
    fails <- fails + gfail_lbl(not Downstream::rh_on_supported_line(2000000, 1), "off-supported-line")

    # ---- shared maintenance exposure ----
    aa: mutable darray[i64] = []
    bb: mutable darray[i64] = []
    aa.push(1)
    aa.push(2)
    aa.push(2)
    bb.push(2)
    bb.push(3)
    shared: i64 = Downstream::rh_actor_overlap(aa, bb)
    fails <- fails + gfail_lbl(shared == 1, "shared-maintenance-1")

    # ---- scenario: simulated unavailability shrinks the dependent set ----
    s2: mutable darray[i64] = []
    strunc: mutable i64 = 0
    sn: i64 = rh_scenario_unavailable(dia, vis, 4, 2, &p, s2, &strunc)
    fails <- fails + gfail_lbl(sn == 2, "scenario-unavailable-2")

    if fails == 0:
        b2: mutable darray[u8] =
            b2: mutable darray[u8] = []
            rh_push_text(b2, "M05 OK")
            b2.push(10)
            b2
        rh_write_stdout(b2)
        return 0
    1

