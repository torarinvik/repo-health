# rh_notify_report.elisa — notification policy execution path (M06-08).
#
# Turns an `rh-notify-input/1` event stream into an `rh-notify-result/1`
# report. The non-negotiable rule is enforced here too: an upstream
# maintainer destination is only authorized when the input marks it
# subscribed; otherwise the decision is suppressed_unauthorized and nothing
# is recorded, so a refusal never starts a cooldown. Dedup/cooldown are keyed
# on (rule, subject, artifact digest); a changed digest is a new key; outage
# suppresses; ack/resolve silence a key.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_notify.elisa"

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    Base::rh_bytes_equal_literal(texts, s, e, lit)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_target(texts: darray[u8]&, s: i64, e: i64) -> i64:
    return Notify::RH_TARGET_SUBSCRIBER if rh_nr_eq(texts, s, e, "subscriber")
    return Notify::RH_TARGET_MAINTAINER_SELF if rh_nr_eq(texts, s, e, "maintainer_self")
    return Notify::RH_TARGET_UPSTREAM_MAINTAINER if rh_nr_eq(texts, s, e, "upstream_maintainer")
    return Notify::RH_TARGET_OPERATOR if rh_nr_eq(texts, s, e, "operator")
    -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_hex_span(texts: darray[u8]&, s: i64, e: i64, hi_out: mutable u64&, lo_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
    hi_out[0] <- 0
    lo_out[0] <- 0
    n: i64 = e - s
    return false if n != 16 and n != 32
    first: i64 = 32 if n == 32 else 16
    acc: u64 =
        while k < s + 16 |acc: u64 = 0, k: i64 = s| -> acc:
            b: u8 = texts[k.usize()]
            d: mutable u64 = (b - 48).u64() if b >= 48 and b <= 57 else 99
            if b >= 97 and b <= 102:
                d <- (b - 87).u64()
            return false if d > 15
            acc <- acc * 16 + d
            k <- k + 1
    hi_out[0] <- acc
    if first == 32:
        acc2: u64 =
            while k2 < s + 32 |acc2: u64 = 0, k2: i64 = s + 16| -> acc2:
                b2: u8 = texts[k2.usize()]
                d2: mutable u64 = (b2 - 48).u64() if b2 >= 48 and b2 <= 57 else 99
                if b2 >= 97 and b2 <= 102:
                    d2 <- (b2 - 87).u64()
                return false if d2 > 15
                acc2 <- acc2 * 16 + d2
                k2 <- k2 + 1
        lo_out[0] <- acc2
    true

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_str(nodes: darray[Json::RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
    return false if idx < 0
    Json::rh_json_str_span(nodes, idx, s_out, e_out)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_int(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    ok_out[0] <- 0
    idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
    return 0 if idx < 0
    Json::rh_json_int(nodes, raw, idx, ok_out)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_bool(nodes: darray[Json::RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, default_v: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    idx: i64 = Json::rh_json_obj_get(nodes, texts, obj, key)
    return default_v if idx < 0
    Json::rh_json_is_true(nodes, raw, idx)

def rh_nr_label(d: u8) -> u8&:
    return "new" if d == Notify::RH_NOTIFY_NEW
    return "suppressed_unauthorized" if d == Notify::RH_NOTIFY_SUPPRESSED_UNAUTHORIZED
    return "suppressed_outage" if d == Notify::RH_NOTIFY_SUPPRESSED_OUTAGE
    return "suppressed_resolved" if d == Notify::RH_NOTIFY_SUPPRESSED_RESOLVED
    return "suppressed_acknowledged" if d == Notify::RH_NOTIFY_SUPPRESSED_ACKNOWLEDGED
    "suppressed_cooldown"

# Parse a persisted `rh-notify-state/1` document into state rows. Returns 0
# ok, -1 malformed. An empty buffer is a fresh (empty) state.
def rh_notify_parse_state(raw: darray[u8]&, states: mutable darray[Notify::RhNotifyState]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    return 0 if raw.count == 0
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    rows: i64 = |nodes, texts|
        root: i64 = Json::rh_json_parse(raw, nodes, texts)
        return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
        ss: mutable i64 = 0
        se: mutable i64 = 0
        return -1 if not rh_nr_str(nodes, texts, root, "schema", &ss, &se)
        return -1 if not rh_nr_eq(texts, ss, se, "rh-notify-state/1")
        block_result: i64 = Json::rh_json_obj_get(nodes, texts, root, "rows")
        block_result
    return -1 if rows < 0 or nodes[rows.usize()].kind != Json::RH_JSON_ARR
    arr: Json::RhJsonNode = nodes[rows.usize()]
    while child >= 0 |child: i64 = arr.first_child, nodes, texts, raw, states|:
        return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
        okr: mutable i64 = 0
        oks: mutable i64 = 0
        okl: mutable i64 = 0
        rule_id: i64 = rh_nr_int(nodes, raw, texts, child, "rule_id", &okr)
        subject_id: i64 = rh_nr_int(nodes, raw, texts, child, "subject_id", &oks)
        last_sent: i64 = rh_nr_int(nodes, raw, texts, child, "last_sent_at", &okl)
        return -1 if okr == 0 or oks == 0 or okl == 0
        dgs: mutable i64 = 0
        dge: mutable i64 = 0
        return -1 if not rh_nr_str(nodes, texts, child, "artifact_digest", &dgs, &dge)
        hi: mutable u64 = 0
        lo: mutable u64 = 0
        return -1 if not rh_nr_hex_span(texts, dgs, dge, &hi, &lo)
        ack: bool = rh_nr_bool(nodes, raw, texts, child, "acknowledged", false)
        res: bool = rh_nr_bool(nodes, raw, texts, child, "resolved", false)
        states.push(Notify::RhNotifyState{rule_id: rule_id, subject_id: subject_id, artifact_high: hi, artifact_low: lo, last_sent_at: last_sent, acknowledged: ack, resolved: res})
        child <- nodes[child.usize()].next_sibling
    0

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_push_digest(out: mutable darray[u8]&, hi: u64, lo: u64) -> void can[Memory.Allocate, Abort.Panic]:
    Base::rh_push_hex_u64(out, hi)
    Base::rh_push_hex_u64(out, lo)

# Emit the persisted `rh-notify-state/1` document (durable across runs).
def rh_notify_emit_state(states: darray[Notify::RhNotifyState]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    Base::rh_push_text(out, "{\"schema\":\"rh-notify-state/1\",\"rows\":[")
    while i < states.count |i: usize = 0, states, out|:
        s: Notify::RhNotifyState = states[i]
        if i > 0:
            out.push(44)
        Base::rh_push_text(out, "{\"rule_id\":")
        Base::rh_push_decimal_i64(out, s.rule_id)
        Base::rh_push_text(out, ",\"subject_id\":")
        Base::rh_push_decimal_i64(out, s.subject_id)
        Base::rh_push_text(out, ",\"artifact_digest\":\"")
        rh_nr_push_digest(out, s.artifact_high, s.artifact_low)
        Base::rh_push_text(out, "\",\"last_sent_at\":")
        Base::rh_push_decimal_i64(out, s.last_sent_at)
        Base::rh_push_text(out, ",\"acknowledged\":")
        if s.acknowledged:
            Base::rh_push_text(out, "true")
        else:
            Base::rh_push_text(out, "false")
        Base::rh_push_text(out, ",\"resolved\":")
        if s.resolved:
            Base::rh_push_text(out, "true")
        else:
            Base::rh_push_text(out, "false")
        Base::rh_push_text(out, "}")
        i <- i + 1
    Base::rh_push_text(out, "]}")

def rh_notify_report_state(raw: darray[u8]&, initial_state: darray[u8]&, out: mutable darray[u8]&, state_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[Json::RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = Json::rh_json_parse(raw, nodes, texts)
    return -1 if root < 0 or nodes[root.usize()].kind != Json::RH_JSON_OBJ
    ss: mutable i64 = 0
    se: mutable i64 = 0
    return -1 if not rh_nr_str(nodes, texts, root, "schema", &ss, &se)
    return -1 if not rh_nr_eq(texts, ss, se, "rh-notify-input/1")
    cd_ok: mutable i64 = 0
    cooldown: mutable i64 = rh_nr_int(nodes, raw, texts, root, "cooldown_secs", &cd_ok)
    if cd_ok == 0:
        cooldown <- 0
    ev_idx: i64 = Json::rh_json_obj_get(nodes, texts, root, "events")
    return -1 if ev_idx < 0 or nodes[ev_idx.usize()].kind != Json::RH_JSON_ARR
    states: mutable darray[Notify::RhNotifyState] = []
    if rh_notify_parse_state(initial_state, states) != 0:
        return -1
    # Emitted decision rows, collected as we go.
    ev_op: mutable darray[u8] = []
    ev_lbl: mutable darray[u8] = []
    ev_deliv: mutable darray[i64] = []
    ev_applied: mutable darray[i64] = []
    counts: mutable darray[i64] = []
    while c0 < 6 |c0: i64 = 0, counts|:
        counts.push(0)
        c0 <- c0 + 1
    arr: Json::RhJsonNode = nodes[ev_idx.usize()]
    while child >= 0 |child: i64 = arr.first_child, nodes, texts, raw, states, cooldown, ev_op, ev_lbl, ev_deliv, ev_applied, counts|:
        return -1 if nodes[child.usize()].kind != Json::RH_JSON_OBJ
        ops: mutable i64 = 0
        ope: mutable i64 = 0
        return -1 if not rh_nr_str(nodes, texts, child, "op", &ops, &ope)
        okr: mutable i64 = 0
        oku: mutable i64 = 0
        rule_id: i64 = rh_nr_int(nodes, raw, texts, child, "rule_id", &okr)
        subject_id: i64 = rh_nr_int(nodes, raw, texts, child, "subject_id", &oku)
        return -1 if okr == 0 or oku == 0
        dgs: mutable i64 = 0
        dge: mutable i64 = 0
        return -1 if not rh_nr_str(nodes, texts, child, "artifact_digest", &dgs, &dge)
        hi: mutable u64 = 0
        lo: mutable u64 = 0
        return -1 if not rh_nr_hex_span(texts, dgs, dge, &hi, &lo)
        key: Notify::RhFindingKey = Notify::RhFindingKey{rule_id: rule_id, subject_id: subject_id, artifact_high: hi, artifact_low: lo}
        if rh_nr_eq(texts, ops, ope, "notify"):
            okt: mutable i64 = 0
            tkind: i64 = |nodes, texts|
                ts: mutable i64 = 0
                te: mutable i64 = 0
                return -1 if not rh_nr_str(nodes, texts, child, "target", &ts, &te)
                block_result: i64 = rh_nr_target(texts, ts, te)
                block_result
            return -1 if tkind < 0
            authorized: bool =
                subscribed: bool = rh_nr_bool(nodes, raw, texts, child, "subscribed", false)
                subscribed if tkind == Notify::RH_TARGET_UPSTREAM_MAINTAINER.i64() else rh_nr_bool(nodes, raw, texts, child, "authorized", true)
            outage: bool = rh_nr_bool(nodes, raw, texts, child, "outage", false)
            now: i64 = rh_nr_int(nodes, raw, texts, child, "now", &okt)
            return -1 if okt == 0
            target: Notify::RhTarget = Notify::RhTarget{kind: tkind.u8(), authorized: authorized}
            dec: u8 = Notify::rh_notify_decide(states, &key, &target, now, cooldown, outage)
            Notify::rh_notify_record(states, &key, &target, now, dec)
            counts[dec.u32().usize()] <- counts[dec.u32().usize()] + 1
            ev_op.push(0)
            ev_lbl.push(dec)
            if dec == Notify::RH_NOTIFY_NEW:
                ev_deliv.push(1)
            else:
                ev_deliv.push(0)
            ev_applied.push(0)
        elif rh_nr_eq(texts, ops, ope, "ack"):
            applied: bool = Notify::rh_notify_acknowledge(states, &key)
            ev_op.push(1)
            ev_lbl.push(255)
            ev_deliv.push(0)
            if applied:
                ev_applied.push(1)
            else:
                ev_applied.push(0)
        elif rh_nr_eq(texts, ops, ope, "resolve"):
            applied2: bool = Notify::rh_notify_resolve(states, &key)
            ev_op.push(2)
            ev_lbl.push(255)
            ev_deliv.push(0)
            if applied2:
                ev_applied.push(1)
            else:
                ev_applied.push(0)
        else:
            return -1
        child <- nodes[child.usize()].next_sibling
    Base::rh_push_text(out, "{\"schema\":\"rh-notify-result/1\",\"cooldown_secs\":")
    Base::rh_push_decimal_i64(out, cooldown)
    Base::rh_push_text(out, ",\"decisions\":[")
    while i < ev_op.count.i64() |i: i64 = 0, ev_op, ev_lbl, ev_deliv, ev_applied, out|:
        if i > 0:
            out.push(44)
        op: u8 = ev_op[i.usize()]
        Base::rh_push_text(out, "{\"event_index\":")
        Base::rh_push_decimal_i64(out, i)
        Base::rh_push_text(out, ",\"op\":\"")
        if op == 0:
            Base::rh_push_text(out, "notify")
        elif op == 1:
            Base::rh_push_text(out, "ack")
        else:
            Base::rh_push_text(out, "resolve")
        Base::rh_push_text(out, "\"")
        if op == 0:
            Base::rh_push_text(out, ",\"decision\":\"")
            Base::rh_push_text(out, rh_nr_label(ev_lbl[i.usize()]))
            Base::rh_push_text(out, "\",\"delivered\":")
            if ev_deliv[i.usize()] == 1:
                Base::rh_push_text(out, "true")
            else:
                Base::rh_push_text(out, "false")
        else:
            Base::rh_push_text(out, ",\"applied\":")
            if ev_applied[i.usize()] == 1:
                Base::rh_push_text(out, "true")
            else:
                Base::rh_push_text(out, "false")
        Base::rh_push_text(out, "}")
        i <- i + 1
    Base::rh_push_text(out, "],\"counts\":{\"new\":")
    Base::rh_push_decimal_i64(out, counts[0.usize()])
    Base::rh_push_text(out, ",\"suppressed_unauthorized\":")
    Base::rh_push_decimal_i64(out, counts[1.usize()])
    Base::rh_push_text(out, ",\"suppressed_outage\":")
    Base::rh_push_decimal_i64(out, counts[2.usize()])
    Base::rh_push_text(out, ",\"suppressed_resolved\":")
    Base::rh_push_decimal_i64(out, counts[3.usize()])
    Base::rh_push_text(out, ",\"suppressed_acknowledged\":")
    Base::rh_push_decimal_i64(out, counts[4.usize()])
    Base::rh_push_text(out, ",\"suppressed_cooldown\":")
    Base::rh_push_decimal_i64(out, counts[5.usize()])
    Base::rh_push_text(out, "},\"note\":\"an upstream maintainer is refused unless explicitly subscribed; suppressed decisions are not recorded, so a cooldown cannot silence a first real alert; a changed artifact digest is a new key\"}")
    rh_notify_emit_state(states, state_out)
    0

# Convenience wrapper: process with empty initial state, discarding state.
def rh_notify_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    empty: mutable darray[u8] = []
    throw: mutable darray[u8] = []
    rh_notify_report_state(raw, empty, out, throw)
