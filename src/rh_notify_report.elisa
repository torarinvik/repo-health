# rh_notify_report.elisa — notification policy execution path (M06-08).
#
# Turns an `rh-notify-input/1` event stream into an `rh-notify-result/1`
# report. The non-negotiable rule is enforced here too: an upstream
# maintainer destination is only authorized when the input marks it
# subscribed; otherwise the decision is suppressed_unauthorized and nothing
# is recorded, so a refusal never starts a cooldown. Dedup/cooldown are keyed
# on (rule, subject, artifact digest); a changed digest is a new key; outage
# suppresses; ack/resolve silence a key.

include "./rh_base.elisa"
include "./rh_json.elisa"
include "./rh_notify.elisa"

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_eq(texts: darray[u8]&, s: i64, e: i64, lit: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
    n: i64 = e - s
    k: mutable i64 = 0
    while k < n |k, texts, lit, s|:
        if lit[k.usize()] == 0:
            return false
        if texts[(s + k).usize()] != lit[k.usize()]:
            return false
        k <- k + 1
    return lit[n.usize()] == 0

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_target(texts: darray[u8]&, s: i64, e: i64) -> i64:
    if rh_nr_eq(texts, s, e, "subscriber"):
        return RH_TARGET_SUBSCRIBER
    if rh_nr_eq(texts, s, e, "maintainer_self"):
        return RH_TARGET_MAINTAINER_SELF
    if rh_nr_eq(texts, s, e, "upstream_maintainer"):
        return RH_TARGET_UPSTREAM_MAINTAINER
    if rh_nr_eq(texts, s, e, "operator"):
        return RH_TARGET_OPERATOR
    return -1

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_hex_span(texts: darray[u8]&, s: i64, e: i64, hi_out: mutable u64&, lo_out: mutable u64&) -> bool can[Memory.Allocate, Abort.Panic]:
    hi_out[0] <- 0
    lo_out[0] <- 0
    n: i64 = e - s
    if n != 16 and n != 32:
        return false
    first: mutable i64 = 16
    if n == 32:
        first <- 32
    acc: mutable u64 = 0
    k: mutable i64 = s
    while k < s + 16 |k, texts, acc, s|:
        b: u8 = texts[k.usize()]
        d: mutable u64 = 99
        if b >= 48 and b <= 57:
            d <- (b - 48).u64()
        if b >= 97 and b <= 102:
            d <- (b - 87).u64()
        if d > 15:
            return false
        acc <- acc * 16 + d
        k <- k + 1
    hi_out[0] <- acc
    if first == 32:
        acc2: mutable u64 = 0
        k2: mutable i64 = s + 16
        while k2 < s + 32 |k2, texts, acc2, s|:
            b2: u8 = texts[k2.usize()]
            d2: mutable u64 = 99
            if b2 >= 48 and b2 <= 57:
                d2 <- (b2 - 48).u64()
            if b2 >= 97 and b2 <= 102:
                d2 <- (b2 - 87).u64()
            if d2 > 15:
                return false
            acc2 <- acc2 * 16 + d2
            k2 <- k2 + 1
        lo_out[0] <- acc2
    return true

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_str(nodes: darray[RhJsonNode]&, texts: darray[u8]&, obj: i64, key: u8&, s_out: mutable i64&, e_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic]:
    idx: i64 = rh_json_obj_get(nodes, texts, obj, key)
    if idx < 0:
        return false
    return rh_json_str_span(nodes, idx, s_out, e_out)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_int(nodes: darray[RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic]:
    ok_out[0] <- 0
    idx: i64 = rh_json_obj_get(nodes, texts, obj, key)
    if idx < 0:
        return 0
    return rh_json_int(nodes, raw, idx, ok_out)

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_bool(nodes: darray[RhJsonNode]&, raw: darray[u8]&, texts: darray[u8]&, obj: i64, key: u8&, default_v: bool) -> bool can[Memory.Allocate, Abort.Panic]:
    idx: i64 = rh_json_obj_get(nodes, texts, obj, key)
    if idx < 0:
        return default_v
    return rh_json_is_true(nodes, raw, idx)

def rh_nr_label(d: u8) -> u8&:
    if d == RH_NOTIFY_NEW:
        return "new"
    if d == RH_NOTIFY_SUPPRESSED_UNAUTHORIZED:
        return "suppressed_unauthorized"
    if d == RH_NOTIFY_SUPPRESSED_OUTAGE:
        return "suppressed_outage"
    if d == RH_NOTIFY_SUPPRESSED_RESOLVED:
        return "suppressed_resolved"
    if d == RH_NOTIFY_SUPPRESSED_ACKNOWLEDGED:
        return "suppressed_acknowledged"
    return "suppressed_cooldown"

# Parse a persisted `rh-notify-state/1` document into state rows. Returns 0
# ok, -1 malformed. An empty buffer is a fresh (empty) state.
def rh_notify_parse_state(raw: darray[u8]&, states: mutable darray[RhNotifyState]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    if raw.count == 0:
        return 0
    nodes: mutable darray[RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = rh_json_parse(raw, nodes, texts)
    if root < 0 or nodes[root.usize()].kind != RH_JSON_OBJ:
        return -1
    ss: mutable i64 = 0
    se: mutable i64 = 0
    if not rh_nr_str(nodes, texts, root, "schema", &ss, &se):
        return -1
    if not rh_nr_eq(texts, ss, se, "rh-notify-state/1"):
        return -1
    rows: i64 = rh_json_obj_get(nodes, texts, root, "rows")
    if rows < 0 or nodes[rows.usize()].kind != RH_JSON_ARR:
        return -1
    arr: RhJsonNode = nodes[rows.usize()]
    child: mutable i64 = arr.first_child
    while child >= 0 |child, nodes, texts, raw, states|:
        if nodes[child.usize()].kind != RH_JSON_OBJ:
            return -1
        okr: mutable i64 = 0
        oks: mutable i64 = 0
        okl: mutable i64 = 0
        rule_id: i64 = rh_nr_int(nodes, raw, texts, child, "rule_id", &okr)
        subject_id: i64 = rh_nr_int(nodes, raw, texts, child, "subject_id", &oks)
        last_sent: i64 = rh_nr_int(nodes, raw, texts, child, "last_sent_at", &okl)
        if okr == 0 or oks == 0 or okl == 0:
            return -1
        dgs: mutable i64 = 0
        dge: mutable i64 = 0
        if not rh_nr_str(nodes, texts, child, "artifact_digest", &dgs, &dge):
            return -1
        hi: mutable u64 = 0
        lo: mutable u64 = 0
        if not rh_nr_hex_span(texts, dgs, dge, &hi, &lo):
            return -1
        ack: bool = rh_nr_bool(nodes, raw, texts, child, "acknowledged", false)
        res: bool = rh_nr_bool(nodes, raw, texts, child, "resolved", false)
        states.push(RhNotifyState{rule_id: rule_id, subject_id: subject_id, artifact_high: hi, artifact_low: lo, last_sent_at: last_sent, acknowledged: ack, resolved: res})
        child <- nodes[child.usize()].next_sibling
    return 0

# private to this file (modules retried after re-seed; see CHANGELOG).
def rh_nr_push_digest(out: mutable darray[u8]&, hi: u64, lo: u64) -> void can[Memory.Allocate, Abort.Panic]:
    rh_push_hex_u64(out, hi)
    rh_push_hex_u64(out, lo)

# Emit the persisted `rh-notify-state/1` document (durable across runs).
def rh_notify_emit_state(states: darray[RhNotifyState]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
    rh_push_text(out, "{\"schema\":\"rh-notify-state/1\",\"rows\":[")
    i: mutable usize = 0
    while i < states.count |i, states, out|:
        s: RhNotifyState = states[i]
        if i > 0:
            out.push(44)
        rh_push_text(out, "{\"rule_id\":")
        rh_push_decimal_i64(out, s.rule_id)
        rh_push_text(out, ",\"subject_id\":")
        rh_push_decimal_i64(out, s.subject_id)
        rh_push_text(out, ",\"artifact_digest\":\"")
        rh_nr_push_digest(out, s.artifact_high, s.artifact_low)
        rh_push_text(out, "\",\"last_sent_at\":")
        rh_push_decimal_i64(out, s.last_sent_at)
        rh_push_text(out, ",\"acknowledged\":")
        if s.acknowledged:
            rh_push_text(out, "true")
        else:
            rh_push_text(out, "false")
        rh_push_text(out, ",\"resolved\":")
        if s.resolved:
            rh_push_text(out, "true")
        else:
            rh_push_text(out, "false")
        rh_push_text(out, "}")
        i <- i + 1
    rh_push_text(out, "]}")

def rh_notify_report_state(raw: darray[u8]&, initial_state: darray[u8]&, out: mutable darray[u8]&, state_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    nodes: mutable darray[RhJsonNode] = []
    texts: mutable darray[u8] = []
    root: i64 = rh_json_parse(raw, nodes, texts)
    if root < 0 or nodes[root.usize()].kind != RH_JSON_OBJ:
        return -1
    ss: mutable i64 = 0
    se: mutable i64 = 0
    if not rh_nr_str(nodes, texts, root, "schema", &ss, &se):
        return -1
    if not rh_nr_eq(texts, ss, se, "rh-notify-input/1"):
        return -1
    cd_ok: mutable i64 = 0
    cooldown: mutable i64 = rh_nr_int(nodes, raw, texts, root, "cooldown_secs", &cd_ok)
    if cd_ok == 0:
        cooldown <- 0
    ev_idx: i64 = rh_json_obj_get(nodes, texts, root, "events")
    if ev_idx < 0 or nodes[ev_idx.usize()].kind != RH_JSON_ARR:
        return -1
    states: mutable darray[RhNotifyState] = []
    if rh_notify_parse_state(initial_state, states) != 0:
        return -1
    # Emitted decision rows, collected as we go.
    ev_op: mutable darray[u8] = []
    ev_lbl: mutable darray[u8] = []
    ev_deliv: mutable darray[i64] = []
    ev_applied: mutable darray[i64] = []
    counts: mutable darray[i64] = []
    c0: mutable i64 = 0
    while c0 < 6 |c0, counts|:
        counts.push(0)
        c0 <- c0 + 1
    arr: RhJsonNode = nodes[ev_idx.usize()]
    child: mutable i64 = arr.first_child
    while child >= 0 |child, nodes, texts, raw, states, cooldown, ev_op, ev_lbl, ev_deliv, ev_applied, counts|:
        if nodes[child.usize()].kind != RH_JSON_OBJ:
            return -1
        ops: mutable i64 = 0
        ope: mutable i64 = 0
        if not rh_nr_str(nodes, texts, child, "op", &ops, &ope):
            return -1
        okr: mutable i64 = 0
        oku: mutable i64 = 0
        rule_id: i64 = rh_nr_int(nodes, raw, texts, child, "rule_id", &okr)
        subject_id: i64 = rh_nr_int(nodes, raw, texts, child, "subject_id", &oku)
        if okr == 0 or oku == 0:
            return -1
        dgs: mutable i64 = 0
        dge: mutable i64 = 0
        if not rh_nr_str(nodes, texts, child, "artifact_digest", &dgs, &dge):
            return -1
        hi: mutable u64 = 0
        lo: mutable u64 = 0
        if not rh_nr_hex_span(texts, dgs, dge, &hi, &lo):
            return -1
        key: RhFindingKey = RhFindingKey{rule_id: rule_id, subject_id: subject_id, artifact_high: hi, artifact_low: lo}
        if rh_nr_eq(texts, ops, ope, "notify"):
            okt: mutable i64 = 0
            ts: mutable i64 = 0
            te: mutable i64 = 0
            if not rh_nr_str(nodes, texts, child, "target", &ts, &te):
                return -1
            tkind: i64 = rh_nr_target(texts, ts, te)
            if tkind < 0:
                return -1
            subscribed: bool = rh_nr_bool(nodes, raw, texts, child, "subscribed", false)
            authorized: bool = subscribed if tkind == RH_TARGET_UPSTREAM_MAINTAINER.i64() else rh_nr_bool(nodes, raw, texts, child, "authorized", true)
            outage: bool = rh_nr_bool(nodes, raw, texts, child, "outage", false)
            now: i64 = rh_nr_int(nodes, raw, texts, child, "now", &okt)
            if okt == 0:
                return -1
            target: RhTarget = RhTarget{kind: tkind.u8(), authorized: authorized}
            dec: u8 = rh_notify_decide(states, &key, &target, now, cooldown, outage)
            rh_notify_record(states, &key, &target, now, dec)
            counts[dec.u32().usize()] <- counts[dec.u32().usize()] + 1
            ev_op.push(0)
            ev_lbl.push(dec)
            if dec == RH_NOTIFY_NEW:
                ev_deliv.push(1)
            else:
                ev_deliv.push(0)
            ev_applied.push(0)
        elif rh_nr_eq(texts, ops, ope, "ack"):
            applied: bool = rh_notify_acknowledge(states, &key)
            ev_op.push(1)
            ev_lbl.push(255)
            ev_deliv.push(0)
            if applied:
                ev_applied.push(1)
            else:
                ev_applied.push(0)
        elif rh_nr_eq(texts, ops, ope, "resolve"):
            applied2: bool = rh_notify_resolve(states, &key)
            ev_op.push(2)
            ev_lbl.push(255)
            ev_deliv.push(0)
            if applied2:
                ev_applied.push(1)
            else:
                ev_applied.push(0)
        else:
            return -1
        child <- nodes[child.usize()].next_sibling
    rh_push_text(out, "{\"schema\":\"rh-notify-result/1\",\"cooldown_secs\":")
    rh_push_decimal_i64(out, cooldown)
    rh_push_text(out, ",\"decisions\":[")
    i: mutable i64 = 0
    while i < ev_op.count.i64() |i, ev_op, ev_lbl, ev_deliv, ev_applied, out|:
        if i > 0:
            out.push(44)
        op: u8 = ev_op[i.usize()]
        rh_push_text(out, "{\"event_index\":")
        rh_push_decimal_i64(out, i)
        rh_push_text(out, ",\"op\":\"")
        if op == 0:
            rh_push_text(out, "notify")
        elif op == 1:
            rh_push_text(out, "ack")
        else:
            rh_push_text(out, "resolve")
        rh_push_text(out, "\"")
        if op == 0:
            rh_push_text(out, ",\"decision\":\"")
            rh_push_text(out, rh_nr_label(ev_lbl[i.usize()]))
            rh_push_text(out, "\",\"delivered\":")
            if ev_deliv[i.usize()] == 1:
                rh_push_text(out, "true")
            else:
                rh_push_text(out, "false")
        else:
            rh_push_text(out, ",\"applied\":")
            if ev_applied[i.usize()] == 1:
                rh_push_text(out, "true")
            else:
                rh_push_text(out, "false")
        rh_push_text(out, "}")
        i <- i + 1
    rh_push_text(out, "],\"counts\":{\"new\":")
    rh_push_decimal_i64(out, counts[0.usize()])
    rh_push_text(out, ",\"suppressed_unauthorized\":")
    rh_push_decimal_i64(out, counts[1.usize()])
    rh_push_text(out, ",\"suppressed_outage\":")
    rh_push_decimal_i64(out, counts[2.usize()])
    rh_push_text(out, ",\"suppressed_resolved\":")
    rh_push_decimal_i64(out, counts[3.usize()])
    rh_push_text(out, ",\"suppressed_acknowledged\":")
    rh_push_decimal_i64(out, counts[4.usize()])
    rh_push_text(out, ",\"suppressed_cooldown\":")
    rh_push_decimal_i64(out, counts[5.usize()])
    rh_push_text(out, "},\"note\":\"an upstream maintainer is refused unless explicitly subscribed; suppressed decisions are not recorded, so a cooldown cannot silence a first real alert; a changed artifact digest is a new key\"}")
    rh_notify_emit_state(states, state_out)
    return 0

# Convenience wrapper: process with empty initial state, discarding state.
def rh_notify_report(raw: darray[u8]&, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
    empty: mutable darray[u8] = []
    throw: mutable darray[u8] = []
    return rh_notify_report_state(raw, empty, out, throw)
