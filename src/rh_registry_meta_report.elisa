# rh_registry_meta_report.elisa — registry enrichment execution path
# (M03-05).
#
# Turns an `rh-registry-meta/1` document into `rh-registry-meta-result/1`:
# per-version metadata with the honest states preserved — a yanked version is
# RETAINED (not deleted), an absent yank field is `null` (unknown, never
# false), a published time may be numeric or an ISO string (unknown stays
# null), deprecation stays tri-state with its bounded notice, a declared
# repository link is an ASSERTION not identity, and
# declared dependency counts are NOT resolved edges. Malformed input fails
# closed.

include "./rh_base.elisa"
include "./rh_inventory_report.elisa"
include "./rh_registry_meta.elisa"
include "./rh_registry_npm.elisa"
include "./rh_registry_crates.elisa"
include "./rh_registry_rubygems.elisa"
include "./rh_registry_nuget.elisa"
include "./rh_sha256.elisa"

module RegistryMetaReport:
    private:
        # private to this file (modules retried after re-seed; see CHANGELOG).
        def rh_rmr_emit(out: mutable darray[u8]&, pool: darray[u8]&, s: i64, e: i64) -> void can[Memory.Allocate, Abort.Panic]:
            if s >= 0 and e >= s and e <= pool.count.i64():
                Base::rh_json_escape(out, pool, s.usize(), e.usize())

        def rh_rmr_provenance(raw: darray[u8]&, source_url: cstr, has_url: bool, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            Base::rh_push_text(out, ",\"provenance\":{\"input_sha256\":\"")
            Sha256::rh_sha256(raw, out)
            Base::rh_push_text(out, "\",\"origin\":\"")
            Base::rh_push_text(out, "captured_url" if has_url else "local_input")
            Base::rh_push_text(out, "\",\"locator_sha256\":")
            if has_url:
                locator: mutable darray[u8] = []
                Base::rh_push_cstr(locator, source_url)
                Base::rh_push_text(out, "\"")
                Sha256::rh_sha256(locator, out)
                out.push(34)
            else:
                Base::rh_push_text(out, "null")
            Base::rh_push_text(out, "}")

    public:
        const RH_REGISTRY_META_MAX_BYTES: i64 = 4194304

        def rh_registry_meta_report(raw: darray[u8]&, source_url: cstr, has_url: bool, out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return -1 if raw.count.i64() > RH_REGISTRY_META_MAX_BYTES
            pool: mutable darray[u8] = []
            versions: mutable darray[RegistryMeta::RhRegVersion] = []
            meta: mutable RegistryMeta::RhRegMeta = RegistryMeta::RhRegMeta{ok: 0, versions: 0, yanked_count: 0, unknown_yank_count: 0, deprecated_count: 0, not_deprecated_count: 0, unknown_deprecation_count: 0, with_repo: 0, declared_deps: 0, optional_deps: 0, dev_deps: 0}
            provider_nodes: mutable darray[Json::RhJsonNode] = []
            provider_texts: mutable darray[u8] = []
            provider_root: i64 = Json::rh_json_parse(raw, provider_nodes, provider_texts)
            crates_shape: bool = provider_root >= 0 and provider_nodes[provider_root.usize()].kind == Json::RH_JSON_OBJ and Json::rh_json_obj_get(provider_nodes, provider_texts, provider_root, "crate") >= 0
            nuget_shape: bool = provider_root >= 0 and provider_nodes[provider_root.usize()].kind == Json::RH_JSON_OBJ and Json::rh_json_obj_get(provider_nodes, provider_texts, provider_root, "items") >= 0 and Json::rh_json_obj_get(provider_nodes, provider_texts, provider_root, "versions") < 0
            rubygems_versions: i64 = provider_root if provider_root >= 0 and provider_nodes[provider_root.usize()].kind == Json::RH_JSON_ARR else Json::rh_json_obj_get(provider_nodes, provider_texts, provider_root, "versions")
            rubygems_shape: bool = rubygems_versions >= 0 and provider_nodes[rubygems_versions.usize()].kind == Json::RH_JSON_ARR and provider_nodes[rubygems_versions.usize()].first_child >= 0 and Json::rh_json_obj_get(provider_nodes, provider_texts, provider_nodes[rubygems_versions.usize()].first_child, "number") >= 0
            canonical_shape: bool = provider_root >= 0 and provider_nodes[provider_root.usize()].kind == Json::RH_JSON_OBJ and not crates_shape and not rubygems_shape and Json::rh_json_obj_get(provider_nodes, provider_texts, provider_root, "versions") >= 0 and provider_nodes[Json::rh_json_obj_get(provider_nodes, provider_texts, provider_root, "versions").usize()].kind == Json::RH_JSON_ARR
            if nuget_shape:
                normalized: mutable darray[u8] = []
                return -1 if RegistryNuget::rh_regmeta_nuget_normalize(raw, normalized) != 0
                return -1 if RegistryMeta::rh_regmeta_parse(normalized, pool, versions, &meta) != 0
            elif rubygems_shape:
                normalized: mutable darray[u8] = []
                return -1 if RegistryRubygems::rh_regmeta_rubygems_normalize(raw, normalized) != 0
                return -1 if RegistryMeta::rh_regmeta_parse(normalized, pool, versions, &meta) != 0
            elif crates_shape:
                normalized: mutable darray[u8] = []
                return -1 if RegistryCrates::rh_regmeta_crates_normalize(raw, normalized) != 0
                return -1 if RegistryMeta::rh_regmeta_parse(normalized, pool, versions, &meta) != 0
            elif canonical_shape:
                return -1 if RegistryMeta::rh_regmeta_parse(raw, pool, versions, &meta) != 0
            elif RegistryMeta::rh_regmeta_parse(raw, pool, versions, &meta) != 0:
                normalized: mutable darray[u8] = []
                if RegistryPypi::rh_regmeta_pypi_normalize(raw, normalized) != 0:
                    normalized <- []
                    if RegistryNpm::rh_regmeta_npm_normalize(raw, normalized) != 0:
                        normalized <- []
                        if RegistryCrates::rh_regmeta_crates_normalize(raw, normalized) != 0:
                            normalized <- []
                            return -1 if RegistryRubygems::rh_regmeta_rubygems_normalize(raw, normalized) != 0
                pool <- []
                versions <- []
                return -1 if RegistryMeta::rh_regmeta_parse(normalized, pool, versions, &meta) != 0
            Base::rh_push_text(out, "{\"schema\":\"rh-registry-meta-result/1\"")
            rh_rmr_provenance(raw, source_url, has_url, out)
            Base::rh_push_text(out, ",\"counts\":{\"versions\":")
            Base::rh_push_decimal_i64(out, meta.versions)
            Base::rh_push_text(out, ",\"yanked\":")
            Base::rh_push_decimal_i64(out, meta.yanked_count)
            Base::rh_push_text(out, ",\"unknown_yank\":")
            Base::rh_push_decimal_i64(out, meta.unknown_yank_count)
            Base::rh_push_text(out, ",\"deprecated\":")
            Base::rh_push_decimal_i64(out, meta.deprecated_count)
            Base::rh_push_text(out, ",\"not_deprecated\":")
            Base::rh_push_decimal_i64(out, meta.not_deprecated_count)
            Base::rh_push_text(out, ",\"unknown_deprecation\":")
            Base::rh_push_decimal_i64(out, meta.unknown_deprecation_count)
            Base::rh_push_text(out, ",\"with_repo\":")
            Base::rh_push_decimal_i64(out, meta.with_repo)
            Base::rh_push_text(out, ",\"declared_deps\":")
            Base::rh_push_decimal_i64(out, meta.declared_deps)
            Base::rh_push_text(out, ",\"optional_deps\":")
            Base::rh_push_decimal_i64(out, meta.optional_deps)
            Base::rh_push_text(out, ",\"dev_deps\":")
            Base::rh_push_decimal_i64(out, meta.dev_deps)
            Base::rh_push_text(out, "},\"versions\":[")
            while i < versions.count.i64() |i: i64 = 0, versions, pool, out|:
                v: RegistryMeta::RhRegVersion = versions[i.usize()]
                if i > 0:
                    out.push(44)
                Base::rh_push_text(out, "{\"version\":\"")
                rh_rmr_emit(out, pool, v.ver_s, v.ver_e)
                Base::rh_push_text(out, "\",\"yanked\":")
                if v.yanked == -1:
                    Base::rh_push_text(out, "null")
                elif v.yanked == 1:
                    Base::rh_push_text(out, "true")
                else:
                    Base::rh_push_text(out, "false")
                Base::rh_push_text(out, ",\"deprecated\":")
                if v.deprecated == 1:
                    Base::rh_push_text(out, "true")
                elif v.deprecated == 0:
                    Base::rh_push_text(out, "false")
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"deprecation_notice\":")
                if v.deprecation_notice_s >= 0:
                    Base::rh_push_text(out, "\"")
                    rh_rmr_emit(out, pool, v.deprecation_notice_s, v.deprecation_notice_e)
                    Base::rh_push_text(out, "\"")
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"published_at\":")
                if v.has_published == 0:
                    Base::rh_push_text(out, "null")
                elif v.published_s >= 0:
                    Base::rh_push_text(out, "\"")
                    rh_rmr_emit(out, pool, v.published_s, v.published_e)
                    Base::rh_push_text(out, "\"")
                else:
                    Base::rh_push_decimal_i64(out, v.published_epoch)
                Base::rh_push_text(out, ",\"repository\":")
                if v.has_repo == 1:
                    Base::rh_push_text(out, "\"")
                    rh_rmr_emit(out, pool, v.repo_s, v.repo_e)
                    Base::rh_push_text(out, "\"")
                else:
                    Base::rh_push_text(out, "null")
                Base::rh_push_text(out, ",\"dep_count\":")
                Base::rh_push_decimal_i64(out, v.dep_count)
                Base::rh_push_text(out, ",\"optional_dep_count\":")
                Base::rh_push_decimal_i64(out, v.optional_dep_count)
                Base::rh_push_text(out, ",\"dev_dep_count\":")
                Base::rh_push_decimal_i64(out, v.dev_dep_count)
                Base::rh_push_text(out, "}")
                i <- i + 1
            Base::rh_push_text(out, "],\"note\":\"a yanked version is retained, not deleted; an absent yank field is null (unknown), not false; an absent deprecation field is null (unknown) unless the provider adapter establishes an explicit non-deprecated state; notices are source text capped at 4096 bytes; a declared repository link is an assertion, not identity; declared dependencies are counts, not resolved edges\"}")
            0
