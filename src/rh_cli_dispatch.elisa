        def rh_cli_cmd_osv_query(argc: i64, slots: mutable cstr&&) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release, Global{Read,Write}]:
            return rh_cli_usage(2) if argc < 6 or argc > 8
            osv_out_flag: u8& = slots[4].cast[u8&] can Unsafe.PointerCast
            return rh_cli_usage(2) if not Base::rh_streq(osv_out_flag, "--out")
            osv_mode_flag: u8& = slots[2].cast[u8&] can Unsafe.PointerCast
            continue_pages: mutable bool = false
            hydrate_advisories: mutable bool = false
            while option_index < argc |option_index: i64 = 6, continue_pages, hydrate_advisories, slots|:
                option_flag: u8& = slots[option_index].cast[u8&] can Unsafe.PointerCast
                if Base::rh_streq(option_flag, "--continue-pagination"):
                    return rh_cli_usage(2) if continue_pages
                    continue_pages <- true
                elif Base::rh_streq(option_flag, "--hydrate-advisories"):
                    return rh_cli_usage(2) if hydrate_advisories
                    hydrate_advisories <- true
                else:
                    return rh_cli_usage(2)
                option_index <- option_index + 1
            if Base::rh_streq(osv_mode_flag, "--input"):
                return rh_cli_usage(2) if hydrate_advisories or argc > 7
                return OsvQueryCli::rh_do_osv_query(slots[3], slots[5], continue_pages)
            if Base::rh_streq(osv_mode_flag, "--graph"):
                return OsvQueryCli::rh_do_osv_graph_query(slots[3], slots[5], continue_pages, hydrate_advisories)
            return rh_cli_usage(2)

