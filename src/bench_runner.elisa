# bench_runner.elisa — deterministic benchmark dataset generator (M10).
#
# Generates a graph from a seed with a fixed LCG, so the DATASET is
# reproducible and its structure digest is stable across runs and machines.
# It prints the digest and exact counts only; it does NOT print timing,
# because wall-clock depends on the machine and must be recorded by the
# harness around this process. Usage: bench_runner <nodes> <seed>
include "./rh_base.elisa"
include "./rh_graph.elisa"
include "./rh_metrics.elisa"
include "./rh_continuity.elisa"

struct BenchLcg:
    state: mutable u64

def rh_bench_next(s: mutable BenchLcg&) -> u64:
    n: u64 = s.state * 6364136223846793005 + 1442695040888963407
    s.state <- n
    n

# FNV-1a over each edge (from, dst) as low/high 32-bit halves.
def rh_bench_digest(edges: darray[RhGraphEdge]&) -> u64 can[Memory.Allocate, Abort.Panic]:
    while i < edges.count |h: u64 = 14695981039346656037, i: usize = 0| -> h:
        v: u64 =
            e: RhGraphEdge = edges[i]
            e.from.u64() ^ (e.dst.u64() << 32)
        while k < 8 |k: i64 = 0, h, v|:
            b: u64 = (v >> (k * 8).u64()) & 255
            h <- (h ^ b) * 1099511628211
            k <- k + 1
        i <- i + 1

# Integer argv parse (argv is cstr). Returns fallback when absent/invalid.
def rh_bench_arg(argc: i64, argv: mutable cstr&&, idx: i64, fallback: i64) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    return fallback if idx >= argc
    s: cstr = argv[idx]
    scratch: mutable darray[u8] = []
    rh_push_cstr(scratch, s)
    ok: mutable i64 = 0
    v: i64 = rh_parse_i64(scratch, 0, scratch.count, &ok)
    return fallback if ok == 0 or v <= 0
    v

def main(argc: i64, argv: mutable void&) -> i32 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
    slots: mutable cstr&& = argv.cast[mutable cstr&&] can Unsafe.PointerCast
    n: i64 = rh_bench_arg(argc, slots, 1, 200)
    lcg: mutable BenchLcg =
        seed: i64 = rh_bench_arg(argc, slots, 2, 42)
        BenchLcg{state: seed.u64() ^ 88172645463325252}
    edges: mutable darray[RhGraphEdge] = []
    m: i64 = n * 2
    while i < m |i: i64 = 0, edges, lcg, n|:
        a: u64 = rh_bench_next(lcg) % n.u64()
        b: u64 = rh_bench_next(lcg) % n.u64()
        if a != b:
            edges.push(RhGraphEdge{from: a.i64(), dst: b.i64(), scope: 0, platform: 0, introduced: 0, removed: 0, first_seen: 1})
        i <- i + 1
    dig: u64 = rh_bench_digest(edges)
    vis: mutable darray[u8] = []
    p: RhProjection = rh_projection_make(1, RH_SCOPE_ALL, 0, 0, 0, 0, 0, false, 1000000, 32)
    nd: i64 = |edges, vis|
        direct: mutable darray[i64] = []
        block_result: i64 = rh_direct_dependents(edges, vis, 0, &p, direct)
        block_result
    nt: i64 = |edges, vis|
        trans: mutable darray[i64] = []
        tr: mutable i64 = 0
        block_result: i64 = rh_transitive_dependents(edges, vis, 0, &p, trans, &tr)
        block_result
    # indegree distribution for concentration (deterministic counts)
    counts: mutable darray[u64] = []
    while j < n |j: i64 = 0, counts|:
        counts.push(0)
        j <- j + 1
    while e < edges.count |e: usize = 0, edges, counts|:
        ed: RhGraphEdge = edges[e]
        if ed.dst >= 0 and ed.dst < counts.count.i64():
            counts[ed.dst.usize()] <- counts[ed.dst.usize()] + 1
        e <- e + 1
    k50: i64 = rh_absence_factor_50(counts)
    csum: u64 =
        while ci < counts.count |csum: u64 = 0, ci: usize = 0, counts| -> csum:
            csum <- csum + counts[ci]
            ci <- ci + 1
    out: mutable darray[u8] =
        out: mutable darray[u8] = []
        rh_push_text(out, "nodes=")
        rh_push_decimal_i64(out, n)
        rh_push_text(out, " edges=")
        rh_push_decimal_i64(out, edges.count.i64())
        rh_push_text(out, " digest=")
        rh_push_hex_u64(out, dig)
        rh_push_text(out, " direct=")
        rh_push_decimal_i64(out, nd)
        rh_push_text(out, " trans=")
        rh_push_decimal_i64(out, nt)
        rh_push_text(out, " k50=")
        rh_push_decimal_i64(out, k50)
        rh_push_text(out, " indegree_sum=")
        rh_push_decimal_i64(out, csum.i64())
        out.push(10)
        out
    rh_write_stdout(out)
    0
