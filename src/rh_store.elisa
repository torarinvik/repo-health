include "./rh_base.elisa"
include "./rh_observation.elisa"

extern mkstemp(template: cstr) -> i32
extern link(existing: cstr, published: cstr) -> i32
extern open(path: cstr, flags: i32, mode: i32) -> i32
extern fsync(fd: i32) -> i32
extern close(fd: i32) -> i32
extern flock(fd: i32, operation: i32) -> i32
extern fchmod(fd: i32, mode: i32) -> i32
extern opendir(path: cstr) -> void&?
extern readdir(directory: void&) -> void&?
extern closedir(directory: void&) -> i32

module Store:
    private:
        const RH_LS_AVAILABLE: i64 = 6
        const RH_STORE_LOCK_EXCLUSIVE: i32 = 2
        const RH_STORE_LOCK_RELEASE: i32 = 8
        const RH_STORE_MAX_GC_CANDIDATES: i64 = 50000
        static if ELISA_TARGET_OS_MACOS:
            const RH_STORE_OPEN_CREATE: i32 = 512
            const RH_STORE_DIRENT_NAME_OFFSET: usize = 21
            extern __error() -> mutable i32&
        static elif ELISA_TARGET_OS_LINUX:
            const RH_STORE_OPEN_CREATE: i32 = 64
            const RH_STORE_DIRENT_NAME_OFFSET: usize = 19
            extern __errno_location() -> mutable i32&
        static else:
            const RH_STORE_OPEN_CREATE: i32 = 0

    public:
        # Hold one advisory lock shared by every local process using this root.
        # The file remains in the root so a shared filesystem carries the lock.
        def rh_store_guard_acquire(root: cstr, fd_out: mutable i32&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Unsafe.PointerCast]:
            fd_out[0] <- -1
            return -1 if Base::rh_cstr_len_c(root) == 0 or Base::rh_cstr_len_c(root) > 4096 or RH_STORE_OPEN_CREATE == 0
            lock_path: mutable darray[u8] = []
            Base::rh_push_cstr(lock_path, root)
            Base::rh_push_text(lock_path, "/.rh-evidence.lock")
            lock_path.push(0)
            lock_ptr: cstr = (&lock_path[0]).cast[cstr] can Unsafe.PointerCast
            fd: mutable i32 = open(lock_ptr, 2 | RH_STORE_OPEN_CREATE, 384)
            fd <- open(lock_ptr, 0, 0) if fd < 0
            return -1 if fd < 0
            if fchmod(fd, 384) != 0:
                _ = close(fd)
                return -1
            if flock(fd, RH_STORE_LOCK_EXCLUSIVE) != 0:
                _ = close(fd)
                return -1
            fd_out[0] <- fd
            0

        def rh_store_guard_release(fd: i32) -> i64 can[Blocking.IO]:
            return -1 if fd < 0
            unlocked: i32 = flock(fd, RH_STORE_LOCK_RELEASE)
            closed: i32 = close(fd)
            return -1 if unlocked != 0 or closed != 0
            0

        # rh_store.elisa — durable filesystem ingestion store (M02-01/02/03/06/07).
        # The first native PostgreSQL page-commit method lives in rh_postgres;
        # this remains the active event and lease backend until full wiring lands.
        #
        # Layout under a store root (all paths caller-joined, allowlisted):
        #   evidence/<fnv-hex>              content-addressed blobs, immutable
        #   sources/<src>/events/<cap>.jsonl   canonical records, one JSON/line
        #   sources/<src>/events/<cap>.index   record ids, one per line (dedup)
        #   sources/<src>/cursors/<cap>.cursor "page: N\ncount: M\n" (last COMMITTED page)
        #   sources/<src>/coverage/<cap>.interval "start end status\n" lines
        #   leases/<job>.lease               token/owner/heartbeat/ttl/phase lines
        #   leases/<job>.log                 append-only attempt history
        #
        # Each file lists its own Elisa-level dependencies via include (the driver
        # dedupes repeated includes across the unit).


        #
        # Crash protocol (S004/S005) without atomic rename: the cursor names the
        # last VERIFIED page and fetch always resumes AT that page (overlap of one
        # page is normal); record ids dedup every write, so crash-before-commit
        # retries and crash-after-commit redeliveries both converge to exactly one
        # canonical copy. A stale worker's token never matches the lease file, so
        # it cannot publish after losing its fencing token.
        #
        # Lease phases: queued(0) leased(1) running(2) succeeded(3)
        # failed_terminal(4) canceled(5) available(6). Job-terminal phases
        # refuse acquisition (-2). The available resource-lock phase can be
        # claimed again with a new fencing token after a completed operation.

        # Compare a byte span against a literal. Private to this file.
        # (private to this file)
        def rh_span_eq(data: darray[u8]&, s: usize, e: usize, want: u8&) -> bool can[Memory.Allocate, Abort.Panic]:
            Base::rh_bytes_equal_literal(data, s.i64(), e.i64(), want)

        # FNV-1a hex digest of bytes into out (16 chars, no terminator).
        # (private to this file)
        def rh_digest_hex(data: darray[u8]&, out: mutable darray[u8]&) -> void can[Memory.Allocate, Abort.Panic]:
            h: u64 = hash_sview(bytes_view(data))
            Base::rh_push_hex_u64(out, h)

        # Stage bytes in the evidence directory, sync them, then publish with an
        # atomic no-clobber hard link and sync the directory. Concurrent retries
        # converge on one immutable object; a different object at the same digest
        # fails closed. hex_out is appended to and must be empty on entry.
    private:
        def rh_store_blob_unlocked(root: cstr, data: mutable darray[u8]&, hex_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            rh_digest_hex(data, hex_out)
            published_path: mutable darray[u8] =
                path: mutable darray[u8] = []
                Base::rh_push_cstr(path, root)
                path.push(47)
                path.extend(bytes_view(hex_out))
                path.push(0)
                path
            published: cstr = (&published_path[0]).cast[cstr] can Unsafe.PointerCast
            stage_path: mutable darray[u8] =
                path: mutable darray[u8] = []
                Base::rh_push_cstr(path, root)
                path.push(47)
                path.push(46)
                path.extend(bytes_view(hex_out))
                Base::rh_push_text(path, ".stage.XXXXXX")
                path.push(0)
                path
            stage: cstr = (&stage_path[0]).cast[cstr] can Unsafe.PointerCast
            fd: i32 = mkstemp(stage)
            return -1 if fd < 0
            offset: mutable usize = 0
            while offset < data.count |offset: usize = 0, data, fd|:
                bytes: void& = (&data[offset]).cast[void&] can Unsafe.PointerCast
                written: i64 = write(fd, bytes, (data.count - offset).i64())
                if written <= 0:
                    _ = close(fd)
                    _ = unlink((&stage_path[0]).cast[u8&] can Unsafe.PointerCast)
                    return -1
                offset <- offset + written.usize()
            if fsync(fd) != 0:
                _ = close(fd)
                _ = unlink((&stage_path[0]).cast[u8&] can Unsafe.PointerCast)
                return -1
            if close(fd) != 0:
                _ = unlink((&stage_path[0]).cast[u8&] can Unsafe.PointerCast)
                return -1
            directory_fd: i32 = open(root, 0, 0)
            if directory_fd < 0:
                _ = unlink((&stage_path[0]).cast[u8&] can Unsafe.PointerCast)
                return -1
            if link(stage, published) == 0:
                stage_removed: i32 = unlink((&stage_path[0]).cast[u8&] can Unsafe.PointerCast)
                synced: i32 = -1 if stage_removed != 0 else fsync(directory_fd)
                closed: i32 = close(directory_fd)
                return -1 if stage_removed != 0 or synced != 0 or closed != 0
                return 0
            back: mutable darray[u8] = []
            existing: bool = Base::rh_io_read(published, back) >= 0
            _ = unlink((&stage_path[0]).cast[u8&] can Unsafe.PointerCast)
            same: bool = existing and string_views_eq(bytes_view(back), bytes_view(data)) == 1
            synced_existing: i32 = fsync(directory_fd) if same else 0
            closed_directory: i32 = close(directory_fd)
            return 0 if same and synced_existing == 0 and closed_directory == 0
            -1

    public:
        def rh_store_blob(root: cstr, data: mutable darray[u8]&, hex_out: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            guard_fd: mutable i32 = -1
            return -1 if Store::rh_store_guard_acquire(root, &guard_fd) != 0
            stored: i64 = Store::rh_store_blob_unlocked(root, data, hex_out)
            released: i64 = Store::rh_store_guard_release(guard_fd)
            return -1 if stored != 0 or released != 0
            stored

        # Verify a stored blob recomputes to its name. False when missing or
        # corrupt: publication from it is blocked (M02-02).
        def rh_store_blob_verify(root: cstr, hexname: u8&, ok_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            ok_out[0] <- 0
            path: mutable darray[u8] =
                path: mutable darray[u8] = []
                Base::rh_push_cstr(path, root)
                path.push(47)
                Base::rh_push_text(path, hexname)
                path.push(0)
                path
            pp: cstr = (&path[0]).cast[cstr] can Unsafe.PointerCast
            back: mutable darray[u8] = []
            return -1 if Base::rh_io_read(pp, back) < 0
            check: mutable darray[u8] = []
            rh_digest_hex(back, check)
            same: bool = string_view_eq(bytes_view(check), hexname) == 1
            if same:
                ok_out[0] <- 1
                return 0
            -1

        # True when the name in `target[ts,te)` equals one newline-separated line
        # of `buf`. Both buffers are caller-owned byte arrays, so the compared
        # bytes come from the two different buffers on purpose.
        # (private to this file)
    private:
        static if ELISA_TARGET_OS_MACOS or ELISA_TARGET_OS_LINUX:
            static if ELISA_TARGET_OS_MACOS:
                def rh_store_errno() -> mutable i32&:
                    __error()
            static elif ELISA_TARGET_OS_LINUX:
                def rh_store_errno() -> mutable i32&:
                    __errno_location()

            def rh_store_readdir_next(directory: void&, error_out: mutable i64&) -> void&? can[Blocking.IO]:
                errno_ref: mutable i32& = Store::rh_store_errno()
                errno_ref[0] <- 0
                entry: void&? = readdir(directory)
                error_out[0] <- errno_ref[0] if entry == null
                entry

            def rh_store_entry_is_blob_name(entry: void&) -> bool can[Unsafe.PointerCast]:
                entry_bytes: u8& = entry.cast[u8&] can Unsafe.PointerCast
                while i < 17 |i: usize = 0, entry_bytes|:
                    byte: u8 = entry_bytes[RH_STORE_DIRENT_NAME_OFFSET + i]
                    return i == 16 if byte == 0
                    return false if i == 16 or not ((byte >= 48 and byte <= 57) or (byte >= 97 and byte <= 102))
                    i <- i + 1
                false

        def rh_store_names_sorted(names: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            return false if not Store::rh_store_names_valid(names)
            previous: mutable usize = 0
            have_previous: mutable bool = false
            while start < names.count |start: usize = 0, names, previous, have_previous|:
                if have_previous:
                    order: mutable i64 = 0
                    while i < 16 |i: usize = 0, names, previous, start, order|:
                        left: u8 = names[previous + i]
                        right: u8 = names[start + i]
                        if left != right:
                            order <- -1 if left < right
                            order <- 1 if left > right
                            i <- 16
                        else:
                            i <- i + 1
                    return false if order >= 0
                previous <- start
                have_previous <- true
                stop: i64 = Base::rh_find_byte(names, start, 10)
                start <- stop.usize() + 1 if stop >= 0 else names.count
            true

        def rh_names_has(buf: darray[u8]&, target: darray[u8]&, ts: usize, te: usize) -> bool can[Memory.Allocate, Abort.Panic]:
            while start < buf.count |start: usize = 0, buf, target, ts, te|:
                stop: i64 = Base::rh_find_byte(buf, start, 10)
                line_end: usize = stop.usize() if stop >= 0 else buf.count
                if line_end - start == te - ts and line_end > start:
                    same: bool =
                        while k < te - ts |same: bool = true, k: usize = 0, start| -> same:
                            if buf[start + k] != target[ts + k]:
                                same <- false
                            k <- k + 1
                    return true if same
                if stop < 0:
                    start <- buf.count
                else:
                    start <- stop.usize() + 1
            false

        def rh_names_has_sorted(buf: darray[u8]&, target: darray[u8]&, ts: usize, te: usize, count: i64) -> bool can[Memory.Allocate, Abort.Panic]:
            low: mutable usize = 0
            high: mutable usize = count.usize()
            while low < high |low, high, buf, target, ts, te|:
                middle: usize = low + (high - low) / 2
                offset: usize = middle * 17
                order: mutable i64 = 0
                while i < te - ts |i: usize = 0, buf, target, ts, offset, order, te|:
                    left: u8 = target[ts + i]
                    right: u8 = buf[offset + i]
                    if left != right:
                        order <- -1 if left < right
                        order <- 1 if left > right
                        i <- te - ts
                    else:
                        i <- i + 1
                return true if order == 0
                low <- middle + 1 if order > 0
                high <- middle if order < 0
            false

        # Validate a newline-separated set of canonical local blob names. An
        # empty set is valid; empty interior lines and path-like names are not.
        def rh_store_names_valid(names: darray[u8]&) -> bool can[Memory.Allocate, Abort.Panic]:
            while start < names.count |start: usize = 0, names|:
                stop: i64 = Base::rh_find_byte(names, start, 10)
                end: usize = stop.usize() if stop >= 0 else names.count
                return false if end - start != 16
                while i < end |i: usize = start, names|:
                    b: u8 = names[i]
                    return false if not ((b >= 48 and b <= 57) or (b >= 97 and b <= 102))
                    i <- i + 1
                start <- end + 1 if stop >= 0 else names.count
            true

    private:
        # Orphan cleanup (F033): delete each discovered candidate absent from the
        # referenced set. The database path uses the guarded directory scan above;
        # the local selftest can still supply explicit newline-separated sets. Both
        # full name lists are validated before any deletion, so malformed or
        # path-like entries cannot escape the evidence directory.
        # A database caller must hold the same root guard across reference
        # discovery and deletion, and registration must acquire it before verify.
        # Referenced objects are never touched. deleted_out counts successful
        # unlinks. Returns -1 for bad inputs or filesystem failures.
        def rh_store_gc_unlocked(evidence_dir: cstr, candidates: darray[u8]&, referenced: darray[u8]&, references_sorted: bool, reference_count: i64, deleted_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            deleted_out[0] <- 0
            return -1 if Base::rh_cstr_len_c(evidence_dir) == 0 or Base::rh_cstr_len_c(evidence_dir) > 4096
            return -1 if not rh_store_names_valid(candidates) or not rh_store_names_valid(referenced)
            return -1 if references_sorted and (reference_count < 0 or referenced.count.i64() != reference_count * 17 or not Store::rh_store_names_sorted(referenced))
            directory_fd: i32 = open(evidence_dir, 0, 0)
            return -1 if directory_fd < 0
            while start < candidates.count |start: usize = 0, candidates, referenced, evidence_dir, deleted_out, directory_fd|:
                stop: i64 = Base::rh_find_byte(candidates, start, 10)
                line_end: mutable usize = stop.usize() if stop >= 0 else candidates.count
                if line_end > start:
                    referenced_blob: bool = rh_names_has_sorted(referenced, candidates, start, line_end, reference_count) if references_sorted else rh_names_has(referenced, candidates, start, line_end)
                    if not referenced_blob:
                        path: mutable darray[u8] =
                            path: mutable darray[u8] = []
                            Base::rh_push_cstr(path, evidence_dir)
                            path.push(47)
                            path
                        while k < line_end |k: usize = start, candidates, path, line_end|:
                            path.push(candidates[k])
                            k <- k + 1
                        path.push(0)
                        pp: u8& = (&path[0]).cast[u8&] can Unsafe.PointerCast
                        removed: i32 = unlink(pp)
                        if removed != 0:
                            _ = fsync(directory_fd)
                            _ = close(directory_fd)
                            return -1
                        deleted_out[0] <- deleted_out[0] + 1
                if stop < 0:
                    start <- candidates.count
                else:
                    start <- stop.usize() + 1
            synced: i32 = fsync(directory_fd)
            closed: i32 = close(directory_fd)
            return -1 if synced != 0 or closed != 0
            0

    public:
        # Discover canonical blob names while the caller holds the root guard.
        # Lock metadata, staging files, and unrelated names are not candidates.
        # A capped or failed directory scan returns no usable candidate set.
        static if ELISA_TARGET_OS_MACOS or ELISA_TARGET_OS_LINUX:
            def rh_store_gc_candidate_names_under_guard(evidence_dir: cstr, candidates_out: mutable darray[u8]&, count_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Blocking.IO, Unsafe.PointerCast]:
                count_out[0] <- 0
                return -1 if candidates_out.count != 0 or Base::rh_cstr_len_c(evidence_dir) == 0 or Base::rh_cstr_len_c(evidence_dir) > 4096
                directory_result: void&? = opendir(evidence_dir)
                return -1 if directory_result == null
                directory: void& = directory_result
                candidate_count: mutable i64 = 0
                read_error: mutable i64 = 0
                failed: mutable bool = false
                entry: mutable void&? = Store::rh_store_readdir_next(directory, &read_error)
                while entry != null and not failed |entry, read_error, failed, directory, candidates_out, candidate_count|:
                    if Store::rh_store_entry_is_blob_name(entry):
                        if candidate_count == RH_STORE_MAX_GC_CANDIDATES:
                            failed <- true
                        else:
                            entry_bytes: u8& = entry.cast[u8&] can Unsafe.PointerCast
                            while i < 16 |i: usize = 0, entry_bytes, candidates_out|:
                                candidates_out.push(entry_bytes[RH_STORE_DIRENT_NAME_OFFSET + i])
                                i <- i + 1
                            candidates_out.push(10)
                            candidate_count <- candidate_count + 1
                    entry <- Store::rh_store_readdir_next(directory, &read_error)
                failed <- true if read_error != 0
                closed: i32 = closedir(directory)
                return -1 if failed or closed != 0
                count_out[0] <- candidate_count
                0
        static else:
            def rh_store_gc_candidate_names_under_guard(evidence_dir: cstr, candidates_out: mutable darray[u8]&, count_out: mutable i64&) -> i64:
                count_out[0] <- 0
                return -1

        # Caller-held form keeps the root guarded across reference discovery and
        # deletion. The caller must acquire and release the matching root guard.
        def rh_store_gc_under_guard(evidence_dir: cstr, candidates: darray[u8]&, referenced: darray[u8]&, deleted_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            Store::rh_store_gc_unlocked(evidence_dir, candidates, referenced, false, 0, deleted_out)

        # Database reference scans arrive in canonical name order. Validate that
        # order once, then use bounded binary lookup for every discovered object.
        def rh_store_gc_sorted_under_guard(evidence_dir: cstr, candidates: darray[u8]&, referenced: darray[u8]&, reference_count: i64, deleted_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            Store::rh_store_gc_unlocked(evidence_dir, candidates, referenced, true, reference_count, deleted_out)

        def rh_store_gc(evidence_dir: cstr, candidates: darray[u8]&, referenced: darray[u8]&, deleted_out: mutable i64&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            guard_fd: mutable i32 = -1
            return -1 if Store::rh_store_guard_acquire(evidence_dir, &guard_fd) != 0
            deleted: i64 = Store::rh_store_gc_under_guard(evidence_dir, candidates, referenced, deleted_out)
            released: i64 = Store::rh_store_guard_release(guard_fd)
            return -1 if deleted != 0 or released != 0
            deleted

        # Delete one evidence blob by name (M07-08 deletion drill). Idempotent:
        # deleting an already-absent blob is success. Returns 0, or -1 on an empty
        # name. Removing a raw payload does NOT rewrite any derived result; it makes
        # the affected report not replayable, which callers must record.
        def rh_store_delete_blob(evidence_dir: cstr, hexname: u8&) -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            return -1 if Base::rh_cstr_len_c(hexname) == 0
            path: mutable darray[u8] =
                path: mutable darray[u8] = []
                Base::rh_push_cstr(path, evidence_dir)
                path.push(47)
                Base::rh_push_text(path, hexname)
                path.push(0)
                path
            pp: u8& = (&path[0]).cast[u8&] can Unsafe.PointerCast
            _ = unlink(pp)
            0

        # Index lookup: 1 present, 0 absent, -1 unreadable.
        def rh_index_has(index_path: cstr, id: u8&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            raw: mutable darray[u8] = []
            return 0 if Base::rh_io_read(index_path, raw) < 0
            while start < raw.count |start: usize = 0, raw, id|:
                stop: i64 = Base::rh_find_byte(raw, start, 10)
                line_end: usize = stop.usize() if stop >= 0 else raw.count
                if line_end > start:
                    return 1 if rh_span_eq(raw, start, line_end, id)
                if stop < 0:
                    start <- raw.count
                else:
                    start <- stop.usize() + 1
            0

        # Append one canonical record. 1 appended, 0 duplicate-skipped, -1 error.
        # The record line must already be complete JSON (caller-built); the id is
        # indexed separately so retries converge (S005).
        def rh_store_event(events_path: cstr, index_path: cstr, id: u8&, line: mutable darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            seen: i64 = rh_index_has(index_path, id)
            return -1 if seen < 0
            return 0 if seen == 1
            current: mutable darray[u8] = []
            if Base::rh_io_read(events_path, current) < 0:
                return -1 if Base::rh_file_size(events_path) >= 0
            current.extend(bytes_view(line))
            current.push(10)
            return -1 if not Base::rh_io_write(events_path, current)
            ids: mutable darray[u8] = []
            if Base::rh_io_read(index_path, ids) < 0:
                return -1 if Base::rh_file_size(index_path) >= 0
            Base::rh_push_text(ids, id)
            ids.push(10)
            return -1 if not Base::rh_io_write(index_path, ids)
            1

        # Count data lines in a file. -1 when unreadable.
        def rh_count_file_lines(path: cstr) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            raw: mutable darray[u8] = []
            return -1 if Base::rh_io_read(path, raw) < 0
            Base::rh_count_lines(raw)

        # Cursor read: page/count/ok. Missing file is ok=0 (fresh job), not error.
        def rh_cursor_read(path: cstr, page_out: mutable i64&, count_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            raw: mutable darray[u8] = []
            if Base::rh_io_read(path, raw) < 0:
                page_out[0] <- 0
                count_out[0] <- 0
                return false
            rest: usize = |page_out, raw|
                pe: i64 = Base::rh_find_byte(raw, 0, 10)
                return false if pe < 0
                pok: mutable i64 = 0
                page_out[0] <- Base::rh_parse_i64(raw, 0, pe.usize(), &pok)
                return false if pok == 0
                pe.usize() + 1
            ce: i64 = Base::rh_find_byte(raw, rest, 10)
            line_end: usize = ce.usize() if ce >= 0 else raw.count
            cok: mutable i64 = 0
            count_out[0] <- Base::rh_parse_i64(raw, rest, line_end, &cok)
            return false if cok == 0
            true

        # Cursor commit AFTER the page is stored and verified. Plain overwrite is
        # safe here because fetch resumes AT the committed page (overlap), so a
        # torn write can only repeat a page the dedup index already absorbs.
        def rh_cursor_commit(path: cstr, page: i64, count: i64) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            body: mutable darray[u8] =
                body: mutable darray[u8] = []
                Base::rh_push_decimal_i64(body, page)
                body.push(10)
                Base::rh_push_decimal_i64(body, count)
                body.push(10)
                body
            Base::rh_io_write(path, body)

        # Append one coverage interval observation "start end status".
        def rh_coverage_mark(path: cstr, start: i64, end: i64, status: u8) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            current: mutable darray[u8] = []
            if Base::rh_io_read(path, current) < 0:
                return false if Base::rh_file_size(path) >= 0
            Base::rh_push_decimal_i64(current, start)
            current.push(32)
            Base::rh_push_decimal_i64(current, end)
            current.push(32)
            Base::rh_push_text(current, Observation::rh_status_label(status))
            current.push(10)
            Base::rh_io_write(path, current)

        # Lease phase words. (private to this file)
        def rh_phase_word(phase: i64) -> u8&:
            return "leased" if phase == 1
            return "running" if phase == 2
            return "succeeded" if phase == 3
            return "failed_terminal" if phase == 4
            return "canceled" if phase == 5
            return "available" if phase == RH_LS_AVAILABLE
            "queued"

        def rh_phase_parse(word_s: usize, word_e: usize, data: darray[u8]&) -> i64 can[Memory.Allocate, Abort.Panic]:
            return 1 if rh_span_eq(data, word_s, word_e, "leased")
            return 2 if rh_span_eq(data, word_s, word_e, "running")
            return 3 if rh_span_eq(data, word_s, word_e, "succeeded")
            return 4 if rh_span_eq(data, word_s, word_e, "failed_terminal")
            return 5 if rh_span_eq(data, word_s, word_e, "canceled")
            return RH_LS_AVAILABLE if rh_span_eq(data, word_s, word_e, "available")
            return 0 if rh_span_eq(data, word_s, word_e, "queued")
            -1

        # Read a lease file into token/owner/heartbeat/phase. Returns false when
        # the file is missing or malformed (caller treats as reclaimable).
        def rh_lease_read(path: cstr, token_out: mutable i64&, owner: mutable darray[u8]&, hb_out: mutable i64&, ttl_out: mutable i64&, phase_out: mutable i64&) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            raw: mutable darray[u8] = []
            return false if Base::rh_io_read(path, raw) < 0
            l3s: usize = |token_out, owner, hb_out, raw|
                l2s: usize = |token_out, owner, raw|
                    l1s: usize = |token_out, raw|
                        l0: i64 = Base::rh_find_byte(raw, 0, 10)
                        return false if l0 < 0
                        tok_ok: mutable i64 = 0
                        token_out[0] <- Base::rh_parse_i64(raw, 0, l0.usize(), &tok_ok)
                        return false if tok_ok == 0
                        l0.usize() + 1
                    l1: i64 = Base::rh_find_byte(raw, l1s, 10)
                    return false if l1 < 0
                    while k < l1.usize() |k: usize = l1s, raw, owner|:
                        owner.push(raw[k])
                        k <- k + 1
                    l1.usize() + 1
                l2: i64 = Base::rh_find_byte(raw, l2s, 10)
                return false if l2 < 0
                hb_ok: mutable i64 = 0
                hb_out[0] <- Base::rh_parse_i64(raw, l2s, l2.usize(), &hb_ok)
                return false if hb_ok == 0
                l2.usize() + 1
            l3: i64 = Base::rh_find_byte(raw, l3s, 10)
            return false if l3 < 0
            tl_ok: mutable i64 = 0
            ttl_out[0] <- Base::rh_parse_i64(raw, l3s, l3.usize(), &tl_ok)
            return false if tl_ok == 0
            return false if ttl_out[0] <= 0
            l4s: usize = l3.usize() + 1
            l4: i64 = Base::rh_find_byte(raw, l4s, 10)
            wend: usize = l4.usize() if l4 >= 0 else raw.count
            ph: i64 = rh_phase_parse(l4s, wend, raw)
            return false if ph < 0
            phase_out[0] <- ph
            true

        def rh_lease_write(path: cstr, token: i64, owner: u8&, heartbeat: i64, ttl: i64, phase: i64) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            body: mutable darray[u8] =
                body: mutable darray[u8] = []
                Base::rh_push_decimal_i64(body, token)
                body.push(10)
                Base::rh_push_cstr(body, owner)
                body.push(10)
                Base::rh_push_decimal_i64(body, heartbeat)
                body.push(10)
                Base::rh_push_decimal_i64(body, ttl)
                body.push(10)
                Base::rh_push_text(body, rh_phase_word(phase))
                body.push(10)
                body
            Base::rh_io_write(path, body)

        def rh_lease_log(log_path: cstr, token: i64, owner: u8&, heartbeat: i64, note: u8&) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            current: mutable darray[u8] = []
            if Base::rh_io_read(log_path, current) < 0:
                return false if Base::rh_file_size(log_path) >= 0
            Base::rh_push_decimal_i64(current, token)
            current.push(32)
            Base::rh_push_cstr(current, owner)
            current.push(32)
            Base::rh_push_decimal_i64(current, heartbeat)
            current.push(32)
            Base::rh_push_text(current, note)
            current.push(10)
            Base::rh_io_write(log_path, current)

        # Acquire (or reclaim when expired) a job lease. Returns the fencing
        # token (>0), -1 when held by a live worker, -2 when terminally closed.
        # Expiry is judged by the RECORDED ttl (stored in the lease itself), so a
        # replacement presenting a different ttl cannot change the verdict; now
        # is caller time so tests inject fixed clocks (deterministic).
        def rh_lease_acquire(path: cstr, log_path: cstr, owner: u8&, now: i64, ttl: i64) -> i64 can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            next: i64 =
                token: mutable i64 = 0
                old_owner: mutable darray[u8] = []
                hb: mutable i64 = 0
                recorded: mutable i64 = 0
                phase: mutable i64 = 0
                have: bool = rh_lease_read(path, &token, old_owner, &hb, &recorded, &phase)
                if have:
                    if phase == RH_LS_AVAILABLE:
                        token + 1
                    else:
                        return -2 if phase == 3 or phase == 4 or phase == 5
                        return -1 if now - hb <= recorded
                        token + 1
                else:
                    token + 1
            return -1 if ttl <= 0
            return -1 if not rh_lease_write(path, next, owner, now, ttl, 1)
            rh_lease_log(log_path, next, owner, now, "claim")
            next

        # Heartbeat only when the token still matches (expired workers fail).
        # The recorded ttl is preserved, never renegotiated mid-lease.
        def rh_lease_heartbeat(path: cstr, token: i64, owner: u8&, now: i64) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            cur: mutable i64 = 0
            drop: mutable darray[u8] = []
            hb: mutable i64 = 0
            kept: mutable i64 = 0
            phase: mutable i64 = 0
            return false if not rh_lease_read(path, &cur, drop, &hb, &kept, &phase)
            return false if cur != token
            return false if phase == 3 or phase == 4 or phase == 5 or phase == RH_LS_AVAILABLE
            rh_lease_write(path, token, owner, now, kept, phase)

        # Release to a final phase only when the token still matches: a stale
        # worker cannot publish after losing its fencing token (M02-03).
        def rh_lease_release(path: cstr, log_path: cstr, token: i64, owner: u8&, now: i64, final_phase: i64) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            cur: mutable i64 = 0
            drop: mutable darray[u8] = []
            hb: mutable i64 = 0
            kept: mutable i64 = 0
            phase: mutable i64 = 0
            return false if not rh_lease_read(path, &cur, drop, &hb, &kept, &phase)
            if cur != token:
                rh_lease_log(log_path, token, owner, now, "stale-release-refused")
                return false
            return false if not rh_lease_write(path, token, owner, now, kept, final_phase)
            rh_lease_log(log_path, token, owner, now, "release")
            true

        # Release a shared resource lock for reuse. A later claim receives the
        # next fencing token; successful job leases should still finish terminally.
        def rh_lease_release_available(path: cstr, log_path: cstr, token: i64, owner: u8&, now: i64) -> bool can[Memory.Allocate, Abort.Panic, Console, Unsafe.PointerCast, Blocking.IO, Memory.Release]:
            Store::rh_lease_release(path, log_path, token, owner, now, RH_LS_AVAILABLE)
